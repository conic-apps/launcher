# Arch Linux source package for Conic Launcher.

pkgname=conic-launcher
pkgver=0.1.0alpha.2
pkgrel=1
_version=0.1.0-alpha.2
pkgdesc='A modern Minecraft launcher built with Tauri and Vue'
arch=('x86_64' 'aarch64')
url='https://github.com/conic-apps/launcher'
license=('GPL-3.0-only' 'LicenseRef-Conic-Additional-Terms')
depends=(
  'ca-certificates'
  'cairo'
  'gcc-libs'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'libsoup3'
  'libx11'
  'webkit2gtk-4.1'
  'xdg-utils'
)
makedepends=(
  'cargo'
  'desktop-file-utils'
  'git'
  'nodejs-lts-krypton'
  'pkgconf'
  'pnpm>=11.7.0'
)
optdepends=('java-runtime: use a system Java runtime instead of downloading one in the launcher')
# Cargo's release profile already enables LTO and strips the binary.
options=('!lto' '!debug')
source=(
  "$pkgname-$_version.tar.gz::$url/archive/refs/tags/v$_version.tar.gz"
  "$pkgname.desktop"
)
sha256sums=(
  '20f8b7a52e9ff5162eb0d175dab0b7c08b729b8ac137d8cd07261de59bc10f26'
  'b9e6b9a66d77b610f695994d06b06c5af576ff958ec1dec0e2d35394a843da28'
)

prepare() {
  cd "$srcdir/launcher-$_version"

  # Match package.json instead of the obsolete pnpm 10 entry in this release.
  printf 'package-manager=pnpm@11.18.0\n' > .npmrc
  pnpm install --frozen-lockfile
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$srcdir/launcher-$_version"

  export CARGO_TARGET_DIR="$srcdir/target"
  pnpm exec tauri build --ci --no-bundle \
    --target "$CARCH-unknown-linux-gnu" -- --frozen
}

check() {
  desktop-file-validate "$srcdir/$pkgname.desktop"
}

package() {
  cd "$srcdir/launcher-$_version"

  install -Dm755 "$srcdir/target/$CARCH-unknown-linux-gnu/release/$pkgname" \
    "$pkgdir/usr/bin/$pkgname"
  install -Dm644 "$srcdir/$pkgname.desktop" \
    "$pkgdir/usr/share/applications/$pkgname.desktop"

  local size
  for size in 32 64 128; do
    install -Dm644 "core/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$pkgname.png"
  done
  install -Dm644 core/icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/$pkgname.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
