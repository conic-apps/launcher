# Python tooling (tools)
__pycache__/
*.pyc

# Generated by `app/build.rs` from `src/assets/icons/*.svg` on every build
app/ui/icons.slint

# The payload `cargo rpm` packages from, staged into `app/.rpm/` by
# `tools/package-linux.sh` out of `packaging/linux/` and `LICENSE`. The spec next
# to it is hand-written and IS committed -- see `app/.rpm/conic-launcher.spec`.
/app/.rpm/usr/

# Where `build.yml` installs the WiX toolset, with `dotnet tool install
# --tool-path .tools`, so the job does not depend on the image's
# `%USERPROFILE%\.dotnet\tools` being on PATH.
/.tools/
