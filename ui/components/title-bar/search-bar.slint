import { Theme } from "../../theme.slint";
import { AppIcon } from "../display/app-icon.slint";

// Search / command palette opener. The icon is the Ionicons `search-outline`
// glyph, read out of the generated `Icons` table like every other icon. The
// hotkey chip is part of the field so the field can size itself to everything
// it shows.
export component SearchBar inherits Rectangle {
    in property <string> placeholder;
    in property <string> hotkey: "";
    in property <bool> active: false;
    out property <length> content-width:
        36px + placeholder-text.preferred-width
        + (root.hotkey == "" ? 12px : hotkey-chip.width + 18px);
    callback activated;

    height: 26px;
    border-radius: Theme.controllers-border-radius;
    background: root.active || touch.pressed ? Theme.surface-2
        : touch.has-hover ? Theme.surface-1
        : transparent;
    clip: true;

    accessible-role: button;
    accessible-label: root.placeholder;
    accessible-action-default => { root.activated(); }

    AppIcon {
        name: "search";
        x: 10px;
        size: 20px;
        icon-color: Theme.default-text-color.transparentize(0.1);
    }

    placeholder-text := Text {
        text: root.placeholder;
        font-size: 13px;
        color: Theme.default-text-color.transparentize(0.2);
        x: 36px;
    }

    hotkey-chip := Rectangle {
        visible: root.hotkey != "";
        width: hotkey-text.preferred-width + 12px;
        height: 17px;
        y: (root.height - self.height) / 2;
        x: root.width - self.width - 10px;
        border-radius: 4px;
        background: Theme.surface-2.transparentize(0.3);

        hotkey-text := Text {
            text: root.hotkey;
            font-size: 11px;
            color: Theme.default-text-color.transparentize(0.4);
            x: (hotkey-chip.width - self.width) / 2;
            y: (hotkey-chip.height - self.height) / 2;
        }
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}
