import { Theme } from "../../theme.slint";

// Title bar icon action button: the left pair, the right-hand actions and the
// music toggle. A selected one is filled with the accent tint, which is how an
// open overlay marks itself; nothing marks the current screen. Icons are
// Ionicons-style stroked paths (512 viewbox).
export component TitleBarActionButton inherits Rectangle {
    in property <string> icon-commands;
    in property <int> icon-viewbox: 512;
    in property <length> icon-stroke-width: 0px;
    in property <bool> selected: false;
    callback clicked;

    width: 28px;
    height: 28px;
    border-radius: 6px;
    // `has-hover` stays true for the whole press, so press has to be tested first.
    // It fills opaque: a wash of the greys hover already wears is the same tile
    // at a slightly different strength, which reads as no feedback at all.
    background: touch.pressed ? Theme.overlay-0
        : root.selected ? Theme.mauve.transparentize(0.7)
        : touch.has-hover ? Theme.surface-2.transparentize(0.3)
        : transparent;
    animate background {
        duration: 120ms;
        easing: Easing.ease;
    }

    accessible-role: button;
    accessible-action-default => { root.clicked(); }

    Path {
        commands: root.icon-commands;
        viewbox-width: root.icon-viewbox;
        viewbox-height: root.icon-viewbox;
        width: 18px;
        height: 18px;
        fill: transparent;
        stroke: root.selected ? Theme.mauve : Theme.text;
        stroke-width: root.icon-stroke-width;
        stroke-line-cap: LineCap.round;
        stroke-line-join: LineJoin.round;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
