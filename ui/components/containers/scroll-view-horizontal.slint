import { Theme } from "../../theme.slint";
import { FocusManager } from "../../globals/focus.slint";
import { ScrollInput, ScrollSource } from "../../globals/scroll.slint";

// Horizontal scroll container with a slim custom scrollbar on its bottom edge.
//
// This is `ScrollView` turned on its side: the same eased lerp, the same thumb,
// and the same rule that the vertical wheel belongs to the page. Two rules keep
// the strip from stealing a gesture meant for the vertical scroller around it:
//
//   * A trackpad (or its momentum) turns the strip only with its *horizontal*
//     component. A vertical two-finger swipe is left to bubble to the page.
//   * A notched wheel turns the strip only while Ctrl is held — the
//     wheel-rotated-sideways convention. Without Ctrl the event bubbles up to
//     the vertical `ScrollView`, so a plain wheel over the strip scrolls the
//     page, and Ctrl+wheel scrolls the strip. A wheel that *reports* a
//     horizontal axis (`delta-x`) is taken as horizontal regardless.
//
// The differences from `ScrollView` are in the details panel's gallery, which
// is the one other place it is used: the track sits at the *bottom* rather than
// the right, inset from the left and right edges by the caller's padding rather
// than by a fixed 8px.
//
// There is no scroll-to-centre here. Centring took a live element to measure;
// here the items are written into a `@children` slot, and Slint has no way to
// reach a slot's child by index, so the offsets are not addressable from inside
// the component. A caller that needs to centre something has to add the distance
// itself — the detail gallery can, because its item widths come from its own
// model.
export component ScrollViewHorizontal inherits Rectangle {
    in property <length> scrollbar-left: 8px;
    in property <length> scrollbar-right: 8px;
    /// Hides the scrollbar without touching the scrolling.
    in property <bool> scrollbar-disabled: false;

    width: 100%;
    height: 100%;
    clip: true;
    background: transparent;

    /// Width of the scrollable content: the natural width of what was put in, or
    /// the viewport when that is narrower. Read off the layout the same way
    /// `ScrollView` reads its height off.
    out property <length> content-width: max(root.width, content-layout.preferred-width);
    /// Smoothed scroll offset in the `Flickable` sign: 0 at the left, negative
    /// once the content has been scrolled to the right. `scroll-x` below is its
    /// positive twin, the one the position and the thumb are written in.
    out property <length> content-x: -root.scroll-x;

    private property <length> scrollbar-inset-bottom: 4px;
    private property <length> scrollbar-height: 6px;
    private property <length> track-width: max(0px, root.width - root.scrollbar-left - root.scrollbar-right);

    /// Smoothed offset: 0 at the left edge, growing as the content scrolls right.
    private property <length> scroll-x: 0px;
    /// Where `scroll-x` is heading (wheel input, `scroll-to`, dragging).
    private property <length> target-x: 0px;
    private property <length> max-scroll: max(0px, root.content-width - root.width);
    /// Wheel distance multiplier; see `ScrollView`'s for why it is 2.
    private property <float> wheel-step: 2;

    // The `lerp`, 0.16 — see `ScrollView`. The horizontal and vertical
    // containers share one value so they glide identically.
    private property <float> lerp: 0.16;
    private property <float> last-tick-ms: 0;

    /// Whether the offset still has to catch up with the target; see `ScrollView`
    /// for why it cannot be derived at the point it is needed.
    private property <bool> scrolling: abs(root.target-x - root.scroll-x) > 0.5px;

    changed scrolling => {
        if root.scrolling {
            root.last-tick-ms = ScrollInput.now-ms();
        }
    }

    scroll-timer := Timer {
        interval: 8ms;
        running: root.scrolling;
        triggered => {
            root.scroll-x = root.scroll-x + (root.target-x - root.scroll-x) * (1 - pow(
                1 - root.lerp,
                clamp((ScrollInput.now-ms() - root.last-tick-ms) / 1000, 0.004, 0.05) * 60,
            ));
            root.last-tick-ms = ScrollInput.now-ms();
        }
    }

    // The content getting wider (or narrower) can leave the offset past the end
    // of the row, which is clamped and eased back from.
    changed max-scroll => {
        root.target-x = clamp(root.target-x, 0px, root.max-scroll);
    }

    /// Scrolls so that `x` — the same sign as `content-x` — ends up at the left of
    /// the viewport.
    public function scroll-to(x: length, smooth: bool) {
        if smooth {
            root.target-x = clamp(-x, 0px, root.max-scroll);
        } else {
            root.jump-to(-x);
        }
    }

    /// Moves the offset without easing: both the offset and the target, so a
    /// glide in flight is dropped rather than resumed.
    function jump-to(offset: length) {
        root.scroll-x = clamp(offset, 0px, root.max-scroll);
        root.target-x = root.scroll-x;
    }

    viewport := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        clip: true;
        background: transparent;

        scroll-touch := TouchArea {
            width: parent.width;
            height: parent.height;

            // Blurs a focused text field when its user clicks away from it. See
            // `ScrollView` for why the area is here rather than on the
            // container.
            clicked => { FocusManager.clear(); }

            scroll-event(event) => {
                let source = ScrollInput.source();
                let horizontal = abs(event.delta-x) > abs(event.delta-y);

                // A vertical gesture is the page's, not the strip's — unless a
                // wheel is being rotated sideways with Ctrl. Either way it is
                // rejected so it bubbles to the vertical scroller around us.
                if !horizontal {
                    if source != ScrollSource.wheel {
                        return reject;
                    }
                    // On macOS Slint maps ⌘ to `control` and the physical
                    // Control key to `meta`, so both are taken: the "Ctrl" the
                    // user presses is whichever of the two the platform reports.
                    if !event.modifiers.control && !event.modifiers.meta {
                        return reject;
                    }
                }

                // A horizontal gesture is ours even with nothing to scroll, so
                // it never chains to the page.
                if root.max-scroll <= 0px {
                    return accept;
                }
                if source == ScrollSource.wheel {
                    // Ctrl+wheel: a notch is a distance, eased towards.
                    let delta = horizontal
                        ? event.delta-x
                        : event.delta-y;
                    root.target-x = clamp(
                        root.target-x - delta * root.wheel-step,
                        0px,
                        root.max-scroll,
                    );
                } else {
                    // A trackpad swipe, fingers down or coasting: the horizontal
                    // deltas *are* the motion.
                    root.jump-to(root.scroll-x - event.delta-x);
                }
                return accept;
            }

            content := Rectangle {
                x: -root.scroll-x;
                y: 0;
                width: root.content-width;
                height: root.height;
                background: transparent;

                content-layout := HorizontalLayout {
                    width: parent.width;
                    cross-axis-alignment: center;
                    @children
                }
            }
        }
    }

    scrollbar := Rectangle {
        visible: !root.scrollbar-disabled && root.max-scroll > 0.5px;
        x: root.scrollbar-left;
        y: root.height - root.scrollbar-inset-bottom - root.scrollbar-height;
        width: root.track-width;
        height: root.scrollbar-height;
        background: transparent;
        z: 500;

        private property <length> thumb-track: self.width - thumb.width;

        thumb := Rectangle {
            height: track-touch.has-hover || track-touch.pressed ? 10px : 8px;
            y: track-touch.has-hover || track-touch.pressed ? -2px : 0px;
            width: root.thumb-width;
            // Follows the *smoothed* offset, so the thumb glides with the content.
            x: parent.thumb-track > 0px
                ? clamp(root.scroll-x / root.max-scroll, 0, 1) * parent.thumb-track
                : 0px;
            border-radius: 999px;
            background: Theme.text;
            opacity: track-touch.pressed ? 0.55 : track-touch.has-hover ? 0.55 : 0.35;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale-x: track-touch.pressed ? 0.9 : 1.0;
            transform-scale-y: track-touch.pressed ? 0.9 : 1.0;
            animate opacity { duration: 160ms; }
            animate height { duration: 160ms; }
            animate y { duration: 160ms; }
            animate transform-scale-x, transform-scale-y { duration: 120ms; }
        }

        // As in `ScrollView`: the drag state is tracked here rather than off the
        // event's button, because a *move* arrives with
        // `PointerEventButton.other`, and the touch area is as tall as the
        // *hovered* thumb so grabbing the overhang does not shrink it out from
        // under the cursor.
        track-touch := TouchArea {
            y: -2px;
            height: parent.height + 4px;
            width: parent.width;

            pointer-event(event) => {
                if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                    root.dragging = false;
                } else if event.kind == PointerEventKind.down {
                    if event.button != PointerEventButton.left
                        || root.max-scroll <= 0px
                        || self.width <= thumb.width {
                        return;
                    }
                    FocusManager.clear();
                    // Pressing the thumb keeps the grab point; pressing the track
                    // brings the thumb's centre to the cursor.
                    root.drag-anchor = self.mouse-x >= thumb.x && self.mouse-x <= thumb.x + thumb.width
                        ? self.mouse-x - thumb.x
                        : thumb.width / 2;
                    root.dragging = true;
                    root.drag-scrollbar(self.mouse-x);
                } else if event.kind == PointerEventKind.move && root.dragging {
                    root.drag-scrollbar(self.mouse-x);
                }
            }
        }
    }

    private property <length> thumb-width: root.max-scroll > 0px
        ? max(32px, root.track-width * root.width / max(root.content-width, root.width))
        : root.track-width;

    private property <bool> dragging: false;
    /// Where inside the thumb the pointer grabbed it, so dragging does not make
    /// the thumb jump under the cursor.
    private property <length> drag-anchor: 0px;

    function drag-scrollbar(mouse-x: length) {
        if root.max-scroll <= 0px || scrollbar.width <= thumb.width {
            return;
        }
        root.jump-to(
            clamp((mouse-x - root.drag-anchor) / (scrollbar.width - thumb.width), 0, 1)
            * root.max-scroll,
        );
    }
}
