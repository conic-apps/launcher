import { Theme } from "../../theme.slint";
import { Dropdown } from "../../globals/dropdown.slint";
import { FocusManager } from "../../globals/focus.slint";
import { ScrollInput, ScrollSource } from "../../globals/scroll.slint";

// Vertical scroll container with a slim custom scrollbar.
//
// Not a `Flickable`: that would layer its own fixed-duration animation on top and
// clamp a programmatic scroll when the content changes height. The offset eases
// towards the wheel target instead, and touchpads apply their deltas — and macOS
// momentum — as they arrive, never eased.
//
// `content-y` is in the `Flickable` sign (0 at top, negative scrolled down);
// `scroll-y` is its positive twin.
export component ScrollView inherits Rectangle {
    in property <length> scrollbar-top: 8px;
    in property <length> scrollbar-bottom: 8px;
    /// Hides the scrollbar without touching the scrolling.
    in property <bool> scrollbar-disabled: false;

    width: 100%;
    height: 100%;
    clip: true;
    background: transparent;

    /// Height of the scrollable content: the natural height of what was put in, or
    /// the viewport when that is shorter.
    out property <length> content-height: max(root.height, content-layout.preferred-height);
    /// Smoothed scroll offset, negative when scrolled down.
    out property <length> content-y: -root.scroll-y;

    private property <length> scrollbar-inset-right: 8px;
    private property <length> scrollbar-width: 6px;
    private property <length> track-height: max(0px, root.height - root.scrollbar-top - root.scrollbar-bottom);

    /// Smoothed offset: 0 at the top, growing as the content scrolls down.
    private property <length> scroll-y: 0px;
    /// Where `scroll-y` is heading, always clamped to the list.
    private property <length> target-y: 0px;
    private property <length> max-scroll: max(0px, root.content-height - root.height);
    /// Wheel distance multiplier: a winit notch is about 60px, so 2 brings it to
    /// the usual ~120px.
    private property <float> wheel-step: 2;

    // Share of the remaining distance covered per 60Hz frame, scaled by elapsed
    // time for the same glide on any refresh rate. Shared with the horizontal
    // container.
    private property <float> lerp: 0.16;
    private property <float> last-tick-ms: 0;

    /// A click on the scroll area that no control inside it took.
    callback background-clicked();

    /// Whether the offset still has to catch up with the target. Held separately
    /// so the glide's start can be caught before the first tick reads a long idle
    /// gap as its frame time.
    private property <bool> scrolling: abs(root.target-y - root.scroll-y) > 0.5px;
    private property <bool> dropdown-open: Dropdown.open;

    changed dropdown-open => {
        if root.dropdown-open {
            root.target-y = root.scroll-y;
        }
    }

    changed scrolling => {
        if root.scrolling {
            root.last-tick-ms = ScrollInput.now-ms();
        }
    }

    scroll-timer := Timer {
        interval: 8ms;
        running: root.scrolling;
        triggered => {
            // Scale by real elapsed time so the glide lasts the same at any frame
            // rate; the upper bound only guards a whole-event-loop stall.
            root.scroll-y = root.scroll-y + (root.target-y - root.scroll-y) * (1 - pow(
                1 - root.lerp,
                clamp((ScrollInput.now-ms() - root.last-tick-ms) / 1000, 0.004, 0.05) * 60,
            ));
            root.last-tick-ms = ScrollInput.now-ms();
        }
    }

    // A resize or content height change can leave the offset past the end, so
    // pull the target back to the new limit.
    changed max-scroll => {
        root.target-y = clamp(root.target-y, 0px, root.max-scroll);
    }

    /// Scrolls so `y` (same sign as `content-y`) is at the top of the viewport.
    public function scroll-to(y: length, smooth: bool) {
        if smooth {
            root.target-y = clamp(-y, 0px, root.max-scroll);
        } else {
            root.jump-to(-y);
        }
    }

    /// Moves both offset and target without easing, dropping any glide in flight.
    function jump-to(offset: length) {
        root.scroll-y = clamp(offset, 0px, root.max-scroll);
        root.target-y = root.scroll-y;
    }

    viewport := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        clip: true;
        background: transparent;

        scroll-touch := TouchArea {
            width: parent.width;
            height: parent.height;

            // A `TouchArea` grabs every press inside it, so the page behind never
            // sees clicks landing here. Blur the focused field, as the settings
            // background does.
            clicked => {
                FocusManager.clear();
                root.background-clicked();
            }

            scroll-event(event) => {
                if Dropdown.open {
                    return accept;
                }
                // Always consume a wheel over the scroll area, even with nothing
                // to scroll, so it never reaches a panel behind or an outer
                // scroller.
                if root.max-scroll <= 0px {
                    return accept;
                }
                if ScrollInput.source() == ScrollSource.wheel {
                    // A notch is a distance, so it goes into the target and the
                    // offset eases after it.
                    root.target-y = clamp(
                        root.target-y - event.delta-y * root.wheel-step,
                        0px,
                        root.max-scroll,
                    );
                } else {
                    // A trackpad's deltas are the motion itself, so apply them
                    // directly; this also drops any wheel glide in flight.
                    root.jump-to(root.scroll-y - event.delta-y);
                }
                return accept;
            }

            content := Rectangle {
                x: 0;
                y: -root.scroll-y;
                width: parent.width;
                height: root.content-height;
                background: transparent;

                content-layout := VerticalLayout {
                    width: parent.width;
                    alignment: start;
                    @children
                }
            }
        }
    }

    scrollbar := Rectangle {
        visible: !root.scrollbar-disabled && root.max-scroll > 0.5px;
        x: root.width - root.scrollbar-inset-right - root.scrollbar-width;
        y: root.scrollbar-top;
        width: root.scrollbar-width;
        height: root.track-height;
        background: transparent;
        z: 500;

        private property <length> thumb-track: self.height - thumb.height;

        thumb := Rectangle {
            width: track-touch.has-hover || track-touch.pressed ? 10px : 8px;
            x: track-touch.has-hover || track-touch.pressed ? -2px : 0px;
            height: root.thumb-height;
            // Follows the smoothed offset, so the thumb glides with the content.
            y: parent.thumb-track > 0px
                ? clamp(root.scroll-y / root.max-scroll, 0, 1) * parent.thumb-track
                : 0px;
            border-radius: 999px;
            background: Theme.text;
            opacity: track-touch.pressed ? 0.55 : track-touch.has-hover ? 0.55 : 0.35;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale-x: track-touch.pressed ? 0.9 : 1.0;
            transform-scale-y: track-touch.pressed ? 0.9 : 1.0;
            animate opacity { duration: 160ms; }
            animate width { duration: 160ms; }
            animate x { duration: 160ms; }
            animate transform-scale-x, transform-scale-y { duration: 120ms; }
        }

        // Grabbing the thumb drags it; pressing the track centres the thumb under
        // the cursor first. The drag state is tracked here because a Slint move
        // arrives with `PointerEventButton.other`. The touch area is as wide as
        // the hovered thumb so grabbing the overhang does not shrink it.
        track-touch := TouchArea {
            x: -2px;
            width: parent.width + 4px;
            height: parent.height;

            pointer-event(event) => {
                if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                    root.dragging = false;
                } else if event.kind == PointerEventKind.down {
                    if event.button != PointerEventButton.left
                        || root.max-scroll <= 0px
                        || self.height <= thumb.height {
                        return;
                    }
                    FocusManager.clear();
                    // Pressing the thumb keeps the grab point; pressing the track
                    // centres the thumb on the cursor.
                    root.drag-anchor = self.mouse-y >= thumb.y && self.mouse-y <= thumb.y + thumb.height
                        ? self.mouse-y - thumb.y
                        : thumb.height / 2;
                    root.dragging = true;
                    root.drag-scrollbar(self.mouse-y);
                } else if event.kind == PointerEventKind.move && root.dragging {
                    root.drag-scrollbar(self.mouse-y);
                }
            }
        }
    }

    private property <length> thumb-height: root.max-scroll > 0px
        ? max(32px, root.track-height * root.height / max(root.content-height, root.height))
        : root.track-height;

    private property <bool> dragging: false;
    /// Where inside the thumb the pointer grabbed it, so dragging does not jump.
    private property <length> drag-anchor: 0px;

    function drag-scrollbar(mouse-y: length) {
        if root.max-scroll <= 0px || scrollbar.height <= thumb.height {
            return;
        }
        root.jump-to(
            clamp((mouse-y - root.drag-anchor) / (scrollbar.height - thumb.height), 0, 1)
            * root.max-scroll,
        );
    }
}
