// The slide-left / slide-right transition, used by the add-account dialog.
//
//   slide-left   leave  translate to -80px, 80ms;  enter from +80px, 250ms
//   slide-right  leave  translate to +80px, 80ms;  enter from -80px, 250ms
//
// Both halves fade to / from opacity 0 over the same time. `phase` picks which
// half an element is in, so a screen plays it by passing the phase down — the same
// contract as `ZoomTransition`.
//
// Slint has no translation transform, so the movement is an animated `x`, and a
// layout child's `x` belongs to its layout: the root is a plain rectangle whose
// height the content dictates through `min-height`.
export component SlideTransition inherits Rectangle {
    /// "enter" (waiting at the start of the enter half), "shown" (at rest) or
    /// "leave" (playing the leave half).
    in property <string> phase: "shown";
    /// "left" or "right".
    in property <string> direction: "left";

    width: 100%;
    // A Rectangle has no preferred size of its own, so the content's height is
    // declared as the minimum for the parent layout to size us by.
    min-height: content.preferred-height;
    background: transparent;
    // Deliberately unclipped: the sliding screen overruns its own box, and the
    // dialog clips it — at the dialog's content box, which is 8px wider on each
    // side than a screen here. Clipping at the screen instead would cut both the
    // slide and any control that grows past the screen's edge, which the buttons
    // do on hover.
    opacity: root.phase == "shown" ? 1.0 : 0.0;

    private property <length> offset: root.phase == "enter"
        ? (root.direction == "left" ? 80px : -80px)
        : root.phase == "leave" ? (root.direction == "left" ? -80px : 80px)
        : 0px;

    // The durations and easings differ per phase, so they are read when the
    // animation starts — i.e. with the phase the element is entering.
    animate offset, opacity {
        duration: root.phase == "leave" ? 80ms : 250ms;
        easing: root.phase == "leave"
            ? cubic-bezier(0.65, 0, 1, 0.42)
            : cubic-bezier(0, 0.65, 0.26, 1);
    }

    content := VerticalLayout {
        x: root.offset;
        width: root.width;
        // See `AccountAdd`: a stretching column would spread the panel's
        // mid-tween surplus over the screen's own rows.
        alignment: start;
        @children
    }
}
