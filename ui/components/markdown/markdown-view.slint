// The view half of the renderer: a document's display list, drawn. Geometry,
// type sizes, line breaks and decorations all come from Rust; Slint only draws.

import { MarkdownPalette, MdIconPath } from "markdown-types.slint";

/// One item of the engine's display list, in paint order. Mirrors the Rust
/// `MdItem`; a bitmap is a `MarkdownImage` instead. `visible` is set by the view's
/// wrapper, not carried here.
export struct MdItem {
    /// "text" | "rect"; a bitmap is a `MarkdownImage`.
    kind: string,
    x: length,
    y: length,
    width: length,
    height: length,
    /// The glyphs of a `text` item, empty for a `rect`.
    text: string,
    font-size: length,
    font-weight: int,
    font-italic: bool,
    /// Set with the code font rather than the text font.
    mono: bool,
    /// The palette slot name this item takes its colour from.
    color: string,
    radius: length,
    /// Whether a `rect` item is filled at all; some cells are outline only.
    filled: bool,
    /// A `rect` item's outline width, drawn inside the box.
    border-width: length,
    /// The palette slot name the outline takes its colour from.
    border-color: string,
    /// On a `rect` link: the transparent box that takes the press.
    link-url: string,
    /// Groups every piece of one link, so a hover can cover all its lines.
    link-id: string,
    /// Where the hovered link's rule sits, from the top of this box.
    rule-offset: length,
    /// Whether this link reveals a rule at all. False for a linked image, since
    /// `text-decoration` does not reach a replaced element.
    rule: bool,
}

/// One bitmap of the document. A separate model because a Slint struct literal
/// must name every field, and there is no empty `image` for the other items.
export struct MarkdownImage {
    x: length,
    y: length,
    width: length,
    height: length,
    /// `.markdown-body img { border-radius: 8px }`.
    radius: length,
    /// The alternative text.
    alt: string,
    /// The bitmap; an empty one draws nothing.
    bitmap: image,
    /// Set when the image is itself a link (`[![alt](img)](url)`).
    link-url: string,
    /// That link's id, so a hovered rule can cover the image too.
    link-id: string,
}

/// One run of the document: the unit a view stacks vertically. Mirrors the Rust
/// `MdChunk` with its section geometry flattened in. A collapsible section is one
/// run, so closing it shortens the column and reclaims the space.
export struct MdChunk {
    /// The engine's section id, or -1 for a run of ordinary blocks.
    section-index: int,
    /// Where the run starts in the engine's open layout.
    top: length,
    /// How tall the run is with its section open.
    height: length,
    /// How much the closed section hides — its content and margin, not the
    /// summary row. Zero for a non-section run.
    hidden: length,
    /// The summary row's box; all zero for a non-section run.
    head-x: length,
    head-y: length,
    head-width: length,
    head-height: length,
    head-radius: length,
    /// The disclosure chevron, rotated a quarter turn when open.
    marker-x: length,
    marker-y: length,
    marker-size: length,
    /// The run's items, in paint order.
    items: [MdItem],
    /// Its bitmaps, in the same coordinate space as the items.
    images: [MarkdownImage],
}

// Resolves a palette slot name. A name that resolves to nothing falls back to the
// text colour, so a missing slot shows the wrong tint rather than nothing.
export global MarkdownColors {
    public pure function resolve(palette: MarkdownPalette, name: string) -> color {
        if name == "heading" { return palette.heading; }
        if name == "link" { return palette.link; }
        if name == "code-text" { return palette.code-text; }
        if name == "code-background" { return palette.code-background; }
        if name == "code-block-text" { return palette.code-block-text; }
        if name == "code-block-background" { return palette.code-block-background; }
        if name == "quote-text" { return palette.quote-text; }
        if name == "quote-bar" { return palette.quote-bar; }
        if name == "table-border" { return palette.table-border; }
        if name == "table-head-text" { return palette.table-head-text; }
        if name == "table-head-background" { return palette.table-head-background; }
        if name == "rule" { return palette.rule; }
        if name == "strike" { return palette.strike; }
        if name == "marker" { return palette.marker; }
        if name == "placeholder" { return palette.placeholder; }
        if name == "details-head" { return palette.details-head; }
        if name == "details-head-hover" { return palette.details-head-hover; }
        if name == "details-head-active" { return palette.details-head-active; }
        if name == "details-marker" { return palette.details-marker; }
        return palette.text;
    }
}

// A run of glyphs in one style. `height` is the run's own ascent and descent, so
// runs of different sizes share a baseline. `wrap` is off because the engine has
// already broken the line.
component MdText inherits Text {
    in property <MdItem> item;
    in property <color> text-color: black;
    in property <string> family: "";
    in property <string> mono-family: "monospace";

    x: item.x;
    y: item.y;
    width: item.width;
    height: item.height;
    text: item.text;
    font-size: item.font-size;
    font-weight: item.font-weight;
    font-italic: item.font-italic;
    font-family: item.mono ? mono-family : family;
    color: text-color;
    vertical-alignment: center;
    horizontal-alignment: left;
    wrap: no-wrap;
    overflow: clip;
}

// A rounded box, filled or outlined.
component MdRect inherits Rectangle {
    in property <MdItem> item;
    in property <color> fill: transparent;
    in property <color> outline: transparent;

    x: item.x;
    y: item.y;
    width: item.width;
    height: item.height;
    background: item.filled ? fill : transparent;
    border-width: item.border-width;
    border-color: outline;
    border-radius: item.radius;
    clip: true;
}

// A bitmap, clipped to its radius and drawn undistorted inside the given box.
component MdImage inherits Rectangle {
    in property <MarkdownImage> picture;
    in property <string> hovered-id: "";
    callback link-clicked(string);

    x: picture.x;
    y: picture.y;
    width: picture.width;
    height: picture.height;
    border-radius: picture.radius;
    clip: true;

    Image {
        width: parent.width;
        height: parent.height;
        source: picture.bitmap;
        image-fit: contain;
    }

    // A linked image takes the press like any other link.
    if root.picture.link-url != "": TouchArea {
        mouse-cursor: pointer;
        clicked => { root.link-clicked(root.picture.link-url); }
    }
}

// The transparent box that takes a link's press, and the rule it reveals. The
// engine emits one per line, all sharing a `link-id`; the hovered id is the
// view's so every piece of the link underlines at once.
component MdLink inherits Rectangle {
    in property <MdItem> box-item;
    in property <color> link-color: black;
    in property <string> hovered-id: "";
    /// The pointer entered or left a link. The id is empty on the way out, so a
    /// view does not have to remember which link it was.
    callback hover-changed(string, bool);
    callback link-clicked(string);

    x: box-item.x;
    y: box-item.y;
    width: box-item.width;
    height: box-item.height;
    background: transparent;

    // The rule, at the position the engine asked for.
    Rectangle {
        visible: box-item.rule && root.hovered-id != "" && root.hovered-id == box-item.link-id;
        x: 0;
        y: box-item.rule-offset;
        width: parent.width;
        height: 1px;
        background: root.link-color;
    }

    touch := TouchArea {
        // A link has no shape of its own, so the hand cursor is what says it goes
        // somewhere.
        mouse-cursor: pointer;
        changed has-hover => { root.hover-changed(box-item.link-id, touch.has-hover); }
        clicked => { root.link-clicked(box-item.link-url); }
    }
}

// A `<details>` summary row: its background, chevron and opening press. Drawn
// before the run's items because its fill would otherwise hide the title.
component MdSectionRow inherits Rectangle {
    in property <MdChunk> chunk;
    in property <MarkdownPalette> palette;
    in property <bool> open: false;
    /// The chevron to draw, when the caller has an icon set of its own.
    in property <MdIconPath> icon: { commands: "", viewbox: 0, stroke-width: 0 };
    /// The row is pressed. The view decides what that means, and says which run
    /// it was.
    callback toggled(int);

    x: chunk.head-x;
    y: chunk.head-y - chunk.top;
    width: chunk.head-width;
    height: chunk.head-height;
    border-top-left-radius: chunk.head-radius;
    border-top-right-radius: chunk.head-radius;
    border-bottom-left-radius: chunk.head-radius;
    border-bottom-right-radius: chunk.head-radius;
    background: touch.pressed ? palette.details-head-active
        : touch.has-hover ? palette.details-head-hover
        : palette.details-head;
    animate background { duration: 50ms; }

    // The chevron, drawn like `AppIcon`: path data at its own view box, stroked,
    // round caps and joins. The font has no disclosure triangles.
    if root.icon.viewbox > 0: Path {
        x: chunk.marker-x - root.x;
        y: chunk.marker-y - chunk.top - root.y;
        width: chunk.marker-size;
        height: chunk.marker-size;
        commands: root.icon.commands;
        viewbox-width: root.icon.viewbox;
        viewbox-height: root.icon.viewbox;
        fill: transparent;
        stroke: palette.details-marker;
        stroke-width: chunk.marker-size * root.icon.stroke-width / root.icon.viewbox;
        stroke-line-cap: LineCap.round;
        stroke-line-join: LineJoin.round;
        // A quarter turn from right (closed) to down (open). It is only honest
        // because the icon set's `chevron-forward` and `chevron-down` are the same
        // glyph.
        transform-rotation: root.open ? 90deg : 0deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        animate transform-rotation {
            duration: 200ms;
            easing: ease-in-out;
        }
    }

    if root.icon.viewbox <= 0: Path {
        x: chunk.marker-x - root.x;
        y: chunk.marker-y - chunk.top - root.y;
        width: chunk.marker-size;
        height: chunk.marker-size;
        fill: palette.details-marker;
        transform-rotation: root.open ? 90deg : 0deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        animate transform-rotation {
            duration: 200ms;
            easing: ease-in-out;
        }
        commands: "M " + (self.width / 1px * 0.36) + " " + (self.height / 1px * 0.22)
            + " L " + (self.width / 1px * 0.66) + " " + (self.height / 1px * 0.5)
            + " L " + (self.width / 1px * 0.36) + " " + (self.height / 1px * 0.78)
            + " L " + (self.width / 1px * 0.26) + " " + (self.height / 1px * 0.68)
            + " L " + (self.width / 1px * 0.46) + " " + (self.height / 1px * 0.5)
            + " L " + (self.width / 1px * 0.26) + " " + (self.height / 1px * 0.32) + " Z";
    }

    // No `mouse-cursor: pointer` (house rule); the row lighting up says it is
    // pressable. A link is the exception.
    touch := TouchArea {
        clicked => { root.toggled(root.chunk.section-index); }
    }
}

/// Draws a document. The caller runs the Rust `Renderer`, copies the runs into
/// [`MdChunk`]s and pushes them in.
///
/// # Culling
///
/// A caller with a scroll offset sets `viewport-y` and `viewport-height`; the
/// `visible` bindings skip items outside that window. The margin is generous on
/// purpose: an item slightly outside costs nothing, one appearing inside late is
/// what a user notices.
export component MarkdownView inherits Rectangle {
    /// The document, in runs, in document order.
    in property <[MdChunk]> chunks: [];
    /// How tall the list is with every section open, as the engine laid it out.
    /// Not what a scroll container should offer; use `shown-height`.
    in property <length> content-height: 0px;
    /// The colours `color` resolves against.
    // Every slot is named: an unset struct field takes its type default (opaque
    // black for a color), and `MarkdownColors.resolve` only falls back to `text`
    // for an unknown name, not a missing field.
    in property <MarkdownPalette> palette: {
        text: #000000,
        heading: #000000,
        link: #0000ee,
        code-text: #000000,
        code-background: #cccccc,
        code-block-text: #000000,
        code-block-background: #eeeeee,
        quote-text: #555555,
        quote-bar: #888888,
        table-border: #aaaaaa,
        table-head-text: #000000,
        table-head-background: #dddddd,
        rule: #888888,
        strike: #000000,
        // No `::marker` or broken-image rule upstream, so both use the text colour.
        marker: #000000,
        placeholder: #000000,
        details-head: #ffffff,
        details-head-hover: #f0f0f0,
        details-head-active: #e0e0e0,
        details-marker: #444444,
    };
    /// The body family. A `mono` run uses `mono-family`; empty falls back to the
    /// window default.
    in property <string> family: "";
    /// The code family. Slint's `font-family` does not resolve a generic
    /// `monospace`, so this must be the real family the engine measures with.
    in property <string> mono-family: "monospace";
    /// The chevron a `<details>` row draws; a zero `viewbox` uses the built-in
    /// path.
    in property <MdIconPath> marker-icon: { commands: "", viewbox: 0, stroke-width: 0 };
    /// The scroll offset of whatever contains this view; only read when culling.
    in property <length> viewport-y: 0px;
    /// The height of the window onto the document, for culling.
    in property <length> viewport-height: 0px;
    /// Skip items outside the viewport. Off by default so a view with no offset
    /// does not silently lose them.
    in property <bool> cull: false;
    /// The id of the link the pointer is inside. `in-out` so a caller can drive it
    /// too; empty draws no rule.
    in-out property <string> hovered-link: "";
    /// A link was clicked, with its URL.
    callback link-clicked(string);

    /// Which runs are open, index-aligned with `chunks`. The caller owns it so the
    /// state survives the re-layout a width change causes.
    in-out property <[bool]> section-open: [];
    /// A summary row was clicked, with the section's id.
    callback section-toggled(int);
    /// The document's height with every run at its current height. A caller sizes
    /// its scroll container from this rather than `content-height`, which is the
    /// fully-open height.
    out property <length> shown-height:
        root.chunks.length == 0 ? root.content-height : column.preferred-height;

    /// The view's width. Reported because a document is a function of its width
    /// and must be re-laid out. `init` covers the first value (a `changed` handler
    /// does not fire for it), `changed` the rest.
    callback resized(length);

    init => { root.resized(self.width); }
    changed width => { root.resized(self.width); }

    background: transparent;
    clip: true;

    // The runs, stacked. A `VerticalLayout` is what adds up the heights and moves
    // each later run up when one closes; covering content and shrinking a number
    // would reclaim no space. The runs stretch to the view's width so they measure
    // the engine-given height rather than their absolutely positioned items.
    column := VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;

        for chunk[index] in root.chunks: chunk-box := Rectangle {
            in property <bool> is-section: chunk.section-index >= 0;
            // 1 open, 0 closed. Animating this one number drives both the height
            // and the clip below.
            private property <float> progress: root.section-open[index] ? 1 : 0;
            animate progress {
                duration: 200ms;
                easing: cubic-bezier(0.215, 0.61, 0.355, 1);
            }

            /// Whether something at `y` inside this run is near enough to the
            /// viewport to draw. The run's layout position matters because a
            /// closed section moves every run below it.
            function in-window(y: length) -> bool {
                return y + chunk-box.y + root.viewport-y > -root.viewport-height
                    && y + chunk-box.y + root.viewport-y < 2 * root.viewport-height;
            }

            width: 100%;
            height: chunk.height - (self.is-section ? chunk.hidden * (1 - self.progress) : 0px);
            background: transparent;
            // Only a section clips: a shrinking run crops its own content.
            clip: true;

            if self.is-section: MdSectionRow {
                chunk: chunk;
                palette: root.palette;
                icon: root.marker-icon;
                open: root.section-open[index];
                toggled(at) => { root.section-toggled(at); }
            }

            // Items carry `y` relative to the run, not the document. One loop with
            // a conditional per kind, because the run's paint order is the
            // engine's: a chip's background is emitted before the text it sits
            // behind.
            for item in chunk.items: Rectangle {
                visible: !root.cull || in-window(item.y);
                // No box of its own: the items place themselves and share only
                // the culling.
                x: 0;
                y: 0;
                width: 0;
                height: 0;
                background: transparent;

                if item.kind == "text": MdText {
                    item: item;
                    text-color: MarkdownColors.resolve(root.palette, item.color);
                    family: root.family;
                    mono-family: root.mono-family;
                }

                if item.kind == "rect": MdRect {
                    item: item;
                    fill: MarkdownColors.resolve(root.palette, item.color);
                    outline: MarkdownColors.resolve(root.palette, item.border-color);
                }
            }

            for picture in chunk.images: MdImage {
                visible: !root.cull || in-window(picture.y);
                picture: picture;
                hovered-id: root.hovered-link;
                link-clicked(url) => { root.link-clicked(url); }
            }

            // Links last within their run so their boxes are over the text.
            for item in chunk.items: MdLink {
                // Culled so an off-screen link is neither painted, hit-tested nor
                // able to set `hovered-link`. The element is still allocated
                // because Slint has no `for … : if`.
                visible: (item.kind == "rect" && item.link-url != "")
                    && (!root.cull || in-window(item.y));
                box-item: item;
                link-color: root.palette.link;
                hovered-id: root.hovered-link;
                hover-changed(id, on) => { root.hovered-link = on ? id : ""; }
                link-clicked(url) => { root.link-clicked(url); }
            }
        }
    }
}
