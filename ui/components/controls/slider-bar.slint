import { Theme } from "../../theme.slint";
import { FocusManager } from "../../globals/focus.slint";
import { ScrollInput } from "../../globals/scroll.slint";
import { TooltipArea } from "./tooltip-area.slint";

// Range slider: a 3.5px track, lavender fill and a 12px thumb that scales on hover
// and while dragging. The value shows in the generic pointer tooltip.
//
// A press jumps the value to the pointer and moves follow while held. Moves are read
// from `TouchArea.moved`, which fires for any move the area grabbed: `dragging` is
// set only by a press that landed on the control, so a press elsewhere cannot drive
// this slider.
//
// `slider-enabled` dims the slider and disables its `TouchArea`.
export component SliderBar inherits Rectangle {
    in property <int> max: 100;
    in property <int> min: 0;
    in property <int> step: 1;
    in property <bool> slider-enabled: true;
    in-out property <int> value: 0;
    callback edited;

    width: 300px;
    height: 20px;
    opacity: root.slider-enabled ? 1.0 : 0.6;

    private property <float> percent: root.max > root.min
        ? clamp((root.value - root.min) * 1.0 / (root.max - root.min), 0, 1)
        : 0;

    /// Whether a drag started on this slider is in progress.
    private property <bool> dragging: false;

    // `value` snaps to `step`, and the thumb rests exactly on a step. The glide
    // between steps uses the scroll container's frame-time scaled lerp, so a step
    // reads as a short slide.
    //
    // Higher than the scroll container's 0.16 because these targets come from a
    // pointer that is already moving; a low share would leave the thumb behind
    // the cursor for the whole drag.
    private property <float> lerp: 0.45;

    private property <bool> gliding: false;
    private property <float> glide-percent: 0;
    private property <float> last-tick-ms: 0;

    /// Where the thumb and fill are drawn: the step the value is on, on its way
    /// there.
    private property <float> shown-percent: root.gliding ? root.glide-percent : root.percent;

    /// Starts the glide from the current drawn position. Called on every move as
    /// well as on press, so each new step is slid to rather than jumped.
    function start-glide() {
        if !root.gliding {
            root.glide-percent = root.shown-percent;
            root.last-tick-ms = ScrollInput.now-ms();
            root.gliding = true;
        }
    }

    glide-timer := Timer {
        interval: 8ms;
        running: root.gliding;
        triggered => {
            // Scale by real elapsed time so the glide is framerate-independent;
            // the upper bound only guards a whole-event-loop stall.
            root.glide-percent = root.glide-percent
                + (root.percent - root.glide-percent) * (1 - pow(
                    1 - root.lerp,
                    clamp((ScrollInput.now-ms() - root.last-tick-ms) / 1000, 0.004, 0.05) * 60,
                ));
            root.last-tick-ms = ScrollInput.now-ms();
            if abs(root.percent - root.glide-percent) <= 0.0005 {
                root.glide-percent = root.percent;
                root.gliding = false;
            }
        }
    }

    /// The value a pointer at `x` picks out: its position over the range, snapped
    /// to `step`. A non-positive step holds the minimum. The builtin `min`/`max`
    /// are not callable because the properties shadow them.
    function value-at(x: length) -> int {
        if root.max <= root.min || root.step <= 0 {
            return root.min;
        }
        return root.min + round(clamp(x / root.width, 0, 1) * (root.max - root.min) / root.step) * root.step;
    }

    track := Rectangle {
        x: 0;
        width: root.width;
        height: 3.5px;
        border-radius: 10px;
        background: #00000045;
    }

    fill := Rectangle {
        x: 0;
        width: root.shown-percent * root.width;
        height: 3.5px;
        border-radius: 10px;
        background: Theme.lavender;
    }

    // The thumb scales uniformly about its centre: 1.1 on hover, 0.9 while
    // dragging. Animating its size instead would re-target the height every frame
    // from the width and make the dot grow wide before it grows tall.
    thumb := Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 100px;
        background: Theme.lavender;
        x: root.shown-percent * root.width - self.width / 2;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale-x: root.dragging ? 0.9 : thumb-touch.has-hover ? 1.1 : 1.0;
        transform-scale-y: root.dragging ? 0.9 : thumb-touch.has-hover ? 1.1 : 1.0;
        animate transform-scale-x, transform-scale-y {
            duration: 200ms;
            easing: ease;
        }
    }

    // The value under the cursor, shown on hover and kept up through a drag.
    TooltipArea {
        text: round(root.percent * 100) + "%";
        hovered: thumb-touch.has-hover;
        pressed: root.dragging;
        wrap: false;
    }

    thumb-touch := TouchArea {
        width: root.width;
        height: root.height;
        mouse-cursor: pointer;
        enabled: root.slider-enabled;

        pointer-event(event) => {
            // Only press and release here; the drag is the `moved` handler below.
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                // Only a press on the 20px band, not just the 3.5px rail, starts
                // a drag.
                let on-track = self.mouse-x >= 0px && self.mouse-x <= self.width
                    && self.mouse-y >= 0px && self.mouse-y <= self.height;
                root.dragging = on-track;
                if on-track {
                    FocusManager.clear();
                    // Start the glide before writing the value, from the step the
                    // thumb is still on.
                    root.start-glide();
                    root.value = root.value-at(self.mouse-x);
                }
            } else if event.kind == PointerEventKind.cancel
                || (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                // A cancel (pointer left the window, or the slider was disabled)
                // ends the drag too, so the reached value still reaches `edited`.
                if root.dragging {
                    root.dragging = false;
                    root.edited();
                }
            }
        }

        moved => {
            if root.dragging {
                // Start the glide before writing the value so the new step slides
                // from the previous one.
                root.start-glide();
                root.value = root.value-at(self.mouse-x);
            }
        }
    }
}
