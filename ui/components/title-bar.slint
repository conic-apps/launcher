import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { CommandPaletteState } from "../globals/command-palette.slint";
import { NavigationButton } from "title-bar/navigation-button.slint";
import { TitleBarActionButton } from "title-bar/title-bar-action-button.slint";
import { SearchBar } from "title-bar/search-bar.slint";
import { NewsState } from "../globals/news.slint";
import { NotificationState } from "../globals/notifications.slint";

component LinuxWindowControlButton inherits Rectangle {
    in property <string> icon-commands;
    callback clicked;

    width: 18px;
    height: 18px;
    border-radius: 9px;
    background: touch.pressed ? Theme.overlay-0
        : touch.has-hover ? Theme.surface-2
        : Theme.surface-1;

    accessible-role: button;
    accessible-action-default => { root.clicked(); }

    Path {
        commands: root.icon-commands;
        viewbox-width: 512;
        viewbox-height: 512;
        width: 14px;
        height: 14px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        fill: transparent;
        stroke: Theme.default-text-color;
        stroke-width: 1px;
        stroke-line-cap: LineCap.round;
        stroke-line-join: LineJoin.round;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// One of the platform's own window controls, as the platform draws it. The glyph
// and fills come from `src/native/windows/caption.rs`. The controls are
// non-client area, so the system hit tests and clicks them and reports the
// pointer through `window-control-hovered` / `-pressed`.
//
// The fill is published as colours rather than baked into the bitmap so it can be
// interpolated, giving hover and press a transition.
export struct WindowControl {
    /// 0 minimize, 1 maximize (or restore), 2 close.
    index: int,
    /// The glyph at rest, in the caption's own ink.
    glyph: image,
    /// The same glyph in the ink that reads on `plate`.
    plate-glyph: image,
    /// Whether this control's fill is an opaque plate rather than a translucent
    /// wash, so its glyph changes ink. Only close is.
    plate: bool,
    /// The fill behind the glyph on hover.
    hover-fill: color,
    /// What the press adds on top of `hover-fill`. Compositing `a` and `b` gives
    /// `a + b - a·b`, so the increment is `(pressed - hover) / (1 - hover)`;
    /// `src/native/windows/caption.rs` computes it.
    press-fill: color,
}

// Draws one platform window control. No TouchArea or callback: the platform owns
// the presses, so a handler here would never fire. The platform places them with
// the same inset this component is given.
component SystemWindowControl inherits Rectangle {
    in property <WindowControl> control;
    in property <int> hovered: -1;
    in property <int> pressed: -1;

    width: 46px;
    height: 100%;

    // How far into the control the pointer is: 0 at rest, 1 hovered, 2 pressed.
    // Two numbers so press can be quicker than hover and ride on top of it.
    private property <float> hover-level: root.hovered == root.control.index ? 1 : 0;
    private property <float> press-level: root.pressed == root.control.index ? 1 : 0;
    animate hover-level {
        duration: 120ms;
        easing: ease-out;
    }
    animate press-level {
        duration: 60ms;
        easing: ease-out;
    }
    private property <float> level: root.hover-level + root.press-level;

    // Two fill layers whose opacities carry the ramp, because `level` runs 0, 1, 2.
    background: Colors.transparent;
    Rectangle {
        background: root.control.hover-fill;
        opacity: clamp(root.level, 0, 1);
    }

    Rectangle {
        background: root.control.press-fill;
        opacity: clamp(root.level - 1, 0, 1);
    }

    // The glyph in whichever ink the fill needs. Only close changes ink; the
    // others keep one image at full opacity so they are not composited twice
    // mid-transition, which would thin the glyph out.
    Image {
        source: root.control.glyph;
        width: 100%;
        height: 100%;
        opacity: root.control.plate ? 1 - clamp(root.level, 0, 1) : 1;
        // The artwork is rendered at this rectangle's device size.
        image-fit: fill;
    }

    Image {
        source: root.control.plate-glyph;
        width: 100%;
        height: 100%;
        opacity: root.control.plate ? clamp(root.level, 0, 1) : 0;
        image-fit: fill;
    }
}

// Title bar. macOS uses native traffic lights, Linux the custom controls below,
// and Windows the platform's own controls at the right-hand end.
export component TitleBar inherits Rectangle {
    in property <bool> macos: false;
    in property <bool> linux: false;
    in property <bool> windows: false;
    /// Whether the window is in native fullscreen, where macOS hides the
    /// traffic lights (see the leading controls below).
    in property <bool> fullscreen: false;
    /// How much of the right-hand end the platform's window controls take, and
    /// the controls with their state. Pushed in and placed by
    /// `src/native/windows/caption.rs`.
    in property <length> window-controls-inset: 0px;
    in property <[WindowControl]> window-controls: [];
    in property <int> window-control-hovered: -1;
    in property <int> window-control-pressed: -1;
    in property <string> search-placeholder;
    in property <string> search-hotkey;
    in property <string> current-page: "game";
    /// Whether background music is on at all; turning it off pauses the player and
    /// closes its panel.
    in property <bool> music-enabled: true;

    callback open-home();
    callback open-settings();
    callback open-search();
    callback open-news();
    callback open-notifications();
    callback toggle-music();
    callback maximize-or-fullscreen();
    callback minimize-window();
    callback close-window();

    // What the right-hand actions must clear: Linux's 86px of custom controls,
    // or the platform's controls plus a 10px gap.
    private property <length> controls-inset:
        root.linux ? 86px : root.window-controls-inset + 10px;

    private property <length> left-actions-start:
        root.macos && !root.fullscreen ? 90px : 16px;
    private property <length> right-actions-width:
        28px + 8px + 28px + (root.music-enabled ? 8px + 28px : 0px);
    private property <length> right-actions-start:
        root.width - root.right-actions-width - root.controls-inset;

    // Ionicons are 512-viewbox with stroke-width 32, so an 18px glyph scales the
    // stroke to 32 * 18 / 512 = 1.125px.
    private property <length> stroked-icon-width: 1.125px;
    // The window-control glyphs are not in the icon set (no SVG, platform
    // metrics), so they stay literals.
    private property <string> minimize-icon: "M128 256H384";
    private property <string> maximize-icon: "M144 144H368V368H144Z";
    private property <string> close-icon: "M160 160L352 352M352 160L160 352";

    height: 44px;
    background: Theme.titlebar-background.transparentize(0.2);

    // Windows' own window controls, flush right and as tall as the bar. Outside
    // `WindowMoveArea`: they are non-client area, so the system hit tests them.
    if root.windows: Rectangle {
        width: root.window-controls-inset;
        height: 100%;
        x: root.width - self.width;
        y: 0px;

        for control in root.window-controls: SystemWindowControl {
            x: root.window-controls-inset / 3 * control.index;
            y: 0px;
            control: control;
            hovered: root.window-control-hovered;
            pressed: root.window-control-pressed;
        }
    }

    // The drag surface is a sibling behind the controls, not their parent: as a
    // parent, `WindowMoveArea` would see a press meant for a button and drag the
    // window. macOS's double-click-to-zoom is disabled in
    // `native/macos/traffic_lights.rs`.
    WindowMoveArea {
        width: root.width;
        height: root.height;

        TouchArea {
            width: root.width;
            height: root.height;
            double-clicked => { root.maximize-or-fullscreen(); }
        }
    }

    // Left navigation actions (settings, home), at left:16, or left:90 on macOS
    // to clear the traffic lights — except in fullscreen, where AppKit hides them.
    Rectangle {
        x: root.left-actions-start;
        width: 60px;
        height: 28px;

        HorizontalLayout {
            spacing: 4px;

            NavigationButton {
                icon-commands: Icons.stroke-commands("settings");
                icon-stroke-width: root.stroked-icon-width;
                selected: root.current-page == "settings";
                accessible-label: @tr("Settings");
                clicked => { root.open-settings(); }
            }

            NavigationButton {
                icon-commands: Icons.stroke-commands("house");
                icon-stroke-width: root.stroked-icon-width;
                selected: root.current-page == "game";
                accessible-label: @tr("Home");
                clicked => { root.open-home(); }
            }
        }
    }

    if root.linux: Rectangle {
        width: 78px;
        height: 28px;
        x: root.width - self.width;
        y: (root.height - self.height) / 2;

        HorizontalLayout {
            x: 0px;
            y: 5px;
            width: 66px;
            height: 18px;
            spacing: 6px;
            alignment: start;
            cross-axis-alignment: center;

            LinuxWindowControlButton {
                icon-commands: root.minimize-icon;
                clicked => { root.minimize-window(); }
            }

            LinuxWindowControlButton {
                icon-commands: root.maximize-icon;
                clicked => { root.maximize-or-fullscreen(); }
            }

            LinuxWindowControlButton {
                icon-commands: root.close-icon;
                clicked => { root.close-window(); }
            }
        }
    }

    // Sized to its text and parked left of the right action group, so it moves
    // with those buttons rather than tracking the window centre.
    Rectangle {
        width: search-bar.content-width;
        x: root.right-actions-start - 8px - self.width;
        height: root.height;
        y: 0px;

        search-bar := SearchBar {
            width: 100%;
            height: 26px;
            x: 0px;
            placeholder: root.search-placeholder;
            hotkey: root.search-hotkey;
            active: CommandPaletteState.visible;
            activated => { root.open-search(); }
        }
    }

    // Right-side actions (news, notifications, then music). One container rather
    // than three absolute buttons, so news keeps its place when music is absent.
    Rectangle {
        width: root.right-actions-width;
        height: 28px;
        x: root.right-actions-start;

        HorizontalLayout {
            spacing: 8px;

            TitleBarActionButton {
                icon-commands: Icons.stroke-commands("newspaper");
                icon-stroke-width: root.stroked-icon-width;
                selected: NewsState.visible;
                accessible-label: @tr("News");
                clicked => { root.open-news(); }
            }

            TitleBarActionButton {
                icon-commands: Icons.stroke-commands("bell");
                icon-viewbox: Icons.viewbox("bell");
                icon-stroke-width: root.stroked-icon-width;
                selected: NotificationState.visible;
                accessible-label: @tr("Notifications");
                clicked => { root.open-notifications(); }
            }

            if root.music-enabled: TitleBarActionButton {
                icon-commands: Icons.stroke-commands("musical-notes");
                icon-stroke-width: root.stroked-icon-width;
                accessible-label: @tr("Music");
                clicked => { root.toggle-music(); }
            }
        }
    }
}
