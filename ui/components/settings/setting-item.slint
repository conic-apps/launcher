import { Theme } from "../../theme.slint";
import { AppIcon } from "../display/app-icon.slint";
import { Loading } from "../controls/loading.slint";
import { DescriptionTooltip } from "../../globals/tooltip.slint";
import { TooltipArea } from "../controls/tooltip-area.slint";
import { FocusManager } from "../../globals/focus.slint";

// A single settings row: a 40px icon column, a title/description text column and
// a right-aligned control area. Navigable rows show a chevron and the hover /
// active background; rows with a control use the caller's children.
export component SettingItem inherits Rectangle {
    in property <string> title: "";
    // Optional blue tag chips appended to the title (Java runtime versions).
    in property <[string]> tags: [];
    in property <string> description: "";
    in property <string> icon: "";
    /// Draw the icon and chevron stroke-only, suppressing the fill pass.
    in property <bool> icon-outline: false;
    in property <image> custom-icon;
    in property <bool> custom-icon-rounded: false;
    in property <bool> navigable: false;
    // Clickable but without the trailing chevron (collapse headers).
    in property <bool> clickable: false;
    in property <bool> resetable: false;
    /// Shows a spinner after the title while the row's value is loading.
    in property <bool> loading: false;
    /// A second string after the title, for the value the row is about. Slint's
    /// only slot, `@children`, is already spent on the chevron.
    in property <string> title-suffix: "";
    // Hover/pressed state a parent can drive for non-navigable clickable rows.
    in property <bool> hovered: false;
    in property <bool> pressed: false;
    in property <bool> item-disabled: false;
    // Whether this row is on the top / bottom edge of its group. The group cannot
    // round or clip its children, so the rows round their own corners.
    //
    // A `clip: true` + `border-radius` box would not do: the software renderer
    // clips rectangularly, ignoring the radius, and winit falls back to it when
    // femtovg's OpenGL context cannot be created.
    in property <bool> group-first: false;
    in property <bool> group-last: false;
    // Pin the description to this many lines, eliding the rest (0 = natural
    // height).
    //
    // This is what makes a repeated row measurable: Slint measures a repeated
    // element at its preferred (unwrapped) width but lays it out at the given
    // width, so wrapped lines are counted short. A `height` binding pins the cell
    // to min == max, and `max-lines` + `elide` keep the text inside it. The full
    // string goes to the description tooltip on hover.
    in property <int> description-lines: 0;

    callback clicked;
    callback reset;

    private property <length> group-radius: 8px;
    // The box allotted to each pinned description line. `DescriptionTooltipOverlay`
    // carries the same constant so the panel collapses onto the line it explains.
    private property <length> description-line-height: 18px;

    /// Hands the pinned description's window position and width to the tooltip.
    /// Called on hover and again from `follow-timer`, so the panel tracks the row.
    function push-description-anchor(x: length, y: length, w: length) {
        DescriptionTooltip.anchor-x = x;
        DescriptionTooltip.anchor-y = y;
        DescriptionTooltip.anchor-width = w;
    }

    /// This row's ownership number for the tooltip anchor; `0` means it never had
    /// it.
    private property <int> description-anchor-seq: 0;

    /// Whether the panel on screen is this row's.
    private property <bool> owns-description-anchor: root.description-anchor-seq != 0
        && root.description-anchor-seq == DescriptionTooltip.anchor-seq;

    /// Claims the anchor for this row and hands it the description. Only the
    /// opening hover calls this; follow-up ticks keep the existing claim.
    function claim-description-anchor(t: string) {
        root.description-anchor-seq = DescriptionTooltip.next-anchor-seq + 1;
        DescriptionTooltip.next-anchor-seq = root.description-anchor-seq;
        DescriptionTooltip.anchor-seq = root.description-anchor-seq;
        DescriptionTooltip.text = t;
    }

    width: 100%;
    background: root.pressed || ((root.navigable || root.clickable) && touch.pressed) ? Theme.setting-item-background-active
        : root.hovered || ((root.navigable || root.clickable) && touch.has-hover) ? Theme.setting-item-background-hover
        : Theme.setting-item-background;
    border-top-left-radius: root.group-first ? root.group-radius : 0px;
    border-top-right-radius: root.group-first ? root.group-radius : 0px;
    border-bottom-left-radius: root.group-last ? root.group-radius : 0px;
    border-bottom-right-radius: root.group-last ? root.group-radius : 0px;
    animate background { duration: 50ms; }
    opacity: root.item-disabled ? 0.6 : 1.0;

    // Declared before the content so controls stay on top and keep their pointer
    // events; empty areas fall through here. Always enabled so a click blurs any
    // focused field.
    touch := TouchArea {
        width: root.width;
        height: root.height;
        clicked => {
            FocusManager.clear();
            if (root.navigable || root.clickable) {
                root.clicked();
            }
        }
    }

    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 14px;
        padding-right: 16px;
        cross-axis-alignment: center;

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            cross-axis-alignment: center;

            if root.icon != "" || root.custom-icon.width > 0: icon-box := Rectangle {
                width: 40px;
                height: 28px;
                horizontal-stretch: 0;

                if root.custom-icon.width > 0: Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: root.custom-icon-rounded ? 10000px : 0px;
                    clip: true;

                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.custom-icon;
                    }
                }
                if root.custom-icon.width <= 0: AppIcon {
                    name: root.icon;
                    size: 26px;
                    no-fill: root.icon-outline;
                }
            }

            text-column := VerticalLayout {
                // `horizontal-stretch` and the elided title are what keep a long
                // translated title from taking width away from the control.
                horizontal-stretch: 1;
                min-width: 0px;
                spacing: 2px;
                alignment: center;
                cross-axis-alignment: start;

                if root.title != "": HorizontalLayout {
                    width: 100%;
                    spacing: 4px;
                    cross-axis-alignment: center;
                    alignment: start;

                    // The text is the only stretch item in this row, so the
                    // suffix and tags keep their natural width. The tooltip is
                    // attached only when the title is actually elided.
                    title-tooltip := TooltipArea {
                        horizontal-stretch: 1;
                        height: title-label.preferred-height;
                        // The row's own `touch` owns the click; a wrapping area
                        // here would swallow it. It still reports hover for the
                        // whole row, which is where the truncated title lives.
                        wrap: false;
                        hovered: touch.has-hover;
                        show-on-press: false;
                        text: title-label.preferred-width > title-label.width + 0.5px ? root.title : "";

                        title-label := Text {
                            width: 100%;
                            text: root.title;
                            font-size: 13px;
                            font-weight: Theme.font-weight-normal;
                            color: Theme.default-text-color.transparentize(0.1);
                            overflow: elide;
                        }
                    }

                    if root.title-suffix != "": title-suffix-box := HorizontalLayout {
                        // 8px on the right separates the suffix from the reset
                        // button and chevron; `Text` has no padding of its own.
                        cross-axis-alignment: center;
                        padding-right: 8px;

                        Text {
                            text: root.title-suffix;
                            font-size: 14px;
                            font-weight: Theme.font-weight-normal;
                            color: Theme.default-text-color.transparentize(0.1);
                            opacity: 0.8;
                        }
                    }

                    for tag[index] in root.tags: Rectangle {
                        height: 17px;
                        width: tag-label.preferred-width + 14px;
                        border-radius: 100px;
                        border-width: 1px;
                        border-color: Theme.blue;
                        background: transparent;

                        tag-label := Text {
                            text: tag;
                            font-size: 11px;
                            font-weight: Theme.font-weight-normal;
                            color: Theme.default-text-color.transparentize(0.1);
                        }
                    }

                    if root.resetable: reset-button := Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 3px;
                        background: reset-touch.has-hover ? #ffffff1c : transparent;
                        opacity: reset-touch.pressed ? 0.8 : 1.0;

                        AppIcon {
                            name: "refresh";
                            size: 16px;
                            icon-color: Theme.default-text-color.transparentize(0.1);
                        }

                        reset-touch := TouchArea {
                            clicked => { root.reset(); }
                        }
                    }

                    // Keep the box in the tree and animate opacity; a newly
                    // created element would simply appear.
                    loading-box := Rectangle {
                        width: 15px;
                        height: 15px;
                        background: transparent;
                        opacity: root.loading ? 1.0 : 0.0;
                        visible: root.loading || self.opacity > 0.001;
                        transform-scale: 80%;
                        animate opacity {
                            duration: 100ms;
                            easing: ease;
                        }

                        Loading {
                            size: 15px;
                            stroke-width: 8;
                            gap: 8;
                            icon-color: Theme.default-text-color.transparentize(0.1);
                        }
                    }
                }

                // The description at its natural height. Safe where the row is not
                // measured across a width it is not given — see `description-lines`.
                if root.description != "" && root.description-lines <= 0: Text {
                    width: 100%;
                    text: root.description;
                    font-size: 12px;
                    font-weight: Theme.font-weight-normal;
                    // The text colour at ~51% alpha.
                    color: Theme.default-text-color.with-alpha(0.509);
                    wrap: word-wrap;
                    line-height-factor: 1.1;
                }

                // A description pinned to `description-lines` lines; the hover opens
                // the full string.
                if root.description != "" && root.description-lines > 0: pinned-box := Rectangle {
                    // `width: 100%` is load-bearing. The `if` makes this a repeated
                    // element with no synthesized layout info, so its
                    // `preferred-width` is 0 and the `start`-aligned column would
                    // give it a zero width.
                    width: 100%;
                    height: root.description-lines * root.description-line-height;
                    background: transparent;

                    // Only text that does not fit its given lines is worth a
                    // tooltip.
                    property <bool> clipped: pinned-text.preferred-width > pinned-text.width + 0.5px;

                    pinned-text := Text {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        text: root.description;
                        font-size: 12px;
                        font-weight: Theme.font-weight-normal;
                        color: Theme.default-text-color.with-alpha(0.509);
                        wrap: word-wrap;
                        line-height-factor: 1.1;
                        max-lines: root.description-lines;
                        overflow: elide;
                    }

                    pinned-touch := TouchArea {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        // A `TouchArea` grabs the press, so the row's own `touch`
                        // never sees this click; repeat its behaviour here.
                        clicked => {
                            FocusManager.clear();
                            if (root.navigable || root.clickable) {
                                root.clicked();
                            }
                        }
                        // `pointer-event` reports `Cancel` on losing hover only
                        // while it holds the grab, so watch the property instead.
                        changed has-hover => {
                            if self.has-hover && parent.clipped {
                                root.claim-description-anchor(root.description);
                                root.push-description-anchor(
                                    parent.absolute-position.x,
                                    parent.absolute-position.y,
                                    parent.width,
                                );
                            }
                            DescriptionTooltip.over-description = self.has-hover && parent.clipped;
                        }
                    }

                    // Keeps the panel's anchor on this box while the panel is this
                    // row's, so it travels with content scrolled out from under a
                    // still pointer (a trackpad never moves it).
                    //
                    // A tick rather than `changed`: `absolute-position` is a native
                    // call with no registered dependency, so `changed` never fires
                    // when the list scrolls. The writes are no-ops when the anchor
                    // has not moved.
                    follow-timer := Timer {
                        interval: 8ms;
                        running: root.owns-description-anchor
                            && (DescriptionTooltip.over-description || DescriptionTooltip.over-panel);
                        triggered => {
                            root.push-description-anchor(
                                pinned-box.absolute-position.x,
                                pinned-box.absolute-position.y,
                                pinned-box.width,
                            );
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            horizontal-stretch: 0;
            cross-axis-alignment: center;

            if root.navigable: AppIcon {
                name: "chevron-forward";
                size: 17px;
                icon-color: Theme.default-text-color.transparentize(0.1);
                no-fill: root.icon-outline;
            }

            if root.navigable: Rectangle {
                width: 4px;
                background: transparent;
            }

            @children
        }
    }

    if root.item-disabled: TouchArea {
        width: root.width;
        height: root.height;
    }
}
