import { Theme } from "../../theme.slint";
import { Icons } from "../../icons.slint";

// Icon renderer.
//
// Icons are SVG path data at their own view box, and the caller passes an explicit
// `icon-color` (default: body text at 90% opacity). `build.rs` splits every shape
// into the pass its own paint calls for, so one colour has to serve both — except
// where a shape is not painted at all, which is what `no-fill` is.
//
// Stroke width is in the icon's view box units, converted to element pixels: an
// 18px glyph on a 512 view box with stroke-width 32 becomes 1.125px.
export component AppIcon inherits Rectangle {
    in property <string> name;
    in property <length> size: 20px;
    in property <color> icon-color: Theme.default-text-color.transparentize(0.1);
    /// Suppresses the fill pass while the stroke keeps `icon-color`. A separate
    /// switch rather than a second colour, because only the fill is dropped.
    in property <bool> no-fill: false;

    width: size;
    height: size;

    Path {
        commands: Icons.stroke-commands(root.name);
        viewbox-width: Icons.viewbox(root.name);
        viewbox-height: Icons.viewbox(root.name);
        width: root.width;
        height: root.height;
        fill: transparent;
        stroke: root.icon-color;
        stroke-width: root.size * Icons.stroke-width(root.name) / Icons.viewbox(root.name);
        stroke-line-cap: LineCap.round;
        stroke-line-join: LineJoin.round;
    }

    Path {
        commands: Icons.fill-commands(root.name);
        viewbox-width: Icons.viewbox(root.name);
        viewbox-height: Icons.viewbox(root.name);
        width: root.width;
        height: root.height;
        fill: root.no-fill ? transparent : root.icon-color;
        stroke: transparent;
    }
}
