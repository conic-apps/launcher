import { Theme } from "../../theme.slint";
import { Icons } from "../../icons.slint";

// Icon renderer.
//
// Icons are SVG path data at their own view box. The caller passes an explicit
// `icon-color` (default: body text at 90% opacity).
//
// `build.rs` splits every icon's geometry into the pass each shape's own paint
// calls for, so `icon-color` has to stay one colour for both — except where a
// shape is not painted at all, which is what `no-fill` is.
//
// Stroke width is expressed in the icon's view box units and converted to
// element pixels the same way the title bar does it: an 18px glyph on a 512
// view box with stroke-width 32 becomes 18 * 32 / 512 = 1.125px.
export component AppIcon inherits Rectangle {
    in property <string> name;
    in property <length> size: 20px;
    in property <color> icon-color: Theme.default-text-color.transparentize(0.1);
    /// Suppresses the fill pass while the stroke keeps `icon-color`. A separate
    /// switch rather than a second colour, because only the fill is dropped.
    in property <bool> no-fill: false;

    width: size;
    height: size;

    Path {
        commands: Icons.stroke-commands(root.name);
        viewbox-width: Icons.viewbox(root.name);
        viewbox-height: Icons.viewbox(root.name);
        width: root.width;
        height: root.height;
        fill: transparent;
        stroke: root.icon-color;
        stroke-width: root.size * Icons.stroke-width(root.name) / Icons.viewbox(root.name);
        stroke-line-cap: LineCap.round;
        stroke-line-join: LineJoin.round;
    }

    Path {
        commands: Icons.fill-commands(root.name);
        viewbox-width: Icons.viewbox(root.name);
        viewbox-height: Icons.viewbox(root.name);
        width: root.width;
        height: root.height;
        fill: root.no-fill ? transparent : root.icon-color;
        stroke: transparent;
    }
}
