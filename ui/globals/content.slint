// Content overlay state. Only one panel is open at a time; the domain state
// lives in Rust and the view writes back only pure UI state (search, selection).

// The Markdown renderer's laid-out body types (`ui/components/markdown/`).
import {
    MdItem,
    MarkdownImage,
    MdChunk,
} from "../components/markdown/markdown-view.slint";

/// One tag on a card. Its `kind` picks the surface colour.
export struct CardTag {
    text: string,
    /// A dimmed label drawn before the text with no gap; only the saves' "last
    /// played:" tag has one.
    label: string,
    /// "loader-fabric" | "loader-forge" | "loader-quilt" | "loader-neoforge"
    /// | "loader-liteloader" | "version" | "game-mode-survival"
    /// | "game-mode-creative" | "game-mode-adventure" | "game-mode-spectator"
    /// | "command-enabled" | "last-played" | "plain"
    kind: string,
    /// When `kind` is "last-played", the parts `GameTime.last-played` formats.
    /// The tag translates these rather than `text`, which Rust cannot translate.
    time-kind: string,
    time-hours: int,
    time-month: int,
    time-day: int,
    time-year: int,
}

/// One card of a content grid.
///
/// Rust lays the cards out because the column count comes from the panel's
/// width. The model is rewritten in place with `set_row_data`, so a resize keeps
/// each card's hover, decoded icon and in-flight animation.
export struct ContentCard {
    x: length,
    y: length,
    width: length,
    height: length,
    /// Whether the card is drawn.
    in-view: bool,
    /// What `select` reports: a project id, a local file path or a save folder name.
    id: string,
    /// The URL a card's link button opens (remote lists only).
    link: string,
    title: string,
    subtitle: string,
    /// Whether the subtitle line is drawn; a card without one omits the row.
    has-subtitle: bool,
    description: string,
    tags: [CardTag],
    /// The decoded icon; falls back to the bundled unknown-server texture.
    icon: image,
    /// The icon is still being fetched, so the card draws a spinner in its place.
    icon-loading: bool,
    /// The trailing action column: "" | "favorite" (heart + link) | "file"
    /// (folder + trash).
    action-kind: string,
    /// The saves' play button, which floats over the icon.
    shows-play: bool,
    favorited: bool,
    /// A disabled local mod: struck-through name and a dimmed card.
    mod-disabled: bool,
    /// The saves' expanded state: the card lifts and its extra panel slides out.
    selected: bool,
    /// Whether a selected save expands upwards (set within 160px of the bottom).
    expand-up: bool,
    /// A save's spawn point for its world map (`level.dat`'s `Data.spawn.pos`).
    /// `0, 0` when absent, asking the world for its own spawn.
    spawn-x: int,
    spawn-z: int,
}

/// One filter chip of the search panel's filter rows.
export struct FilterChip {
    /// The option itself, or a CurseForge category's numeric id as a string.
    value: string,
    /// The chip's label; ignored when `translated` is set.
    text: string,
    /// Resolve the label through `ContentText.chip-label` from `label-key` so it
    /// re-translates with the locale. The key is not always the value.
    translated: bool,
    label-key: string,
    selected: bool,
    /// The selected fill: "" (lavender) | "fabric" | "forge" | "neoforge"
    /// | "quilt" | "minecraft-version" | "favorites".
    accent: string,
}

/// One filter row. The version row is the paginated one and the only one that
/// draws its chips in a carousel rather than wrapping.
export struct FilterRow {
    /// "loader" | "version" | "category", resolved by `ContentText.row-label`.
    label: string,
    chips: [FilterChip],
    paginated: bool,
    /// The row's height, computed in Rust from the chips' measured widths. A
    /// wrapping `FlexboxLayout` measures itself at its preferred width, not the
    /// width it is given, so it cannot supply this.
    height: length,
}

/// One page button of the pagination bar.
export struct PageButton {
    text: string,
    /// -1 for an ellipsis.
    page: int,
}

/// One image of a strip whose items have a fixed height and a width following
/// the image's aspect ratio. Rust supplies the ratio because Slint cannot read an
/// image's natural size.
export struct GalleryShot {
    image: image,
    /// width / height of the decoded bitmap.
    ratio: float,
}

/// The overlay layer's state. Which panel is open, what it is showing, and the
/// grids behind it.
export global ContentState {
    /// "" | "saves" | "mods" | "resourcepacks" | "screenshots" | "packs"
    in-out property <string> open-panel: "";
    /// "" | "modrinth" | "curseforge" — the site the open detail panel belongs
    /// to; the view only reads whether it is empty.
    in-out property <string> open-detail: "";
    /// The id the open detail panel is showing — a project id either way, the
    /// CurseForge numeric id as a string.
    in-out property <string> detail-id: "";
    /// The height Rust gave the visible grid. Cards are positioned absolutely
    /// and contribute nothing to their parent, so a measured height would be
    /// zero and the panel's `ScrollView` would stop scrolling. One per grid,
    /// because the other lists keep loading behind the visible one.
    in-out property <length> saves-grid-height: 0px;
    in-out property <length> local-mods-grid-height: 0px;
    in-out property <length> local-resourcepacks-grid-height: 0px;
    in-out property <length> remote-grid-height: 0px;

    /// The panel's height, for the "nothing here" placeholder.
    in-out property <length> panel-height: 0px;

    /// A grid reports the width it has to lay out in; Rust turns it into a
    /// column count and rewrites the cards' geometry in place.
    callback grid-resized(length, length);

    in-out property <[ContentCard]> saves: [];
    in-out property <bool> saves-loading: false;
    in-out property <[ContentCard]> local-mods: [];
    in-out property <bool> local-mods-loading: false;
    in-out property <[ContentCard]> local-resourcepacks: [];
    in-out property <bool> local-resourcepacks-loading: false;

    /// Which sub-view is showing: "local" | "modrinth" | "curseforge".
    in-out property <string> source: "local";
    /// "mods" | "resourcepacks" | "packs" — which panel the remote list belongs
    /// to, deciding the card's tags and where a download lands.
    in-out property <string> remote-kind: "mods";
    in-out property <[ContentCard]> remote-cards: [];
    /// The spinner shows while there is no result yet or a request is in flight.
    in-out property <bool> remote-loading: true;
    /// The last remote search failed, so the panels draw the failure placeholder.
    in-out property <bool> remote-failed: false;

    in-out property <bool> detail-loading: false;
    in-out property <string> detail-title: "";
    in-out property <image> detail-icon;
    /// The repository URL the link opens; `detail-source-label` is its display
    /// form.
    in-out property <string> detail-source: "";
    /// "owner/repo" when the source is GitHub, and the URL otherwise.
    in-out property <string> detail-source-label: "";
    /// Whether the source is GitHub, which decides the entry's glyph.
    in-out property <bool> detail-source-is-github: false;
    in-out property <string> detail-downloads: "";
    in-out property <string> detail-followers: "";
    in-out property <bool> detail-has-followers: false;
    in-out property <string> detail-description: "";
    /// The body before rendering: Modrinth Markdown or CurseForge HTML. Rust
    /// lays it out and fills the properties below; this string is never drawn.
    in-out property <string> detail-body: "";
    /// The laid-out body, as the runs a view stacks. Each run carries its own
    /// items and bitmaps because a run is what moves when a `<details>` toggles.
    in-out property <[MdChunk]> detail-body-chunks: [];
    /// The engine's height with every `<details>` open. Used while there are no
    /// runs to measure, between the engine answering and the rows being pushed.
    in-out property <length> detail-body-height: 0px;
    /// Which runs are open, index-aligned with `detail-body-chunks`. Rust owns it
    /// so the state survives a width-change re-layout.
    in-out property <[bool]> detail-body-section-open: [];
    /// A `<details>` summary row was clicked; the parameter is the run's index.
    callback body-section-toggled(int);
    /// The body link the pointer is over, cleared when the body scrolls away.
    in-out property <string> detail-body-hovered: "";
    /// The monospace family code is drawn in. Slint's `font-family` takes a name
    /// rather than a generic, so Rust names the embedded Fira Code here.
    in-out property <string> detail-body-mono-family: "";
    /// The body needs laying out for this width, in logical pixels. Body links
    /// open through `open-url`, the same path as the header's repository link.
    callback body-resized(length);
    /// Whether the body box is drawn even when empty. The Modrinth panels render
    /// it unconditionally; the CurseForge ones only when there is a description.
    in-out property <bool> detail-body-always: false;
    in-out property <[GalleryShot]> detail-gallery: [];
    in-out property <bool> detail-favorited: false;
    /// The heart + download/remove row belongs to the mod and resource-pack
    /// panels; a pack has no remove and is never "installed".
    in-out property <bool> detail-has-install: true;
    in-out property <bool> detail-installed: false;
    in-out property <string> detail-installed-version: "";
    in-out property <bool> detail-checking-installed: false;
    in-out property <bool> detail-operating: false;
    /// The in-flight install/remove download: `value`/`max` plus a formatted byte
    /// label. `max` is 0 while the size is unknown and the bar is hidden.
    in-out property <float> detail-progress: 0;
    in-out property <float> detail-progress-max: 0;
    in-out property <string> detail-progress-text: "";
    /// Whether this panel has an installed state at all; a pack only downloads.
    in-out property <bool> detail-can-remove: true;

    in-out property <[GalleryShot]> screenshots: [];
    in-out property <bool> screenshots-loading: false;
    in-out property <int> screenshot-index: 0;
    /// The image the stage shows. Kept separate because a model index inside a
    /// binding would re-read the whole model.
    in-out property <image> current-screenshot;

    /// Closes whichever panel is open (scrim click and Escape).
    callback close();
    /// A detail panel was closed, leaving the list underneath open.
    callback close-detail();
    /// The mods/resource-packs/packs panels' source switcher.
    callback set-source(string);
    /// A card was clicked.
    callback select-card(string);
    /// A saves or local-mods folder button.
    callback open-path(string);
    /// A local mod's / resource pack's / pack's delete button. The saves grid
    /// uses `request-delete-save` instead; this one is currently inert.
    callback delete-save(string);
    /// The saves' delete button: opens `ConfirmDeleteSave` rather than deleting.
    callback request-delete-save(string, string);
    /// The remote grids' link button or the detail panel's source link.
    callback open-url(string);
    callback toggle-favorite(string);
    callback download();
    callback remove();
    /// A save was selected, or deselected with an empty id.
    callback select-save(string);
    /// The screenshots viewer.
    callback set-screenshot(int);
    callback screenshot-next();
    callback screenshot-prev();
}

/// The search panel's own state, for whichever remote list is on screen. Kept
/// apart from `ContentState` because it is a self-contained form.
export global ContentSearch {
    in-out property <string> query: "";
    in-out property <[FilterRow]> filters: [];
    /// Which row index is the paginated (version) one; -1 when there is none.
    in-out property <int> version-row: -1;
    in-out property <int> version-page: 0;
    in-out property <int> version-page-count: 0;
    /// Every version the filter offers. The carousel draws the whole track and
    /// translates it by page.
    in-out property <[FilterChip]> version-chips: [];
    /// How far the track is scrolled left. Rust sums the chips' measured widths;
    /// Slint cannot read a repeated element's geometry from outside.
    in-out property <length> version-offset: 0px;
    in-out property <[PageButton]> pages: [];
    in-out property <int> current-page: 1;
    in-out property <int> total-pages: 0;

    callback search();
    callback chip-clicked(string);
    /// A version chip reports its measured width, keyed by value rather than
    /// position so other rows' reports do not land on the version slots.
    callback chip-measured(string, length);
    callback version-page-prev();
    callback version-page-next();
    callback go-to-page(int);
}


/// The content overlays' translated strings.
///
/// Labels live here because a string Rust pushes into a model would not follow a
/// language change, while an `@tr` binding re-evaluates. The context is explicit
/// because these are not one component's own strings.
export global ContentText {
    /// The local mods' disabled marker; the prefix carries its trailing space.
    out property <string> disabled-prefix: @tr("ContentText" => "[Disabled] ");

    /// The loader names, never translated.
    public pure function loader(key: string) -> string {
        if key == "fabric" { return "Fabric"; }
        if key == "forge" { return "Forge"; }
        if key == "neoforge" { return "NeoForge"; }
        if key == "quilt" { return "Quilt"; }
        if key == "liteloader" { return "LiteLoader"; }
        return key;
    }

    /// A category chip's label. `platform` and `kind` are part of the lookup
    /// because the lists have their own category tables and the same slug can
    /// mean something different in two of them.
    public pure function category(kind: string, platform: string, key: string) -> string {
        if kind == "mods" && platform == "curseforge" && key == "adventure-rpg" {
            return @tr("CategoryModsCurseforge" => "Adventure & RPG");
        }
        if kind == "mods" && platform == "curseforge" && key == "armor-weapons-tools" {
            return @tr("CategoryModsCurseforge" => "Armor, Tools & Weapons");
        }
        if kind == "mods" && platform == "curseforge" && key == "world-gen" {
            return @tr("CategoryModsCurseforge" => "World Generation");
        }
        if kind == "mods" && platform == "curseforge" && key == "technology" {
            return @tr("CategoryModsCurseforge" => "Technology");
        }
        if kind == "mods" && platform == "curseforge" && key == "magic" {
            return @tr("CategoryModsCurseforge" => "Magic");
        }
        if kind == "mods" && platform == "curseforge" && key == "storage" {
            return @tr("CategoryModsCurseforge" => "Storage");
        }
        if kind == "mods" && platform == "curseforge" && key == "library-api" {
            return @tr("CategoryModsCurseforge" => "Library & API");
        }
        if kind == "mods" && platform == "curseforge" && key == "map-information" {
            return @tr("CategoryModsCurseforge" => "Maps & Info");
        }
        if kind == "mods" && platform == "curseforge" && key == "utility-qol" {
            return @tr("CategoryModsCurseforge" => "Utility & QoL");
        }
        if kind == "mods" && platform == "curseforge" && key == "server-utility" {
            return @tr("CategoryModsCurseforge" => "Server Utility");
        }
        if kind == "mods" && platform == "curseforge" && key == "mc-food" {
            return @tr("CategoryModsCurseforge" => "Food");
        }
        if kind == "mods" && platform == "curseforge" && key == "performance" {
            return @tr("CategoryModsCurseforge" => "Performance");
        }
        if kind == "mods" && platform == "curseforge" && key == "bug-fixes" {
            return @tr("CategoryModsCurseforge" => "Bug Fixes");
        }
        if kind == "mods" && platform == "curseforge" && key == "redstone" {
            return @tr("CategoryModsCurseforge" => "Redstone");
        }
        if kind == "mods" && platform == "curseforge" && key == "cosmetic" {
