// What the Lenis-style scroll containers need from the platform.
//
// A wheel notch is a *distance*, so it accumulates into a target the offset eases
// after; a trackpad's deltas *are* a motion, so easing them would make the content
// trail the hand — and easing macOS's momentum would stall it at the moment of
// release.
//
// Slint hands over the delta and the modifiers only, so both answers come from the
// platform (`app/src/ui/services/scroll.rs`).

export enum ScrollSource {
    /// A classic wheel — or a platform the classifier cannot tell apart, which
    /// takes the same path: a distance the offset eases after.
    wheel,
    /// A trackpad with the fingers on it: the deltas are the motion itself.
    trackpad,
    /// The momentum a trackpad keeps generating after the fingers left: also the
    /// motion itself, because macOS derived it from the velocity the gesture
    /// ended at. Kept apart from `trackpad` because a run says which phase an
    /// event belonged to, and because a softer tail would be tuned here.
    momentum,
}

export global ScrollInput {
    /// What generated the scroll event being handled right now. Pulled from
    /// inside a `scroll-event` handler, once per event: it describes the event
    /// that is being dispatched, not the one before it.
    callback source() -> ScrollSource;

    /// Monotonic milliseconds since startup. The smoothing scales its per-tick
    /// step by the real elapsed time the way Lenis does, so the glide lasts the
    /// same on a 120Hz display as on a 60Hz one; Slint has no clock to read
    /// (its `DateNow` reports a date, not an instant), so it comes from Rust.
    callback now-ms() -> float;
}
