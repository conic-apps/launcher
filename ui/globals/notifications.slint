/// A completed notification shown by the notification centre.
export struct NotificationItem {
    id: int,
    kind: string,
    /// Literal title, empty when the kind's translated title is used or the
    /// notice has no title at all.
    title: string,
    /// Literal body, empty when the kind's translated template is used.
    body: string,
    /// Values for the kind's template placeholders, in order.
    args: [string],
    icon: string,
    has-action: bool,
}

export global NotificationState {
    in-out property <bool> visible: false;
    in-out property <[NotificationItem]> notifications: [];
    /// The floating previews in the top-right corner. Its rows mirror
    /// `notifications` until one expires, at which point only the preview goes
    /// away and the centre keeps the card.
    in-out property <[NotificationItem]> toasts: [];
    in-out property <int> notification-count: 0;

    callback close();
    callback clear();
    callback dismiss(int);
    /// A preview finished its exit and should leave `toasts` alone.
    callback expire(int);
    /// Drops every preview, e.g. when the centre opens.
    callback expire-all();
    callback activate(int);
}

export global NotificationText {
    pure function arg(item: NotificationItem, index: int) -> string {
        return index < item.args.length ? item.args[index] : "";
    }

    /// The card's optional heading.
    ///
    /// A literal title on the notice wins; otherwise a known kind supplies its
    /// translated one. Empty means no title, and the card keeps the single-body
    /// layout every notice had before titles were optional.
    public pure function notification-title(item: NotificationItem) -> string {
        if item.title != "" {
            return item.title;
        }
        if item.kind == "game-crashed" {
            return @tr("NotificationText" => "Game did not exit normally");
        }
        return "";
    }

    public pure function notification-body(item: NotificationItem) -> string {
        if item.body != "" {
            return item.body;
        }
        if item.kind == "game-crashed" {
            return @tr("NotificationText" => "{} seems to have crashed. Click here to view the crash report", arg(item, 0));
        }
        if item.kind == "update-ready" {
            return @tr("NotificationText" => "Version {} will be applied when the launcher exits", arg(item, 0));
        }
        if item.kind == "task-error" {
            return @tr("NotificationText" => "{}", arg(item, 0));
        }
        if item.kind == "task-cancelled" {
            return @tr("NotificationText" => "The task was cancelled");
        }
        if item.kind == "task-finished" {
            if arg(item, 1) == "content-download" || arg(item, 1) == "library-download" {
                return @tr("NotificationText" => "{} downloaded. Click here to view", arg(item, 0));
            }
            if arg(item, 1) == "modpack-install" || arg(item, 1) == "game-install" {
                return @tr("NotificationText" => "{} installed. Click here to view", arg(item, 0));
            }
            return @tr("NotificationText" => "The task finished");
        }
        if item.kind == "setup-skipped" {
            return @tr("NotificationText" => "Click here to return to first-run setup");
        }
        if item.kind == "minecraft-released" {
            return @tr("NotificationText" => "Minecraft {} has been released. Click here for details", arg(item, 0));
        }
        return "";
    }
}
