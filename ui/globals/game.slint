// Game view state. Domain state lives in Rust and is pushed in; pure-UI state
// (search, sort/group mode, selected account) is written here and read back by
// Rust through callbacks.

/// A flattened row of the instance list: a group header or an instance card.
/// Rust expands the grouping so the view can render with a single `for`.
export struct GameRow {
    /// "group" or "instance".
    kind: string,
    /// Group key or instance id.
    key: string,
    /// Identity of the rendered row. A starred instance is listed twice, so the
    /// instance id alone is not unique.
    uid: string,
    /// Row position and height inside the list content. `row-y` avoids clashing
    /// with the element `y` property.
    row-y: length,
    height: length,
    /// Instance name (instance rows only).
    name: string,
    /// "favorites" | "all" | "literal" (group rows only).
    title-kind: string,
    /// Group title when `title-kind == "literal"`.
    title-literal: string,
    /// Number of instances in the group.
    count: int,
    /// Loader display name, or "Vanilla" (instance rows only).
    loader: string,
    /// Lower-case loader key used for the accent colour.
    loader-key: string,
    /// Relative-time kind for `GameTime.last-played`.
    last-played-kind: string,
    last-played-hours: int,
    last-played-month: int,
    last-played-day: int,
    last-played-year: int,
    starred: bool,
    current: bool,
    /// Whether the group is collapsed.
    collapsed: bool,
    /// Row opacity target. A collapsed group's cards stay in the model with
    /// opacity 0 so their `for` items survive and can glide/fade.
    opacity: float,
    /// False until a newly added row has been revealed; the view slides it in.
    appear: bool,
    /// Whether the next position change animates a reorder rather than a group
    /// collapse.
    flip: bool,
    /// Whether the instance has a custom background.
    has-background: bool,
    /// The decoded custom background, drawn on the card's right half.
    background: image,
}

/// One account entry of the footer account dropdown.
export struct AccountItem {
    /// Stable account key (`microsoft-<uuid>` etc.).
    key: string,
    name: string,
    /// "Microsoft" | "Offline" | "Yggdrasil".
    kind: string,
    /// The head the row's avatar shows, built by Rust because only it can crop a
    /// skin.
    avatar: image,
}

/// Relative-time and play-time formatting helpers, kept here so `@tr` re-evaluates
/// on a locale change.
export global GameTime {
    /// A year-month-day date, used for relative times and version release dates.
    public pure function year-month-day(month: int, day: int, year: int) -> string {
        return @tr("GameTime" => "{}/{}/{}", month, day, year);
    }

    public pure function last-played(kind: string, hours: int, month: int, day: int, year: int, ) -> string {
        if kind == "just-now" {
            return @tr("GameTime" => "Just now");
        }
        if kind == "hours-ago" {
            return hours == 1
                ? @tr("GameTime" => "1 hour ago")
                : @tr("GameTime" => "{} hours ago", hours);
        }
        if kind == "yesterday" {
            return @tr("GameTime" => "Yesterday");
        }
        if kind == "month-day" {
            return @tr("GameTime" => "{}/{}", month, day);
        }
        if kind == "year-month-day" {
            return self.year-month-day(month, day, year);
        }
        return @tr("GameTime" => "Never played");
    }

    public pure function play-time(kind: string, value: string) -> string {
        if kind == "seconds" {
            return @tr("GameTime" => "{} sec", value);
        }
        if kind == "minutes" {
            return @tr("GameTime" => "{} min", value);
        }
        if kind == "hours" {
            return @tr("GameTime" => "{} hr", value);
        }
        return "";
    }
}

/// Entrance animation state of the game view. `GameView` resets `played` on every
/// instantiation and flips it true once the list has been measured.
export global GameIntro {
    in-out property <bool> played: false;
}

export global GameState {
    in-out property <[GameRow]> rows: [];
    /// Total scrollable height of the instance list content.
    in-out property <length> list-content-height: 0px;
    /// Bumped when the current instance changes from the keyboard or
    /// Alt/Option + wheel, so the list can glide to its row.
    in-out property <int> selection-serial: 0;
    /// A group header's content position, and the serial that asks the list to
    /// bring it below the sort/group bar after expansion.
    in-out property <length> group-scroll-y: 0px;
    in-out property <int> group-scroll-serial: 0;
    /// The current instance's row position and size, used to centre it on open.
    in-out property <length> current-row-y: -1px;
    in-out property <length> current-row-height: 0px;
    in-out property <bool> has-instances: false;
    in-out property <bool> show-placeholder: false;
    in-out property <string> search-query: "";
    // "playtime" | "name" | "version" | "lastplay"
    in-out property <string> sort-mode: "playtime";
    // "none" | "loader"
    in-out property <string> group-mode: "none";

    in-out property <bool> has-current: false;
    in-out property <string> current-name: "";
    /// The current instance's id, which the launch view resolves back into an
    /// `Instance`.
    in-out property <string> current-id: "";
    in-out property <string> current-minecraft: "";
    in-out property <bool> current-has-loader: false;
    in-out property <string> current-loader: "";
    in-out property <string> current-loader-version: "";
    in-out property <string> current-last-played-kind: "never";
    in-out property <int> current-last-played-hours: 0;
    in-out property <int> current-last-played-month: 0;
    in-out property <int> current-last-played-day: 0;
    in-out property <int> current-last-played-year: 0;
    in-out property <bool> current-has-playtime: false;
    in-out property <string> current-playtime-kind: "";
    in-out property <string> current-playtime-value: "";
    in-out property <bool> current-starred: false;

    // The four content counts: lengths of the same parsed lists the content
    // overlay draws from, not a second scan of the folder.
    in-out property <int> content-saves: 0;
    in-out property <int> content-mods: 0;
    in-out property <int> content-resourcepacks: 0;
    in-out property <int> content-screenshots: 0;
    /// The icons the game view's preview rows draw, up to five of each kind.
    in-out property <[image]> preview-saves: [];
    in-out property <[image]> preview-mods: [];
    in-out property <[image]> preview-resourcepacks: [];
    in-out property <[image]> preview-screenshots: [];
    /// Whether a kind's list is still being parsed, one flag per kind because
    /// they settle at very different times.
    in-out property <bool> content-loading-saves: false;
    in-out property <bool> content-loading-mods: false;
    in-out property <bool> content-loading-resourcepacks: false;
    in-out property <bool> content-loading-screenshots: false;
    // Suffix after a content count. Only Chinese uses one; Rust derives it from
    // the language so it is not a gettext key.
    in-out property <string> count-unit: "";

    in-out property <[AccountItem]> accounts: [];
    in-out property <bool> has-account: false;
    in-out property <string> current-account-key: "";
    in-out property <string> current-account-name: "";
    in-out property <string> current-account-kind: "";
    /// The head on the footer's avatar; the wide Steve when no account is selected.
    in-out property <image> current-account-avatar;

    /// Called once at startup and whenever something changed on disk.
    callback refresh();
    /// Reloads the list and selects the given instance as it lands. Used after a
    /// create, where the instance is only in the new listing.
    callback refresh-selecting(string);
    /// An account was added or removed: pick one when none is selected.
    callback select-first-account();
    /// An instance card was clicked.
    callback select-instance(string);
    /// Moves the current instance by one in the displayed order: -1 previous, 1
    /// next. Used by Up/Down and Alt/Option + wheel.
    callback move-selection(int);
    /// A group header was clicked.
    callback toggle-group(string);
    callback set-sort(string);
    callback set-group-mode(string);
    callback search-changed(string);
    // Footer / summary actions.
    callback launch();
    callback repair-and-launch();
    callback open-instance-folder();
    callback toggle-starred();
    callback open-instance-settings();
    callback open-content(string);
    callback select-account(string);
    callback open-accounts();
    callback open-add-account();
    callback open-connect();
    callback new-instance();
    callback open-packs();
    // TEMP-PROBE
    callback debug-log(string);
}
