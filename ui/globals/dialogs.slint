// The overlay layer's state: one visibility flag per dialog plus the form state
// each dialog keeps. A global is the only way Rust can reach a component.
import { Theme } from "../theme.slint";

/// A row of the Minecraft version chooser.
export struct MinecraftVersionItem {
    /// The version id, e.g. "1.20.1".
    id: string,
    /// "release" | "snapshot" | "old_beta" | "old_alpha".
    kind: string,
    /// The release date, split so `GameTime` can format it.
    year: int,
    month: int,
    day: int,
}

/// A row of the Yggdrasil profile chooser.
export struct YggdrasilProfileItem {
    /// The profile UUID, which the selection is keyed on.
    id: string,
    name: string,
    /// Whether the launcher already holds this profile, shown as " (added)".
    added: bool,
    selected: bool,
    /// The head `AccountAvatar` draws, built by Rust because Slint cannot crop
    /// an image itself.
    avatar: image,
}

/// The six sentences of the OAuth callback page (`crates/authcode/page.html`),
/// kept here because a `@tr` in a `.slint` file is what the `.po` files target.
export struct AuthCodePageText {
    /// Shown on `/`, the page reached without the OAuth parameters.
    waiting-title: string,
    waiting-body: string,
    /// Shown once the code has been taken.
    success-title: string,
    success-body: string,
    /// Shown when the sign-in was refused or the callback was not ours.
    failure-title: string,
    failure-body: string,
}

/// The colours that page is drawn in, off the `Theme` tokens. The theme is
/// snapshotted here rather than read in Rust, since the listener serves from a
/// worker thread while `Theme` belongs to the UI thread.
export struct AuthCodePageTheme {
    window: color,
    card: color,
    card-border: color,
    title: color,
    body: color,
    success: color,
    danger: color,
    /// Whether the palette is dark, setting the page's `color-scheme`.
    dark: bool,
    /// The page's `font-family` stack; the embedded launcher fonts resolve to the
    /// system UI font in a browser.
    font-family: string,
}

// One visibility flag per dialog, written by whoever opens it and by Rust.
export global Dialogs {
    in-out property <bool> create-instance-visible: false;
    in-out property <bool> account-add-visible: false;
    // Launch-view errors, raised by Rust when a launch is refused.
    in-out property <bool> no-account-error-visible: false;
    in-out property <bool> no-microsoft-account-error-visible: false;
    in-out property <bool> account-refresh-failed-visible: false;
    in-out property <bool> no-suitable-java-error-visible: false;
    // The instance settings overlay's "Delete instance" row.
    in-out property <bool> confirm-delete-instance-visible: false;
    // The saves grid's trash button.
    in-out property <bool> confirm-delete-save-visible: false;
    // The title bar's close button, while a task is running.
    in-out property <bool> confirm-quit-app-visible: false;
    // Settings → Data storage, after a location changed.
    in-out property <bool> restart-required-visible: false;
    // The account view's "Delete from Conic Launcher" row.
    in-out property <bool> confirm-delete-account-visible: false;
    // The task centre's X after a task has run for 10 seconds.
    in-out property <bool> confirm-cancel-task-visible: false;
    // The launch button's Stop, or the same item in the right-click menu. The id
    // is the instance the dialog will stop, which need not be the selection: the
    // menu acts on the card that was right-clicked.
    in-out property <bool> confirm-stop-game-visible: false;
    in-out property <string> stop-game-id: "";
}

// A dropped CurseForge pack, before it is installed. The file list resolves in
// the background, so the user can name the instance while metadata is fetched.
export global ModpackImportState {
    in-out property <bool> visible: false;
    in-out property <bool> checking: false;
    /// The lookup failed; the dialog shows the error and a Retry button.
    in-out property <bool> failed: false;
    in-out property <string> error-message: "";
    in-out property <string> pack-name: "";
    in-out property <string> minecraft-version: "";
    in-out property <bool> has-loader: false;
    in-out property <string> loader-type: "";
    in-out property <string> loader-version: "";
    /// The editable instance name, seeded with the pack name.
    in-out property <string> instance-name: "";
    /// The manifest files that cannot be downloaded, with their reason.
    in-out property <[string]> files: [];

    callback cancel();
    callback confirm();
    callback retry();

    out property <string> install-title: @tr("ModpackImport" => "Install this modpack?");
    out property <string> instance-name-label: @tr("ModpackImport" => "Instance name");
    out property <string> checking-text: @tr("ModpackImport" => "Checking files");
    out property <string> install-text: @tr("ModpackImport" => "Install");
    out property <string> install-anyway-text: @tr("ModpackImport" => "Install anyway");
    out property <string> error-title: @tr("ModpackImport" => "Could not check the modpack files");
    out property <string> error-detail: @tr(
        "ModpackImport" => "The CurseForge API could not be reached. Check your connection, then retry."
    );
    out property <string> retry-text: @tr("ModpackImport" => "Retry");
    out property <string> warning-title: @tr(
        "ModpackImport" => "Some modpack files cannot be downloaded automatically"
    );
    out property <string> warning-detail: @tr(
        "ModpackImport" => "The pack author disabled third-party downloads for these files. Continue without them, or cancel and download them manually."
    );
    out property <string> cancel-text: @tr("ModpackImport" => "Cancel");
}

// The "delete instance" dialog. Rust fills these from the instance that was
// current when the row was pressed.
export global DeleteInstanceState {
    in-out property <string> id: "";
    in-out property <string> name: "";
    /// The mod loader's display name, empty for a vanilla instance.
    in-out property <string> loader: "";
    in-out property <string> minecraft-version: "";
    in-out property <bool> has-background: false;
    /// The instance's background picture, loaded by Rust.
    in-out property <image> background;
    /// The play time, as `GameTime.play-time`'s two parts.
    in-out property <string> playtime-kind: "";
    in-out property <string> playtime-value: "";
    /// The card's playtime label, kept as a `@tr` so it can be translated.
    out property <string> playtime-label: @tr("ConfirmDeleteInstance" => "游戏时间：");
    /// The dialog's warning sentence.
    out property <string> warning: @tr(
        "ConfirmDeleteInstance" => "是否确认删除此实例？实例下存档、资源包、Mod 等文件也将永久丢失 (真的很久！)"
    );

    /// A delete is running: the confirm button is disabled.
    in-out property <bool> deleting: false;
    callback cancel();
    /// Rust deletes the instance, refreshes the game view and closes the dialog.
    callback confirm();
}

// The "delete save" dialog. Rust fills these from the card whose trash button
// was pressed.
export global DeleteSaveState {
    /// The save's folder under `saves/`, which is what gets deleted.
    in-out property <string> folder: "";
    /// `level.dat`'s `Data.LevelName`, which the dialog names; falls back to the
    /// folder when empty.
    in-out property <string> level-name: "";
    /// A delete is running: the confirm button is disabled.
    in-out property <bool> deleting: false;
    /// The "Wait a moment…" button.
    callback cancel();
    /// Rust deletes the save, reloads the grid and closes the dialog.
    callback confirm();
}

// The "delete account" dialog. The account view's danger row sets `key`/`name`
// and raises `Dialogs.confirm-delete-account-visible`.
export global DeleteAccountState {
    /// The account's stable key (`microsoft-<uuid>` etc.), which is what gets
    /// deleted.
    in-out property <string> key: "";
    /// The profile name the dialog shows.
    in-out property <string> name: "";
    /// A delete is running: the confirm button is disabled.
    in-out property <bool> deleting: false;
    callback cancel();
    /// Rust deletes the account, refreshes the list and closes the dialog (and
    /// the account view if it was the last account).
    callback confirm();
}

// The "create instance" dialog.
export global CreateInstanceState {
    /// "settings" | "minecraft-choose" | "mod-loader-choose"; empty while the
    /// dialog is closed, unmounting every step.
    in-out property <string> step: "";

    in-out property <string> minecraft-version: "";
    /// "None" | "Fabric" | "Quilt" | "Neoforge" | "Forge"
    in-out property <string> mod-loader-type: "None";
    in-out property <string> mod-loader-version: "";
    /// What the user typed; empty falls back to `default-name`.
    in-out property <string> custom-name: "";
    in-out property <bool> name-editing: false;
    in-out property <bool> creating: false;
    /// The picked background file. Rust loads it into `background-image`, because
    /// Slint cannot load an image from a runtime path.
    in-out property <string> background-path: "";
    in-out property <image> background-image;

    in-out property <bool> minecraft-loading: false;
    /// The versions of the selected category (~900, not all instantiated as rows).
    in-out property <[MinecraftVersionItem]> minecraft-versions: [];
    /// "releases" | "snapshot" | "old".
    in-out property <string> version-category: "releases";

    in-out property <bool> fabric-loading: true;
    in-out property <bool> quilt-loading: true;
    in-out property <bool> forge-loading: true;
    in-out property <bool> neoforge-loading: true;
    in-out property <bool> fabric-available: false;
    in-out property <bool> quilt-available: false;
    in-out property <bool> forge-available: false;
    in-out property <bool> neoforge-available: false;
    /// Loader versions for the chosen Minecraft version. Forge strips the
    /// Minecraft part of the version string.
    in-out property <[string]> fabric-versions: [];
    in-out property <[string]> quilt-versions: [];
    in-out property <[string]> forge-versions: [];
    in-out property <[string]> neoforge-versions: [];

    /// The name offered when the user did not type one.
    out property <string> default-name: (minecraft-version != ""
        ? minecraft-version
        : @tr("CreateInstance" => "Unnamed instance"))
        + (mod-loader-type.to-lowercase() == "none"
        ? ""
        : "-" + mod-loader-type.to-lowercase() + mod-loader-version);

    /// Any list still loading.
    out property <bool> mod-loader-loading: fabric-loading || quilt-loading || forge-loading
        || neoforge-loading;

    /// Which mod loader options can be picked; the loaders that answered with an
    /// empty list are unavailable. Slint arrays have no `contains`, so the select
    /// takes these flags parallel to its options.
    public pure function loader-option-enabled() -> [bool] {
        return [
            true,
            self.fabric-available,
            self.quilt-available,
            self.neoforge-available,
            self.forge-available,
        ];
    }

    callback load-minecraft-versions();
    /// The version category changed: re-filter the list.
    callback set-version-category(string);
    /// A version was picked: store it and refresh the mod loader lists.
    callback select-minecraft-version(string);
    /// Rust creates the instance, refreshes the game view and closes the dialog.
    callback create();
    /// The "Set background image" row; the UI passes the translated picker label.
    callback pick-background(string);
    /// The version row's `about` button: opens the Minecraft wiki.
    callback open-version-wiki(string);
}

// The "add account" dialog.
export global AccountAddState {
    /// "microsoft" | "yggdrasil" | "offline".
    in-out property <string> auth-service: "microsoft";
    /// The service selector is frozen while a Microsoft login runs, so its
    /// progress cannot be lost by switching away.
    out property <bool> switch-disabled: self.ms-view == "processing";

    in-out property <string> offline-username: "";
    in-out property <string> offline-uuid: "";
    in-out property <bool> offline-advanced: false;
    /// Whether the typed UUID is malformed; only true in advanced mode. Rust
    /// computes it because Slint has no regular expressions.
    in-out property <bool> offline-uuid-invalid: false;
    /// Whether "Create offline profile" can be pressed, computed by Rust because
    /// Slint has no `trim`.
    in-out property <bool> offline-can-submit: false;

    /// "auth-code" | "processing" | "device-code" | "error".
    in-out property <string> ms-view: "auth-code";
    /// The running login step, named after its `LoginEvent`; the screen turns it
    /// into text so the translation stays in the UI.
    in-out property <string> ms-progress: "";
    in-out property <string> ms-error: "";
    in-out property <string> ms-user-code: "";
    in-out property <string> ms-verification-uri: "";
    /// Seconds left on the device code, counted down by the screen.
    in-out property <int> ms-expires-in: 0;
    /// The two "copied!" hints, one per copy target. They clear when the pointer
    /// leaves the box.
    in-out property <bool> ms-copied: false;
    in-out property <bool> ms-copied-code: false;
    /// The URL the browser flow opens. It is not a constant: the code returns on
    /// a loopback listener whose port the OS chooses, and the `redirect_uri` is
    /// repeated verbatim at the token endpoint (RFC 6749 §4.1.3).
    in-out property <string> auth-code-login-url: "";

    /// The callback page's six sentences, in the launcher's language.
    out property <AuthCodePageText> auth-code-page-text: {
        waiting-title: @tr("AccountAddMicrosoft" => "Waiting for the sign-in"),
        waiting-body: @tr("AccountAddMicrosoft" => "Finish signing in in your browser — this page will change when it is done."),
        success-title: @tr("AccountAddMicrosoft" => "Signed in"),
        success-body: @tr("AccountAddMicrosoft" => "You can close this tab and go back to Conic Launcher."),
        failure-title: @tr("AccountAddMicrosoft" => "Sign-in failed"),
        failure-body: @tr("AccountAddMicrosoft" => "Conic Launcher did not receive a valid sign-in. Close this tab and try again."),
    };
    /// Its colours, off the live `Theme`, read when the listener is bound.
    out property <AuthCodePageTheme> auth-code-page-theme: {
        window: Theme.crust,
        card: Theme.dialog-background,
        card-border: Theme.dialog-border,
        title: Theme.default-text-color.transparentize(0.1),
        body: Theme.default-text-color.transparentize(0.3),
        success: Theme.green,
        danger: Theme.red,
        dark: Theme.active-palette != "Latte",
        font-family: "'Nunito', 'Comfortaa', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif, 'Yu Gothic UI', 'Microsoft YaHei UI'",
    };

    /// "form" | "processing" | "error" | "profiles".
    in-out property <string> yggdrasil-view: "form";
    in-out property <string> yggdrasil-api-root: "";
    in-out property <string> yggdrasil-username: "";
    in-out property <string> yggdrasil-password: "";
    in-out property <string> yggdrasil-error: "";
    /// The `meta.serverName` the API root answered with, shown under the field.
    in-out property <string> yggdrasil-server-name: "";
    in-out property <[YggdrasilProfileItem]> yggdrasil-profiles: [];
    /// Whether any row is selected.
    in-out property <bool> yggdrasil-has-selection: false;
    /// Whether "Verify and add profile" can be pressed: the three fields are
    /// non-blank after trimming, which Rust checks.
    in-out property <bool> yggdrasil-can-submit: false;
    /// Reported when a server answered with no profiles at all.
    out property <string> no-profile-message: @tr("AccountAddYggdrasil" => "This account has no game profile");

    /// A service button of the selector.
    callback select-auth-service(string);
    callback close();
    /// Puts every field back and cancels any running flow, so the previous
    /// session does not bleed into the next.
    callback reset();
    /// Copies `text` to the system clipboard.
    callback copy-text(string);
    /// Opens a URL with the platform's default handler.
    callback open-url(string);

    callback reset-offline-form();
    /// The advanced switch was flipped: mirror the mode and reset the UUID field.
    callback toggle-offline-advanced();
    /// The username or UUID changed: recompute the derived UUID and its validity.
    callback sync-offline-uuid();
    /// "Create offline profile".
    callback add-offline-account();

    /// The "log in with a device code" link; starts a login when none is running.
    callback use-device-code-flow();
    /// The "back to the browser" link: cancels a device-code login and shows the
    /// browser screen again.
    callback use-auth-code-flow();
    /// A "Cancel" button of the Microsoft screen.
    callback cancel-microsoft-login();
    /// The browser screen is on show: bind the loopback listener and put its URL
    /// in `auth-code-login-url`. Idempotent, so the screen can ask every time.
    callback prepare-auth-code-flow();
    /// The browser screen is off or the dialog closed: drop the listener, freeing
    /// the port.
    callback release-auth-code-flow();

    callback reset-yggdrasil-form();
    /// 500 ms after the API root stopped changing: look its name up.
    callback lookup-server-name();
    /// One of the three fields changed: recompute `yggdrasil-can-submit`.
    callback sync-yggdrasil-submit();
    /// "Verify and add profile".
    callback yggdrasil-login();
    /// "Add profiles", for the rows selected in the chooser.
    callback yggdrasil-add-profiles();
    /// A row of the chooser was clicked, by index.
    callback toggle-yggdrasil-profile(int);
}
