// State of the two tooltips the app has, both drawn at the application root so no
// clipping container cuts them off.
//
// `DescriptionTooltip` shows the full text of a `SettingItem` description the row
// pinned to a few lines. It is anchored to the description's own window position,
// not the pointer, so it starts on the line it explains.
//
// `TooltipState` is the generic pointer tooltip any control shows through
// `TooltipArea`; it is anchored to the pointer. Slint has no cursor accessor, so
// the Rust service `ui/services/tooltip.rs` writes its position.
export global DescriptionTooltip {
    /// The full text, written by the row on hover.
    in-out property <string> text: "";
    /// The description line's top-left corner in window coordinates, and the
    /// width it is given there — the panel is as wide as the line it explains, so
    /// the text breaks where that line's did.
    in-out property <length> anchor-x: 0px;
    in-out property <length> anchor-y: 0px;
    in-out property <length> anchor-width: 0px;
    /// Whether the pointer is on the description line, and whether it is on the
    /// panel. The panel is drawn *over* the description, so a pointer that moves
    /// onto it takes the hover away from there: it is the two together that keep
    /// the tooltip up, not the first one alone.
    in-out property <bool> over-description: false;
    in-out property <bool> over-panel: false;
    /// Which pinned box the anchor currently belongs to, and the counter the boxes
    /// take their numbers from. The row that opened the panel keeps refreshing the
    /// anchor while it owns it, even once a scroll has left the pointer on the
    /// panel, so the panel travels with the content. A number rather than a flag: a
    /// global flag would let every row push its own anchor.
    in-out property <int> anchor-seq: 0;
    in-out property <int> next-anchor-seq: 0;
}

// State of the generic pointer tooltip. A trigger (`TooltipArea`) writes `text` and
// raises `wanted`; the overlay owns the reveal and reads `wanted` only as the target
// it animates towards. The pointer position is written by the Rust service
// `ui/services/tooltip.rs`, because Slint has no global cursor accessor.
export global TooltipState {
    /// The text to show. Written by the trigger that raised `wanted`.
    in-out property <string> text: "";
    /// Whether the panel is wanted. The overlay animates towards it, so this is a
    /// request and not the panel's visibility.
    in-out property <bool> wanted: false;
    /// The pointer's position within the window, in logical units, written by the
    /// Rust cursor tracker. The overlay places the panel beside it.
    in-out property <length> pointer-x: 0px;
    in-out property <length> pointer-y: 0px;
    /// Which trigger opened the panel, and the counter the triggers take their
    /// numbers from. A trigger that loses its hover may only clear `wanted` when
    /// it still owns it — moving from one control to the next would otherwise
    /// have the first clear the second's panel. A number rather than a flag for
    /// the reason `DescriptionTooltip.anchor-seq` is: a global flag would let
    /// every trigger think it owns the panel, and the last write of the tick
    /// would win.
    in-out property <int> owner: 0;
    in-out property <int> next-owner: 0;
}
