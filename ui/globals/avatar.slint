// The pixel-level corner rounding and drop shadow of avatar heads.
//
// Slint cannot round an `Image` — a `clip: true` with a `border-radius` is clipped
// rectangularly by the software renderer — so the round goes in the pixels.
//
// A radius of half the shorter side or more is the inscribed pill. `draw-size` is
// the width the caller draws at, so the radius is measured on screen rather than in
// the (possibly larger) source pixels.
//
// `drop-shadow` is CSS `filter: drop-shadow(0 <offset-y> <blur> <color>)`: Slint's
// own `drop-shadow-*` follows an element's box, so the shadow of a head with
// transparent corners would be a square. This blurs the image's own alpha and
// returns it on a canvas grown by `pad`, which the caller draws behind the head at
// `-pad`.
export global AvatarMask {
    pure callback rounded(image, length, length) -> image;
    pure callback drop-shadow(image, length, length, length, color) -> image;
}
