// Global screen navigation. Screen values are "setup" | "game" | "launch";
// settings is an overlay, not a screen.
export global Navigation {
    in-out property <string> current-screen: "game";
    in-out property <string> previous-screen: "";

    /// The screen being left while a swap plays, "" at rest. Written
    /// synchronously because the screen stack reads it in a binding to keep the
    /// outgoing screen mounted; a queued write would leave a frame with neither
    /// screen mounted.
    in-out property <string> leaving-screen: "";
    /// Whether the in-flight navigation is a `back`, for directional animations.
    in-out property <bool> back-navigation: false;
    /// The screen-swap lifecycle the `App` timers drive: "idle" | "starting"
    /// (incoming screen held one frame) | "running".
    in-out property <string> transition-stage: "idle";

    /// Fired whenever `current-screen` changes, so a screen can run its teardown.
    callback screen-changed(string);

    /// The app-wide Escape shortcut: close transient UI and go home.
    callback escape();

    changed current-screen => {
        self.screen-changed(self.current-screen);
    }

    public function navigate(screen: string) {
        if (self.current-screen == screen) {
            return;
        }
        // Leave `previous-screen` alone when leaving `launch`, so back returns to
        // where the launch was started from.
        if (self.current-screen != "launch") {
            self.previous-screen = self.current-screen;
        }
        self.leaving-screen = self.current-screen;
        self.back-navigation = false;
        self.current-screen = screen;
        self.transition-stage = "starting";
    }

    public function back() {
        if (self.previous-screen == "") {
            return;
        }
        self.leaving-screen = self.current-screen;
        self.back-navigation = true;
        self.current-screen = self.previous-screen;
        self.previous-screen = "";
        self.transition-stage = "starting";
    }
}
