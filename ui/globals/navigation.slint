// Global page navigation. Page values are "setup" | "game" | "launch";
// settings is an overlay, not a page.
export global Navigation {
    in-out property <string> current-page: "game";
    in-out property <string> previous-page: "";

    /// The page being left while a swap plays, "" at rest. Written
    /// synchronously because the page stack reads it in a binding to keep the
    /// outgoing page mounted; a queued write would leave a frame with neither
    /// page mounted.
    in-out property <string> leaving-page: "";
    /// Whether the in-flight navigation is a `back`, for directional animations.
    in-out property <bool> back-navigation: false;
    /// The page-swap lifecycle the `App` timers drive: "idle" | "starting"
    /// (incoming view held one frame) | "running".
    in-out property <string> transition-stage: "idle";

    /// Fired whenever `current-page` changes, so a screen can run its teardown.
    callback page-changed(string);

    /// The app-wide Escape shortcut: close transient UI and go home.
    callback escape();

    changed current-page => {
        self.page-changed(self.current-page);
    }

    public function navigate(page: string) {
        if (self.current-page == page) {
            return;
        }
        // Leave `previous-page` alone when leaving `launch`, so back returns to
        // where the launch was started from.
        if (self.current-page != "launch") {
            self.previous-page = self.current-page;
        }
        self.leaving-page = self.current-page;
        self.back-navigation = false;
        self.current-page = page;
        self.transition-stage = "starting";
    }

    public function back() {
        if (self.previous-page == "") {
            return;
        }
        self.leaving-page = self.current-page;
        self.back-navigation = true;
        self.current-page = self.previous-page;
        self.previous-page = "";
        self.transition-stage = "starting";
    }
}
