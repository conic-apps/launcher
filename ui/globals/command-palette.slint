// Command palette state. Pure-UI state (open, mode, query, selection) lives
// here and is written from the view; domain state lives in Rust and is pushed in
// as a `PaletteItem` model.

/// One row of the palette's result list: a command, an instance or an online
/// project. Translatable parts are keys, resolved by `CommandText`, because a
/// string pushed into a model would not follow a language change.
export struct PaletteItem {
    /// What `hover` / `perform` report and what `selected-key` is compared
    /// against: `instance-<id>`, `modrinth-<id>`, `curseforge-<id>`, or a
    /// command's own name.
    key: string,
    title: string,
    /// "" for a title that is data (an instance's name, a project's), or the
    /// command's key when the title is one of the five fixed commands, or the
    /// operation's key in an instance's sub-menu: "launch-instance" |
    /// "create-instance" | "add-account" | "search-modrinth" |
    /// "search-curseforge" | "instance-launch" | "instance-settings" |
    /// "instance-saves" | "instance-mods" | "instance-resourcepacks".
    title-kind: string,
    /// The project's author, or "".
    author: string,
    /// The mod loader tags in the API's slugs (fabric | forge | quilt | neoforge),
    /// already filtered.
    loaders: [string],
    subtitle: string,
    /// "" or the project type the subtitle labels: "mod" | "modpack" |
    /// "resourcepack" | "shader".
    subtitle-kind: string,
    /// The `AppIcon` name, or the site an online result came from.
    icon: string,
    /// Whether `icon` is a site mark rather than a glyph; the two are drawn
    /// differently and take their ink from different variables.
    icon-is-brand: bool,
    /// The project's own icon, when the search returned one.
    icon-image: image,
    has-icon-image: bool,
    /// Whether the trailing chevron is drawn.
    has-children: bool,
    /// The action the footer reports for the selected row: "open" | "launch".
    action-kind: string,
    /// The section heading above this row, or "" — "commands" | "instances" |
    /// "results". Only the first row of a section carries one.
    section-kind: string,
    /// The section label's height, 0 when the row carries no heading.
    label-height: length,
    /// The row's height, with or without the loader tag row.
    row-height: length,
}

/// The palette's translated strings. The context is explicit because the rows,
/// placeholder, breadcrumb and footer hints are separate elements.
export global CommandText {
    /// A row's title — the command's own, or the data Rust pushed.
    public pure function title(kind: string, text: string) -> string {
        if kind == "launch-instance" { return @tr("CommandText" => "Launch instance"); }
        if kind == "create-instance" { return @tr("CommandText" => "Create instance"); }
        if kind == "add-account" { return @tr("CommandText" => "Add game profile"); }
        if kind == "search-modrinth" { return @tr("CommandText" => "Search on Modrinth"); }
        if kind == "search-curseforge" { return @tr("CommandText" => "Search on CurseForge"); }
        if kind == "instance-launch" { return @tr("CommandText" => "Launch"); }
        if kind == "instance-settings" { return @tr("CommandText" => "Open settings"); }
        if kind == "instance-saves" { return @tr("CommandText" => "Open saves list"); }
        if kind == "instance-mods" { return @tr("CommandText" => "Open mods list"); }
        if kind == "instance-resourcepacks" { return @tr("CommandText" => "Open resource packs list"); }
        return text;
    }

    /// The `by <author>` suffix of a project's title line.
    public pure function author(name: string) -> string {
        if name == "" { return ""; }
        return @tr("CommandText" => "by {}", name);
    }

    /// The right-hand subtitle of a row — the project's category.
    public pure function category(kind: string) -> string {
        if kind == "modpack" { return @tr("CommandText" => "Modpack"); }
        if kind == "resourcepack" { return @tr("CommandText" => "Resource Pack"); }
        if kind == "shader" { return @tr("CommandText" => "Shader"); }
        if kind == "mod" { return @tr("CommandText" => "Mod"); }
        return "";
    }

    /// The footer's action hint for the selected row.
    public pure function action(kind: string) -> string {
        if kind == "launch" { return @tr("CommandText" => "Launch"); }
        if kind == "open" { return @tr("CommandText" => "Open"); }
        return "";
    }

    /// The heading above a section of results.
    public pure function section(kind: string) -> string {
        if kind == "instances" { return @tr("CommandText" => "Instances"); }
        if kind == "results" { return @tr("CommandText" => "Search results"); }
        if kind == "commands" { return @tr("CommandText" => "Commands"); }
        return "";
    }

    /// The search field's placeholder, which depends on the mode.
    public pure function placeholder(mode: string, source: string) -> string {
        if mode == "launch-instance" { return @tr("CommandText" => "Select an instance to launch…"); }
        if mode == "instance-actions" { return @tr("CommandText" => "Search actions…"); }
        if mode == "search-online" {
            if source == "curseforge" { return @tr("CommandText" => "Search on CurseForge…"); }
            return @tr("CommandText" => "Search on Modrinth…");
        }
        return @tr("CommandText" => "Search commands or instances…");
    }

    /// The footer's left-hand label, which names the current mode. In an
    /// instance's sub-menu it is the instance's own name, so the menu always says
    /// which instance it will act on.
    public pure function breadcrumb(mode: string, source: string, target: string) -> string {
        if mode == "instance-actions" { return target; }
        if mode == "launch-instance" { return @tr("CommandText" => "Launch instance"); }
        if mode == "search-online" {
            if source == "curseforge" { return @tr("CommandText" => "Search on CurseForge"); }
            return @tr("CommandText" => "Search on Modrinth");
        }
        return @tr("CommandText" => "Commands");
    }

    /// "Back" — shown instead of "Close" outside the root mode.
    public pure function back-hint() -> string {
        return @tr("CommandText" => "Back");
    }

    public pure function close-hint() -> string {
        return @tr("CommandText" => "Close");
    }

    /// The empty-list messages. `kind` is one of "searching" | "type-to-search"
    /// | "failed" | "no-matches" | "none", and `source` is the site for the one
    /// that names it.
    public pure function empty(kind: string, source: string) -> string {
        if kind == "type-to-search" {
            // Name the site: only Enter performs a search, so do not promise that
            // a key does something here.
            if source == "curseforge" {
                return @tr("CommandText" => "Type keywords to search on CurseForge");
            }
            return @tr("CommandText" => "Type keywords to search on Modrinth");
        }
        if kind == "failed" { return @tr("CommandText" => "Search failed, please try again"); }
        if kind == "no-matches" || kind == "none" {
            return @tr("CommandText" => "No matching results");
        }
        return "";
    }
}

/// The command palette's state and the callbacks its controller answers.
export global CommandPaletteState {
    in-out property <bool> visible: false;
    /// "root" | "launch-instance" | "instance-actions" | "search-online".
    in-out property <string> mode: "root";
    /// "modrinth" | "curseforge" — which site `search-online` searches.
    in-out property <string> source: "modrinth";
    /// The instance name the "instance-actions" breadcrumb shows. "" outside
    /// that mode.
    in-out property <string> target-name: "";
    in-out property <string> query: "";
    /// Whether the trimmed query is empty. Slint has no `trim`, so Rust answers.
    in-out property <bool> query-empty: true;

    in-out property <[PaletteItem]> items: [];
    /// The height of `items` laid out end to end, headings included.
    in-out property <length> items-content-height: 0px;
    /// Bumped whenever `items` is replaced, so the view drops the scroll offset.
    in-out property <int> items-seq: 0;

    /// The key of the selected row.
    in-out property <string> selected-key: "";
    /// The key of the row the pointer is over, which is not the selection.
    in-out property <string> hovered-key: "";
    in-out property <string> selected-action-kind: "";
    in-out property <length> selected-row-y: 0px;
    in-out property <length> selected-row-height: 0px;
    /// Bumped on every selection change so the view scrolls the row into sight.
    in-out property <int> selected-seq: 0;

    in-out property <bool> online-searching: false;
    in-out property <bool> online-error: false;

    /// Opens the palette, or closes it if already open.
    callback toggle();
    /// The title bar's search field was clicked.
    callback open();
    /// The backdrop, Escape, or a command that finishes its work.
    callback close();
    /// A row was clicked; a click on the already-selected row opens it.
    callback click(int);
    /// Enter, acting on the selected row.
    callback perform-selected();
    /// The pointer moved onto a row, or off one (a negative index).
    callback hover(int);
    /// `ArrowUp` (-1) and `ArrowDown` (1), wrapping at both ends.
    callback move-selection(int);
    /// The user typed in the search field; the selection is reset.
    callback query-changed();
    /// Escape with a non-empty query: empty it and reset the results.
    callback clear-query();
    /// A command that opens another mode was chosen. `kind` is "launch-instance"
    /// or "search-online"; `source` is the site for the latter.
    callback enter-mode(string, string);
    /// Escape or Backspace on an empty query, outside the root mode.
    callback back-to-root();
    /// The 250ms debounce after the last keystroke elapsed.
    callback run-search();
}
