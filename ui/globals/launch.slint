// The launch screen's state.
//
// The domain data comes from Rust (`app/src/ui/views/launch/`); the progress
// *description* is deliberately kept as a kind plus its parts rather than a
// finished string, so the `@tr()` calls stay in the UI and can be re-evaluated
// when the language changes at runtime. The byte counts are pre-formatted by
// Rust because Slint cannot format them.
export global LaunchState {
    in-out property <bool> has-instance: false;
    in-out property <string> instance-name: "";
    in-out property <string> minecraft-version: "";
    in-out property <bool> has-loader: false;
    in-out property <string> loader-type: "";
    in-out property <string> loader-version: "";

    in-out property <image> account-avatar;
    /// "Microsoft" | "Yggdrasil" | "Offline" | "" (the avatar ring colour and
    /// the "Auth service" value).
    in-out property <string> account-kind: "";
    in-out property <bool> has-account: false;
    /// The profile name shown next to "Profile name".
    in-out property <string> profile-name: "";

    in-out property <bool> error: false;
    /// The progress line's kind: "preparing", "refresh-account",
    /// "prepare-download", "verify-files", "download-files", "check-java",
    /// "download-java", "install-mod-loader", "download-installer",
    /// "download-installer-progress", "download-deps", "download-deps-progress",
    /// "run-installer", "preparing-launch", "generate-script", "wait-for-launch",
    /// "game-started" or "error".
    in-out property <string> progress-kind: "preparing";
    in-out property <string> progress-name: "";
    in-out property <string> progress-current: "";
    in-out property <string> progress-total: "";
    in-out property <string> progress-message: "";
    in-out property <string> error-message: "";
    in-out property <bool> progress-loading: true;
    in-out property <float> progress-value: 0;
    in-out property <float> progress-max: 0;
    /// A disabled back button ignores the pointer, so a stray click cannot
    /// cancel the launch.
    in-out property <bool> back-disabled: false;

    /// The screen was mounted: start the launch flow.
    callback start();
    /// The back button — cancels any running task first.
    callback cancel();
    /// The progress line, translated from `progress-kind` and its parts.
    public pure function description() -> string {
        if self.progress-kind == "prepare-download" {
            return @tr("LaunchView" => "Preparing download");
        }
        if self.progress-kind == "refresh-account" {
            return @tr("LaunchView" => "Refreshing account");
        }
        if self.progress-kind == "verify-files" {
            return @tr("LaunchView" => "Verifying game files");
        }
        if self.progress-kind == "download-files" {
            return @tr("LaunchView" => "Downloading game files {} / {}", self.progress-current, self.progress-total);
        }
        if self.progress-kind == "check-java" {
            return @tr("LaunchView" => "Checking Java runtime");
        }
        if self.progress-kind == "download-java" {
            return @tr("LaunchView" => "Downloading Java {}/{}", self.progress-current, self.progress-total);
        }
        if self.progress-kind == "install-mod-loader" {
            return @tr("LaunchView" => "Installing {}", self.progress-name);
        }
        if self.progress-kind == "download-installer" {
            return @tr("LaunchView" => "Downloading {} installer", self.progress-name);
        }
        if self.progress-kind == "download-installer-progress" {
            return @tr("LaunchView" => "Downloading {} installer", self.progress-name) + " " + self.progress-current + " / " + self.progress-total;
        }
        if self.progress-kind == "download-deps" {
            return @tr("LaunchView" => "Downloading dependencies");
        }
        if self.progress-kind == "download-deps-progress" {
            return @tr("LaunchView" => "Downloading dependencies") + " " + self.progress-current + " / " + self.progress-total;
        }
        if self.progress-kind == "run-installer" {
            return @tr("LaunchView" => "Running {} installer: {}", self.progress-name, self.progress-message);
        }
        if self.progress-kind == "preparing-launch" {
            return @tr("LaunchView" => "Preparing to launch");
        }
        if self.progress-kind == "generate-script" {
            return @tr("LaunchView" => "Generating launch script");
        }
        if self.progress-kind == "wait-for-launch" {
            return @tr("LaunchView" => "Waiting for game process to start");
        }
        if self.progress-kind == "game-started" {
            return @tr("LaunchView" => "Game started");
        }
        if self.progress-kind == "error" {
            return @tr("LaunchView" => "Error: {}", self.error-message);
        }
        return @tr("LaunchView" => "Preparing");
    }
}
