// Re-export so the Rust side can access the globals and the runtime model.
export { AppConfig, JavaRuntime } from "globals/settings.slint";
export { Navigation } from "globals/navigation.slint";
export { Dropdown } from "globals/dropdown.slint";
export { FocusManager } from "globals/focus.slint";
export { GameState, GameRow, AccountItem } from "globals/game.slint";
export { LaunchState } from "globals/launch.slint";
export { CrashState } from "globals/crash.slint";
export { ScrollInput, ScrollSource } from "globals/scroll.slint";
export { AvatarMask } from "globals/avatar.slint";
export {
    Dialogs,
    CreateInstanceState,
    MinecraftVersionItem,
    AccountAddState,
    YggdrasilProfileItem,
    DeleteInstanceState,
    DeleteSaveState,
    DeleteAccountState,
    ModpackImportState,
} from "globals/dialogs.slint";
export { WindowDrag } from "globals/window-drag.slint";
export {
    MultiplayerState,
    MultiplayerPlayer,
    MultiplayerPeer,
} from "globals/multiplayer.slint";
export { WindowControl } from "components/title-bar.slint";
export { Background } from "globals/background.slint";
export {
    ContentState,
    ContentSearch,
    ContentCard,
    CardTag,
    FilterChip,
    FilterRow,
    PageButton,
} from "globals/content.slint";
export { MusicState, MusicTrack } from "globals/music.slint";
export {
    NewsState,
    NewsSearch,
    NewsCard,
    NewsChip,
    NewsText,
} from "globals/news.slint";
export {
    CommandPaletteState,
    PaletteItem,
} from "globals/command-palette.slint";
export { InstanceSettingsState } from "globals/instance-settings.slint";
export {
    AccountViewState,
    AccountDay,
    AccountMonthLabel,
    AccountActivity,
} from "globals/account-view.slint";
export { SetupWizardState } from "globals/setup.slint";
export { WorldMapState, WorldSource, WorldTile } from "globals/worldmap.slint";
export { TooltipState } from "globals/tooltip.slint";
export {
    NotificationState,
    NotificationItem,
} from "globals/notifications.slint";
export { TaskState, TaskItem, TaskText } from "globals/tasks.slint";

// Application root window. macOS keeps the native traffic lights, Linux draws
// its own window controls, and Windows draws the platform's own over the title
// bar (`app/src/support/native/windows/caption.rs`).
export component App inherits Window {
    title: @tr("Conic Launcher");
    // Window/taskbar icon for Windows and Linux WMs. macOS uses its dock icon
    // instead: winit's window icon path is a no-op there.
    icon: @image-url("assets/images/app-icon.png");
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size-base;
    default-font-weight: Theme.font-weight-normal;
    // macOS blends its native title bar into the client area; Linux leaves the
    // corners transparent for the rounded, frameless window. Windows stays
    // opaque because its frame is DWM's and rounds the window itself.
    background: self.macos || self.linux ? transparent : Theme.crust;
    // The floor, not a fixed size: fixed `width`/`height` on the root Window pin
    // min == max and make it non-resizable.
    min-width: 840px;
    min-height: 532px;
    preferred-width: 840px;
    preferred-height: 532px;
    // Linux has no window controls of its own, and Windows drops the caption so
    // the platform's controls sit on the app's title bar.
    no-frame: self.linux || self.windows;
    resize-border-width: (self.linux || self.windows) ? 6px : 0px;
    // The initial focus element: a window with nothing focused discards its key
    // events, which would kill the `Ctrl`/`⌘` + `/` shortcut after the first
    // click. The scope wraps the whole window so a key event from any focused
    // field inside it still reaches its binding on the way up.
    forward-focus: app-scope;

    in-out property <bool> macos: false;
    in-out property <bool> linux: false;
    in-out property <bool> windows: false;
    /// The custom title bar's height, shared with the platform, which sizes and
    /// hit tests the window controls against it (`app/src/support/native/windows/caption.rs`).
    in property <length> title-bar-height: 44px;
    /// How much of the title bar's right-hand end the platform's window controls
    /// take, in logical units. Zero everywhere but Windows.
    in-out property <length> window-controls-inset: 0px;
    /// The platform's window controls, as the platform draws them. Empty until
    /// the window exists.
    in-out property <[WindowControl]> window-controls: [];
    /// Which control the pointer is on, and which is pressed, in the platform's
    /// own numbering (`WindowControl.index`). -1 is neither; the controls are
    /// non-client area, so only the system reports the pointer.
    in-out property <int> window-control-hovered: -1;
    in-out property <int> window-control-pressed: -1;
    /// Native fullscreen, a state pushed from the platform rather than a request
    /// (use `WindowService` to change it). macOS hides the traffic lights here.
    in-out property <bool> window-fullscreen: false;
    in-out property <string> search-placeholder: @tr("Action");
    in-out property <string> search-hotkey: "";

    // Closing while a task is running asks first
    // (`Dialogs.confirm-quit-app-visible`), then plays a 250ms scale + fade and
    // closes the window 500ms later. A close on any other page never gets here.
    private property <bool> quitting: false;
    private property <float> quit-alpha: root.quitting ? 0.0 : 1.0;
    private property <float> quit-scale: root.quitting ? 93% : 100%;
    animate quit-alpha, quit-scale {
        duration: 250ms;
        easing: cubic-bezier(0, 0.74, 0.65, 1);
    }

    quit-timer := Timer {
        interval: 500ms;
        running: root.quitting;
        triggered => { root.close(); }
    }

    function quit() {
        root.quitting = true;
    }

    /// The same close flow as `⌘W`, for callers outside the UI. The macOS
    /// terminate hook invokes it for `⌘Q`, the Quit menu item or a logout, so no
    /// `⌘Q` `KeyBinding` is registered.
    public function request-close() {
        root.close();
    }

    // The page-swap lifecycle. The 16ms beat holds a view at its start values
    // for one frame before its animation retargets them; Slint has no timeline
    // and a property only moves while something reads it.
    page-settle-timer := Timer {
        interval: 16ms;
        running: Navigation.transition-stage == "starting";
        triggered => { Navigation.transition-stage = "running"; }
    }

    // The swap is at most the 250ms any view's exit is allowed. Clearing
    // `leaving-page` lets a kept-mounted view (the wizard) unmount.
    page-run-timer := Timer {
        interval: 250ms;
        running: Navigation.transition-stage == "running";
        triggered => {
            Navigation.transition-stage = "idle";
            Navigation.leaving-page = "";
        }
    }

    // The first page's view can animate in too: the wizard reads "starting" as
    // its entrance. `init` runs before the event loop.
    init => {
        if Navigation.transition-stage == "idle" {
            Navigation.transition-stage = "starting";
        }
        // Make the Up/Down bindings live from the first frame: the app can be
        // already frontmost when launched from a running terminal.
        app-scope.focus();
    }

    callback toggle-music();
    callback open-news();
    callback open-notifications();
    callback maximize-or-fullscreen();
    callback minimize-window();
    callback close-window();
    /// Settings → Data storage asked for a restart after a location changed.
    callback restart-app();
    /// Tells the platform which theme the app resolved to, so the window controls
    /// it draws take their ink from this title bar. Answered on Windows only.
    callback set-caption-dark(dark: bool);

    // Drives the palette selection and animates the Theme tokens. Must exist
    // exactly once.
    ThemeProvider {
        caption-dark-changed(dark) => { root.set-caption-dark(dark); }
    }

    // The window's key handler. Focus-on-click and tab traversal are off so the
    // scope does not steal clicks from the control under the pointer; it is only
    // ever focused explicitly.
    app-scope := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        focus-on-tab-navigation: false;

        // Slint's `Control` is the command key on macOS and the control key
        // everywhere else, so one binding covers both. The binding lives on the
        // app scope rather than on the palette, which is hidden most of the time.
        KeyBinding {
            keys: @keys(Control + "/");
            activated => { CommandPaletteState.toggle(); }
        }

        // `⌘W` (`Control` + `W`): the platform's close-window shortcut. `close()`
        // runs the close-requested callback, so the launch page asks first.
        KeyBinding {
            keys: @keys(Control + W);
            activated => { root.close(); }
        }

        // Escape returns home and closes whatever transient UI is above it. The
        // command palette owns Escape while it is open.
        KeyBinding {
            keys: @keys(Escape);
            activated => { Navigation.escape(); }
        }

        // Up/Down move the current instance on the game page. A `key-pressed`
        // handler rather than a `KeyBinding`: the winit backend reports arrows
        // through the key text, and a binding for them was not matched.
        key-pressed(event) => {
            if Navigation.current-page == "game" && !CommandPaletteState.visible {
                if event.text == Key.UpArrow {
                    GameState.move-selection(-1);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    GameState.move-selection(1);
                    return accept;
                }
            }
            reject
        }

        // Focus returns here when the palette closes, so the bindings above keep
        // working: a window with nothing focused discards its key events.
        private property <bool> palette-open: CommandPaletteState.visible;
        changed palette-open => {
            if !palette-open {
                app-scope.focus();
            }
        }

        // The content layer stays full-size; the title bar owns the top row and
        // the platform owns the remaining window edge.
        container := Rectangle {
            width: root.width;
            height: root.height;
            // The quit animation: scale(0.93) plus fade, on the one box that
            // holds everything. The easing lives on the two root properties.
            opacity: root.quit-alpha;
            transform-scale: root.quit-scale;
            // The flat `crust` base; the background sky over it is translucent.
            background: Theme.crust;
            border-radius: 16px;
            // A 1px hairline at 16% white. A Slint border is drawn inside the box
            // and does not inset its children, so only the hairline is reproduced.
            border-width: 1px;
            border-color: #ffffff.with-alpha(0.16);
            clip: true;

            // Behind every page and every overlay.
            WindowBackground { }

            VerticalLayout {
                width: root.width;
                height: root.height;

                // Reserves the bar's row; the bar itself is mounted above the
                // overlay layers below.
                Rectangle {
                    width: 100%;
                    height: root.title-bar-height;
                    background: transparent;
                }

                // Page stack. The account view is an overlay on the game screen,
                // not a page; the fallback catches any page with no screen.
                // Animation lives at the view: a page playing its exit stays
                // mounted while `leaving-page` is set.
                page-stack := Rectangle {
                    width: 100%;
                    vertical-stretch: 1;
                    clip: true;

                    if Navigation.current-page == "settings" || Navigation.leaving-page == "settings": SettingsView { }
                    if Navigation.current-page == "game" || Navigation.leaving-page == "game": GameView { }
                    if Navigation.current-page == "launch": LaunchView { }
                    if Navigation.current-page == "setup" || Navigation.leaving-page == "setup": SetupView { }
                    if Navigation.current-page != "settings" && Navigation.current-page != "game" && Navigation.current-page != "launch" && Navigation.current-page != "setup": TodoPlaceholder { }
                }
            }

            // Floating dropdown list + outside-click layer, above the page stack.
            // The `z` is load-bearing: the instance list's toolbar (`z: 114`) and
            // scrollbars (`z: 500`) would otherwise paint over the panel.
            DropdownOverlay {
                z: 1000;
            }

            // The description tooltip, drawn here because both the settings
            // collapse and the settings scroll area clip it.
            DescriptionTooltipOverlay { }

            // The background-music panel, covering everything below the title bar.
            MusicPlayerOverlay {
                y: root.title-bar-height;
                height: root.height - root.title-bar-height;
            }

            // The news browser, above the pages and below the command palette and
            // dialogs.
            NewsRoot {
                y: root.title-bar-height;
                height: root.height - root.title-bar-height;
            }

            NotificationOverlay {
                y: root.title-bar-height;
                height: root.height - root.title-bar-height;
                z: 1100;
            }

            // The floating previews, above the centre panel but under the title
            // bar so the window controls stay reachable.
            NotificationToasts {
                y: root.title-bar-height;
                height: root.height - root.title-bar-height;
                z: 1150;
            }

            // The crash prompt, above the notification layers but below the title
            // bar and dialogs.
            CrashRoot {
                y: root.title-bar-height;
                height: root.height - root.title-bar-height;
                z: 1180;
            }

            // Mounted outside the page layout so the bar stays above the
            // notification, news and music layers, but under the palette and dialogs.
            TitleBar {
                x: 0;
                y: 0;
                width: 100%;
                height: root.title-bar-height;
                z: 1200;
                macos: root.macos;
                linux: root.linux;
                windows: root.windows;
                fullscreen: root.window-fullscreen;
                window-controls-inset: root.window-controls-inset;
                window-controls: root.window-controls;
                window-control-hovered: root.window-control-hovered;
                window-control-pressed: root.window-control-pressed;
                search-placeholder: root.search-placeholder;
                search-hotkey: root.search-hotkey;
                current-page: Navigation.current-page;
                music-enabled: AppConfig.music-enabled;

                // Navigation is global: the title bar drives it directly.
                open-home => { Navigation.navigate("game"); }
                open-settings => { Navigation.navigate("settings"); }
                open-search => { CommandPaletteState.open(); }
                open-news => {
                    NotificationState.visible = false;
                    root.open-news();
                }
                open-notifications => {
                    NewsState.visible = false;
                    NewsState.detail-visible = false;
                    NotificationState.visible = !NotificationState.visible;
                }
                toggle-music => { root.toggle-music(); }
                maximize-or-fullscreen => { root.maximize-or-fullscreen(); }
                minimize-window => { root.minimize-window(); }
                // `App.close()` runs the close-requested callback, where the
                // launch-page confirm lives.
                close-window => { root.close(); }
            }

            // The command palette, mounted between the music player and the dialog
            // layer.
            CommandPaletteOverlay { }

            // The dialog layer, above the palette and the music player, hence the
            // explicit `z` rather than declaration order.
            DialogRoot {
                z: 2000;
                confirm-quit => { root.quit(); }
                restart-app => { root.restart-app(); }
            }

            // The generic pointer tooltip, above everything including the dialogs.
            // Pure drawing with no `TouchArea`, so it never takes a click.
            TooltipOverlay {
                z: 3000;
            }
        }
    }
}
