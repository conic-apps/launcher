import { CrashState } from "../../globals/crash.slint";
import { ContentOverlay } from "../content/content-overlay.slint";
import { CrashPanel } from "crash-panel.slint";

// The crash overlay layer, using the content shell so a crash interrupts the
// launcher like a content panel. A game outlives its launch flow, so this can
// rise over any page.
export component CrashRoot inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    overlay := ContentOverlay {
        overlay-visible: CrashState.visible;
        closed => { CrashState.close(); }

        CrashPanel {
            panel-width: overlay.panel-width;
            panel-height: overlay.panel-height;
        }
    }
}
