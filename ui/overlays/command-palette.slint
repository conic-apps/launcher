import { Theme } from "../theme.slint";
import { AppIcon } from "../components/display/app-icon.slint";
import { Loading } from "../components/controls/loading.slint";
import { ScrollView } from "../components/containers/scroll-view.slint";
import { ContentText } from "../globals/content.slint";
import { Navigation } from "../globals/navigation.slint";
import {
    CommandPaletteState,
    CommandText,
    PaletteItem,
} from "../globals/command-palette.slint";

// A keyboard key cap.
component KeyCap inherits Rectangle {
    in property <string> text: "";
    // Explicit width, not `min-width`, which the layout would have to solve for
    // and which reads the widths it is measured from.
    width: key-text.width + 10px;
    height: 13px;
    border-radius: 4px;
    background: Theme.surface-0;

    key-text := Text {
        text: root.text;
        font-size: 11px;
        font-weight: Theme.font-weight-normal;
        color: Theme.subtext-0;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

// One row of the result list. Rust computes `row-height`, so this never measures
// itself.
component PaletteRow inherits Rectangle {
    in property <PaletteItem> item;
    in property <bool> selected: false;
    in property <bool> hovered: false;
    in property <int> index: 0;

    callback pointer-moved(int);
    callback pressed(int);

    width: 100%;
    height: root.item.row-height;
    // Keyboard selection and pointer hover use different colours on purpose.
    background: root.selected ? Theme.surface-1
        : root.hovered ? Theme.surface-0
        : transparent;
    border-radius: 8px;
    border-width: 0px;

    // A plain `Rectangle` reports no height, so it is stated: title line plus
    // the tag row when there are tags.
    private property <length> main-height: root.item.loaders.length > 0 ? 30px : 13px;

    HorizontalLayout {
        x: 0px;
        y: 8px;
        width: 100%;
        height: parent.height - 16px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        cross-axis-alignment: center;

        icon-box := Rectangle {
            width: 24px;
            height: 24px;
            background: transparent;

            // Two branches: Slint has no element-form `else if`.
            if root.item.has-icon-image: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                border-radius: 4px;
                clip: true;

                Image {
                    source: root.item.icon-image;
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                }
            }
            if !root.item.has-icon-image && root.item.icon != "": AppIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: root.item.icon;
                size: 18px;
                // Brand marks use `text`; under high contrast the default text
                // colour is forced to pure white or black, but `text` is not.
                icon-color: root.item.icon-is-brand
                    ? Theme.text.transparentize(0.15)
                    : Theme.default-text-color.transparentize(0.15);
            }
        }

        main := Rectangle {
            horizontal-stretch: 1;
            height: root.main-height;
            background: transparent;
            clip: true;

            // Slint has no baseline alignment, so the author is centred in the
            // title line. The explicit `y` matters: a child of a plain element is
            // otherwise centred, putting the title on the loader tags.
            HorizontalLayout {
                y: 0px;
                width: 100%;
                height: 13px;
                spacing: 6px;
                cross-axis-alignment: center;

                title-text := Text {
                    // `overflow: elide` gives a zero minimum, so the layout can
                    // shrink it; its preferred width is still the whole text.
                    horizontal-stretch: 0;
                    height: 13px;
                    text: CommandText.title(root.item.title-kind, root.item.title);
                    font-size: 13px;
                    font-weight: Theme.font-weight-normal;
                    color: Theme.default-text-color;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    overflow: elide;
                }

                // No elide, so the author keeps its whole name and the title
                // gives way.
                if root.item.author != "": author-text := Text {
                    horizontal-stretch: 0;
                    height: 13px;
                    text: CommandText.author(root.item.author);
                    font-size: 11px;
                    font-weight: Theme.font-weight-normal;
                    color: Theme.subtext-0;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }

                // Slack after the author, so it sits against the title.
                Rectangle {
                    min-width: 0px;
                    horizontal-stretch: 1;
                }
            }

            if root.item.loaders.length > 0: Rectangle {
                x: 0px;
                y: 16px;
                width: 100%;
                height: 14px;
                background: transparent;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 4px;
                    cross-axis-alignment: center;

                    for loader in root.item.loaders: loader-tag := Rectangle {
                        height: 14px;
                        width: loader-text.width + 10px;
                        border-radius: 4px;
                        background: Theme.surface-0;

                        loader-text := Text {
                            text: ContentText.loader(loader);
                            font-size: 10px;
                            font-weight: Theme.font-weight-normal;
                            color: Theme.subtext-1;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        if root.item.subtitle-kind != "" || root.item.subtitle != "": subtitle-text := Text {
            horizontal-stretch: 0;
            height: 12px;
            // Categories resolve from a key; an instance's `loader · version` is
            // already data.
            text: root.item.subtitle-kind != ""
                ? CommandText.category(root.item.subtitle-kind)
                : root.item.subtitle;
            font-size: 12px;
            font-weight: Theme.font-weight-normal;
            color: Theme.subtext-0;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        if root.item.has-children: AppIcon {
            name: "chevron-forward";
            size: 14px;
            icon-color: Theme.overlay-1;
        }
    }

    // Hover uses a raw move, not `TouchArea.moved`, which is a drag and requires
    // the button held.
    pointer := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if event.kind == PointerEventKind.move {
                root.pointer-moved(root.index);
            }
            // The scroll area under the row still wants its own moves.
            return EventResult.reject;
        }
        clicked => { root.pressed(root.index); }
    }
}

// The command palette overlay: a scrim and the panel. It appears without an
// entrance animation.
//
// Keys are handled in `capture-key-pressed`, not `key-pressed`: a `TextInput`
// accepts Backspace and the arrows first, so an ancestor would never see them.
// A Backspace with text in the field is rejected so the field can edit normally.
export component CommandPaletteOverlay inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #00000042;
    border-radius: 16px;
    // Between the content overlays and the dialogs (`z: 2000`).
    z: 1500;

    // Declared before the panel, so the panel stays on top: the last-declared
    // element is hit-tested first.
    scrim := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { CommandPaletteState.close(); }
        // Take the wheel, or the pages behind scroll.
        scroll-event(event) => { accept }
    }

    // Capped at 320px including padding, and shrinks to the taller of the list
    // and the empty state. The `max` keeps the 72px spinner from being clipped.
    private property <length> results-height: min(320px, max(CommandPaletteState.items-content-height, root.empty-height) + 12px);
    // Border + input row + results + footer + border.
    private property <length> panel-height: 74px + root.results-height + 2px;

    private property <bool> shown: CommandPaletteState.visible;
    visible: root.shown;

    panel := Rectangle {
        // The same span the title bar's search field is given.
        width: max(600px, root.width - 500px);
        height: root.panel-height;
        x: (root.width - self.width) / 2;
        // Hangs 4px below the top edge, inside the title bar.
        y: 4px;
        drop-shadow-color: #00000071;
        drop-shadow-blur: 50px;
        background: Theme.base;
        border-width: 1px;
        border-color: Theme.surface-1.with-alpha(0.9);
        border-radius: 12px;

        // Starts 1px in, since a border does not inset children. `clip` lives here
        // so the panel can keep its drop shadow; the radius is 1px smaller.
        content := Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: 11px;
            clip: true;
            background: transparent;

            // A `FocusScope` only sees events of what it contains, and it centres
            // children with no `y`, so every child below sets one.
            scope := FocusScope {
                width: 100%;
                height: 100%;

                // Focus the field on the way in. `app.slint` restores focus on the
                // way out, since Slint drops it only on the next key press.
                private property <bool> shown: CommandPaletteState.visible;
                changed shown => {
                    if shown {
                        input.focus();
                    }
                }

                capture-key-pressed(event) => {
                    if (event.text == Key.Backspace && CommandPaletteState.query == "" && CommandPaletteState.mode != "root") {
                        CommandPaletteState.back-to-root();
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        CommandPaletteState.move-selection(1);
                        return accept;
                    }
                    if (event.text == Key.UpArrow) {
                        CommandPaletteState.move-selection(-1);
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        if (CommandPaletteState.query != "") {
                            CommandPaletteState.clear-query();
                        } else if (CommandPaletteState.mode != "root") {
                            CommandPaletteState.back-to-root();
                        } else {
                            Navigation.escape();
                        }
                        return accept;
                    }
                    return reject;
                }

                // Swallows clicks, so only the scrim closes. Rows are declared
                // after this and take their own.
                panel-touch := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;

                    // Clears hover over the panel; rows declared later take their
                    // own moves.
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move {
                            CommandPaletteState.hover(-1);
                        }
                        return EventResult.reject;
                    }
                }

                input-row := Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 41px;
                    background: transparent;

                    Rectangle {
                        x: 0px;
                        y: 40px;
                        width: 100%;
                        height: 1px;
                        background: Theme.surface-1.with-alpha(0.8);
                    }

                    AppIcon {
                        x: 16px;
                        y: 12px;
                        name: "search";
                        size: 16px;
                        icon-color: Theme.default-text-color.transparentize(0.2);
                    }

                    if CommandPaletteState.query == "": Text {
                        x: 42px;
                        y: 12px;
                        width: parent.width - 42px - 16px;
                        height: 16px;
                        text: CommandText.placeholder(CommandPaletteState.mode, CommandPaletteState.source);
                        font-size: 15px;
                        font-weight: Theme.font-weight-normal;
                        color: Theme.default-text-color.transparentize(0.5);
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    input := TextInput {
                        // The 16px icon plus a 10px gap.
                        x: 42px;
                        y: 12px;
                        width: parent.width - 42px - 16px;
                        height: 16px;
                        text <=> CommandPaletteState.query;
                        font-size: 15px;
                        font-weight: Theme.font-weight-normal;
                        color: Theme.default-text-color;
                        // The macOS caret uses the selection background at full
                        // alpha, so a translucent one gives a text-coloured caret.
                        selection-background-color: Theme.default-text-color.with-alpha(0.3);
                        selection-foreground-color: Theme.default-text-color;
                        single-line: true;
                        vertical-alignment: center;
                        input-type: text;
                        accepted => { CommandPaletteState.perform-selected(); }
                        edited => { CommandPaletteState.query-changed(); }
                    }
                }

                results := Rectangle {
                    x: 0px;
                    y: 41px;
                    width: 100%;
                    height: root.results-height;
                    background: transparent;

                    results-view := ScrollView {
                        x: 6px;
                        y: 6px;
                        width: parent.width - 12px;
                        height: parent.height - 12px;

                        // A new list starts at the top. Globals are mirrored locally
                        // because `changed` does not take a qualified global.
                        private property <int> items-seq: CommandPaletteState.items-seq;
                        private property <int> selected-seq: CommandPaletteState.selected-seq;
                        changed items-seq => { self.scroll-to(0px, false); }
                        changed selected-seq => { self.reveal-selected(); }

                        // Scroll only when the arrow keys took the row off screen,
                        // with 8px of slack. All values use the `content-y` sign:
                        // it counts down, so a row 400px in is `-400px`, and
                        // `scroll-to` takes the same sign. Passing `offsetTop`
                        // directly clamps every call to zero.
                        function reveal-selected() {
                            let top = -CommandPaletteState.selected-row-y;
                            let bottom = top - CommandPaletteState.selected-row-height;
                            let first = self.content-y;
                            let last = self.content-y - self.height;
                            if top > first {
                                self.scroll-to(top + 8px, true);
                            } else if bottom < last {
                                self.scroll-to(bottom + self.height - 8px, true);
                            }
                        }

                        // Each row carries its heading's height, so the loop is a flat
                        // stack of `label-height + row-height`; `label-height` is 0
                        // except on a section's first row.
                        for item[index] in CommandPaletteState.items: row-slot := Rectangle {
                            width: 100%;
                            height: item.label-height + item.row-height;
                            background: transparent;

                            // The heading line; its box includes 4px of space below.
                            if item.label-height > 0: section-label := Text {
                                x: 10px;
                                y: 6px;
                                width: parent.width - 20px;
                                height: 11px;
                                text: CommandText.section(item.section-kind);
                                font-size: 11px;
                                font-weight: Theme.font-weight-normal;
                                color: Theme.subtext-0;
                            }

                            PaletteRow {
                                x: 0px;
                                y: item.label-height;
                                width: 100%;
                                height: item.row-height;
                                item: item;
                                index: index;
                                selected: item.key == CommandPaletteState.selected-key;
                                hovered: item.key == CommandPaletteState.hovered-key;
                                // Clicking a non-selected row selects it; clicking
                                // the selected one opens it.
                                pressed(row) => { CommandPaletteState.click(row); }
                                pointer-moved(row) => { CommandPaletteState.hover(row); }
                            }
                        }

                        if CommandPaletteState.items.length == 0 && root.empty-kind != "none": Rectangle {
                            width: 100%;
                            height: root.empty-height;
                            background: transparent;

                            if root.empty-kind == "searching": Loading {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                size: 24px;
                                stroke-width: 4;
                            }
                            if root.empty-kind != "searching": empty-text := Text {
                                x: 16px;
                                y: (parent.height - self.height) / 2;
                                width: parent.width - 32px;
                                height: 13px;
                                text: CommandText.empty(root.empty-kind, CommandPaletteState.source);
                                font-size: 13px;
                                font-weight: Theme.font-weight-normal;
                                color: Theme.subtext-0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                footer := Rectangle {
                    x: 0px;
                    y: parent.height - self.height;
                    width: 100%;
                    height: 31px;
                    background: transparent;
                    border-width: 1px;
                    border-color: Theme.surface-1.with-alpha(0.8);

                    // The breadcrumb stretches and elides; the hints keep their
                    // width, putting one at each end.
                    HorizontalLayout {
                        x: 12px;
                        y: 8px;
                        width: parent.width - 24px;
                        height: 14px;
                        spacing: 12px;

                        breadcrumb := Text {
                            horizontal-stretch: 1;
                            text: CommandText.breadcrumb(
                                CommandPaletteState.mode,
                                CommandPaletteState.source);
                            font-size: 12px;
                            font-weight: Theme.font-weight-normal;
                            color: Theme.subtext-0;
                            // Slint centres text; an elided line is left-aligned.
                            horizontal-alignment: left;
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        hints := HorizontalLayout {
                            horizontal-stretch: 0;
                            spacing: 12px;
                            alignment: start;

                            navigate := HorizontalLayout {
                                vertical-stretch: 0;
                                spacing: 4px;
                                alignment: start;

                                KeyCap {
                                    text: "↑";
                                }

                                KeyCap {
                                    text: "↓";
                                }
                            }

                            // Back in a sub-mode, Close at the root. A layout is
                            // used because the cap's width is its glyph's.
                            if CommandPaletteState.mode != "root": back-hint := HorizontalLayout {
                                vertical-stretch: 0;
                                spacing: 4px;
                                alignment: start;

                                KeyCap {
                                    text: "⌫";
                                }

                                back-text := Text {
                                    text: CommandText.back-hint();
                                    font-size: 12px;
                                    font-weight: Theme.font-weight-normal;
                                    color: Theme.subtext-0;
                                    vertical-alignment: center;
                                }
                            }
                            if CommandPaletteState.mode == "root": close-hint := HorizontalLayout {
                                vertical-stretch: 0;
                                spacing: 4px;
                                alignment: start;

                                KeyCap {
                                    text: "esc";
                                }

                                close-text := Text {
                                    text: CommandText.close-hint();
                                    font-size: 12px;
                                    font-weight: Theme.font-weight-normal;
                                    color: Theme.subtext-0;
                                    vertical-alignment: center;
                                }
                            }

                            // The only hint in the default text colour.
                            if CommandPaletteState.selected-action-kind != "": primary := HorizontalLayout {
                                vertical-stretch: 0;
                                spacing: 4px;
                                alignment: start;

                                action-text := Text {
                                    text: CommandText.action(
                                        CommandPaletteState.selected-action-kind);
                                    font-size: 12px;
                                    font-weight: Theme.font-weight-normal;
                                    color: Theme.default-text-color;
                                    vertical-alignment: center;
                                }

                                AppIcon {
                                    name: "corner-down-left";
                                    size: 14px;
                                    icon-color: Theme.default-text-color;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Only the online mode can be empty; the root and instance modes never are.
    private property <string> empty-kind: {
        if (CommandPaletteState.mode != "search-online") { return "none"; }
        if (CommandPaletteState.online-searching) { return "searching"; }
        if (CommandPaletteState.query-empty) { return "type-to-search"; }
        if (CommandPaletteState.online-error) { return "failed"; }
        return "none";
    }

    private property <length> empty-height: root.empty-kind == "searching" ? 72px : 61px;

    // Folds query and mode because `changed` cannot watch a global. The control
    // character separator cannot occur in either.
    private property <string> debounce-key: CommandPaletteState.query + "\u{1}" + CommandPaletteState.mode;
    debounce := Timer {
        interval: 250ms;
        running: false;
        triggered => {
            // One shot: a timer left running would repeat every interval.
            debounce.stop();
            CommandPaletteState.run-search();
        }
    }

    changed debounce-key => {
        // `restart()` is a no-op on a timer that never ran, so start it first;
        // afterwards every change restarts the deadline.
        if debounce.running {
            debounce.restart();
        } else {
            debounce.start();
        }
    }
}
