import { Theme } from "../theme.slint";
import { AppIcon } from "../components/display/app-icon.slint";
import { ScrollView } from "../components/containers/scroll-view.slint";
import {
    NotificationItem,
    NotificationState,
    NotificationText,
} from "../globals/notifications.slint";
import { TaskItem, TaskState, TaskText } from "../globals/tasks.slint";

// The 4px progress strip at the bottom of a task card. It spans the card's full
// width; the card's own rounded clip gives the bottom corners their shape.
component TaskBar inherits Rectangle {
    in property <float> value: 0;
    in property <float> max: 0;
    in property <bool> loading: false;

    height: 4px;
    background: Theme.surface-2;

    private property <float> phase: mod(animation-tick(), 1.25s) / 1.25s;
    private property <float> sweep: self.phase * self.phase * (3.0 - 2.0 * self.phase);
    private property <length> sweep-x: root.width * (-0.60 + self.sweep * 1.70);

    if root.loading: Rectangle {
        width: root.width * 0.5;
        height: 100%;
        x: root.sweep-x;
        background: #f0f0f0;
    }

    if !root.loading: Rectangle {
        width: root.max > 0.0 ? min(root.value / root.max, 1.0) * root.width : 0px;
        height: 100%;
        x: 0px;
        background: #f0f0f0;
        animate width {
            duration: 300ms;
            easing: ease;
        }
    }
}

// One running task. The body is clickable when the task has a target; the X
// always asks for a stop, and the task centre decides whether it must confirm.
component TaskRow inherits Rectangle {
    in property <TaskItem> item;
    /// Read by a preview to pause its deadline while the pointer is on the card.
    out property <bool> hovered: card-click.has-hover || dismiss-touch.has-hover;
    /// The body was clicked. The centre navigates directly; a preview fades
    /// first and only then runs the action.
    callback body-clicked();

    width: 100%;
    height: 76px;
    background: transparent;

    card := Rectangle {
        width: 100%;
        height: 76px;
        border-radius: 10px;
        clip: true;
        background: root.item.action-kind != "none" && card-click.pressed ? Theme.surface-2
            : root.item.action-kind != "none" && card-click.has-hover ? Theme.surface-1
            : Theme.surface-0;
        animate background {
            duration: 120ms;
            easing: ease;
        }

        Rectangle {
            x: 0;
            y: 0;
            width: 42px;
            height: 100%;
            border-top-left-radius: 10px;
            border-bottom-left-radius: 10px;
            background: Theme.mantle;

            AppIcon {
                name: root.item.icon;
                size: 20px;
                icon-color: Theme.text;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            x: 52px;
            y: 11px;
            width: root.width - 92px;
            height: 16px;
            text: TaskText.title(root.item);
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }

        Text {
            x: 52px;
            y: 28px;
            width: root.width - 92px;
            height: 36px;
            text: TaskText.detail(root.item);
            color: Theme.text;
            font-size: 12px;
            wrap: word-wrap;
            max-lines: 2;
            overflow: elide;
            vertical-alignment: top;
        }

        card-click := TouchArea {
            width: root.width - 32px;
            height: 100%;
            // Enabled without a target too: a preview's deadline pauses on
            // hover, and a disabled area never reports it.
            enabled: !root.item.cancelling;
            clicked => {
                if root.item.action-kind != "none" {
                    root.body-clicked();
                }
            }
        }

        dismiss-button := Rectangle {
            x: root.width - 32px;
            y: 0;
            width: 32px;
            height: 100%;
            border-top-right-radius: 10px;
            border-bottom-right-radius: 10px;
            background: dismiss-touch.pressed ? Theme.surface-2.transparentize(0.6)
                : dismiss-touch.has-hover ? Theme.surface-1.transparentize(0.6)
                : Theme.surface-1.transparentize(0.82);
            animate background {
                duration: 120ms;
                easing: ease;
            }

            AppIcon {
                name: "xmark";
                size: 16px;
                icon-color: root.item.cancelling ? Theme.subtext-0 : Theme.text;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            dismiss-touch := TouchArea {
                enabled: !root.item.cancelling;
                clicked => { TaskState.request-cancel(root.item.id); }
            }
        }

        TaskBar {
            x: 0;
            y: root.height - 4px;
            width: 100%;
            value: root.item.value;
            max: root.item.max;
            loading: root.item.indeterminate;
        }
    }
}

// One floating preview of a running task. The task card itself is the toast; it
// disappears after five seconds while the centre keeps the ongoing card. The
// enter/leave motion mirrors `NotificationToast`: a short slide from the edge,
// a fade on a body click, and a slide back out before the row is removed.
component TaskToast inherits Rectangle {
    in property <TaskItem> item;

    width: 100%;
    height: 76px;
    background: transparent;

    private property <string> phase: "starting";
    private property <bool> leaving: root.phase == "leaving";
    private property <length> phase-dx: root.phase == "starting" || root.leaving ? 48px : 0px;
    private property <float> phase-alpha: root.phase == "shown" ? 1.0 : 0.0;
    private property <bool> body-fading: false;
    private property <float> body-alpha: root.body-fading ? 0.0 : 1.0;

    animate phase-dx, phase-alpha {
        duration: root.leaving ? 200ms : 240ms;
        easing: root.leaving
            ? cubic-bezier(0.55, 0, 1, 0.45)
            : cubic-bezier(0, 0.55, 0.35, 1);
    }
    animate body-alpha {
        duration: 160ms;
        easing: ease-out-quad;
    }

    card := Rectangle {
        x: root.phase-dx;
        width: 100%;
        height: 100%;
        opacity: root.phase-alpha * root.body-alpha;
        background: transparent;

        // The shadow is a backdrop, not a property of the card: the card clips
        // its own contents to round the progress strip, and a blurred shadow on
        // that clipped layer would blur the text too.
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 10px;
            background: Theme.surface-0;
            drop-shadow-color: #00000073;
            drop-shadow-blur: 20px;
            drop-shadow-offset-y: 6px;
        }

        task := TaskRow {
            item: root.item;
            body-clicked => { root.start-body-fade(); }
        }
    }

    private property <int> remaining-ms: 5000;
    private property <int> shown-id: -1;

    // A row reused when another task is inserted at the front must get its own
    // deadline and enter motion; progress updates keep the same id.
    changed item => {
        if root.item.id != root.shown-id {
            root.shown-id = root.item.id;
            root.remaining-ms = 5000;
            root.body-fading = false;
            root.phase = "starting";
            enter-timer.restart();
        }
        if root.item.closing {
            root.leave();
        }
    }

    public function leave() {
        if root.phase != "leaving" {
            root.phase = "leaving";
        }
    }

    function start-body-fade() {
        if !root.body-fading && !root.leaving {
            root.body-fading = true;
        }
    }

    enter-timer := Timer {
        interval: 16ms;
        running: root.phase == "starting";
        triggered => { root.phase = "shown"; }
    }

    leave-timer := Timer {
        interval: 220ms;
        running: root.leaving;
        triggered => { TaskState.expire-toast(root.item.id); }
    }

    body-fade-timer := Timer {
        interval: 160ms;
        running: root.body-fading;
        triggered => {
            root.body-fading = false;
            TaskState.activate(root.item.id);
            TaskState.expire-toast(root.item.id);
        }
    }

    expire-timer := Timer {
        interval: 50ms;
        running: !task.hovered && !root.leaving && !root.body-fading && root.remaining-ms > 0;
        triggered => {
            root.remaining-ms -= 50;
            if root.remaining-ms <= 0 {
                root.leave();
            }
        }
    }
}

component NotificationRow inherits Rectangle {
    in property <NotificationItem> item;
    /// How far the card travels on enter and leave. The centre clips at its
    /// content padding, so its default keeps the exit visible; the toast sits
    /// nearer the window edge and has room for a longer throw.
    in property <length> slide-distance: 24px;
    /// The floating preview needs a shadow to lift it off the page; the centre
    /// card sits in a panel of its own and stays flat.
    in property <bool> floating: false;
    /// Set by the centre's Clear all; the whole list exits as one stagger.
    in property <bool> clearing: false;
    in property <int> clear-index: 0;
    /// The toast checkmark drops the card instead of sliding it right.
    in property <bool> fall-on-dismiss: false;
    /// The centre's cards leave with opacity only; a toast still slides right
    /// when its five seconds run out.
    in property <bool> slide-on-exit: true;
    /// The toast body fades before its action runs.
    in property <bool> fade-on-body-click: false;
    /// Read by a toast to pause its deadline while the pointer is on the card.
    out property <bool> hovered: card-click.has-hover || dismiss-touch.has-hover;
    /// The card is already leaving; a toast must stop its deadline.
    out property <bool> closing: root.leaving || root.falling || root.body-fading;

    private property <length> dismiss-width: 32px;
    // `starting` holds the offset for one frame: Slint only advances an animated
    // property while something reads it, so the renderer has to see the start
    // values before the enter retargets them to rest.
    private property <string> phase: "starting";
    private property <bool> leaving: root.phase == "leaving";
    private property <length> phase-dx: root.phase == "starting"
        || (root.phase == "leaving" && root.slide-on-exit)
        ? root.slide-distance : 0px;
    private property <float> phase-alpha: root.phase == "shown" ? 1.0 : 0.0;
    // Clear all keeps the rows in the model while they leave, so they travel
    // from their own slots instead of collapsing into each other.
    private property <length> clear-dx: root.clearing && root.slide-on-exit
        ? root.slide-distance : 0px;
    private property <float> clear-alpha: root.clearing ? 0.0 : 1.0;
    // The fall is simulated rather than eased: a real toss needs the vertical
    // speed to reverse, which no single cubic-bezier can express. Drive it from
    // `animation-tick()` so it advances per rendered frame, not per timer tick.
    private property <bool> falling: false;
    private property <bool> fall-ticking: false;
    private property <duration> fall-start: 0ms;
    private property <float> fall-t: root.fall-ticking
        ? min((animation-tick() - root.fall-start) / 1s, 1.0)
        : 0.0;
    private property <length> fall-dx: root.fall-t * -620px;
    private property <length> fall-dy: root.fall-t * -110px + root.fall-t * root.fall-t * 2400px;
    private property <angle> fall-rotation: root.fall-t * -50deg;
    private property <float> fall-alpha: max(0.0, 1.0 - root.fall-t / 0.45);
    private property <bool> body-fading: false;
    private property <float> body-alpha: root.body-fading ? 0.0 : 1.0;
    private property <string> title: NotificationText.notification-title(root.item);
    private property <bool> has-title: root.title != "";

    width: 100%;
    height: 68px;
    background: transparent;

    animate phase-dx, phase-alpha {
        duration: root.leaving ? 200ms : 240ms;
        easing: root.leaving
            ? cubic-bezier(0.55, 0, 1, 0.45)
            : cubic-bezier(0, 0.55, 0.35, 1);
    }
    animate clear-dx, clear-alpha {
        duration: 200ms;
        delay: root.clear-index * 40ms;
        easing: cubic-bezier(0.55, 0, 1, 0.45);
    }
    animate body-alpha {
        duration: 160ms;
        easing: ease-out-quad;
    }

    // The wrapper's y belongs to the stack; the card moves itself inside it, so
    // the fall and the reflow do not both animate the same property.
    card := Rectangle {
        width: 100%;
        height: 68px;
        x: root.phase-dx + root.clear-dx + root.fall-dx;
        y: root.fall-dy;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: root.fall-rotation;
        opacity: root.phase-alpha * root.clear-alpha * root.fall-alpha * root.body-alpha;
        border-radius: 10px;
        drop-shadow-color: root.floating ? #00000073 : transparent;
        drop-shadow-blur: root.floating ? 20px : 0px;
        drop-shadow-offset-y: root.floating ? 6px : 0px;
        background: root.item.has-action && card-click.pressed ? Theme.surface-2
            : root.item.has-action && card-click.has-hover ? Theme.surface-1
            : Theme.surface-0;
        animate background {
            duration: 120ms;
            easing: ease;
        }

        card-click := TouchArea {
            width: root.width - root.dismiss-width;
            // Enabled even without an action: `hovered` above is what pauses a
            // toast's deadline, and a disabled area never reports hover.
            enabled: !root.closing;
            clicked => {
                if root.fade-on-body-click {
                    root.start-body-fade();
                } else {
                    root.body-clicked();
                }
            }
        }

        Rectangle {
            x: 0;
            y: 0;
            width: 42px;
            height: 100%;
            border-top-left-radius: 10px;
            border-bottom-left-radius: 10px;
            background: Theme.mantle;

            AppIcon {
                name: root.item.icon;
                size: 20px;
                icon-color: Theme.text;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            x: 52px;
            y: 11px;
            width: root.width - 92px;
            height: 16px;
            visible: root.has-title;
            text: root.title;
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }

        Text {
            x: 52px;
            y: root.has-title ? 28px : 10px;
            width: root.width - 92px;
            height: root.has-title ? root.height - 34px : root.height - 20px;
            text: NotificationText.notification-body(root.item);
            color: Theme.text;
            font-size: 12px;
            wrap: word-wrap;
            // `max-lines` with `elide` drops the first wrapped line in this
            // layout, so a titled card clips instead: the player must see the
            // instance name that starts the sentence.
            max-lines: root.has-title ? 2 : 3;
            overflow: root.has-title ? clip : elide;
            vertical-alignment: root.has-title ? top : center;
        }

        dismiss-button := Rectangle {
            x: root.width - root.dismiss-width;
            y: 0;
            width: root.dismiss-width;
            height: 100%;
            border-top-right-radius: 10px;
            border-bottom-right-radius: 10px;
            background: dismiss-touch.pressed ? Theme.surface-2.transparentize(0.6)
                : dismiss-touch.has-hover ? Theme.surface-1.transparentize(0.6)
                : Theme.surface-1.transparentize(0.82);
            animate background {
                duration: 120ms;
                easing: ease;
            }

            AppIcon {
                name: "checkmark-outline";
                size: 16px;
                icon-color: Theme.text;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            dismiss-touch := TouchArea {
                enabled: !root.closing;
                clicked => {
                    root.dismiss-on-finish = true;
                    if root.fall-on-dismiss {
                        root.start-fall();
                    } else {
                        root.leave();
                    }
                }
            }
        }
    }

    /// The exit finished; the owner decides whether the card leaves only its
    /// preview or the centre as well.
    callback finished();
    /// The checkmark asked to dismiss the notification itself, not just its
    /// preview (a preview expires on its own without touching the centre).
    callback dismiss-requested();
    /// The body was clicked; the owner runs the notice's action.
    callback body-clicked();

    private property <bool> dismiss-on-finish: false;

    // A reused row must start a fresh notice with no fall in flight, or the
    // previous toast's latched time base leaves the new one off screen.
    changed item => {
        root.falling = false;
        root.fall-ticking = false;
        root.fall-start = 0ms;
    }

    public function leave() {
        if root.phase != "leaving" {
            root.phase = "leaving";
        }
    }

    function start-fall() {
        if !root.falling {
            root.fall-start = animation-tick();
            root.fall-ticking = true;
            root.falling = true;
        }
    }

    function start-body-fade() {
        if !root.body-fading {
            root.body-fading = true;
        }
    }

    enter-timer := Timer {
        interval: 16ms;
        running: root.phase == "starting";
        triggered => { root.phase = "shown"; }
    }

    leave-timer := Timer {
        interval: 220ms;
        running: root.phase == "leaving";
        triggered => {
            if root.dismiss-on-finish {
                root.dismiss-requested();
            } else {
                root.finished();
            }
        }
    }

    fall-timer := Timer {
        interval: 450ms;
        running: root.falling;
        triggered => {
            root.falling = false;
            root.dismiss-requested();
        }
    }

    body-fade-timer := Timer {
        interval: 160ms;
        running: root.body-fading;
        triggered => {
            root.body-fading = false;
            root.body-clicked();
        }
    }
}

// One floating preview. Only the toast owns the deadline; the centre's copy of
// the same notice has none.
component NotificationToast inherits Rectangle {
    in property <NotificationItem> item;
    width: 100%;
    height: 68px;
    background: transparent;

    private property <int> remaining-ms: 5000;

    card := NotificationRow {
        item: root.item;
        slide-distance: 48px;
        floating: true;
        fall-on-dismiss: true;
        fade-on-body-click: true;
        finished => { NotificationState.expire(root.item.id); }
        dismiss-requested => { NotificationState.dismiss(root.item.id); }
        body-clicked => {
            if root.item.has-action {
                NotificationState.activate(root.item.id);
            }
            NotificationState.expire(root.item.id);
        }
    }

    // Stopping the timer while hovered preserves `remaining-ms`, so the deadline
    // pauses rather than restarting the whole five seconds.
    expire-timer := Timer {
        interval: 50ms;
        running: !card.hovered && !card.closing && root.remaining-ms > 0;
        triggered => {
            root.remaining-ms -= 50;
            if root.remaining-ms <= 0 {
                card.leave();
            }
        }
    }
}

/// The floating previews in the window's top-right corner. They mirror the
/// centre's newest notifications and stack downwards; a preview that expires
/// leaves the centre untouched.
export component NotificationToasts inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    private property <length> toast-width: 320px;
    private property <length> toast-pitch: 76px;
    private property <length> task-toast-pitch: 84px;
    private property <length> toast-margin: 16px;
    private property <length> task-toast-height: max(0px, TaskState.toasts.length * root.task-toast-pitch - 8px);
    // Running task previews come first; completed notices wait below them.
    private property <length> notification-y: root.toast-margin
        + (TaskState.toasts.length > 0 ? root.task-toast-height + 8px : 0px);

    // Absolute positions, like the centre's stack: a layout child's position
    // belongs to its layout and would snap when the rows move.
    task-toast-stack := Rectangle {
        x: root.width - root.toast-width - root.toast-margin;
        y: root.toast-margin;
        width: root.toast-width;
        height: root.task-toast-height;

        for item[i] in TaskState.toasts: TaskToast {
            item: item;
            y: i * root.task-toast-pitch;
            animate y {
                duration: 260ms;
                easing: cubic-bezier(0.33, 1, 0.68, 1);
            }
        }
    }

    toast-stack := Rectangle {
        x: root.width - root.toast-width - root.toast-margin;
        y: root.notification-y;
        width: root.toast-width;
        height: max(0px, NotificationState.toasts.length * root.toast-pitch - 8px);

        animate y {
            duration: 260ms;
            easing: cubic-bezier(0.33, 1, 0.68, 1);
        }

        for item[i] in NotificationState.toasts: NotificationToast {
            item: item;
            y: i * root.toast-pitch;
            animate y {
                duration: 260ms;
                easing: cubic-bezier(0.33, 1, 0.68, 1);
            }
        }
    }
}

/// The notification centre uses the same full-height side-panel treatment as
/// the news surface, entering from the right and covering the window's right
/// side rather than floating above the page.
export component NotificationOverlay inherits Rectangle {
    width: 100%;
    height: 100%;
    visible: root.phase != "closed";
    // The panel's drop shadow paints outside its box; clip it so the top blur
    // cannot cross into the title bar above this overlay.
    clip: true;
    background: #000000.with-alpha(0.35 * root.scrim-alpha);

    private property <string> phase: "closed";
    private property <bool> open: NotificationState.visible;
    private property <float> scrim-alpha: root.phase == "shown" ? 1.0 : 0.0;
    private property <length> panel-width: 300px;
    // Only the slide offset animates; the window-relative term stays outside it,
    // so a resize moves the panel with the right edge instead of easing after it.
    private property <length> panel-offset: root.phase == "shown" ? 0px : root.panel-width;
    private property <bool> leaving: root.phase == "leaving";
    // Clear all keeps the rows mounted while they leave; the timer below drops
    // them from the model only after the last staggered card has finished.
    private property <bool> clearing: false;
    animate scrim-alpha {
        duration: 150ms;
        easing: ease-out-quad;
    }
    animate panel-offset {
        duration: root.leaving ? 180ms : 220ms;
        easing: root.leaving ? cubic-bezier(0.47, 0, 1, 0.75) : cubic-bezier(0, 0.47, 0.25, 1);
    }

    changed open => {
        if root.open {
            // The centre already lists them; a preview would only cover it and
            // should not keep its own deadline running behind the panel.
            NotificationState.expire-all();
            TaskState.expire-all-toasts();
            root.phase = "starting";
            start-timer.restart();
        } else if root.phase != "closed" {
            root.phase = "leaving";
            leave-timer.restart();
        }
    }
    init => {
        if NotificationState.visible { root.phase = "shown"; }
    }

    function start-clear() {
        if !root.clearing && NotificationState.notifications.length > 0 {
            root.clearing = true;
        }
    }

    start-timer := Timer {
        interval: 16ms;
        running: root.phase == "starting";
        triggered => { root.phase = "shown"; }
    }

    leave-timer := Timer {
        interval: 180ms;
        running: root.phase == "leaving";
        triggered => { root.phase = "closed"; }
    }

    // 40ms per row plus the 200ms exit, with 20ms of margin.
    clear-timer := Timer {
        interval: (NotificationState.notifications.length - 1) * 40ms + 220ms;
        running: root.clearing;
        triggered => {
            root.clearing = false;
            NotificationState.clear();
        }
    }

    TouchArea {
        clicked => { NotificationState.close(); }
        scroll-event(event) => { accept }
    }

    Rectangle {
        x: root.width - root.panel-width + root.panel-offset;
        y: 0px;
        width: root.panel-width;
        height: root.height;
        background: Theme.base;
        drop-shadow-color: #00000059;
        drop-shadow-blur: 24px;
        drop-shadow-offset-x: -6px;

        TouchArea { }

        ScrollView {
            scrollbar-top: 8px;
            scrollbar-bottom: 8px;
            VerticalLayout {
                padding-top: 16px;
                padding-right: 24px;
                padding-bottom: 16px;
                padding-left: 24px;
                spacing: 8px;
                HorizontalLayout {
                    height: 24px;
                    spacing: 8px;
                    Text {
                        text: @tr("NotificationOverlay" => "Notifications");
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: Theme.font-weight-bold;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "" + NotificationState.notification-count;
                        color: Theme.mauve;
                        font-size: 13px;
                        font-weight: Theme.font-weight-bold;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    clear-all := Rectangle {
                        width: clear-all-label.preferred-width;
                        height: parent.height;
                        background: transparent;

                        clear-all-label := Text {
                            text: @tr("NotificationOverlay" => "Clear all");
                            color: clear-all-touch.has-hover ? Theme.yellow : Theme.text;
                            font-size: 12px;
                            font-weight: Theme.font-weight-normal;
                            width: parent.width;
                            height: parent.height;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            animate color {
                                duration: 120ms;
                                easing: ease;
                            }
                        }

                        clear-all-touch := TouchArea {
                            enabled: !root.clearing;
                            clicked => { root.start-clear(); }
                        }
                    }
                }

                // Running work comes before the completed notices. The two
                // stacks keep their own pitch because a task card carries a
                // progress strip at its bottom and is taller than a notice.
                if TaskState.tasks.length > 0: VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        height: 24px;
                        spacing: 8px;
                        Text {
                            text: @tr("NotificationOverlay" => "Active tasks");
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: Theme.font-weight-bold;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "" + TaskState.task-count;
                            color: Theme.mauve;
                            font-size: 13px;
                            font-weight: Theme.font-weight-bold;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    tasks-stack := Rectangle {
                        height: max(0px, TaskState.tasks.length * 84px - 8px);

                        for item[i] in TaskState.tasks: TaskRow {
                            item: item;
                            y: i * 84px;
                            body-clicked => { TaskState.activate(item.id); }
                            animate y {
                                duration: 260ms;
                                easing: cubic-bezier(0.33, 1, 0.68, 1);
                            }
                        }
                    }
                }

                // Fixed-height rows are positioned absolutely so one that
                // outlives the card above it can glide to its new slot; a layout
                // would snap it there in one frame.
                notifications-stack := Rectangle {
                    height: max(0px, NotificationState.notifications.length * 76px - 8px);

                    for item[i] in NotificationState.notifications: NotificationRow {
                        item: item;
                        y: i * 76px;
                        clearing: root.clearing;
                        clear-index: i;
                        slide-on-exit: false;
                        animate y {
                            duration: 260ms;
                            easing: cubic-bezier(0.33, 1, 0.68, 1);
                        }
                        // While Clear all runs, the rows must survive until the
                        // list timer drops them together; an individual exit
                        // must not pull one out from under the stagger.
                        finished => {
                            if !root.clearing {
                                NotificationState.dismiss(item.id);
                            }
                        }
                        dismiss-requested => { NotificationState.dismiss(item.id); }
                        body-clicked => {
                            if item.has-action {
                                NotificationState.activate(item.id);
                            }
                        }
                    }
                }
            }
        }
    }
}
