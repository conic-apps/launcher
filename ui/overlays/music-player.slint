import { Theme } from "../theme.slint";
import { AppIcon } from "../components/display/app-icon.slint";
import { ScrollView } from "../components/containers/scroll-view.slint";
import { MusicState } from "../globals/music.slint";

// A player button. The ink is its own animated property because the icon is a
// child with a plain `icon-color` binding.
component PlayerButton inherits Rectangle {
    in property <string> icon;
    in property <length> size: 34px;
    in property <bool> on: false;
    in property <bool> primary: false;
    /// Slint has no tooltip on an icon button, so this is the accessible label.
    in property <string> label: "";
    callback clicked;

    width: root.size;
    height: root.size;
    border-radius: 10px;
    background: touch.pressed
        ? Theme.overlay-0.transparentize(0.3)
        : touch.has-hover
        ? Theme.surface-2.transparentize(0.3)
        : Colors.transparent;
    animate background {
        duration: 120ms;
        easing: Easing.ease;
    }

    private property <color> ink: root.primary || root.on
        ? Theme.mauve
        : touch.has-hover ? Theme.text : Theme.subtext-0;
    animate ink {
        duration: 120ms;
        easing: Easing.ease;
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    AppIcon {
        icon-color: root.ink;
        name: root.icon;
        size: root.primary ? 24px : 18px;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component PlaylistItem inherits Rectangle {
    in property <string> name;
    in property <bool> playing: false;
    callback clicked;

    width: 100%;
    height: 26px;
    border-radius: 8px;
    background: touch.has-hover
        ? Theme.surface-1.transparentize(0.3)
        : Colors.transparent;
    animate background {
        duration: 120ms;
        easing: Easing.ease;
    }

    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => { root.clicked(); }

    // Keeps the line tight against the font's taller natural line box.
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        cross-axis-alignment: center;

        Text {
            height: 12px;
            text: root.name;
            font-size: 12px;
            font-weight: Theme.font-weight-normal;
            color: root.playing
                ? Theme.blue
                : touch.has-hover ? Theme.text : Theme.subtext-0;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The background-music panel: a scrim, the player card in the top-right, and
// the playlist popup beneath it. Both cards use `base` with a 1px border and a
// blurred shadow (Slint has no shadow offset).
export component MusicPlayerOverlay inherits Rectangle {
    in property <bool> open: MusicState.panel-open;

    width: 100%;
    height: 100%;
    background: #000000.with-alpha(0.45 * root.scrim-alpha);

    // As in `Dialog`, the panel shows one frame at the start values because an
    // animated property only advances while read.
    private property <string> phase: "closed";
    visible: root.phase != "closed";

    changed open => {
        if root.open {
            if root.phase == "closed" {
                root.phase = "starting";
                start-timer.restart();
            } else {
                // Play the enter from wherever the leave got to.
                root.phase = "shown";
            }
            // The subtree is rebuilt with the overlay, so re-enter the playlist;
            // its open flag lives in `MusicState`, not here.
            if root.playlist-open {
                root.playlist-phase = "starting";
                playlist-start.restart();
            }
        } else if root.phase != "closed" && root.phase != "leaving" {
            // The playlist is inside this subtree, so it fades out with it.
            root.phase = "leaving";
        }
    }

    start-timer := Timer {
        interval: 16ms;
        running: root.phase == "starting";
        triggered => { root.phase = "shown"; }
    }

    leave-timer := Timer {
        interval: 150ms;
        running: root.phase == "leaving";
        triggered => {
            root.phase = "closed";
            root.playlist-phase = "closed";
            // End a drag that never got its release; otherwise the paused state
            // would persist into the next open.
            root.end-drag();
        }
    }

    init => {
        if root.open {
            root.phase = "shown";
        }
    }

    // Its own phase machine: the playlist toggles while the overlay stays open,
    // so it cannot share the overlay's transition. `Dialog`'s rules apply.
    private property <bool> playlist-open: MusicState.playlist-open;
    private property <string> playlist-phase: "closed";
    private property <float> playlist-alpha: root.playlist-phase == "shown" ? 1.0 : 0.0;
    private property <length> playlist-dy: root.playlist-phase == "shown" ? 0px : -4px;
    animate playlist-alpha {
        duration: 120ms;
        easing: Easing.ease;
    }
    animate playlist-dy {
        duration: 120ms;
        easing: Easing.ease;
    }

    changed playlist-open => {
        if root.playlist-open {
            if root.playlist-phase == "closed" {
                root.playlist-phase = "starting";
                playlist-start.restart();
            } else {
                // Play the enter from wherever the leave got to.
                root.playlist-phase = "shown";
            }
        } else if root.playlist-phase != "closed" && root.playlist-phase != "leaving" {
            root.playlist-phase = "leaving";
        }
    }

    playlist-start := Timer {
        interval: 16ms;
        running: root.playlist-phase == "starting";
        triggered => { root.playlist-phase = "shown"; }
    }

    playlist-leave := Timer {
        interval: 120ms;
        running: root.playlist-phase == "leaving";
        triggered => { root.playlist-phase = "closed"; }
    }

    private property <float> scrim-alpha: root.phase == "shown" ? 1.0 : 0.0;
    animate scrim-alpha {
        duration: 150ms;
        easing: Easing.ease;
    }
    private property <float> card-alpha: root.phase == "shown" ? 1.0 : 0.0;
    private property <length> card-dy: root.phase == "shown" ? 0px : -8px;
    animate card-alpha {
        duration: 150ms;
        easing: Easing.ease;
    }
    animate card-dy {
        duration: 150ms;
        easing: Easing.ease;
    }

    private property <bool> dragging: false;

    // Whether this drag stopped the music, so the release restores it. A drag
    // that began paused leaves it paused.
    private property <bool> drag-paused-playback: false;

    // A drag asks "where", not "playing", so stop the transport and restore the
    // prior state on release rather than toggling.
    function begin-drag() {
        root.dragging = true;
        if (MusicState.is-playing) {
            MusicState.pause();
            root.drag-paused-playback = true;
        }
    }

    // Ends it, and is safe to call when no drag is in flight.
    function end-drag() {
        root.dragging = false;
        if (root.drag-paused-playback) {
            root.drag-paused-playback = false;
            MusicState.resume();
        }
    }

    // Sized rather than measured: a `for` row is measured at its preferred width,
    // which is not the height the layout uses.
    private property <length> playlist-row-height: 26px;
    private property <length> playlist-empty-height: 36px;
    private property <length> playlist-items-height: 4px
        + (MusicState.tracks.length > 0
        ? playlist-row-height * MusicState.tracks.length
        : playlist-empty-height)
        + 8px;

    // Clamped to what is left, so both cards fit at the minimum window height.
    private property <length> card-height: 125px;
    private property <length> overlay-padding: 16px;
    private property <length> card-gap: 12px;
    private property <length> playlist-max-height: min(
    320px,
    root.height - 2 * root.overlay-padding - root.card-height - root.card-gap,
    );

    // Closes on a press outside a card; each card has its own area declared after.
    scrim-touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                MusicState.close-panel();
            }
        }
    }

    // Each card is wrapped in a cell: a layout child cannot set its own `y`, so
    // the cell keeps the geometry and the inner card keeps the animation.
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        cross-axis-alignment: end;

        card-cell := Rectangle {
            width: 340px;
            height: root.card-height;
            background: Colors.transparent;

            card := Rectangle {
                width: 100%;
                height: 100%;
                y: root.card-dy;
                opacity: root.card-alpha;
                border-radius: 8px;
                background: Theme.base;
                border-width: 1px;
                border-color: Theme.overlay-0.transparentize(0.5);
                drop-shadow-color: #0000004d;
                drop-shadow-blur: 24px;

                card-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                }

                // The card cannot itself be the layout, since it carries the
                // background, border and shadow.
                card-body := VerticalLayout {
                    padding: 16px;

                    // `start` pins the text to the top of the 34px block, matching
                    // the 18px bottom margin; `stretch` and `center` would not.
                    track-info := VerticalLayout {
                        height: 34px;
                        alignment: start;

                        Text {
                            height: 16px;
                            text: MusicState.current-name != ""
                                ? MusicState.current-name
                                : @tr("No music");
                            font-size: 16px;
                            // The `bold` token is 700, so the literal 600 is used.
                            font-weight: 600;
                            // Dimmed while waiting on audio, via colour only so the
                            // card does not grow a row.
                            color: MusicState.buffering ? Theme.subtext-0 : Theme.text;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }

                    // Cross-axis centring aligns the 4px bar with the 11px clock
                    // line. The labels need `horizontal-stretch: 0`; the default
                    // 1 would grow them with the bar.
                    progress-area := HorizontalLayout {
                        height: 19px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        current-time-text := Text {
                            horizontal-stretch: 0;
                            height: 11px;
                            text: MusicState.current-time-text;
                            font-size: 11px;
                            font-weight: Theme.font-weight-normal;
                            color: Theme.subtext-0;
                        }

                        progress-bar := Rectangle {
                            horizontal-stretch: 1;
                            height: 4px;
                            border-radius: 4px;
                            background: Theme.surface-2.transparentize(0.2);

                            // `x: 0` pins the fill left; an unbound `x` centres it.
                            Rectangle {
                                x: 0px;
                                width: parent.width * MusicState.progress;
                                height: parent.height;
                                border-radius: 4px;
                                // Faded with the title while buffering.
                                background: MusicState.buffering
                                    ? Theme.mauve.transparentize(0.45)
                                    : Theme.mauve;
                            }

                            // Slint cannot listen outside the element, so the drag
                            // is tracked here; a press inside still seeks.
                            touch := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                // Pixels because lengths cannot be divided.
                                // `self.mouse-x` is already relative to this
                                // element, which covers the bar.
                                private property <float> ratio: clamp(
                                self.mouse-x / 1px / (parent.width / 1px),
                                0,
                                1,
                                );
                                function seek() {
                                    if MusicState.duration > 0 {
                                        MusicState.seek-ratio(self.ratio);
                                    }
                                }
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down
                                        && event.button == PointerEventButton.left {
                                        root.begin-drag();
                                        self.seek();
                                    } else if event.kind == PointerEventKind.up
                                        || event.kind == PointerEventKind.cancel {
                                        root.end-drag();
                                    } else if event.kind == PointerEventKind.move && root.dragging {
                                        self.seek();
                                    }
                                }
                            }
                        }

                        // A sibling of the bar; inside it, it would print over the
                        // track.
                        duration-text := Text {
                            horizontal-stretch: 0;
                            height: 11px;
                            text: MusicState.duration-text;
                            font-size: 11px;
                            font-weight: Theme.font-weight-normal;
                            color: Theme.subtext-0;
                        }
                    }

                    // Bare spacers take the free space around the centre group. A
                    // `FlexboxLayout` would not help, and a spacer with a bound width
                    // cannot take a share.
                    controls := HorizontalLayout {
                        height: 40px;
                        spacing: 2px;
                        cross-axis-alignment: center;

                        shuffle-button := PlayerButton {
                            icon: "shuffle";
                            on: MusicState.shuffle;
                            label: @tr("Shuffle");
                            clicked => { MusicState.toggle-shuffle(); }
                        }

                        repeat-button := PlayerButton {
                            icon: "repeat";
                            on: MusicState.repeat;
                            label: @tr("Repeat");
                            clicked => { MusicState.cycle-repeat(); }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        previous-button := PlayerButton {
                            icon: "play-skip-back";
                            label: @tr("Previous");
                            clicked => { MusicState.previous(); }
                        }

                        play-button := PlayerButton {
                            size: 40px;
                            primary: true;
                            icon: MusicState.is-playing ? "pause-circle-outline" : "play-circle-outline";
                            label: MusicState.is-playing ? @tr("Pause") : @tr("Play");
                            clicked => { MusicState.toggle-play(); }
                        }

                        next-button := PlayerButton {
                            icon: "play-skip-forward";
                            label: @tr("Next");
                            clicked => { MusicState.next(); }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        folder-button := PlayerButton {
                            icon: "folder";
                            label: @tr("Open music folder");
                            clicked => { MusicState.open-music-folder(); }
                        }

                        list-button := PlayerButton {
                            icon: "list";
                            on: MusicState.playlist-open;
                            label: @tr("Playlist");
                            clicked => { MusicState.toggle-playlist(); }
                        }
                    }
                }
            }
        }

        // Height is computed from the row height, not measured (see above). It
        // stays mounted while its phase is not "closed", so the leave can animate.
        if root.playlist-phase != "closed": playlist-cell := Rectangle {
            width: 340px;
            height: min(root.playlist-max-height, 16px + root.playlist-items-height);
            background: Colors.transparent;

            playlist-card := Rectangle {
                width: 100%;
                height: 100%;
                y: root.playlist-dy;
                opacity: root.playlist-alpha;
                border-radius: 8px;
                background: Theme.base;
                border-width: 1px;
                border-color: Theme.overlay-0.transparentize(0.5);
                drop-shadow-color: #0000004d;
                drop-shadow-blur: 24px;

                playlist-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                }

                VerticalLayout {
                    padding: 8px;

                    ScrollView {

                        playlist-items := VerticalLayout {
                            alignment: start;
                            padding-top: 4px;
                            padding-bottom: 8px;

                            for track[index] in MusicState.tracks: PlaylistItem {
                                name: track.name;
                                playing: index == MusicState.current-index;
                                clicked => { MusicState.play-index(index); }
                            }

                            if MusicState.tracks.length == 0: Text {
                                height: root.playlist-empty-height;
                                text: @tr("Nothing here");
                                font-size: 12px;
                                font-weight: Theme.font-weight-normal;
                                color: Theme.overlay-0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
