import { Theme } from "../theme.slint";
import { AppIcon } from "../components/display/app-icon.slint";
import { ScrollView } from "../components/containers/scroll-view.slint";
import { MusicState } from "../globals/music.slint";

// A player button (`.player-btn`): 34px square, 10px radius, transparent at
// rest, `surface2` on hover, `overlay0` pressed, and `mauve` when it is *on*
// (shuffle / repeat, the playlist toggle) or is the play button — which is why
// the transport's play and pause are purple and not text-coloured.
//
// `transition: all 120ms ease` moves the ink as well as the fill, so the colour
// is animated through a property of its own: the icon is a child, and its
// `icon-color` is a plain binding.
component PlayerButton inherits Rectangle {
    in property <string> icon;
    in property <length> size: 34px;
    in property <bool> on: false;
    in property <bool> primary: false;
    /// The tooltip text. Slint has no tooltip on an icon button, so this is the
    /// accessible label instead.
    in property <string> label: "";
    callback clicked;

    width: root.size;
    height: root.size;
    border-radius: 10px;
    background: touch.pressed
        ? Theme.overlay-0.transparentize(0.3)
        : touch.has-hover
        ? Theme.surface-2.transparentize(0.3)
        : Colors.transparent;
    animate background {
        duration: 120ms;
        easing: Easing.ease;
    }

    private property <color> ink: root.primary || root.on
        ? Theme.mauve
        : touch.has-hover ? Theme.text : Theme.subtext-0;
    animate ink {
        duration: 120ms;
        easing: Easing.ease;
    }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    AppIcon {
        icon-color: root.ink;
        name: root.icon;
        size: root.primary ? 24px : 18px;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component PlaylistItem inherits Rectangle {
    in property <string> name;
    in property <bool> playing: false;
    callback clicked;

    width: 100%;
    height: 26px;
    border-radius: 8px;
    background: touch.has-hover
        ? Theme.surface-1.transparentize(0.3)
        : Colors.transparent;
    animate background {
        duration: 120ms;
        easing: Easing.ease;
    }

    accessible-role: button;
    accessible-label: root.name;
    accessible-action-default => { root.clicked(); }

    // The 12px text height stays: it keeps the line tight against the embedded
    // font's taller natural line box, and the 26px row height is derived from it.
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        cross-axis-alignment: center;

        Text {
            height: 12px;
            text: root.name;
            font-size: 12px;
            font-weight: Theme.font-weight-normal;
            color: root.playing
                ? Theme.blue
                : touch.has-hover ? Theme.text : Theme.subtext-0;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The background-music panel.
//
// A scrim over everything below the title bar, the 340px player card in its
// top-right corner, and — when it is open — the playlist popup underneath it.
// Both cards use `base`, a 1px `overlay0` border at half opacity, a 14px radius
// and a 24px blur shadow; Slint has no shadow offset, only a blur.
//
// The card's own height, computed from its content:
//
//   padding 32 (16 + 16)
//   .track-info    16px line box + the 18px `margin-bottom` = 34
//   .progress-area 11px (the `.time` line box; the 4px bar centres in it)
//                   + the 8px `margin-bottom`
//   .controls      40px (the play button)
//   ─────────────────────────────
//                  125px
export component MusicPlayerOverlay inherits Rectangle {
    in property <bool> open: MusicState.panel-open;

    width: 100%;
    height: 100%;
    background: #000000.with-alpha(0.45 * root.scrim-alpha);

    // The scrim fades over 150ms and the card slides in from -8px over the same
    // 150ms. As in `Dialog`, the phase is plain state and the panel is shown
    // for one frame at the start values, because an animated property is only
    // advanced while something reads it.
    private property <string> phase: "closed";
    visible: root.phase != "closed";

    changed open => {
        if root.open {
            if root.phase == "closed" {
                root.phase = "starting";
                start-timer.restart();
            } else {
                // Reopened while it was leaving: play the enter from wherever the
                // leave had got to.
                root.phase = "shown";
            }
            // The whole subtree — the playlist included — is built and destroyed
            // with the overlay, so re-entering re-enters the playlist too. A
            // `playlist-open` that was still true is not forgotten: it lives in
            // `MusicState`, not in this subtree.
            if root.playlist-open {
                root.playlist-phase = "starting";
                playlist-start.restart();
            }
        } else if root.phase != "closed" && root.phase != "leaving" {
            // The playlist does *not* leave here: it is inside the overlay's own
            // subtree, so it fades out with it. It is dropped when the overlay's
            // leave is over (see `leave-timer`).
            root.phase = "leaving";
        }
    }

    start-timer := Timer {
        interval: 16ms;
        running: root.phase == "starting";
        triggered => { root.phase = "shown"; }
    }

    leave-timer := Timer {
        interval: 150ms;
        running: root.phase == "leaving";
        triggered => {
            root.phase = "closed";
            root.playlist-phase = "closed";
            // The overlay stays mounted between shows, so a drag that was still
            // in flight when the panel left would keep the music stopped, and the
            // flag that remembers it did the stopping, next time it opened. The
            // release that ends a drag normally arrives as a cancel; this is for
            // the drag that never got one.
            root.end-drag();
        }
    }

    init => {
        if root.open {
            root.phase = "shown";
        }
    }

    // The playlist's own transition: 120ms from opacity 0 and -4px, and it is a
    // *separate* transition from the overlay's. So it needs its own phase machine:
    // driving it off the overlay's phase would leave the playlist with nothing to
    // animate when the user toggles it while the overlay stays open — the case the
    // button is for. The same two rules as `Dialog` apply: "starting" is a
    // frame at the start values, because an animated property is only advanced
    // while something reads it, and "leaving" keeps the card on screen until the
    // timer drops it.
    private property <bool> playlist-open: MusicState.playlist-open;
    private property <string> playlist-phase: "closed";
    private property <float> playlist-alpha: root.playlist-phase == "shown" ? 1.0 : 0.0;
    private property <length> playlist-dy: root.playlist-phase == "shown" ? 0px : -4px;
    animate playlist-alpha {
        duration: 120ms;
        easing: Easing.ease;
    }
    animate playlist-dy {
        duration: 120ms;
        easing: Easing.ease;
    }

    changed playlist-open => {
        if root.playlist-open {
            if root.playlist-phase == "closed" {
                root.playlist-phase = "starting";
                playlist-start.restart();
            } else {
                // Reopened while it was leaving: play the enter from wherever the
                // leave had got to.
                root.playlist-phase = "shown";
            }
        } else if root.playlist-phase != "closed" && root.playlist-phase != "leaving" {
            root.playlist-phase = "leaving";
        }
    }

    playlist-start := Timer {
        interval: 16ms;
        running: root.playlist-phase == "starting";
        triggered => { root.playlist-phase = "shown"; }
    }

    playlist-leave := Timer {
        interval: 120ms;
        running: root.playlist-phase == "leaving";
        triggered => { root.playlist-phase = "closed"; }
    }

    private property <float> scrim-alpha: root.phase == "shown" ? 1.0 : 0.0;
    animate scrim-alpha {
        duration: 150ms;
        easing: Easing.ease;
    }
    private property <float> card-alpha: root.phase == "shown" ? 1.0 : 0.0;
    private property <length> card-dy: root.phase == "shown" ? 0px : -8px;
    animate card-alpha {
        duration: 150ms;
        easing: Easing.ease;
    }
    animate card-dy {
        duration: 150ms;
        easing: Easing.ease;
    }

    private property <bool> dragging: false;

    // Whether this drag is the one that stopped the music, so the release puts
    // it back. A drag that began while already paused leaves it paused: the
    // release restores what was there, which is what "the same whichever way it
    // was" means.
    private property <bool> drag-paused-playback: false;

    // Stops the music for the duration of a drag.
    //
    // A drag is a question about *where*, not about whether the music is running,
    // so it is answered with the transport stopped: what comes back afterwards is
    // the state that was there before, rather than a play/pause toggle that
    // would land wherever the last seek happened to leave it.
    function begin-drag() {
        root.dragging = true;
        if (MusicState.is-playing) {
            MusicState.pause();
            root.drag-paused-playback = true;
        }
    }

    // Ends it, and is safe to call when no drag is in flight.
    function end-drag() {
        root.dragging = false;
        if (root.drag-paused-playback) {
            root.drag-paused-playback = false;
            MusicState.resume();
        }
    }

    // Playlist geometry. A 12px line box with 7px of padding above and below is
    // a row; the empty message adds 12px around the same line box. The card is
    // sized from these rather than measured, because the list is built by a `for`
    // and a repeated element's height is measured at its own preferred width — so
    // a measurement would not be the height the layout uses (the same trap the
    // content grid's `filter_row_height` works around).
    private property <length> playlist-row-height: 26px;
    private property <length> playlist-empty-height: 36px;
    private property <length> playlist-items-height: 4px
        + (MusicState.tracks.length > 0
        ? playlist-row-height * MusicState.tracks.length
        : playlist-empty-height)
        + 8px;

    // The column has 16px of padding and a 12px gap, and its height is the
    // window's less the 44px title bar — 488px at the 532px minimum window
    // height. A 125px card plus a 320px playlist plus 16 + 12 + 16 does not quite
    // fit and would scroll by a pixel. Clamping the playlist to what is left
    // keeps the two cards inside the panel at any window size instead.
    private property <length> card-height: 125px;
    private property <length> overlay-padding: 16px;
    private property <length> card-gap: 12px;
    private property <length> playlist-max-height: min(
    320px,
    root.height - 2 * root.overlay-padding - root.card-height - root.card-gap,
    );

    // The scrim swallows the presses meant for the window below, and a press that
    // is not on a card closes the panel. The two cards stop it, which is why each
    // carries its own touch area and both are declared after this one.
    scrim-touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                MusicState.close-panel();
            }
        }
    }

    // The column is aligned to the end with 16px of padding, so both cards are
    // flush to the right inset by 16px and separated by the 12px gap.
    //
    // Each card is *wrapped* rather than placed here. A layout child cannot set
    // its own `y`, so the sliding element is not the layout's child: it is a plain
    // child of a cell the layout sizes, letting the layout keep the `y`, the gap
    // and the right-hand inset while the card keeps the animation.
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        cross-axis-alignment: end;

        card-cell := Rectangle {
            width: 340px;
            height: root.card-height;
            background: Colors.transparent;

            card := Rectangle {
                width: 100%;
                height: 100%;
                y: root.card-dy;
                opacity: root.card-alpha;
                border-radius: 8px;
                background: Theme.base;
                border-width: 1px;
                border-color: Theme.overlay-0.transparentize(0.5);
                drop-shadow-color: #0000004d;
                drop-shadow-blur: 24px;

                card-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                }

                // 16px of padding around the three rows. A layout gives the card
                // its height too, so the 125px falls out of the rows rather than
                // being written down — but the card itself cannot be the layout,
                // because it carries a background, a border and a shadow.
                card-body := VerticalLayout {
                    padding: 16px;

                    // `.track-info` is a flex row that centres its one child, and the
                    // child carries an 18px `margin-bottom` — so the text sits 9px above
                    // the middle of a box 18px taller than the line itself. That is the
                    // same as pinning the text to the top of a 34px block, which is what
                    // `alignment: start` on a 34px row says. (`stretch` would grow the
                    // 16px text to 34px and `center` would drop it 9px.)
                    track-info := VerticalLayout {
                        height: 34px;
                        alignment: start;

                        Text {
                            height: 16px;
                            text: MusicState.current-name != ""
                                ? MusicState.current-name
                                : @tr("No music");
                            font-size: 16px;
                            // The `bold` token is 700, so the literal 600 is used
                            // instead, as elsewhere in the app where the weight is 600.
                            font-weight: 600;
                            // Dimmed while the player is still waiting on audio: a
                            // native player streams from a file, and a starved
                            // buffer is worth saying out loud — but only through
                            // colour, so the card does not grow a row.
                            color: MusicState.buffering ? Theme.subtext-0 : Theme.text;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }

                    // The two clock labels and the bar are one row: 8px gaps, the
                    // labels fixed at their own width, everything centred in an
                    // 11px box, and the bar taking what is left.
                    //
                    // `cross-axis-alignment: center` is the load-bearing line: the
                    // clocks are 11px and the bar 4px, so centring puts the bar's
                    // centre line on the clocks'. `start` left the bar against the
                    // top of the row, three and a half pixels too high.
                    //
                    // The row is 19px because of the 8px below it, which sits
                    // *outside* the 11px content box. `padding-bottom` expresses
                    // the same thing inside the row, and it keeps the content box
                    // 11px so that centring lands on the 5.5px centre line rather
                    // than the 19px row's.
                    //
                    // `horizontal-stretch: 0` on the labels is not optional:
                    // stretch factors default to **1**, so without it both clocks
                    // grow along with the bar and the duration text walks left over
                    // the top of it.
                    progress-area := HorizontalLayout {
                        height: 19px;
                        padding-bottom: 8px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        current-time-text := Text {
                            horizontal-stretch: 0;
                            height: 11px;
                            text: MusicState.current-time-text;
                            font-size: 11px;
                            font-weight: Theme.font-weight-normal;
                            color: Theme.subtext-0;
                        }

                        progress-bar := Rectangle {
                            horizontal-stretch: 1;
                            height: 4px;
                            border-radius: 4px;
                            background: Theme.surface-2.transparentize(0.2);

                            // `x: 0` is load-bearing, not the default: the fill's
                            // width is a *fraction* of the bar's, and an unbound
                            // `x` centres an element rather than pinning it left,
                            // which would float a half-drawn bar in the middle of
                            // the track.
                            Rectangle {
                                x: 0px;
                                width: parent.width * MusicState.progress;
                                height: parent.height;
                                border-radius: 4px;
                                // Faded with the title while the player is
                                // waiting on audio, for the same reason: the
                                // bar is the one thing that visibly stops
                                // moving when the buffer is empty.
                                background: MusicState.buffering
                                    ? Theme.mauve.transparentize(0.45)
                                    : Theme.mauve;
                            }

                            // A drag keeps following the pointer once it has left
                            // the bar. Slint cannot listen outside the element, so
                            // the drag is tracked here instead — a press inside the
                            // bar still seeks, which is what a click does.
                            touch := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                // The ratio is clamped to 0..1, and the division is
                                // written in pixels because Slint cannot divide one
                                // length by another.
                                //
                                // `self.mouse-x` is already relative to *this*
                                // element, and this element covers the bar, so its
                                // origin is the bar's left edge. Subtracting
                                // `parent.x` — the bar's own offset within the row —
                                // as well would shift every seek by a constant
                                // fraction of the bar, leaving the fill a fixed
                                // distance to the pointer's left.
                                private property <float> ratio: clamp(
                                self.mouse-x / 1px / (parent.width / 1px),
                                0,
                                1,
                                );
                                // The bar is seekable only once there is a duration
                                // to seek within.
                                function seek() {
                                    if MusicState.duration > 0 {
                                        MusicState.seek-ratio(self.ratio);
                                    }
                                }
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.down
                                        && event.button == PointerEventButton.left {
                                        root.begin-drag();
                                        self.seek();
                                    } else if event.kind == PointerEventKind.up
                                        || event.kind == PointerEventKind.cancel {
                                        root.end-drag();
                                    } else if event.kind == PointerEventKind.move && root.dragging {
                                        self.seek();
                                    }
                                }
                            }
                        }

                        // The third child of the row, not the last child of the
                        // bar: it is a sibling of the bar, which is the whole
                        // reason it belongs here rather than inside `progress-bar`,
                        // where it would centre itself on the track and print over
                        // it.
                        duration-text := Text {
                            horizontal-stretch: 0;
                            height: 11px;
                            text: MusicState.duration-text;
                            font-size: 11px;
                            font-weight: Theme.font-weight-normal;
                            color: Theme.subtext-0;
                        }
                    }

                    // `.controls` is a flex row of three `flex: 1` groups — left, centre,
                    // right — each `gap: 2px`, and the play button is 40px. The centre
                    // group's buttons are 34+2+40+2+34 = 112px in a third of the 308px
                    // content width, so it overflows its cell symmetrically and the play
                    // button lands in the middle of the card either way.
                    //
                    // Which is what the two bare spacers are: the left group takes the
                    // free space, then the centre group's three buttons, then the rest.
                    // The row is one `spacing: 2px` because every group has that gap.
                    //
                    // A `FlexboxLayout` is the wrong tool — `justify-content` belongs to
                    // the container, not to a group, so three `flex: 1` cells with their
                    // own alignment would still need the cells. And the spacers must be
                    // bare `Rectangle`s: an element with a bound `width` gets
                    // `min == max == width` and cannot take a share, and a nested layout
                    // of fixed-size buttons has `max == preferred` and would not grow
                    // either.
                    controls := HorizontalLayout {
                        height: 40px;
                        spacing: 2px;
                        cross-axis-alignment: center;

                        shuffle-button := PlayerButton {
                            icon: "shuffle";
                            on: MusicState.shuffle;
                            label: @tr("Shuffle");
                            clicked => { MusicState.toggle-shuffle(); }
                        }

                        repeat-button := PlayerButton {
                            icon: "repeat";
                            on: MusicState.repeat;
                            label: @tr("Repeat");
                            clicked => { MusicState.cycle-repeat(); }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        previous-button := PlayerButton {
                            icon: "play-skip-back";
                            label: @tr("Previous");
                            clicked => { MusicState.previous(); }
                        }

                        play-button := PlayerButton {
                            size: 40px;
                            primary: true;
                            icon: MusicState.is-playing ? "pause-circle-outline" : "play-circle-outline";
                            label: MusicState.is-playing ? @tr("Pause") : @tr("Play");
                            clicked => { MusicState.toggle-play(); }
                        }

                        next-button := PlayerButton {
                            icon: "play-skip-forward";
                            label: @tr("Next");
                            clicked => { MusicState.next(); }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        folder-button := PlayerButton {
                            icon: "folder";
                            label: @tr("Open music folder");
                            clicked => { MusicState.open-music-folder(); }
                        }

                        list-button := PlayerButton {
                            icon: "list";
                            on: MusicState.playlist-open;
                            label: @tr("Playlist");
                            clicked => { MusicState.toggle-playlist(); }
                        }
                    }
                }
            }
        }

        // `.playlist-card` is 340px wide, at most 320px tall, and holds the app's
        // own `ScrollView` in its 8px padding. The card's own fade and slide are
        // `playlist-alpha` / `playlist-dy` above.
        //
        // The height is computed from the row height rather than measured: the
        // list is built by a `for`, and a repeated element's height is measured
        // at its own preferred width, so a measurement would not be the height
        // the layout uses (the same trap the content grid's `filter_row_height`
        // works around).
        //
        // It stays mounted for as long as its *phase* is not "closed" rather than
        // while `playlist-open` is true, so the leave has something to animate.
        if root.playlist-phase != "closed": playlist-cell := Rectangle {
            width: 340px;
            height: min(root.playlist-max-height, 16px + root.playlist-items-height);
            background: Colors.transparent;

            playlist-card := Rectangle {
                width: 100%;
                height: 100%;
                y: root.playlist-dy;
                opacity: root.playlist-alpha;
                border-radius: 8px;
                background: Theme.base;
                border-width: 1px;
                border-color: Theme.overlay-0.transparentize(0.5);
                drop-shadow-color: #0000004d;
                drop-shadow-blur: 24px;

                playlist-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                }

                // 8px of padding for the scroll view.
                VerticalLayout {
                    padding: 8px;

                    ScrollView {

                        playlist-items := VerticalLayout {
                            alignment: start;
                            padding-top: 4px;
                            padding-bottom: 8px;

                            for track[index] in MusicState.tracks: PlaylistItem {
                                name: track.name;
                                playing: index == MusicState.current-index;
                                clicked => { MusicState.play-index(index); }
                            }

                            if MusicState.tracks.length == 0: Text {
                                height: root.playlist-empty-height;
                                text: @tr("Nothing here");
                                font-size: 12px;
                                font-weight: Theme.font-weight-normal;
                                color: Theme.overlay-0;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
