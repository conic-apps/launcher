import { Dialog } from "dialog.slint";
import { ConfirmWarningBody } from "confirm-warning.slint";
import { Dialogs } from "../../globals/dialogs.slint";

// The close-button prompt raised while on the launch page, where closing would
// abandon an install, launch or download. The height comes from the body's
// measuring layout.
//
// The Chinese source text is kept inside `@tr`, so an untranslated locale still
// reads it.
export component ConfirmQuitApp inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    /// The app root owns the exit animation and the window close.
    callback confirm();

    dialog := Dialog {
        dialog-visible: Dialogs.confirm-quit-app-visible;
        dialog-width: 500px;
        // `Dialog` keeps 32px of its own (16px each side).
        dialog-height: body.preferred-height + 32px;

        // Sized against the slot, not `parent` (the whole window).
        body := ConfirmWarningBody {
            content-width: dialog.content-width;
            title-text: @tr("ConfirmQuitApp" => "正在进行的任务将被中止，你确定要退出吗？");
            detail-text: @tr("ConfirmQuitApp" => "最后的反悔机会");
            cancel-text: @tr("ConfirmQuitApp" => "稍等一下...");
            confirm-text: @tr("ConfirmQuitApp" => "让我出去！");
            // Only the flag goes down; the launch keeps running.
            cancel => { Dialogs.confirm-quit-app-visible = false; }
            confirm => { root.confirm(); }
        }
    }
}
