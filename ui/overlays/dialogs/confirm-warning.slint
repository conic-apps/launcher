import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { Button } from "../../components/controls/button.slint";

// The body shared by the warning dialogs: icon, two-line message and a blue/red
// button pair. Strings are passed in so each dialog catalogues its own.
//
// Both callbacks must be handled by the mounting dialog: Slint accepts an
// unhandled callback silently, leaving a dead button.
export component ConfirmWarningBody inherits VerticalLayout {
    in property <length> content-width: 0px;
    in property <string> title-text: "";
    in property <string> detail-text: "";
    in property <string> cancel-text: "";
    in property <string> confirm-text: "";
    /// The confirm button's enabled state, cleared while the delete runs.
    in property <bool> confirm-enabled: true;

    callback cancel();
    callback confirm();

    width: root.content-width;
    spacing: 16px;
    padding: 8px;
    alignment: start;

    // The 50px icon sets the row height; the message centres in it.
    HorizontalLayout {
        height: 50px;
        spacing: 16px;
        cross-axis-alignment: center;

        AppIcon {
            name: "warning";
            size: 50px;
        }

        VerticalLayout {
            alignment: center;
            spacing: 8px;

            Text {
                text: root.title-text;
                font-size: 17px;
                color: Theme.default-text-color.transparentize(0.1);
                wrap: word-wrap;
            }

            Text {
                text: root.detail-text;
                font-size: 12px;
                color: Theme.default-text-color.transparentize(0.1);
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        width: 100%;
        cross-axis-alignment: center;

        Button {
            horizontal-stretch: 1;
            text: root.cancel-text;
            text-color: Theme.text-inverse;
            button-radius: 4px;
            button-background: Theme.blue;
            clicked => { root.cancel(); }
        }

        // The 8px gap between the equally stretched buttons.
        Rectangle {
            width: 8px;
            background: transparent;
        }

        Button {
            horizontal-stretch: 1;
            text: root.confirm-text;
            text-color: Theme.text-inverse;
            button-radius: 4px;
            button-background: Theme.red;
            button-enabled: root.confirm-enabled;
            clicked => { root.confirm(); }
        }
    }
}
