import { Theme } from "../../graphics/theme.slint";
import { Dialog } from "../shell/dialog.slint";
import { Button } from "../../graphics/controls/button.slint";
import { AppIcon } from "../../graphics/display/app-icon.slint";
import { Input } from "../../graphics/controls/input.slint";
import { Loading } from "../../graphics/controls/loading.slint";
import { ScrollView } from "../../graphics/containers/scroll-view.slint";
import { InstanceImportState } from "../../globals/dialogs.slint";

// The confirmation before an import. It opens as soon as the source is read, so
// the instance name can be set while the file list resolves. Files that cannot
// be resolved are listed, and confirming then means "install/import anyway".
export component InstanceImportDialog inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    Dialog {
        dialog-visible: InstanceImportState.visible;
        dialog-width: 520px;
        dialog-height: InstanceImportState.failed
            ? 400px
            : (InstanceImportState.files.length > 0 ? 500px : 340px);

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 8px;
            spacing: 12px;

            HorizontalLayout {
                height: 50px;
                spacing: 16px;
                cross-axis-alignment: center;

                AppIcon {
                    name: "package";
                    size: 50px;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 4px;

                    Text {
                        text: InstanceImportState.importing-instance
                            ? InstanceImportState.import-title
                            : InstanceImportState.install-title;
                        font-size: 17px;
                        color: Theme.default-text-color.transparentize(0.1);
                        wrap: word-wrap;
                    }

                    Text {
                        text: InstanceImportState.source-name;
                        font-size: 13px;
                        color: Theme.default-text-color.transparentize(0.35);
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                spacing: 16px;
                alignment: start;

                Text {
                    text: "Minecraft " + InstanceImportState.minecraft-version;
                    font-size: 13px;
                    color: Theme.default-text-color.transparentize(0.25);
                    vertical-alignment: center;
                }

                if InstanceImportState.has-loader: Text {
                    text: InstanceImportState.loader-type + " " + InstanceImportState.loader-version;
                    font-size: 13px;
                    color: Theme.default-text-color.transparentize(0.25);
                    vertical-alignment: center;
                }
            }

            Text {
                text: InstanceImportState.instance-name-label;
                font-size: 12px;
                color: Theme.default-text-color.transparentize(0.35);
            }

            Input {
                input-width: 0px;
                horizontal-stretch: 1;
                value <=> InstanceImportState.instance-name;
            }

            if InstanceImportState.checking: HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;

                Loading {
                    size: 16px;
                }

                Text {
                    text: InstanceImportState.checking-text;
                    font-size: 12px;
                    color: Theme.default-text-color.transparentize(0.35);
                    vertical-alignment: center;
                }
            }

            if !InstanceImportState.checking && InstanceImportState.failed: VerticalLayout {
                vertical-stretch: 1;
                spacing: 6px;

                Text {
                    text: InstanceImportState.error-title;
                    font-size: 13px;
                    color: Theme.default-text-color.transparentize(0.1);
                    wrap: word-wrap;
                }

                Text {
                    text: InstanceImportState.error-detail;
                    font-size: 12px;
                    color: Theme.default-text-color.transparentize(0.35);
                    wrap: word-wrap;
                }

                // The API's own message, bounded; the text above says what to do.
                Text {
                    text: InstanceImportState.error-message;
                    font-size: 11px;
                    color: Theme.default-text-color.transparentize(0.5);
                    wrap: word-wrap;
                    max-lines: 4;
                    overflow: elide;
                }
            }

            if !InstanceImportState.checking && !InstanceImportState.failed && InstanceImportState.files.length > 0: VerticalLayout {
                vertical-stretch: 1;
                spacing: 6px;

                Text {
                    text: InstanceImportState.warning-title;
                    font-size: 13px;
                    color: Theme.default-text-color.transparentize(0.1);
                    wrap: word-wrap;
                }

                Text {
                    text: InstanceImportState.warning-detail;
                    font-size: 12px;
                    color: Theme.default-text-color.transparentize(0.35);
                    wrap: word-wrap;
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface-0;
                    border-radius: 6px;

                    ScrollView {
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            alignment: start;

                            for file in InstanceImportState.files: Text {
                                text: file;
                                font-size: 12px;
                                color: Theme.default-text-color.transparentize(0.1);
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // Keeps the buttons at the bottom when there is no list to stretch.
            if !InstanceImportState.failed && InstanceImportState.files.length == 0: Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                width: 100%;
                cross-axis-alignment: center;

                Button {
                    horizontal-stretch: 1;
                    text: InstanceImportState.cancel-text;
                    text-color: Theme.text-inverse;
                    button-radius: 4px;
                    button-background: Theme.blue;
                    clicked => {
                        InstanceImportState.cancel();
                    }
                }

                // The 8px gap between the equally stretched buttons.
                Rectangle {
                    width: 8px;
                    background: transparent;
                }

                if InstanceImportState.failed: Button {
                    horizontal-stretch: 1;
                    text: InstanceImportState.retry-text;
                    text-color: Theme.text-inverse;
                    button-radius: 4px;
                    button-background: Theme.red;
                    clicked => {
                        InstanceImportState.retry();
                    }
                }

                if !InstanceImportState.failed: Button {
                    horizontal-stretch: 1;
                    text: InstanceImportState.importing-instance
                        ? (InstanceImportState.files.length > 0
                        ? InstanceImportState.import-anyway-text
                        : InstanceImportState.import-text)
                        : (InstanceImportState.files.length > 0
                        ? InstanceImportState.install-anyway-text
                        : InstanceImportState.install-text);
                    text-color: Theme.text-inverse;
                    button-radius: 4px;
                    button-background: Theme.red;
                    button-enabled: !InstanceImportState.checking;
                    clicked => {
                        InstanceImportState.confirm();
                    }
                }
            }
        }
    }
}
