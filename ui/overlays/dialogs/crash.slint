import { Theme } from "../../theme.slint";
import { Dialog } from "dialog.slint";
import { Button } from "../../components/controls/button.slint";
import { ScrollView } from "../../components/containers/scroll-view.slint";
import { CrashState, CrashText } from "../../globals/crash.slint";

// The game's crash prompt.
//
// It is a dialog rather than a page so a crash that happens long after the
// launch flow, or while the user is on another screen, does not replace the
// window. The reason is the analyzer's rule family, not the rule's name or the
// raw crash text: those are what the report is for. The list has a fixed height
// so a crash that matched several rules cannot push the buttons out of the
// dialog.
//
// The note under the reason matters: a screenshot of this dialog loses the
// report's stack trace and the matched rules, so it is not what a helper needs.
export component CrashDialog inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    Dialog {
        dialog-visible: CrashState.visible;
        dialog-width: 460px;
        dialog-height: 300px;

        VerticalLayout {
            width: 100%;
            height: 100%;
            padding: 8px;
            spacing: 10px;

            Text {
                height: 26px;
                text: @tr("CrashView" => "Game crashed");
                font-size: 20px;
                color: Theme.red;
                vertical-alignment: center;
            }

            Text {
                text: CrashState.instance-name;
                font-size: 13px;
                color: Theme.default-text-color.transparentize(0.35);
                wrap: word-wrap;
            }

            ScrollView {
                height: 100px;

                VerticalLayout {
                    spacing: 6px;

                    if CrashState.reason-categories.length == 0: Text {
                        text: CrashText.reason("unknown");
                        font-size: 13px;
                        color: Theme.default-text-color.transparentize(0.1);
                        wrap: word-wrap;
                    }

                    for kind in CrashState.reason-categories: Text {
                        text: CrashText.reason(kind);
                        font-size: 13px;
                        color: Theme.default-text-color.transparentize(0.1);
                        wrap: word-wrap;
                    }

                    if CrashState.keywords != "": Text {
                        text: @tr("CrashView" => "Possible mods:") + " " + CrashState.keywords;
                        font-size: 12px;
                        color: Theme.peach;
                        wrap: word-wrap;
                        max-lines: 2;
                        overflow: elide;
                    }
                }
            }

            Text {
                text: @tr(
                    "CrashView" => "If you need help from others, send them the error report instead of just a screenshot of this window."
                );
                font-size: 13px;
                color: Theme.default-text-color.transparentize(0.25);
                wrap: word-wrap;
            }

            // Keeps the buttons at the bottom when the reason list is short.
            Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                width: 100%;
                spacing: 8px;

                Button {
                    button-width: 202px;
                    text: @tr("CrashView" => "Open error report");
                    text-color: Theme.text-inverse;
                    button-radius: 4px;
                    button-background: Theme.blue;
                    clicked => {
                        CrashState.open-report();
                    }
                }

                Button {
                    button-width: 202px;
                    text: @tr("CrashView" => "Close window");
                    text-color: Theme.text-inverse;
                    button-radius: 4px;
                    button-background: Theme.red;
                    clicked => {
                        CrashState.close();
                    }
                }
            }
        }
    }
}
