import { Dialog } from "dialog.slint";
import { ConfirmWarningBody } from "confirm-warning.slint";
import { DeleteSaveState, Dialogs } from "../../globals/dialogs.slint";

// Confirms deleting a save. The height comes from the body's measuring layout,
// since `Dialog` has no `fit-content`.
//
// The Chinese source text is kept inside `@tr`, so an untranslated locale still
// reads it.
export component ConfirmDeleteSave inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // A save with no name in `level.dat` uses its folder.
    private property <string> save-name: DeleteSaveState.level-name != ""
        ? DeleteSaveState.level-name
        : DeleteSaveState.folder;

    dialog := Dialog {
        dialog-visible: Dialogs.confirm-delete-save-visible;
        dialog-width: 500px;
        // `Dialog` keeps 32px of its own (16px each side).
        dialog-height: body.preferred-height + 32px;

        // Sized against the slot, not `parent` (the whole window).
        body := ConfirmWarningBody {
            content-width: dialog.content-width;
            // `「`/`」` are CJK quotation marks, not braces.
            title-text: @tr("ConfirmDeleteSave" => "是否确认删除存档「{}」？", root.save-name);
            detail-text: @tr("ConfirmDeleteSave" => "存档文件夹将永久删除，这是最后的反悔机会");
            cancel-text: @tr("ConfirmDeleteSave" => "稍等一下...");
            confirm-text: @tr("ConfirmDeleteSave" => "确认删除");
            confirm-enabled: !DeleteSaveState.deleting;
            cancel => { DeleteSaveState.cancel(); }
            confirm => { DeleteSaveState.confirm(); }
        }
    }
}
