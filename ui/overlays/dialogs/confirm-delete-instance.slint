import { Theme } from "../../theme.slint";
import { Dialog } from "dialog.slint";
import { Button } from "../../components/controls/button.slint";
import { InstanceCard } from "../../components/display/instance-card.slint";
import { Dialogs, DeleteInstanceState } from "../../globals/dialogs.slint";
import { GameTime } from "../../globals/game.slint";

// The dialog the instance settings overlay's "Delete instance" row opens.
//
// `Dialog` has no `fit-content` height mode, so the height comes from the
// measuring layout the body is written in — the arrangement the add-account and
// multiplayer dialogs use.
//
// The warning, its "游戏时间：" label and its two button labels are hard-coded
// Chinese. The Chinese is kept as the source text of a `@tr`, so a locale without
// an entry still reads these strings while the catalogues can translate them —
// the treatment the four launch error dialogs already have.

component ConfirmDeleteBody inherits VerticalLayout {
    in property <length> content-width: 0px;

    width: root.content-width;
    spacing: 16px;
    padding: 12px;
    alignment: start;

    Text {
        text: DeleteInstanceState.warning;
        font-size: 16px;
        font-weight: Theme.font-weight-normal;
        color: Theme.default-text-color.transparentize(0.1);
        wrap: word-wrap;
        // A `line-height: 1.3` is deliberately not reproduced: Slint 1.18 has no
        // CSS `line-height` — `line-height-factor` multiplies the font's *natural*
        // line height rather than the font size, and the two are not in a fixed
        // ratio (Comfortaa's is 1.115em, the CJK fallback this sentence actually
        // draws with is nearer 1.4em), so one factor cannot hold both. The
        // paragraph keeps its natural leading, like every other text in the app;
        // see `README.md`.
    }

    InstanceCard {
        width: 100%;
        height: 60px;
        vertical-stretch: 0;
        name: DeleteInstanceState.name;
        loader: DeleteInstanceState.loader;
        minecraft-version: DeleteInstanceState.minecraft-version;
        // The delete dialog's copy of the card always shows the version.
        version-always: true;
        has-background: DeleteInstanceState.has-background;
        card-background: DeleteInstanceState.background;
        playtime: GameTime.play-time(DeleteInstanceState.playtime-kind, DeleteInstanceState.playtime-value);
        playtime-label: DeleteInstanceState.playtime-label;
    }

    HorizontalLayout {
        width: 100%;
        cross-axis-alignment: center;

        Button {
            horizontal-stretch: 1;
            text: @tr("ConfirmDeleteInstance" => "取消");
            text-color: Theme.text-inverse;
            button-radius: 4px;
            button-background: Theme.blue;
            clicked => { DeleteInstanceState.cancel(); }
        }

        // The 8px between the two buttons: both stretch equally, which leaves the
        // gap between them.
        Rectangle {
            width: 8px;
            background: transparent;
        }

        Button {
            horizontal-stretch: 1;
            text: @tr("ConfirmDeleteInstance" => "确认删除");
            text-color: Theme.text-inverse;
            button-radius: 4px;
            button-background: Theme.red;
            button-enabled: !DeleteInstanceState.deleting;
            clicked => { DeleteInstanceState.confirm(); }
        }
    }
}

export component ConfirmDeleteInstance inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    dialog := Dialog {
        dialog-visible: Dialogs.confirm-delete-instance-visible;
        dialog-width: 500px;
        // `fit-content`: `Dialog` keeps 32px of its own — 16px on each side
        // (a 1px clip and 15px of padding).
        dialog-height: body.preferred-height + 32px;

        // Sized against the slot's width, not `parent` — the elements written in
        // a component's braces have the element they are written *in* as their
        // parent, which here is the whole window.
        body := ConfirmDeleteBody {
            content-width: dialog.content-width;
        }
    }
}
