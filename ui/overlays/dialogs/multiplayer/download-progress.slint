import { Theme } from "../../../theme.slint";
import { AppIcon } from "../../../components/display/app-icon.slint";
import { Button } from "../../../components/controls/button.slint";
import { Progress } from "../../../components/controls/progress.slint";
import { MultiplayerState } from "../../../globals/multiplayer.slint";

// The Conic Nexus library download screen.
export component MultiplayerDownloadProgress inherits VerticalLayout {
    width: 100%;
    spacing: 0px;
    alignment: start;

    init => { MultiplayerState.start-download(); }

    // `display: flex; align-items: center` — the icon is the taller of the two,
    // so the row is 50px and the message column is centred against it.
    HorizontalLayout {
        height: 50px;
        spacing: 16px;
        cross-axis-alignment: center;

        AppIcon {
            name: "download";
            size: 50px;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;

            HorizontalLayout {
                alignment: space-between;
                cross-axis-alignment: end;

                Text {
                    horizontal-stretch: 1;
                    text: MultiplayerState.download-phase-text;
                    font-size: 16px;
                    line-height-factor: 1;
                    // The headline wraps rather than pushing the counter out of
                    // the panel.
                    wrap: word-wrap;
                    color: Theme.default-text-color.transparentize(0.1);
                }

                if MultiplayerState.show-download-bytes: Text {
                    text: MultiplayerState.download-value-text + " / " + MultiplayerState.download-max-text;
                    font-size: 14px;
                    line-height-factor: 1;
                    color: Theme.default-text-color.transparentize(0.1);
                }
            }

            Rectangle {
                height: 16px;
                background: transparent;
            }

            Progress {
                loading: MultiplayerState.download-loading;
                value: MultiplayerState.download-value;
                max: MultiplayerState.download-max;
            }
        }
    }

    // The 16px above the button is padding below, and the row is the button
    // itself; the 12px gap is dead for a single child.
    actions := HorizontalLayout {
        padding-top: 16px;
        spacing: 12px;

        Button {
            horizontal-stretch: 1;
            text: @tr("Multiplayer" => "Stop download");
            text-color: Theme.red;
            button-border-color: Theme.red.with-alpha(0.6);
            hover-background: Theme.red;
            hover-text-color: Theme.text-inverse;
            clicked => { MultiplayerState.cancel-download(); }
        }
    }
}
