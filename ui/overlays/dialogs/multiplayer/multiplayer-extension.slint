import { Dialog } from "../dialog.slint";
import {
    SlideTransition,
} from "../../../components/containers/slide-transition.slint";
import { MultiplayerState } from "../../../globals/multiplayer.slint";
import { MultiplayerDownloadDescription } from "download-description.slint";
import { MultiplayerDownloadProgress } from "download-progress.slint";
import { MultiplayerManager } from "multiplayer-manager.slint";

// The dialog body: the mounted component, swapped with a left slide-out/in using
// the create-instance state machine.
component MultiplayerConnect inherits VerticalLayout {
    /// The panel minus its 16px padding.
    in property <length> content-width: 0px;

    width: root.content-width;
    padding: 8px;
    spacing: 0px;
    alignment: start;

    private property <string> component: MultiplayerState.component;
    private property <string> shown: "";
    private property <bool> leaving: false;
    private property <string> arrive-phase: "shown";
    private property <bool> leave-armed: false;
    private property <bool> enter-armed: false;

    init => { root.shown = root.component; }

    changed component => {
        if root.component == "" {
            root.shown = "";
            root.leaving = false;
            root.leave-armed = false;
            root.enter-armed = false;
            root.arrive-phase = "shown";
        } else if root.shown == "" {
            root.shown = root.component;
        } else if root.component == root.shown {
            root.leaving = false;
            root.leave-armed = false;
        } else {
            root.leaving = true;
            root.leave-armed = true;
            leave-timer.restart();
        }
    }

    leave-timer := Timer {
        interval: 80ms;
        running: root.leave-armed;
        triggered => {
            root.leave-armed = false;
            root.leaving = false;
            if root.component != root.shown {
                root.shown = root.component;
                root.arrive-phase = "enter";
                root.enter-armed = true;
            }
        }
    }

    enter-timer := Timer {
        interval: 16ms;
        running: root.enter-armed;
        triggered => {
            root.enter-armed = false;
            root.arrive-phase = "shown";
        }
    }

    if root.shown == "downloadDescription": SlideTransition {
        phase: root.leaving ? "leave" : root.arrive-phase;
        direction: "left";
        MultiplayerDownloadDescription { }
    }
    if root.shown == "downloadProgress": SlideTransition {
        phase: root.leaving ? "leave" : root.arrive-phase;
        direction: "left";
        MultiplayerDownloadProgress { }
    }
    if root.shown == "multiplayerManager": SlideTransition {
        phase: root.leaving ? "leave" : root.arrive-phase;
        direction: "left";
        MultiplayerManager { }
    }
}

// The multiplayer floating dialog. `Dialog` eases height changes between the
// mounted components; the width switches instantly. The height comes from the
// body's measuring layout, like the add-account dialog.
export component MultiplayerExtension inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    private property <length> dialog-width: MultiplayerState.component == "multiplayerManager"
        ? 600px
        : MultiplayerState.component == "downloadProgress" ? 480px : 580px;

    dialog := Dialog {
        dialog-visible: MultiplayerState.visible;
        dialog-width: root.dialog-width;
        dialog-height: body.preferred-height + 32px;

        body := MultiplayerConnect {
            content-width: dialog.content-width;
        }
    }
}
