import { Theme } from "../../../theme.slint";
import {
    ZoomTransition,
} from "../../../components/containers/zoom-transition.slint";
import { ListItem } from "../../../components/controls/list-item.slint";
import { Select } from "../../../components/controls/select.slint";
import { Button } from "../../../components/controls/button.slint";
import { ScrollView } from "../../../components/containers/scroll-view.slint";
import { Loading } from "../../../components/controls/loading.slint";
import { Dialogs, CreateInstanceState } from "../../../globals/dialogs.slint";
import { GameTime } from "../../../globals/game.slint";

// The Minecraft version chooser: a category filter, a virtualized version list
// and a Cancel button. The list takes the height the filter and button leave.
export component MinecraftChoose inherits ZoomTransition {
    /// The dialog's inner area minus its title: what this screen has to fill.
    in property <length> screen-height: 0px;

    height: root.screen-height;
    padding: 8px;
    spacing: 8px;

    /// Release, snapshot or older-version icon.
    pure function version-icon(kind: string) -> image {
        if kind == "release" {
            return @image-url("../../../assets/images/minecraft.webp");
        }
        if kind == "snapshot" {
            return @image-url("../../../assets/images/command-block.webp");
        }
        return @image-url("../../../assets/images/ancient-debris.webp");
    }

    filter := Rectangle {
        width: 100%;
        height: 40px;
        border-radius: 8px;
        background: Theme.surface-0;

        // The label takes the free space; a fixed select width left an empty
        // strip to its right.
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            cross-axis-alignment: center;

            Text {
                text: @tr("Version category");
                font-size: 13px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
                horizontal-stretch: 1;
                vertical-alignment: center;
            }

            Select {
                options: ["releases", "snapshot", "old"];
                display-name: [@tr("Releases"), @tr("Snapshots"), @tr("Old versions")];
                value <=> CreateInstanceState.version-category;
                // Rust re-filters the list behind it.
                selected(value) => { CreateInstanceState.set-version-category(value); }
            }
        }
    }

    // Matches `ListItem`'s height, so the visible range needs no measuring.
    private property <length> row-height: 54px;
    // The visible slice plus two rows of slack. Building every row (600+ snapshots)
    // makes the renderer give up past roughly 150 rows in a frame.
    private property <length> window-top: max(
        0px,
        -versions-scroll.content-y - 2 * root.row-height);
    private property <length> window-bottom: -versions-scroll.content-y + versions-scroll.height
        + 2 * root.row-height;

    list := Rectangle {
        width: 100%;
        vertical-stretch: 1;
        border-width: 1px;
        border-color: #00000029;
        border-radius: 8px;
        clip: true;
        background: transparent;

        versions-scroll := ScrollView {
            // A row's `visible` cannot drop it from the scroll content, or the
            // list would collapse; hence the full-height box.
            list-content := Rectangle {
                width: 100%;
                height: root.row-height * CreateInstanceState.minecraft-versions.length;

                for version[index] in CreateInstanceState.minecraft-versions: ListItem {
                    visible: root.row-height * index < root.window-bottom
                        && root.row-height * (index + 1) > root.window-top;
                    y: root.row-height * index;
                    title: "Minecraft " + version.id;
                    description: GameTime.year-month-day(version.month, version.day, version.year);
                    icon: root.version-icon(version.kind);
                    icon-opacity: version.kind == "release" ? 0.8 : 1.0;
                    clickable: true;
                    buttons: ["about"];

                    clicked => {
                        CreateInstanceState.select-minecraft-version(version.id);
                        CreateInstanceState.step = "settings";
                    }
                    // Every version has a wiki page, localized per language.
                    button-clicked(name) => { CreateInstanceState.open-version-wiki(version.id); }
                }
            }
        }

        if CreateInstanceState.minecraft-loading: Rectangle {
            width: 100%;
            height: 100%;
            background: #0000004b;

            Loading {
                size: 32px;
            }
        }
    }

    Button {
        width: 100%;
        text: @tr("Cancel");
        clicked => { Dialogs.create-instance-visible = false; }
    }
}
