import { Theme } from "../../../theme.slint";
import { Dialog } from "../dialog.slint";
import { Button } from "../../../components/controls/button.slint";
import { Select } from "../../../components/controls/select.slint";
import { Switch } from "../../../components/controls/switch.slint";
import { SettingGroup } from "../../../components/settings/setting-group.slint";
import { SettingItem } from "../../../components/settings/setting-item.slint";
import { AppIcon } from "../../../components/display/app-icon.slint";
import {
    ZoomTransition,
} from "../../../components/containers/zoom-transition.slint";
import { FocusManager } from "../../../globals/focus.slint";
import { Dropdown } from "../../../globals/dropdown.slint";
import { Dialogs, CreateInstanceState } from "../../../globals/dialogs.slint";
import { MinecraftChoose } from "minecraft-choose.slint";
import { ModLoaderChoose } from "mod-loader-choose.slint";

// The dialog's "settings" step. Its own component so the step swap mounts it
// fresh and the zoom starts from the right place.
component SettingsStep inherits ZoomTransition {
    spacing: 0px;
    padding-left: 8px;
    padding-right: 8px;

    pure function tag-color(loader: string) -> color {
        if loader == "quilt" { return Theme.mauve; }
        if loader == "fabric" { return Theme.yellow; }
        if loader == "forge" { return Theme.blue; }
        if loader == "neoforge" { return Theme.peach; }
        return Theme.green;
    }

    Rectangle {
        width: 100%;
        height: 4px;
        background: transparent;
    }

    card := Rectangle {
        width: 100%;
        height: 60px;
        border-radius: 8px;
        clip: true;
        background: Theme.surface-0.with-alpha(0.4);

        Rectangle {
            border-width: 1px;
            border-color: Theme.surface-1.with-alpha(0.8);
            background: transparent;
        }

        // A 16px lavender bar over the hairline, since Slint borders cover all
        // four edges.
        Rectangle {
            x: 0;
            y: 0;
            width: 16px;
            height: parent.height;
            background: Theme.lavender.with-alpha(0.8);
        }

        // Slint has no masks, so the card colour is laid over the image and fades
        // right. A failed load reports zero width, which is the same test; Rust
        // loads the file because Slint cannot read a runtime path.
        if CreateInstanceState.background-path != ""
            && CreateInstanceState.background-image.width > 0: Rectangle {
            x: 116px;
            y: 1px;
            width: parent.width - 116px - 1px;
            height: parent.height - 2px;
            background: transparent;

            Image {
                width: 100%;
                height: 100%;
                source: CreateInstanceState.background-image;
                image-fit: cover;
            }

            Rectangle {
                background: @linear-gradient(90deg, Theme.dialog-background.mix(Theme.surface-0, 0.4) 0%, transparent 100%);
            }
        }

        if !CreateInstanceState.name-editing: name-row := Rectangle {
            x: 32px;
            y: 9px;
            width: parent.width - 32px - 17px;
            height: 16px;
            background: transparent;

            name-text := Text {
                text: CreateInstanceState.custom-name != ""
                    ? CreateInstanceState.custom-name
                    : CreateInstanceState.default-name;
                // Pinned left because a bare `Text` is centred by Slint; elides
                // before the edit icon.
                x: 0;
                width: min(self.preferred-width, parent.width - 30px);
                height: 16px;
                font-size: 16px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
            }

            edit-icon := AppIcon {
                name: "create-outline";
                size: 16px;
                x: name-text.width + 4px;
                icon-color: Theme.default-text-color.transparentize(0.1);
                transform-scale: edit-touch.pressed ? 97% : edit-touch.has-hover ? 102% : 100%;
                animate transform-scale { duration: 100ms; }
            }

            edit-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    FocusManager.clear();
                    CreateInstanceState.name-editing = true;
                }
            }
        }

        if CreateInstanceState.name-editing: name-input := TextInput {
            x: 32px;
            y: 9px;
            width: parent.width - 32px - 17px;
            height: 16px;
            text <=> CreateInstanceState.custom-name;
            font-size: 16px;
            font-weight: Theme.font-weight-normal;
            color: Theme.default-text-color.transparentize(0.1);
            // The macOS caret uses the selection colour, so keep it translucent.
            selection-background-color: Theme.default-text-color.with-alpha(0.3);
            selection-foreground-color: Theme.default-text-color;
            single-line: true;
            vertical-alignment: center;
            // Focus on appearance; losing focus ends editing.
            init => { self.focus(); }
            changed has-focus => {
                if !self.has-focus && CreateInstanceState.name-editing {
                    CreateInstanceState.name-editing = false;
                }
            }
            // Clicking another control drops focus, which ends the edit.
            private property <int> clear-sequence: FocusManager.clear-sequence;
            changed clear-sequence => { self.clear-focus(); }
        }

        // `TextInput` has no placeholder, so it is drawn over the field.
        if CreateInstanceState.name-editing && CreateInstanceState.custom-name == "": Text {
            x: 32px;
            y: 9px;
            width: parent.width - 32px - 17px;
            height: 16px;
            text: CreateInstanceState.default-name;
            font-size: 16px;
            font-weight: Theme.font-weight-normal;
            color: Theme.default-text-color.transparentize(0.2);
            vertical-alignment: center;
            overflow: elide;
        }

        details := HorizontalLayout {
            x: 32px;
            y: 9px + 16px + 6px;
            width: parent.width - 32px - 17px;
            height: 13px;
            spacing: 8px;
            alignment: start;
            cross-axis-alignment: center;

            tag := Rectangle {
                width: tag-text.preferred-width + 12px;
                height: 13px;
                border-radius: 100px;
                background: root.tag-color(CreateInstanceState.mod-loader-type.to-lowercase());

                tag-text := Text {
                    text: CreateInstanceState.mod-loader-type == "None"
                        ? "Vanilla"
                        : CreateInstanceState.mod-loader-type;
                    font-size: 11px;
                    font-weight: 500;
                    color: Theme.text-inverse;
                }
            }

            if CreateInstanceState.minecraft-version != "": HorizontalLayout {
                spacing: 0px;
                alignment: start;
                cross-axis-alignment: center;

                Text {
                    text: "Minecraft: ";
                    font-size: 11px;
                    font-weight: 300;
                    color: Theme.default-text-color.transparentize(0.1).with-alpha(0.72);
                }

                Text {
                    text: CreateInstanceState.minecraft-version;
                    font-size: 11px;
                    font-weight: 500;
                    color: Theme.default-text-color.transparentize(0.1);
                }
            }
        }
    }

    Rectangle {
        width: 100%;
        height: 12px;
        background: transparent;
    }

    SettingGroup {
        SettingItem {
            group-first: true;
            title: @tr("CreateInstance" => "Set background image");
            icon: "image";
            navigable: CreateInstanceState.background-path == "";
            clicked => { CreateInstanceState.pick-background(@tr("CreateInstance" => "Images")); }

            // Once a file is picked, a "Remove image" button replaces the chevron.
            if CreateInstanceState.background-path != "": Button {
                text: @tr("CreateInstance" => "Remove image");
                text-color: Theme.red;
                clicked => { CreateInstanceState.background-path = ""; }
            }
        }

        SettingItem {
            group-last: true;
            title: @tr("CreateInstance" => "Use instance background as launcher background");
            item-disabled: CreateInstanceState.background-path == "";
            // The switch is inert: the choice is not persisted yet.
            Switch { }
        }
    }

    Rectangle {
        width: 100%;
        height: 16px;
        background: transparent;
    }

    SettingGroup {
        title: @tr("CreateInstance" => "Version settings");

        SettingItem {
            group-first: true;
            title: "Minecraft";
            icon: "minecraft";
            description: CreateInstanceState.minecraft-version != ""
                ? @tr("CreateInstance" => "Selected {}", CreateInstanceState.minecraft-version)
                : "";
            navigable: true;
            clicked => { CreateInstanceState.step = "minecraft-choose"; }
        }

        SettingItem {
            title: @tr("CreateInstance" => "Mod loader");
            loading: CreateInstanceState.mod-loader-loading;

            Select {
                options: ["None", "Fabric", "Quilt", "Neoforge", "Forge"];
                display-name: [@tr("CreateInstance" => "None"), "Fabric", "Quilt", "Neoforge", "Forge"];
                option-enabled: CreateInstanceState.loader-option-enabled();
                value <=> CreateInstanceState.mod-loader-type;
                // Selecting a loader clears the version.
                selected(value) => { CreateInstanceState.mod-loader-version = ""; }
            }
        }

        SettingItem {
            group-last: true;
            title: @tr("CreateInstance" => "Loader version");
            // Shown as a title suffix.
            title-suffix: CreateInstanceState.minecraft-version;
            icon: "extension-puzzle";
            description: CreateInstanceState.minecraft-version != ""
                ? (CreateInstanceState.mod-loader-version != ""
                ? @tr(
                        "CreateInstance" => "Selected {}",
                        CreateInstanceState.mod-loader-type + " " + CreateInstanceState.mod-loader-version)
                : @tr("CreateInstance" => "Click to select a mod loader version"))
                : @tr("CreateInstance" => "Select a Minecraft version first");
            navigable: true;
            item-disabled: CreateInstanceState.minecraft-version == ""
                || CreateInstanceState.mod-loader-type == "None";
            clicked => { CreateInstanceState.step = "mod-loader-choose"; }
        }
    }

    Rectangle {
        width: 100%;
        height: 16px;
        background: transparent;
    }

    // The step already insets by 8px. The default `stretch` splits the row;
    // another main-axis alignment would pack both buttons left.
    actions := HorizontalLayout {
        spacing: 12px;

        // Equal explicit widths keep the buttons equal despite different labels;
        // stretch alone only distributes extra space.
        Button {
            button-width: (actions.width - actions.spacing) / 2;
            horizontal-stretch: 1;
            text: @tr("CreateInstance" => "Cancel");
            clicked => { Dialogs.create-instance-visible = false; }
        }

        Button {
            button-width: (actions.width - actions.spacing) / 2;
            horizontal-stretch: 1;
            text: CreateInstanceState.creating
                ? @tr("CreateInstance" => "Creating...")
                : @tr("CreateInstance" => "Create instance");
            // Needs a version, and a loader version when modded.
            button-enabled: !CreateInstanceState.creating
                && CreateInstanceState.minecraft-version != ""
                && (CreateInstanceState.mod-loader-type == "None"
                || CreateInstanceState.mod-loader-version != "");
            clicked => { CreateInstanceState.create(); }
        }
    }
}

// The create-instance dialog: a 480×480 panel swapping between three screens.
//
// The swap is out-in: the mounted screen leaves, then the next is created at its
// enter rest and moves to "shown" a frame later. The direction comes from the
// screen being left.
export component CreateInstance inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    private property <length> title-height: 40px;
    // The version chooser is the inner area minus 42px; the loader chooser fills
    // it entirely.
    private property <length> version-screen-height: 42px;
    private property <bool> open: Dialogs.create-instance-visible;
    // The step the user asked for; the title follows it at once.
    private property <string> step: CreateInstanceState.step;
    // The screen actually mounted, following `step` only after the leave. Driving
    // the leave from the mounted screen is what makes it play: a hidden copy would
    // jump straight to the leave values.
    private property <string> shown: "";
    private property <bool> leaving: false;
    private property <string> arrive-phase: "shown";
    private property <string> direction: "in";
    private property <bool> leave-armed: false;
    private property <bool> enter-armed: false;

    changed open => {
        if open {
            CreateInstanceState.step = "minecraft-choose";
        } else {
            // Clearing the step unmounts the screens so the next open rebuilds.
            CreateInstanceState.step = "";
            CreateInstanceState.custom-name = "";
            CreateInstanceState.name-editing = false;
            CreateInstanceState.minecraft-version = "";
            CreateInstanceState.mod-loader-type = "None";
            CreateInstanceState.mod-loader-version = "";
            CreateInstanceState.background-path = "";
            CreateInstanceState.creating = false;
        }
    }

    changed step => {
        if root.step == "" {
            root.shown = "";
            root.leaving = false;
            root.leave-armed = false;
            root.enter-armed = false;
            root.arrive-phase = "shown";
            root.direction = "in";
        } else {
            // The direction comes from the screen being left.
            root.direction = (root.step == "minecraft-choose"
                || (root.step == "settings" && root.shown == "mod-loader-choose"))
                ? "in"
                : "out";

            // The crate caches the manifest for 30 minutes.
            if root.step == "minecraft-choose" {
                CreateInstanceState.load-minecraft-versions();
            }
            if root.shown == "" {
                // The first screen just appears; mounting is not animated.
                root.shown = root.step;
            } else if root.step == root.shown {
                // Switching back to the screen that is leaving calls it off.
                root.leaving = false;
                root.leave-armed = false;
            } else {
                root.leaving = true;
                root.leave-armed = true;
                leave-timer.restart();
            }
        }
    }

    // The out-in beat: mount the arriving screen after the leave.
    leave-timer := Timer {
        interval: 80ms;
        running: root.leave-armed;
        triggered => {
            root.leave-armed = false;
            root.leaving = false;
            if root.step != root.shown {
                root.shown = root.step;
                root.arrive-phase = "enter";
                root.enter-armed = true;
            }
        }
    }

    // Mount at the enter rest, then move to "shown" a frame later.
    enter-timer := Timer {
        interval: 16ms;
        running: root.enter-armed;
        triggered => {
            root.enter-armed = false;
            root.arrive-phase = "shown";
        }
    }

    // An instance, not a base: in an inherited component `parent` would resolve
    // against the base's root (the whole window), not the `@children` slot.
    dialog := Dialog {
        dialog-visible: Dialogs.create-instance-visible;
        dialog-width: 480px;
        dialog-height: 480px;

        // Sized from `Dialog`: `parent` here is the window, not the content slot.
        scroll := Rectangle {
            x: 4px;
            y: 4px;
            width: dialog.content-width - 8px;
            height: dialog.content-height - 8px;
            background: transparent;
            // Only a `Rectangle` can clip; without it the screen draws over the
            // panel's rounded edges.
            clip: true;

            // The dialog's scroll area; its scrollbar is hidden globally.
            flick := Flickable {
                width: 100%;
                height: 100%;
                interactive: !Dropdown.open;
                mouse-drag-pan-enabled: false;
                // Without this the column lays out at its preferred width.
                content-width: scroll.width;

                VerticalLayout {
                    alignment: start;

                    title := Rectangle {
                        width: 100%;
                        height: root.title-height;
                        background: transparent;

                        Text {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 8px;
                            height: 16px;
                            text: root.step == "minecraft-choose"
                                ? @tr("Select Minecraft version")
                                : root.step == "mod-loader-choose" ? @tr("Select mod loader") : @tr("Create new instance");
                            font-size: 16px;
                            font-weight: Theme.font-weight-normal;
                            color: Theme.default-text-color.transparentize(0.1);
                            vertical-alignment: center;
                        }
                    }

                    // Keyed on the mounted screen, so the leaving screen stays
                    // alive to animate and the arriving one mounts freshly.
                    if root.shown == "settings": SettingsStep {
                        phase: root.leaving ? "leave" : root.arrive-phase;
                        direction: root.direction;
                    }
                    if root.shown == "minecraft-choose": MinecraftChoose {
                        phase: root.leaving ? "leave" : root.arrive-phase;
                        direction: root.direction;
                        // The inner area less the title.
                        screen-height: flick.height - root.version-screen-height;
                    }
                    if root.shown == "mod-loader-choose": ModLoaderChoose {
                        phase: root.leaving ? "leave" : root.arrive-phase;
                        direction: root.direction;
                        // Fills what the title leaves; it scrolls its own list.
                        screen-height: flick.height - root.title-height;
                    }
                }
            }

            dropdown-scroll-blocker := TouchArea {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                enabled: Dropdown.open;
                scroll-event(event) => { return accept; }
                clicked => { Dropdown.open = false; }
            }
        }
    }
}
