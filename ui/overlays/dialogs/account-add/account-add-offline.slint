import { Theme } from "../../../theme.slint";
import { Button } from "../../../components/controls/button.slint";
import { Input } from "../../../components/controls/input.slint";
import { Switch } from "../../../components/controls/switch.slint";
import { AccountAddState } from "../../../globals/dialogs.slint";

// "Create an offline profile", the add-account dialog's third screen. The UUID is
// derived or validated in Rust, since Slint has no regular expressions.
export component AccountAddOffline inherits VerticalLayout {
    width: 100%;
    spacing: 0px;
    // `start`: a stretching column would spread the wrapped height over the rows.
    alignment: start;

    // The wizard hides the "Cancel" button.
    in property <bool> wizard-host: false;

    init => {
        // The screen is rebuilt whenever the dialog switches services.
        AccountAddState.reset-offline-form();
    }

    Text {
        text: @tr("Log in without any auth service. Skins are usually invisible in multiplayer, and servers with online-mode enabled will not let you join.");
        font-size: 14px;
        line-height-factor: 1.3;
        wrap: word-wrap;
        color: Theme.default-text-color.transparentize(0.1);
    }

    // The description's 8px bottom margin, since a layout has no margin.
    form := VerticalLayout {
        padding-top: 8px;
        spacing: 8px;

        HorizontalLayout {
            alignment: space-between;
            cross-axis-alignment: center;

            Text {
                text: @tr("Username");
                font-size: 13px;
                color: Theme.default-text-color.transparentize(0.1);
            }

            Input {
                input-width: 260px;
                placeholder: @tr("Username");
                value <=> AccountAddState.offline-username;
                edited => { AccountAddState.sync-offline-uuid(); }
            }
        }

        HorizontalLayout {
            alignment: space-between;
            cross-axis-alignment: center;

            Text {
                text: @tr("Enable advanced settings");
                font-size: 13px;
                color: Theme.default-text-color.transparentize(0.1);
            }

            // The script handles the toggle because it empties the UUID field.
            Switch {
                checked: AccountAddState.offline-advanced;
                toggled => { AccountAddState.toggle-offline-advanced(); }
            }
        }

        // The whole row fades while the field uses its derived value.
        HorizontalLayout {
            alignment: space-between;
            cross-axis-alignment: center;
            opacity: AccountAddState.offline-advanced ? 1.0 : 0.4;
            animate opacity {
                duration: 200ms;
                easing: ease;
            }

            VerticalLayout {
                spacing: 2px;
                alignment: center;

                Text {
                    text: @tr("UUID");
                    font-size: 13px;
                    color: Theme.default-text-color.transparentize(0.1);
                }

                Text {
                    text: AccountAddState.offline-uuid-invalid
                        ? @tr("The UUID you entered is not valid")
                        : @tr("The unique identifier of a Minecraft player");
                    font-size: 12px;
                    color: AccountAddState.offline-uuid-invalid ? Theme.red
                        : Theme.default-text-color.transparentize(0.5);
                }
            }

            Input {
                input-width: 260px;
                placeholder: @tr("UUID");
                input-enabled: AccountAddState.offline-advanced;
                error: AccountAddState.offline-uuid-invalid;
                value <=> AccountAddState.offline-uuid;
                edited => { AccountAddState.sync-offline-uuid(); }
            }
        }
    }

    HorizontalLayout {
        padding-top: 12px;
        spacing: 8px;

        if !root.wizard-host: Button {
            horizontal-stretch: 1;
            text: @tr("Cancel");
            clicked => { AccountAddState.close(); }
        }

        Button {
            horizontal-stretch: 1;
            text: @tr("Create offline profile");
            button-background: Theme.latte-lavender;
            text-color: #000;
            button-enabled: AccountAddState.offline-can-submit;
            clicked => { AccountAddState.add-offline-account(); }
        }
    }
}
