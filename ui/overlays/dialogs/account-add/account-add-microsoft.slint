import { Theme } from "../../../theme.slint";
import { Button } from "../../../components/controls/button.slint";
import { Loading } from "../../../components/controls/loading.slint";
import { TooltipArea } from "../../../components/controls/tooltip-area.slint";
import {
    SlideTransition,
} from "../../../components/containers/slide-transition.slint";
import { Dialogs, AccountAddState } from "../../../globals/dialogs.slint";

// "Sign in with Microsoft", the add-account dialog's first screen. Four states,
// swapped with the same out-in beat as the dialog shell; Rust drives `ms-view`.
export component AccountAddMicrosoft inherits VerticalLayout {
    width: 100%;
    spacing: 0px;
    // `start`: a stretching column would spread height changes over the rows.
    alignment: start;

    // The wizard hides the "Cancel" buttons and gives the link box more room.
    in property <bool> wizard-host: false;

    /// The link box's gap: 8px/16px in the dialog, 36px in the wizard. Margins
    /// collapse, so the row below is `max(link-margin, 16px)` away, not the sum.
    private property <length> link-margin: root.wizard-host ? 36px : 8px;

    // Mirrored locally because `changed` cannot take a qualified global.
    private property <string> view: AccountAddState.ms-view;
    /// The state actually mounted, one 80ms beat behind `view`.
    private property <string> shown: "";
    private property <bool> leaving: false;
    private property <bool> leave-armed: false;
    private property <bool> enter-armed: false;
    private property <string> arrive-phase: "shown";

    // Later states slide in from the right; the first one slides back from the left.
    private property <string> direction: (root.view == "processing" || root.view == "error"
        || root.view == "device-code") ? "left" : "right";

    init => {
        root.shown = root.view;
        // The change tracker takes its baseline after `init`, so a screen that
        // opens already on the browser flow never fires `changed`. Ask for the
        // listener here; `prepare-auth-code-flow` is a no-op if already bound.
        if root.browser-flow-on-screen {
            AccountAddState.prepare-auth-code-flow();
        }
    }

    changed view => {
        if root.shown == "" {
            root.shown = root.view;
        } else if root.view == root.shown {
            root.leaving = false;
            root.leave-armed = false;
        } else {
            root.leaving = true;
            root.leave-armed = true;
            leave-timer.restart();
        }
    }

    // The out-in beat: mount the arriving state after the leave.
    leave-timer := Timer {
        interval: 80ms;
        running: root.leave-armed;
        triggered => {
            root.leave-armed = false;
            root.leaving = false;
            if root.view != root.shown {
                root.shown = root.view;
                root.arrive-phase = "enter";
                root.enter-armed = true;
            }
        }
    }

    // Mount at the enter rest, then move to "shown" a frame later; otherwise
    // there is nothing to animate from.
    enter-timer := Timer {
        interval: 16ms;
        running: root.enter-armed;
        triggered => {
            root.enter-armed = false;
            root.arrive-phase = "shown";
        }
    }

    // Runs while the code is on screen and has seconds left.
    countdown := Timer {
        interval: 1000ms;
        running: root.shown == "device-code" && AccountAddState.ms-expires-in > 0;
        triggered => { AccountAddState.ms-expires-in -= 1; }
    }

    // The URL is only meaningful while its listener is bound on an OS-assigned
    // port, so bind it exactly while this screen is on show with its host open.
    // The wizard mounts the screen without the dialog, so `wizard-host` stands
    // in for dialog visibility. `shown`, not `view`, because the swap is out-in.
    private property <bool> dialog-visible: Dialogs.account-add-visible;
    private property <bool> browser-flow-on-screen: root.shown == "auth-code"
        && (root.dialog-visible || root.wizard-host);
    changed browser-flow-on-screen => {
        if root.browser-flow-on-screen {
            AccountAddState.prepare-auth-code-flow();
        } else {
            AccountAddState.release-auth-code-flow();
        }
    }

    /// In the UI so a language change re-renders it.
    pure function progress-text(job: string) -> string {
        if job == "prepare" { return @tr("Preparing to log in"); }
        if job == "request-device-code" { return @tr("Requesting a device code"); }
        if job == "redeem-access-token" { return @tr("Getting the access token"); }
        if job == "xbox-authenticate" { return @tr("Signing in to Xbox"); }
        if job == "xsts-authenticate" { return @tr("Verifying XSTS"); }
        if job == "minecraft-authenticate" { return @tr("Getting the Minecraft access token"); }
        if job == "get-profile" { return @tr("Getting the game profile"); }
        if job == "save-account" { return @tr("Saving the account"); }
        return "";
    }

    /// `floor`, because Slint's `/` is floating-point even on integers.
    pure function countdown-text(seconds: int) -> string {
        if seconds < 60 { return @tr("{} sec", seconds); }
        return @tr("{} min {} sec", floor(seconds / 60), mod(seconds, 60));
    }

    if root.shown == "error": SlideTransition {
        phase: root.leaving ? "leave" : root.arrive-phase;
        direction: root.direction;

        Text {
            text: @tr("Login failed: {}", AccountAddState.ms-error);
            wrap: word-wrap;
            color: Theme.default-text-color.transparentize(0.1);
        }
    }

    if root.shown == "processing": SlideTransition {
        phase: root.leaving ? "leave" : root.arrive-phase;
        direction: root.direction;
        min-height: 120px;
        vertical-stretch: 0;

        VerticalLayout {
            width: 100%;
            height: 120px;
            alignment: center;
            spacing: 8px;

            // An 8px padding around the arc; a single child gets no `spacing`.
            HorizontalLayout {
                alignment: center;
                cross-axis-alignment: center;
                padding: 8px;

                Loading {
                    size: 40px;
                    stroke-width: 5;
                    gap: 12;
                }
            }

            Text {
                text: root.progress-text(AccountAddState.ms-progress);
                font-size: 14px;
                horizontal-alignment: center;
                wrap: word-wrap;
                color: Theme.default-text-color.transparentize(0.1);
            }
        }
    }

    if root.shown == "device-code": SlideTransition {
        phase: root.leaving ? "leave" : root.arrive-phase;
        direction: root.direction;

        // `StyledText` is the only element that can hold a link inside a wrapping
        // paragraph; Slint 1.18 has no click target for a span.
        StyledText {
            width: 100%;
            text: @markdown("\{@tr("Open a web page on any device — ")}[\{AccountAddState.ms-verification-uri}](conic:open-verification)\{@tr(", enter the device code below and sign in. It expires in {}.", root.countdown-text(AccountAddState.ms-expires-in))} [\{@tr("Click here")}](conic:use-auth-code)\{@tr(" to sign in with your browser instead.")}");
            default-font-size: 14px;
            default-color: Theme.default-text-color.transparentize(0.1);
            link-color: Theme.blue;
            link-clicked(link) => {
                if link == "conic:use-auth-code" {
                    AccountAddState.use-auth-code-flow();
                } else {
                    AccountAddState.open-url(AccountAddState.ms-verification-uri);
                }
            }
        }

        // The wizard's 36px margin is spent below, where the button row's 16px
        // would have collapsed into it.
        Rectangle {
            height: root.link-margin;
            background: transparent;
        }

        Rectangle {
            width: 100%;
            height: 48px;
            background: transparent;

            // Measures "0" at the inherited base size, since the 20px belongs to
            // the inner code text.
            zero-glyph := Text {
                text: "0";
                font-size: Theme.font-size-base;
                visible: false;
            }

            // No padding, so the code centres in the 20ch.
            code-box := Rectangle {
                width: zero-glyph.preferred-width * 20;
                height: parent.height;
                border-radius: Theme.controllers-border-radius;
                border-width: 1px;
                border-color: Theme.controllers-border;
                background: code-touch.pressed ? Theme.surface-1
                    : code-touch.has-hover ? Theme.surface-0
                    : transparent;
                animate background {
                    duration: 100ms;
                    easing: ease;
                }

                code-text := Text {
                    y: 0;
                    x: (parent.width - self.width) / 2;
                    height: parent.height;
                    text: AccountAddState.ms-user-code;
                    font-size: 20px;
                    // Bolder: the code is meant to be read and retyped.
                    font-weight: 700;
                    letter-spacing: 4px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    color: Theme.default-text-color.transparentize(0.1);
                }

                code-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => {
                        AccountAddState.copy-text(AccountAddState.ms-user-code);
                        AccountAddState.ms-copied-code = true;
                    }
                    // The hint lasts as long as the hover, so leaving resets it.
                    // A timer would flip it while the pointer is still on the code.
                    changed has-hover => {
                        if !self.has-hover {
                            AccountAddState.ms-copied-code = false;
                        }
                    }
                }

                TooltipArea {
                    text: AccountAddState.ms-copied-code ? @tr("Copied!") : @tr("Click to copy");
                    hovered: code-touch.has-hover;
                    wrap: false;
                    show-on-press: false;
                }
            }
        }

        // Its 16px applies only where the link's margin does not already exceed it.
        HorizontalLayout {
            padding-top: max(root.link-margin, 16px);
            spacing: 8px;

            if !root.wizard-host: Button {
                horizontal-stretch: 1;
                text: @tr("Cancel");
                clicked => { AccountAddState.cancel-microsoft-login(); }
            }
        }
    }

    if root.shown == "auth-code": SlideTransition {
        phase: root.leaving ? "leave" : root.arrive-phase;
        direction: root.direction;

        StyledText {
            width: 100%;
            text: @markdown("\{@tr("Clicking \"Log in\" opens your browser to sign in. You can also ")}[\{@tr("click to copy the link below")}](conic:copy-link)\{@tr(". To finish signing in on another device, ")}[\{@tr("use a device code")}](conic:device-code)\{@tr(" instead.")}");
            default-font-size: 14px;
            default-color: Theme.default-text-color.transparentize(0.1);
            link-color: Theme.blue;
            link-clicked(link) => {
                if link == "conic:device-code" {
                    AccountAddState.use-device-code-flow();
                } else {
                    // No tooltip: `StyledText` has no children to hang one on; the
                    // link box below carries it instead.
                    AccountAddState.copy-text(AccountAddState.auth-code-login-url);
                }
            }
        }

        HorizontalLayout {
            padding-top: root.link-margin;
            cross-axis-alignment: center;

            Text {
                text: @tr("Login link:");
                font-size: 14px;
                color: Theme.default-text-color.transparentize(0.1);
            }

            link-box := Rectangle {
                horizontal-stretch: 1;
                height: 30px;
                border-radius: Theme.controllers-border-radius;
                background: link-touch.pressed ? Theme.controllers-background-focus
                    : link-touch.has-hover ? Theme.controllers-background-hover
                    : Theme.controllers-background;
                border-width: 1px;
                border-color: Theme.controllers-border;
                animate background {
                    duration: 100ms;
                    easing: ease;
                }

                Text {
                    x: 8px;
                    y: 0;
                    height: parent.height;
                    width: parent.width - 16px;
                    text: AccountAddState.auth-code-login-url;
                    vertical-alignment: center;
                    overflow: elide;
                    font-size: 12.5px;
                    color: Theme.default-text-color.transparentize(0.1);
                }

                link-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => {
                        AccountAddState.copy-text(AccountAddState.auth-code-login-url);
                        AccountAddState.ms-copied = true;
                    }
                    // The hint lasts as long as the hover; a timer would flip it
                    // while the pointer is still on the link.
                    changed has-hover => {
                        if !self.has-hover {
                            AccountAddState.ms-copied = false;
                        }
                    }
                }

                TooltipArea {
                    text: AccountAddState.ms-copied ? @tr("Copied!") : @tr("Click to copy");
                    hovered: link-touch.has-hover;
                    wrap: false;
                    show-on-press: false;
                }
            }
        }

        HorizontalLayout {
            padding-top: max(root.link-margin, 16px);
            spacing: 8px;

            if !root.wizard-host: Button {
                horizontal-stretch: 1;
                text: @tr("Cancel");
                clicked => { AccountAddState.cancel-microsoft-login(); }
            }

            Button {
                horizontal-stretch: 1;
                text: @tr("Log in");
                button-background: Theme.blue;
                text-color: Theme.text-inverse;
                // The URL Rust filled in when it bound the listener; the wait for
                // the callback is already running.
                clicked => { AccountAddState.open-url(AccountAddState.auth-code-login-url); }
            }
        }
    }
}
