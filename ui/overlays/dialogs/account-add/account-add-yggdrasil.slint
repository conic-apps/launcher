import { Theme } from "../../../theme.slint";
import { Button } from "../../../components/controls/button.slint";
import { Checkbox } from "../../../components/controls/checkbox.slint";
import { Input } from "../../../components/controls/input.slint";
import { Loading } from "../../../components/controls/loading.slint";
import { ScrollView } from "../../../components/containers/scroll-view.slint";
import {
    AccountAddState,
    YggdrasilProfileItem,
} from "../../../globals/dialogs.slint";
import { AvatarMask } from "../../../globals/avatar.slint";

// "Sign in with Yggdrasil", the add-account dialog's second screen. Four states,
// swapped without an animation.
export component AccountAddYggdrasil inherits VerticalLayout {
    width: 100%;
    spacing: 0px;
    // `start`: a stretching column would spread the height surplus over the rows.
    alignment: start;

    // The wizard hides the "Cancel" button.
    in property <bool> wizard-host: false;

    init => {
        // The screen is rebuilt whenever the dialog switches services.
        AccountAddState.reset-yggdrasil-form();
    }

    // A direct child, not a form row: one level deeper, a wrapping `Text`
    // measured a single line for its three and clipped the buttons away.
    if AccountAddState.yggdrasil-view == "form": Text {
        text: @tr("Sign in to a Minecraft account through a third-party Yggdrasil auth server — for skin sites, self-hosted auth servers and other unofficial account systems.");
        font-size: 14px;
        line-height-factor: 1.3;
        wrap: word-wrap;
        color: Theme.default-text-color.transparentize(0.1);
    }

    if AccountAddState.yggdrasil-view == "form": VerticalLayout {
        alignment: start;

        // The description's 8px bottom margin, since a layout has no margin.
        VerticalLayout {
            padding-top: 8px;
            spacing: 8px;

            HorizontalLayout {
                alignment: space-between;
                cross-axis-alignment: center;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: @tr("Auth server address (API root)");
                        font-size: 13px;
                        color: Theme.default-text-color.transparentize(0.1);
                    }

                    if AccountAddState.yggdrasil-server-name != "": Text {
                        text: @tr("Auth service: {}", AccountAddState.yggdrasil-server-name);
                        font-size: 12px;
                        width: 200px;
                        color: Theme.default-text-color.transparentize(0.5);
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }

                Input {
                    input-width: 300px;
                    value <=> AccountAddState.yggdrasil-api-root;
                    edited => {
                        AccountAddState.sync-yggdrasil-submit();
                        server-lookup.restart();
                    }
                }
            }

            HorizontalLayout {
                alignment: space-between;
                cross-axis-alignment: center;

                Text {
                    text: @tr("Username");
                    font-size: 13px;
                    color: Theme.default-text-color.transparentize(0.1);
                }

                Input {
                    input-width: 300px;
                    value <=> AccountAddState.yggdrasil-username;
                    edited => { AccountAddState.sync-yggdrasil-submit(); }
                }
            }

            HorizontalLayout {
                alignment: space-between;
                cross-axis-alignment: center;

                Text {
                    text: @tr("Password");
                    font-size: 13px;
                    color: Theme.default-text-color.transparentize(0.1);
                }

                Input {
                    input-width: 300px;
                    value <=> AccountAddState.yggdrasil-password;
                    edited => { AccountAddState.sync-yggdrasil-submit(); }
                }
            }
        }

        HorizontalLayout {
            padding-top: 12px;
            spacing: 8px;

            if !root.wizard-host: Button {
                horizontal-stretch: 1;
                text: @tr("Cancel");
                clicked => { AccountAddState.close(); }
            }

            Button {
                horizontal-stretch: 1;
                text: @tr("Verify and add profile");
                button-background: Theme.latte-lavender;
                text-color: #000;
                button-enabled: AccountAddState.yggdrasil-can-submit;
                clicked => { AccountAddState.yggdrasil-login(); }
            }
        }
    }

    if AccountAddState.yggdrasil-view == "processing": Rectangle {
        width: 100%;
        height: 180px;
        background: transparent;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            alignment: center;
            spacing: 8px;

            // An 8px padding around the arc; a single child gets no `spacing`.
            HorizontalLayout {
                alignment: center;
                cross-axis-alignment: center;
                padding: 8px;

                Loading {
                    size: 40px;
                    stroke-width: 5;
                    gap: 12;
                }
            }

            Text {
                text: @tr("Please wait");
                font-size: 14px;
                horizontal-alignment: center;
                color: Theme.default-text-color.transparentize(0.1);
            }
        }
    }

    if AccountAddState.yggdrasil-view == "error": Rectangle {
        width: 100%;
        height: 120px;
        background: transparent;

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            alignment: center;
            cross-axis-alignment: center;
            spacing: 16px;
            padding-bottom: 8px;

            // Stretches because `cross-axis-alignment: center` would hand over
            // the unwrapped width, leaving nothing to wrap at.
            Text {
                text: AccountAddState.yggdrasil-error;
                font-size: 14px;
                horizontal-stretch: 1;
                horizontal-alignment: center;
                wrap: word-wrap;
                color: Theme.red;
            }

            Button {
                button-width: 100px;
                text: @tr("Back");
                clicked => { AccountAddState.yggdrasil-view = "form"; }
            }
        }
    }

    if AccountAddState.yggdrasil-view == "profiles": VerticalLayout {
        alignment: start;

        Text {
            text: @tr("This account has more than one profile — choose the ones to add");
            font-size: 14px;
            line-height-factor: 1.3;
            wrap: word-wrap;
            color: Theme.default-text-color.transparentize(0.1);
        }

        Rectangle {
            height: 8px;
            background: transparent;
        }

        // As tall as its 44px rows, up to 234px.
        list-wrapper := Rectangle {
            width: 100%;
            height: min(234px, 4px
                + AccountAddState.yggdrasil-profiles.length * 44px
                + max(0, AccountAddState.yggdrasil-profiles.length - 1) * 8px);
            background: transparent;

            ScrollView {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    spacing: 8px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    padding-left: 4px;
                    padding-right: 4px;

                    for profile[index] in AccountAddState.yggdrasil-profiles: Rectangle {
                        width: 100%;
                        height: 44px;
                        border-radius: 8px;
                        background: profile-touch.pressed ? Theme.overlay-0
                            : profile.selected || profile-touch.has-hover ? Theme.surface-2
                            : Theme.surface-1;
                        border-width: profile.selected ? 1px : 0px;
                        border-color: Theme.latte-lavender;
                        opacity: profile.added ? 0.4 : 1.0;
                        animate background {
                            duration: 150ms;
                            easing: ease;
                        }

                        Checkbox {
                            x: 10px;
                            checked: profile.selected;
                            checkbox-enabled: false;
                        }

                        // No disc or ring here. The round is cut in the pixels
                        // because a rounded `clip` is a no-op on the software
                        // renderer.
                        Rectangle {
                            x: 38px;
                            width: 28px;
                            height: 28px;
                            background: transparent;

                            if profile.avatar.width > 0: Image {
                                width: 28px;
                                height: 28px;
                                source: AvatarMask.rounded(profile.avatar, 10000px, 28px);
                                image-rendering: pixelated;
                            }
                        }

                        Text {
                            x: 76px;
                            y: 0;
                            width: parent.width - 86px;
                            height: parent.height;
                            text: profile.name + (profile.added ? @tr(" (added)") : "");
                            font-size: 14px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                            color: Theme.default-text-color.transparentize(0.1);
                        }

                        profile-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            enabled: !profile.added;
                            clicked => { AccountAddState.toggle-yggdrasil-profile(index); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            padding-top: 12px;
            spacing: 16px;

            Button {
                horizontal-stretch: 1;
                text: @tr("Back");
                clicked => { AccountAddState.yggdrasil-view = "form"; }
            }

            Button {
                horizontal-stretch: 1;
                text: @tr("Add profiles");
                button-background: Theme.latte-lavender;
                text-color: #000;
                button-enabled: AccountAddState.yggdrasil-has-selection;
                clicked => { AccountAddState.yggdrasil-add-profiles(); }
            }
        }
    }

    // Debounced 500ms: the name is looked up after typing stops, including when
    // the field empties.
    server-lookup := Timer {
        interval: 500ms;
        running: false;
        triggered => { AccountAddState.lookup-server-name(); }
    }
}
