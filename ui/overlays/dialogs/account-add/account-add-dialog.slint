import { Dialog } from "../dialog.slint";
import { Dialogs, AccountAddState } from "../../../globals/dialogs.slint";
import { AccountAdd } from "account-add.slint";

// The add-account dialog: the `AccountAdd` body inside a plain modal.
//
// `Dialog` has no fit-content, so the height comes from the body's measuring
// layout; the width does not feed back into it. 572px is the 540px body plus
// 16px padding each side.
export component AccountAddDialog inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // Reset on open. `changed` misses the initial value, so `init` covers a
    // dialog that starts open.
    private property <bool> dialog-open: Dialogs.account-add-visible;
    changed dialog-open => {
        if (root.dialog-open) {
            AccountAddState.reset();
        }
    }
    init => {
        if (root.dialog-open) {
            AccountAddState.reset();
        }
    }

    dialog := Dialog {
        dialog-visible: Dialogs.account-add-visible;
        dialog-width: 572px;
        dialog-height: body.preferred-height + 32px;

        body := AccountAdd {
            content-width: dialog.content-width;
        }
    }
}
