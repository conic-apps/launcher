import { Theme } from "../../theme.slint";
import { FocusManager } from "../../globals/focus.slint";
import { WindowDrag } from "../../globals/window-drag.slint";

// Modal dialog shell: a full-window scrim with a centred panel. Slint has no
// animation timeline, so the delays encode the track order. The scrim stays
// clickable through the leave, until the phase reaches "closed".
export component Dialog inherits Rectangle {
    /// Named with a prefix because `visible` is an element property.
    in property <bool> dialog-visible: false;
    /// 0 grows the panel to the window minus a 20px margin. Height changes are
    /// eased; the width switches instantly.
    in property <length> dialog-width: 0px;
    in property <length> dialog-height: 0px;
    /// The content area (panel minus 16px padding). Children written between the
    /// braces have the whole window as `parent`, so size against these.
    out property <length> content-width: panel.width - 32px;
    out property <length> content-height: panel.height - 32px;

    width: 100%;
    height: 100%;
    // Alpha is in the colour: an element `opacity` would create a render layer.
    background: #000000.with-alpha(0.259 * root.scrim-alpha);
    border-radius: 16px;

    // "closed" | "starting" | "shown" | "leaving".
    //
    // Visibility must not derive from an animated value: an unread animation
    // snaps, so the dialog would vanish in one frame. `leaving` keeps it on
    // screen until the timer hides it, and `starting` shows one frame at the
    // start values so the entrance is not skipped.
    private property <string> phase: "closed";
    visible: root.phase != "closed";

    changed dialog-visible => {
        if root.dialog-visible {
            if root.phase == "closed" {
                root.phase = "starting";
                start-timer.restart();
            } else {
                // Play the enter from wherever the leave got to.
                root.phase = "shown";
            }
        } else if root.phase != "closed" && root.phase != "leaving" {
            root.phase = "leaving";
        }
    }

    // One frame at the start values is enough for the renderer to see them.
    start-timer := Timer {
        interval: 16ms;
        running: root.phase == "starting";
        triggered => { root.phase = "shown"; }
    }

    // The leave's longest track: 100ms delay plus 200ms scrim.
    leave-timer := Timer {
        interval: 300ms;
        running: root.phase == "leaving";
        triggered => { root.phase = "closed"; }
    }

    init => {
        // `changed` does not fire for the value a component is created with.
        if root.dialog-visible {
            root.phase = "shown";
        }
    }

    private property <float> scrim-alpha: root.phase == "shown" ? 1.0 : 0.0;
    animate scrim-alpha {
        duration: 200ms;
        delay: root.phase == "shown" ? 0ms : 100ms;
        easing: ease-out-quad;
    }

    // Eased height changes only. `enabled` keeps the opening out: a dialog
    // appears at its natural height and only later resizes animate.
    private property <length> panel-height: root.dialog-height;
    animate panel-height {
        enabled: root.phase == "shown";
        duration: 300ms;
        easing: ease-out-quad;
    }

    private property <float> content-alpha: root.phase == "shown" ? 1.0 : 0.0;
    private property <float> content-scale: root.phase == "shown" ? 1.0 : 0.9;
    animate content-alpha {
        duration: root.phase == "shown" ? 300ms : 180ms;
        delay: root.phase == "shown" ? 200ms : 0ms;
        easing: root.phase == "shown" ? cubic-bezier(0.34, 1.56, 0.64, 1) : ease-out-quad;
    }
    animate content-scale {
        duration: root.phase == "shown" ? 300ms : 180ms;
        delay: root.phase == "shown" ? 200ms : 0ms;
        easing: root.phase == "shown" ? cubic-bezier(0.34, 1.56, 0.64, 1) : ease-out-quad;
    }

    // Swallows clicks through the leave; declared before the panel so the panel
    // stays on top. Dragging must start on the press, since the platform takes
    // over the drag and the release never reaches Slint.
    scrim-touch := TouchArea {
        enabled: root.visible;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                // A press outside the panel drops any focused text field.
                FocusManager.clear();
                WindowDrag.start();
            }
        }
    }

    // Pressing the panel must not start a window drag.
    panel := Rectangle {
        // Clamped to the window, with at least 20px visible around it.
        width: min(root.dialog-width > 0px ? root.dialog-width : root.width - 20px, root.width - 20px);
        height: min(root.panel-height > 0px ? root.panel-height : root.height - 20px, root.height - 20px);
        background: Theme.dialog-background;
        border-width: 1px;
        border-color: Theme.dialog-border;
        border-radius: Theme.dialog-border-radius;
        drop-shadow-color: #00000071;
        drop-shadow-blur: 50px;
        opacity: root.content-alpha;
        transform-scale: root.content-scale * 100%;

        panel-touch := TouchArea {
            width: 100%;
            height: 100%;
        }

        // The clip is a box outside the padding, so a control that grows (buttons
        // scale on hover) is not sliced off at the inner edge. A plain
        // `Rectangle` clip keeps the subtree out of a render layer.
        clip-box := Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            background: transparent;
            clip: true;

            content := Rectangle {
                x: 15px;
                y: 15px;
                width: parent.width - 30px;
                height: parent.height - 30px;
                background: transparent;
                @children
            }
        }
    }
}
