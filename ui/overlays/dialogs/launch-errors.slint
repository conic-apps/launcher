import { Theme } from "../../theme.slint";
import { Dialog } from "dialog.slint";
import { Button } from "../../components/controls/button.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { Dialogs } from "../../globals/dialogs.slint";
import { Navigation } from "../../globals/navigation.slint";

// The four dialogs the launch view raises. Each is a warning icon, a message and
// a "Cancel launch" button that hides it and goes back.
//
// The English source text is kept inside `@tr`, so an untranslated locale reads it.
export component LaunchErrorDialogs inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    no-account := Dialog {
        dialog-visible: Dialogs.no-account-error-visible;
        dialog-width: 500px;
        dialog-height: 146px;

        VerticalLayout {
            padding: 8px;
            spacing: 16px;

            HorizontalLayout {
                height: 50px;
                spacing: 16px;
                cross-axis-alignment: center;
                AppIcon {
                    name: "warning";
                    size: 50px;
                }

                Text {
                    vertical-alignment: center;
                    font-size: 16px;
                    color: Theme.default-text-color.transparentize(0.1);
                    wrap: word-wrap;
                    text: @tr("LaunchDialogs" => "To launch the game, you must have added at least one account");
                }
            }

            Button {
                horizontal-stretch: 1;
                text: @tr("LaunchDialogs" => "Cancel launch");
                clicked => {
                    Dialogs.no-account-error-visible = false;
                    Navigation.back();
                }
            }
        }
    }

    no-microsoft-account := Dialog {
        dialog-visible: Dialogs.no-microsoft-account-error-visible;
        dialog-width: 500px;
        dialog-height: 146px;

        VerticalLayout {
            padding: 8px;
            spacing: 16px;

            HorizontalLayout {
                height: 50px;
                spacing: 16px;
                cross-axis-alignment: center;
                AppIcon {
                    name: "warning";
                    size: 50px;
                }

                Text {
                    vertical-alignment: center;
                    font-size: 16px;
                    color: Theme.default-text-color.transparentize(0.1);
                    wrap: word-wrap;
                    text: @tr("LaunchDialogs" => "To launch the game, you must have added at least one Microsoft account");
                }
            }

            Button {
                horizontal-stretch: 1;
                text: @tr("LaunchDialogs" => "Cancel launch");
                clicked => {
                    Dialogs.no-microsoft-account-error-visible = false;
                    Navigation.back();
                }
            }
        }
    }

    refresh-failed := Dialog {
        dialog-visible: Dialogs.account-refresh-failed-visible;
        dialog-width: 500px;
        dialog-height: 146px;

        VerticalLayout {
            padding: 8px;
            spacing: 16px;

            HorizontalLayout {
                height: 50px;
                spacing: 16px;
                cross-axis-alignment: center;
                AppIcon {
                    name: "warning";
                    size: 50px;
                }

                Text {
                    vertical-alignment: center;
                    font-size: 16px;
                    color: Theme.default-text-color.transparentize(0.1);
                    wrap: word-wrap;
                    text: @tr("LaunchDialogs" => "Failed to refresh the account. Check your network connection and try again, or log in to the account again");
                }
            }

            Button {
                horizontal-stretch: 1;
                text: @tr("LaunchDialogs" => "Cancel launch");
                clicked => {
                    Dialogs.account-refresh-failed-visible = false;
                    Navigation.back();
                }
            }
        }
    }

    no-java := Dialog {
        dialog-visible: Dialogs.no-suitable-java-error-visible;
        dialog-width: 500px;
        dialog-height: 144px;

        VerticalLayout {
            padding: 8px;
            spacing: 16px;

            HorizontalLayout {
                height: 50px;
                spacing: 16px;
                cross-axis-alignment: center;
                AppIcon {
                    name: "warning";
                    size: 50px;
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    Text {
                        font-size: 17px;
                        color: Theme.default-text-color.transparentize(0.1);
                        wrap: word-wrap;
                        text: @tr("LaunchDialogs" => "Could not find a suitable Java runtime");
                    }

                    Text {
                        font-size: 12px;
                        color: Theme.default-text-color.transparentize(0.1);
                        wrap: word-wrap;
                        text: @tr("LaunchDialogs" => "You can set one manually in the instance settings");
                    }
                }
            }

            Button {
                horizontal-stretch: 1;
                text: @tr("LaunchDialogs" => "Cancel launch");
                text-color: Theme.text-inverse;
                button-background: Theme.blue;
                clicked => {
                    Dialogs.no-suitable-java-error-visible = false;
                    Navigation.back();
                }
            }
        }
    }
}
