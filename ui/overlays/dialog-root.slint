import { AccountAddDialog } from "dialogs/account-add/account-add-dialog.slint";
import { CreateInstance } from "dialogs/create-instance/create-instance.slint";
import { LaunchErrorDialogs } from "dialogs/launch-errors.slint";
import {
    MultiplayerExtension,
} from "dialogs/multiplayer/multiplayer-extension.slint";
import { ConfirmDeleteInstance } from "dialogs/confirm-delete-instance.slint";
import { ConfirmDeleteSave } from "dialogs/confirm-delete-save.slint";
import { ConfirmDeleteAccount } from "dialogs/confirm-delete-account.slint";
import { ConfirmQuitApp } from "dialogs/confirm-quit-app.slint";
import { ConfirmCancelTask } from "dialogs/confirm-cancel-task.slint";
import { RestartRequired } from "dialogs/restart-required.slint";
import { ModpackImportDialog } from "dialogs/modpack-import.slint";

// The dialog overlay layer. Each dialog hides until its flag is set and draws its
// own scrim, so a closed dialog lets everything through.
export component DialogRoot inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    /// Forwards `ConfirmQuitApp` to the app root, which exits.
    callback confirm-quit();

    /// Forwards `RestartRequired` to the app root, which re-execs.
    callback restart-app();

    CreateInstance { }
    // Delete prompts and launch errors sit above the instance settings overlay;
    // declaration order is the z-order, and the last instance is on top.
    ConfirmDeleteInstance { }

    LaunchErrorDialogs { }

    MultiplayerExtension { }

    AccountAddDialog { }

    ConfirmDeleteSave { }

    ConfirmDeleteAccount { }

    ConfirmCancelTask { }

    ConfirmQuitApp {
        confirm => { root.confirm-quit(); }
    }
    // After the quit prompt: a restart is never asked while a quit is up.
    RestartRequired {
        confirm => { root.restart-app(); }
    }

    // A dropped pack can arrive at any time, so it is the topmost layer.
    ModpackImportDialog { }
}
