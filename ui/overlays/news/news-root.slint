import { Theme } from "../../theme.slint";
import { NewsState } from "../../globals/news.slint";
import { ContentOverlay } from "../content/content-overlay.slint";
import { NewsListPanel } from "news-panel.slint";
import { NewsDetailPanel } from "news-detail.slint";

// The news overlay layer: the list, and the changelog detail drawn after it so
// the detail covers the list.
export component NewsRoot inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    list-overlay := ContentOverlay {
        overlay-visible: NewsState.visible;
        panel-inset: 150px;
        closed => { NewsState.close(); }

        NewsListPanel {
            panel-width: list-overlay.panel-width;
            panel-height: list-overlay.panel-height;
        }
    }

    // Declared last: a detail covers the list.
    detail-overlay := ContentOverlay {
        overlay-visible: NewsState.detail-visible;
        panel-inset: 150px;
        panel-background: Theme.base;
        closed => { NewsState.close-detail(); }

        NewsDetailPanel {
            panel-width: detail-overlay.panel-width;
            panel-height: detail-overlay.panel-height;
        }
    }
}
