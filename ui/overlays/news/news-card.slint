import { Theme } from "../../theme.slint";
import { Loading } from "../../components/controls/loading.slint";
import { TooltipArea } from "../../components/controls/tooltip-area.slint";
import { GameTime } from "../../globals/game.slint";
import { NewsCard as CardData, NewsText } from "../../globals/news.slint";

// One card of the news flow. The two feeds have different image shapes, so a
// banner stacks picture over copy and a square sits picture beside copy. Heights
// are computed in Rust because the flow positions cards absolutely for culling.

component CardMedia inherits Rectangle {
    in property <image> source;
    in property <bool> loading: false;

    background: Theme.surface-0;
    clip: true;

    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        // Crops rather than letterboxing.
        image-fit: cover;
        opacity: root.loading ? 0.0 : 1.0;
        animate opacity {
            duration: 200ms;
            easing: ease-out;
        }
    }

    if root.loading: Loading {
        size: 24px;
        stroke-width: 4;
        gap: 8;
        icon-color: Theme.overlay-1;
    }
}

// A news entry: the wide banner across the top, then the copy.
export component NewsBannerCard inherits Rectangle {
    in property <CardData> card;
    callback clicked;

    width: 100%;
    height: root.card.height;
    background: card-touch.has-hover ? Theme.surface-1.transparentize(0.4)
        : Theme.surface-0.transparentize(0.6);
    border-radius: 8px;
    clip: true;
    animate background {
        duration: 160ms;
        easing: ease-out;
    }

    /// Matches `layout::NEWS_MEDIA_HEIGHT` in Rust.
    private property <length> media-height: 200px;

    CardMedia {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.media-height;
        source: root.card.image;
        loading: root.card.image-loading;
        border-radius: 8px;
    }

    // Declared after the media so it paints over the banner's corner.
    date-chip := Rectangle {
        x: parent.width - self.width - 12px;
        y: 12px;
        width: chip-label.preferred-width + 20px;
        height: 22px;
        border-radius: 999px;
        background: Theme.crust.with-alpha(0.65);

        chip-label := Text {
            // The localized absolute date; it reorders for year-first languages.
            text: GameTime.year-month-day(
                root.card.date-month,
                root.card.date-day,
                root.card.date-year,
            );
            font-size: 12px;
            color: Theme.default-text-color.transparentize(0.1);
            vertical-alignment: center;
        }
    }

    info := Rectangle {
        x: 0;
        y: root.media-height;
        width: parent.width;
        height: parent.height - root.media-height;
        background: transparent;

        // Matches Rust's `BANNER_INFO_HEIGHT`.
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 4px;
            alignment: start;

            Text {
                height: 22px;
                text: root.card.title;
                font-size: 16px;
                font-weight: 700;
                color: Theme.default-text-color.transparentize(0.1);
                overflow: elide;
                vertical-alignment: center;
            }

            Text {
                height: 16px;
                text: root.card.subtitle;
                font-size: 12px;
                color: Theme.mauve;
                overflow: elide;
                vertical-alignment: center;
            }

            Text {
                height: 40px;
                text: root.card.description;
                font-size: 13px;
                color: Theme.default-text-color.transparentize(0.3);
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: top;
            }
        }
    }

    card-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // Only this shape opens in the browser, so only it carries the hint. The card
    // owns its touch, so hover comes from there.
    TooltipArea {
        text: @tr("View in browser");
        hovered: card-touch.has-hover;
        wrap: false;
        show-on-press: false;
    }
}

export component NewsRowCard inherits Rectangle {
    in property <CardData> card;
    callback clicked;

    width: 100%;
    height: root.card.height;
    background: card-touch.has-hover ? Theme.surface-1.transparentize(0.4)
        : Theme.surface-0.transparentize(0.6);
    border-radius: 8px;
    clip: true;
    animate background {
        duration: 160ms;
        easing: ease-out;
    }

    // Tall times ratio — a square here — and full card height.
    private property <length> media: root.height * root.card.image-ratio;

    CardMedia {
        x: 0;
        y: 0;
        width: root.media;
        height: parent.height;
        source: root.card.image;
        loading: root.card.image-loading;
        border-radius: 8px;
    }

    info := Rectangle {
        x: root.media + 14px;
        y: 0;
        width: max(0px, parent.width - root.media - 28px);
        height: parent.height;
        background: transparent;

        // Tag, version and date on one line.
        HorizontalLayout {
            x: 0;
            y: 8px;
            width: parent.width;
            height: 18px;
            spacing: 8px;
            cross-axis-alignment: center;

            Rectangle {
                height: 18px;
                width: tag-label.preferred-width + 14px;
                border-radius: 999px;
                background: root.card.tag == "release" ? Theme.green : Theme.yellow;

                tag-label := Text {
                    text: NewsText.kind-label(root.card.tag);
                    font-size: 10px;
                    font-weight: 500;
                    color: Theme.text-inverse;
                    vertical-alignment: center;
                }
            }

            // The version takes the slack and elides; the date says stretch 0
            // explicitly because the default is 1.
            Text {
                horizontal-stretch: 1;
                text: root.card.title;
                font-size: 15px;
                font-weight: 700;
                color: Theme.default-text-color.transparentize(0.1);
                overflow: elide;
                vertical-alignment: center;
            }

            Text {
                horizontal-stretch: 0;
                text: GameTime.year-month-day(
                    root.card.date-month,
                    root.card.date-day,
                    root.card.date-year,
                );
                font-size: 12px;
                color: Theme.subtext-0;
                vertical-alignment: center;
            }
        }

        Text {
            x: 0;
            y: 32px;
            width: parent.width;
            height: parent.height - 40px;
            text: root.card.description;
            font-size: 12px;
            color: Theme.default-text-color.transparentize(0.3);
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
        }
    }

    card-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component NewsCardView inherits Rectangle {
    in property <CardData> card;
    callback clicked;

    width: 100%;
    height: root.card.height;
    background: transparent;

    if root.card.kind == "changelog": NewsRowCard {
        card: root.card;
        clicked => { root.clicked(); }
    }

    if root.card.kind != "changelog": NewsBannerCard {
        card: root.card;
        clicked => { root.clicked(); }
    }
}
