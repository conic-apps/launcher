import { ContentState } from "../../globals/content.slint";
import { OverlayPanel } from "../shell/overlay-panel.slint";
import { ContentSavesPanel } from "saves-panel.slint";
import { ContentScreenshotsPanel } from "screenshots-panel.slint";
import { ContentModsPanel } from "mods-panel.slint";
import { ContentResourcepacksPanel } from "resourcepacks-panel.slint";
import { ContentPacksPanel } from "packs-panel.slint";
import { DetailPanel } from "details-panel.slint";
import { SaveDetailsPanel } from "save-details-panel.slint";

// The content overlay layer. Panels are shown/hidden rather than added/removed
// with `if`, so a reopened panel keeps its scroll position. Details are drawn
// last, so they cover the list they came from without disturbing it.
//
// Each panel is one `ScrollView` holding a 52px header bar and its content, so
// the search header scrolls away with the grid.
export component ContentRoot inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // One overlay per panel, each with its own enter/leave, so switching panels
    // plays both animations.
    saves-overlay := OverlayPanel {
        panel-visible: ContentState.open-panel == "saves";
        closed => { ContentState.close(); }

        ContentSavesPanel {
            panel-width: saves-overlay.panel-width;
            panel-height: saves-overlay.panel-height;
        }
    }

    mods-overlay := OverlayPanel {
        panel-visible: ContentState.open-panel == "mods";
        closed => { ContentState.close(); }

        ContentModsPanel {
            panel-width: mods-overlay.panel-width;
            panel-height: mods-overlay.panel-height;
        }
    }

    resourcepacks-overlay := OverlayPanel {
        panel-visible: ContentState.open-panel == "resourcepacks";
        closed => { ContentState.close(); }

        ContentResourcepacksPanel {
            panel-width: resourcepacks-overlay.panel-width;
            panel-height: resourcepacks-overlay.panel-height;
        }
    }

    // Mounted without the sliding container, so it spans the window.
    screenshots-overlay := OverlayPanel {
        panel-visible: ContentState.open-panel == "screenshots";
        slide: false;
        panel-inset: 0px;
        panel-background: transparent;
        closed => { ContentState.close(); }

        ContentScreenshotsPanel {
            panel-width: screenshots-overlay.panel-width;
            panel-height: screenshots-overlay.panel-height;
        }
    }

    packs-overlay := OverlayPanel {
        panel-visible: ContentState.open-panel == "packs";
        closed => { ContentState.close(); }

        ContentPacksPanel {
            panel-width: packs-overlay.panel-width;
            panel-height: packs-overlay.panel-height;
        }
    }

    DetailPanel { }

    // A save's details live in their own layer over the saves grid. Only one of
    // the two detail panels is ever open: the grid opens saves, the remote lists
    // open projects.
    SaveDetailsPanel { }
}
