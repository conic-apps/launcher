import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { Loading } from "../../components/controls/loading.slint";
import { WorldMap } from "world-map.slint";
import { WorldMapState } from "../../globals/worldmap.slint";
import {
    CardTag,
    ContentCard as CardData,
    ContentText,
} from "../../globals/content.slint";
import { GameState, GameTime } from "../../globals/game.slint";

// One card of a content grid, shared by all nine grids. The card is three
// overlapping boxes (image, info, action column) and the hover state reaches into
// them.
//
// The action column is declared before the image and info: siblings paint in
// declaration order. Rounded clips are a no-op on the software renderer, so the
// image's left corners can come out square.
//
// `ActionButton` draws only: the card owns the pointer and passes it its hover and
// press state, because a `TouchArea` here would steal the card's hover.
component ActionButton inherits Rectangle {
    in property <string> kind: "heart";
    in property <bool> favorited: false;
    in property <bool> shown: false;
    /// Worked out from the pointer position by the card.
    in property <bool> pointed: false;
    in property <bool> pressed: false;

    // Exactly the glyph's size; a larger box left it off-centre.
    width: 14px;
    height: 14px;
    background: transparent;
    opacity: root.shown ? (root.pressed ? 0.9 : (root.pointed ? 1.0 : 0.8)) : 0.0;
    transform-scale: root.shown ? 1.0 : 0.5;

    animate opacity, transform-scale {
        duration: 200ms;
        easing: ease-out-quad;
    }

    AppIcon {
        name: root.kind == "heart" && !root.favorited ? "heart-outline" : root.kind;
        size: 14px;
        icon-color: root.favorited && root.kind == "heart"
            ? Theme.red
            : Theme.default-text-color.transparentize(0.1);
    }
}

component TagChip inherits Rectangle {
    in property <CardTag> tag;

    // Margins sit outside the pill, so the background lives on an inner box.
    private property <bool> pill: tag.kind != "last-played" && tag.kind != "plain";
    private property <length> margin-before:
        tag.kind == "command-enabled" || tag.kind == "last-played" ? 4px : 0px;
    private property <length> margin-after:
        tag.kind == "version"
        || tag.kind == "loader-fabric"
        || tag.kind == "loader-forge"
        || tag.kind == "loader-neoforge"
        || tag.kind == "loader-quilt"
        || tag.kind == "loader-liteloader" ? 4px
        : 0px;

    // One 16px line box with a 13px pill centred in it.
    height: 16px;
    width: root.margin-before + pill-box.width + root.margin-after;
    background: transparent;

    // Resolved here because translated halves cannot be composed in Rust.
    private property <string> resolved: root.tag.kind == "last-played"
        ? ContentText.last-played-label()
        + GameTime.last-played(
                root.tag.time-kind,
                root.tag.time-hours,
                root.tag.time-month,
                root.tag.time-day,
                root.tag.time-year,
            )
        : root.tag.kind == "game-mode-survival" || root.tag.kind == "game-mode-creative"
        || root.tag.kind == "game-mode-adventure" || root.tag.kind == "game-mode-spectator"
        || root.tag.kind == "command-enabled" ? ContentText.save-tag(root.tag.kind)
        : root.tag.label + root.tag.text;

    pill-box := Rectangle {
        x: root.margin-before;
        y: root.pill ? 1.5px : 0px;
        height: root.pill ? 13px : 16px;
        border-radius: 100px;
        background: tag.kind == "loader-fabric" || tag.kind == "loader-liteloader"
            || tag.kind == "command-enabled" ? Theme.yellow
            : tag.kind == "loader-forge" ? Theme.blue
            : tag.kind == "loader-neoforge" ? Theme.peach
            : tag.kind == "loader-quilt" ? Theme.mauve
            : tag.kind == "game-mode-survival" ? Theme.green
            : tag.kind == "game-mode-creative" ? Theme.mauve
            : tag.kind == "game-mode-adventure" ? Theme.peach
            : tag.kind == "game-mode-spectator" ? Theme.blue
            : transparent;
        border-width: tag.kind == "version" ? 1px : 0px;
        border-color: Theme.sky;

        label := Text {
            text: root.resolved;
            // A version has no fill, so it uses body text. Last-played has no
            // per-span styling, so the whole tag takes the dimmer label colour.
            color: !root.pill || tag.kind == "version"
                ? Theme.default-text-color.transparentize(root.pill ? 0.1 : 0.3)
                : Theme.text-inverse;
            font-size: root.pill ? 9px : 10px;
            font-weight: root.pill ? 500 : Theme.font-weight-normal;
            x: root.pill ? 6px : 0px;
            vertical-alignment: center;
        }

        width: label.width + (root.pill ? 12px : 0px);
    }
}

export component ContentCard inherits Rectangle {
    in property <CardData> card;
    /// 72px for the content lists, 64px for the saves.
    in property <length> icon-size: 72px;
    /// The empty-state placeholder that covers an empty grid turns this off.
    in property <bool> interactive: true;
    /// "authors" for content lists, "folder" for the saves' folder.
    in property <string> subtitle-style: "authors";

    callback select();
    callback open-path();
    callback delete();
    callback toggle-favorite();
    callback open-link();
    callback play();

    // Placed by Rust: there is no grid layout here, so without these every card
    // would draw at the origin.
    x: card.x;
    y: card.y;
    width: card.width;
    height: card.height;
    visible: card.in_view;
    background: Theme.surface-0.transparentize(0.6);
    border-radius: 8px;
    opacity: card.mod-disabled ? 0.7 : 1.0;
    // An expanded save rises over its neighbours.
    z: card.selected ? 10 : 0;

    // One `TouchArea` routes clicks to the hover-revealed controls by position.
    // Per-control areas would fight: `has-hover` is only true for the topmost
    // area, so reaching a button would un-hover the card and fade the column out.
    hover-area := TouchArea {
        enabled: root.interactive;
        clicked => {
            if root.over-play {
                root.play();
            } else if root.over-first {
                if root.card.action-kind == "favorite" {
                    root.toggle-favorite();
                } else {
                    root.open-path();
                }
            } else if root.over-second {
                if root.card.action-kind == "favorite" {
                    root.open-link();
                } else {
                    root.delete();
                }
            } else if hover-area.mouse-x <= root.inner-right {
                root.select();
            }
        }
    }

    private property <bool> hovered: hover-area.has-hover || expansion.pointed;
    /// The 16px the inner card gives up while the pointer is on the card.
    private property <length> info-inset: root.hovered ? 16px : 0px;
    /// A click past the image and info is on the cell's transparent overhang and
    /// opens nothing.
    private property <length> inner-right:
        root.icon-size - 8px + max(0px, root.width - root.icon-size - root.info-inset);

    private property <length> actions-left: root.width - 18px;
    private property <bool> column-shown: root.card.action-kind != "";
    private property <length> play-top: (root.height - 18px) / 2;

    /// The pointer is over the column's top button.
    private property <bool> over-first:
        root.hovered && root.column-shown
        && hover-area.mouse-x >= root.actions-left
        && hover-area.mouse-y >= 12px && hover-area.mouse-y <= 26px;
    private property <bool> over-second:
        root.hovered && root.column-shown
        && hover-area.mouse-x >= root.actions-left
        && hover-area.mouse-y >= root.height - 26px && hover-area.mouse-y <= root.height - 12px;
    private property <bool> over-play:
        root.hovered && root.card.shows-play
        && hover-area.mouse-x >= 20px && hover-area.mouse-x <= 38px
        && hover-area.mouse-y >= root.play-top && hover-area.mouse-y <= root.play-top + 18px;

    /// 1 while the icon is loading, 0 after. A float because `visible` cannot be
    /// animated, and the image's opacity is already used for the saves' hover dim.
    private property <float> loading-fade: root.card.icon-loading ? 1.0 : 0.0;

    // The hover-revealed action column; the card routes clicks here by position.
    if root.column-shown: Rectangle {
        x: root.actions-left;
        y: 0;
        width: 14px;
        height: root.height;
        background: transparent;

        actions := VerticalLayout {
            padding-top: 12px;
            padding-bottom: 12px;
            alignment: space-between;

            ActionButton {
                kind: root.card.action-kind == "favorite" ? "heart" : "folder";
                favorited: root.card.favorited;
                shown: root.hovered;
                pointed: root.over-first;
                pressed: root.over-first && hover-area.pressed;
            }

            ActionButton {
                kind: root.card.action-kind == "favorite" ? "link" : "trash";
                shown: root.hovered;
                pointed: root.over-second;
                pressed: root.over-second && hover-area.pressed;
            }
        }
    }

    icon-box := Rectangle {
        x: 0;
        y: 0;
        width: root.icon-size;
        height: root.height;
        border-width: 2px;
        border-color: Theme.surface-0;
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
        clip: true;

        // The fade lives on a wrapper: the image's opacity is used for the
        // saves' hover dim. This is the complement of the spinner's fade, so one
        // value drives both and they cannot drift apart.
        icon-image := Rectangle {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            background: transparent;
            // Transparent while loading; the source is empty then anyway.
            opacity: 1.0 - root.loading-fade;
            animate opacity {
                duration: 200ms;
                easing: ease-out;
            }

            Image {
                width: 100%;
                height: 100%;
                source: root.card.icon;
                image-fit: ImageFit.fill;
                // Only saves (the "folder" subtitle) dim their icon on hover.
                opacity: root.hovered && root.subtitle-style == "folder" ? 0.4 : 1.0;
                animate opacity {
                    duration: 200ms;
                    easing: ease-out;
                }
            }
        }

        // The spinner sits in the same inner box as the image, over the empty
        // source. Not behind an `if`: that would remove it before it could fade
        // out, and `visible` (a `bool`) cannot animate. 24px fits the 72px box.
        spinner := Loading {
            x: 2px + (parent.width - 4px - self.width) / 2;
            y: 2px + (parent.height - 4px - self.height) / 2;
            size: 24px;
            stroke-width: 4;
            gap: 8;
            opacity: root.loading-fade;
            visible: root.loading-fade > 0.0;
            animate opacity {
                duration: 200ms;
                easing: ease-out;
            }
        }
    }

    info := Rectangle {
        // -8px pulls the block back over the image. Only the inset is animated:
        // `width` also follows the card, so animating it lags during a resize.
        private property <length> inset: root.info-inset;

        x: root.icon-size - 8px;
        y: 0;
        height: root.height;
        width: max(0px, root.width - root.icon-size - self.inset);
        background: root.hovered ? Theme.surface-1 : Theme.surface-0;
        border-radius: 8px;

        animate inset, background {
            duration: 200ms;
            easing: ease-out-quad;
        }

        info-layout := VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 0px;

            // The line box follows its own font. The strikethrough needs a `y`, and
            // a layout child may not set one, so both live in this wrapper.
            Rectangle {
                height: 14px;
                background: transparent;

                name := Text {
                    width: parent.width;
                    height: parent.height;
                    text: (root.card.mod-disabled ? ContentText.disabled-prefix : "")
                        + root.card.title;
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.default-text-color.transparentize(0.1);
                    overflow: elide;
                    vertical-alignment: center;
                }

                // `Text` has no decoration, so the strikethrough is a hairline
                // as wide as the drawn text, in the text's ink.
                if root.card.mod-disabled: Rectangle {
                    x: 0;
                    width: min(name.preferred-width, name.width);
                    height: 1px;
                    background: name.color;
                }
            }

            if root.card.has-subtitle: Text {
                text: root.card.subtitle;
                font-size: root.subtitle-style == "folder" ? 10px : 11px;
                // The 90% subtitle colour multiplies with the 90% body ink.
                color: Theme.default-text-color.transparentize(
                    root.subtitle-style == "folder" ? 0.4 : 0.1,
                );
                overflow: elide;
                vertical-alignment: center;
                height: root.subtitle-style == "folder" ? 18px : 15px;
            }

            if root.card.description != "": Text {
                text: root.card.description;
                font-size: 10px;
                color: Theme.default-text-color.transparentize(0.4);
                overflow: elide;
                vertical-alignment: center;
                height: 14px;
            }

            // The tags share one line box and carry their own margins.
            tags := HorizontalLayout {
                height: 16px;
                // The tags carry their own margins (see `TagChip`).
                spacing: 0px;
                cross-axis-alignment: center;

                for tag in root.card.tags: TagChip {
                    tag: tag;
                }
            }
        }
    }

    if root.card.shows-play: Rectangle {
        x: 20px;
        width: 18px;
        height: 18px;
        background: transparent;
        opacity: root.hovered ? 1.0 : 0.0;
        transform-scale: root.hovered ? 1.0 : 0.5;

        animate opacity, transform-scale {
            duration: 200ms;
            easing: ease-out-quad;
        }

        AppIcon {
            name: "play";
            size: 18px;
            // The play glyph is a fill, so this is its fill colour.
            icon-color: Theme.default-text-color.transparentize(0.1);
        }
    }

    // The saves' expansion: a selected save grows by 160px (upwards near the
    // window bottom), gains an outline and holds the world map. It is `visible`
    // rather than `if`, so its hover keeps the card hovered.
    expansion := Rectangle {
        private property <float> expanded: root.card.selected ? 1.0 : 0.0;

        visible: self.expanded > 0.0;
        x: 0;
        y: root.card.expand-up ? -160px * self.expanded : 0px;
        width: root.width;
        height: root.height + 160px * self.expanded;
        opacity: self.expanded;
        animate height, opacity, y {
            duration: 200ms;
            easing: ease;
        }
        background: Theme.surface-0;
        border-radius: 8px;
        // A 2px outline (a border is drawn inside the box).
        border-width: 2px;
        border-color: Theme.blue;

        // A click here only keeps the card hovered.
        expansion-touch := TouchArea { }

        // 8px of padding around the world map. One map exists at a time; tearing
        // it down drops its tiles, since the cache is keyed by world.
        if root.card.selected && GameState.has-current: WorldMap {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            folder-name: root.card.id;
            instance-id: GameState.current-id;
            // `0, 0` means no `spawn.pos`; Rust falls back to the world spawn.
            center-x: root.card.spawn-x;
            center-z: root.card.spawn-z;
            show-cursor-coords: true;
            cursor-coordinates-position: "bottom-center";
        }

        // The map's own hover counts too; `expansion-touch` is under it.
        out property <bool> pointed: expansion-touch.has-hover || WorldMapState.hovered;
    }
}
