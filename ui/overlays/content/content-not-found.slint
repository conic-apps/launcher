import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { Loading } from "../../components/controls/loading.slint";

// The "nothing here" placeholder and the loading spinner block.
//
// The placeholder springs in and fades out. A newly created element never plays
// an `animate`, so it shows a frame at the rest values first, like `Dialog`.
export component ContentNotFound inherits Rectangle {
    in property <bool> show: false;
    /// The failure variant: connectivity icon, message and error colour.
    in property <bool> failed: false;
    in property <string> description: "";
    callback retry;
    /// A definite height: a measured component collapses to nothing as a child
    /// of a column (see the note in `panels.slint`).
    in property <length> block-height: 150px;
    /// For call sites whose block is this content plus padding.
    out property <length> content-height: body.preferred-height;

    width: 100%;
    height: block-height;
    background: transparent;

    // "closed" | "starting" | "shown" | "leaving"
    private property <string> phase: "closed";
    visible: root.phase != "closed";
    private property <float> reveal: root.phase == "shown" ? 1.0 : 0.0;
    private property <float> spring: root.phase == "shown" ? 1.0 : 0.9;

    changed show => {
        if root.show {
            if root.phase == "closed" {
                root.phase = "starting";
                start-timer.restart();
            } else {
                root.phase = "shown";
            }
        } else if root.phase != "closed" && root.phase != "leaving" {
            root.phase = "leaving";
        }
    }

    start-timer := Timer {
        interval: 16ms;
        running: root.phase == "starting";
        triggered => { root.phase = "shown"; }
    }

    // The longer of the leave's two tracks.
    leave-timer := Timer {
        interval: 260ms;
        running: root.phase == "leaving";
        triggered => { root.phase = "closed"; }
    }

    init => {
        if root.show {
            root.phase = "shown";
        }
    }

    animate reveal {
        duration: root.phase == "shown" ? 350ms : 250ms;
        easing: root.phase == "shown"
            ? cubic-bezier(0.34, 1.56, 0.64, 1)
            : cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    animate spring {
        duration: root.phase == "shown" ? 350ms : 250ms;
        easing: root.phase == "shown"
            ? cubic-bezier(0.34, 1.56, 0.64, 1)
            : cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    body := Rectangle {
        width: 380px;
        height: self.preferred-height;
        background: transparent;
        opacity: root.reveal;
        transform-scale: root.spring;

        VerticalLayout {
            spacing: 12px;

            // A wrapper: cell alignment is a property of native elements only.
            Rectangle {
                height: 64px;
                background: transparent;

                AppIcon {
                    y: 0;
                    name: root.failed ? "cloud-offline-outline" : "about";
                    icon-color: root.failed
                        ? Theme.red
                        : Theme.default-text-color.transparentize(0.1);
                    size: 64px;
                }
            }

            Text {
                text: root.failed
                    ? @tr("Search failed, please try again")
                    : @tr("No results match the current filter");
                font-size: 16px;
                color: root.failed ? Theme.red : Theme.default-text-color.transparentize(0.1);
                horizontal-alignment: center;
                height: 16px;
            }

            if root.failed || root.description != "": Rectangle {
                height: description-label.preferred-height;
                background: transparent;

                description-label := Text {
                    // Wrapped at the block's 380px, with no height of its own.
                    text: root.failed ? @tr("Click here to retry") : root.description;
                    font-size: 12px;
                    color: Theme.default-text-color.transparentize(0.1);
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    width: parent.width;
                }
            }
        }

        // The whole failure body is the retry control; the empty state has none.
        if root.failed: TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.retry(); }
        }
    }
}

// The spinner block shown while the first response is in flight.
export component ContentLoading inherits Rectangle {
    width: 100%;
    height: 144px;
    background: transparent;

    VerticalLayout {
        width: 100%;
        padding-top: 40px;
        padding-bottom: 40px;
        // `alignment` would centre it vertically instead and leave it at the left.
        cross-axis-alignment: center;

        Rectangle {
            width: 64px;
            height: 64px;
            background: Theme.mantle;
            border-radius: 8px;

            Loading {
                size: 32px;
                stroke-width: 4;
                gap: 8;
            }
        }
    }
}
