// The README body of a project detail panel.
//
// The `markdown` crate draws it, because Slint 1.18 lacks CSS line-height,
// strikethrough, link-underline control, and runtime `@markdown`. The crate
// measures with Slint's text engine, lays out every run, and hands this
// component positioned boxes to paint.
//
// The crate lays out the content, so the 16px padding is applied here.

import { Theme } from "../../theme.slint";
import { Icons } from "../../icons.slint";
import { ContentState } from "../../globals/content.slint";
import { MarkdownView } from "../../components/markdown/markdown-view.slint";

export component MarkdownBody inherits Rectangle {
    /// The scroller's offset, passed in because this box cannot reach it.
    in property <length> scroll-y: 0px;
    /// This box's position in the scrolled content; the view culls from its own
    /// top, so without it everything above this box would be culled.
    in property <length> top-in-scroll: 0px;
    /// The scroller's height, not this box's (which is the document height and
    /// would cull nothing).
    in property <length> viewport-height: 0px;
    /// 16px of padding, stated once for the height, the view box and culling.
    private property <length> inset: 16px;

    width: 100%;
    // Must be stated: all-positioned children measure zero. The view's shown
    // height, not the engine's, so closed `<details>` do not leave a scrollable
    // empty band.
    height: view.shown-height + 2 * root.inset;
    background: Theme.surface-0;
    border-radius: 8px;

    // A wheel scroll emits no pointer-move, so a link that moved out from under
    // the pointer would keep its hover. Clear it on scroll, as the browser does.
    changed scroll-y => { ContentState.detail-body-hovered = ""; }

    view := MarkdownView {
        x: root.inset;
        y: root.inset;
        width: parent.width - 2 * root.inset;
        height: parent.height - 2 * root.inset;
        chunks: ContentState.detail-body-chunks;
        section-open: ContentState.detail-body-section-open;
        // The crate has no icon set, so this is path data. `chevron-forward` is
        // rotated a quarter turn when the section opens.
        marker-icon: {
            commands: Icons.stroke-commands("chevron-forward"),
            viewbox: Icons.viewbox("chevron-forward"),
            stroke-width: Icons.stroke-width("chevron-forward"),
        };
        family: Theme.font-family;
        // The family the engine shaped the code with; a generic name would use the
        // wrong face and advances.
        mono-family: ContentState.detail-body-mono-family;
        // Skip off-screen items so a long README does not create a `Text` per line.
        viewport-y: root.scroll-y - root.top-in-scroll;
        viewport-height: root.viewport-height;
        cull: true;
        // Two-way because the view assigns it; a one-way binding would be dropped.
        hovered-link <=> ContentState.detail-body-hovered;
        // Open the href rather than navigating the app away.
        link-clicked(url) => { ContentState.open-url(url); }
        // The engine must hear about width changes or the document never re-wraps.
        resized(width) => { ContentState.body-resized(width); }
        section-toggled(id) => { ContentState.body-section-toggled(id); }
        // Bound rather than baked into items, so a palette change repaints without
        // rebuilding the display list.
        palette: {
            text: Theme.text,
            heading: Theme.text,
            link: Theme.blue,
            code-text: Theme.text,
            code-background: Theme.surface-1,
            code-block-text: Theme.text,
            code-block-background: Theme.mantle,
            quote-text: Theme.overlay-2,
            quote-bar: Theme.surface-1,
            table-border: Theme.surface-1,
            table-head-text: Theme.text,
            table-head-background: Theme.mantle,
            rule: Theme.surface-1,
            // Keep the text colour, not GitHub's red.
            strike: Theme.text,
            // Bullets and broken-image alt text keep the text colour.
            marker: Theme.text,
            placeholder: Theme.text,
            // Drawn like `SettingItem`, so it does not read as an unstyled leftover.
            details-head: Theme.setting-item-background,
            details-head-hover: Theme.setting-item-background-hover,
            details-head-active: Theme.setting-item-background-active,
            details-marker: Theme.default-text-color.transparentize(0.1),
        };
    }
}
