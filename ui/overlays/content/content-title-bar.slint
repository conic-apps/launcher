import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";

// A source switcher button: tinted by its source, `surface2` while active.
component SourceButton inherits Rectangle {
    in property <string> source: "";
    in property <bool> active: false;
    callback clicked;

    width: 40px;
    height: 32px;
    border-radius: 4px;
    background: touch.pressed ? Theme.surface-1
        : touch.has-hover ? Theme.surface-0
        : (root.active ? Theme.surface-2 : transparent);

    private property <color> tint:
        !root.active ? Theme.default-text-color.transparentize(0.3)
        : root.source == "local" ? Theme.blue
        : root.source == "modrinth" ? Theme.green
        : Theme.peach;

    AppIcon {
        name: root.source == "local" ? "file-tray-full-outline"
            : root.source == "modrinth" ? "modrinth"
            : "curseforge";
        // Modrinth's 593-unit view box reads larger than the 512-unit icons.
        size: root.source == "modrinth" ? 18px : 24px;
        icon-color: root.tint;
    }

    // The active button ignores the pointer entirely: hovering or pressing it
    // would otherwise shade it back to surface-0/1 over its surface-2 state.
    touch := TouchArea {
        enabled: !root.active;
        clicked => { root.clicked(); }
    }
}

export component ContentTitleBar inherits Rectangle {
    in property <string> icon: "";
    in property <length> icon-size: 20px;
    in property <string> title: "";
    /// Only the saves panel sets a gap below the bar.
    in property <length> title-gap: 0px;
    /// Empty for a single-source panel; otherwise "local", "modrinth",
    /// "curseforge".
    in property <[string]> sources: [];
    in property <string> active-source: "";

    callback source-selected(string);

    width: 100%;
    height: 52px + title-gap;
    background: transparent;

    bar := Rectangle {
        // Pinned to the top: a centered child would split `title-gap` above and
        // below, but the gap belongs below the bar.
        x: 0;
        y: 0;
        width: parent.width;
        height: 52px;
        background: Theme.mantle;
        clip: true;

        // The title takes what the buttons leave; the spacer pushes them right.
        HorizontalLayout {
            padding-left: 32px;
            padding-right: 32px;
            spacing: 8px;
            cross-axis-alignment: center;

            AppIcon {
                name: root.icon;
                size: root.icon-size;
            }

            Text {
                text: root.title;
                font-size: 16px;
                color: Theme.default-text-color.transparentize(0.1);
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            switcher := HorizontalLayout {
                // Without an explicit width a layout takes its parent's, which
                // would run the buttons back over the title.
                height: 32px;
                vertical-stretch: 0;
                spacing: 4px;

                for source in root.sources: SourceButton {
                    source: source;
                    active: source == root.active-source;
                    clicked => { root.source-selected(source); }
                }
            }
        }
    }
}
