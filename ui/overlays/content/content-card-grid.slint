import {
    ContentCard as CardData,
    ContentState,
} from "../../globals/content.slint";
import { ContentCard } from "content-card.slint";

// The card grid, shared by all nine lists. Slint has no wrapping grid, so Rust
// computes the columns from the panel width and places every card; this is the
// `for` that draws them.
export component ContentCardGrid inherits Rectangle {
    in property <[CardData]> cards: [];
    /// 72px for the content lists, 64px for the saves.
    in property <length> icon-size: 72px;
    in property <string> subtitle-style: "authors";
    /// Rust's rows × row height plus padding. It must be given: absolutely
    /// positioned children measure zero, so the `ScrollView` would not scroll.
    in property <length> grid-height: 0px;

    callback select(string);
    callback open-path(string);
    /// Carries the title too: the save id is the folder, not the name shown in
    /// `ConfirmDeleteSave`.
    callback delete(string, string);
    callback toggle-favorite(string);
    callback open-link(string);
    callback play(string);

    width: 100%;
    height: root.grid-height;
    background: transparent;

    // The visible cards live inside this padding.
    grid := Rectangle {
        x: 32px;
        y: 16px;
        width: max(0px, parent.width - 64px);
        height: root.grid-height;
        background: transparent;

        for card in root.cards: ContentCard {
            card: card;
            icon-size: root.icon-size;
            subtitle-style: root.subtitle-style;
            select => { root.select(card.id); }
            open-path => { root.open-path(card.id); }
            delete => { root.delete(card.id, card.title); }
            toggle-favorite => { root.toggle-favorite(card.id); }
            open-link => { root.open-link(card.link); }
            play => { root.play(card.id); }
        }
    }
}
