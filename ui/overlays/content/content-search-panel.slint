import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import {
    ContentSearch,
    ContentState,
    ContentText,
    FilterChip,
    FilterRow,
} from "../../globals/content.slint";
component ChipPager inherits Rectangle {
    in property <bool> flipped: false;
    in property <bool> disabled: false;
    callback clicked;

    width: 26px;
    height: 26px;
    border-width: 1px;
    border-color: Theme.surface-1;
    border-radius: 999px;
    background: touch.has-hover && !root.disabled ? Theme.surface-1 : Theme.surface-0;
    opacity: root.disabled ? 0.4 : 1.0;

    AppIcon {
        name: "chevron-forward";
        size: 12px;
        icon-color: Theme.default-text-color.transparentize(0.1);
        transform-rotation: root.flipped ? 180deg : 0deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

component FilterChipView inherits Rectangle {
    in property <FilterChip> chip;
    /// Repeated-element geometry is unreadable outside, so each chip reports its
    /// width. The wrapping rows ignore this.
    callback measured(length);

    height: 20px;
    // Explicitly from the label: the component's own `preferred-width` was zero.
    width: label.preferred-width + 16px;
    border-radius: 999px;
    background: !root.chip.selected ? (touch.pressed ? Theme.surface-2
        : touch.has-hover ? Theme.surface-1 : transparent)
        : root.chip.accent == "fabric" ? Theme.yellow
        : root.chip.accent == "forge" ? Theme.blue
        : root.chip.accent == "neoforge" ? Theme.peach
        : root.chip.accent == "quilt" ? Theme.mauve
        : root.chip.accent == "minecraft-version" ? Theme.green
        : root.chip.accent == "favorites" ? Theme.yellow
        : Theme.lavender;

    // Hover-in is instant, hover-out eased; press and selection ease both ways.
    animate background {
        duration: touch.has-hover && !touch.pressed && !root.chip.selected ? 0ms : 120ms;
        easing: ease-out;
    }

    label := Text {
        width: self.preferred-width;
        // Resolved here rather than in Rust, so it follows a language change.
        text: root.chip.translated
            ? ContentText.chip-label(ContentState.remote-kind, ContentState.source, root.chip.label-key)
            : root.chip.text;
        font-size: 12px;
        x: 8px;
        color: root.chip.selected ? Theme.text-inverse : Theme.default-text-color.transparentize(0.1);
    }

    touch := TouchArea {
        clicked => { ContentSearch.chip-clicked(root.chip.value); }
    }

    // `changed` does not fire for the initial value, hence both.
    init => { root.measured(root.width); }
    changed width => { root.measured(root.width); }
}

component VersionCarousel inherits Rectangle {
    in property <[FilterChip]> chips: [];

    height: 26px;
    background: transparent;

    private property <int> page: ContentSearch.version-page;

    HorizontalLayout {
        spacing: 6px;
        // Centring is on the cross axis: a non-default main-axis alignment would
        // drop `horizontal-stretch` and collapse the viewport to zero.
        cross-axis-alignment: center;

        ChipPager {
            flipped: true;
            disabled: root.page <= 0;
            clicked => { ContentSearch.version-page-prev(); }
        }

        viewport := Rectangle {
            horizontal-stretch: 1;
            height: parent.height;
            clip: true;
            background: transparent;

            // The whole track is drawn and clipped. Rust computes the offset from
            // the widths the chips report. A plain `Rectangle` is needed because a
            // layout child's `x` belongs to its layout.
            track := HorizontalLayout {
                x: -ContentSearch.version-offset;
                y: 0;
                width: self.preferred-width;
                height: parent.height;
                spacing: 6px;
                cross-axis-alignment: center;

                for chip in root.chips: FilterChipView {
                    chip: chip;
                    measured(width) => { ContentSearch.chip-measured(chip.value, width); }
                }

                // `animate` cannot reach into a sibling, so it lives here.
                animate x {
                    duration: 240ms;
                    easing: ease-out-quad;
                }
            }
        }

        ChipPager {
            disabled: root.page >= max(0, ContentSearch.version-page-count - 1);
            clicked => { ContentSearch.version-page-next(); }
        }
    }
}

// The remote lists' search and filter header. The loader and category rows wrap
// in a `FlexboxLayout`; the version row is paginated by translating a clipped
// track, using chip widths reported from inside the `for`.
component FilterRowView inherits Rectangle {
    in property <FilterRow> row-data;
    in property <bool> is-version-row: false;

    width: 100%;
    height: root.row-data.height;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        // The cross axis stays `stretch`: a wrapping `FlexboxLayout` reports a
        // preferred height measured at a roughly square width, about twice the
        // lines it draws. Stretched, it takes the height Rust computed.

        Text {
            text: ContentText.row-label(root.row-data.label);
            font-size: 12px;
            color: Theme.subtext-0;
            min-width: 52px;
            horizontal-alignment: left;
            vertical-alignment: center;
            height: 20px;
        }

        if root.is-version-row: VersionCarousel {
            horizontal-stretch: 1;
            // The carousel draws the whole track, not a page of `FilterRow` chips.
            chips: ContentSearch.version-chips;
        }

        if !root.is-version-row: FlexboxLayout {
            horizontal-stretch: 1;
            flex-wrap: wrap;
            spacing: 6px;

            for chip in root.row-data.chips: FilterChipView {
                chip: chip;
                // Rust computes the row height from these, since a wrapping
                // `FlexboxLayout` cannot measure itself at its given width.
                measured(width) => { ContentSearch.chip-measured(chip.value, width); }
            }
        }
    }
}

export component ContentSearchPanel inherits Rectangle {
    width: 100%;
    // A layout has no margin, so the 16px gap below is outside the panel's fill.
    height: panel-content.preferred-height + 16px;
    background: Colors.transparent;

    panel := Rectangle {
        // Pinned to the top: centring would split the 16px above and below,
        // but the gap belongs below, against the grid.
        x: 0;
        y: 0;
        width: 100%;
        height: panel-content.preferred-height;
        // No backdrop blur in Slint 1.18, so the panel is translucent only.
        background: Theme.crust.with-alpha(0.92);

        panel-content := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                height: 36px;
                spacing: 8px;

                search-field := Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    border-radius: 8px;
                    background: field-touch.has-hover ? Theme.surface-1 : Theme.surface-0;

                    input := TextInput {
                        x: 12px;
                        y: 0;
                        width: parent.width - 24px;
                        height: parent.height;
                        text <=> ContentSearch.query;
                        font-size: 13px;
                        color: Theme.default-text-color.transparentize(0.1);
                        selection-background-color: Theme.default-text-color.with-alpha(0.3);
                        selection-foreground-color: Theme.default-text-color;
                        single-line: true;
                        vertical-alignment: center;
                        // Enter commits the query, which is already bound as typed.
                        accepted => { ContentSearch.search(); }
                    }

                    if ContentSearch.query == "": Text {
                        text: ContentText.search-placeholder(ContentState.remote-kind);
                        font-size: 13px;
                        color: Theme.subtext-0;
                        x: 12px;
                    }

                    field-touch := TouchArea {
                        // The area sits over the input to give the field its
                        // hover fill, so it must hand focus over explicitly.
                        clicked => { input.focus(); }
                    }
                }

                search-button := Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 8px;
                    background: button-touch.pressed ? Theme.lavender
                        : button-touch.has-hover ? Theme.surface-1
                        : Theme.surface-0;

                    AppIcon {
                        name: "search";
                        size: 16px;
                        icon-color: button-touch.pressed
                            ? Theme.text-inverse
                            : Theme.default-text-color.transparentize(0.1);
                    }

                    button-touch := TouchArea {
                        clicked => { ContentSearch.search(); }
                    }
                }
            }

            VerticalLayout {
                spacing: 8px;

                for filter-row[index] in ContentSearch.filters: FilterRowView {
                    row-data: filter-row;
                    is-version-row: index == ContentSearch.version-row;
                }
            }
        }
    }
}
