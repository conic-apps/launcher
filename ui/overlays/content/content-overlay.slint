import { Theme } from "../../theme.slint";

// The content overlays' shared shell: a full-window scrim and a sliding
// container. The screenshots viewer spans the window with only the scrim fading.
//
// Only `y` moves: `opacity` or `transform` on the panel would put the subtree in
// a render layer, and the renderer gives up above 8192px. The scrim fade lives
// in its background colour. The scrim does not drag the window; a press closes.
//
// Showing one frame at the start value is what makes the entrance play: a hidden
// element is never painted, so an unread animated property snaps to its target.
export component ContentOverlay inherits Rectangle {
    in property <bool> overlay-visible: false;
    /// How much of the window width the container leaves free — 150px, or 200px
    /// for the instance-settings panel.
    in property <length> panel-inset: 150px;
    /// False for the screenshots viewer, which has no sliding container.
    in property <bool> slide: true;
    /// The container's fill. A colour, or a mixed brush (the panels tint it with
    /// their accent at a weaker ratio than their title bar).
    in property <brush> panel-background: Theme.base;

    /// The container's size. Children written between the braces have the game
    /// view as `parent`, so anything sizing against the container reads these.
    out property <length> panel-width: max(0px, root.width - root.panel-inset);
    out property <length> panel-height: root.height;

    /// A click landed on the scrim, or Escape was pressed.
    callback closed;

    width: 100%;
    height: 100%;
    // The container travels up from below; clipping hides the part not arrived.
    clip: true;
    // Alpha lives in the colour, not an element `opacity`, which would create a
    // render layer for the whole panel.
    background: #000000.with-alpha(0.502 * root.scrim-alpha);

    // "closed" | "starting" | "shown" | "leaving" — `Dialog`'s machine.
    private property <string> phase: "closed";
    visible: root.phase != "closed";

    // What the animated bindings read, one frame behind `phase`: Slint drops the
    // first of two same-frame changes, so a fast close/reopen would make the
    // panel jump. The timer means a frame only sees the latest state.
    private property <string> settled: "closed";
    // `running` must be an owned property: a constant-bound timer cannot be
    // started by `restart()`, leaving the overlay parked below the window.
    private property <bool> settling: false;
    changed phase => { root.settling = true; }
    settle-timer := Timer {
        interval: 16ms;
        running: root.settling;
        triggered => {
            root.settled = root.phase;
            root.settling = false;
        }
    }

    changed overlay-visible => {
        if root.overlay-visible {
            if root.phase != "shown" {
                // Play the entrance from wherever the panel is, so an
                // interrupted leave carries on from its offset.
                root.phase = "starting";
                start-timer.restart();
            }
        } else if root.phase != "closed" && root.phase != "leaving" {
            root.phase = "leaving";
        }
    }

    // One frame at the start values, so the renderer sees them before the
    // container is asked to move.
    start-timer := Timer {
        interval: 16ms;
        running: root.phase == "starting";
        triggered => { root.phase = "shown"; }
    }

    // The longest of the leave's two tracks (280ms slide, 100 + 200ms scrim).
    leave-timer := Timer {
        interval: 300ms;
        running: root.phase == "leaving";
        triggered => { root.phase = "closed"; }
    }

    init => {
        // `changed` does not fire for the value a component is created with.
        if root.overlay-visible {
            root.phase = "shown";
            root.settled = "shown";
        }
    }

    // The container's offset: the window height while parked, 0 once arrived.
    // Each transition moves it, so the 400ms/280ms pair applies per direction.
    private property <length> panel-y:
        root.settled == "shown" || root.settled == "starting" ? 0px : root.height;
    private property <bool> leaving: root.settled == "leaving";

    animate panel-y {
        duration: root.leaving ? 280ms : 400ms;
        easing: root.leaving ? cubic-bezier(0.47, 0, 1, 0.75) : cubic-bezier(0, 0.47, 0.25, 1);
    }

    private property <float> scrim-alpha: root.settled == "shown" ? 1.0 : 0.0;
    animate scrim-alpha {
        duration: 200ms;
        delay: root.leaving ? 100ms : 0ms;
        easing: ease-out-quad;
    }

    scrim-touch := TouchArea {
        clicked => { root.closed(); }
        // Take the wheel, or it falls through to the instance list behind.
        scroll-event(event) => { accept }
    }

    container := Rectangle {
        // A plain `Rectangle`, because a layout owns its children's `y` and this
        // one is animated. The screenshots viewer keeps it at 0.
        y: root.slide ? root.panel-y : 0px;
        width: root.panel-width;
        height: root.panel-height;
        background: root.panel-background;

        // Stops a press on the panel reaching the scrim and closing it. Declared
        // before the content so the controls still get their own clicks.
        swallow := TouchArea { }

        // A plain `Rectangle`, not a layout: children written between the braces
        // get the game view as `parent`, so a layout would size them against the
        // wrong box. This is why `panel-width`/`panel-height` are exposed.
        content := Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: transparent;
            @children
        }
    }
}
