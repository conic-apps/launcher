import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { Loading } from "../../components/controls/loading.slint";
import { Progress } from "../../components/controls/progress.slint";
import { ContentState, ContentText } from "../../globals/content.slint";
import { ScrollView } from "../../components/containers/scroll-view.slint";
import {
    ScrollViewHorizontal,
} from "../../components/containers/scroll-view-horizontal.slint";
import { ContentOverlay } from "content-overlay.slint";
import { ContentTitleBar } from "content-title-bar.slint";
import { MarkdownBody } from "markdown-body.slint";
component MetadataEntry inherits Rectangle {
    in property <string> icon: "";
    in property <string> text: "";
    in property <bool> link: false;
    /// A hairline inside the entry plus its 13px offset, giving 25px between
    /// entries with the row's 12px gap.
    in property <bool> divider: false;
    callback clicked;

    // From the inner layout: all-positioned children measure zero, so a bare
    // `self.preferred-width` was 0 and every entry stacked at the same place.
    width: entry.preferred-width + (root.divider ? 13px : 0px);
    height: 20px;
    background: transparent;

    if root.divider: Rectangle {
        x: 0;
        width: 1px;
        height: 16px;
        background: Theme.overlay-2;
    }

    entry := HorizontalLayout {
        x: root.divider ? 13px : 0px;
        height: parent.height;
        spacing: 4px;
        alignment: center;

        AppIcon {
            name: root.icon;
            size: 20px;
            icon-color: Theme.mauve;
        }

        Text {
            text: root.text;
            font-size: 14px;
            color: root.link ? Theme.blue : Theme.default-text-color.transparentize(0.1);
            vertical-alignment: center;
            height: 20px;
        }
    }

    if root.link: TouchArea {
        clicked => { root.clicked(); }
    }
}

component DetailButton inherits Rectangle {
    in property <string> kind: "download";
    in property <string> label: "";
    in property <bool> favorited: false;
    in property <bool> on: true;
    callback clicked;

    height: 36px;
    border-radius: 6px;
    opacity: root.on ? 1.0 : 0.6;
    // Remove is surface0 with a red outline; the rest are Latte teal.
    background: root.kind == "remove" ? Theme.surface-0 : Theme.latte-teal;
    border-width: root.kind == "remove" ? 1px : 0px;
    border-color: Theme.red;

    private property <color> ink:
        root.kind == "remove"
        ? (touch.has-hover ? Theme.red : white)
        : root.kind == "heart" && root.favorited ? Theme.red : white;

    HorizontalLayout {
        // The row fills the button so the glyph and label centre as one run.
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        spacing: 4px;
        alignment: center;
        // `alignment` is the main axis; without this the glyph sits at the top.
        cross-axis-alignment: center;

        if root.kind == "heart": AppIcon {
            // The glyph inside the view box is smaller, so 16px looks too small.
            name: root.favorited ? "heart" : "heart-outline";
            size: 20px;
            icon-color: root.ink;
        }

        if root.label != "": Text {
            text: root.label;
            font-size: 14px;
            color: root.ink;
            vertical-alignment: center;
        }

        if root.kind == "download": AppIcon {
            name: "download";
            size: 20px;
            icon-color: root.ink;
        }

        if root.kind == "remove": AppIcon {
            name: "trash";
            size: 20px;
            icon-color: root.ink;
        }
    }

    touch := TouchArea {
        enabled: root.on;
        clicked => { root.clicked(); }
    }
}

// The six detail panels share one header, action row and body, differing only in
// the API that fills them and two conditionals (remove button, gallery), all
// carried by `ContentState`.
component DetailBody inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // Named so the body can read its scroll offset and cull hidden items.
    scroller := ScrollView {
        details-column := VerticalLayout {
            ContentTitleBar {
                // Packs use a package glyph; mods and resource packs a puzzle.
                icon: ContentState.remote-kind == "packs" ? "package" : "extension-puzzle";
                title: ContentText.detail-title(ContentState.remote-kind);
            }

            // 40px above and below the spinner. The list panels use
            // `ContentLoading` instead.
            if ContentState.detail-loading: Rectangle {
                width: 100%;
                height: 112px;
                background: transparent;

                Loading {
                    y: 40px;
                    size: 32px;

                    stroke-width: 4;
                    gap: 8;
                }
            }

            if !ContentState.detail-loading: Rectangle {
                width: 100%;
                height: self.preferred-height;
                background: transparent;

                details-inner := VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 16px;

                    HorizontalLayout {
                        height: self.preferred-height;
                        spacing: 16px;

                        Rectangle {
                            width: 88px;
                            height: 88px;
                            border-radius: 12px;
                            clip: true;
                            background: Theme.surface-0;

                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: ContentState.detail-icon;
                                image-fit: cover;
                            }
                        }

                        // The lines are centred against the 88px icon.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            spacing: 8px;
                            alignment: center;

                            if ContentState.detail-title != "": Text {
                                text: ContentState.detail-title;
                                font-size: 24px;
                                font-weight: 600;
                                color: Theme.default-text-color.transparentize(0.1);
                                height: 24px;
                                vertical-alignment: center;
                            }

                            metadata := FlexboxLayout {
                                flex-wrap: wrap;
                                height: 20px;
                                spacing: 12px;
                                cross-axis-alignment: center;

                                if ContentState.detail-source != "": MetadataEntry {
                                    icon: ContentState.detail-source-is-github ? "github" : "code-slash-outline";
                                    text: ContentState.detail-source-label;
                                    link: true;
                                    clicked => { ContentState.open-url(ContentState.detail-source); }
                                }

                                MetadataEntry {
                                    icon: "download";
                                    text: ContentState.detail-downloads;
                                    // The divider belongs after the previous entry.
                                    divider: ContentState.detail-source != "";
                                }

                                if ContentState.detail-has-followers: MetadataEntry {
                                    icon: "heart-outline";
                                    text: ContentState.detail-followers;
                                    divider: true;
                                }
                            }

                            // Wraps with no set height, unlike the card's one line.
                            if ContentState.detail-description != "": Text {
                                text: ContentState.detail-description;
                                font-size: 14px;
                                color: Theme.default-text-color.transparentize(0.1);
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        alignment: start;

                        DetailButton {
                            kind: "heart";
                            label: "";
                            width: 36px;
                            favorited: ContentState.detail-favorited;
                            on: true;
                            clicked => { ContentState.toggle-favorite(ContentState.detail-id); }
                        }

                        // checking → spinner, installed → remove, else → download.
                        if ContentState.detail-can-remove && ContentState.detail-checking-installed: Rectangle {
                            width: 120px;
                            height: 36px;
                            border-radius: 6px;
                            background: Theme.latte-teal;
                            opacity: 0.6;

                            Loading {
                                size: 18px;
                                stroke-width: 6;
                                icon-color: white;
                            }
                        }

                        if ContentState.detail-can-remove
                            && !ContentState.detail-checking-installed
                            && ContentState.detail-installed: DetailButton {
                            kind: "remove";
                            label: @tr("Remove");
                            width: 120px;
                            on: !ContentState.detail-operating;
                            clicked => { ContentState.remove(); }
                        }

                        if (!ContentState.detail-can-remove
                            || !ContentState.detail-checking-installed)
                            && !ContentState.detail-installed: DetailButton {
                            kind: "download";
                            label: @tr("Download");
                            width: 120px;
                            on: !ContentState.detail-operating;
                            clicked => { ContentState.download(); }
                        }

                        if ContentState.detail-operating && ContentState.detail-progress-max > 0: VerticalLayout {
                            width: 160px;
                            height: 36px;
                            alignment: center;
                            spacing: 4px;

                            Text {
                                text: ContentState.detail-progress-text;
                                font-size: 12px;
                                color: Theme.subtext-1;
                                horizontal-alignment: center;
                            }

                            Progress {
                                width: 100%;
                                loading: false;
                                value: ContentState.detail-progress;
                                max: ContentState.detail-progress-max;
                            }
                        }

                        if ContentState.detail-installed-version != "": Text {
                            text: @tr("Installed: {}", ContentState.detail-installed-version);
                            font-size: 13px;
                            font-italic: true;
                            color: Theme.subtext-1;
                            opacity: 0.6;
                            vertical-alignment: center;
                            height: 36px;
                            horizontal-alignment: left;
                        }
                    }

                    // An empty body still draws the box when `body-always` is set.
                    if ContentState.detail-body != "" || ContentState.detail-body-always: markdown-body := MarkdownBody {
                        // The body is a grandchild of the scroller, so the offset
                        // and height are passed down.
                        scroll-y: scroller.content-y;
                        viewport-height: scroller.height;
                        // The body culls from its own top, so it needs its position
                        // inside the scrolled content or it would cull the header
                        // above it.
                        top-in-scroll: details-column.y
                            + details-inner.y
                            + markdown-body.y;
                    }

                    if ContentState.detail-gallery.length > 0: Rectangle {
                        width: 100%;
                        height: 252px;
                        background: Theme.surface-0;
                        border-radius: 8px;

                        // 8px inside the 16px padding, so items start 24px in. The
                        // box clips, hence the horizontal scroller.
                        gallery-scroll := ScrollViewHorizontal {
                            x: 24px;
                            y: 16px;
                            width: parent.width - 48px;
                            height: parent.height - 32px;
                            scrollbar-left: 8px;
                            scrollbar-right: 8px;

                            HorizontalLayout {
                                spacing: 12px;
                                cross-axis-alignment: center;

                                for shot in ContentState.detail-gallery: Rectangle {
                                    width: shot.ratio * 204px;
                                    height: 204px;
                                    border-radius: 8px;
                                    clip: true;
                                    background: transparent;

                                    Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: shot.image;
                                        image-fit: cover;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component DetailPanels inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    ContentOverlay {
        overlay-visible: ContentState.open-detail != "";
        panel-background: Theme.base;
        closed => { ContentState.close-detail(); }

        DetailBody { }
    }
}
