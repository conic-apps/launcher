import { Theme } from "../../graphics/theme.slint";
import { AppIcon } from "../../graphics/display/app-icon.slint";
import { Loading } from "../../graphics/controls/loading.slint";
import { Progress } from "../../graphics/controls/progress.slint";
import { TooltipArea } from "../../graphics/controls/tooltip-area.slint";
import { PillFace } from "../../graphics/display/pill-face.slint";
import { ContentState, ContentText } from "../../globals/content.slint";
import { TaskState } from "../../globals/tasks.slint";
import { ScrollView } from "../../graphics/containers/scroll-view.slint";
import {
    ScrollViewHorizontal,
} from "../../graphics/containers/scroll-view-horizontal.slint";
import { OverlayPanel } from "../shell/overlay-panel.slint";
import { HeaderBar } from "../../graphics/display/header-bar.slint";
import { MarkdownBody } from "components/markdown-body.slint";

component MetadataEntry inherits Rectangle {
    in property <string> icon: "";
    in property <string> text: "";
    in property <bool> link: false;
    /// A hairline inside the entry plus its 13px offset, giving 25px between
    /// entries with the row's 12px gap.
    in property <bool> divider: false;
    callback clicked;

    // From the inner layout: all-positioned children measure zero, so a bare
    // `self.preferred-width` was 0 and every entry stacked at the same place.
    width: entry.preferred-width + (root.divider ? 13px : 0px);
    height: 20px;
    background: transparent;

    if root.divider: Rectangle {
        x: 0;
        width: 1px;
        height: 16px;
        background: Theme.overlay-2;
    }

    entry := HorizontalLayout {
        x: root.divider ? 13px : 0px;
        height: parent.height;
        spacing: 4px;
        alignment: center;

        AppIcon {
            name: root.icon;
            size: 20px;
            icon-color: Theme.mauve;
        }

        Text {
            text: root.text;
            font-size: 14px;
            color: root.link ? Theme.blue : Theme.default-text-color.transparentize(0.1);
            vertical-alignment: center;
            height: 20px;
        }
    }

    if root.link: TouchArea {
        clicked => { root.clicked(); }
    }
}

// The detail row's action: one pill whose fill and face say what a click does.
//
// The states cross-fade rather than swap, because stopping a download is a
// different intent from starting one, and the width eases to the face on show so
// a longer translation widens the pill instead of being elided.
component DetailPill inherits Rectangle {
    /// "download" | "cancel" | "installed"
    in property <string> kind: "download";
    callback clicked;

    // An installed project's pill stays green and done until the pointer is on
    // it, and only then says what a click would do: take it away again. A
    // destructive action should not be the resting state of a finished download.
    private property <bool> removing: root.kind == "installed" && touch.has-hover;
    // Tighter than the launch button's 24px: this row also carries the heart and
    // the progress, so the pill gives the label less air than the game view's.
    private property <length> face-padding: 20px;

    // An installed pill keeps the wider of its two faces so hovering can never
    // shrink it out from under the pointer and start a hover flicker.
    width: root.kind == "installed" ? max(installed-pill.pill-width, remove-pill.pill-width)
        : root.kind == "cancel" ? cancel-pill.pill-width
        : download-pill.pill-width;
    height: 40px;
    border-radius: 10000px;
    background: root.kind == "cancel" ? Theme.mauve
        : root.removing ? Theme.red
        : root.kind == "installed" ? Theme.green
        : Theme.blue;
    opacity: touch.pressed ? 0.9 : 1.0;
    clip: true;
    animate width, background, opacity {
        duration: 200ms;
        easing: ease;
    }

    download-face := Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        opacity: root.kind == "download" ? 1.0 : 0.0;
        animate opacity {
            duration: 120ms;
            easing: ease-out-quad;
        }

        download-pill := PillFace {
            icon: "download";
            side-padding: root.face-padding;
            text: @tr("Download");
        }
    }

    cancel-face := Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        opacity: root.kind == "cancel" ? 1.0 : 0.0;
        animate opacity {
            duration: 120ms;
            easing: ease-out-quad;
        }

        cancel-pill := PillFace {
            icon: "xmark";
            icon-size: 18px;
            side-padding: root.face-padding;
            text: @tr("Cancel");
        }
    }

    installed-face := Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        opacity: root.kind == "installed" && !root.removing ? 1.0 : 0.0;
        animate opacity {
            duration: 120ms;
            easing: ease-out-quad;
        }

        installed-pill := PillFace {
            icon: "checkmark-outline";
            icon-size: 22px;
            side-padding: root.face-padding;
            text: @tr("Downloaded");
        }
    }

    remove-face := Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        opacity: root.removing ? 1.0 : 0.0;
        animate opacity {
            duration: 120ms;
            easing: ease-out-quad;
        }

        remove-pill := PillFace {
            icon: "trash";
            side-padding: root.face-padding;
            text: @tr("Remove");
        }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

// The six detail panels share one header, action row and body, differing only in
// the API that fills them and two conditionals (remove button, gallery), all
// carried by `ContentState`.
component DetailBody inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // What the pill does next: still asking the disk → a spinner; a download
    // running → cancel; installed → done, removing on hover; otherwise →
    // download. A pack has no installed state at all, so it only ever downloads
    // or cancels.
    private property <string> action: ContentState.detail-can-remove
        && ContentState.detail-checking-installed ? "checking"
        : ContentState.detail-operating ? "cancel"
        : ContentState.detail-can-remove && ContentState.detail-installed ? "installed"
        : "download";

    // Named so the body can read its scroll offset and cull hidden items.
    scroller := ScrollView {
        details-column := VerticalLayout {
            HeaderBar {
                // Packs use a package glyph; mods and resource packs a puzzle.
                icon: ContentState.remote-kind == "packs" ? "package" : "extension-puzzle";
                title: ContentText.detail-title(ContentState.remote-kind);
            }

            // 40px above and below the spinner. The list panels use
            // `LoadingState` instead.
            if ContentState.detail-loading: Rectangle {
                width: 100%;
                height: 112px;
                background: transparent;

                Loading {
                    y: 40px;
                    size: 32px;

                    stroke-width: 4;
                    gap: 8;
                }
            }

            if !ContentState.detail-loading: Rectangle {
                width: 100%;
                height: self.preferred-height;
                background: transparent;

                details-inner := VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 16px;

                    HorizontalLayout {
                        height: self.preferred-height;
                        spacing: 16px;

                        Rectangle {
                            width: 88px;
                            height: 88px;
                            border-radius: 12px;
                            clip: true;
                            background: Theme.surface-0;

                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: ContentState.detail-icon;
                                image-fit: cover;
                            }
                        }

                        // The lines are centred against the 88px icon.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            spacing: 8px;
                            alignment: center;

                            if ContentState.detail-title != "": Text {
                                text: ContentState.detail-title;
                                font-size: 24px;
                                font-weight: 600;
                                color: Theme.default-text-color.transparentize(0.1);
                                height: 24px;
                                vertical-alignment: center;
                            }

                            metadata := FlexboxLayout {
                                flex-wrap: wrap;
                                height: 20px;
                                spacing: 12px;
                                cross-axis-alignment: center;

                                if ContentState.detail-source != "": MetadataEntry {
                                    icon: ContentState.detail-source-is-github ? "github" : "code-slash-outline";
                                    text: ContentState.detail-source-label;
                                    link: true;
                                    clicked => { ContentState.open-url(ContentState.detail-source); }
                                }

                                MetadataEntry {
                                    icon: "download";
                                    text: ContentState.detail-downloads;
                                    // The divider belongs after the previous entry.
                                    divider: ContentState.detail-source != "";
                                }

                                if ContentState.detail-has-followers: MetadataEntry {
                                    icon: "heart-outline";
                                    text: ContentState.detail-followers;
                                    divider: true;
                                }
                            }

                            // Wraps with no set height, unlike the card's one line.
                            if ContentState.detail-description != "": Text {
                                text: ContentState.detail-description;
                                font-size: 14px;
                                color: Theme.default-text-color.transparentize(0.1);
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 40px;
                        spacing: 8px;
                        alignment: start;
                        cross-axis-alignment: center;

                        // Still asking the disk whether this project is installed:
                        // the same pill, holding a spinner.
                        if root.action == "checking": Rectangle {
                            width: 112px;
                            height: 40px;
                            border-radius: 10000px;
                            background: Theme.blue;
                            opacity: 0.6;

                            Loading {
                                size: 18px;
                                stroke-width: 6;
                                icon-color: white;
                            }
                        }

                        if root.action != "checking": DetailPill {
                            kind: root.action;
                            clicked => {
                                if root.action == "cancel" {
                                    // The centre applies its own rule: a download
                                    // that has been writing asks before it stops.
                                    if ContentState.detail-task-id >= 0 {
                                        TaskState.request-cancel(ContentState.detail-task-id);
                                    }
                                } else if root.action == "installed" {
                                    ContentState.remove();
                                } else {
                                    ContentState.download();
                                }
                            }
                        }

                        // The project's own toggle, drawn like the action icons
                        // beside the game view's launch button.
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 100px;
                            background: heart-touch.pressed ? Theme.surface-0
                                : heart-touch.has-hover ? Theme.surface-1
                                : transparent;

                            AppIcon {
                                name: ContentState.detail-favorited ? "heart" : "heart-outline";
                                size: 20px;
                            }

                            heart-touch := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                clicked => { ContentState.toggle-favorite(ContentState.detail-id); }
                            }

                            // The glyph names the state, so the hint names the
                            // action that changes it.
                            TooltipArea {
                                text: ContentState.detail-favorited
                                    ? @tr("Remove from favorites")
                                    : @tr("Add to favorites");
                                hovered: heart-touch.has-hover;
                                wrap: false;
                                show-on-press: false;
                            }
                        }

                        if ContentState.detail-operating && ContentState.detail-progress-max > 0: VerticalLayout {
                            width: 160px;
                            height: 36px;
                            alignment: center;
                            spacing: 4px;

                            Text {
                                text: ContentState.detail-progress-text;
                                font-size: 12px;
                                color: Theme.subtext-1;
                                horizontal-alignment: center;
                            }

                            Progress {
                                width: 100%;
                                loading: false;
                                value: ContentState.detail-progress;
                                max: ContentState.detail-progress-max;
                            }
                        }

                        if ContentState.detail-installed-version != "": Text {
                            text: @tr("Installed: {}", ContentState.detail-installed-version);
                            font-size: 13px;
                            font-italic: true;
                            color: Theme.subtext-1;
                            opacity: 0.6;
                            vertical-alignment: center;
                            height: 36px;
                            horizontal-alignment: left;
                        }
                    }

                    // An empty body still draws the box when `body-always` is set.
                    if ContentState.detail-body != "" || ContentState.detail-body-always: markdown-body := MarkdownBody {
                        // The body is a grandchild of the scroller, so the offset
                        // and height are passed down.
                        scroll-y: scroller.content-y;
                        viewport-height: scroller.height;
                        // The body culls from its own top, so it needs its position
                        // inside the scrolled content or it would cull the header
                        // above it.
                        top-in-scroll: details-column.y
                            + details-inner.y
                            + markdown-body.y;
                    }

                    if ContentState.detail-gallery.length > 0: Rectangle {
                        width: 100%;
                        height: 252px;
                        background: Theme.surface-0;
                        border-radius: 8px;

                        // 8px inside the 16px padding, so items start 24px in. The
                        // box clips, hence the horizontal scroller.
                        gallery-scroll := ScrollViewHorizontal {
                            x: 24px;
                            y: 16px;
                            width: parent.width - 48px;
                            height: parent.height - 32px;
                            scrollbar-left: 8px;
                            scrollbar-right: 8px;

                            HorizontalLayout {
                                spacing: 12px;
                                cross-axis-alignment: center;

                                for shot in ContentState.detail-gallery: Rectangle {
                                    width: shot.ratio * 204px;
                                    height: 204px;
                                    border-radius: 8px;
                                    clip: true;
                                    background: transparent;

                                    Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: shot.image;
                                        image-fit: cover;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component DetailPanel inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    OverlayPanel {
        panel-visible: ContentState.open-detail != "";
        panel-background: Theme.base;
        closed => { ContentState.close-detail(); }

        DetailBody { }
    }
}
