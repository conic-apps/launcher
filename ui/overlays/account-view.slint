import { Theme } from "../theme.slint";
import { AppIcon } from "../components/display/app-icon.slint";
import { ScrollView } from "../components/containers/scroll-view.slint";
import {
    ScrollViewHorizontal,
} from "../components/containers/scroll-view-horizontal.slint";
import { SettingGroup } from "../components/settings/setting-group.slint";
import { SettingItem } from "../components/settings/setting-item.slint";
import { Button } from "../components/controls/button.slint";
import { Loading } from "../components/controls/loading.slint";
import { ContentOverlay } from "content/content-overlay.slint";
import { GameState, GameTime } from "../globals/game.slint";
import { AccountViewState } from "../globals/account-view.slint";
import { AvatarMask } from "../globals/avatar.slint";
import { Dropdown } from "../globals/dropdown.slint";
import { FocusManager } from "../globals/focus.slint";

// `flexible` lets a pair take the leftover width and elide; the rest keep theirs.
component DetailItem inherits HorizontalLayout {
    in property <string> icon;
    in property <string> label;
    in property <bool> flexible: false;
    spacing: 6px;
    cross-axis-alignment: center;
    horizontal-stretch: root.flexible ? 1 : 0;

    AppIcon {
        name: root.icon;
        size: 16px;
        icon-color: Theme.default-text-color.with-alpha(0.509);
    }

    Text {
        text: root.label;
        font-size: 12px;
        font-weight: Theme.font-weight-normal;
        color: Theme.default-text-color.with-alpha(0.65);
        overflow: root.flexible ? elide : clip;
        wrap: no-wrap;
        vertical-alignment: center;
    }
}

// The account view overlay: head, auth details, launch graph, recent activity,
// capes and the danger zone, on the shared `ContentOverlay` shell.
//
// The top band (title bar, summary, graph) runs full width with no gaps; the
// sections below it are rounded cards.
export component AccountView inherits Rectangle {
    in property <length> panel-width: 0px;
    in property <length> panel-height: 0px;
    private property <length> cell: 11px;

    // The shadow is a bitmap, padded so the blur is not clipped.
    private property <length> avatar-size: 64px;
    private property <length> avatar-shadow-blur: 10px;
    private property <length> avatar-shadow-offset-y: 3px;
    private property <length> avatar-shadow-pad: self.avatar-shadow-blur * 1.5
        + self.avatar-shadow-offset-y + 1px;

    // Mirrors the dropdown's pick into a local change, as `AccountListDropdown` does.
    private property <int> switch-serial: Dropdown.choose-serial;
    changed switch-serial => {
        if Dropdown.choose-owner == "account-view-switch" {
            if Dropdown.chosen == "__add_account__" {
                AccountViewState.add-account();
            } else {
                AccountViewState.select-account(Dropdown.chosen);
            }
        }
    }

    width: panel-width;
    height: panel-height;
    background: transparent;

    pure function auth-icon() -> string {
        if AccountViewState.kind == "Microsoft" {
            return "logo-microsoft";
        }
        if AccountViewState.kind == "Yggdrasil" {
            return "server";
        }
        return "cloud-offline-outline";
    }

    pure function auth-text() -> string {
        if AccountViewState.kind == "Microsoft" {
            return @tr("AccountView" => "Microsoft (auth service)");
        }
        if AccountViewState.kind == "Yggdrasil" {
            return @tr(
                "AccountView" => "{} (third-party Yggdrasil)",
                AccountViewState.auth-server);
        }
        return @tr("AccountView" => "No auth service (offline account)");
    }

    pure function refresh-text() -> string {
        if AccountViewState.refresh-kind == "year-month-day" {
            return GameTime.year-month-day(
                AccountViewState.refresh-month,
                AccountViewState.refresh-day,
                AccountViewState.refresh-year);
        }
        return @tr("AccountView" => "Never");
    }

    pure function month-label(month: int) -> string {
        return @tr("AccountView" => "{}月", month);
    }

    /// Only rows 1, 3 and 5 are labelled, like GitHub's graph.
    pure function weekday-label(row: int) -> string {
        if row == 1 {
            return @tr("AccountView" => "Mon");
        }
        if row == 3 {
            return @tr("AccountView" => "Wed");
        }
        if row == 5 {
            return @tr("AccountView" => "Fri");
        }
        return "";
    }

    pure function level-color(level: int) -> color {
        if level <= 0 {
            return Theme.overlay-0.with-alpha(0.2);
        }
        if level == 1 {
            return Theme.green.with-alpha(0.25);
        }
        if level == 2 {
            return Theme.green.with-alpha(0.45);
        }
        if level == 3 {
            return Theme.green.with-alpha(0.7);
        }
        return Theme.green;
    }

    ScrollView {
        // The top band: title bar, summary and graph, edge to edge.
        top-band := VerticalLayout {
            width: 100%;
            spacing: 0px;

            // The shared 52px bar, tinted with the account's lavender.
            title-bar := Rectangle {
                width: 100%;
                height: 52px;
                background: Theme.mantle.mix(Theme.lavender, 0.82);

                HorizontalLayout {
                    padding-left: 32px;
                    padding-right: 32px;
                    spacing: 8px;
                    cross-axis-alignment: center;

                    AppIcon {
                        name: "person-circle-outline";
                        size: 20px;
                    }

                    Text {
                        text: @tr("AccountView" => "Account details");
                        font-size: 16px;
                        color: Theme.default-text-color.transparentize(0.1);
                    }
                }
            }

            if AccountViewState.has-account: VerticalLayout {
                width: 100%;
                spacing: 0px;

                // Square and full width, continuing the title bar. A light accent
                // mix shifts the neutral's hue without washing out the text.
                Rectangle {
                    width: 100%;
                    height: 108px;
                    background: Theme.mantle.mix(Theme.lavender, 0.93);

                    HorizontalLayout {
                        width: 100%;
                        height: 100%;
                        padding-left: 32px;
                        padding-right: 32px;
                        padding-top: 18px;
                        padding-bottom: 18px;
                        spacing: 18px;
                        cross-axis-alignment: center;

                        // A square head, so the avatar is not passed through
                        // `AvatarMask.rounded` here. The shadow is a bitmap that
                        // follows the head's alpha; `drop-shadow-*` would cast a
                        // square from the box.
                        avatar-box := Rectangle {
                            width: root.avatar-size;
                            height: root.avatar-size;
                            background: transparent;

                            Image {
                                x: -root.avatar-shadow-pad;
                                y: -root.avatar-shadow-pad;
                                width: root.avatar-size + 2 * root.avatar-shadow-pad;
                                height: root.avatar-size + 2 * root.avatar-shadow-pad;
                                source: AvatarMask.drop-shadow(
                                    AccountViewState.avatar,
                                    root.avatar-shadow-blur,
                                    root.avatar-shadow-offset-y,
                                    root.avatar-shadow-pad,
                                    #00000066);
                                image-fit: fill;
                            }

                            Image {
                                width: 100%;
                                height: 100%;
                                source: AccountViewState.avatar;
                                image-rendering: pixelated;
                            }
                        }

                        info := VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 10px;
                            alignment: center;

                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                cross-axis-alignment: center;

                                Text {
                                    text: AccountViewState.name;
                                    font-size: 20px;
                                    font-weight: Theme.font-weight-bold;
                                    color: Theme.default-text-color.transparentize(0.05);
                                    overflow: elide;
                                    wrap: no-wrap;
                                    vertical-alignment: center;
                                }

                                // Bare hit area. `Button` is not used because it
                                // always paints its fill and border.
                                switch-account := Rectangle {
                                    width: 36px;
                                    height: 30px;
                                    background: transparent;

                                    AppIcon {
                                        name: "swap-horizontal-outline";
                                        size: 16px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        icon-color: switch-touch.has-hover || switch-touch.pressed
                                            ? Theme.lavender
                                            : Theme.default-text-color.transparentize(0.1);
                                        transform-origin: { x: self.width / 2, y: self.height / 2 };
                                        transform-scale: switch-touch.pressed ? 90% : 100%;
                                        animate icon-color {
                                            duration: 120ms;
                                            easing: ease;
                                        }
                                        animate transform-scale {
                                            duration: 120ms;
                                            easing: ease;
                                        }
                                    }

                                    switch-touch := TouchArea {
                                        width: 100%;
                                        height: 100%;

                                        clicked => {
                                            FocusManager.clear();
                                            if Dropdown.open
                                                && Dropdown.owner == "account-view-switch" {
                                                Dropdown.open = false;
                                            } else {
                                                Dropdown.options = [];
                                                Dropdown.accounts = GameState.accounts;
                                                Dropdown.account-mode = true;
                                                Dropdown.include-add-account = true;
                                                Dropdown.current = AccountViewState.viewed-key;
                                                Dropdown.owner = "account-view-switch";
                                                Dropdown.anchor-x = switch-account.absolute-position.x;
                                                Dropdown.anchor-width = 240px;
                                                Dropdown.anchor-y = switch-account.absolute-position.y
                                                    + switch-account.height + 4px;
                                                Dropdown.expand-upwards = false;
                                                Dropdown.open = true;
                                            }
                                        }
                                    }
                                }
                            }

                            // Only the UUID is flexible and may be elided.
                            //
                            // TODO(account-view): add a hover tooltip
                            // (DescriptionTooltip) and click-to-copy for the UUID.
                            HorizontalLayout {
                                spacing: 18px;
                                cross-axis-alignment: center;

                                DetailItem {
                                    icon: auth-icon();
                                    label: auth-text();
                                }

                                DetailItem {
                                    icon: "time";
                                    label: refresh-text();
                                }

                                DetailItem {
                                    flexible: true;
                                    icon: "finger-print";
                                    label: AccountViewState.uuid;
                                }
                            }
                        }
                    }
                }

                // The contribution graph, also on the band with no heading.
                Rectangle {
                    width: 100%;
                    height: stats-inner.preferred-height;
                    background: Theme.base.mix(Theme.lavender, 0.93);

                    stats-inner := VerticalLayout {
                        width: 100%;
                        padding-left: 32px;
                        padding-right: 32px;
                        padding-top: 16px;
                        padding-bottom: 16px;
                        spacing: 4px;
                        alignment: start;

                        HorizontalLayout {
                            width: 100%;
                            height: 112px;
                            spacing: 4px;

                            weekday-gutter := Rectangle {
                                width: 26px;
                                height: 112px;
                                background: transparent;

                                for row in [1, 3, 5]: Text {
                                    x: 0;
                                    y: 16px + row * 13px;
                                    width: parent.width;
                                    height: 11px;
                                    text: weekday-label(row);
                                    font-size: 10px;
                                    color: Theme.default-text-color.with-alpha(0.45);
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            graph-column := VerticalLayout {
                                horizontal-stretch: 1;
                                height: 112px;
                                alignment: start;

                                graph-scroll := ScrollViewHorizontal {
                                    width: 100%;
                                    height: 112px;

                                    graph-content := Rectangle {
                                        // Measured against the viewport, not the
                                        // panel, or a fitting graph leaves a strip
                                        // of scrollable blank.
                                        width: max(
                                            graph-scroll.width,
                                            AccountViewState.column-count * 13px);
                                        height: 112px;
                                        background: transparent;

                                        for label in AccountViewState.months: Text {
                                            x: label.column * 13px;
                                            y: 0px;
                                            text: month-label(label.month);
                                            font-size: 10px;
                                            color: Theme.default-text-color.with-alpha(0.45);
                                        }

                                        for day in AccountViewState.days: Rectangle {
                                            x: day.column * 13px;
                                            y: 16px + day.row * 13px;
                                            width: root.cell;
                                            height: root.cell;
                                            border-radius: 2px;
                                            background: root.level-color(day.level);
                                        }
                                    }
                                }
                            }
                        }

                        Rectangle {
                            width: 100%;
                            height: 12px;
                            background: transparent;
                        }

                        HorizontalLayout {
                            width: 100%;
                            spacing: 4px;
                            cross-axis-alignment: center;

                            // Its stretch pushes the legend to the right edge.
                            Text {
                                text: @tr(
                                    "AccountView" => "Launched this account {} times in the past year",
                                    AccountViewState.total-launches);
                                horizontal-stretch: 1;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                overflow: elide;
                                wrap: no-wrap;
                                font-size: 12px;
                                color: Theme.default-text-color.with-alpha(0.65);
                            }

                            Text {
                                text: @tr("AccountView" => "Less");
                                font-size: 10px;
                                color: Theme.default-text-color.with-alpha(0.45);
                            }

                            for level in [0, 1, 2, 3, 4]: Rectangle {
                                width: 10px;
                                height: 10px;
                                border-radius: 2px;
                                background: root.level-color(level);
                            }

                            Text {
                                text: @tr("AccountView" => "More");
                                font-size: 10px;
                                color: Theme.default-text-color.with-alpha(0.45);
                            }
                        }
                    }
                }

                // The cards, re-inset below the band.
                VerticalLayout {
                    width: 100%;
                    spacing: 16px;
                    alignment: start;
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 16px;

                    // A hand-written box rather than `SettingGroup`, so its fill
                    // can carry the account's lavender.
                    VerticalLayout {
                        width: 100%;
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: @tr("AccountView" => "Recent activity");
                            font-size: 13.5px;
                            color: Theme.default-text-color.transparentize(0.1);
                        }

                        Rectangle {
                            width: 100%;
                            height: activity-inner.preferred-height;
                            background: Theme.setting-item-background.mix(Theme.lavender, 0.9);
                            border-radius: 8px;

                            activity-inner := VerticalLayout {
                                width: 100%;
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-top: 12px;
                                padding-bottom: 12px;
                                spacing: 0px;
                                alignment: start;

                                if AccountViewState.activities-empty: Text {
                                    text: @tr("AccountView" => "No launches recorded yet");
                                    font-size: 12px;
                                    color: Theme.default-text-color.with-alpha(0.509);
                                    vertical-alignment: center;
                                }

                                for activity in AccountViewState.activities: HorizontalLayout {
                                    height: 32px;
                                    spacing: 6px;
                                    cross-axis-alignment: center;

                                    AppIcon {
                                        name: "play-circle-outline";
                                        size: 16px;
                                        icon-color: Theme.green;
                                    }

                                    Text {
                                        text: AccountViewState.name;
                                        font-size: 13px;
                                        color: Theme.lavender;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }

                                    Text {
                                        text: @tr("AccountView" => "launched");
                                        font-size: 13px;
                                        color: Theme.default-text-color.with-alpha(0.7);
                                        wrap: no-wrap;
                                    }

                                    // Takes the slack and elides, so the time
                                    // stays against the right edge.
                                    Text {
                                        text: activity.name;
                                        horizontal-stretch: 1;
                                        font-size: 13px;
                                        color: Theme.lavender;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }

                                    Text {
                                        text: GameTime.last-played(
                                            activity.kind,
                                            activity.hours,
                                            activity.month,
                                            activity.day,
                                            activity.year);
                                        font-size: 11px;
                                        color: Theme.default-text-color.with-alpha(0.45);
                                        wrap: no-wrap;
                                    }
                                }
                            }
                        }
                    }

                    // The cape list, led by a "no cape" entry. Capes are rounded in
                    // the pixels by `AvatarMask.rounded`, because a rounded `clip`
                    // is a no-op on the software renderer.
                    VerticalLayout {
                        width: 100%;
                        spacing: 10px;
                        alignment: start;

                        Text {
                            text: @tr("AccountView" => "Select cape");
                            font-size: 13.5px;
                            color: Theme.default-text-color.transparentize(0.1);
                        }

                        Rectangle {
                            width: 100%;
                            height: cape-inner.preferred-height;
                            background: Theme.setting-item-background.mix(Theme.lavender, 0.9);
                            border-radius: 8px;

                            // Scrolls sideways when the capes do not fit.
                            cape-scroll := ScrollViewHorizontal {
                                width: 100%;
                                height: 100%;
                                scrollbar-left: 16px;
                                scrollbar-right: 16px;

                                cape-inner := HorizontalLayout {
                                    padding: 16px;
                                    spacing: 12px;
                                    alignment: start;
                                    cross-axis-alignment: center;

                                    if AccountViewState.capes.length == 0: Text {
                                        text: @tr("AccountView" => "No capes available");
                                        font-size: 12px;
                                        color: Theme.default-text-color.with-alpha(0.509);
                                    }

                                    for cape[index] in AccountViewState.capes: Rectangle {
                                        width: 44px;
                                        height: 72px;
                                        border-radius: 8px;
                                        border-width: cape.selected ? 2px : 0px;
                                        border-color: Theme.blue;
                                        background: transparent;
                                        opacity: AccountViewState.cape-loading ? 0.4 : 1.0;
                                        animate opacity {
                                            duration: 120ms;
                                            easing: ease;
                                        }

                                        // The "no cape" entry's dashed ring. A
                                        // `Rectangle` has no dashed border, so the
                                        // dashes are one `Path` of segments.
                                        if cape.none && !cape.selected: Path {
                                            x: 0;
                                            y: 0;
                                            width: 44px;
                                            height: 72px;
                                            viewbox-x: 0;
                                            viewbox-y: 0;
                                            viewbox-width: 44;
                                            viewbox-height: 72;
                                            fill: transparent;
                                            stroke-width: 2px;
                                            stroke: Theme.default-text-color.with-alpha(0.509);
                                            commands: "M8.0 1.0L12.0 1.0M16.0 1.0L20.0 1.0M24.0 1.0L28.0 1.0M32.0 1.0L36.0 1.0M39.8 2.1L42.4 5.1M43.0 9.0L43.0 13.0M43.0 17.0L43.0 21.0M43.0 25.0L43.0 29.0M43.0 33.0L43.0 37.0M43.0 41.0L43.0 45.0M43.0 49.0L43.0 53.0M43.0 57.0L43.0 61.0M42.9 65.0L41.3 68.6M37.9 70.7L34.0 71.0M30.0 71.0L26.0 71.0M22.0 71.0L18.0 71.0M14.0 71.0L10.0 71.0M6.0 70.7L2.7 68.5M1.1 64.9L1.0 61.0M1.0 57.0L1.0 53.0M1.0 49.0L1.0 45.0M1.0 41.0L1.0 37.0M1.0 33.0L1.0 29.0M1.0 25.0L1.0 21.0M1.0 17.0L1.0 13.0M1.0 9.0L1.7 5.1M4.3 2.1L8.0 1.0";
                                        }

                                        if cape.none: AppIcon {
                                            name: "ban";
                                            size: 26px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            icon-color: cape.selected ? Theme.blue
                                                : Theme.default-text-color.with-alpha(0.509);
                                        }

                                        if !cape.none: Image {
                                            x: 2px;
                                            y: 2px;
                                            width: 40px;
                                            height: 68px;
                                            source: AvatarMask.rounded(cape.image, 6px, 40px);
                                            image-fit: fill;
                                            image-rendering: pixelated;
                                        }

                                        TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            enabled: !AccountViewState.cape-loading;
                                            clicked => { AccountViewState.select-cape(index); }
                                        }
                                    }
                                }
                            }

                            // The in-flight spinner badge. Kept in the tree so it
                            // can fade/scale rather than pop in through an `if`.
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: 10px;
                                background: Theme.crust;
                                opacity: AccountViewState.cape-loading ? 1.0 : 0.0;
                                transform-origin: { x: self.width / 2, y: self.height / 2 };
                                transform-scale: AccountViewState.cape-loading ? 1.0 : 0.6;

                                animate opacity {
                                    duration: AccountViewState.cape-loading ? 220ms : 160ms;
                                    easing: AccountViewState.cape-loading
                                        ? ease-out-back
                                        : ease-out-quart;
                                }
                                animate transform-scale {
                                    duration: AccountViewState.cape-loading ? 220ms : 160ms;
                                    easing: AccountViewState.cape-loading
                                        ? ease-out-back
                                        : ease-out-quart;
                                }

                                Loading {
                                    size: 18px;
                                    stroke-width: 4;
                                    gap: 6;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    icon-color: Theme.text;
                                }
                            }
                        }
                    }

                    SettingGroup {
                        danger: true;
                        title: @tr("AccountView" => "Delete account");

                        SettingItem {
                            group-first: true;
                            group-last: true;
                            title: @tr("AccountView" => "Delete from Conic Launcher");
                            description: @tr(
                                "AccountView" => "Removes the locally stored credentials. The account itself is not affected");
                            icon: "trash";
                            navigable: true;
                            clicked => { AccountViewState.delete-account(); }
                        }
                    }
                }
            }
        }

        if !AccountViewState.has-account: VerticalLayout {
            width: 100%;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px;

            SettingGroup {
                empty-box := Rectangle {
                    width: 100%;
                    height: 220px;
                    background: Theme.setting-item-background;
                    border-radius: 8px;

                    VerticalLayout {
                        width: 100%;
                        height: 100%;
                        alignment: center;
                        spacing: 12px;

                        AppIcon {
                            name: "person-circle-outline";
                            size: 48px;
                            icon-color: Theme.default-text-color.with-alpha(0.4);
                        }

                        Text {
                            text: @tr("AccountView" => "No account selected");
                            font-size: 15px;
                            color: Theme.default-text-color.transparentize(0.2);
                        }

                        Button {
                            text: @tr("Add account");
                            button-width: 160px;
                            clicked => { AccountViewState.add-account(); }
                        }
                    }
                }
            }
        }

        // Trailing 16px spacer: `spacing` does not cover the last group.
        Rectangle {
            width: 100%;
            height: 16px;
            background: transparent;
        }
    }
}

export component AccountViewRoot inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    overlay := ContentOverlay {
        overlay-visible: AccountViewState.visible;
        panel-inset: 200px;
        // Lavender at the body's weaker ratio.
        panel-background: Theme.base.mix(Theme.lavender, 0.9);
        closed => { AccountViewState.close(); }

        AccountView {
            panel-width: overlay.panel-width;
            panel-height: overlay.panel-height;
        }
    }
}
