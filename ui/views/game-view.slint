import { GameIntro } from "../globals/game.slint";
import { FocusManager } from "../globals/focus.slint";
import { PageMotion } from "../globals/page-motion.slint";
import { InstanceSummary } from "game/instance-summary.slint";
import { InstancesList } from "game/instances-list.slint";
import { GameFooterBar } from "game/footer.slint";
import { InstanceSettingsRoot } from "../overlays/instance-settings.slint";
import { AccountViewRoot } from "../overlays/account-view.slint";
import { ContentRoot } from "../overlays/content/content-root.slint";

// The game screen: current-instance summary on the left, the grouped instance
// list on the right and the footer bar beneath. The click-to-open content
// overlays live in ContentRoot.
export component GameView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // Only the exit uses this; the entrance is the `GameIntro` stagger, so an
    // "enter" here would double the intro.
    opacity: PageMotion.phase("game") == "leave" ? 0.0 : 1.0;
    animate opacity {
        duration: 200ms;
        easing: ease-out-quad;
    }

    // The page stack recreates this screen per navigation, so the intro replays.
    init => {
        GameIntro.played = false;
    }

    // Centre the current instance without animating, then flip the shared flag
    // so every element plays its own delayed `animate`.
    intro-timer := Timer {
        interval: 50ms;
        running: true;
        triggered => {
            instance-list.scroll-to-current(false);
            // Tell the list its window after centring, before the flag flips,
            // so cards stagger from the visible area rather than the list top.
            instance-list.begin-intro();
            GameIntro.played = true;
            intro-timer.running = false;
        }
    }

    // Clicking empty space blurs a focused field.
    background-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { FocusManager.clear(); }
    }

    instance-summary := InstanceSummary {
        x: 48px;
        y: parent.height * 45 / 100 - self.height / 2;
    }

    instance-list := InstancesList {
        y: 0;
        x: parent.width - self.width + 320px;
    }

    GameFooterBar {
        y: parent.height - self.height;
    }

    // Declaration order is the z-order: settings below content, account on top.
    InstanceSettingsRoot { }

    // Mounted here, not at the app root, so the panels sit below the title bar
    // and exist only on the game screen.
    ContentRoot { }

    AccountViewRoot { }
}
