import { SettingGroup } from "../../components/settings/setting-group.slint";
import {
    SettingCollapse,
} from "../../components/settings/setting-collapse.slint";
import { SettingItem } from "../../components/settings/setting-item.slint";
import { Switch } from "../../components/controls/switch.slint";
import { Select } from "../../components/controls/select.slint";
import {
    DropdownSelect,
} from "../../components/controls/dropdown-select.slint";
import { AppConfig } from "../../globals/settings.slint";
import { Navigation } from "../../globals/navigation.slint";

export component SettingsGeneral inherits VerticalLayout {
    width: 100%;
    padding-left: 8px;
    padding-right: 8px;
    spacing: 16px;
    alignment: start;

    pure function language-label(value: string) -> string {
        if value == "en_us" { return "English"; }
        if value == "zh_cn" { return "简体中文"; }
        if value == "zh_tw" { return "繁體中文"; }
        if value == "ja_jp" { return "日本語"; }
        if value == "ko_kr" { return "한국어"; }
        if value == "de_de" { return "Deutsch"; }
        if value == "fr_fr" { return "Français"; }
        if value == "es_es" { return "Español"; }
        if value == "pt_br" { return "Português (Brasil)"; }
        if value == "ru_ru" { return "Русский"; }
        if value == "tr_tr" { return "Türkçe"; }
        if value == "pl_pl" { return "Polski"; }
        return "";
    }

    SettingGroup {
        SettingItem {
            group-first: true;
            title: @tr("Language");
            icon: "language";

            DropdownSelect {
                options: [
                    { key: "en_us", label: "English", icon: "" },
                    { key: "zh_cn", label: "简体中文", icon: "" },
                    { key: "zh_tw", label: "繁體中文", icon: "" },
                    { key: "ja_jp", label: "日本語", icon: "" },
                    { key: "ko_kr", label: "한국어", icon: "" },
                    { key: "de_de", label: "Deutsch", icon: "" },
                    { key: "fr_fr", label: "Français", icon: "" },
                    { key: "es_es", label: "Español", icon: "" },
                    { key: "pt_br", label: "Português (Brasil)", icon: "" },
                    { key: "ru_ru", label: "Русский", icon: "" },
                    { key: "tr_tr", label: "Türkçe", icon: "" },
                    { key: "pl_pl", label: "Polski", icon: "" },
                ];
                selected-label: language-label(AppConfig.language);
                placeholder: @tr("Follow system");
                value <=> AppConfig.language;
                selected(value) => { AppConfig.changed(); }
            }
        }

        SettingItem {
            title: @tr("Auto update");
            // A package-manager install (deb, rpm, Arch) is updated by the
            // package manager, so the switch is greyed out and says so.
            description: AppConfig.update-self-updating
                ? @tr("Automatically download and install updates when available")
                : @tr("Updates are provided by your package manager");
            item-disabled: !AppConfig.update-self-updating;

            Switch {
                checked <=> AppConfig.auto-update;
                toggled => { AppConfig.changed(); }
            }
        }

        SettingItem {
            title: @tr("Update channel");
            description: @tr("Controls how frequently the launcher receives updates");
            item-disabled: !AppConfig.auto-update || !AppConfig.update-self-updating;

            Select {
                options: ["stable", "beta"];
                display-name: [@tr("Stable"), @tr("Beta")];
                value <=> AppConfig.update-channel;
                selected(value) => { AppConfig.changed(); }
            }
        }

        SettingItem {
            group-last: true;
            title: @tr("Open setup wizard");
            description: @tr("The setup wizard guides you through basic launcher settings");
            navigable: true;
            clicked => { Navigation.navigate("setup"); }
        }
    }

    // The three storage roots. They are not part of `config.toml` — that file
    // lives inside the launcher location — so clicking a row opens the folder
    // chooser, writes the bootstrap file and asks for a restart.
    SettingCollapse {
        title: @tr("Data storage");

        SettingItem {
            title: @tr("Launcher data");
            description: AppConfig.launcher-location;
            navigable: true;
            // A path is a single elided line, with the whole of it in the hover
            // tooltip (see `SettingItem`'s `description-lines`).
            description-lines: 1;
            clicked => { AppConfig.pick-data-location("launcher"); }
        }

        SettingItem {
            title: @tr("Minecraft install");
            description: AppConfig.minecraft-location;
            navigable: true;
            description-lines: 1;
            clicked => { AppConfig.pick-data-location("minecraft"); }
        }

        SettingItem {
            group-last: true;
            title: @tr("Instances and game data");
            description: AppConfig.instances-location;
            navigable: true;
            description-lines: 1;
            clicked => { AppConfig.pick-data-location("instances"); }
        }
    }
}
