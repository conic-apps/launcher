import { Theme } from "../../theme.slint";
import { SettingGroup } from "../../components/settings/setting-group.slint";
import { SettingItem } from "../../components/settings/setting-item.slint";
import { SettingReveal } from "../../components/settings/setting-reveal.slint";
import { Switch } from "../../components/controls/switch.slint";
import { Button } from "../../components/controls/button.slint";
import { SliderBar } from "../../components/controls/slider-bar.slint";
import { PaletteRow } from "../../components/display/palette-row.slint";
import { AppConfig } from "../../globals/settings.slint";
import { Background } from "../../globals/background.slint";

export component SettingsAppearance inherits VerticalLayout {
    width: 100%;
    padding-left: 8px;
    padding-right: 8px;
    spacing: 16px;
    alignment: start;

    SettingGroup {
        title: @tr("Palette");

        SettingItem {
            group-first: true;
            title: @tr("Follow system dark mode");
            description: @tr("Uses Latte when the system is set to light mode, otherwise uses Mocha");
            icon: "moon";
            icon-outline: true;

            Switch {
                checked <=> AppConfig.palette-follow-system;
                // Arms the palette transition so a user change animates;
                // tokens are evaluated lazily from the event loop, so setting
                // this in `toggled` is early enough.
                toggled => {
                    Theme.transitions-enabled = true;
                    AppConfig.changed();
                }
            }
        }

        // `PaletteRow` is not a `SettingItem`, so it rounds its own bottom as
        // the group's last child.
        PaletteRow {
            selected: Theme.active-palette;
            swatches-disabled: AppConfig.palette-follow-system;
        }
    }

    SettingGroup {
        title: @tr("Background image");

        SettingItem {
            group-first: true;
            title: @tr("Custom background image");
            description: @tr("Select an image as the launcher background. Instance backgrounds take priority");
            icon: "image";
            navigable: AppConfig.background-image == "";
            clicked => { AppConfig.pick-background-image(); }

            if AppConfig.background-image != "": Button {
                text: @tr("Remove image");
                text-color: Theme.red;
                clicked => { AppConfig.remove-background-image(); }
            }
        }

        // Revealed rather than greyed out: darkness only applies to a drawn image.
        SettingReveal {
            shown: AppConfig.background-image != "";

            SettingItem {
                title: @tr("Background image darkness");
                description: AppConfig.background-darkness + "%";

                SliderBar {
                    max: 100;
                    min: 0;
                    step: 5;
                    value <=> AppConfig.background-darkness;
                    edited => { AppConfig.changed(); }
                }
            }
        }

        SettingItem {
            title: @tr("3D background camera movement");
            description: @tr("When disabled, the camera stops moving forward and the background stops updating after rendering, completely eliminating background overhead");
            // Nothing moves a world that is not drawn: the software renderer
            // shows only the hyperbola sky.
            item-disabled: Background.software-only;

            Switch {
                checked <=> AppConfig.background-camera-move;
                toggled => { AppConfig.changed(); }
            }
        }

        SettingItem {
            group-last: true;
            title: @tr("Background parallax");
            description: @tr("When disabled, the background no longer moves with the mouse");

            Switch {
                checked <=> AppConfig.background-parallax;
                toggled => { AppConfig.changed(); }
            }
        }
    }
}
