import { Theme } from "../../theme.slint";
import { FocusManager } from "../../globals/focus.slint";
import { AppConfig } from "../../globals/settings.slint";
import { WizardTitle, WizardMessage } from "wizard-text.slint";

component LanguageButton inherits Rectangle {
    in property <string> code;
    in property <string> label;
    in property <length> track-width;
    in property <bool> selected: false;

    width: root.track-width;
    height: 42px;
    border-radius: 8px;
    // Selection is tested first, then press, then hover, so a selected button
    // never shows a pointer state. (`AccountAddSelect`'s service buttons follow
    // the same rule.)
    background: root.selected ? Theme.surface-1
        : touch.pressed ? Theme.surface-1
        : touch.has-hover ? Theme.surface-0
        : transparent;
    // Hover arrives instantly and leaves eased; selection and press ease in over
    // 200ms. Reading the duration from the state the animation is heading for
    // expresses that.
    animate background {
        duration: root.selected || touch.pressed ? 200ms : touch.has-hover ? 0ms : 100ms;
        easing: ease;
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        vertical-alignment: center;
        horizontal-alignment: center;
        // One pixel above the default button label size, which is rather small
        // for a row the user reads rather than recognises. The button's own box
        // stays 42px either way.
        font-size: 12px;
        font-weight: Theme.font-weight-normal;
        color: root.selected ? Theme.mauve : Theme.default-text-color.transparentize(0.1);
    }

    touch := TouchArea {
        clicked => {
            FocusManager.clear();
            AppConfig.language = root.code;
            AppConfig.changed();
        }
    }
}

// The wizard's first screen. It has no intro of its own; the header, body and
// footer are the only ones that animate.
export component SetupLanguage inherits VerticalLayout {
    /// The 12 language codes, in the same order the General settings dropdown
    /// uses.
    private property <[string]> codes: [
        "en_us",
        "zh_cn",
        "zh_tw",
        "ja_jp",
        "ko_kr",
        "de_de",
        "fr_fr",
        "es_es",
        "pt_br",
        "ru_ru",
        "tr_tr",
        "pl_pl",
    ];

    /// A language code as its endonym.
    pure function language-label(value: string) -> string {
        if value == "en_us" { return "English"; }
        if value == "zh_cn" { return "简体中文"; }
        if value == "zh_tw" { return "繁體中文"; }
        if value == "ja_jp" { return "日本語"; }
        if value == "ko_kr" { return "한국어"; }
        if value == "de_de" { return "Deutsch"; }
        if value == "fr_fr" { return "Français"; }
        if value == "es_es" { return "Español"; }
        if value == "pt_br" { return "Português (Brasil);"; }
        if value == "ru_ru" { return "Русский"; }
        if value == "tr_tr" { return "Türkçe"; }
        if value == "pl_pl" { return "Polski"; }
        return "";
    }

    width: 100%;
    spacing: 0px;
    alignment: start;

    WizardTitle {
        title: @tr("SetupLanguage" => "Welcome");
    }

    WizardMessage {
        message: @tr("SetupLanguage" => "Welcome to the first-run setup wizard!");
    }

    WizardMessage {
        message: @tr("SetupLanguage" => "Conic Launcher is highly customizable, but the complex settings might be overwhelming.");
    }

    WizardMessage {
        message: @tr("SetupLanguage" => "This wizard will quickly walk you through some important settings so you can start playing right away.");
    }

    // The grid has to be computed here: `GridLayout` cannot do an `auto-fill`
    // track list — its `col`/`row` bindings have to be compile-time constants —
    // and a wrapping `FlexboxLayout` measures itself as √(total area) rather
    // than at the width it is given, which the `ScrollView` above asks for. So
    // the track count and the column width are worked out here instead: as many
    // 100px tracks with 8px gaps between them as fit, each then stretched over
    // what is left over.
    grid := Rectangle {
        width: 100%;
        background: transparent;
        private property <int> columns: max(1, floor((self.width + 8px) / 108px));
        private property <int> rows: ceil(root.codes.length / self.columns);
        private property <length> track-width: (self.width - (self.columns - 1) * 8px) / self.columns;
        // The 16px `margin-top` is folded into the box rather than taken as a
        // padding: a `Rectangle` has no padding, and the first row would have to
        // carry it on its own.
        height: 16px + self.rows * 42px + (self.rows - 1) * 8px;

        for code[index] in root.codes: LanguageButton {
            x: mod(index, grid.columns) * (grid.track-width + 8px);
            y: 16px + floor(index / grid.columns) * 50px;
            track-width: grid.track-width;
            code: code;
            label: root.language-label(code);
            selected: AppConfig.language == code;
        }
    }
}
