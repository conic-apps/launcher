import { Theme } from "../../theme.slint";
import { SettingGroup } from "../../components/settings/setting-group.slint";
import { SettingItem } from "../../components/settings/setting-item.slint";
import { Switch } from "../../components/controls/switch.slint";
import { PaletteRow } from "../../components/display/palette-row.slint";
import { AppConfig } from "../../globals/settings.slint";
import { WizardTitle, WizardMessage } from "wizard-text.slint";

// The appearance settings' palette group, without a title and at full width.
// `Theme.active-palette` resolves "follow system"; the tiles arm the transition.
export component SetupPalette inherits VerticalLayout {
    width: 100%;
    spacing: 0px;
    alignment: start;

    WizardTitle {
        title: @tr("SetupPalette" => "Choose a color scheme");
    }

    WizardMessage {
        message: @tr("SetupPalette" => "Conic Launcher supports multiple color schemes. Pick one that suits your style.");
    }

    VerticalLayout {
        width: 100%;
        padding-top: 16px;
        spacing: 0px;
        alignment: start;

        SettingGroup {
            // Full width: the wizard's column already has the body's 36px inset.
            width: 100%;

            SettingItem {
                group-first: true;
                title: @tr("SetupPalette" => "Follow system dark mode");
                description: @tr("SetupPalette" => "Uses Latte when the system is set to light mode, otherwise uses Mocha");
                icon: "moon";
                icon-outline: true;

                Switch {
                    checked <=> AppConfig.palette-follow-system;
                    // Arms the palette transition so this reads as a user change.
                    toggled => {
                        Theme.transitions-enabled = true;
                        AppConfig.changed();
                    }
                }
            }

            PaletteRow {
                selected: Theme.active-palette;
                swatches-disabled: AppConfig.palette-follow-system;
            }
        }
    }
}
