import { Theme } from "../../theme.slint";
import { AccountAvatar } from "../../components/display/account-avatar.slint";
import {
    AccountAdd,
} from "../../overlays/dialogs/account-add/account-add.slint";
import { GameState } from "../../globals/game.slint";
import { WizardTitle, WizardMessage } from "wizard-text.slint";

// Two states: the add-account body with no account, or the new profile card.
// `GameState` is reloaded by Rust once sign-in writes the config.
export component SetupAddAccount inherits VerticalLayout {
    width: 100%;
    spacing: 0px;
    alignment: start;
    // The paragraphs are full width, so this only centres the card.
    cross-axis-alignment: center;

    if !GameState.has-account: AccountAdd {
        content-width: root.width;
        // The wizard's close/next buttons replace the dialog's hidden "Cancel".
        wizard-host: true;
    }

    if GameState.has-account: WizardTitle {
        title: @tr("SetupAddAccount" => "Account added!");
    }

    if GameState.has-account: WizardMessage {
        width: 100%;
        message: @tr("SetupAddAccount" => "The following profile has been set as default. The launcher will use this profile to log in to the game when no profile is assigned to an instance");
    }

    // Raw surface0: the setting-item background is remapped to mantle in Latte.
    if GameState.has-account: Rectangle {
        width: 320px;
        height: card-rows.preferred-height + 48px;
        background: Theme.surface-0;
        border-radius: 12px;

        card-rows := VerticalLayout {
            x: 24px;
            y: 24px;
            width: parent.width - 48px;
            alignment: start;
            spacing: 0px;

            // No drop shadow: Slint shadows follow the box, giving a square
            // shadow behind a round avatar.
            Rectangle {
                width: 100%;
                height: 56px;
                background: transparent;

                AccountAvatar {
                    x: (parent.width - self.width) / 2;
                    y: 0px;
                    size: 56px;
                    kind: GameState.current-account-kind;
                    skin: GameState.current-account-avatar;
                }
            }

            // A layout has no margin, so the 16px gap is a spacer.
            Rectangle {
                width: 100%;
                height: 16px;
                background: transparent;
            }

            Text {
                width: 100%;
                text: GameState.current-account-name;
                font-size: 16px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
                horizontal-alignment: center;
            }

            // The profile type's 8px gap.
            Rectangle {
                width: 100%;
                height: 8px;
                background: transparent;
            }

            Text {
                width: 100%;
                text: GameState.current-account-kind == "Microsoft"
                    ? @tr("SetupAddAccount" => "Microsoft (Official account)")
                    : GameState.current-account-kind == "Yggdrasil"
                    ? @tr("SetupAddAccount" => "Yggdrasil (External login)")
                    : @tr("SetupAddAccount" => "No auth service (Offline account)");
                font-size: 13px;
                font-weight: Theme.font-weight-normal;
                // Matches the ring colours `AccountAvatar` uses.
                color: GameState.current-account-kind == "Microsoft" ? Theme.green
                    : GameState.current-account-kind == "Yggdrasil" ? Theme.yellow
                    : Theme.red;
                horizontal-alignment: center;
            }
        }
    }

    // A layout has no margin, so the 24px gap is a sibling spacer.
    if GameState.has-account: Rectangle {
        width: 0px;
        height: 24px;
        background: transparent;
    }
}
