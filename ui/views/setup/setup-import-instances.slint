import { Theme } from "../../theme.slint";
import { SetupWizardState } from "../../globals/setup.slint";
import { WizardTitle, WizardMessage } from "wizard-text.slint";

// Import button: 240x36 with a white hover/press wash over the fill.
component ImportButton inherits Rectangle {
    in property <string> text;
    /// Paints the button red, over the lavender.
    in property <bool> error: false;
    in property <bool> inactive: false;
    callback clicked;

    width: 240px;
    height: 36px;
    border-radius: 8px;
    background: root.error ? Theme.red : Theme.lavender;
    opacity: root.inactive ? 0.7 : 1.0;

    // A separate wash element, so the `error` variant can repaint the fill
    // underneath it.
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: touch.pressed ? #ffffff6f : touch.has-hover ? #ffffff2f : #ffffff00;
        animate background {
            duration: 100ms;
            easing: ease;
        }
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        vertical-alignment: center;
        horizontal-alignment: center;
        font-size: 12px;
        font-weight: Theme.font-weight-normal;
        color: Theme.text-inverse;
    }

    touch := TouchArea {
        enabled: !root.inactive;
        clicked => { root.clicked(); }
    }
}

// The "Import instances" button has no click handler yet; it is a known dead
// button.
export component SetupImportInstances inherits VerticalLayout {
    width: 100%;
    spacing: 0px;
    alignment: start;

    WizardTitle {
        title: @tr("SetupImportInstances" => "Import instances");
    }

    WizardMessage {
        message: @tr("SetupImportInstances" => "Import previously played instances from other launchers to get started quickly");
    }

    // A layout has no margin, so the 12px sits in spacers around the row.
    Rectangle {
        width: 100%;
        height: 12px;
        background: transparent;
    }

    HorizontalLayout {
        width: 100%;
        alignment: center;

        ImportButton {
            text: @tr("SetupImportInstances" => "Import instances");
        }
    }

    Rectangle {
        width: 100%;
        height: 12px;
        background: transparent;
    }

    WizardMessage {
        message: @tr("SetupImportInstances" => "If you're new to Minecraft, you can also create a blank instance with the latest version right away");
    }

    Rectangle {
        width: 100%;
        height: 12px;
        background: transparent;
    }

    HorizontalLayout {
        width: 100%;
        alignment: center;
        spacing: 16px;

        ImportButton {
            text: SetupWizardState.release-error
                ? @tr("SetupImportInstances" => "An error occurred")
                : SetupWizardState.creating-release
                ? @tr("SetupImportInstances" => "Creating...")
                : SetupWizardState.created-release != ""
                ? SetupWizardState.created-release
                : @tr("SetupImportInstances" => "Create instance with latest release");
            error: SetupWizardState.release-error;
            inactive: SetupWizardState.creating-release || SetupWizardState.release-error;
            clicked => { SetupWizardState.create-latest-release(); }
        }

        ImportButton {
            text: SetupWizardState.snapshot-error
                ? @tr("SetupImportInstances" => "An error occurred")
                : SetupWizardState.creating-snapshot
                ? @tr("SetupImportInstances" => "Creating...")
                : SetupWizardState.created-snapshot != ""
                ? SetupWizardState.created-snapshot
                : @tr("SetupImportInstances" => "Create instance with latest snapshot");
            error: SetupWizardState.snapshot-error;
            inactive: SetupWizardState.creating-snapshot || SetupWizardState.snapshot-error;
            clicked => { SetupWizardState.create-latest-snapshot(); }
        }
    }

    Rectangle {
        width: 100%;
        height: 12px;
        background: transparent;
    }
}
