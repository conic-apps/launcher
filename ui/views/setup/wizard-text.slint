import { Theme } from "../../theme.slint";

// The two paragraphs every wizard screen opens with: a lavender 22px title and a
// 13px, 1.5-line-height message.
//
// `WizardMessage` inherits `Text` rather than wrapping one, so a screen can put it
// straight into its own column: Slint measures a word-wrapping `Text` correctly only
// while the chain from the layout that owns the width is short enough, and the
// wizard's `ScrollView` measures its content height.
//
// `WizardTitle` adds a level, which is safe: every title is a single line in every
// catalogue.
export component WizardTitle inherits VerticalLayout {
    in property <string> title;

    width: 100%;
    // The 8px bottom margin, which a layout has no margin for.
    padding-bottom: 8px;
    // `start`, so the single `Text` keeps its own height instead of being given
    // the box's — the same reasoning as the wizard screens' own columns.
    alignment: start;

    Text {
        text: root.title;
        font-size: 22px;
        font-weight: Theme.font-weight-normal;
        color: Theme.lavender;
    }
}

// The 13px, 1.5-line-height paragraph the six screens share.
export component WizardMessage inherits Text {
    in property <string> message;

    text: root.message;
    font-size: 13px;
    font-weight: Theme.font-weight-normal;
    color: Theme.default-text-color.transparentize(0.1);
    wrap: word-wrap;
    // 1.18 has no `line-height`; `line-height-factor` multiplies the font's
    // natural line box (~1.115em) rather than the font size, so this comes out
    // a shade taller than the intended 19.5px.
    line-height-factor: 1.5;
}

// The warning paragraph: the same text inside a yellow hairline box.
//
// The padding is one pixel larger on every side than the text needs: a Slint border
// is drawn *inside* the box and does not inset the children. Only a graphical
// element carries a border and a fill, which is why this is a `Rectangle`.
export component WizardWarning inherits Rectangle {
    in property <string> message;

    width: 100%;
    height: warn-layout.preferred-height + 10px;
    border-width: 1px;
    border-color: Theme.yellow;
    border-radius: 4px;
    background: Theme.yellow.with-alpha(0.1);

    warn-layout := VerticalLayout {
        x: 9px;
        y: 5px;
        width: parent.width - 18px;
        alignment: start;

        Text {
            text: root.message;
            font-size: 13px;
            font-weight: Theme.font-weight-normal;
            color: Theme.default-text-color.transparentize(0.1);
            wrap: word-wrap;
            line-height-factor: 1.5;
        }
    }
}
