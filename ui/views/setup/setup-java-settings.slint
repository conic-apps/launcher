import { Theme } from "../../theme.slint";
import { AppConfig } from "../../globals/settings.slint";
import { SetupWizardState } from "../../globals/setup.slint";
import { SettingsJvm } from "../settings/settings-jvm.slint";
import { WizardTitle, WizardMessage, WizardWarning } from "wizard-text.slint";

// The settings Java section with the wizard's full-width layout and top margin.
// The body's `ScrollView` is the only scroller; a nested one would never scroll.
export component SetupJavaSettings inherits VerticalLayout {
    width: 100%;
    spacing: 0px;
    alignment: start;

    // Auto-install is pointless on a platform that cannot fetch a runtime.
    // The screen is recreated per visit, so this runs once each time.
    init => {
        if !SetupWizardState.jvm-auto-install-supported && AppConfig.prefer-mojang-java {
            AppConfig.prefer-mojang-java = false;
            AppConfig.changed();
        }
    }

    WizardTitle {
        title: @tr("SetupJavaSettings" => "Java settings");
    }

    if SetupWizardState.jvm-auto-install-supported: WizardMessage {
        message: @tr("SetupJavaSettings" => "Conic Launcher can greatly simplify Java environment configuration. Enable \"Auto-install Java runtime\" to avoid manual installation!");
    }

    if !SetupWizardState.jvm-auto-install-supported: WizardWarning {
        message: @tr("SetupJavaSettings" => "Note: Auto-installation of Java may not be available on the current platform. It is recommended to install Java manually and disable \"Auto-install Java runtime\"");
    }

    Rectangle {
        width: 100%;
        height: 16px;
        background: transparent;
    }

    SettingsJvm {
        // The wizard drops the settings page's inset.
        group-inset: 0px;
    }
}
