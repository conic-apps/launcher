import { Theme } from "../theme.slint";
import { AppIcon } from "../components/display/app-icon.slint";
import { ScrollView } from "../components/containers/scroll-view.slint";
import {
    SlideTransition,
} from "../components/containers/slide-transition.slint";
import { FocusManager } from "../globals/focus.slint";
import { Navigation } from "../globals/navigation.slint";
import { PageMotion } from "../globals/page-motion.slint";
import { AccountAddState } from "../globals/dialogs.slint";
import { SetupWizardState } from "../globals/setup.slint";
import { SetupLanguage } from "setup/setup-language.slint";
import { SetupStorage } from "setup/setup-storage.slint";
import { SetupPalette } from "setup/setup-palette.slint";
import { SetupAddAccount } from "setup/setup-add-account.slint";
import { SetupJavaSettings } from "setup/setup-java-settings.slint";
import { SetupLaunchOptions } from "setup/setup-launch-options.slint";
import { SetupImportInstances } from "setup/setup-import-instances.slint";

component FooterButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> show-icon: false;
    in property <color> fill: Theme.blue;
    in property <bool> disabled: false;
    callback clicked;

    horizontal-stretch: 1;
    height: 40px;
    border-radius: 8px;
    background: root.fill;
    opacity: root.disabled ? 0.7 : 1.0;

    // The wash sits over the fill rather than being mixed into it.
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: touch.pressed ? #ffffff6f : touch.has-hover ? #ffffff2f : #ffffff00;
        animate background {
            duration: 100ms;
            easing: ease;
        }
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        cross-axis-alignment: center;
        spacing: 4px;

        if root.show-icon: AppIcon {
            name: "chevron-back";
            size: 20px;
            // A stroked path, so the label colour is the stroke colour.
            icon-color: Theme.text-inverse;
        }

        Text {
            text: root.text;
            font-size: 13px;
            font-weight: Theme.font-weight-normal;
            color: Theme.text-inverse;
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => {
            FocusManager.clear();
            root.clicked();
        }
    }
}

// The first-run wizard: a mauve header, a step card and a bottom button bar.
// The page swap drives entrance and exit separately; the step swap plays the
// outgoing screen out before the incoming one in, like `AccountAdd`.
export component SetupView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // Driven by the app-wide page swap; "shown" is at rest.
    private property <string> motion: PageMotion.phase("setup");

    private property <length> header-inset: 100px;
    private property <length> body-inset: 186px;
    // The window minus the 100px header band and the 76px bottom area.
    private property <length> body-height: root.height - 176px;

    // The wrapper carries 8px of plain `base` below the mauve header.
    header-wrapper := Rectangle {
        x: (root.width - self.width) / 2;
        y: root.motion == "shown" ? 0px : -118px;
        width: root.width - root.header-inset;
        height: header.height + 8px;
        background: Theme.base;
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
        // The exit is defined separately (not the entrance reversed) so it can
        // be tuned on its own.
        animate y {
            duration: root.motion == "leave" ? 150ms : 330ms;
            delay: root.motion == "leave" ? 90ms : 0ms;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }

        header := Rectangle {
            width: 100%;
            height: 76px;
            background: Theme.mauve.with-alpha(0.2);
            border-width: 1px;
            border-color: Theme.mauve.with-alpha(0.2);
            border-bottom-left-radius: 12px;
            border-bottom-right-radius: 12px;

            Text {
                x: 32px;
                y: 16px;
                text: @tr("SetupView" => "First-run setup");
                font-size: 16px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
            }

            Text {
                x: 32px;
                y: 36px;
                text: @tr("SetupView" => "Customize Conic Launcher to suit your preferences");
                font-size: 12px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
            }

            close := Rectangle {
                x: parent.width - self.width - 32px;
                y: 16px;
                width: 20px;
                height: 20px;
                border-radius: 100px;
                background: close-touch.pressed ? Theme.mauve.with-alpha(0.5)
                    : close-touch.has-hover ? Theme.mauve.with-alpha(0.4)
                    : #ffffff00;
                animate background {
                    duration: 100ms;
                    easing: ease;
                }

                AppIcon {
                    x: 2px;
                    y: 2px;
                    name: "xmark";
                    size: 16px;
                    icon-color: Theme.default-text-color.transparentize(0.1);
                }

                close-touch := TouchArea {
                    clicked => {
                        FocusManager.clear();
                        root.close-add-account-host();
                        // Closing the wizard skips it: Rust keeps the defaults.
                        SetupWizardState.skip();
                        Navigation.navigate("game");
                    }
                }
            }
        }
    }

    // The padding belongs to the `ScrollView`, so its scrollbar sits at the
    // card's edge rather than 36px further in.
    body := Rectangle {
        x: (root.width - self.width) / 2;
        y: header-wrapper.height + 16px;
        width: root.width - root.body-inset;
        height: root.body-height;
        background: Theme.base.with-alpha(0.9);
        border-radius: 12px;
        clip: true;
        opacity: root.motion == "shown" ? 1.0 : 0.0;
        transform-scale: root.motion == "shown" ? 100% : 90%;
        animate opacity, transform-scale {
            duration: root.motion == "leave" ? 150ms : 330ms;
            delay: root.motion == "leave" ? 30ms : 60ms;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }

        ScrollView {
            content-column := VerticalLayout {
                padding-top: 24px;
                padding-bottom: 24px;
                padding-left: 36px;
                padding-right: 36px;
                alignment: start;

                if root.shown == "language": SlideTransition {
                    phase: root.leaving ? "leave" : root.arrive-phase;
                    direction: root.direction;
                    SetupLanguage { }
                }

                if root.shown == "storage": SlideTransition {
                    phase: root.leaving ? "leave" : root.arrive-phase;
                    direction: root.direction;
                    SetupStorage { }
                }

                if root.shown == "palette": SlideTransition {
                    phase: root.leaving ? "leave" : root.arrive-phase;
                    direction: root.direction;
                    SetupPalette { }
                }

                if root.shown == "add-account": SlideTransition {
                    phase: root.leaving ? "leave" : root.arrive-phase;
                    direction: root.direction;
                    SetupAddAccount { }
                }

                if root.shown == "java-settings": SlideTransition {
                    phase: root.leaving ? "leave" : root.arrive-phase;
                    direction: root.direction;
                    SetupJavaSettings { }
                }

                if root.shown == "launch-options": SlideTransition {
                    phase: root.leaving ? "leave" : root.arrive-phase;
                    direction: root.direction;
                    SetupLaunchOptions { }
                }

                if root.shown == "import-instances": SlideTransition {
                    phase: root.leaving ? "leave" : root.arrive-phase;
                    direction: root.direction;
                    SetupImportInstances { }
                }
            }
        }
    }

    // The storage step is dropped once answered, so a reopened wizard does not
    // ask again.
    private property <[string]> phases:
        SetupWizardState.storage-configured
        ? [
        "language",
        "palette",
        "add-account",
        "java-settings",
        "launch-options",
        "import-instances",
    ]
        : [
        "language",
        "storage",
        "palette",
        "add-account",
        "java-settings",
        "launch-options",
        "import-instances",
    ];

    /// The step the user asked for, written by `goto-step`.
    private property <int> wanted: 0;
    /// The step actually mounted, one 80ms beat behind `wanted`.
    private property <string> shown: "";
    private property <string> direction: "left";
    private property <bool> leaving: false;
    private property <bool> leave-armed: false;
    private property <bool> enter-armed: false;
    private property <string> arrive-phase: "shown";

    /// Follows the request, not the 80ms beat.
    // Keyed on the next phase's name: the optional storage step shifts indices.
    out property <string> next-label:
        root.wanted == 0 ? @tr("SetupView" => "Let's get started!")
        : root.wanted >= root.phases.length - 1 ? @tr("SetupView" => "Finish")
        : root.phases[root.wanted + 1] == "palette" ? @tr("SetupView" => "Next (Color scheme)")
        : root.phases[root.wanted + 1] == "add-account" ? @tr("SetupView" => "Next (Add account)")
        : root.phases[root.wanted + 1] == "java-settings" ? @tr("SetupView" => "Next (Java settings)")
        : root.phases[root.wanted + 1] == "launch-options" ? @tr("SetupView" => "Next (Launch options)")
        : root.phases[root.wanted + 1] == "import-instances" ? @tr("SetupView" => "Next (Import instances)")
        : @tr("SetupView" => "Next");

    // The page stack rebuilds this view on every navigation, so mount the first
    // step.
    init => {
        root.shown = root.phases[0];
    }

    // The out-in beat: mount the next step at its enter rest, then move it to
    // "shown" a frame later; an element created and finished in the same frame
    // has nothing to animate from.
    leave-timer := Timer {
        interval: 80ms;
        running: root.leave-armed;
        triggered => {
            root.leave-armed = false;
            root.leaving = false;
            if root.phases[root.wanted] != root.shown {
                root.shown = root.phases[root.wanted];
                root.arrive-phase = "enter";
                root.enter-armed = true;
            }
        }
    }

    enter-timer := Timer {
        interval: 16ms;
        running: root.enter-armed;
        triggered => {
            root.enter-armed = false;
            root.arrive-phase = "shown";
        }
    }

    /// Tears down the embedded add-account body when leaving its step.
    ///
    /// The wizard hides the dialog's "Cancel" button, so this is the only
    /// teardown left; otherwise the browser flow's loopback listener would
    /// outlive the screen. See `AccountAddState.close`.
    function close-add-account-host() {
        if root.shown == "add-account" {
            AccountAddState.close();
        }
    }

    function goto-step(index: int, towards-left: bool) {
        if index < 0 || index >= root.phases.length || index == root.wanted {
            return;
        }
        root.close-add-account-host();
        root.direction = towards-left ? "left" : "right";
        root.wanted = index;
        if root.shown == "" {
            root.shown = root.phases[index];
            return;
        }
        root.leaving = true;
        root.leave-armed = true;
        leave-timer.restart();
    }

    // The slide's offset, not the bar's position: `footer.y` follows the window's
    // bottom edge, and animating that would ease the bar into place on every
    // resize instead of letting it ride the edge being dragged.
    private property <length> footer-drop: root.motion == "shown" ? 0px : 100px;
    animate footer-drop {
        duration: root.motion == "leave" ? 150ms : 330ms;
        delay: root.motion == "leave" ? 0ms : 90ms;
        easing: cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    // No backdrop blur (Slint 1.18 has none), so content shows through.
    footer := Rectangle {
        x: 0px;
        y: root.height - self.height + root.footer-drop;
        width: 100%;
        height: 48px;
        background: Theme.surface-0.with-alpha(0.6);

        // A plain `Rectangle` has no padding, so the 40px buttons are positioned
        // with numbers: 8px above the bar, 16px from its bottom edge.
        row := HorizontalLayout {
            x: 16px;
            y: 16px - 24px;
            width: parent.width - 32px;
            height: 40px;
            spacing: 32px;

            FooterButton {
                horizontal-stretch: 0;
                width: 200px;
                text: @tr("SetupView" => "Back");
                show-icon: true;
                disabled: root.wanted == 0;
                clicked => { root.goto-step(root.wanted - 1, false); }
            }

            FooterButton {
                fill: Theme.mauve;
                text: root.next-label;
                clicked => {
                    if root.wanted < root.phases.length - 1 {
                        root.goto-step(root.wanted + 1, true);
                    } else {
                        // Commit the storage choice and setup flag, then leave.
                        SetupWizardState.finish();
                        Navigation.navigate("game");
                    }
                }
            }
        }
    }
}
