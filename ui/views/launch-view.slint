import { Theme } from "../theme.slint";
import { LaunchState } from "../globals/launch.slint";
import { Navigation } from "../globals/navigation.slint";
import { AccountAvatar } from "../components/display/account-avatar.slint";
import { Progress } from "../components/controls/progress.slint";

// The launch screen: avatar, instance name and version, progress panel, account
// summary and a cancel button, in a centred column.
//
// The entrance is two beats. From the game screen the avatar flies in from its
// footer slot, shrinking; from anywhere else it grows in at the centre. After a
// 0.17s hold the hero rises into the column's avatar slot while the other blocks
// rise or sink and fade in.
//
// Layouts own their children's `x`/`y`, so every animated element sits in a slot
// that keeps its layout box and carries the offset on a wrapper inside. The
// avatar is a single hero pinned to the page (outside the column) because it has
// to travel from the footer; it lands using the empty slot's `absolute-position`.
export component LaunchView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // `previous-page` is written before this view mounts, so it is set from the
    // first frame. The wizard never launches, but it would take the grow branch.
    private property <bool> from-game: Navigation.previous-page == "game";

    // "0" holds the first frame so the renderer sees the start values; "1" parks
    // the avatar at the centre for the hold; "2" runs the second beat.
    private property <int> intro-stage: 0;

    // Both beats are 0.3s, so one `animate` per property covers each; the second
    // timer adds the 0.17s hold.
    private property <duration> entrance-duration: 300ms;
    private property <duration> beat-two-delay: 470ms;

    // The progress block rises from below; the summary and cancel button sink
    // from above.
    private property <length> entry-rise: root.intro-stage >= 2 ? 0px : 24px;
    private property <length> entry-sink: root.intro-stage >= 2 ? 0px : -24px;
    private property <float> entry-opacity: root.intro-stage >= 2 ? 1.0 : 0.0;

    // Size and centre rather than `x`/`y`/width, so scaling about the centre is
    // one interpolation and the head never drifts.
    //
    // The two beats need different easings, and a property carries one `animate`,
    // so the hero is two boxes: the outer flies, the inner carries the rise. The
    // rise is on the inner box because Slint only evaluates a read binding; a
    // second centre would first evaluate at its target and snap instead of animating.
    private property <length> hero-size: root.intro-stage == 0
        ? (root.from-game ? 56px : 8px)
        : 48px;
    private property <length> hero-first-cx: root.intro-stage == 0
        ? (root.from-game ? 56px : root.width / 2)
        : root.width / 2;
    private property <length> hero-first-cy: root.intro-stage == 0
        ? (root.from-game ? root.height - 46px : root.height / 2)
        : root.height / 2;
    // The slot relative to the centre the flight parks at, so the offset is zero
    // through beat one.
    private property <length> hero-rise-dx: root.intro-stage >= 2
        ? root.avatar-target-x - root.width / 2
        : 0px;
    private property <length> hero-rise-dy: root.intro-stage >= 2
        ? root.avatar-target-y - root.height / 2
        : 0px;
    // Already opaque when flying from the footer; the grow-in case fades up.
    private property <float> hero-opacity: root.from-game
        ? 1.0
        : (root.intro-stage == 0 ? 0.0 : 1.0);

    // The empty slot's centre, relative to this page. Subtracting the page
    // position keeps the landing exact wherever the page stack sits.
    private property <length> avatar-target-x:
        avatar.absolute-position.x - root.absolute-position.x + avatar.width / 2;
    private property <length> avatar-target-y:
        avatar.absolute-position.y - root.absolute-position.y + avatar.height / 2;

    // Beat one's flight.
    animate hero-size, hero-first-cx, hero-first-cy, hero-opacity {
        duration: root.entrance-duration;
        easing: cubic-bezier(0.215, 0.61, 0.355, 1);
    }
    // Beat two's hero rise.
    animate hero-rise-dx, hero-rise-dy {
        duration: root.entrance-duration;
        easing: cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    animate entry-rise, entry-sink, entry-opacity {
        duration: root.entrance-duration;
        easing: cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    // Beat one. Waits for `has-instance`, which the launch flow seeds when it
    // opens the page; without it the intro would run while the column is
    // invisible.
    intro-start-timer := Timer {
        interval: 50ms;
        running: LaunchState.has-instance && root.intro-stage == 0;
        triggered => { root.intro-stage = 1; }
    }

    // Beat two: outlast beat one plus the 0.17s hold.
    intro-second-timer := Timer {
        interval: root.beat-two-delay;
        running: root.intro-stage == 1;
        triggered => { root.intro-stage = 2; }
    }

    container := VerticalLayout {
        // With no instance the screen is empty.
        visible: LaunchState.has-instance;
        // A lone layout defaults to 100% of its parent, so without these the
        // centring below collapses and the column pins to the top.
        width: self.preferred-width;
        height: self.preferred-height;
        y: (parent.height - self.height) / 2 - 16px;
        cross-axis-alignment: center;

        // The empty slot the hero lands in, and the source of its destination.
        avatar := Rectangle {
            width: 52px;
            height: 52px;
            background: transparent;
        }

        Rectangle {
            height: 16px;
        }

        // The slot keeps the layout box; the offset lives on the text.
        name-slot := Rectangle {
            width: name-text.preferred-width;
            height: name-text.height;
            opacity: root.entry-opacity;
            name-text := Text {
                y: root.entry-rise;
                height: 32px;
                text: LaunchState.instance-name;
                font-size: 32px;
                color: Theme.default-text-color.transparentize(0.1);
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 16px;
        }

        info-slot := Rectangle {
            width: info-layout.preferred-width;
            height: info-layout.preferred-height;
            opacity: root.entry-opacity;
            info-layout := HorizontalLayout {
                y: root.entry-rise;
                width: self.preferred-width;
                height: self.preferred-height;
                alignment: center;
                spacing: 16px;
                Text {
                    height: 16px;
                    text: "Minecraft " + LaunchState.minecraft-version;
                    font-size: 16px;
                    color: Theme.default-text-color.transparentize(0.1);
                    vertical-alignment: center;
                }

                if LaunchState.has-loader: Text {
                    height: 16px;
                    text: LaunchState.loader-type + " " + LaunchState.loader-version;
                    font-size: 16px;
                    color: Theme.default-text-color.transparentize(0.1);
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 16px;
        }

        // 58px, or 50px when the 2px error border shows.
        progress-slot := Rectangle {
            width: progress-container.width;
            height: progress-container.height;
            opacity: root.entry-opacity;
            progress-container := Rectangle {
                y: root.entry-rise;
                width: 340px;
                height: LaunchState.error ? 50px : 58px;
                border-radius: 8px;
                background: Theme.overlay-2.with-alpha(0.16);
                border-width: LaunchState.error ? 2px : 0px;
                border-color: Theme.red;
                clip: true;
                animate height {
                    duration: 300ms;
                    easing: ease;
                }

                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    padding-left: 32px;
                    padding-right: 32px;
                    alignment: center;

                    // Description and error swap in place; Slint has no transition
                    // groups to fade between them.
                    Text {
                        height: 14px;
                        width: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: LaunchState.error ? Theme.red : Theme.default-text-color.transparentize(0.1);
                        font-size: 14px;
                        wrap: no-wrap;
                        overflow: elide;
                        // `description()` adds the "Error: {…}" wrapper in the UI.
                        text: LaunchState.description();
                    }

                    if !LaunchState.error: Rectangle {
                        height: 10px;
                    }
                    if !LaunchState.error: Progress {
                        width: 100%;
                        loading: LaunchState.progress-loading;
                        value: LaunchState.progress-value;
                        max: LaunchState.progress-max;
                    }
                }
            }
        }

        Rectangle {
            height: 40px;
        }

        login-slot := Rectangle {
            width: login-grid.preferred-width;
            height: login-grid.preferred-height;
            opacity: root.entry-opacity;
            login-grid := GridLayout {
                y: root.entry-sink;
                width: self.preferred-width;
                height: self.preferred-height;
                spacing-horizontal: 12px;
                spacing-vertical: 6px;
                // Explicit rows, or all four cells auto-place into row 0.
                Text {
                    row: 0;
                    col: 0;
                    height: 13px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    opacity: 0.8;
                    font-size: 13px;
                    color: Theme.default-text-color.transparentize(0.1);
                    text: @tr("LaunchView" => "Auth service");
                }

                Text {
                    row: 0;
                    col: 1;
                    height: 13px;
                    vertical-alignment: center;
                    font-size: 13px;
                    color: Theme.default-text-color.transparentize(0.1);
                    text: LaunchState.account-kind;
                }

                Text {
                    row: 1;
                    col: 0;
                    height: 13px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    opacity: 0.8;
                    font-size: 13px;
                    color: Theme.default-text-color.transparentize(0.1);
                    text: @tr("LaunchView" => "Profile name");
                }

                Text {
                    row: 1;
                    col: 1;
                    height: 13px;
                    vertical-alignment: center;
                    font-size: 13px;
                    color: Theme.default-text-color.transparentize(0.1);
                    text: LaunchState.profile-name;
                }
            }
        }

        Rectangle {
            height: 36px;
        }

        back-slot := Rectangle {
            width: back-button.width;
            height: back-button.height;
            opacity: root.entry-opacity;
            back-button := Rectangle {
                y: root.entry-sink;
                width: 240px;
                height: 30px;
                border-radius: Theme.controllers-border-radius;
                border-width: 1px;
                border-color: Theme.red;
                background: back-touch.has-hover && !LaunchState.back-disabled
                    ? Theme.red
                    : Theme.surface-0;
                transform-scale: back-touch.pressed ? 98% : 100%;
                opacity: LaunchState.back-disabled ? 0.5 : 1.0;
                animate background, transform-scale {
                    duration: 200ms;
                    easing: ease;
                }

                Text {
                    text: @tr("LaunchView" => "Cancel launch");
                    font-size: 11px;
                    color: back-touch.has-hover && !LaunchState.back-disabled
                        ? Theme.text-inverse
                        : Theme.red;
                    animate color {
                        duration: 200ms;
                        easing: ease;
                    }
                }

                back-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    enabled: !LaunchState.back-disabled;
                    clicked => {
                        LaunchState.cancel();
                    }
                }
            }
        }
    }

    // The hero avatar over the column. A bare `Rectangle` takes no pointer
    // events, so it never shadows the controls. The outer box flies; the inner
    // carries the rise.
    hero := Rectangle {
        visible: LaunchState.has-instance;
        x: root.hero-first-cx - root.hero-size / 2;
        y: root.hero-first-cy - root.hero-size / 2;
        width: root.hero-size;
        height: root.hero-size;
        opacity: root.hero-opacity;

        // Read every frame, so its offset is tracked before it changes.
        hero-rise := Rectangle {
            x: root.hero-rise-dx;
            y: root.hero-rise-dy;
            width: 100%;
            height: 100%;

            AccountAvatar {
                width: 100%;
                height: 100%;
                skin: LaunchState.account-avatar;
                kind: LaunchState.account-kind;
                unlogged: !LaunchState.has-account;
            }
        }
    }
}
