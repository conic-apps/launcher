import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { AccountItem } from "../../globals/game.slint";
import { Dropdown } from "../../globals/dropdown.slint";
import { FocusManager } from "../../globals/focus.slint";

// The account switcher shared by the footer and the account view.
export component AccountListDropdown inherits Rectangle {
    in property <string> name: "";
    in property <string> kind: "";
    in property <[AccountItem]> players: [];
    in property <string> current-key: "";
    in property <string> dropdown-id: "account-switcher";
    in property <bool> show-label: true;
    in property <bool> expand-upwards: true;
    in property <string> button-icon: "chevron-up";
    in property <bool> flip-icon: true;
    /// Adds the panel's "Add account" row, reporting through `add-account`.
    in property <bool> include-add-account: false;
    /// The panel's width when it is wider than the button (the icon-only form).
    in property <length> panel-width: 0px;
    callback select(string);
    callback add-account();
    /// The name, not the switch button, was clicked.
    callback name-clicked();

    out property <bool> opened: root.is-open;

    height: 36px;
    // Avatar padding + name + gap + button. The icon-only form is just the button.
    width: root.show-label ? 32px + name-text.preferred-width + 16px + 36px : 36px;
    background: Theme.surface-0;
    border-radius: 8px;
    drop-shadow-color: #00000033;
    drop-shadow-blur: 10px;

    private property <bool> is-open: Dropdown.open && Dropdown.owner == root.dropdown-id;
    private property <float> chevron-flip: root.is-open ? 1.0 : 0.0;
    animate chevron-flip {
        duration: 200ms;
        easing: ease-in-out;
    }

    // The panel's 8px padding around rows of 26px with 4px between them:
    // `8 + 26n + 4(n-1) + 8`, a 16px constant.
    private property <int> rows: root.players.length + (root.include-add-account ? 1 : 0);
    private property <length> panel-height: root.rows * 26px
        + max(0, root.rows - 1) * 4px + 16px;
    private property <int> serial: Dropdown.choose-serial;
    changed serial => {
        if Dropdown.choose-owner == root.dropdown-id {
            if Dropdown.chosen == "__add_account__" {
                root.add-account();
            } else {
                root.select(Dropdown.chosen);
            }
        }
    }

    // The name is its own button: hover tints it, and its click opens the
    // account details. The tint is instant, and the background stays the pill's.
    name-area := Rectangle {
        x: 0;
        y: 0;
        width: parent.width - 36px;
        height: parent.height;
        visible: root.show-label;
        background: transparent;

        name-text := Text {
            text: root.name;
            font-size: 14px;
            font-weight: Theme.font-weight-normal;
            color: name-touch.has-hover ? Theme.yellow
                : Theme.default-text-color.transparentize(0.1);
            x: 32px;
        }

        name-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.name-clicked(); }
        }
    }

    switch-btn := Rectangle {
        x: parent.width - 36px;
        y: 0;
        width: 36px;
        height: parent.height;
        background: switch-touch.pressed ? Theme.overlay-0
            : switch-touch.has-hover ? Theme.surface-2
            : Theme.surface-1;
        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;
        // The icon-only form is a lone rounded button, not half a pill.
        border-top-left-radius: root.show-label ? 0px : 8px;
        border-bottom-left-radius: root.show-label ? 0px : 8px;

        AppIcon {
            name: root.button-icon;
            size: 16px;
            icon-color: Theme.default-text-color.transparentize(0.1);
            transform-scale-y: root.flip-icon
                ? (1.0 - 2.0 * root.chevron-flip) * 100%
                : 100%;
            opacity: root.flip-icon
                ? 1.0 - 0.3 * (1.0 - abs(1.0 - 2.0 * root.chevron-flip))
                : 1.0;
        }

        switch-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                FocusManager.clear();
                if (root.is-open) {
                    Dropdown.open = false;
                } else {
                    Dropdown.options = [];
                    Dropdown.accounts = root.players;
                    Dropdown.account-mode = true;
                    Dropdown.include-add-account = root.include-add-account;
                    Dropdown.current = root.current-key;
                    Dropdown.owner = root.dropdown-id;
                    Dropdown.anchor-x = root.absolute-position.x;
                    Dropdown.anchor-width = root.panel-width > 0px
                        ? root.panel-width
                        : root.width;
                    if (root.expand-upwards) {
                        Dropdown.anchor-y = root.absolute-position.y - root.panel-height - 4px;
                    } else {
                        Dropdown.anchor-y = root.absolute-position.y + root.height + 4px;
                    }
                    Dropdown.expand-upwards = root.expand-upwards;
                    Dropdown.open = true;
                }
            }
        }
    }
}
