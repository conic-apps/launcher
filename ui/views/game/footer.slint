import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { AccountAvatar } from "../../components/display/account-avatar.slint";
import { BeatMap } from "beat-map.slint";
import { MusicState } from "../../globals/music.slint";
import { AppConfig } from "../../globals/settings.slint";
import { GameState, GameIntro } from "../../globals/game.slint";
import { AccountListDropdown } from "account-list-dropdown.slint";

// A pill-shaped footer action; the label is hidden for icon-only buttons.
component FooterButton inherits Rectangle {
    in property <string> icon;
    in property <bool> show-label: false;
    in property <string> label-text: "";
    callback clicked;

    // Icon padding, plus an 8px gap and the label when labelled.
    width: root.show-label ? 54px + label.preferred-width : 46px;
    private property <length> label-width: root.show-label ? label.preferred-width : 0px;
    height: 36px;
    border-radius: 8px;
    background: button-touch.pressed ? Theme.surface-2
        : button-touch.has-hover ? Theme.surface-2.transparentize(0.2)
        : Theme.surface-1;
    drop-shadow-color: #00000033;
    drop-shadow-blur: 10px;

    HorizontalLayout {
        alignment: center;
        // An empty `Text` still has preferred width, so the label's width and
        // gap must both zero out or the icon goes off-centre. The width is its
        // own property because the button's width needs it.
        spacing: root.show-label ? 8px : 0px;
        cross-axis-alignment: center;

        AppIcon {
            name: root.icon;
            size: 22px;
            icon-color: Theme.default-text-color.transparentize(0.1);
        }

        label := Text {
            width: root.label-width;
            text: root.label-text;
            font-size: 14px;
            font-weight: Theme.font-weight-normal;
            color: Theme.default-text-color.transparentize(0.1);
            visible: root.show-label;
        }
    }

    button-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Bottom bar: account avatar + switcher, connect / new instance / install pack,
// over the background music visualizer.
export component GameFooterBar inherits Rectangle {
    width: 100%;
    height: 56px;
    background: transparent;

    // The bar slides up, then contents fade in from +10px, staggered.
    private property <duration> item-duration: 200ms;
    private property <length> intro-dy: GameIntro.played ? 0px : 56px;
    animate intro-dy {
        duration: 600ms;
        easing: ease-out-quart;
    }

    // A bare `Rectangle` takes no pointer events, so presses on empty bar space
    // would reach the card underneath. The shield swallows them; declared first
    // so the controls in `body` still get their own events.
    shield := TouchArea {
        width: root.width;
        height: root.height;
        // Accept the wheel so the list does not scroll under the bar.
        scroll-event(event) => { accept }
    }

    body := Rectangle {
        x: 0;
        y: root.intro-dy;
        width: root.width;
        height: root.height;
        background: Theme.surface-0.transparentize(0.2);

        // Declared first: it is the layer under every sibling.
        if AppConfig.show-visualizer: BeatMap {
            fill: true;
            transparent: true;
            opacity: 0.3;
            // Sizes must be given here: a percentage on a conditional child's
            // root is evaluated before its `if` wrapper has a size.
            width: parent.width;
            height: parent.height;
            resized(bar-count) => { MusicState.resized(bar-count); }
        }

        if GameState.has-account: account-layer := Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            pill := AccountListDropdown {
                // Avatar's right edge, less the 16px the pill tucks under it.
                x: 68px;
                y: -6px + self.intro-dy;
                name: GameState.current-account-name;
                kind: GameState.current-account-kind;
                players: GameState.accounts;
                current-key: GameState.current-account-key;
                include-add-account: true;
                opacity: self.intro-alpha;
                select(key) => { GameState.select-account(key); }
                add-account => { GameState.open-add-account(); }
                // The name opens the account details too, just like the avatar.
                name-clicked => { GameState.open-accounts(); }

                private property <length> intro-dy: GameIntro.played ? 0px : 10px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dy {
                    duration: root.item-duration;
                    delay: 150ms;
                    easing: ease-out-quart;
                }
                animate intro-alpha {
                    duration: root.item-duration;
                    delay: 150ms;
                    easing: ease-out-quart;
                }
            }

            connect-button := FooterButton {
                x: pill.x + pill.width + 8px;
                y: -6px + self.intro-dy;
                icon: "globe";
                opacity: self.intro-alpha;
                clicked => { GameState.open-connect(); }

                private property <length> intro-dy: GameIntro.played ? 0px : 10px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dy {
                    duration: root.item-duration;
                    delay: 200ms;
                    easing: ease-out-quart;
                }
                animate intro-alpha {
                    duration: root.item-duration;
                    delay: 200ms;
                    easing: ease-out-quart;
                }
            }
        }

        if !GameState.has-account: unlogged-layer := Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            unlogged-pill := Rectangle {
                // As the logged-in pill above.
                x: 68px;
                y: -6px + self.intro-dy;
                width: 32px + unlogged-text.preferred-width + 16px;
                height: 36px;
                border-radius: 8px;
                background: Theme.surface-0;
                drop-shadow-color: #00000033;
                drop-shadow-blur: 10px;
                opacity: self.intro-alpha;

                private property <length> intro-dy: GameIntro.played ? 0px : 10px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dy {
                    duration: root.item-duration;
                    delay: 150ms;
                    easing: ease-out-quart;
                }
                animate intro-alpha {
                    duration: root.item-duration;
                    delay: 150ms;
                    easing: ease-out-quart;
                }

                unlogged-text := Text {
                    text: @tr("Not logged in");
                    font-size: 14px;
                    font-weight: Theme.font-weight-normal;
                    color: Theme.default-text-color.transparentize(0.1);
                    x: 32px;
                }

                unlogged-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => { GameState.open-add-account(); }
                }
            }

            connect-button-unlogged := FooterButton {
                x: unlogged-pill.x + unlogged-pill.width + 8px;
                y: -6px + self.intro-dy;
                icon: "globe";
                opacity: self.intro-alpha;
                clicked => { GameState.open-connect(); }

                private property <length> intro-dy: GameIntro.played ? 0px : 10px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dy {
                    duration: root.item-duration;
                    delay: 200ms;
                    easing: ease-out-quart;
                }
                animate intro-alpha {
                    duration: root.item-duration;
                    delay: 200ms;
                    easing: ease-out-quart;
                }
            }
        }

        // Declared after the account layers so the overhanging circle paints over
        // the name pill. The compiler ignores `z` on a component root, so
        // declaration order is the z-order here.
        avatar-wrap := Rectangle {
            x: 28px;
            y: -18px + self.intro-dy;
            width: 56px;
            height: 56px;
            background: transparent;
            opacity: self.intro-alpha;

            private property <length> intro-dy: GameIntro.played ? 0px : 10px;
            private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
            animate intro-dy {
                duration: root.item-duration;
                delay: 100ms;
                easing: ease-out-quart;
            }
            animate intro-alpha {
                duration: root.item-duration;
                delay: 100ms;
                easing: ease-out-quart;
            }

            // Scale about the box centre so the circle stays put.
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: avatar-touch.pressed ? 92% : avatar-touch.has-hover ? 104% : 100%;
            animate transform-scale {
                duration: 160ms;
                easing: ease-out-quart;
            }

            AccountAvatar {
                width: 100%;
                height: 100%;
                skin: GameState.current-account-avatar;
                kind: GameState.current-account-kind;
                unlogged: !GameState.has-account;
            }

            avatar-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    if GameState.has-account {
                        GameState.open-accounts();
                    } else {
                        GameState.open-add-account();
                    }
                }
            }
        }

        install-pack-button := FooterButton {
            x: parent.width - 52px - self.width;
            y: -6px + self.intro-dy;
            icon: "package";
            opacity: self.intro-alpha;
            clicked => { GameState.open-packs(); }

            private property <length> intro-dy: GameIntro.played ? 0px : 10px;
            private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
            animate intro-dy {
                duration: root.item-duration;
                delay: 100ms;
                easing: ease-out-quart;
            }
            animate intro-alpha {
                duration: root.item-duration;
                delay: 100ms;
                easing: ease-out-quart;
            }
        }

        new-instance-button := FooterButton {
            x: install-pack-button.x - 8px - self.width;
            y: -6px + self.intro-dy;
            icon: "add";
            show-label: true;
            label-text: @tr("New instance");
            opacity: self.intro-alpha;
            clicked => { GameState.new-instance(); }

            private property <length> intro-dy: GameIntro.played ? 0px : 10px;
            private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
            animate intro-dy {
                duration: root.item-duration;
                delay: 150ms;
                easing: ease-out-quart;
            }
            animate intro-alpha {
                duration: root.item-duration;
                delay: 150ms;
                easing: ease-out-quart;
            }
        }
    }
}
