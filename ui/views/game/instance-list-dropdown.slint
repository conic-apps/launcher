import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { Dropdown, DropdownOption } from "../../globals/dropdown.slint";
import { FocusManager } from "../../globals/focus.slint";

export component InstanceListDropdown inherits Rectangle {
    in property <string> label: "";
    in property <string> selected: "";
    in property <[DropdownOption]> options: [];
    in property <string> selected-key: "";
    in property <string> dropdown-id: "instance-list";
    callback select(string);

    out property <bool> opened: root.is-open;

    // No `width`: a layout child must not bind one, or it steals the width the
    // parent layout is dividing.
    height: 25px;
    background: Theme.surface-0;
    border-radius: 4px;

    private property <bool> is-open: Dropdown.open && Dropdown.owner == root.dropdown-id;
    private property <float> chevron-flip: root.is-open ? 1.0 : 0.0;
    animate chevron-flip {
        duration: 200ms;
        easing: ease-in-out;
    }

    private property <int> serial: Dropdown.choose-serial;
    changed serial => {
        if Dropdown.choose-owner == root.dropdown-id {
            root.select(Dropdown.chosen);
        }
    }

    // The label is its own text; the selection takes the rest, with the chevron
    // 12px from the end. Sizes are explicit because this box hosts the only
    // `TouchArea`.
    head := HorizontalLayout {
        width: root.width;
        height: root.height;
        cross-axis-alignment: center;

        // `horizontal-stretch: 0` keeps the label at its own width; the default 1
        // would claim half the row from the selection.
        label-box := Rectangle {
            horizontal-stretch: 0;
            vertical-stretch: 0;
            background: Theme.surface-1;
            border-radius: 4px;

            HorizontalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                padding-left: 12px;
                padding-right: 12px;
                cross-axis-alignment: center;

                label-text := Text {
                    text: root.label;
                    font-size: 13px;
                    font-weight: Theme.font-weight-normal;
                    color: Theme.default-text-color.transparentize(0.1);
                }
            }
        }

        // The chevron's `horizontal-stretch: 0` keeps it 12px from the end.
        selected-box := Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-left: 12px;
                padding-right: 12px;
                cross-axis-alignment: center;

                Text {
                    text: root.selected;
                    font-size: 13px;
                    font-weight: Theme.font-weight-normal;
                    color: Theme.default-text-color.transparentize(0.1);
                    horizontal-stretch: 1;
                    overflow: elide;
                    wrap: no-wrap;
                }

                AppIcon {
                    name: "chevron-down";
                    horizontal-stretch: 0;
                    size: 14px;
                    icon-color: Theme.default-text-color.transparentize(0.1);
                    transform-scale-y: (1.0 - 2.0 * root.chevron-flip) * 100%;
                    opacity: 1.0 - 0.3 * (1.0 - abs(1.0 - 2.0 * root.chevron-flip));
                }
            }
        }
    }

    // Hangs off the root, not `head`: inside the layout it would consume a share
    // of the row; out here it covers the whole dropdown and costs the row nothing.
    head-touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            FocusManager.clear();
            if (root.is-open) {
                Dropdown.open = false;
            } else {
                Dropdown.options = root.options;
                Dropdown.accounts = [];
                Dropdown.account-mode = false;
                Dropdown.current = root.selected-key;
                Dropdown.owner = root.dropdown-id;
                Dropdown.anchor-x = root.absolute-position.x;
                Dropdown.anchor-y = root.absolute-position.y + root.height + 4px;
                Dropdown.anchor-width = root.width;
                Dropdown.expand-upwards = false;
                Dropdown.open = true;
            }
        }
    }
}
