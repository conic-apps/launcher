import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { Dropdown } from "../../globals/dropdown.slint";
import { FocusManager } from "../../globals/focus.slint";
import {
    GameRow,
    GameState,
    GameIntro,
    GameTime,
} from "../../globals/game.slint";
import { ScrollInput, ScrollSource } from "../../globals/scroll.slint";
import { InstancesListToolBar } from "instances-list-tool-bar.slint";

// One instance card: an outer card carrying the state colour, a content card
// offset to the right, the loader tag and the last-played line. The caller
// computes the rail x; this component owns the current card's 20px nudge.
component InstanceListCard inherits Rectangle {
    in property <GameRow> item;
    in property <length> base-x: 0px;
    /// The loader tag's colour, from `InstanceListContent.accent`.
    in property <color> accent;
    callback clicked();

    private property <length> current-shift: root.item.current ? -20px : 0px;
    animate current-shift {
        duration: 200ms;
        easing: ease;
    }

    x: root.base-x + self.current-shift;
    y: 2px;
    width: 480px;
    height: 56px;
    // One path: the outer 8px rounded rect with the content card's 6px rect
    // punched out. The subpaths wind oppositely because Slint 1.18 ignores
    // `fill-rule: evenodd`, leaving the hole under the nonzero rule. The geometry
    // must match the content card below.
    background: transparent;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale-x: card-touch.pressed && !root.item.current ? 0.99 : root.item.current ? 1.03 : 1.0;
    transform-scale-y: card-touch.pressed && !root.item.current ? 0.99 : root.item.current ? 1.03 : 1.0;
    animate transform-scale-x { duration: 100ms; }
    animate transform-scale-y { duration: 100ms; }

    Path {
        width: 100%;
        height: 100%;
        fill: root.item.current
            ? Theme.lavender.with-alpha(0.85)
            : Theme.surface-1.with-alpha(0.85);

        MoveTo {
            x: 8;
            y: 0;
        }

        LineTo {
            x: 472;
            y: 0;
        }

        ArcTo {
            radius-x: 8;
            radius-y: 8;
            x: 480;
            y: 8;
            sweep: true;
        }

        LineTo {
            x: 480;
            y: 48;
        }

        ArcTo {
            radius-x: 8;
            radius-y: 8;
            x: 472;
            y: 56;
            sweep: true;
        }

        LineTo {
            x: 8;
            y: 56;
        }

        ArcTo {
            radius-x: 8;
            radius-y: 8;
            x: 0;
            y: 48;
            sweep: true;
        }

        LineTo {
            x: 0;
            y: 8;
        }

        ArcTo {
            radius-x: 8;
            radius-y: 8;
            x: 8;
            y: 0;
            sweep: true;
        }

        Close { }

        // Counter-clockwise, so the nonzero rule leaves a hole.
        MoveTo {
            x: 22;
            y: 1;
        }

        ArcTo {
            radius-x: 6;
            radius-y: 6;
            x: 16;
            y: 7;
            sweep: false;
        }

        LineTo {
            x: 16;
            y: 49;
        }

        ArcTo {
            radius-x: 6;
            radius-y: 6;
            x: 22;
            y: 55;
            sweep: false;
        }

        LineTo {
            x: 471;
            y: 55;
        }

        ArcTo {
            radius-x: 6;
            radius-y: 6;
            x: 477;
            y: 49;
            sweep: false;
        }

        LineTo {
            x: 477;
            y: 7;
        }

        ArcTo {
            radius-x: 6;
            radius-y: 6;
            x: 471;
            y: 1;
            sweep: false;
        }

        LineTo {
            x: 22;
            y: 1;
        }

        Close { }
    }

    // The content card, raised over the punched-out outer. It clips so an
    // instance background stays inside its rounded corners.
    Rectangle {
        x: 16px;
        y: 1px;
        width: parent.width - 16px - 3px;
        height: parent.height - 2px;
        border-radius: 6px;
        clip: true;
        background: card-touch.pressed && !root.item.current ? Theme.surface-0
            : card-touch.has-hover && !root.item.current ? Theme.surface-0.with-alpha(0.8)
            : Theme.surface-0.with-alpha(0.4);

        // Starts 100px in to keep the colour strip and name clear; its left edge
        // is pre-faded in the pixels (`load_background`) to dissolve into the card.
        if root.item.has-background && root.item.background.width > 0: Image {
            x: 100px;
            y: 0;
            width: parent.width - 100px;
            height: 100%;
            source: root.item.background;
            image-fit: cover;
        }
    }

    Text {
        text: root.item.name;
        font-size: 15.2px;
        font-weight: Theme.font-weight-normal;
        color: Theme.default-text-color.transparentize(0.1);
        x: 16px + 16px;
        y: 8px;
    }

    details := HorizontalLayout {
        x: 16px + 16px;
        y: 27px;
        width: parent.width - 48px;
        height: 14px;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        tag := Rectangle {
            width: tag-text.preferred-width + 12px;
            height: 13px;
            border-radius: 100px;
            background: root.accent;
            vertical-stretch: 0;

            tag-text := Text {
                text: root.item.loader;
                font-size: 10px;
                font-weight: 700;
                color: Theme.text-inverse;
            }
        }

        HorizontalLayout {
            // No `spacing`: the label's trailing space is the only separator.
            cross-axis-alignment: center;

            Text {
                text: @tr("Last played: ");
                font-size: 10px;
                font-weight: 300;
                color: Theme.default-text-color.with-alpha(0.509);
            }

            Text {
                text: GameTime.last-played(
                    root.item.last-played-kind,
                    root.item.last-played-hours,
                    root.item.last-played-month,
                    root.item.last-played-day,
                    root.item.last-played-year,
                );
                font-size: 10px;
                font-weight: 500;
                color: Theme.default-text-color.with-alpha(0.9);
            }
        }
    }

    card-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked();
        }
    }
}

// A group header: accent bar, collapse chevron, title and count badge. The
// caller computes the rail x.
component InstanceGroupRow inherits Rectangle {
    in property <GameRow> item;
    in property <length> base-x: 0px;
    /// The group's key colour, from `InstanceListContent.accent`.
    in property <color> accent;
    callback clicked();

    x: root.base-x;
    y: 2px;
    width: 480px;
    height: 40px;
    // Same punched-out layered path as `InstanceListCard`, so the group colour
    // shows as a left strip and frame.
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        fill: root.accent.with-alpha(0.8);
        commands: "M 8 0 L 472 0 A 8 8 0 0 1 480 8 L 480 32 A 8 8 0 0 1 472 40 L 8 40 A 8 8 0 0 1 0 32 L 0 8 A 8 8 0 0 1 8 0 Z M 26 1 A 6 6 0 0 0 20 7 L 20 33 A 6 6 0 0 0 26 39 L 471 39 A 6 6 0 0 0 477 33 L 477 7 A 6 6 0 0 0 471 1 L 26 1 Z";
    }

    Rectangle {
        x: 20px;
        y: 1px;
        width: parent.width - 20px - 3px;
        height: parent.height - 2px;
        border-radius: 6px;
        background: group-touch.has-hover
            ? Theme.surface-0.with-alpha(0.8)
            : Theme.surface-0.with-alpha(0.4);
        animate background { duration: 200ms; }
    }

    AppIcon {
        name: "chevron-forward";
        size: 14px;
        icon-color: Theme.text-inverse;
        x: 4px;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: root.item.collapsed ? 0deg : 90deg;
        animate transform-rotation {
            duration: 200ms;
            easing: ease;
        }
    }

    HorizontalLayout {
        x: 20px + 16px;
        height: 14px;
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        Text {
            text: root.item.title-kind == "favorites" ? @tr("Favorites")
                : root.item.title-kind == "all" ? @tr("All instances")
                : root.item.title-literal;
            font-size: 14px;
            font-weight: Theme.font-weight-normal;
            color: Theme.default-text-color.transparentize(0.1);
        }

        count-badge := Rectangle {
            width: count-text.preferred-width + 12px;
            height: 13px;
            border-radius: 100px;
            background: root.accent;

            count-text := Text {
                text: "\{root.item.count}";
                font-size: 10px;
                font-weight: 500;
                color: Theme.text-inverse;
            }
        }
    }

    group-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.clicked();
        }
    }
}

// The scrolling content: every row laid out absolutely (Rust writes `row-y` and
// `height`) and animated along the rail. `InstancesList` owns wheel/trackpad
// input and keeps the collapse lock and selection centring.
//
// `rail-x` pulls a row left at the viewport centre and eases it back near the
// top and bottom. It depends only on the row's current y, so a row animating to
// a new slot follows the same curve the wheel draws.
component InstanceListContent inherits Rectangle {
    /// The list's smoothed scroll offset.
    in property <length> scroll-y: 0px;
    /// The rail and intro stagger are measured against this, not this element's
    /// own height (which is the whole content).
    in property <length> viewport-height: 0px;
    callback group-clicked(string);
    callback card-clicked(string);

    // The card content starts 200px in; the group box rests 40px to the left of
    // that, at 160px.
    private property <length> card-left: 200px;
    private property <length> group-left: 160px;
    // `parallaxX`: `-maxOffset * (1 - t²)` with `maxOffset = 160`.
    private property <length> rail-offset: 160px;
    // Half the group row's 42px height — the rail is sampled at the row
    // *wrapper*'s centre.
    private property <length> group-half-height: 21px;

    // Cards start 165ms in, staggered 30ms per card row (`CARD_HEIGHT`).
    private property <duration> intro-card-delay: 165ms;
    private property <duration> intro-stagger: 30ms;
    private property <length> intro-row-pitch: 58px;
    /// One step per card row the viewport holds, so taller windows spread over
    /// more steps instead of sharing the last one.
    private property <float> intro-steps: max(1, root.viewport-height / root.intro-row-pitch);
    /// Captured at entrance start: the stagger counts from the first row on
    /// screen, and capturing prevents scrolling mid-entrance from reshuffling it.
    private property <length> intro-top: 0px;

    /// Called once the list has settled, just before the entrance plays.
    public function begin-intro() {
        self.intro-top = root.scroll-y;
    }

    /// `viewport-center-y` is the row's centre on screen, so callers subtract
    /// `scroll-y` and the sign lives in one place.
    pure function rail-x(viewport-center-y: length) -> length {
        if root.viewport-height <= 0px {
            return 0px;
        }
        return -root.rail-offset * (1 - squared(clamp(
            (viewport-center-y - root.viewport-height / 2) / root.viewport-height,
            -1,
            1,
        )));
    }

    pure function squared(value: float) -> float {
        return value * value;
    }

    pure function accent(key: string) -> color {
        if key == "starred" {
            return Theme.yellow;
        }
        if key == "quilt" {
            return Theme.mauve;
        }
        if key == "fabric" {
            return Theme.yellow;
        }
        if key == "neoforge" {
            return Theme.peach;
        }
        if key == "forge" {
            return Theme.blue;
        }
        if key == "vanilla" {
            return Theme.green;
        }
        return Theme.lavender;
    }

    x: 0;
    y: -root.scroll-y;
    width: 100%;
    height: GameState.list-content-height;
    background: transparent;

    // Rust lays out row positions, so rows animate to new slots without the
    // model being rebuilt.
    for row[i] in GameState.rows: row-box := Rectangle {
        y: row.row-y;
        width: parent.width;
        height: row.height;
        background: transparent;

        // The entrance slides from +40px along the rail; a row appearing later
        // slides from +24px. Both are rail offsets, so it enters along the curve.
        //
        // The stagger counts card rows from the top of the window, not the `for`
        // index, which saturates and no longer matches visual order after a sort.
        private property <float> intro-rank: clamp(
            (row.row-y - root.intro-top) / root.intro-row-pitch,
            0,
            root.intro-steps,
        );
        private property <duration> intro-delay: root.intro-card-delay
            + self.intro-rank * root.intro-stagger;
        private property <length> intro-dx: GameIntro.played ? 0px : 40px;
        private property <length> appear-dx: row.appear ? 0px : 24px;
        private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
        private property <float> appear-alpha: row.appear ? 1.0 : 0.0;
        /// The collapse fade: a collapsed group's cards fade in place.
        private property <float> row-alpha: row.opacity;

        x: self.intro-dx + self.appear-dx;
        // Not animated: it is the product of three animated values, and a second
        // easing would make the fade lag the slide.
        opacity: self.intro-alpha * self.appear-alpha * self.row-alpha;
        // A fading row must not take clicks from what it covers.
        visible: self.opacity > 0.01;

        animate intro-dx {
            duration: 300ms;
            delay: self.intro-delay;
            easing: ease-out-quart;
        }
        animate appear-dx {
            duration: 300ms;
            easing: ease-out-quint;
        }
        animate intro-alpha {
            duration: 300ms;
            delay: self.intro-delay;
            easing: ease-out-quart;
        }
        animate appear-alpha {
            duration: 300ms;
            easing: ease-out-quint;
        }
        animate row-alpha {
            duration: 300ms;
            easing: cubic-bezier(0.33, 1, 0.68, 1);
        }
        // The FLIP: x is a pure function of y, so the row glides along the rail.
        // A reorder uses the FLIP curve (400ms); a collapse the cubic (300ms).
        animate y {
            duration: row.flip ? 400ms : 300ms;
            easing: row.flip
                ? ease-out-quint
                : cubic-bezier(0.33, 1, 0.68, 1);
        }

        if row.kind == "group": InstanceGroupRow {
            base-x: root.group-left + root.rail-x(
                row-box.y + root.group-half-height - root.scroll-y);
            item: row;
            accent: root.accent(row.key);
            clicked => {
                root.group-clicked(row.key);
            }
        }

        if row.kind == "instance": InstanceListCard {
            base-x: root.card-left + root.rail-x(
                row-box.y + row.height / 2 - root.scroll-y);
            item: row;
            accent: root.accent(row.loader-key);
            clicked => {
                root.card-clicked(row.key);
            }
        }
    }
}

// Grouped instance list, anchored so the cards peek in from the right.
//
// The rail and scrollbar follow a smoothed offset (`lerp`), driven by a `Timer`
// rather than a `Flickable`: a Flickable would add its own wheel animation and
// fight the programmatic scrolling this view needs. Wheel events bubble to the
// wrapping `TouchArea`; trackpad deltas are applied as they arrive (see
// `globals/scroll.slint`), because easing macOS momentum would stall it.
export component InstancesList inherits Rectangle {
    width: 680px;
    height: 100%;
    background: transparent;

    // Pinned against the window, below the toolbar, above the footer.
    private property <length> scrollbar-right: 8px;
    private property <length> scrollbar-width: 6px;
    private property <length> scrollbar-top: 8px + 112px + 6px;
    private property <length> scrollbar-bottom: 56px + 4px;

    /// Smoothed scroll offset; drives the rail and the scrollbar thumb.
    in-out property <length> scroll-y: 0px;
    /// Where `scroll-y` is heading.
    in-out property <length> target-y: 0px;
    /// Wheel distance multiplier; trackpad deltas are already in pixels.
    private property <float> wheel-step: 2;
    private property <length> max-scroll: max(0px, GameState.list-content-height - root.height);
    // While settling, leave the offset alone so the collapse plays out first.
    private property <length> clamped-target: root.settling
        ? root.target-y
        : clamp(root.target-y, 0px, root.max-scroll);

    // Scrolling and a second toggle are held off while a collapse/expand animates
    // (700ms and 350ms). The timers' `running` bindings drive the release;
    // `restart()` would not start a timer that was never running.
    private property <bool> settling: false;
    private property <bool> toggle-locked: false;

    scroll-unlock-timer := Timer {
        interval: 700ms;
        running: root.settling;
        triggered => { root.settling = false; }
    }

    toggle-unlock-timer := Timer {
        interval: 350ms;
        running: root.toggle-locked;
        triggered => {
            root.toggle-locked = false;
            // If the collapse shortened the list, glide up to its new end.
            root.target-y = clamp(root.target-y, 0px, root.max-scroll);
        }
    }

    // Clamp the target once, so the collapse plays first and expanding does not
    // scroll back to where it left off.
    changed max-scroll => {
        if !root.settling {
            root.target-y = clamp(root.target-y, 0px, root.max-scroll);
        }
    }

    // 16% of the remaining distance per 60Hz frame, scaled by elapsed time so
    // the glide looks the same at any frame rate.
    private property <float> lerp: 0.16;
    private property <float> last-tick-ms: 0;

    /// Catches the glide start: without it the first tick after idle would treat
    /// the whole gap as its frame time and jump.
    private property <bool> scrolling: abs(root.clamped-target - root.scroll-y) > 0.5px;
    private property <bool> dropdown-open: Dropdown.open;

    changed dropdown-open => {
        if root.dropdown-open {
            root.target-y = root.scroll-y;
        }
    }

    // Bumped after Rust re-lays out the rows, so centring reads the new row.
    private property <int> selection-serial: GameState.selection-serial;
    changed selection-serial => {
        root.scroll-to-current(true);
    }

    // Keeps an opened group's header below the floating sort/group bar.
    private property <length> group-scroll-top: 8px + 112px + 6px;
    private property <int> group-scroll-serial: GameState.group-scroll-serial;
    changed group-scroll-serial => {
        root.target-y = clamp(GameState.group-scroll-y - root.group-scroll-top, 0px, root.max-scroll);
    }

    changed scrolling => {
        if root.scrolling {
            root.last-tick-ms = ScrollInput.now-ms();
        }
    }

    scroll-timer := Timer {
        interval: 8ms;
        running: root.scrolling;
        triggered => {
            // Scale by real elapsed time so a low frame rate does not stretch the
            // glide; the upper bound only guards an event-loop stall. The target
            // is already in range, so clamping here would snap on a collapse.
            root.scroll-y = root.scroll-y + (root.clamped-target - root.scroll-y) * (1 - pow(
                1 - root.lerp,
                clamp((ScrollInput.now-ms() - root.last-tick-ms) / 1000, 0.004, 0.05) * 60,
            ));
            root.last-tick-ms = ScrollInput.now-ms();
        }
    }

    /// `smooth` glides there (selection); `!smooth` opens directly on it.
    public function scroll-to-current(smooth: bool) {
        if GameState.current-row-y >= 0px {
            root.target-y = clamp(
                GameState.current-row-y + GameState.current-row-height / 2 - root.height / 2,
                0px,
                root.max-scroll,
            );
            if !smooth {
                root.scroll-y = root.target-y;
            }
        }
    }

    // The list plays 0.05s after the footer and summary.
    private property <duration> intro-list-delay: 50ms;

    /// Called once the list has settled, just before the entrance plays.
    public function begin-intro() {
        content.begin-intro();
    }

    // `z` must be set on the instance: a component root's own `z` is only
    // honoured for `for`-loop children, and the rows scroll under the toolbar.
    InstancesListToolBar {
        x: root.width - 320px - self.width;
        y: 8px;
        z: 114;
    }

    viewport := Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        clip: true;
        background: transparent;

        scroll-touch := TouchArea {
            width: parent.width;
            height: parent.height;

            clicked => { FocusManager.clear(); }

            scroll-event(event) => {
                if Dropdown.open {
                    return accept;
                }
                if !root.settling {
                    // Alt/Option + wheel steps the selection; plain wheel only
                    // scrolls.
                    if ScrollInput.source() == ScrollSource.wheel && event.modifiers.alt {
                        if event.delta-y != 0 {
                            GameState.move-selection(event.delta-y > 0 ? -1 : 1);
                            return accept;
                        }
                    }
                    if root.max-scroll > 0px {
                        if ScrollInput.source() == ScrollSource.wheel {
                            // A notch is a distance: go into the target and ease.
                            root.target-y = clamp(
                                root.target-y - event.delta-y * root.wheel-step,
                                0px,
                                root.max-scroll,
                            );
                        } else {
                            // Trackpad deltas are the motion itself, and their
                            // momentum is macOS' own; easing it would stall on
                            // release. Writing the target drops any glide in flight.
                            root.scroll-y = clamp(
                                root.scroll-y - event.delta-y,
                                0px,
                                root.max-scroll,
                            );
                            root.target-y = root.scroll-y;
                        }
                        return accept;
                    }
                }
                reject
            }

            content := InstanceListContent {
                scroll-y: root.scroll-y;
                viewport-height: root.height;
                group-clicked(key) => {
                    // A second click mid-flight would collapse moving cards.
                    if !root.toggle-locked {
                        root.settling = true;
                        root.toggle-locked = true;
                        GameState.toggle-group(key);
                    }
                }
                card-clicked(key) => {
                    GameState.select-instance(key);
                    // Centre even when the card was already current.
                    root.scroll-to-current(true);
                }
            }
        }
    }

    // Fades and scales in on `ease-out-back`; the `if` removes it with no leave.
    if GameState.show-placeholder: placeholder := Rectangle {
        x: root.width - 320px - self.width;
        y: root.height / 2 - self.height / 2;
        width: 380px;
        height: placeholder-layout.preferred-height;
        private property <float> enter: GameState.show-placeholder ? 1.0 : 0.0;
        opacity: self.enter;
        visible: self.enter > 0.01;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale-x: 0.9 + self.enter * 0.1;
        transform-scale-y: 0.9 + self.enter * 0.1;
        animate enter {
            duration: 350ms;
            easing: ease-out-back;
        }

        placeholder-layout := VerticalLayout {
            alignment: center;
            width: parent.width;

            Rectangle {
                width: parent.width;
                height: 64px;
                background: transparent;

                AppIcon {
                    name: "about";
                    size: 64px;
                }
            }

            Rectangle {
                width: parent.width;
                height: 12px;
                background: transparent;
            }

            Text {
                text: @tr("No matching instances");
                font-size: 16px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
                horizontal-alignment: center;
                width: parent.width;
            }

            Rectangle {
                width: parent.width;
                height: 8px;
                background: transparent;
            }

            Text {
                text: @tr("Consider creating a new instance");
                font-size: 14px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
                horizontal-alignment: center;
                width: parent.width;
            }
        }
    }

    // A 6px track pinned 8px from the window's right edge (the -320px offsets
    // the view's overhang); the thumb widens on hover and can be dragged.
    scrollbar := Rectangle {
        visible: root.max-scroll > 0.5px;
        private property <length> intro-dx: GameIntro.played
            ? 0px
            : root.scrollbar-width + root.scrollbar-right;
        private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;

        x: root.width - 320px - root.scrollbar-right - root.scrollbar-width + self.intro-dx;
        y: root.scrollbar-top;
        width: root.scrollbar-width;
        height: max(0px, root.height - root.scrollbar-top - root.scrollbar-bottom);
        background: transparent;
        opacity: self.intro-alpha;
        z: 500;

        animate intro-dx {
            duration: 300ms;
            delay: root.intro-list-delay;
            easing: ease-out-quart;
        }
        animate intro-alpha {
            duration: 300ms;
            delay: root.intro-list-delay;
            easing: ease-out-quart;
        }

        private property <length> thumb-track: self.height - thumb.height;
        private property <length> track-height: self.height;

        thumb := Rectangle {
            width: track-touch.has-hover || track-touch.pressed ? 10px : 8px;
            x: track-touch.has-hover || track-touch.pressed ? -2px : 0px;
            height: root.max-scroll > 0px
                ? max(32px, parent.track-height * root.height
                / max(GameState.list-content-height, root.height))
                : parent.track-height;
            y: parent.thumb-track > 0px
                ? clamp(root.scroll-y / root.max-scroll, 0, 1) * parent.thumb-track
                : 0px;
            border-radius: 999px;
            background: Theme.text;
            opacity: track-touch.pressed ? 0.55 : track-touch.has-hover ? 0.55 : 0.35;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale-x: track-touch.pressed ? 0.9 : 1.0;
            transform-scale-y: track-touch.pressed ? 0.9 : 1.0;
            animate opacity { duration: 160ms; }
            animate width { duration: 160ms; }
            animate x { duration: 160ms; }
            animate transform-scale-x, transform-scale-y { duration: 120ms; }
        }

        // Pressing the thumb drags it; pressing the track centres the thumb under
        // the cursor and drags. Drag state is tracked here because Slint reports a
        // move with `PointerEventButton.other`. The area covers the hovered
        // thumb's 10px, including its 2px overhang, so grabbing does not shrink it.
        track-touch := TouchArea {
            x: -2px;
            width: parent.width + 4px;
            height: parent.height;

            pointer-event(event) => {
                if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                    root.dragging = false;
                } else if event.kind == PointerEventKind.down {
                    if event.button != PointerEventButton.left
                        || root.settling
                        || root.max-scroll <= 0px
                        || self.height <= thumb.height {
                        return;
                    }
                    FocusManager.clear();
                    // Thumb: keep the grab point. Track: centre under the cursor.
                    root.drag-anchor = self.mouse-y >= thumb.y && self.mouse-y <= thumb.y + thumb.height
                        ? self.mouse-y - thumb.y
                        : thumb.height / 2;
                    root.dragging = true;
                    root.drag-scrollbar(self.mouse-y);
                } else if event.kind == PointerEventKind.move && root.dragging {
                    root.drag-scrollbar(self.mouse-y);
                }
            }
        }
    }

    private property <bool> dragging: false;
    /// The grab point inside the thumb, so dragging does not make it jump.
    private property <length> drag-anchor: 0px;

    function drag-scrollbar(mouse-y: length) {
        if root.max-scroll <= 0px || scrollbar.height <= thumb.height {
            return;
        }
        root.target-y = clamp(
            (mouse-y - root.drag-anchor) / (scrollbar.height - thumb.height),
            0,
            1,
        ) * root.max-scroll;
        root.scroll-y = root.target-y;
    }
}
