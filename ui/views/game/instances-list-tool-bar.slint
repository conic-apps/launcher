import { Theme } from "../../theme.slint";
import { GameState, GameIntro } from "../../globals/game.slint";
import { DropdownOption } from "../../globals/dropdown.slint";
import { FocusManager } from "../../globals/focus.slint";
import { InstanceListDropdown } from "instance-list-dropdown.slint";

// The instance list's view controls: sorting and grouping in one compact pill
// at the top-right. The search field that used to share this panel was removed;
// the palette in the title bar is the search entry point for the whole app.
export component InstancesListToolBar inherits Rectangle {
    width: 360px;
    height: 41px;
    // The root is only the box `InstancesList` positions against; the panel with
    // the background is `body` below, because the intro animates that whole
    // element.
    background: transparent;
    // NOTE: a `z` is not set here. A component root's `z` only reaches the
    // parent's stacking order when the parent places it from a `for` loop — for
    // a plain instance the compiler's z-order pass reads the instance's own
    // binding and drops the rest. `InstancesList` sets it where the toolbar has
    // to sit above the scrolling rows.

    private property <[DropdownOption]> sort-options: [
        { key: "name", label: @tr("Name"), icon: "" },
        { key: "version", label: @tr("Version"), icon: "" },
        { key: "playtime", label: @tr("Play time"), icon: "" },
        { key: "lastplay", label: @tr("Last played"), icon: "" },
    ];
    private property <[DropdownOption]> group-options: [
        { key: "none", label: @tr("Ungrouped"), icon: "" },
        { key: "loader", label: @tr("Mod loader"), icon: "" },
    ];

    private property <string> sort-label:
    GameState.sort-mode == "name" ? @tr("Name")
        : GameState.sort-mode == "version" ? @tr("Version")
        : GameState.sort-mode == "lastplay" ? @tr("Last played")
        : @tr("Play time");
    private property <string> group-label:
    GameState.group-mode == "loader" ? @tr("Mod loader") : @tr("Ungrouped");

    // Intro: the toolbar slides in from 100px to the right over 0.5s, easing
    // out quart. It is the first beat of the list's intro, which the game view
    // starts 0.05s after the footer and the summary, so the shared delay is
    // 50ms.
    private property <length> intro-dx: GameIntro.played ? 0px : 100px;
    private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;

    animate intro-dx {
        duration: 500ms;
        delay: 50ms;
        easing: ease-out-quart;
    }
    animate intro-alpha {
        duration: 500ms;
        delay: 50ms;
        easing: ease-out-quart;
    }

    // The whole panel is one element: the intro animates it as a unit, so the
    // translucent background slides in together with the controls rather than
    // staying put under them.
    body := Rectangle {
        x: root.intro-dx;
        y: 0;
        width: root.width;
        height: root.height;
        background: Theme.surface-0.transparentize(0.6);
        border-radius: 8px;
        opacity: root.intro-alpha;
        visible: root.intro-alpha > 0.01;

        // The panel is drawn on top of the scrolling rows, but a bare
        // `Rectangle` does not take pointer events: Slint dispatches to the
        // topmost item first and falls through to the items below whenever one
        // ignores the event, so a press on the panel's empty area would reach the
        // card underneath and select it. The shield swallows it; it is declared
        // first so the controls below still get their own events.
        shield := TouchArea {
            width: parent.width;
            height: parent.height;
            // A bare `TouchArea`'s `scroll-event` defaults to `reject`, which
            // would let the wheel through to the list, so accept it to keep the
            // list from scrolling under the panel.
            scroll-event(event) => { accept }
            clicked => { FocusManager.clear(); }
        }

        // The two dropdowns split the row exactly in half. `horizontal-stretch:
        // 1` alone cannot do that: it only hands out what is left after each
        // child's preferred size, and these two prefer different widths
        // ("Sort" against "Group", "Play time" against "Ungrouped").
        //
        // So the preferred size is zero on both: equal floors plus equal
        // stretch factors make the two come out exactly equal whatever the
        // value is, and the row divides rather than packs.
        HorizontalLayout {
            width: 100%;
            height: 100%;
            padding: 8px;
            spacing: 8px;
            cross-axis-alignment: center;

            InstanceListDropdown {
                preferred-width: 0px;
                horizontal-stretch: 1;
                label: @tr("Sort");
                selected: root.sort-label;
                options: root.sort-options;
                selected-key: GameState.sort-mode;
                dropdown-id: "instance-sort";
                select(key) => { GameState.set-sort(key); }
            }

            InstanceListDropdown {
                preferred-width: 0px;
                horizontal-stretch: 1;
                label: @tr("Group");
                selected: root.group-label;
                options: root.group-options;
                selected-key: GameState.group-mode;
                dropdown-id: "instance-group";
                select(key) => { GameState.set-group-mode(key); }
            }
        }
    }
}
