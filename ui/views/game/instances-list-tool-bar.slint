import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { GameState, GameIntro } from "../../globals/game.slint";
import { DropdownOption } from "../../globals/dropdown.slint";
import { FocusManager } from "../../globals/focus.slint";
import { InstanceListDropdown } from "instance-list-dropdown.slint";

// Search + sort/group toolbar above the instance list, anchored to the
// top-right.
export component InstancesListToolBar inherits Rectangle {
    width: 400px;
    height: 112px;
    // The root is only the box `InstancesList` positions against; `body` carries
    // the background because the intro animates that whole element.
    background: transparent;
    // No `z` here: a component root's `z` is dropped on a plain instance, so
    // `InstancesList` sets the stacking order where it places the toolbar.

    private property <[DropdownOption]> sort-options: [
        { key: "name", label: @tr("Name"), icon: "" },
        { key: "version", label: @tr("Version"), icon: "" },
        { key: "playtime", label: @tr("Play time"), icon: "" },
        { key: "lastplay", label: @tr("Last played"), icon: "" },
    ];
    private property <[DropdownOption]> group-options: [
        { key: "none", label: @tr("Ungrouped"), icon: "" },
        { key: "loader", label: @tr("Mod loader"), icon: "" },
    ];

    private property <string> sort-label:
    GameState.sort-mode == "name" ? @tr("Name")
        : GameState.sort-mode == "version" ? @tr("Version")
        : GameState.sort-mode == "lastplay" ? @tr("Last played")
        : @tr("Play time");
    private property <string> group-label:
    GameState.group-mode == "loader" ? @tr("Mod loader") : @tr("Ungrouped");

    // The first beat of the list's intro, 50ms after the footer and summary.
    private property <length> intro-dx: GameIntro.played ? 0px : 100px;
    private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;

    private property <int> clear-sequence: FocusManager.clear-sequence;
    changed clear-sequence => { input.clear-focus(); }

    animate intro-dx {
        duration: 500ms;
        delay: 50ms;
        easing: ease-out-quart;
    }
    animate intro-alpha {
        duration: 500ms;
        delay: 50ms;
        easing: ease-out-quart;
    }

    // One element, so the background slides in with the controls.
    body := Rectangle {
        x: root.intro-dx;
        y: 0;
        width: root.width;
        height: root.height;
        background: Theme.surface-0.transparentize(0.6);
        border-top-left-radius: 16px;
        border-bottom-left-radius: 16px;
        opacity: root.intro-alpha;
        visible: root.intro-alpha > 0.01;

        // A bare `Rectangle` takes no pointer events, so presses on empty panel
        // space would reach the card underneath. The shield swallows them;
        // declared first so the controls below still get their own events.
        shield := TouchArea {
            width: parent.width;
            height: parent.height;
            // Accept the wheel so the list does not scroll under the panel.
            scroll-event(event) => { accept }
            clicked => { FocusManager.clear(); }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;

            search-row := HorizontalLayout {
                height: 40px;

                input-box := Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.surface-0;
                    border-top-left-radius: 8px;
                    border-bottom-left-radius: 8px;

                    HorizontalLayout {
                        padding-left: 16px;
                        cross-axis-alignment: center;

                        input := TextInput {
                            horizontal-stretch: 1;
                            text: GameState.search-query;
                            font-size: 14px;
                            selection-background-color: Theme.default-text-color.with-alpha(0.3);
                            selection-foreground-color: Theme.default-text-color;
                            single-line: true;
                            vertical-alignment: center;
                            edited => { GameState.search-changed(self.text); }
                        }
                    }

                    // `TextInput` has no placeholder, so it is drawn over the field.
                    if GameState.search-query == "" && !input.has-focus: Text {
                        x: 16px;
                        y: 0;
                        height: parent.height;
                        text: @tr("Search...");
                        font-size: 14px;
                        color: Theme.default-text-color.transparentize(0.4);
                        vertical-alignment: center;
                    }
                }

                search-button := Rectangle {
                    width: 40px;
                    background: search-touch.pressed ? Theme.surface-2
                        : search-touch.has-hover ? Theme.surface-2.transparentize(0.2)
                        : Theme.surface-1;
                    border-top-right-radius: 8px;
                    border-bottom-right-radius: 8px;

                    HorizontalLayout {
                        alignment: center;
                        cross-axis-alignment: center;

                        AppIcon {
                            name: "search";
                            size: 20px;
                        }
                    }

                    search-touch := TouchArea { }
                }
            }

            // Equal stretch alone would not split the row evenly, since the two
            // prefer different widths. Zeroing both preferred widths gives equal
            // floors, so the stretch factors divide the row exactly. Reading the
            // other's width instead would be a binding loop.
            other-row := HorizontalLayout {
                height: 25px;
                spacing: 8px;

                InstanceListDropdown {
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    label: @tr("Sort");
                    selected: root.sort-label;
                    options: root.sort-options;
                    selected-key: GameState.sort-mode;
                    dropdown-id: "instance-sort";
                    select(key) => { GameState.set-sort(key); }
                }

                InstanceListDropdown {
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    label: @tr("Group");
                    selected: root.group-label;
                    options: root.group-options;
                    selected-key: GameState.group-mode;
                    dropdown-id: "instance-group";
                    select(key) => { GameState.set-group-mode(key); }
                }
            }
        }
    }
}
