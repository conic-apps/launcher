import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { Loading } from "../../components/controls/loading.slint";
import { Progress } from "../../components/controls/progress.slint";
import {
    GameState,
    GameInstallText,
    GameIntro,
    GameTime,
} from "../../globals/game.slint";

component MetaColumn inherits Rectangle {
    in property <string> label;
    in property <string> value;

    width: layout.preferred-width;
    height: layout.preferred-height;
    background: transparent;

    layout := VerticalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        padding-left: 4px;
        padding-right: 4px;
        spacing: 2px;
        alignment: start;

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: Theme.font-weight-normal;
            color: Theme.default-text-color.with-alpha(0.8);
        }

        Text {
            text: root.value;
            font-size: 15px;
            font-weight: Theme.font-weight-normal;
            color: Theme.default-text-color.transparentize(0.1);
        }
    }
}

component MetaSeparator inherits Rectangle {
    width: 17px;
    height: 26px;
    background: transparent;

    Rectangle {
        x: 8px;
        width: 1px;
        height: 26px;
        background: Theme.surface-2;
    }
}

// One preview row of the current-instance contents list. The count and icons
// come from the same list the content overlay draws, so opening it is free.
component ContentRow inherits Rectangle {
    in property <string> icon;
    in property <string> type-label;
    in property <int> count: 0;
    /// The row's preview icons, at most five.
    in property <[image]> icons: [];
    in property <bool> loading: false;
    in property <bool> disabled: false;
    in property <string> unit: "";
    callback clicked;

    width: 400px;
    height: 36px;
    border-radius: 8px;
    background: row-touch.pressed ? Theme.surface-1
        : row-touch.has-hover ? Theme.surface-0
        : Theme.surface-0.with-alpha(0.7);
    opacity: root.disabled ? 0.6 : 1.0;
    animate background { duration: 100ms; }

    // The layout fills the row by default, so this is just its padding.
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        cross-axis-alignment: center;

        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            cross-axis-alignment: center;
            alignment: start;

            AppIcon {
                name: root.icon;
                size: 20px;
            }

            Text {
                text: root.type-label;
                font-size: 14px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
            }
        }

        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 8px;
            cross-axis-alignment: center;

            // 20px circles with a 1px lavender outline, 1px apart. Rust fills
            // them one at a time, so the row is drawn before it is finished.
            HorizontalLayout {
                spacing: 1px;
                cross-axis-alignment: center;
                for icon in root.icons: Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10000px;
                    border-width: 1px;
                    border-color: Theme.lavender.with-alpha(0.8);
                    background: Theme.surface-1;
                    clip: true;

                    Image {
                        x: 1px;
                        y: 1px;
                        width: 18px;
                        height: 18px;
                        source: icon;
                        image-fit: cover;
                    }
                }
            }

            if root.loading: Loading {
                size: 16px;
                stroke-width: 6;
            }
            if !root.loading: Text {
                text: "\{root.count} \{root.unit}";
                font-size: 14px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
            }
        }
    }

    row-touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

// One of the launch button's cross-faded faces.
//
// The icon and the label are one centred row, as in the rest of the interface.
// `pill-width` is what the pill sizes itself from: the row's own width plus the
// padding, so a longer translation widens the pill instead of being elided.
component LaunchFace inherits Rectangle {
    in property <string> icon;
    in property <length> icon-size: 20px;
    in property <string> text;
    /// Horizontal padding on each side of the icon and label. One property,
    /// because `pill-width` and the row's own box have to agree on it.
    private property <length> side-padding: 24px;
    /// The pill width this face needs. The pill takes the width of the face that
    /// is showing.
    out property <length> pill-width: content.preferred-width + root.side-padding + root.side-padding;

    width: 100%;
    height: 100%;
    background: transparent;

    content := HorizontalLayout {
        x: root.side-padding;
        y: 0;
        width: parent.width - root.side-padding - root.side-padding;
        height: 100%;
        alignment: center;
        spacing: 4px;
        cross-axis-alignment: center;

        AppIcon {
            name: root.icon;
            size: root.icon-size;
            icon-color: Theme.text-inverse;
        }

        Text {
            text: root.text;
            font-size: 15px;
            font-weight: Theme.font-weight-normal;
            color: Theme.text-inverse;
            overflow: elide;
        }
    }
}

// The install strip beside the launch button.
//
// It is a clipped box whose width the row gives it, so the strip is exactly the
// space between the button and the action icons. The contents fade in behind
// the clip and the text stays on one line, so opening and closing never reflows
// the sentence into two lines.
component InstallStrip inherits Rectangle {
    in property <bool> shown: false;
    in property <bool> queued: false;
    in property <string> text: "";

    height: 42px;
    clip: true;
    background: transparent;

    content := Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: transparent;
        opacity: root.shown ? 1.0 : 0.0;

        animate opacity {
            duration: 160ms;
            delay: root.shown ? 60ms : 0ms;
            easing: ease-out-quad;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;
            alignment: center;
            spacing: 7px;

            Text {
                width: 100%;
                height: 14px;
                text: root.text;
                font-size: 12px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.2);
                vertical-alignment: center;
                overflow: elide;
            }

            Progress {
                width: 100%;
                loading: root.queued || GameState.install-loading;
                value: GameState.install-value;
                max: GameState.install-max;
            }
        }
    }
}

// The current-instance panel: title, metadata row, launch/actions row and the
// local-content previews.
//
// The intro slides each block in, but Slint refuses `x` on a layout child, so
// each block is wrapped twice: a cell the layout positions, and inside it a
// second `Rectangle` that carries the slide offset.
export component InstanceSummary inherits Rectangle {
    // The panel is as wide as its widest block, which the layout reports.
    width: stack.preferred-width;
    height: stack.preferred-height;
    background: transparent;

    // The detail rows and content previews stagger by this.
    private property <duration> intro-stagger: 30ms;

    stack := VerticalLayout {
        spacing: 16px;
        cross-axis-alignment: start;

        row1-cell := Rectangle {
            background: transparent;
            // `cross-axis-alignment: start` sizes cells to their preferred size;
            // a `Rectangle`'s is 0, so without these the cell collapses.
            preferred-width: title1.preferred-width;
            preferred-height: title1.preferred-height;

            // The slide, one level down: Slint refuses `x` on a layout child.
            row1-slide := Rectangle {
                background: transparent;
                x: self.intro-dx;
                opacity: self.intro-alpha;

                private property <length> intro-dx: GameIntro.played ? 0px : -50px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dx {
                    duration: 330ms;
                    easing: ease-out-quart;
                }
                animate intro-alpha {
                    duration: 330ms;
                    easing: ease-out-quart;
                }

                title1 := Text {
                    text: GameState.has-current ? GameState.current-name : @tr("no instance selected!");
                    font-size: 38px;
                    font-weight: Theme.font-weight-normal;
                    color: Theme.default-text-color.transparentize(0.1);
                }
            }
        }

        row2-cell := Rectangle {
            background: transparent;
            preferred-width: row2.preferred-width;
            preferred-height: row2.preferred-height;

            row2-slide := Rectangle {
                background: transparent;
                x: self.intro-dx;
                opacity: self.intro-alpha;

                private property <length> intro-dx: GameIntro.played ? 0px : -50px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dx {
                    duration: 330ms;
                    delay: 1 * root.intro-stagger;
                    easing: ease-out-quart;
                }
                animate intro-alpha {
                    duration: 330ms;
                    delay: 1 * root.intro-stagger;
                    easing: ease-out-quart;
                }

                // `vertical-stretch: 0`: the panel's height comes from this
                // layout, so a filling child would create a binding loop.
                row2 := HorizontalLayout {
                    cross-axis-alignment: center;
                    vertical-stretch: 0;
                    horizontal-stretch: 0;

                    MetaColumn {
                        label: @tr("Minecraft version");
                        value: GameState.has-current ? GameState.current-minecraft : "--";
                    }

                    if GameState.current-has-loader: MetaSeparator { }
                    if GameState.current-has-loader: MetaColumn {
                        label: "\{GameState.current-loader} \{@tr("version")}";
                        value: GameState.current-loader-version;
                    }

                    MetaSeparator { }

                    MetaColumn {
                        label: @tr("Last played date");
                        value: GameState.has-current
                            ? GameTime.last-played(
                        GameState.current-last-played-kind,
                        GameState.current-last-played-hours,
                        GameState.current-last-played-month,
                        GameState.current-last-played-day,
                        GameState.current-last-played-year,
                        )
                            : "--";
                    }

                    if GameState.current-has-playtime: MetaSeparator { }
                    // 2px here plus the `MetaColumn`'s 4px makes a 6px gap.
                    if GameState.current-has-playtime: time-icon := HorizontalLayout {
                        cross-axis-alignment: center;
                        padding-right: 2px;

                        AppIcon {
                            name: "time";
                            size: 22px;
                        }
                    }
                    if GameState.current-has-playtime: MetaColumn {
                        label: @tr("Play time");
                        value: GameTime.play-time(GameState.current-playtime-kind, GameState.current-playtime-value);
                    }
                }
            }
        }

        row3-cell := Rectangle {
            background: transparent;
            // The row spans the content bars below, so the action icons can sit
            // on their right edge while the button keeps the width of its label.
            preferred-width: contents-cell.preferred-width;
            preferred-height: 42px;

            row3-slide := Rectangle {
                width: 100%;
                height: 100%;
                background: transparent;
                x: self.intro-dx;
                opacity: self.intro-alpha;

                private property <length> intro-dx: GameIntro.played ? 0px : -50px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dx {
                    duration: 330ms;
                    delay: 2 * root.intro-stagger;
                    easing: ease-out-quart;
                }
                animate intro-alpha {
                    duration: 330ms;
                    delay: 2 * root.intro-stagger;
                    easing: ease-out-quart;
                }

                // Centring puts the 32px pills 5px below the top of the 42px
                // launch button; pinning to the top did not.
                row3 := Rectangle {
                    width: 100%;
                    height: 42px;
                    background: transparent;

                    // The width is the showing face's own - the icon, its gap,
                    // the label and the padding - so a long translation widens
                    // the pill instead of being elided. It eases into the next
                    // state's width rather than snapping.
                    launch-button := Rectangle {
                        x: 0;
                        width: root.button-width;
                        height: parent.height;
                        border-radius: 10000px;
                        background: root.button-fill;
                        animate background, width {
                            duration: 200ms;
                            easing: ease;
                        }
                        opacity: launch-touch.pressed ? 0.9 : root.button-disabled ? 0.6 : 1.0;
                        clip: true;

                        // Three states, cross-faded: cancelling is a different
                        // intent from starting, so it gets its own face.
                        idle-face := Rectangle {
                            width: 100%;
                            height: 100%;
                            background: transparent;
                            opacity: root.button-kind == "cancel" ? 0.0 : 1.0;
                            animate opacity {
                                duration: 120ms;
                                easing: ease-out-quad;
                            }

                            idle-pill := LaunchFace {
                                icon: root.button-kind == "download" ? "download" : "play";
                                text: root.button-kind == "download"
                                    ? @tr("Download")
                                    : @tr("Launch");
                            }
                        }

                        cancel-face := Rectangle {
                            width: 100%;
                            height: 100%;
                            background: transparent;
                            opacity: root.button-kind == "cancel" ? 1.0 : 0.0;
                            animate opacity {
                                duration: 120ms;
                                easing: ease-out-quad;
                            }

                            cancel-pill := LaunchFace {
                                icon: "xmark";
                                icon-size: 18px;
                                text: @tr("Cancel");
                            }
                        }

                        launch-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            enabled: GameState.has-current;
                            clicked => {
                                if root.button-kind == "cancel" {
                                    GameState.cancel-task();
                                } else if root.button-kind == "download" {
                                    GameState.start-download();
                                } else {
                                    GameState.launch();
                                }
                            }
                        }
                    }

                    // Whatever the button and the icons leave: the progress area
                    // is the remaining space, not a width worked out from the
                    // button's own.
                    install-strip := InstallStrip {
                        x: launch-button.width + 12px;
                        y: 0;
                        width: max(0px, actions.x - 12px - self.x);
                        shown: root.task-active;
                        queued: root.task-queued;
                        text: root.strip-text;
                    }

                    actions := Rectangle {
                        // Beside the button while it is idle, on the row's right
                        // edge while the strip is open; `actions-slide` is what
                        // makes the move between the two a slide instead of a
                        // jump.
                        x: (parent.width - self.width) * root.actions-slide
                            + (launch-button.width + 16px) * (1 - root.actions-slide);
                        y: (parent.height - self.height) / 2;
                        width: 112px;
                        height: 32px;
                        background: transparent;
                        opacity: GameState.has-current ? 1.0 : 0.6;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 100px;
                                background: folder-touch.pressed ? Theme.surface-0
                                    : folder-touch.has-hover ? Theme.surface-1
                                    : transparent;

                                AppIcon {
                                    name: "folder";
                                    size: 20px;
                                }

                                folder-touch := TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    enabled: GameState.has-current;
                                    clicked => { GameState.open-instance-folder(); }
                                }
                            }

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 100px;
                                background: star-touch.pressed ? Theme.surface-0
                                    : star-touch.has-hover ? Theme.surface-1
                                    : transparent;

                                AppIcon {
                                    name: GameState.current-starred ? "star" : "star-outline";
                                    size: 20px;
                                }

                                star-touch := TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    enabled: GameState.has-current;
                                    clicked => { GameState.toggle-starred(); }
                                }
                            }

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 100px;
                                background: settings-touch.pressed ? Theme.surface-0
                                    : settings-touch.has-hover ? Theme.surface-1
                                    : transparent;

                                AppIcon {
                                    name: "settings";
                                    size: 20px;
                                }

                                settings-touch := TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    enabled: GameState.has-current;
                                    clicked => { GameState.open-instance-settings(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // The previews start one stagger after the detail rows; without an
        // instance the whole block is dimmed rather than each row.
        contents-cell := Rectangle {
            border-radius: 12px;
            background: transparent;
            preferred-width: contents.preferred-width;
            preferred-height: contents.preferred-height;

            contents-slide := Rectangle {
                background: transparent;
                x: self.intro-dx;
                opacity: (GameState.has-current ? 1.0 : 0.6) * self.intro-alpha;

                private property <length> intro-dx: GameIntro.played ? 0px : -50px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dx {
                    duration: 330ms;
                    delay: 1 * root.intro-stagger;
                    easing: ease-out-quart;
                }
                animate intro-alpha {
                    duration: 330ms;
                    delay: 1 * root.intro-stagger;
                    easing: ease-out-quart;
                }

                // The slide is on the box above, so these are just rows.
                contents := VerticalLayout {
                    padding: 4px;
                    spacing: 4px;
                    vertical-stretch: 0;
                    horizontal-stretch: 0;

                    saves-row := ContentRow {
                        height: 36px;
                        icon: "save";
                        type-label: @tr("Saves");
                        count: GameState.content-saves;
                        icons: GameState.preview-saves;
                        loading: GameState.content-loading-saves;
                        disabled: !GameState.has-current;
                        unit: GameState.count-unit;
                        clicked => { GameState.open-content("saves"); }
                    }

                    mods-row := ContentRow {
                        height: 36px;
                        icon: "extension-puzzle";
                        type-label: @tr("Mods");
                        count: GameState.content-mods;
                        icons: GameState.preview-mods;
                        loading: GameState.content-loading-mods;
                        disabled: !GameState.has-current || !GameState.current-has-loader;
                        unit: GameState.count-unit;
                        clicked => { GameState.open-content("mods"); }
                    }

                    resourcepacks-row := ContentRow {
                        height: 36px;
                        icon: "folder";
                        type-label: @tr("Resource packs");
                        count: GameState.content-resourcepacks;
                        icons: GameState.preview-resourcepacks;
                        loading: GameState.content-loading-resourcepacks;
                        disabled: !GameState.has-current;
                        unit: GameState.count-unit;
                        clicked => { GameState.open-content("resourcepacks"); }
                    }

                    screenshots-row := ContentRow {
                        height: 36px;
                        icon: "images-outline";
                        type-label: @tr("Screenshots");
                        count: GameState.content-screenshots;
                        icons: GameState.preview-screenshots;
                        loading: GameState.content-loading-screenshots;
                        disabled: !GameState.has-current || GameState.content-screenshots == 0;
                        unit: GameState.count-unit;
                        clicked => { GameState.open-content("screenshots"); }
                    }
                }
            }
        }
    }

    // The button's state, and the strip that explains it.
    //
    // `current-task` is the task centre's own view of this instance, so the
    // button follows a task that ended, was cancelled or was queued in another
    // surface; nothing here remembers anything.
    private property <bool> task-active: GameState.current-task != "idle";
    private property <bool> task-queued: GameState.current-task == "queued";
    private property <bool> button-disabled: !GameState.has-current;
    // "cancel" | "download" | "launch"
    private property <string> button-kind: root.task-active
        ? "cancel"
        : (GameState.current-installed ? "launch" : "download");
    // The fill owned by that state, so the three colours cross-fade instead of
    // snapping when the button changes what it does.
    private property <color> button-fill: root.button-kind == "download" ? Theme.blue
        : root.button-kind == "cancel" ? Theme.mauve
        : Theme.green;
    // The pill's target width, from the face that is showing. The pill animates
    // towards it; the strip and the icons read the pill's own animated width.
    private property <length> button-width: root.button-kind == "cancel"
        ? cancel-pill.pill-width
        : idle-pill.pill-width;
    // 0 while the row is idle, 1 while the strip is open. It blends the action
    // icons between beside the button and the row's right edge.
    private property <float> actions-slide: root.task-active ? 1.0 : 0.0;
    animate actions-slide {
        duration: 220ms;
        easing: ease-out-quart;
    }
    private property <string> strip-text: root.task-queued
        ? @tr("Waiting")
        : GameInstallText.description(
            GameState.install-kind,
            GameState.install-name,
            GameState.install-current,
            GameState.install-total,
            GameState.install-message);
}
