import { Theme } from "../../theme.slint";
import { MusicState } from "../../globals/music.slint";

// Audio visualizer: live spectrum bars while playing, a 2px baseline otherwise.
// The spectrum-to-bars maths lives in Rust; see `app/src/ui/overlays/music_player/`.
export component BeatMap inherits Rectangle {
    /// Take the whole container and drop the block's own border radius.
    in property <bool> fill: false;
    in property <bool> transparent: false;
    /// Live spectrum (`MusicState.live`) or the idle baseline.
    in property <bool> live: MusicState.live;
    /// One bar height per bar, 0..1 of `height`.
    in property <[float]> levels: MusicState.levels;
    /// Minimum bar width: the bar count is the container width divided by this.
    /// A plain number because Slint cannot divide one length by another.
    in property <float> min-bar-width: 8;
    /// Reports a resize; the bar count follows, and through it the analyser's
    /// resolution.
    callback resized(int);

    width: 100%;
    height: 100%;
    // Height is a state because Slint will not unify `100%` with `48px` in one
    // expression; the radius is a plain ternary.
    states [
        block when !root.fill: {
            height: 48px;
        }
    ]
    border-radius: root.fill ? 0 : 8px;
    background: (root.fill || root.transparent) ? Colors.transparent : Theme.mantle;

    private property <int> bar-count: clamp(
        floor(root.width / 1px / root.min-bar-width),
        32,
        256,
    );
    private property <length> bar-width: root.width / root.bar-count;
    /// Share of a bar's slot taken by the gap; the bar itself is what is left,
    /// so widening the gap narrows the bars without changing their count.
    private property <float> gap-ratio: 0.5;
    private property <length> bar-gap: max(1px, floor(root.bar-width * root.gap-ratio / 1px) * 1px);
    /// The floor that keeps a silent bar visible.
    private property <length> min-bar-height: 1px;
    private property <length> idle-height: 2px;

    // The width is unknown at `init`, so the count is the floor.
    init => {
        root.resized(root.bar-count);
    }

    changed bar-count => {
        root.resized(root.bar-count);
    }


    // The frame pump: the spectrum is pulled from Rust, so something must ask
    // once per frame. The item is zero-sized.
    if root.visible && root.live: Rectangle {
        x: (animation-tick() / 1s) * 1px;
        width: 0;
        height: 0;
    }

    // One bar per level. The guard agrees with the idle branch's `!live`.
    if root.live: live-bars := Rectangle {
        for level[index] in root.levels: Rectangle {
            x: floor(index * root.bar-width / 1px) * 1px;
            y: root.height - self.height;
            width: root.bar-width - root.bar-gap;
            height: max(root.min-bar-height, level * root.height);
            // Half the shorter side, so the cap is a semicircle on a grown bar
            // and the whole shape on one that has barely left the floor.
            border-radius: min(self.width, self.height) / 2;
            background: @linear-gradient(0deg, Theme.lavender 0%, Theme.lavender.mix(Theme.blue, level) 100%,);
        }
    }

    // The idle baseline. A separate loop because a gradient and a plain colour
    // do not unify into one `background` ternary.
    if !root.live: idle := Rectangle {
        for index in root.bar-count: Rectangle {
            x: floor(index * root.bar-width / 1px) * 1px;
            y: root.height - root.idle-height;
            width: root.bar-width - root.bar-gap;
            height: root.idle-height;
            border-radius: min(self.width, self.height) / 2;
            background: Theme.surface-2;
        }
    }
}
