// The multiplayer dialog's state, both the session and the manager's own
// pure-UI flags (the join-code field, the copy hint, the scan countdown).
//
// The session itself stays in Rust (`multiplayer` + `app/src/ui/overlays/dialogs/multiplayer/`),
// which is the source of truth for `state`/`room-code`/`players`/`peers`/`url`/
// `fault`; this global is the surface the dialog reads and writes.

/// One member of the room (`PlayerProfile` in the `multiplayer` crate).
export struct MultiplayerPlayer {
    machine-id: string,
    name: string,
    vendor: string,
    /// "HOST" | "LOCAL" | "GUEST".
    kind: string,
}

/// One mesh peer (`PeerInfo`), with the EasyTier NAT code the header shows.
export struct MultiplayerPeer {
    hostname: string,
    ipv4: string,
    is-local: bool,
    nat: int,
}

export global MultiplayerState {
    /// The visibility flag of the `Dialog` this extends.
    in-out property <bool> visible: false;
    /// "downloadDescription" | "downloadProgress" | "multiplayerManager".
    in-out property <string> component: "downloadDescription";

    /// "waiting" | "host-scanning" | "host-starting" | "host-ok" |
    /// "guest-connecting" | "guest-starting" | "guest-ok" | "exception" |
    /// "unknown".
    in-out property <string> state: "waiting";
    in-out property <string> room-code: "";
    in-out property <[MultiplayerPlayer]> players: [];
    in-out property <[MultiplayerPeer]> peers: [];
    in-out property <string> url: "";
    in-out property <bool> has-fault: false;
    in-out property <int> fault-code: 0;
    in-out property <string> fault-message: "";

    /// The join-code screen is up regardless of the session state.
    in-out property <bool> code-input-open: false;
    in-out property <string> code-input: "";
    /// Whether the typed code is valid; computed in Rust, since Slint has no
    /// regular expressions.
    in-out property <bool> code-input-valid: false;
    /// The "Copied!" bubble that replaces the code.
    in-out property <bool> code-copied: false;
    /// Seconds left in the scan, counted down by the manager.
    in-out property <int> scan-remaining: 60;

    /// "prepare" | "downloading" | "finished".
    in-out property <string> download-phase: "prepare";
    in-out property <bool> download-loading: true;
    in-out property <float> download-value: 0;
    in-out property <float> download-max: 0;
    /// The `formatBytes` strings beside the bar (Rust formats them, because
    /// Slint cannot print a fixed number of decimals).
    in-out property <string> download-value-text: "";
    in-out property <string> download-max-text: "";

    /// Which of the manager's seven screens is mounted.
    out property <string> screen: root.code-input-open ? "guestCodeInput"
        : root.state == "host-scanning" || root.state == "host-starting" ? "hostScan"
        : root.state == "host-ok" ? "hostReady"
        : root.state == "guest-connecting" || root.state == "guest-starting" ? "guestJoining"
        : root.state == "guest-ok" ? "guestReady"
        : root.state == "exception" ? "exception"
        // "waiting", and the fallback for an unknown state.
        : "waiting";

    /// A swap that lands on `waiting` comes from the right.
    out property <string> screen-direction: root.screen == "waiting" ? "right" : "left";

    /// The local peer's NAT code, or -1 when there is no local peer yet. Rust
    /// fills both when it publishes the peer list — Slint functions cannot loop
    /// over an array.
    in-out property <int> local-nat-code: -1;
    in-out property <bool> has-local-peer: false;

    /// The label beside "你的网络环境："; the names are library-defined and left
    /// untranslated.
    out property <string> local-nat-label: root.nat-label(root.local-nat-code);

    out property <bool> show-nat: root.has-local-peer;

    /// The bottom button's label. The join-code screen swaps the whole bar for
    /// a "Back" button.
    out property <string> bottom-label: root.screen == "waiting" || root.screen == "exception"
        ? @tr("Multiplayer" => "Close")
        : @tr("Multiplayer" => "Hide window (connection stays open)");

    /// The download screen's headline.
    out property <string> download-phase-text: root.download-phase == "finished"
        ? @tr("Multiplayer" => "Done!")
        : root.download-phase == "downloading"
            ? @tr("Multiplayer" => "Downloading the Conic Nexus extension")
            : @tr("Multiplayer" => "Preparing to download the Conic Nexus extension");

    /// The byte counter is only drawn once both values are known.
    out property <bool> show-download-bytes: root.download-value > 0 && root.download-max > 0;

    public pure function nat-label(code: int) -> string {
        if code == 0 { return "Unknown"; }
        if code == 1 { return "OpenInternet"; }
        if code == 2 { return "NoPAT"; }
        if code == 3 { return "FullCone"; }
        if code == 4 { return "Restricted"; }
        if code == 5 { return "PortRestricted"; }
        if code == 6 { return "Symmetric"; }
        if code == 7 { return "SymUdpFirewall"; }
        if code == 8 { return "SymmetricEasyInc"; }
        if code == 9 { return "SymmetricEasyDec"; }
        return "NAT" + code;
    }

    /// The footer's connect button: checks the library and opens the dialog on
    /// the manager or the download screen.
    callback open();
    /// Subscribes to the session and reads its first snapshot; named `start`
    /// because a global cannot declare a callback called `init`.
    callback start();
    /// "创建小组".
    callback create-room();
    /// "加入".
    callback join-room();
    /// "关闭连接" / "退出小组" / "取消" / "重新开始".
    callback leave-room();
    /// "点击复制".
    callback copy-room-code();
    /// The join-code field changed: recompute `code-input-valid`.
    callback code-input-changed();
    /// "开始下载".
    callback start-download();
    /// "停止下载".
    callback cancel-download();
    /// Hides the dialog (`visible = false`).
    callback close();
}
