// The overlay layer's state: one visibility flag per dialog plus the form state
// each dialog keeps.
//
// This is a global because Slint components can only be reached from Rust
// through a global, and the script that fills the version lists and creates the
// instance (`app/src/ui/overlays/dialogs/create_instance/`) has to read and write that state.

// For the OAuth callback page's palette, which is handed to `authcode`
// rather than drawn here.
import { Theme } from "../theme.slint";

/// A row of the Minecraft version chooser.
export struct MinecraftVersionItem {
    /// The version id, e.g. "1.20.1".
    id: string,
    /// `version.type` as the manifest spells it: "release", "snapshot",
    /// "old_beta" or "old_alpha".
    kind: string,
    /// The release date, split so `GameTime` can format it.
    year: int,
    month: int,
    day: int,
}

/// A row of the Yggdrasil profile chooser.
export struct YggdrasilProfileItem {
    /// The profile UUID, which the selection is keyed on.
    id: string,
    /// The profile name.
    name: string,
    /// Whether the launcher already holds this profile on this server, which
    /// the row shows as an " (added)" suffix and does not let you pick.
    added: bool,
    /// Whether the row is selected.
    selected: bool,
    /// The head `AccountAvatar` draws. Rust builds it from the profile's
    /// `textures` property, because Slint cannot crop an image itself.
    avatar: image,
}

/// The six sentences of the page the browser lands on when the OAuth redirect
/// fires (`crates/authcode/page.html`).
///
/// They live here rather than in the catalog's Rust side because this is where
/// every other string in the app lives: a `@tr` in a `.slint` file, which is
/// what the `.po` files are written against. Rust reads the struct and hands it
/// to the callback, and the page template has no sentence of its own.
export struct AuthCodePageText {
    /// Shown on `/` — the page a browser reaches without the OAuth parameters.
    waiting-title: string,
    waiting-body: string,
    /// Shown once the code has been taken.
    success-title: string,
    success-body: string,
    /// Shown when the sign-in was refused, or the callback was not ours.
    failure-title: string,
    failure-body: string,
}

/// The colours that page is drawn in, straight off the `Theme` tokens.
///
/// A struct like this rather than a read of `Theme` in Rust: `Theme` is a
/// global of the UI thread, and the listener is built on the UI thread and
/// serves from a worker, so the theme is snapshotted where it is defined
/// rather than read across that boundary. The tokens are named here so the two
/// sides cannot drift: `window` is the window's own `crust`, the `card` fields
/// are the dialog, and `success`/`danger` are the two states.
export struct AuthCodePageTheme {
    window: color,
    card: color,
    card-border: color,
    title: color,
    body: color,
    success: color,
    danger: color,
    /// Whether the palette is one of the three dark flavors, which sets the
    /// page's `color-scheme` to dark.
    dark: bool,
    /// The page's `font-family` stack. The fonts in it are embedded in the
    /// launcher binary rather than installed, so a browser resolves this to the
    /// system UI font.
    font-family: string,
}

// One visibility flag per dialog, written by whoever opens it (the footer's
// "New instance", the launch view's errors …) and by Rust (an action that
// finishes and dismisses the dialog).
export global Dialogs {
    in-out property <bool> create-instance-visible: false;
    in-out property <bool> account-add-visible: false;
    // The launch view's error dialogs. Rust raises them when a launch is
    // refused before it starts.
    in-out property <bool> no-account-error-visible: false;
    in-out property <bool> no-microsoft-account-error-visible: false;
    in-out property <bool> account-refresh-failed-visible: false;
    in-out property <bool> no-suitable-java-error-visible: false;
    // The instance settings overlay's "Delete instance" row.
    in-out property <bool> confirm-delete-instance-visible: false;
    // The saves grid's trash button.
    in-out property <bool> confirm-delete-save-visible: false;
    // The title bar's close button, while a task is running.
    in-out property <bool> confirm-quit-app-visible: false;
    // Settings → Data storage, after a location changed: the launcher has to be
    // restarted before the new root is used.
    in-out property <bool> restart-required-visible: false;
    // The account view's "Delete from Conic Launcher" row.
    in-out property <bool> confirm-delete-account-visible: false;
}

// The "delete instance" dialog.
//
// Rust fills the fields below from the instance that was current when the row
// was pressed, so there is no placeholder instance to render before it opens.
export global DeleteInstanceState {
    in-out property <string> id: "";
    in-out property <string> name: "";
    /// The mod loader's display name, empty for a vanilla instance.
    in-out property <string> loader: "";
    in-out property <string> minecraft-version: "";
    in-out property <bool> has-background: false;
    /// The instance's background picture, loaded by Rust for the same reason the
    /// settings overlay's is.
    in-out property <image> background;
    /// The play time, as `GameTime.play-time`'s two parts — the card's third
    /// detail row draws them as one string.
    in-out property <string> playtime-kind: "";
    in-out property <string> playtime-value: "";
    /// The card's playtime label. It is a `@tr` so the sentence can be
    /// translated, with the Chinese kept as the source text.
    out property <string> playtime-label: @tr("ConfirmDeleteInstance" => "游戏时间：");
    /// The dialog's warning sentence, likewise.
    out property <string> warning: @tr(
        "ConfirmDeleteInstance" => "是否确认删除此实例？实例下存档、资源包、Mod 等文件也将永久丢失 (真的很久！)"
    );

    /// A delete is running: the confirm button is disabled.
    in-out property <bool> deleting: false;
    /// The "Cancel" button.
    callback cancel();
    /// The "Confirm delete" button. Rust deletes the instance, refreshes the
    /// game view and closes the dialog.
    callback confirm();
}

// The "delete save" dialog.
//
// Rust fills the two below from the card whose trash button was pressed.
export global DeleteSaveState {
    /// The save's folder under `saves/`, which is what gets deleted.
    in-out property <string> folder: "";
    /// `level.dat`'s `Data.LevelName`, which is what the dialog names. Empty
    /// when the save has none, in which case the dialog shows the folder.
    in-out property <string> level-name: "";
    /// A delete is running: the confirm button is disabled.
    in-out property <bool> deleting: false;
    /// The "Wait a moment…" button.
    callback cancel();
    /// The "Confirm delete" button. Rust deletes the save, reloads the saves
    /// grid and closes the dialog.
    callback confirm();
}

// The "delete account" dialog.
//
// The account view's danger row sets `key`/`name` from the account it is
// showing and raises `Dialogs.confirm-delete-account-visible`.
export global DeleteAccountState {
    /// The account's stable key (`microsoft-<uuid>` etc.), which is what gets
    /// deleted.
    in-out property <string> key: "";
    /// The profile name the dialog names.
    in-out property <string> name: "";
    /// A delete is running: the confirm button is disabled.
    in-out property <bool> deleting: false;
    callback cancel();
    /// Rust deletes the account, refreshes the account list and closes both the
    /// dialog and, if the account was the last one, the account view.
    callback confirm();
}

// The "create instance" dialog.
export global CreateInstanceState {
    /// "settings" | "minecraft-choose" | "mod-loader-choose"; empty while the
    /// dialog is closed, so the step machine in `CreateInstance` unmounts
    /// everything.
    in-out property <string> step: "";

    in-out property <string> minecraft-version: "";
    /// "None" | "Fabric" | "Quilt" | "Neoforge" | "Forge"
    in-out property <string> mod-loader-type: "None";
    in-out property <string> mod-loader-version: "";
    /// What the user typed; an empty value falls back to `default-name`.
    in-out property <string> custom-name: "";
    in-out property <bool> name-editing: false;
    in-out property <bool> creating: false;
    /// The picked background file, empty when none. Rust loads it into
    /// `background-image`, because Slint can only load an image from a runtime
    /// path through Rust.
    in-out property <string> background-path: "";
    in-out property <image> background-image;

    in-out property <bool> minecraft-loading: false;
    /// The versions of the selected category, filtered by the script from the
    /// manifest. It holds ~900 versions, so they are not all instantiated as
    /// rows.
    in-out property <[MinecraftVersionItem]> minecraft-versions: [];
    /// "releases" | "snapshot" | "old".
    in-out property <string> version-category: "releases";

    in-out property <bool> fabric-loading: true;
    in-out property <bool> quilt-loading: true;
    in-out property <bool> forge-loading: true;
    in-out property <bool> neoforge-loading: true;
    in-out property <bool> fabric-available: false;
    in-out property <bool> quilt-available: false;
    in-out property <bool> forge-available: false;
    in-out property <bool> neoforge-available: false;
    /// Fabric loader versions for the chosen Minecraft version.
    in-out property <[string]> fabric-versions: [];
    in-out property <[string]> quilt-versions: [];
    /// Forge versions of the chosen Minecraft version, without the Minecraft
    /// part of the version string.
    in-out property <[string]> forge-versions: [];
    /// Neoforge versions of the chosen Minecraft version.
    in-out property <[string]> neoforge-versions: [];

    /// The name offered when the user did not type one. Rust reads it when it
    /// creates the instance.
    out property <string> default-name: (minecraft-version != ""
            ? minecraft-version
            : @tr("CreateInstance" => "Unnamed instance"))
        + (mod-loader-type.to-lowercase() == "none"
            ? ""
            : "-" + mod-loader-type.to-lowercase() + mod-loader-version);

    /// Any list still loading.
    out property <bool> mod-loader-loading: fabric-loading || quilt-loading || forge-loading
        || neoforge-loading;

    /// Which options of the mod loader select can be picked — the loaders that
    /// answered with an empty list are unavailable.
    ///
    /// Slint arrays have no `contains` — only the experimental `index-of` — so
    /// the select takes a list of flags parallel to its options instead. The
    /// order matches the select in `create-instance/create-instance.slint`.
    public pure function loader-option-enabled() -> [bool] {
        return [
            true,
            self.fabric-available,
            self.quilt-available,
            self.neoforge-available,
            self.forge-available,
        ];
    }

    /// Fetches the Mojang version manifest.
    callback load-minecraft-versions();
    /// The version category changed: re-filter the list.
    callback set-version-category(string);
    /// A version was picked: stores it and refreshes the mod loader lists.
    callback select-minecraft-version(string);
    /// The "Create instance" button: Rust creates the instance, refreshes the
    /// game view and closes the dialog.
    callback create();
    /// The "Set background image" row. The native picker's filter label is
    /// translated, so the UI passes it along.
    callback pick-background(string);
    /// The `about` button of a version row: opens the Minecraft wiki for it.
    callback open-version-wiki(string);
}

// The "add account" dialog.
export global AccountAddState {
    /// Which auth service's screen is mounted: "microsoft" | "yggdrasil" |
    /// "offline".
    in-out property <string> auth-service: "microsoft";
    /// Whether the service selector is frozen — the Microsoft screen sets it
    /// while a login runs, so its progress cannot be lost by switching away
    /// (the selector is dimmed while it is set).
    out property <bool> switch-disabled: self.ms-view == "processing";

    in-out property <string> offline-username: "";
    in-out property <string> offline-uuid: "";
    in-out property <bool> offline-advanced: false;
    /// Whether the typed UUID is malformed; only ever true in advanced mode.
    /// Rust computes it — Slint has no regular expressions.
    in-out property <bool> offline-uuid-invalid: false;
    /// Whether "Create offline profile" can be pressed. Rust computes it too:
    /// the test trims the username, and Slint has no `trim`.
    in-out property <bool> offline-can-submit: false;

    /// "auth-code" | "processing" | "device-code" | "error".
    in-out property <string> ms-view: "auth-code";
    /// Which login step is running, named after its `LoginEvent` ("prepare",
    /// "request-device-code", …). The screen turns it into text, so the
    /// translation stays in the UI.
    in-out property <string> ms-progress: "";
    /// The failure the screen reports.
    in-out property <string> ms-error: "";
    in-out property <string> ms-user-code: "";
    in-out property <string> ms-verification-uri: "";
    /// Seconds left on the device code, counted down by the screen.
    in-out property <int> ms-expires-in: 0;
    /// The two "copied!" hints, each on its own timer: the link box and the
    /// device code box.
    ///
    /// The third — the "已复制！" bubble on the "copy the link" span inside the
    /// description paragraph — has nowhere to live: it is anchored mid-`<p>` in
    /// a browser, and the paragraph is one `StyledText` here, which takes no
    /// children. `AccountAddMicrosoft.slint` says so where the link is.
    in-out property <bool> ms-copied: false;
    in-out property <bool> ms-copied-code: false;
    /// The URL the browser flow opens.
    ///
    /// It is not a constant: the code comes back on a loopback listener this app
    /// owns, and the port is the OS's choice, so Rust fills this in when it binds
    /// the listener and empties it when the flow is over. The `redirect_uri`
    /// inside it is repeated verbatim at the token endpoint (RFC 6749 §4.1.3),
    /// which is why the one string is kept whole.
    in-out property <string> auth-code-login-url: "";

    /// The callback page's six sentences, in the launcher's language.
    out property <AuthCodePageText> auth-code-page-text: {
        waiting-title: @tr("AccountAddMicrosoft" => "Waiting for the sign-in"),
        waiting-body: @tr("AccountAddMicrosoft" => "Finish signing in in your browser — this page will change when it is done."),
        success-title: @tr("AccountAddMicrosoft" => "Signed in"),
        success-body: @tr("AccountAddMicrosoft" => "You can close this tab and go back to Conic Launcher."),
        failure-title: @tr("AccountAddMicrosoft" => "Sign-in failed"),
        failure-body: @tr("AccountAddMicrosoft" => "Conic Launcher did not receive a valid sign-in. Close this tab and try again."),
    };
    /// Its colours, off the live `Theme`. Read when the listener is bound, so
    /// the tab and the window the login came from are the same palette.
    out property <AuthCodePageTheme> auth-code-page-theme: {
        window: Theme.crust,
        card: Theme.dialog-background,
        card-border: Theme.dialog-border,
        title: Theme.default-text-color.transparentize(0.1),
        body: Theme.default-text-color.transparentize(0.3),
        success: Theme.green,
        danger: Theme.red,
        dark: Theme.active-palette != "Latte",
        font-family: "'Nunito', 'Comfortaa', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif, 'Yu Gothic UI', 'Microsoft YaHei UI'",
    };

    /// "form" | "processing" | "error" | "profiles".
    in-out property <string> yggdrasil-view: "form";
    in-out property <string> yggdrasil-api-root: "";
    in-out property <string> yggdrasil-username: "";
    in-out property <string> yggdrasil-password: "";
    /// The failure the screen reports.
    in-out property <string> yggdrasil-error: "";
    /// The `meta.serverName` the API root answered with, shown under the field.
    in-out property <string> yggdrasil-server-name: "";
    /// The profiles the chooser offers.
    in-out property <[YggdrasilProfileItem]> yggdrasil-profiles: [];
    /// Whether any row is selected.
    in-out property <bool> yggdrasil-has-selection: false;
    /// Whether "Verify and add profile" can be pressed — the three fields are
    /// non-blank, after trimming, which is what Rust checks.
    in-out property <bool> yggdrasil-can-submit: false;
    /// What the screen reports when a server answered with no profiles at all.
    /// It is read by the script so the sentence stays translatable.
    out property <string> no-profile-message: @tr("AccountAddYggdrasil" => "This account has no game profile");

    /// A service button of the selector.
    callback select-auth-service(string);
    /// A "Cancel" button.
    callback close();
    /// Puts every field back to its initial state and cancels any running flow.
    /// The dialog calls it as it opens, so a previous session — including one
    /// that ended in the "saving" state — does not bleed into the next.
    callback reset();
    /// Copies `text` to the system clipboard.
    callback copy-text(string);
    /// Opens a URL with the platform's default handler.
    callback open-url(string);

    /// Resets the form to its initial state.
    callback reset-offline-form();
    /// The advanced switch was flipped: mirror the new mode into the button's
    /// state and reset the UUID field.
    callback toggle-offline-advanced();
    /// The username or the UUID field changed: recompute the derived UUID and
    /// its validity.
    callback sync-offline-uuid();
    /// "Create offline profile".
    callback add-offline-account();

    /// The "log in with a device code" link. Starts a login when none is
    /// running.
    callback use-device-code-flow();
    /// The "back to the browser" link: cancels a running device-code login and
    /// shows the browser screen again.
    callback use-auth-code-flow();
    /// A "Cancel" button of the Microsoft screen.
    callback cancel-microsoft-login();
    /// The browser screen is on show and the dialog is open: bind the loopback
    /// listener the code will come back on, and put its URL in
    /// `auth-code-login-url`. Does nothing when one is already bound, so the
    /// screen can ask for this every time it is shown.
    callback prepare-auth-code-flow();
    /// The browser screen is off, or the dialog is closed: drop the listener and
    /// the URL with it, which frees the port.
    callback release-auth-code-flow();

    /// Resets the form to its initial state.
    callback reset-yggdrasil-form();
    /// 500 ms after the API root stopped changing: look its name up.
    callback lookup-server-name();
    /// One of the three fields changed: recompute `yggdrasil-can-submit`.
    callback sync-yggdrasil-submit();
    /// "Verify and add profile".
    callback yggdrasil-login();
    /// "Add profiles", for the rows selected in the chooser.
    callback yggdrasil-add-profiles();
    /// A row of the chooser was clicked, by index.
    callback toggle-yggdrasil-profile(int);
}
