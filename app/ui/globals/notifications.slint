/// A completed notification shown by the notification centre.
export struct NotificationItem {
    id: int,
    kind: string,
    /// Literal body, empty when the kind's translated template is used.
    body: string,
    /// Values for the kind's template placeholders, in order.
    args: [string],
    icon: string,
    has-action: bool,
}

export global NotificationState {
    in-out property <bool> visible: false;
    in-out property <[NotificationItem]> notifications: [];
    in-out property <int> notification-count: 0;

    callback close();
    callback clear();
    callback dismiss(int);
    callback activate(int);
}

export global NotificationText {
    pure function arg(item: NotificationItem, index: int) -> string {
        return index < item.args.length ? item.args[index] : "";
    }

    public pure function notification-body(item: NotificationItem) -> string {
        if item.body != "" {
            return item.body;
        }
        if item.kind == "update-ready" {
            return @tr("NotificationText" => "Version {} will be applied when the launcher exits", arg(item, 0));
        }
        if item.kind == "task-error" {
            return @tr("NotificationText" => "{}", arg(item, 0));
        }
        if item.kind == "task-cancelled" {
            return @tr("NotificationText" => "The task was cancelled");
        }
        if item.kind == "task-finished" {
            return @tr("NotificationText" => "The task finished");
        }
        if item.kind == "setup-skipped" {
            return @tr("NotificationText" => "Click here to return to first-run setup");
        }
        return "";
    }
}
