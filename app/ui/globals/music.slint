// Background-music state.
//
// The audio graph lives in the `music` crate and this global carries what the
// UI reads: the playlist, the transport flags, the two clocks and the bar
// levels the footer visualizer draws. `panel-open` and `playlist-open` are the
// one piece of state that stays here rather than in Rust, because the title bar
// has to reach them.

/// One entry of the playlist, as `list_music_files` returns it.
export struct MusicTrack {
    /// The file name, which is also what the playlist and the track title show.
    name: string,
    /// Absolute path, the key the saved position is restored by.
    path: string,
}

export global MusicState {
    in-out property <[MusicTrack]> tracks: [];
    /// Which track is selected, or -1 for none.
    in-out property <int> current-index: -1;
    /// The selected track's name, empty when nothing is selected. Resolved here
    /// rather than pushed from Rust so the two cannot disagree.
    out property <string> current-name: MusicState.current-index >= 0
        && MusicState.current-index < MusicState.tracks.length
            ? MusicState.tracks[MusicState.current-index].name
            : "";

    in-out property <bool> is-playing: false;
    in-out property <bool> shuffle: false;
    in-out property <bool> repeat: false;
    /// Whether the transport is waiting on audio: a selection being opened, or
    /// the player running out of buffered samples. The audio backend cannot be
    /// asked whether it is behind, so the state is tracked here.
    in-out property <bool> buffering: false;
    /// Playback position and total length, in seconds.
    in-out property <float> current-time: 0;
    in-out property <float> duration: 0;
    /// The panel's two clocks (`mm:ss`, zero-padded, `00:00` for anything that
    /// is not a time). Composed in Rust because Slint has no number-to-string
    /// conversion.
    in-out property <string> current-time-text: "00:00";
    in-out property <string> duration-text: "00:00";
    /// 0 while the duration is unknown, so the bar is empty rather than a
    /// division by zero.
    in-out property <float> progress: 0;

    /// One bar height per bar, 0..1 of the visualizer's height, already mapped
    /// and normalised by `app/src/ui/overlays/music_player/`. The component only draws them.
    in-out property <[float]> levels: [];
    /// Whether the bars show a live spectrum or the idle baseline.
    in-out property <bool> live: false;

    in-out property <bool> panel-open: false;
    in-out property <bool> playlist-open: false;

    callback toggle-play();
    // `pause` and `resume` rather than two `toggle-play`s: the progress bar stops
    // the music for the duration of a drag and puts back what was there, and a
    // toggle would land on whatever the last seek left instead.
    callback pause();
    callback resume();
    callback play-index(int);
    callback previous();
    callback next();
    callback seek-ratio(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback open-music-folder();

    callback close-panel();
    callback toggle-playlist();

    /// The visualizer reports its bar count, which is what decides the analyser's
    /// resolution.
    callback resized(int);
}
