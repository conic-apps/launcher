// Global focus coordination.
//
// Slint only moves focus when a focusable element (TextInput) is clicked; a
// click anywhere else leaves the previously focused field focused. Every
// `BaseInput` mirrors `clear-sequence` and drops focus when it changes, so any
// interactive control (or the settings page background) can blur the active
// text field by calling `FocusManager.clear()`.
export global FocusManager {
    // Bumped whenever a click happened outside a text field.
    in-out property <int> clear-sequence: 0;

    public function clear() {
        clear-sequence += 1;
    }
}
