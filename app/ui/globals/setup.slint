// The first-run setup wizard's state.
//
// The pure UI state (which step is on screen, which way the last swap slid)
// stays in the view, and what Rust has to see or drive is a global. Only the
// import-instances screen needs the latter — it fetches the Mojang manifest and
// writes an `instance.toml`.
//
// Which step is mounted is deliberately *not* here: the swap is a transition
// whose mounted screen lags the wanted one by the 80ms leave half, and a
// `changed` handler cannot observe a global's qualified property, so the
// machine reads better next to the transition that plays it (see
// `views/setup-view.slint`).
export global SetupWizardState {
    /// Whether this machine can have a Java runtime downloaded for it: x86-64 or
    /// arm64 on Windows and macOS, and x86-64 only on Linux (the Mojang
    /// runtimes are not published for anything else).
    ///
    /// It is a platform fact, so it is answered by Rust from `platform`'s
    /// `PLATFORM_INFO` rather than worked out here.
    in property <bool> jvm-auto-install-supported: true;

    /// One of the two "create a blank instance" buttons is running.
    in-out property <bool> creating-release: false;
    in-out property <bool> creating-snapshot: false;
    /// …and failed. The flag is what turns the button red; it is never cleared,
    /// so a failed attempt stays red for the rest of the session.
    in-out property <bool> release-error: false;
    in-out property <bool> snapshot-error: false;
    /// The version the created instance is on, or empty. The button reads it as
    /// its label.
    in-out property <string> created-release: "";
    in-out property <string> created-snapshot: "";

    /// The name the release button's instance is created under. It is a
    /// `@tr` here rather than in Rust so a language change renames it with the
    /// rest of the screen — the same reason `CreateInstanceState.default-name`
    /// is a property of the view.
    out property <string> latest-release-name: @tr("SetupImportInstances" => "Latest release");
    out property <string> latest-snapshot-name: @tr("SetupImportInstances" => "Latest snapshot");

    /// Fetches the Mojang manifest and creates an instance on its latest
    /// release. Rust then refreshes the game view, which is what picks the new
    /// instance up.
    callback create-latest-release();
    /// …and the same for the latest snapshot.
    callback create-latest-snapshot();
}
