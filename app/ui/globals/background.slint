import { Theme } from "../theme.slint";

// Window background state: the layer stack the `WindowBackground` component
// reads.
//
// Rust owns all of it: it renders the 3D world and the hyperbola sky into the
// two images, decides which custom background is showing, and drives the
// cross-fade between them. `WindowBackground` is the only reader.
export global Background {
    // Two layers, composited over the window's colour in this order: the
    // hyperbola sky at 30% opacity, then the world at 30%. Both are drawn 1.08x
    // the window (the parallax wrapper's scale) with their opacity baked into
    // the pixels.
    in-out property <image> sky-image;
    in-out property <image> world-image;
    // Whether the world layer is on screen at all. False while a custom
    // background covers it, which also stops the renderer.
    in-out property <bool> world-shown: true;
    // Whether the camera is advancing right now. The component turns this into
    // a per-frame dependency (see `window-background.slint`), which is what
    // keeps Slint painting the world while it moves.
    in-out property <bool> camera-moving: false;
    // Set when the renderer has no OpenGL, so the world is not drawn at all and
    // the background is the hyperbola sky alone. The settings page greys out the
    // camera option while it is set.
    in-out property <bool> software-only: false;

    // Two slots, so one can fade in over the other. `custom-a` is the one a
    // transition starts from when both are free.
    in-out property <image> custom-a;
    in-out property <float> custom-a-alpha: 0;
    in-out property <image> custom-b;
    in-out property <float> custom-b-alpha: 0;

    /// Black over the custom background, at the user's "background darkness"
    /// percentage — and only while the *global* custom image is the one on
    /// screen.
    in-out property <float> dim-alpha: 0;

    /// Offsets of the wrapper, in logical pixels. The wrapper is scaled by 1.08
    /// and follows the pointer by up to `MAX_OFFSET` (4px) at the window edges.
    in-out property <length> parallax-x: 0px;
    in-out property <length> parallax-y: 0px;

    /// Set by Rust around a layer change. The view does not read it, so the
    /// layer alphas jump to their new values either way.
    in-out property <bool> snap: true;

    /// The palette's `crust`, the world's fill colour — read every frame, so it
    /// follows the 300ms palette transition.
    out property <color> crust: Theme.crust;
    /// Latte outlines in black, every other flavour in white.
    out property <bool> dark: Theme.active-palette != "Latte";

    /// The palette moved: the world has to be redrawn in the new colour. A
    /// palette change animates `Theme.crust` over 300ms, so this fires for each
    /// step of it and the renderer follows the colour across.
    callback theme-changed();
    changed crust => { Background.theme-changed(); }
}
