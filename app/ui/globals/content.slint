// Content overlay state.
//
// Nothing ever opens two panels at once, and the six kinds of detail panel are
// one family, so what the UI needs is an enumerable "which overlay is open"
// plus the id it shows, which a view can switch on directly.
//
// The domain state lives in Rust and is pushed in here; the view writes back
// only what is pure UI (the search box, the selected save).

// The types a laid-out body is made of. They belong to the Markdown renderer
// (`src/markdown/`), whose `.slint` files live under `ui/components/markdown/`.
// See `ui/overlays/content/markdown-body.slint` for the component that draws
// them.
import { MdItem, MarkdownImage, MdChunk } from "../components/markdown/markdown-view.slint";

/// One tag on a card. Its `kind` picks the surface colour.
export struct CardTag {
    text: string,
    /// A dimmed label drawn before the text, with no gap between them. Only the
    /// saves' "last played:" tag has one.
    label: string,
    /// "loader-fabric" | "loader-forge" | "loader-quilt" | "loader-neoforge"
    /// | "loader-liteloader" | "version" | "game-mode-survival"
    /// | "game-mode-creative" | "game-mode-adventure" | "game-mode-spectator"
    /// | "command-enabled" | "last-played" | "plain"
    kind: string,
    /// When `kind` is "last-played", the parts `GameTime.last-played` formats.
    /// The tag then draws a translated label and a translated relative time
    /// instead of `text`, which Rust could not translate — a string Rust
    /// composed is fixed when it is pushed and would not follow a language
    /// change.
    time-kind: string,
    time-hours: int,
    time-month: int,
    time-day: int,
    time-year: int,
}

/// One card of a content grid.
///
/// Its geometry is part of the row rather than derived in the view: the grid's
/// column count comes from the panel's width, so Rust lays the cards out and
/// hands each one its `x`/`y`/`width`/`height`. That keeps a resize onto the
/// *same* elements — the model is rewritten in place with `set_row_data`, so a
/// card keeps its hover, its decoded icon and any animation in flight, where a
/// model reset would re-create every one of them.
export struct ContentCard {
    x: length,
    y: length,
    width: length,
    height: length,
    /// Whether the card is drawn. Rust sets it true for every card it lays
    /// out, so no card is culled.
    in-view: bool,
    /// What `select` reports back: a Modrinth/CurseForge project id, a local
    /// file path, or a save folder name.
    id: string,
    /// The URL a card's link button opens (remote lists only).
    link: string,
    title: string,
    subtitle: string,
    /// Whether the subtitle line is drawn (a project's "by …", a save's folder
    /// name); a card without one keeps the row out of the layout rather than
    /// drawing an empty line.
    has-subtitle: bool,
    description: string,
    tags: [CardTag],
    /// The decoded icon. Rust falls back to the bundled unknown-server texture.
    icon: image,
    /// Which trailing action column the card draws: "" | "favorite" (heart +
    /// link) | "file" (folder + trash). The two buttons fade and scale in on
    /// hover.
    action-kind: string,
    /// The saves' separate play button, which floats over the icon rather than
    /// sitting in the action column. A save card draws both.
    shows-play: bool,
    favorited: bool,
    /// A disabled local mod: struck-through name behind the
    /// `[disabled] ` prefix, and the whole card dimmed.
    mod-disabled: bool,
    /// The saves' expanded state: the card lifts above its neighbours and its
    /// extra panel slides out.
    selected: bool,
    /// Whether a selected save expands upwards — set when the card sits within
    /// 160px of the bottom of the window.
    expand-up: bool,
    /// A save's spawn point, which its world map opens centred on
    /// (`level.dat`'s `Data.spawn.pos`). `0, 0` when the tag is absent, which
    /// asks the world for its own spawn. Zero on every other kind of card.
    spawn-x: int,
    spawn-z: int,
}

/// One filter chip of the search panel's filter rows.
export struct FilterChip {
    /// What `chip-clicked` reports back — the option itself, or the CurseForge
    /// category's numeric id as a string.
    value: string,
    /// The chip's label. Ignored when `translated` is set, because a label that
    /// may need translating has to be resolved in Slint: a string Rust composed
    /// is fixed at the moment it was pushed and would not follow a language
    /// change (`@tr` bindings do).
    text: string,
    /// Resolve the label through `ContentText.chip-label` from `label-key`
    /// instead of drawing `text`, so it re-translates with the locale. The key
    /// is not always the value: a CurseForge category chip carries the numeric
    /// id the API wants while its label comes from the category's slug.
    translated: bool,
    label-key: string,
    selected: bool,
    /// The selected fill: "" (lavender) | "fabric" | "forge" | "neoforge"
    /// | "quilt" | "minecraft-version" | "favorites".
    accent: string,
}

/// One filter row. The version row is the paginated one, and is the only one
/// that draws its chips in a carousel rather than wrapping.
export struct FilterRow {
    /// The row's key — "loader" | "version" | "category" — which
    /// `ContentText.row-label` turns into the label the row draws. A key rather
    /// than the text so it follows a language change.
    label: string,
    chips: [FilterChip],
    paginated: bool,
    /// The row's height, computed in Rust from the widths the chips report.
    ///
    /// A wrapping `FlexboxLayout` cannot supply it: the layout measures itself
    /// at its own *preferred* width, and for `flex-wrap: wrap` that is a
    /// deliberately "roughly square" one (`i-slint-core/layout.rs`), not the
    /// width the row actually gets. A row of Chinese category labels therefore
    /// reserved two lines where it drew one, and the rows below it sat too far
    /// down. Rust wraps the chips itself instead — same 6px gap, same 20px
    /// chips — and the height follows a language change with the labels.
    height: length,
}

/// One page button of the pagination bar. `text` is "…" for an ellipsis, which
/// is drawn as a label instead of a button.
export struct PageButton {
    text: string,
    /// -1 for the ellipsis.
    page: int,
}

/// One image of a strip whose items are a fixed height and whose width follows
/// the image's own aspect ratio — a detail panel's gallery and the screenshots
/// viewer's thumbnail row. The ratio comes from Rust, which has just decoded the
/// bitmap: Slint cannot read an image's natural size, and the two strips scale
/// it to different heights.
export struct GalleryShot {
    image: image,
    /// width / height of the decoded bitmap.
    ratio: float,
}

/// The overlay layer's state. Which panel is open, what it is showing, and the
/// grids behind it.
export global ContentState {
    /// "" | "saves" | "mods" | "resourcepacks" | "screenshots" | "packs"
    in-out property <string> open-panel: "";
    /// "" | "modrinth" | "curseforge" — the site the open detail panel belongs
    /// to; the view only reads whether it is empty.
    in-out property <string> open-detail: "";
    /// The id the open detail panel is showing — a project id either way, the
    /// CurseForge numeric id as a string.
    in-out property <string> detail-id: "";
    /// The height Rust gave the visible grid. `ContentCardGrid` takes this as
    /// its own height: the cards are positioned absolutely and an absolutely
    /// positioned child contributes nothing to its parent's measurement, so a
    /// measured height would be zero and the panel's `ScrollView` would stop
    /// scrolling.
    /// One height **per grid**, because they are not the same grid: a panel
    /// shows one list at a time, but the other lists keep loading behind it —
    /// opening Mods loads the local folder while the Modrinth search is still
    /// in the air — and a single shared height would be overwritten by
    /// whichever finished last. The remote grid then reserved the *local*
    /// folder's 3 081px for its 906px of cards, which is the blank that sat
    /// between the last row and the page bar.
    ///
    /// The four names are the four models (`Grid` in `app/src/content/`).
    in-out property <length> saves-grid-height: 0px;
    in-out property <length> local-mods-grid-height: 0px;
    in-out property <length> local-resourcepacks-grid-height: 0px;
    in-out property <length> remote-grid-height: 0px;

    /// The panel's height, written back by whichever panel is on screen. The
    /// "nothing here" placeholder covers the panel rather than its (empty) grid,
    /// so it needs a height of its own to sit in.
    in-out property <length> panel-height: 0px;

    /// A grid reports the width it has to lay out in. Rust turns it into a
    /// column count and rewrites every card's geometry, in place, so a resize
    /// moves the cards rather than re-creating them. `height` is the panel's,
    /// for the placeholder.
    callback grid-resized(length, length);

    in-out property <[ContentCard]> saves: [];
    in-out property <bool> saves-loading: false;
    in-out property <[ContentCard]> local-mods: [];
    in-out property <bool> local-mods-loading: false;
    in-out property <[ContentCard]> local-resourcepacks: [];
    in-out property <bool> local-resourcepacks-loading: false;

    // Only one sub-view is on screen at a time; switching to another resets its
    // query, page and selections, which Rust clears.
    /// Which of the open panel's sub-views is showing: "local" | "modrinth"
    /// | "curseforge". One value covers every panel because only one panel is
    /// ever open.
    in-out property <string> source: "local";
    /// "mods" | "resourcepacks" | "packs" — which panel the remote list belongs
    /// to. It decides the card's tag set and where a download lands.
    in-out property <string> remote-kind: "mods";
    in-out property <[ContentCard]> remote-cards: [];
    /// The spinner shows while there is no result yet *or* a request is in
    /// flight, so this covers both.
    in-out property <bool> remote-loading: true;

    in-out property <bool> detail-loading: false;
    in-out property <string> detail-title: "";
    in-out property <image> detail-icon;
    /// The repository URL the link opens. `detail-source-label` is its display
    /// form.
    in-out property <string> detail-source: "";
    /// "owner/repo" when the source is a GitHub URL, and the URL itself
    /// otherwise.
    in-out property <string> detail-source-label: "";
    /// Whether the source is GitHub, which decides the entry's glyph.
    in-out property <bool> detail-source-is-github: false;
    in-out property <string> detail-downloads: "";
    in-out property <string> detail-followers: "";
    in-out property <bool> detail-has-followers: false;
    in-out property <string> detail-description: "";
    /// The body, before rendering: the Markdown a Modrinth project ships, or the
    /// HTML a CurseForge project ships. Rust parses and lays it out for the
    /// width the panel gives it and fills the three properties below; the panel
    /// draws only those, and this string is never drawn.
    in-out property <string> detail-body: "";
    /// The laid-out body, as the runs a view stacks. Empty until Rust has laid it
    /// out. Each run carries its own items and bitmaps, because a run is what
    /// moves when a `<details>` above it opens or closes.
    in-out property <[MdChunk]> detail-body-chunks: [];
    /// How tall the engine laid the body out, measured *inside* the box's
    /// padding and with every `<details>` open. The box does not size itself
    /// from it — the view measures the runs as they are, so a closing section
    /// shrinks the document — but the view reads it while there are no runs to
    /// measure, which is the state between the engine answering and the rows
    /// being pushed.
    in-out property <length> detail-body-height: 0px;
    /// Which runs are open, index-aligned with `detail-body-chunks`. A run that is
    /// not a `<details>` has nothing to open and the value it holds is never read.
    ///
    /// Rust owns it so the state survives the re-layout a width change causes,
    /// seeding each section from its own `open` — a README's `<details>` has no
    /// `open` attribute, so it starts closed, as it does on GitHub.
    in-out property <[bool]> detail-body-section-open: [];
    /// A `<details>` summary row was clicked. The parameter is the run's index.
    callback body-section-toggled(int);
    /// Whether the body holds a link the pointer is over. The panel clears it
    /// when the body scrolls out from under the pointer, which is the only way
    /// a hover can outlive the item it was on.
    in-out property <string> detail-body-hovered: "";
    /// The monospace family code is drawn in, which the panel's font style does
    /// not know: Slint's `font-family` takes a name rather than a generic, so
    /// "monospace" would mean "no such family" and the view would fall back to
    /// the body face. Rust resolves it (see `monospace_family` in
    /// `content/body.rs`) and puts the answer here.
    in-out property <string> detail-body-mono-family: "";
    /// The body needs laying out for this width, in logical pixels. The view
    /// reports it because a document is a function of its width, and a width
    /// nobody is told about is a document that never re-wraps.
    ///
    /// A link in the body opens through `open-url`, the same callback the header's
    /// repository link uses, so it goes through one `open_external` path rather
    /// than two.
    callback body-resized(length);
    /// Whether the body's box is drawn even when the body is empty. The three
    /// Modrinth panels render it unconditionally — an empty one still takes a
    /// 32px box plus its 16px margin — while the CurseForge ones draw it only
    /// when there is a description. Rust sets this from the platform it loaded.
    in-out property <bool> detail-body-always: false;
    in-out property <[GalleryShot]> detail-gallery: [];
    in-out property <bool> detail-favorited: false;
    /// The heart + download/remove row is the mod detail panels'; the pack and
    /// resource-pack ones have no remove, and only the mods are "installed".
    in-out property <bool> detail-has-install: true;
    in-out property <bool> detail-installed: false;
    in-out property <string> detail-installed-version: "";
    in-out property <bool> detail-checking-installed: false;
    in-out property <bool> detail-operating: false;
    /// Whether this detail panel has an installed state at all. The mod panels
    /// offer a remove button; the pack and resource-pack ones only ever draw a
    /// download button.
    in-out property <bool> detail-can-remove: true;

    in-out property <[GalleryShot]> screenshots: [];
    in-out property <bool> screenshots-loading: false;
    in-out property <int> screenshot-index: 0;
    /// The image the stage shows, which is `screenshots[screenshot-index]` —
    /// kept as its own property because a model index inside a binding would
    /// re-read the whole model.
    in-out property <image> current-screenshot;

    /// Closes whichever panel is open (the scrim click, and Escape).
    callback close();
    /// A detail panel was closed, leaving the list underneath open.
    callback close-detail();
    /// The mods/resource-packs/packs panels' source switcher.
    callback set-source(string);
    /// A card was clicked. `id` is the card's id.
    callback select-card(string);
    /// The saves' folder button, the local mods' folder button.
    callback open-path(string);
    /// A local mod's / resource pack's / pack's delete button.
    ///
    /// The saves grid does not come through here: it goes to
    /// `request-delete-save` first, because its button is the only destructive
    /// one in the content layer and it asks before it acts. This one is wired to
    /// the local mods' and resource packs' buttons, which are inert: they have
    /// no click handler.
    callback delete-save(string);
    /// The saves' delete button: opens `ConfirmDeleteSave` rather than deleting.
    /// `folder` is the card's id, `level-name` what the dialog names it by.
    callback request-delete-save(string, string);
    /// The remote grids' link button / the detail panel's source link.
    callback open-url(string);
    callback toggle-favorite(string);
    callback download();
    callback remove();
    /// A save was selected (or deselected, with an empty id).
    callback select-save(string);
    /// The screenshots viewer.
    callback set-screenshot(int);
    callback screenshot-next();
    callback screenshot-prev();
}

/// The search panel's own state, for whichever remote list is on screen.
///
/// Kept apart from `ContentState` because it is a self-contained form: the
/// query, the three filter rows, the version carousel's page, and the result
/// pages. Rust fills `filters` and `pages` and reads back what the user picked.
export global ContentSearch {
    in-out property <string> query: "";
    in-out property <[FilterRow]> filters: [];
    /// Which row index is the paginated (version) one; -1 when there is none.
    in-out property <int> version-row: -1;
    in-out property <int> version-page: 0;
    in-out property <int> version-page-count: 0;
    /// Every version the filter offers. The carousel draws the whole track and
    /// clips it: a page is what the track is *translated* by, not how many chips
    /// are drawn, so more than a page's worth can show at once.
    in-out property <[FilterChip]> version-chips: [];
    /// How far the track is scrolled left, in pixels. Rust sums the chips'
    /// measured widths up to the page's first one — Slint cannot read a repeated
    /// element's geometry from outside.
    in-out property <length> version-offset: 0px;
    in-out property <[PageButton]> pages: [];
    in-out property <int> current-page: 1;
    in-out property <int> total-pages: 0;

    callback search();
    callback chip-clicked(string);
    /// A version chip reports the width it measured, for the carousel's offset.
    /// Keyed by the chip's value rather than its position: the other rows' chips
    /// report too (their handler is the same one), and their indices would land
    /// on the version slots.
    callback chip-measured(string, length);
    callback version-page-prev();
    callback version-page-next();
    callback go-to-page(int);
}


/// The content overlays' translated strings.
///
/// Rust composes most of a chip's label — a loader name, a version, a category —
/// but a string Rust pushes into a model is fixed at the moment it is pushed and
/// would not follow a language change, where an `@tr` binding re-evaluates. So
/// the labels live here and the view resolves them from the chip's key, the way
/// `GameTime` does for the game view's relative times.
///
/// The context is set explicitly (`@tr("ContentText" => …)`) because these are
/// not a component's own strings: Slint's default context is the component name,
/// and the callers are the chips and cards rather than one component.
export global ContentText {
    /// The local mods' disabled marker. It resolves through a `@tr` so it
    /// follows a language change; the prefix carries its own trailing space.
    out property <string> disabled-prefix: @tr("ContentText" => "[Disabled] ");

    /// The loader names, never translated.
    public pure function loader(key: string) -> string {
        if key == "fabric" { return "Fabric"; }
        if key == "forge" { return "Forge"; }
        if key == "neoforge" { return "NeoForge"; }
        if key == "quilt" { return "Quilt"; }
        if key == "liteloader" { return "LiteLoader"; }
        return key;
    }

    /// A category chip's label. `platform` and `kind` are part of the lookup
    /// because the three lists have their own category tables and CurseForge's
    /// are keyed by numeric id — the same slug can mean something different in
    /// two of them (`combat` is a Modrinth pack category and a CurseForge one
    /// with a different name).
    public pure function category(kind: string, platform: string, key: string) -> string {
        if kind == "mods" && platform == "curseforge" && key == "adventure-rpg" {
            return @tr("CategoryModsCurseforge" => "Adventure & RPG");
        }
        if kind == "mods" && platform == "curseforge" && key == "armor-weapons-tools" {
            return @tr("CategoryModsCurseforge" => "Armor, Tools & Weapons");
        }
        if kind == "mods" && platform == "curseforge" && key == "world-gen" {
            return @tr("CategoryModsCurseforge" => "World Generation");
        }
        if kind == "mods" && platform == "curseforge" && key == "technology" {
            return @tr("CategoryModsCurseforge" => "Technology");
        }
        if kind == "mods" && platform == "curseforge" && key == "magic" {
            return @tr("CategoryModsCurseforge" => "Magic");
        }
        if kind == "mods" && platform == "curseforge" && key == "storage" {
            return @tr("CategoryModsCurseforge" => "Storage");
        }
        if kind == "mods" && platform == "curseforge" && key == "library-api" {
            return @tr("CategoryModsCurseforge" => "Library & API");
        }
        if kind == "mods" && platform == "curseforge" && key == "map-information" {
            return @tr("CategoryModsCurseforge" => "Maps & Info");
        }
        if kind == "mods" && platform == "curseforge" && key == "utility-qol" {
            return @tr("CategoryModsCurseforge" => "Utility & QoL");
        }
        if kind == "mods" && platform == "curseforge" && key == "server-utility" {
            return @tr("CategoryModsCurseforge" => "Server Utility");
        }
        if kind == "mods" && platform == "curseforge" && key == "mc-food" {
            return @tr("CategoryModsCurseforge" => "Food");
        }
        if kind == "mods" && platform == "curseforge" && key == "performance" {
            return @tr("CategoryModsCurseforge" => "Performance");
        }
        if kind == "mods" && platform == "curseforge" && key == "bug-fixes" {
            return @tr("CategoryModsCurseforge" => "Bug Fixes");
        }
        if kind == "mods" && platform == "curseforge" && key == "redstone" {
            return @tr("CategoryModsCurseforge" => "Redstone");
        }
        if kind == "mods" && platform == "curseforge" && key == "cosmetic" {
            return @tr("CategoryModsCurseforge" => "Cosmetic");
        }
        if kind == "mods" && platform == "curseforge" && key == "mc-miscellaneous" {
            return @tr("CategoryModsCurseforge" => "Miscellaneous");
        }
        if kind == "mods" && platform == "modrinth" && key == "adventure" {
            return @tr("CategoryModsModrinth" => "Adventure");
        }
        if kind == "mods" && platform == "modrinth" && key == "cursed" {
            return @tr("CategoryModsModrinth" => "Cursed");
        }
        if kind == "mods" && platform == "modrinth" && key == "decoration" {
            return @tr("CategoryModsModrinth" => "Decoration");
        }
        if kind == "mods" && platform == "modrinth" && key == "economy" {
            return @tr("CategoryModsModrinth" => "Economy");
        }
        if kind == "mods" && platform == "modrinth" && key == "equipment" {
            return @tr("CategoryModsModrinth" => "Equipment");
        }
        if kind == "mods" && platform == "modrinth" && key == "food" {
            return @tr("CategoryModsModrinth" => "Food");
        }
        if kind == "mods" && platform == "modrinth" && key == "game-mechanics" {
            return @tr("CategoryModsModrinth" => "Game Mechanics");
        }
        if kind == "mods" && platform == "modrinth" && key == "library" {
            return @tr("CategoryModsModrinth" => "Library");
        }
        if kind == "mods" && platform == "modrinth" && key == "magic" {
            return @tr("CategoryModsModrinth" => "Magic");
        }
        if kind == "mods" && platform == "modrinth" && key == "management" {
