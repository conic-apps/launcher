            return @tr("CategoryModsModrinth" => "Minigame");
        }
        if kind == "mods" && platform == "modrinth" && key == "mobs" {
            return @tr("CategoryModsModrinth" => "Mobs");
        }
        if kind == "mods" && platform == "modrinth" && key == "optimization" {
            return @tr("CategoryModsModrinth" => "Optimization");
        }
        if kind == "mods" && platform == "modrinth" && key == "social" {
            return @tr("CategoryModsModrinth" => "Social");
        }
        if kind == "mods" && platform == "modrinth" && key == "storage" {
