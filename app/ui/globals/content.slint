    /// A chip's label, whichever kind of chip it is. A Minecraft version is not
    /// in any table and reads as itself.
    public pure function chip-label(kind: string, platform: string, key: string) -> string {
        if key == "favorites" { return @tr("ContentText" => "Favorites"); }
        if key == "fabric" || key == "forge" || key == "neoforge" || key == "quilt"
            || key == "liteloader" {
            return self.loader(key);
        }
        return self.category(kind, platform, key);
    }

    /// The saves' "Last played: " prefix. The time itself is
    /// `GameTime.last-played`'s, which the card tag calls.
    public pure function last-played-label() -> string {
        return @tr("ContentText" => "Last played: ");
    }

    /// A save card's game-mode and cheats tags. `kind` is the tag's own `kind`,
    /// so the one table covers both the game-mode and command-enabled families.
    ///
    /// These are resolved here rather than composed in Rust for the reason the
    /// chip labels are: a string Rust pushed is fixed at that moment and would
    /// not follow a language change.
    public pure function save-tag(kind: string) -> string {
        if kind == "game-mode-survival" { return @tr("ContentText" => "Survival"); }
        if kind == "game-mode-creative" { return @tr("ContentText" => "Creative"); }
        if kind == "game-mode-adventure" { return @tr("ContentText" => "Adventure"); }
        if kind == "game-mode-spectator" { return @tr("ContentText" => "Spectator"); }
        if kind == "command-enabled" { return @tr("ContentText" => "Cheats"); }
        return "";
    }

    /// A detail panel's header title. `kind` is the `ContentState.remote-kind`
    /// of the open list.
    public pure function detail-title(kind: string) -> string {
        if kind == "mods" { return @tr("ContentText" => "Mod info"); }
        if kind == "resourcepacks" { return @tr("ContentText" => "Resource pack info"); }
        return @tr("ContentText" => "Modpack info");
    }

    /// The search field's placeholder.
    public pure function search-placeholder(kind: string) -> string {
        if kind == "mods" { return @tr("ContentText" => "Search mods..."); }
        if kind == "resourcepacks" { return @tr("ContentText" => "Search resource packs..."); }
        return @tr("ContentText" => "Search modpacks...");
    }

    /// A filter row's label. The rows are identified by key so the label stays
    /// translatable.
    public pure function row-label(key: string) -> string {
        if key == "loader" { return @tr("ContentText" => "Loader"); }
        if key == "version" { return @tr("ContentText" => "Version"); }
        return @tr("ContentText" => "Category");
    }
}
