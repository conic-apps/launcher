            return @tr("CategoryResourcepacksCurseforge" => "Simple");
        }
        if kind == "resourcepacks" && platform == "curseforge" && key == "traditional" {
            return @tr("CategoryResourcepacksCurseforge" => "Traditional");
        }
        if kind == "resourcepacks" && platform == "curseforge" && key == "animated" {
            return @tr("CategoryResourcepacksCurseforge" => "Animated");
        }
        if kind == "resourcepacks" && platform == "curseforge" && key == "modern" {
