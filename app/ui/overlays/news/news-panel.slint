import { Theme } from "../../theme.slint";
import { Loading } from "../../components/controls/loading.slint";
import { NewsState } from "../../globals/news.slint";
import { ScrollView } from "../../components/containers/scroll-view.slint";
import { ContentTitleBar } from "../content/content-title-bar.slint";
import { ContentNotFound } from "../content/content-not-found.slint";
import { NewsSearchPanel } from "news-search-panel.slint";
import { NewsCardView } from "news-card.slint";

// The news list: the content browser's skeleton — a title bar, a search panel
// and the results — with a vertical card flow where the content panels draw a
// grid.
//
// The flow positions its cards by hand and culls them. Slint's layout would
// draw every card of a 415-entry changelog at once, and — worse — fetch every
// one of their images; instead Rust stacks them, the flow draws only the ones
// the viewport touches (`card.in-view`), and the panel reports its scroll
// offset so that set follows the reader. `content-card-grid.slint` does the
// same for the paged content grids.
export component NewsListPanel inherits Rectangle {
    /// The overlay container's size, passed in rather than read off `parent`.
    in property <length> panel-width: 0px;
    in property <length> panel-height: 0px;

    width: panel-width;
    height: panel-height;
    background: transparent;

    // The size Rust lays the cards and the filter rows out in. Reported from
    // here rather than read off the flow, which is an absolutely-positioned
    // child of the scroller: `changed` does not fire for the value a component
    // is created with, so the first report is `init` and the handlers pick up a
    // later resize.
    init => { NewsState.list-resized(root.width, root.height); }
    changed width => { NewsState.list-resized(root.width, root.height); }
    changed height => { NewsState.list-resized(root.width, root.height); }

    // The distance from the flow's top to the viewport's top: the scroller's
    // offset (`content-y`, negative down) plus the flow's own place in the
    // scrolled content. It moves on a scroll and when the panels above the flow
    // change height, which are exactly the two times the visible cards change.
    private property <length> viewport-top: list-scroll.content-y + flow.y;
    changed viewport-top => {
        NewsState.list-scrolled(-root.viewport-top, list-scroll.height);
    }

    // The panel stays mounted between shows, so the scroll is reset by hand.
    private property <bool> panel-open: NewsState.visible;
    changed panel-open => {
        if root.panel-open {
            list-scroll.scroll-to(0px, false);
        }
    }

    // One float drives the whole loading layer: the dim and the spinner's
    // opacity, and — through its value — the spinner's scale. It snaps up while
    // a feed is in flight and eases back down when it lands, which is what gives
    // the spinner its shrink-and-fade and the panel its fade back to full
    // brightness.
    private property <float> loading-fade: NewsState.loading ? 1.0 : 0.0;
    animate loading-fade {
        duration: NewsState.loading ? 150ms : 300ms;
        easing: ease-out;
    }

    list-scroll := ScrollView {
        // No `title-gap`: the search panel's crust sits directly under the
        // header, as it does in the mods, resource-pack and pack panels.
        ContentTitleBar {
            icon: "newspaper";
            title: @tr("News");
        }

        NewsSearchPanel { }

        // The flow's box is as tall as every card plus the padding; its own
        // children are stacked by Rust and only the visible ones are drawn. An
        // empty flow keeps only its padding.
        flow := Rectangle {
            width: 100%;
            height: NewsState.list-height;
            background: transparent;

            grid := Rectangle {
                x: 32px;
                y: 0;
                width: max(0px, parent.width - 64px);
                height: parent.height;
                background: transparent;

                for card in NewsState.cards : NewsCardView {
                    card: card;
                    y: card.y;
                    visible: card.in-view;
                    clicked => { NewsState.open-card(card.id); }
                }
            }
        }

        if !NewsState.loading && NewsState.cards.length == 0 : not-found := ContentNotFound {
            show: true;
            // The placeholder sits below the search panel rather than over the
            // whole panel, so its block is its own content plus a padding.
            block-height: not-found.content-height + 80px;
            description: @tr("Try adjusting the filters or search again");
        }
    }

    // The loading layer, over the *panel* rather than the whole window: it dims
    // the title bar, the search panel and the flow while a feed is in flight,
    // and the overlay's own scrim — the strip beside the narrower container — is
    // left uncovered, so a click there still closes the panel. The spinner is
    // centred in the panel and shrinks into the dim as it fades.
    if root.loading-fade > 0.001 : Rectangle {
        width: 100%;
        height: 100%;
        // Black rather than a palette surface: the panel is `base`, which is
        // light in Latte and dark in the others, and a palette token would
        // brighten one of them instead of dimming it.
        background: #000000.with-alpha(0.45 * root.loading-fade);

        // Swallows presses so nothing under the dim reacts while loading; it is
        // still inside the container, so the scrim keeps its own clicks.
        TouchArea { }

        // The same mark `ContentLoading` draws — a 64px mantle rounded square
        // with a 32px ring — centred in the panel rather than at the top of the
        // flow. The fade and the shrink are on this box, so the ring travels
        // with it.
        Rectangle {
            width: 64px;
            height: 64px;
            background: Theme.mantle;
            border-radius: 8px;
            opacity: root.loading-fade;
            // 0.6 when gone, 1.0 at full: the shrink the fade reads as.
            transform-scale: 0.6 + 0.4 * root.loading-fade;
            transform-origin: { x: self.width / 2, y: self.height / 2 };

            Loading {
                size: 32px;
                stroke-width: 4;
                gap: 8;
            }
        }
    }
}
