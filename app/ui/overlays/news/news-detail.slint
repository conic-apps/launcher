import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { Loading } from "../../components/controls/loading.slint";
import { ScrollView } from "../../components/containers/scroll-view.slint";
import { NewsState, NewsText } from "../../globals/news.slint";
import { NewsBody } from "news-body.slint";

// The 52px header of the changelog detail: a back button, the newspaper glyph
// and the entry's title. It replaces `ContentTitleBar` because that component
// has no back affordance, and the detail is closed by returning to the list it
// came from.
component DetailHeader inherits Rectangle {
    in property <string> title: "";
    callback back;

    width: 100%;
    height: 52px;
    background: Theme.mantle;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 32px;
        spacing: 8px;
        cross-axis-alignment: center;

        back-button := Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 6px;
            background: back-touch.pressed ? Theme.overlay-0.transparentize(0.3)
                : back-touch.has-hover ? Theme.surface-2.transparentize(0.3)
                : transparent;
            animate background { duration: 120ms; easing: Easing.ease; }

            AppIcon {
                name: "chevron-back";
                size: 20px;
                icon-color: Theme.default-text-color.transparentize(0.1);
            }

            back-touch := TouchArea {
                clicked => { root.back(); }
            }
        }

        AppIcon {
            name: "newspaper";
            size: 20px;
        }

        Text {
            text: root.title;
            font-size: 16px;
            color: Theme.default-text-color.transparentize(0.1);
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

// The changelog detail panel: the entry's header and hero, then the full body
// the launcher-content crate fetched.
export component NewsDetailPanel inherits Rectangle {
    /// The overlay container's size, passed in rather than read off `parent`.
    in property <length> panel-width: 0px;
    in property <length> panel-height: 0px;

    width: panel-width;
    height: panel-height;
    background: transparent;

    scroller := ScrollView {
        details-column := VerticalLayout {
            DetailHeader {
                title: NewsState.detail-title;
                back => { NewsState.close-detail(); }
            }

            if NewsState.detail-loading : Rectangle {
                width: 100%;
                height: 112px;
                background: transparent;

                Loading {
                    y: 40px;
                    size: 32px;
                    stroke-width: 4;
                    gap: 8;
                }
            }

            if !NewsState.detail-loading : Rectangle {
                width: 100%;
                height: self.preferred-height;
                background: transparent;

                details-inner := VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 16px;

                    HorizontalLayout {
                        height: self.preferred-height;
                        spacing: 16px;

                        // A 96px rounded square, the image's own proportions.
                        Rectangle {
                            width: 96px;
                            height: 96px;
                            border-radius: 12px;
                            clip: true;
                            background: Theme.surface-0;

                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: NewsState.detail-image;
                                image-fit: cover;
                            }
                        }

                        // The title and the three metadata entries, centred in
                        // the 96px the image gives the header.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            alignment: center;

                            Text {
                                text: NewsState.detail-title;
                                font-size: 24px;
                                font-weight: 600;
                                color: Theme.default-text-color.transparentize(0.1);
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                height: 20px;
                                spacing: 10px;
                                alignment: start;
                                cross-axis-alignment: center;

                                // The release / snapshot pill.
                                Rectangle {
                                    height: 20px;
                                    width: kind-label.preferred-width + 16px;
                                    border-radius: 999px;
                                    background: NewsState.detail-subtitle == "release"
                                        ? Theme.green : Theme.yellow;

                                    kind-label := Text {
                                        text: NewsText.kind-label(NewsState.detail-subtitle);
                                        font-size: 11px;
                                        font-weight: 500;
                                        color: Theme.text-inverse;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: NewsState.detail-date;
                                    font-size: 13px;
                                    color: Theme.subtext-0;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    body := NewsBody {
                        scroll-y: scroller.content-y;
                        viewport-height: scroller.height;
                        // The scroller's offset is not enough on its own: the
                        // view culls from its own top, so the two layout steps
                        // above it are added back.
                        top-in-scroll: details-column.y
                            + details-inner.y
                            + body.y;
                    }
                }
            }
        }
    }
}
