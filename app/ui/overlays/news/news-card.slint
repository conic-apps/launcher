import { Theme } from "../../theme.slint";
import { Loading } from "../../components/controls/loading.slint";
import { TooltipArea } from "../../components/controls/tooltip-area.slint";
import { GameTime } from "../../globals/game.slint";
import { NewsCard as CardData, NewsText } from "../../globals/news.slint";

// One card of the news flow.
//
// The flow is two feeds in one column, and the two feeds carry different
// pictures — a news entry a 772×350 banner, a changelog a 540×540 square — so
// the card has two shapes. The shape follows the image's own aspect ratio,
// which Rust passes as `image-ratio`: a banner stacks picture over copy, a
// square sits picture beside copy.
//
// The card's `height` is computed in Rust: the flow positions every card
// absolutely so it can cull the ones outside the viewport, and the height is
// part of that stacking.

// The image box both cards share: a clipped, rounded frame that draws a
// spinner until the bitmap arrives.
component CardMedia inherits Rectangle {
    in property <image> source;
    in property <bool> loading: false;

    background: Theme.surface-0;
    clip: true;

    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        // The picture fills the box it is given, cropping whatever does not fit
        // rather than leaving bands: the banner is a fixed height and the row's
        // thumbnail is a square, and neither should letterbox.
        image-fit: cover;
        opacity: root.loading ? 0.0 : 1.0;
        animate opacity { duration: 200ms; easing: ease-out; }
    }

    // Centred by its default `x`/`y`.
    if root.loading : Loading {
        size: 24px;
        stroke-width: 4;
        gap: 8;
        icon-color: Theme.overlay-1;
    }
}

// A news entry: the wide banner across the top, then the copy.
//
// The banner's height is its own width over the image's ratio, so the picture
// is shown at its native proportions and the card grows with the panel.
export component NewsBannerCard inherits Rectangle {
    in property <CardData> card;
    callback clicked;

    width: 100%;
    height: root.card.height;
    background: card-touch.has-hover ? Theme.surface-1.transparentize(0.4)
        : Theme.surface-0.transparentize(0.6);
    border-radius: 8px;
    clip: true;
    animate background { duration: 160ms; easing: ease-out; }

    /// The banner's fixed height. `layout::NEWS_MEDIA_HEIGHT` in Rust is the
    /// same 200, and the card's `height` is this plus the copy block.
    private property <length> media-height: 200px;

    CardMedia {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.media-height;
        source: root.card.image;
        loading: root.card.image-loading;
        border-radius: 8px;
    }

    // The date, as a translucent crust capsule over the banner's top-right
    // corner. It is declared after the media so it paints over it, and inset by
    // 12px from the edges.
    date-chip := Rectangle {
        x: parent.width - self.width - 12px;
        y: 12px;
        width: chip-label.preferred-width + 20px;
        height: 22px;
        border-radius: 999px;
        background: Theme.crust.with-alpha(0.65);

        chip-label := Text {
            // The app's one localized absolute date, which reorders for a
            // language whose date reads year-first.
            text: GameTime.year-month-day(
                root.card.date-month,
                root.card.date-day,
                root.card.date-year,
            );
            font-size: 12px;
            color: Theme.default-text-color.transparentize(0.1);
            vertical-alignment: center;
        }
    }

    info := Rectangle {
        x: 0;
        y: root.media-height;
        width: parent.width;
        height: parent.height - root.media-height;
        background: transparent;

        // 110px of copy: 12 + 22 (title) + 4 + 16 (meta) + 4 + 40 (blurb) + 12.
        // Rust's `BANNER_INFO_HEIGHT` is the same number.
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 4px;
            alignment: start;

            // 16px title, weight 700, one elided line.
            Text {
                height: 22px;
                text: root.card.title;
                font-size: 16px;
                font-weight: 700;
                color: Theme.default-text-color.transparentize(0.1);
                overflow: elide;
                vertical-alignment: center;
            }

            // The category, 12px. The date is on the banner itself now.
            Text {
                height: 16px;
                text: root.card.subtitle;
                font-size: 12px;
                color: Theme.mauve;
                overflow: elide;
                vertical-alignment: center;
            }

            // The blurb, 13px, at most two lines.
            Text {
                height: 40px;
                text: root.card.description;
                font-size: 13px;
                color: Theme.default-text-color.transparentize(0.3);
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: top;
            }
        }
    }

    card-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // A news card opens its article in the system browser (a changelog opens in
    // the panel instead, so only this shape carries the hint). The card owns its
    // own `touch`, so the hover comes from there and the built-in area is off.
    TooltipArea {
        text: @tr("View in browser");
        hovered: card-touch.has-hover;
        wrap: false;
        show-on-press: false;
    }
}

// A changelog: the square image on the left, the copy to its right.
export component NewsRowCard inherits Rectangle {
    in property <CardData> card;
    callback clicked;

    width: 100%;
    height: root.card.height;
    background: card-touch.has-hover ? Theme.surface-1.transparentize(0.4)
        : Theme.surface-0.transparentize(0.6);
    border-radius: 8px;
    clip: true;
    animate background { duration: 160ms; easing: ease-out; }

    // The image is as wide as it is tall times its ratio — a square here — and
    // fills the card's height.
    private property <length> media: root.height * root.card.image-ratio;

    CardMedia {
        x: 0;
        y: 0;
        width: root.media;
        height: parent.height;
        source: root.card.image;
        loading: root.card.image-loading;
        border-radius: 8px;
    }

    info := Rectangle {
        x: root.media + 14px;
        y: 0;
        width: max(0px, parent.width - root.media - 28px);
        height: parent.height;
        background: transparent;

        // The release / snapshot tag, the version and the date, on one line. The
        // tag leads, the version takes the middle and the date is pushed to the
        // trailing edge.
        HorizontalLayout {
            x: 0;
            y: 8px;
            width: parent.width;
            height: 18px;
            spacing: 8px;
            cross-axis-alignment: center;

            // The tag as a small pill, to the left of the version.
            Rectangle {
                height: 18px;
                width: tag-label.preferred-width + 14px;
                border-radius: 999px;
                background: root.card.tag == "release" ? Theme.green : Theme.yellow;

                tag-label := Text {
                    text: NewsText.kind-label(root.card.tag);
                    font-size: 10px;
                    font-weight: 500;
                    color: Theme.text-inverse;
                    vertical-alignment: center;
                }
            }

            // The version takes the space the date leaves, so the date lands on
            // the trailing edge and a long version elides rather than pushing it
            // off the card. `horizontal-stretch` defaults to 1, so the date has
            // to say 0 explicitly to stay its own width.
            Text {
                horizontal-stretch: 1;
                text: root.card.title;
                font-size: 15px;
                font-weight: 700;
                color: Theme.default-text-color.transparentize(0.1);
                overflow: elide;
                vertical-alignment: center;
            }

            Text {
                horizontal-stretch: 0;
                text: GameTime.year-month-day(
                    root.card.date-month,
                    root.card.date-day,
                    root.card.date-year,
                );
                font-size: 12px;
                color: Theme.subtext-0;
                vertical-alignment: center;
            }
        }

        // The short body, two elided lines.
        Text {
            x: 0;
            y: 32px;
            width: parent.width;
            height: parent.height - 40px;
            text: root.card.description;
            font-size: 12px;
            color: Theme.default-text-color.transparentize(0.3);
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
        }
    }

    card-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// The card the flow draws, whichever shape the entry's image calls for.
export component NewsCardView inherits Rectangle {
    in property <CardData> card;
    callback clicked;

    width: 100%;
    height: root.card.height;
    background: transparent;

    if root.card.kind == "changelog" : NewsRowCard {
        card: root.card;
        clicked => { root.clicked(); }
    }

    if root.card.kind != "changelog" : NewsBannerCard {
        card: root.card;
        clicked => { root.clicked(); }
    }
}
