import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { Loading } from "../../components/controls/loading.slint";
import { Progress } from "../../components/controls/progress.slint";
import { ContentState, ContentText } from "../../globals/content.slint";
import { ScrollView } from "../../components/containers/scroll-view.slint";
import { ScrollViewHorizontal } from "../../components/containers/scroll-view-horizontal.slint";
import { ContentOverlay } from "content-overlay.slint";
import { ContentTitleBar } from "content-title-bar.slint";
import { MarkdownBody } from "markdown-body.slint";
component MetadataEntry inherits Rectangle {
    in property <string> icon: "";
    in property <string> text: "";
    in property <bool> link: false;
    /// A 1px hairline in front of every entry but the first, *inside* the entry
    /// and followed by its own 12px margin. With the row's 12px gap that is 25px
    /// between the entries, not 13px.
    in property <bool> divider: false;
    callback clicked;

    // From the inner layout, explicitly: a component whose children are all
    // absolutely positioned reports a preferred size of **zero** — Slint's
    // `gen_layout_info_prop` skips a child that sets `x` or `y`
    // (`passes/default_geometry.rs`), so a bare `self.preferred-width` here
    // measured 0 and every entry of the row was drawn at the same place.
    width: entry.preferred-width + (root.divider ? 13px : 0px);
    height: 20px;
    background: transparent;

    if root.divider : Rectangle {
        x: 0;
        width: 1px;
        height: 16px;
        background: Theme.overlay-2;
    }

    entry := HorizontalLayout {
        x: root.divider ? 13px : 0px;
        height: parent.height;
        spacing: 4px;
        alignment: center;

        AppIcon {
            name: root.icon;
            size: 20px;
            icon-color: Theme.mauve;
        }

        Text {
            text: root.text;
            font-size: 14px;
            color: root.link ? Theme.blue : Theme.default-text-color.transparentize(0.1);
            vertical-alignment: center;
            height: 20px;
        }
    }

    if root.link : TouchArea {
        clicked => { root.clicked(); }
    }
}
component DetailButton inherits Rectangle {
    in property <string> kind: "download";
    in property <string> label: "";
    in property <bool> favorited: false;
    in property <bool> on: true;
    callback clicked;

    height: 36px;
    border-radius: 6px;
    opacity: root.on ? 1.0 : 0.6;
    // The remove button is surface0 with a red outline; every other action
    // button is the Latte teal, which stays teal in every palette.
    background: root.kind == "remove" ? Theme.surface-0 : Theme.latte-teal;
    border-width: root.kind == "remove" ? 1px : 0px;
    border-color: Theme.red;

    private property <color> ink:
        root.kind == "remove"
            ? (touch.has-hover ? Theme.red : white)
            : root.kind == "heart" && root.favorited ? Theme.red : white;

    HorizontalLayout {
        // The row fills the button and the glyph and the label are centred in it
        // as one run, 4px apart. Sizing the row to its content instead left the
        // two at the button's ends for the 120px labelled buttons, and the lone
        // heart off-centre.
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        spacing: 4px;
        // The main (horizontal) axis is centred.
        alignment: center;
        // The cross axis is centred too: `alignment` is the main (horizontal)
        // axis, and on its own it leaves the 16px glyph at the top of the 36px
        // button instead of centred on the label.
        cross-axis-alignment: center;

        if root.kind == "heart" : AppIcon {
            // `AppIcon`'s default 20px: the glyph inside the view box is smaller
            // than that, which is what makes 16px look too small.
            name: root.favorited ? "heart" : "heart-outline";
            size: 20px;
            icon-color: root.ink;
        }

        if root.label != "" : Text {
            text: root.label;
            font-size: 14px;
            color: root.ink;
            vertical-alignment: center;
        }

        if root.kind == "download" : AppIcon {
            name: "download";
            size: 20px;
            icon-color: root.ink;
        }

        if root.kind == "remove" : AppIcon {
            name: "trash";
            size: 20px;
            icon-color: root.ink;
        }
    }

    touch := TouchArea {
        enabled: root.on;
        clicked => { root.clicked(); }
    }
}

// The six detail panels.
//
// The same header, the same action row and the same body serve all six,
// differing only in which API fills them and in two conditionals — whether the
// panel offers a remove button (mods only) and whether it has a gallery
// (Modrinth only). The differences are carried by `ContentState`; Rust already
// knows which of the six is open.
component DetailBody inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // Named for the one thing its children need from it: the scroll offset, so
    // the body's renderer can skip the items that are scrolled out of sight.
    scroller := ScrollView {
        details-column := VerticalLayout {
            ContentTitleBar {
                // The pack panels open with a package glyph; the mod and
                // resource-pack panels with `extension-puzzle`.
                icon: ContentState.remote-kind == "packs" ? "package" : "extension-puzzle";
                title: ContentText.detail-title(ContentState.remote-kind);
            }

            // 40px of padding above and below the spinner: 112px, full panel
            // width. The list panels instead use `ContentLoading`, 144px tall
            // with a 64px mantle square.
            if ContentState.detail-loading : Rectangle {
                width: 100%;
                height: 112px;
                background: transparent;

                Loading {
                    y: 40px;
                    size: 32px;

                    stroke-width: 4;
                    gap: 8;
                }
            }

            if !ContentState.detail-loading : Rectangle {
                width: 100%;
                height: self.preferred-height;
                background: transparent;

                details-inner := VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 16px;

                    HorizontalLayout {
                        height: self.preferred-height;
                        spacing: 16px;

                        Rectangle {
                            width: 88px;
                            height: 88px;
                            border-radius: 12px;
                            clip: true;
                            background: Theme.surface-0;

                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: ContentState.detail-icon;
                                image-fit: cover;
                            }
                        }

                        // The three lines are centred in the 88px the icon gives
                        // the header, with 8px between them.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            spacing: 8px;
                            alignment: center;

                            if ContentState.detail-title != "" : Text {
                                text: ContentState.detail-title;
                                font-size: 24px;
                                font-weight: 600;
                                color: Theme.default-text-color.transparentize(0.1);
                                height: 24px;
                                vertical-alignment: center;
                            }

                            metadata := FlexboxLayout {
                                flex-wrap: wrap;
                                height: 20px;
                                spacing: 12px;
                                cross-axis-alignment: center;

                                if ContentState.detail-source != "" : MetadataEntry {
                                    icon: ContentState.detail-source-is-github ? "github" : "code-slash-outline";
                                    text: ContentState.detail-source-label;
                                    link: true;
                                    clicked => { ContentState.open-url(ContentState.detail-source); }
                                }

                                MetadataEntry {
                                    icon: "download";
                                    text: ContentState.detail-downloads;
                                    // The divider belongs to the entry that
                                    // follows another one, so this one only gets
                                    // it when the source entry is drawn.
                                    divider: ContentState.detail-source != "";
                                }

                                if ContentState.detail-has-followers : MetadataEntry {
                                    icon: "heart-outline";
                                    text: ContentState.detail-followers;
                                    divider: true;
                                }
                            }

                            // A wrapping block with no set height, unlike the
                            // card's, which is one elided line.
                            if ContentState.detail-description != "" : Text {
                                text: ContentState.detail-description;
                                font-size: 14px;
                                color: Theme.default-text-color.transparentize(0.1);
                                wrap: word-wrap;
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 36px;
                        spacing: 8px;
                        alignment: start;

                        DetailButton {
                            kind: "heart";
                            label: "";
                            width: 36px;
                            favorited: ContentState.detail-favorited;
                            on: true;
                            clicked => { ContentState.toggle-favorite(ContentState.detail-id); }
                        }

                        // Three buttons swap in and out: checking → a spinner,
                        // installed → remove, otherwise → download. Only a mod
                        // panel has the installed state at all; a pack or
                        // resource-pack panel draws the plain download button.
                        if ContentState.detail-can-remove && ContentState.detail-checking-installed : Rectangle {
                            width: 120px;
                            height: 36px;
                            border-radius: 6px;
                            // The same Latte teal as the heart and the download.
                            background: Theme.latte-teal;
                            opacity: 0.6;

                            Loading {
                                size: 18px;
                                stroke-width: 6;
                                icon-color: white;
                            }
                        }

                        if ContentState.detail-can-remove
                            && !ContentState.detail-checking-installed
                            && ContentState.detail-installed : DetailButton {
                            kind: "remove";
                            label: @tr("Remove");
                            width: 120px;
                            on: !ContentState.detail-operating;
                            clicked => { ContentState.remove(); }
                        }

                        if (!ContentState.detail-can-remove
                                || !ContentState.detail-checking-installed)
                            && !ContentState.detail-installed : DetailButton {
                            kind: "download";
                            label: @tr("Download");
                            width: 120px;
                            on: !ContentState.detail-operating;
                            clicked => { ContentState.download(); }
                        }

                        if ContentState.detail-operating && ContentState.detail-progress-max > 0 : VerticalLayout {
                            width: 160px;
                            height: 36px;
                            alignment: center;
                            spacing: 4px;

                            Text {
                                text: ContentState.detail-progress-text;
                                font-size: 12px;
                                color: Theme.subtext-1;
                                horizontal-alignment: center;
                            }
                            Progress {
                                width: 100%;
                                loading: false;
                                value: ContentState.detail-progress;
                                max: ContentState.detail-progress-max;
                            }
                        }

                        if ContentState.detail-installed-version != "" : Text {
                            text: @tr("Installed: {}", ContentState.detail-installed-version);
                            font-size: 13px;
                            font-italic: true;
                            color: Theme.subtext-1;
                            opacity: 0.6;
                            vertical-alignment: center;
                            height: 36px;
                            horizontal-alignment: left;
                        }
                    }

                    // An empty body still draws the surface0 box when
                    // `ContentState.detail-body-always` is set.
                    if ContentState.detail-body != "" || ContentState.detail-body-always : markdown-body := MarkdownBody {
                        // The scroller's offset and height, for the body to cull
                        // against. The view is a grandchild of the scroller and
                        // cannot reach it, so both are passed down.
                        scroll-y: scroller.content-y;
                        viewport-height: scroller.height;
                        // …and where this box sits inside the scrolled content.
                        // The view measures its culling window from its *own* top,
                        // so handing it the scroller's offset alone culls away the
                        // header and the action row above it — a blank band at the
                        // top of the body whenever the panel is shorter than they
                        // are. A layout assigns `y` to each of its children, so
                        // the three steps up are each readable.
                        top-in-scroll: details-column.y
                            + details-inner.y
                            + markdown-body.y;
                    }

                    if ContentState.detail-gallery.length > 0 : Rectangle {
                        width: 100%;
                        height: 252px;
                        background: Theme.surface-0;
                        border-radius: 8px;

                        // 8px inside the 16px padding, so the items start 24px
                        // in and the row is 220px tall. The box clips, so a plain
                        // `HorizontalLayout` would have shown the first few shots
                        // and nothing else.
                        gallery-scroll := ScrollViewHorizontal {
                            x: 24px;
                            y: 16px;
                            width: parent.width - 48px;
                            height: parent.height - 32px;
                            scrollbar-left: 8px;
                            scrollbar-right: 8px;

                            HorizontalLayout {
                                spacing: 12px;
                                cross-axis-alignment: center;

                                for shot in ContentState.detail-gallery : Rectangle {
                                    width: shot.ratio * 204px;
                                    height: 204px;
                                    border-radius: 8px;
                                    clip: true;
                                    background: transparent;

                                    Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: shot.image;
                                        image-fit: cover;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
export component DetailPanels inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    ContentOverlay {
        overlay-visible: ContentState.open-detail != "";
        panel-background: Theme.base;
        closed => { ContentState.close-detail(); }

        DetailBody { }
    }
}
