import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/app-icon.slint";
import { BaseLoading } from "../../components/base-loading.slint";
import { ContentState, ContentText } from "../../globals/content.slint";
import { ScrollView } from "../../components/scroll-view.slint";
import { ScrollViewHorizontal } from "../../components/scroll-view-horizontal.slint";
import { ContentOverlay } from "content-overlay.slint";
import { ContentTitleBar } from "content-title-bar.slint";
import { MarkdownBody } from "markdown-body.slint";
component MetadataEntry inherits Rectangle {
    in property <string> icon: "";
    in property <string> text: "";
    in property <bool> link: false;
    /// The Vue puts a 1px hairline in front of every entry but the first
    /// (`.metadata > * + *::before`), *inside* the entry and followed by its
    /// own 12px margin. With the row's 12px gap that is 25px between the
    /// entries, not 13px.
    in property <bool> divider: false;
    callback clicked;

    // From the inner layout, explicitly: a component whose children are all
    // absolutely positioned reports a preferred size of **zero** — Slint's
    // `gen_layout_info_prop` skips a child that sets `x` or `y`
    // (`passes/default_geometry.rs`), so a bare `self.preferred-width` here
    // measured 0 and every entry of the row was drawn at the same place.
    width: entry.preferred-width + (root.divider ? 13px : 0px);
    // The Vue's `.metadata` row is as tall as its tallest child, which is the
    // 20px icon — the 14px label sits centred in it.
    height: 20px;
    background: transparent;

    if root.divider : Rectangle {
        x: 0;
        width: 1px;
        height: 16px;
        background: Theme.overlay-2;
    }

    entry := HorizontalLayout {
        x: root.divider ? 13px : 0px;
        height: parent.height;
        spacing: 4px;
        alignment: center;

        AppIcon {
            // `:deep(svg) { stroke: var(--ctp-mauve); fill: var(--ctp-mauve) }`
            name: root.icon;
            size: 20px;
            icon-color: Theme.mauve;
        }

        Text {
            text: root.text;
            font-size: 14px;
            // `a { color: var(--ctp-blue) }`
            color: root.link ? Theme.blue : Theme.default-text-color.transparentize(0.1);
            vertical-alignment: center;
            height: 20px;
        }
    }

    if root.link : TouchArea {
        clicked => { root.clicked(); }
    }
}
component DetailButton inherits Rectangle {
    in property <string> kind: "download";
    in property <string> label: "";
    in property <bool> favorited: false;
    in property <bool> on: true;
    callback clicked;

    height: 36px;
    border-radius: 6px;
    opacity: root.on ? 1.0 : 0.6;
    // `button.remove { background: var(--ctp-surface0); border: 1px solid var(--ctp-red) }`
    // — and every other action button is the Latte teal the stylesheet picks
    // once in `:root`, so it stays teal in every palette.
    background: root.kind == "remove" ? Theme.surface-0 : Theme.latte-teal;
    border-width: root.kind == "remove" ? 1px : 0px;
    border-color: Theme.red;

    // `button { color: #fff }`, with `.remove:hover` and `.heart-favorited`
    // the only two that leave it.
    private property <color> ink:
        root.kind == "remove"
            ? (touch.has-hover ? Theme.red : white)
            : root.kind == "heart" && root.favorited ? Theme.red : white;

    HorizontalLayout {
        // `button { display: flex; align-items: center; justify-content: center;
        // gap: 4px }` — the row fills the button and the glyph and the label are
        // centred in it as one run. Sizing the row to its content instead
        // (`x: (parent.width - self.width) / 2`) left the two at the button's
        // ends for the 120px labelled buttons, and the lone heart off-centre.
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        spacing: 4px;
        // `justify-content: center` — the main (horizontal) axis.
        alignment: center;
        // `align-items: center` — the cross axis. `alignment` is the main
        // (horizontal) axis, and on its own it leaves the 16px glyph at the top
        // of the 36px button instead of centred on the label.
        cross-axis-alignment: center;

        if root.kind == "heart" : AppIcon {
            // The Vue passes no `:size`, so these are `AppIcon`'s default 20px —
            // the glyph inside the view box is smaller than that, which is what
            // makes 16px look too small.
            name: root.favorited ? "heart" : "heart-outline";
            size: 20px;
            icon-color: root.ink;
        }

        if root.label != "" : Text {
            text: root.label;
            font-size: 14px;
            color: root.ink;
            vertical-alignment: center;
        }

        if root.kind == "download" : AppIcon {
            name: "download";
            size: 20px;
            icon-color: root.ink;
        }

        if root.kind == "remove" : AppIcon {
            name: "trash";
            size: 20px;
            icon-color: root.ink;
        }
    }

    touch := TouchArea {
        enabled: root.on;
        clicked => { root.clicked(); }
    }
}

// The six detail panels (`Content{Modrinth,Curseforge}{Mod,Resourcepack,Pack}
// Details.vue`).
//
// The Vue has six near-identical files: the same header, the same action row
// and the same body, differing only in which API fills them and in two
// conditionals — whether the panel offers a remove button (mods only) and
// whether it has a gallery (Modrinth only). They are one component here, with
// the differences carried by `ContentState`; Rust already knows which of the
// six is open, so nothing is lost but about 1 200 lines of duplication.
// One of the action row's buttons. `kind` picks the fill and the glyph: the
// heart is a lavender square, the download a lavender pill with a label, and
// the remove a surface0 pill with a red outline that turns red on hover.
// One entry of the metadata row. The Vue separates them with a CSS `::before`
// hairline on every child but the first, which is the `divider` here.
component DetailBody inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // Named for the one thing its children need from it: the scroll offset, so
    // the body's renderer can skip the items that are scrolled out of sight.
    scroller := ScrollView {
        details-column := VerticalLayout {
            ContentTitleBar {
                // `ContentModrinth/CurseforgePackDetails.vue` open with
                // `<AppIcon name="package">`; the mod and resource-pack panels
                // with `extension-puzzle`.
                icon: ContentState.remote-kind == "packs" ? "package" : "extension-puzzle";
                title: ContentText.detail-title(ContentState.remote-kind);
            }

            // `.search-status { padding: 40px 0 }` with the spinner as its only
            // child: 112px, full panel width. The list panels use the same class
            // but wrap the spinner in a `.loading` box — that one is
            // `ContentLoading`, 144px tall with a 64px mantle square.
            if ContentState.detail-loading : Rectangle {
                width: 100%;
                height: 112px;
                background: transparent;

                BaseLoading {
                    y: 40px;
                    size: 32px;

                    stroke-width: 4;
                    gap: 8;
                }
            }

            if !ContentState.detail-loading : Rectangle {
                width: 100%;
                height: self.preferred-height;
                background: transparent;

                // `.details { padding: 8px 24px }`. The Vue gives the action
                // row, the body and the gallery a 16px `margin-top` each, which
                // is the layout's spacing.
                details-inner := VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 16px;

                    // ----- the header -----
                    HorizontalLayout {
                        height: self.preferred-height;
                        spacing: 16px;

                        // `.icon img { width: 88px; height: 88px; border-radius: 12px }`
                        Rectangle {
                            width: 88px;
                            height: 88px;
                            border-radius: 12px;
                            clip: true;
                            background: Theme.surface-0;

                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: ContentState.detail-icon;
                                image-fit: cover;
                            }
                        }

                        // `.info { display: flex; flex-direction: column; justify-content: center }`
                        // — `justify-content` is the main (vertical) axis, so the
                        // three lines are centred in the 88px the icon gives the
                        // header, and the 8px between them is the name's and the
                        // metadata's `margin-bottom` (there is no `gap`).
                        VerticalLayout {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            spacing: 8px;
                            alignment: center;

                            // `.project-name { font-size: 24px; font-weight: 600; margin-bottom: 8px }`
                            if ContentState.detail-title != "" : Text {
                                text: ContentState.detail-title;
                                font-size: 24px;
                                font-weight: 600;
                                color: Theme.default-text-color.transparentize(0.1);
                                height: 24px;
                                vertical-alignment: center;
                            }

                            // `.metadata { font-size: 14px; margin-bottom: 8px; gap: 12px }`
                            // with a 1px divider before every entry but the first.
                            metadata := FlexboxLayout {
                                flex-wrap: wrap;
                                height: 20px;
                                spacing: 12px;
                                // `align-items: center` — the cross axis. The main
                                // axis has no `justify-content`, so the entries
                                // start at the left.
                                cross-axis-alignment: center;

                                if ContentState.detail-source != "" : MetadataEntry {
                                    icon: ContentState.detail-source-is-github ? "github" : "code-slash-outline";
                                    text: ContentState.detail-source-label;
                                    link: true;
                                    clicked => { ContentState.open-url(ContentState.detail-source); }
                                }

                                MetadataEntry {
                                    icon: "download";
                                    text: ContentState.detail-downloads;
                                    // The divider belongs to the entry that
                                    // follows another one, so this one only gets
                                    // it when the source entry is drawn.
                                    divider: ContentState.detail-source != "";
                                }

                                if ContentState.detail-has-followers : MetadataEntry {
                                    icon: "heart-outline";
                                    text: ContentState.detail-followers;
                                    divider: true;
                                }
                            }

                            // `.description { font-size: 14px }` — a wrapping
                            // block with no set height, unlike the card's, which
                            // is one elided line.
                            if ContentState.detail-description != "" : Text {
                                text: ContentState.detail-description;
                                font-size: 14px;
                                color: Theme.default-text-color.transparentize(0.1);
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ----- the action row -----
                    HorizontalLayout {
                        // `.actions-section { gap: 8px }`
                        height: 36px;
                        spacing: 8px;
                        alignment: start;

                        // `button.heart { width: 36px; height: 36px }`
                        DetailButton {
                            kind: "heart";
                            label: "";
                            width: 36px;
                            // `button.heart-favorited { color: var(--ctp-red) }`
                            favorited: ContentState.detail-favorited;
                            on: true;
                            clicked => { ContentState.toggle-favorite(ContentState.detail-id); }
                        }

                        // The Vue swaps three buttons in and out:
                        // `checkingInstalled` → a spinner, `installed` → remove,
                        // otherwise → download. Only a mod panel has the
                        // installed state at all; a pack or resource-pack panel
                        // draws the plain download button.
                        if ContentState.detail-can-remove && ContentState.detail-checking-installed : Rectangle {
                            width: 120px;
                            height: 36px;
                            border-radius: 6px;
                            // `button.download-loading`, which `details.less:17-34`
                            // gives the same `--ctp-latte-teal` as the heart, the
                            // download and the remove button.
                            background: Theme.latte-teal;
                            opacity: 0.6;

                            BaseLoading {
                                size: 18px;
                                stroke-width: 6;
                                icon-color: white;
                            }
                        }

                        if ContentState.detail-can-remove
                            && !ContentState.detail-checking-installed
                            && ContentState.detail-installed : DetailButton {
                            kind: "remove";
                            label: @tr("Remove");
                            width: 120px;
                            on: !ContentState.detail-operating;
                            clicked => { ContentState.remove(); }
                        }

                        if (!ContentState.detail-can-remove
                                || !ContentState.detail-checking-installed)
                            && !ContentState.detail-installed : DetailButton {
                            kind: "download";
                            label: @tr("Download");
                            width: 120px;
                            on: !ContentState.detail-operating;
                            clicked => { ContentState.download(); }
                        }

                        // `.installed-version { font-size: 13px; font-style: italic;
                        // opacity: .6 }`
                        if ContentState.detail-installed-version != "" : Text {
                            text: @tr("Installed: {}", ContentState.detail-installed-version);
                            font-size: 13px;
                            font-italic: true;
                            color: Theme.subtext-1;
                            opacity: 0.6;
                            vertical-alignment: center;
                            height: 36px;
                            horizontal-alignment: left;
                        }
                    }

                    // ----- the body -----
                    // The CurseForge panels put the box behind `v-if`, the
                    // Modrinth ones do not — an empty body still draws the
                    // surface0 box there (`ContentState.detail-body-always`).
                    if ContentState.detail-body != "" || ContentState.detail-body-always : markdown-body := MarkdownBody {
                        // The scroller's offset and height, for the body to cull
                        // against. The view is a grandchild of the scroller and
                        // cannot reach it, so both are passed down.
                        scroll-y: scroller.content-y;
                        viewport-height: scroller.height;
                        // …and where this box sits inside the scrolled content.
                        // The view measures its culling window from its *own* top,
                        // so handing it the scroller's offset alone culls away the
                        // header and the action row above it — a blank band at the
                        // top of the body whenever the panel is shorter than they
                        // are. A layout assigns `y` to each of its children, so
                        // the three steps up are each readable.
                        top-in-scroll: details-column.y
                            + details-inner.y
                            + markdown-body.y;
                    }

                    // ----- the gallery (Modrinth projects) -----
                    if ContentState.detail-gallery.length > 0 : Rectangle {
                        // `.gallery { padding: 16px; height: 252px }`
                        width: 100%;
                        height: 252px;
                        background: Theme.surface-0;
                        border-radius: 8px;

                        // `.gallery-list { height: 100%; padding: 0 8px; gap: 12px;
                        // align-items: center }` inside the 16px padding, so the
                        // items start 24px in and the row is 220px tall. The Vue
                        // scrolled this with a `ScrollViewHorizontal`, which is
                        // what it is again here: the box clips, so a plain
                        // `HorizontalLayout` in it would have shown the first few
                        // shots and nothing else.
                        gallery-scroll := ScrollViewHorizontal {
                            x: 24px;
                            y: 16px;
                            width: parent.width - 48px;
                            height: parent.height - 32px;
                            // `.gallery-list`'s own `padding: 0 8px`, against the
                            // track rather than the row.
                            scrollbar-left: 8px;
                            scrollbar-right: 8px;

                            HorizontalLayout {
                                spacing: 12px;
                                cross-axis-alignment: center;

                                // `.gallery-item { height: calc(100% - 16px) }` —
                                // 204px in the 220px row, centred.
                                for shot in ContentState.detail-gallery : Rectangle {
                                    width: shot.ratio * 204px;
                                    height: 204px;
                                    border-radius: 8px;
                                    clip: true;
                                    background: transparent;

                                    Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: shot.image;
                                        image-fit: cover;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
export component DetailPanels inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    ContentOverlay {
        overlay-visible: ContentState.open-detail != "";
        panel-background: Theme.base;
        closed => { ContentState.close-detail(); }

        DetailBody { }
    }
}
