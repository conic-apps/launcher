import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/app-icon.slint";
import { WorldMap } from "../../components/world-map.slint";
import { WorldMapState } from "../../globals/worldmap.slint";
import { CardTag, ContentCard as CardData, ContentText } from "../../globals/content.slint";
import { GameState, GameTime } from "../../globals/game.slint";

// One card of a content grid, shared by all nine grids — the two local lists,
// the six remote ones and the saves.
//
// The card is built out of three overlapping boxes; the hover state reaches into
// them:
//
//     card           translateX(4px)          rgba(surface0, .4), radius 8
//     image          72px wide, 2px surface0 border, radius 8 0 0 8
//     info           starts where the image ends and its own transform pulls it
//                    8px back over it, width calc(100% - 72px) → -88px on
//                    hover, surface0 → surface1
//     actions        right: 4px, behind the rest, buttons at opacity 0 / scale
//                    .5
//
// Three things work differently here:
//
//   * The 4px right shift is folded into the card's `x`, which Rust computes —
//     there is one place that knows the grid geometry.
//   * The action column sits *behind* the image and the info block. Slint has no
//     negative z, so the column is declared **before** them: siblings paint in
//     declaration order and hit-test in reverse, which is the same result.
//   * The image's rounded left corners need a `clip`, and a rounded `clip` is a
//     no-op on the software renderer (see the README's Windows note) — the one
//     place a card can come out square, like `AccountAvatar`.
//
// One tag of the info block; its kind picks the fill.
//
// One button of the card's action column: invisible until the card is hovered,
// then `.8` opacity and full scale, over 200ms.
//
// It draws only — the card owns the pointer (see `ContentCard`'s `hover-area`)
// and hands the button its own hover and press state, because a `TouchArea` here
// would take the card's hover away the moment the pointer reached it.
component ActionButton inherits Rectangle {
    in property <string> kind: "heart";
    in property <bool> favorited: false;
    /// The whole card is hovered.
    in property <bool> shown: false;
    /// The pointer is over this button, worked out from its position.
    in property <bool> pointed: false;
    in property <bool> pressed: false;

    // 14px, the size of the `AppIcon`: the button is exactly as big as its
    // glyph. A 20px box left the glyph against the info block instead of centred
    // in the 24px the hover opens up.
    width: 14px;
    height: 14px;
    background: transparent;
    opacity: root.shown ? (root.pressed ? 0.9 : (root.pointed ? 1.0 : 0.8)) : 0.0;
    transform-scale: root.shown ? 1.0 : 0.5;

    animate opacity, transform-scale {
        duration: 200ms;
        easing: ease-out-quad;
    }

    // The heart is outlined until it is favourited, when it also turns red.
    AppIcon {
        name: root.kind == "heart" && !root.favorited ? "heart-outline" : root.kind;
        size: 14px;
        icon-color: root.favorited && root.kind == "heart"
            ? Theme.red
            : Theme.default-text-color.transparentize(0.1);
    }
}
component TagChip inherits Rectangle {
    in property <CardTag> tag;

    // The tag family. A loader or game-mode tag is a 9px pill with 2px/6px
    // padding, a 4px right margin, a 100px radius, weight 500 and inverse text;
    // its kind picks the fill (fabric and liteloader yellow, forge blue,
    // neoforge and adventure peach, quilt and creative mauve, survival green).
    // A version tag is the one outline: a 1px sky border and body text, no fill.
    // A command tag is yellow with a 4px left margin; a last-played tag is 10px
    // with a 4px left margin.
    //
    // The margins are *outside* the pill, which is why the background lives on
    // an inner box: a tag's own box is `margin + padding + label`.
    private property <bool> pill: tag.kind != "last-played" && tag.kind != "plain";
    private property <length> margin-before:
        tag.kind == "command-enabled" || tag.kind == "last-played" ? 4px : 0px;
    private property <length> margin-after:
        tag.kind == "version"
            || tag.kind == "loader-fabric"
            || tag.kind == "loader-forge"
            || tag.kind == "loader-neoforge"
            || tag.kind == "loader-quilt"
            || tag.kind == "loader-liteloader" ? 4px
        : 0px;

    // One line box for the run — the info block's 16px strut — with a 13px
    // pill centred in it (9px of text plus its 4px of padding).
    height: 16px;
    width: root.margin-before + pill-box.width + root.margin-after;
    background: transparent;

    // A last-played tag's halves are both translated, so neither can be
    // composed in Rust; the relative time comes from the same `GameTime` helper
    // the instance cards use, and the game-mode / cheats tags are words the card
    // resolves itself, for the same reason.
    private property <string> resolved: root.tag.kind == "last-played"
        ? ContentText.last-played-label()
            + GameTime.last-played(
                root.tag.time-kind,
                root.tag.time-hours,
                root.tag.time-month,
                root.tag.time-day,
                root.tag.time-year,
            )
        : root.tag.kind == "game-mode-survival" || root.tag.kind == "game-mode-creative"
            || root.tag.kind == "game-mode-adventure" || root.tag.kind == "game-mode-spectator"
            || root.tag.kind == "command-enabled" ? ContentText.save-tag(root.tag.kind)
        : root.tag.label + root.tag.text;

    pill-box := Rectangle {
        x: root.margin-before;
        y: root.pill ? 1.5px : 0px;
        height: root.pill ? 13px : 16px;
        border-radius: 100px;
        background: tag.kind == "loader-fabric" || tag.kind == "loader-liteloader"
                || tag.kind == "command-enabled" ? Theme.yellow
            : tag.kind == "loader-forge" ? Theme.blue
            : tag.kind == "loader-neoforge" ? Theme.peach
            : tag.kind == "loader-quilt" ? Theme.mauve
            : tag.kind == "game-mode-survival" ? Theme.green
            : tag.kind == "game-mode-creative" ? Theme.mauve
            : tag.kind == "game-mode-adventure" ? Theme.peach
            : tag.kind == "game-mode-spectator" ? Theme.blue
            : transparent;
        // The version tag is the only outlined one.
        border-width: tag.kind == "version" ? 1px : 0px;
        border-color: Theme.sky;

        label := Text {
            text: root.resolved;
            // A version reads as body text, not as the inverse of its own fill,
            // because it has no fill. A last-played tag's label is drawn at 70%
            // and its value at full strength; Slint has no per-span styling, so
            // the whole tag takes the label's dimmer colour.
            color: !root.pill || tag.kind == "version"
                ? Theme.default-text-color.transparentize(root.pill ? 0.1 : 0.3)
                : Theme.text-inverse;
            font-size: root.pill ? 9px : 10px;
            // The pill classes are weight 500; a last-played tag keeps the body
            // weight.
            font-weight: root.pill ? 500 : Theme.font-weight-normal;
            x: root.pill ? 6px : 0px;
            vertical-alignment: center;
        }

        width: label.width + (root.pill ? 12px : 0px);
    }
}
export component ContentCard inherits Rectangle {
    in property <CardData> card;
    /// 72px for the content lists, 64px for the saves.
    in property <length> icon-size: 72px;
    /// Whether the card reacts to the pointer. The empty-state placeholder that
    /// covers an empty grid turns it off.
    in property <bool> interactive: true;
    /// Which line style the second row takes: "authors" (11px, 2px margins) for
    /// the content lists, "folder" (10px, 4px margins) for the saves' folder.
    in property <string> subtitle-style: "authors";

    callback select();
    callback open-path();
    callback delete();
    callback toggle-favorite();
    callback open-link();
    callback play();

    // The card's place in the grid, from Rust (`layout` in
    // `app/src/content/grid.rs`).
    // A grid has no layout of its own here — the cards are positioned by hand —
    // so without these every card is drawn at the grid's origin and they pile up
    // on one another.
    x: card.x;
    y: card.y;
    width: card.width;
    height: card.height;
    visible: card.in_view;
    // surface0 at 40%.
    background: Theme.surface-0.transparentize(0.6);
    border-radius: 8px;
    // A disabled mod is dimmed.
    opacity: card.mod-disabled ? 0.7 : 1.0;
    // An expanded save rises over its neighbours.
    z: card.selected ? 10 : 0;

    // The card holds **one** `TouchArea`, and every hover-revealed control is a
    // plain drawing that it routes clicks to by position.
    //
    // One `TouchArea` per control does not work: `has-hover` is only ever true
    // for the *topmost* area under the pointer, so the moment the pointer reached
    // an action button the card stopped being hovered — the column faded out from
    // under the pointer, the pointer was over the card again, and the two chased
    // each other every time the mouse moved.
    //
    // The column sits 4px from the right with 12px of padding, exactly as wide as
    // a button's 14px glyph, and the play button is an 18px button vertically
    // centred 20px from the left.
    hover-area := TouchArea {
        enabled: root.interactive;
        clicked => {
            if root.over-play {
                root.play();
            } else if root.over-first {
                if root.card.action-kind == "favorite" {
                    root.toggle-favorite();
                } else {
                    root.open-path();
                }
            } else if root.over-second {
                if root.card.action-kind == "favorite" {
                    root.open-link();
                } else {
                    root.delete();
                }
            } else if hover-area.mouse-x <= root.inner-right {
                root.select();
            }
        }
    }

    private property <bool> hovered: hover-area.has-hover || expansion.pointed;
    /// The 16px the inner card gives up while the pointer is on the card.
    private property <length> info-inset: root.hovered ? 16px : 0px;
    /// Where the inner card ends: the image and the info block are what the card
    /// *is*; the strip of the grid cell past them is its transparent overhang,
    /// and a click there opens nothing.
    private property <length> inner-right:
        root.icon-size - 8px + max(0px, root.width - root.icon-size - root.info-inset);

    /// The 4px right inset around the 14px column.
    private property <length> actions-left: root.width - 18px;
    private property <bool> column-shown: root.card.action-kind != "";
    private property <length> play-top: (root.height - 18px) / 2;

    /// Whether the pointer is over the column's top button — the favourites'
    /// heart, or a local card's folder.
    private property <bool> over-first:
        root.hovered && root.column-shown
            && hover-area.mouse-x >= root.actions-left
            && hover-area.mouse-y >= 12px && hover-area.mouse-y <= 26px;
    private property <bool> over-second:
        root.hovered && root.column-shown
            && hover-area.mouse-x >= root.actions-left
            && hover-area.mouse-y >= root.height - 26px && hover-area.mouse-y <= root.height - 12px;
    private property <bool> over-play:
        root.hovered && root.card.shows-play
            && hover-area.mouse-x >= 20px && hover-area.mouse-x <= 38px
            && hover-area.mouse-y >= root.play-top && hover-area.mouse-y <= root.play-top + 18px;

    // The hover-revealed action column: two buttons pushed to its ends. Neither
    // takes clicks — the card's own area routes them here by position.
    if root.column-shown : Rectangle {
        x: root.actions-left;
        y: 0;
        width: 14px;
        height: root.height;
        background: transparent;

        actions := VerticalLayout {
            // 12px of padding, with the two buttons pushed to the ends.
            padding-top: 12px;
            padding-bottom: 12px;
            alignment: space-between;

            ActionButton {
                kind: root.card.action-kind == "favorite" ? "heart" : "folder";
                favorited: root.card.favorited;
                shown: root.hovered;
                pointed: root.over-first;
                pressed: root.over-first && hover-area.pressed;
            }

            ActionButton {
                kind: root.card.action-kind == "favorite" ? "link" : "trash";
                shown: root.hovered;
                pointed: root.over-second;
                pressed: root.over-second && hover-area.pressed;
            }
        }
    }

    icon-box := Rectangle {
        x: 0;
        y: 0;
        width: root.icon-size;
        height: root.height;
        border-width: 2px;
        border-color: Theme.surface-0;
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
        clip: true;

        Image {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            source: root.card.icon;
            image-fit: ImageFit.fill;
            // The *saves* cards dim their world icon while the info block opens
            // up; the mods cards do not. The saves are the only cards whose
            // second line is a folder name (and the only ones with a play
            // button), which is what this keys off.
            opacity: root.hovered && root.subtitle-style == "folder" ? 0.4 : 1.0;
            animate opacity {
                duration: 200ms;
                easing: ease-out;
            }
        }
    }

    info := Rectangle {
        // The block sits after the image; -8px pulls it back over the image's
        // right edge. On hover it is the same block 16px narrower. Only the
        // *inset* is animated: `width` also follows the card's own width, so
        // animating it left the block a frame behind the card around it while the
        // window was being resized. The animation has to be on a property this
        // element owns: an `animate` cannot reach into another element's property.
        private property <length> inset: root.info-inset;

        x: root.icon-size - 8px;
        y: 0;
        height: root.height;
        width: max(0px, root.width - root.icon-size - self.inset);
        background: root.hovered ? Theme.surface-1 : Theme.surface-0;
        border-radius: 8px;

        animate inset, background {
            duration: 200ms;
            easing: ease-out-quad;
        }

        // 8px vertically and 12px horizontally.
        info-layout := VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 0px;

            // The name is 14px, weight 700, nowrap + ellipsis. Its line box is
            // its *own* font size: everything uses `line-height: 1`, and a
            // block's strut comes from its own font, not the parent's.
            // The line box is its own 14px row: the strikethrough below is
            // drawn over it, and a layout child may not set its own `y`, so the
            // two live inside this wrapper.
            Rectangle {
                height: 14px;
                background: transparent;

                name := Text {
                    width: parent.width;
                    height: parent.height;
                    text: (root.card.mod-disabled ? ContentText.disabled-prefix : "")
                        + root.card.title;
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.default-text-color.transparentize(0.1);
                    overflow: elide;
                    vertical-alignment: center;
                }

                // A disabled mod's name is struck through. Slint's `Text` has no
                // decoration property, hence the rule drawn by hand: a hairline
                // through the middle of the line box, as wide as the text it drew
                // — `preferred-width` while that fits, the elided block when it
                // does not — in the text's ink.
                if root.card.mod-disabled : Rectangle {
                    x: 0;
                    width: min(name.preferred-width, name.width);
                    height: 1px;
                    background: name.color;
                }
            }

            // The authors line is 11px at 90%; the folder line is 10px at 60%.
            if root.card.has-subtitle : Text {
                text: root.card.subtitle;
                font-size: root.subtitle-style == "folder" ? 10px : 11px;
                // The authors line is at 90%, and the body ink is already at
                // 90%: the two multiply.
                color: Theme.default-text-color.transparentize(
                    root.subtitle-style == "folder" ? 0.4 : 0.1,
                );
                overflow: elide;
                vertical-alignment: center;
                // 2px around the authors line, 4px around the folder one.
                height: root.subtitle-style == "folder" ? 18px : 15px;
            }

            // The description is 10px at 60%. A card with no description — a
            // save — draws no line at all.
            if root.card.description != "" : Text {
                text: root.card.description;
                font-size: 10px;
                color: Theme.default-text-color.transparentize(0.4);
                overflow: elide;
                vertical-alignment: center;
                // 2px around the 10px line box.
                height: 14px;
            }

            // The tags share one line box. A pill's right margin and the
            // last-played tag's left margin are both 4px; one 4px step is used
            // for all of them, so a run of pills reads 4px tighter than the two
            // margins together would.
            tags := HorizontalLayout {
                height: 16px;
                // The tags carry their own margins (see `TagChip`).
                spacing: 0px;
                // The run starts at the block's left edge.
                cross-axis-alignment: center;

                for tag in root.card.tags : TagChip {
                    tag: tag;
                }
            }
        }
    }

    // The saves' play button: 20px from the left, vertically centred, revealed
    // with the hover.
    if root.card.shows-play : Rectangle {
        x: 20px;
        width: 18px;
        height: 18px;
        background: transparent;
        opacity: root.hovered ? 1.0 : 0.0;
        transform-scale: root.hovered ? 1.0 : 0.5;

        animate opacity, transform-scale {
            duration: 200ms;
            easing: ease-out-quad;
        }

        AppIcon {
            name: "play";
            size: 18px;
            // The ionicon play glyph is a fill, and `fill` defaults to the
            // body ink.
            icon-color: Theme.default-text-color.transparentize(0.1);
        }
    }

    // The saves' expansion: a selected save grows to `height + 160px` (or hangs
    // upwards when the card sits near the bottom of the window), takes an
    // outline and rises above the neighbouring cards. It is declared last so it
    // paints over the info block, and it holds the save's world map.
    //
    // The box *grows* by 160px over 200ms rather than appearing. Expanding
    // upwards pins it to the card's bottom edge, so the growth is what moves its
    // top edge up.
    //
    // `visible` rather than `if`, so the card's hover can take the expanded area
    // into account: the expansion is a child of the card, and a hovered
    // descendant keeps the card hovered.
    expansion := Rectangle {
        private property <float> expanded: root.card.selected ? 1.0 : 0.0;

        visible: self.expanded > 0.0;
        x: 0;
        y: root.card.expand-up ? -160px * self.expanded : 0px;
        width: root.width;
        height: root.height + 160px * self.expanded;
        opacity: self.expanded;
        animate height, opacity, y {
            duration: 200ms;
            easing: ease;
        }
        background: Theme.surface-0;
        border-radius: 8px;
        // A 2px outline; a border is drawn inside the box, an outline outside
        // it.
        border-width: 2px;
        border-color: Theme.blue;

        // A click on the expanded area opens nothing; it only keeps the card
        // hovered.
        expansion-touch := TouchArea { }

        // 8px of padding around the world map, which draws its own rounded base
        // background.
        //
        // One world map exists at a time, and it is torn down when the card is
        // deselected — which is also what drops the tiles, since the cache is
        // keyed by world.
        if root.card.selected && GameState.has-current : WorldMap {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            folder-name: root.card.id;
            instance-id: GameState.current-id;
            // The spawn is read out of `level.dat`. `0, 0` is what a world
            // without a `spawn.pos` gets, and Rust falls back to the world's own
            // spawn for that — see `worldmap.rs`.
            center-x: root.card.spawn-x;
            center-z: root.card.spawn-z;
            show-cursor-coords: true;
            cursor-coordinates-position: "bottom-center";
        }

        // The map's own hover counts: the expansion is a child of the card, and
        // hovering a descendant leaves the card hovered. `expansion-touch` is
        // *under* the map, so it stops being hovered the moment the pointer
        // reaches it.
        out property <bool> pointed: expansion-touch.has-hover || WorldMapState.hovered;
    }
}
