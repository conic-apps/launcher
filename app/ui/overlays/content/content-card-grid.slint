import { ContentCard as CardData, ContentState } from "../../globals/content.slint";
import { ContentCard } from "content-card.slint";

// The card grid, shared by all nine lists.
//
// The intended grid is `repeat(auto-fill, minmax(290px, 1fr))` with a 12px gap
// and `16px 32px 32px 32px` padding. Slint has no wrapping grid — its only
// multi-column construct is `Row`, and a repeated child becomes a single cell —
// so the column count has to come from outside in any case, and Rust computes
// it from the panel's width and lays every card out. Each card's `x`/`y`/
// `width`/`height` is therefore already in the model, and this component is the
// `for` that draws them plus the empty state over the top.
export component ContentCardGrid inherits Rectangle {
    in property <[CardData]> cards: [];
    /// 72px for the content lists, 64px for the saves.
    in property <length> icon-size: 72px;
    in property <string> subtitle-style: "authors";
    /// Rust's rows × row height plus the padding. It has to be given rather
    /// than measured — the cards are positioned absolutely, and an
    /// absolutely-positioned child contributes nothing to its parent's
    /// measurement, so the panel's `ScrollView` would otherwise see a grid of
    /// zero height and stop scrolling.
    in property <length> grid-height: 0px;

    callback select(string);
    callback open-path(string);
    /// The card's trash button. Carries the card's title as well as its id,
    /// because the saves grid has to name the save in the confirmation dialog
    /// (`ConfirmDeleteSave`) and the id is the folder, not the name.
    callback delete(string, string);
    callback toggle-favorite(string);
    callback open-link(string);
    callback play(string);

    width: 100%;
    height: root.grid-height;
    background: transparent;

    // The grid's own padding. The visible cards live inside it; the empty state
    // is centred over the whole area, padding included.
    grid := Rectangle {
        x: 32px;
        y: 16px;
        width: max(0px, parent.width - 64px);
        height: root.grid-height;
        background: transparent;

        for card in root.cards : ContentCard {
            card: card;
            icon-size: root.icon-size;
            subtitle-style: root.subtitle-style;
            select => { root.select(card.id); }
            open-path => { root.open-path(card.id); }
            delete => { root.delete(card.id, card.title); }
            toggle-favorite => { root.toggle-favorite(card.id); }
            open-link => { root.open-link(card.link); }
            play => { root.play(card.id); }
        }
    }

}
