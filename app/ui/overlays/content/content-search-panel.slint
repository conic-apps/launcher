import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/app-icon.slint";
import { ContentSearch, ContentState, ContentText, FilterChip, FilterRow } from "../../globals/content.slint";
component ChipPager inherits Rectangle {
    in property <bool> flipped: false;
    in property <bool> disabled: false;
    callback clicked;

    width: 26px;
    height: 26px;
    border-width: 1px;
    border-color: Theme.surface-1;
    border-radius: 999px;
    background: touch.has-hover && !root.disabled ? Theme.surface-1 : Theme.surface-0;
    opacity: root.disabled ? 0.4 : 1.0;

    AppIcon {
        name: "chevron-forward";
        size: 12px;
        icon-color: Theme.default-text-color.transparentize(0.1);
        transform-rotation: root.flipped ? 180deg : 0deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}
component FilterChipView inherits Rectangle {
    in property <FilterChip> chip;
    /// The chip's own width, which the version carousel needs: a repeated
    /// element's geometry cannot be read from outside in Slint, so each chip
    /// reports what it measured. Unhandled by the wrapping rows.
    callback measured(length);

    height: 20px;
    // From the label, explicitly: a component's own `preferred-width` came out
    // as zero here, which stacked every chip of a row on top of the others.
    width: label.preferred-width + 16px;
    border-radius: 999px;
    background: !root.chip.selected ? (touch.pressed ? Theme.surface-2
            : touch.has-hover ? Theme.surface-1 : transparent)
        : root.chip.accent == "fabric" ? Theme.yellow
        : root.chip.accent == "forge" ? Theme.blue
        : root.chip.accent == "neoforge" ? Theme.peach
        : root.chip.accent == "quilt" ? Theme.mauve
        : root.chip.accent == "minecraft-version" ? Theme.green
        : root.chip.accent == "favorites" ? Theme.yellow
        : Theme.lavender;

    // The *leave* eases and the enter does not, which is what `duration` bound
    // to the hover state says. A pressed or selected chip eases either way.
    animate background {
        duration: touch.has-hover && !touch.pressed && !root.chip.selected ? 0ms : 120ms;
        easing: ease-out;
    }

    label := Text {
        width: self.preferred-width;
        // A chip whose label comes from a table is resolved here rather than in
        // Rust, so it follows a language change.
        text: root.chip.translated
            ? ContentText.chip-label(ContentState.remote-kind, ContentState.source, root.chip.label-key)
            : root.chip.text;
        font-size: 12px;
        x: 8px;
        color: root.chip.selected ? Theme.text-inverse : Theme.default-text-color.transparentize(0.1);
    }

    touch := TouchArea {
        clicked => { ContentSearch.chip-clicked(root.chip.value); }
    }

    // `changed` does not fire for the value an element is created with, hence
    // both.
    init => { root.measured(root.width); }
    changed width => { root.measured(root.width); }
}
component VersionCarousel inherits Rectangle {
    in property <[FilterChip]> chips: [];

    height: 26px;
    background: transparent;

    private property <int> page: ContentSearch.version-page;

    HorizontalLayout {
        spacing: 6px;
        // Centring is on the *cross* axis, not the main axis: a main-axis
        // alignment other than the default `stretch` makes the layout hand every
        // child its preferred width and drop its `horizontal-stretch`, which
        // collapses the viewport below to zero.
        cross-axis-alignment: center;

        ChipPager {
            flipped: true;
            disabled: root.page <= 0;
            clicked => { ContentSearch.version-page-prev(); }
        }

        // The viewport that clips the track.
        viewport := Rectangle {
            horizontal-stretch: 1;
            height: parent.height;
            clip: true;
            background: transparent;

            // The whole track is drawn and the viewport clips it, which is why
            // more than one page's worth of chips shows at once. Rust computes
            // the offset from the widths the chips report
            // (`ContentSearch.chip-measured`), because a repeated element's
            // geometry is not readable here.
            //
            // A layout child's own `x` belongs to its layout, so this is a plain
            // `Rectangle` holding the track: it is the thing that moves.
            track := HorizontalLayout {
                x: -ContentSearch.version-offset;
                y: 0;
                width: self.preferred-width;
                height: parent.height;
                spacing: 6px;
                cross-axis-alignment: center;

                for chip in root.chips : FilterChipView {
                    chip: chip;
                    measured(width) => { ContentSearch.chip-measured(chip.value, width); }
                }

                // The animate is declared on the element that owns the property;
                // it cannot reach into a sibling.
                animate x {
                    duration: 240ms;
                    easing: ease-out-quad;
                }
            }
        }


        ChipPager {
            disabled: root.page >= max(0, ContentSearch.version-page-count - 1);
            clicked => { ContentSearch.version-page-next(); }
        }
    }
}

// The remote lists' search + filter header.
//
// A translucent crust panel with a 36px search field and a button beside it,
// then one row per filter: a 52px label and a run of pill chips. The loader and
// category rows wrap; the version row is the paginated one and does not.
//
// The wrapping rows are a `FlexboxLayout` with `flex-wrap: wrap`. (The plain
// `HorizontalLayout` used everywhere else in this app never wraps.)
//
// The version row is paginated by translating the whole track by its negative
// offset with a 240ms ease. Slint cannot read a repeated element's geometry from
// outside, and an id inside a `for` is deliberately unreachable — but each chip
// can *report* the width it measured, and the offset is the sum of the ones
// before the page. That is what makes the same track-and-clip arrangement
// possible here.
//
// A filter chip is a 20px pill whose `accent` picks the selected fill. A pager
// is a 26px round arrow button. The version row's carousel is a pager, the whole
// track in a clipped viewport, and a pager. One filter row is the label, then
// either the chip carousel or a wrapping run of chips.
component FilterRowView inherits Rectangle {
    in property <FilterRow> row-data;
    in property <bool> is-version-row: false;

    width: 100%;
    height: root.row-data.height;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        // The cross axis is left at its default (`stretch`) deliberately: a
        // non-stretch alignment hands each child its **preferred** size, and a
        // wrapping `FlexboxLayout`'s preferred height is measured at its own
        // "roughly square" width — about twice the lines it actually draws — so
        // the chip run would be given a box twice as tall as its content and
        // would spread its lines across it. Stretched, it takes the row's own
        // height, which Rust computed from the chips' measured widths. The label
        // and the carousel are unaffected: both set an explicit height.

        Text {
            // A 52px label column.
            text: ContentText.row-label(root.row-data.label);
            font-size: 12px;
            color: Theme.subtext-0;
            min-width: 52px;
            horizontal-alignment: left;
            // The 20px line box centres the 12px text.
            vertical-alignment: center;
            height: 20px;
        }

        if root.is-version-row : VersionCarousel {
            horizontal-stretch: 1;
            // The row's own chips are empty: the carousel draws the whole track,
            // which is not a page's worth and therefore not what a `FilterRow`
            // carries.
            chips: ContentSearch.version-chips;
        }

        if !root.is-version-row : FlexboxLayout {
            horizontal-stretch: 1;
            flex-wrap: wrap;
            spacing: 6px;

            for chip in root.row-data.chips : FilterChipView {
                chip: chip;
                // The row's height is computed in Rust from these (Slint cannot
                // measure a wrapping `FlexboxLayout` at the width it is given).
                measured(width) => { ContentSearch.chip-measured(chip.value, width); }
            }
        }
    }

}
export component ContentSearchPanel inherits Rectangle {
    width: 100%;
    // A Slint layout has no margin, so the box is the content plus the bottom
    // 16px, and the background stops where the panel does instead of running
    // behind the gap.
    height: panel-content.preferred-height + 16px;
    background: Colors.transparent;

    panel := Rectangle {
        width: 100%;
        height: panel-content.preferred-height;
        // `backdrop-filter: blur(4px)` has no Slint equivalent, so the panel
        // stays translucent without the blur (the same trade the game view's
        // toolbar and footer make).
        background: Theme.crust.with-alpha(0.92);

        panel-content := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                height: 36px;
                spacing: 8px;

                search-field := Rectangle {
                    horizontal-stretch: 1;
                    height: 36px;
                    border-radius: 8px;
                    // A lighter fill on hover.
                    background: field-touch.has-hover ? Theme.surface-1 : Theme.surface-0;

                    input := TextInput {
                        x: 12px;
                        y: 0;
                        width: parent.width - 24px;
                        height: parent.height;
                        text <=> ContentSearch.query;
                        font-size: 13px;
                        color: Theme.default-text-color.transparentize(0.1);
                        selection-background-color: Theme.default-text-color.with-alpha(0.3);
                        selection-foreground-color: Theme.default-text-color;
                        single-line: true;
                        vertical-alignment: center;
                        // The query is committed on Enter; the input is bound to
                        // the model as it is typed.
                        accepted => { ContentSearch.search(); }
                    }

                    if ContentSearch.query == "" : Text {
                        text: ContentText.search-placeholder(ContentState.remote-kind);
                        font-size: 13px;
                        color: Theme.subtext-0;
                        x: 12px;
                    }

                    field-touch := TouchArea {
                        // The field carries only the hover fill, no border.
                        //
                        // The area sits *over* the input (it is declared after it, so
                        // it takes the press), which is what gives the field its
                        // hover fill — so it has to hand the focus over explicitly,
                        // or clicking the field would never put a cursor in it.
                        clicked => { input.focus(); }
                    }
                }

                search-button := Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 8px;
                    background: button-touch.pressed ? Theme.lavender
                        : button-touch.has-hover ? Theme.surface-1
                        : Theme.surface-0;

                    AppIcon {
                        name: "search";
                        size: 16px;
                        // Inverse text while pressed.
                        icon-color: button-touch.pressed
                            ? Theme.text-inverse
                            : Theme.default-text-color.transparentize(0.1);
                    }

                    button-touch := TouchArea {
                        clicked => { ContentSearch.search(); }
                    }
                }
            }

        VerticalLayout {
            spacing: 8px;

            for filter-row[index] in ContentSearch.filters : FilterRowView {
                row-data: filter-row;
                is-version-row: index == ContentSearch.version-row;
            }
        }
        }
    }
}
