import { AccountAddDialog } from "dialogs/account-add.slint";
import { CreateInstance } from "dialogs/create-instance.slint";
import { LaunchErrorDialogs } from "dialogs/launch-errors.slint";
import { MultiplayerExtension } from "dialogs/multiplayer-extension.slint";
import { ConfirmDeleteInstance } from "dialogs/confirm-delete-instance.slint";
import { ConfirmDeleteSave } from "dialogs/confirm-delete-save.slint";
import { ConfirmQuitApp } from "dialogs/confirm-quit-app.slint";

// The overlay layer: one instance per dialog, mounted once above the whole app.
// Each dialog stays hidden until its flag in `Dialogs` is set, and draws its own
// scrim, so a dialog that is closed lets everything through.
export component DialogRoot inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    /// The "Let me out!" button of `ConfirmQuitApp`, forwarded to the app root
    /// (which plays the exit animation and closes the window).
    callback confirm-quit();

    CreateInstance { }
    // The instance settings overlay's "Delete instance" row. It sits right after
    // `CreateInstance` and ahead of the four launch errors, so a create-instance
    // dialog that is still open covers it and a launch error covers it in turn.
    ConfirmDeleteInstance { }
    // Slint draws and hit-tests in declaration order. The four launch-error
    // dialogs come ahead of `MultiplayerExtension` and `AccountAdd`, so a launch
    // error raised while one of those is open is drawn *over* it — which is the
    // case that matters, since a launch is what raises one. The last instance is
    // the top one.
    LaunchErrorDialogs { }
    MultiplayerExtension { }
    AccountAddDialog { }
    // The saves grid's trash button and the title bar's close button, last: a
    // delete or a quit is the thing the user reached the app for, so it is asked
    // over whatever else is open.
    ConfirmDeleteSave { }
    ConfirmQuitApp {
        confirm => { root.confirm-quit(); }
    }
}
