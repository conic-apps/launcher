import { Dialog } from "../dialog.slint";
import { Dialogs } from "../../../globals/dialogs.slint";
import { AccountAdd } from "account-add.slint";

// The add-account dialog: the `AccountAdd` view's body inside a plain modal.
//
// The panel animates its height: it sizes to the mounted screen and tweens to it
// over 300ms, an ease-out-quad applied by `Dialog` itself off this height.
// Slint has no fit-content panel mode, so the height is taken from the measuring
// layout the content is written in: `body` is a VerticalLayout, so its
// `preferred-height` is the content's height, and it is evaluated before the
// panel's height is applied to it (the content's *width* comes from the panel,
// the height does not, so the two do not depend on each other).
//
// 572px is the 540px body plus the dialog's 16px padding on each side, which
// leaves `Dialog.content-width` at exactly 540.
export component AccountAddDialog inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    dialog := Dialog {
        dialog-visible: Dialogs.account-add-visible;
        dialog-width: 572px;
        dialog-height: body.preferred-height + 32px;

        body := AccountAdd {
            content-width: dialog.content-width;
        }
    }
}
