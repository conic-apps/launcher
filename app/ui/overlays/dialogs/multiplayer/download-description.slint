import { Theme } from "../../../theme.slint";
import { Button } from "../../../components/controls/button.slint";
import { MultiplayerState } from "../../../globals/multiplayer.slint";

// The "download the Conic Nexus extension" screen: the title, the three
// paragraphs and the Cancel / Start download pair.
//
// The title's 16px and the buttons' 16px do not stack, so the gap before the
// buttons is 16px — the spacers below spell that out.
export component MultiplayerDownloadDescription inherits VerticalLayout {
    width: 100%;
    // The 16px title gap and the 16px button gap are both 16px, so one `spacing`
    // carries the two. The 8px gaps are a different value and are kept as
    // spacers.
    spacing: 16px;
    alignment: start;

    Text {
        text: @tr("Multiplayer" => "Download the Conic Nexus extension");
        font-size: 22px;
        line-height-factor: 1;
        horizontal-alignment: center;
        color: Theme.default-text-color.transparentize(0.1);
    }

    Text {
        text: @tr("Multiplayer" => "The Conic Nexus extension is built on EasyTier and implements the Scaffolding protocol, so it can play together with many other launchers, HMCL included.");
        font-size: 14px;
        line-height-factor: 1.5;
        wrap: word-wrap;
        color: Theme.default-text-color.transparentize(0.1);
    }

    Rectangle { height: 8px; background: transparent; }

    Text {
        text: @tr("Multiplayer" => "Conic Nexus only uses P2P connections. Once the room is up, its members connect to each other directly; no third-party server relays your traffic. How well it works depends on the network conditions of everyone taking part.");
        font-size: 14px;
        line-height-factor: 1.5;
        wrap: word-wrap;
        color: Theme.default-text-color.transparentize(0.1);
    }

    Rectangle { height: 8px; background: transparent; }

    // The paragraph is measured by its wrap width rather than by a nested
    // layout: a `Text` one layout level away from the column that owns its width
    // reports a single line (see the account dialog's Yggdrasil note), so the
    // box takes its height from the text and the text is placed by hand.
    important := Rectangle {
        width: 100%;
        height: important-text.preferred-height + 18px;
        background: Theme.red.with-alpha(0.15);
        border-width: 1px;
        border-color: Theme.red;
        border-radius: 8px;

        important-text := Text {
            x: 16px;
            y: 8px;
            width: parent.width - 34px;
            text: @tr("Multiplayer" => "Please note that you must strictly obey all laws and regulations of your country and region throughout the whole multiplayer session.");
            font-size: 14px;
            line-height-factor: 1.5;
            wrap: word-wrap;
            vertical-alignment: top;
            color: Theme.red;
        }
    }

    // A bare row of two buttons with a 12px gap.
    // The default `stretch`, not `alignment: start` — see `overlays/dialogs/create-instance/create-instance.slint`.
    HorizontalLayout {
        spacing: 12px;

        Button {
            horizontal-stretch: 1;
            text: @tr("Multiplayer" => "Cancel");
            clicked => { MultiplayerState.close(); }
        }

        Button {
            horizontal-stretch: 1;
            text: @tr("Multiplayer" => "Start download");
            text-color: Theme.text-inverse;
            button-background: Theme.blue;
            clicked => { MultiplayerState.component = "downloadProgress"; }
        }
    }
}
