import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { Button } from "../../components/controls/button.slint";

// The body shared by the two "are you sure?" dialogs that are a warning icon, a
// two-line message and a blue/red button pair:
//
//   ConfirmDeleteSave
//   ConfirmQuitApp
//
// The two dialogs differ only in what the four strings say, which is why they are
// one here. (The launch error dialogs in `launch-errors.slint` share the icon and
// the message as well, but end in a single button, so they are not part of this.)
//
// The strings are passed in rather than `@tr`'d here, so each dialog's sentences
// are catalogued under its own context and a translator can tell which of the
// two a "Confirm delete" belongs to.
//
// **Both callbacks have to be handled by the dialog that mounts this.** Slint
// lets a consumer leave a `callback` unhandled without a word, and a button whose
// callback nobody answers is a button that does nothing — which is exactly what
// an unhandled `cancel` is.
export component ConfirmWarningBody inherits VerticalLayout {
    in property <length> content-width: 0px;
    /// The question, drawn at 17px.
    in property <string> title-text: "";
    /// The consequence line, drawn at 12px.
    in property <string> detail-text: "";
    in property <string> cancel-text: "";
    in property <string> confirm-text: "";
    /// The confirm button's enabled state, cleared while the delete runs.
    in property <bool> confirm-enabled: true;

    callback cancel();
    callback confirm();

    // 8px of padding, with the buttons separated by the layout's own 16px
    // spacing.
    width: root.content-width;
    spacing: 16px;
    padding: 8px;
    alignment: start;

    // The row around the icon and the message. The 50px icon is the taller of the
    // two, and the message column centres itself in it.
    HorizontalLayout {
        height: 50px;
        spacing: 16px;
        cross-axis-alignment: center;

        AppIcon {
            name: "warning";
            size: 50px;
        }

        // The message column; its 16px gap from the icon is the row's spacing.
        VerticalLayout {
            alignment: center;
            spacing: 8px;

            Text {
                text: root.title-text;
                font-size: 17px;
                color: Theme.default-text-color.transparentize(0.1);
                wrap: word-wrap;
            }

            Text {
                text: root.detail-text;
                font-size: 12px;
                color: Theme.default-text-color.transparentize(0.1);
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        width: 100%;
        cross-axis-alignment: center;

        Button {
            horizontal-stretch: 1;
            text: root.cancel-text;
            text-color: Theme.text-inverse;
            // A 4px radius, overriding the controller's own.
            button-radius: 4px;
            button-background: Theme.blue;
            clicked => { root.cancel(); }
        }

        // The 8px between the two buttons: both stretch equally, which leaves the
        // gap between them.
        Rectangle {
            width: 8px;
            background: transparent;
        }

        Button {
            horizontal-stretch: 1;
            text: root.confirm-text;
            text-color: Theme.text-inverse;
            button-radius: 4px;
            button-background: Theme.red;
            button-enabled: root.confirm-enabled;
            clicked => { root.confirm(); }
        }
    }
}
