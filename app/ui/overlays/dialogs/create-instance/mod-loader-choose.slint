import { ZoomTransition } from "../../../components/containers/zoom-transition.slint";
import { ListItem } from "../../../components/controls/list-item.slint";
import { ScrollView } from "../../../components/containers/scroll-view.slint";
import { CreateInstanceState } from "../../../globals/dialogs.slint";

// The mod loader version chooser: the versions of the loader the settings screen
// picked.
//
// All four loaders render the same list, so the list (and the icon) is picked
// from the loader type. Forge rows show the version without its Minecraft prefix,
// which Rust strips when it builds the list.
//
// The list is built like the Minecraft chooser's, bar its height: a 1px bordered,
// rounded box around the app's `ScrollView` (and its slim thumb), with only the
// visible rows drawn. Three things about it are deliberate:
//
//   * the list scrolls in an area of its own instead of growing to its full
//     height and letting the dialog's scroll area carry it. Slint's renderer
//     cannot paint an element taller than 8192px *inside an opacity/transform
//     group*, and a screen is exactly such a group — the zoom transition — while
//     a list is 13 700px tall for Fabric on 1.20.1 (Quilt: 16 600px). The layer
//     allocation fails and the dialog stops being painted altogether. A bounded
//     scroller keeps the group small.
//   * that area draws a 1px border and a scrollbar. The border makes it match the
//     version chooser, whose list carries one, and the thumb shows that the list
//     can be scrolled.
//   * the screen opens with the settings screen's 4px gap rather than an empty
//     `SettingGroup` hairline plus the 16px margin of its item list.
//
// Only the visible rows are built as well — past roughly 150 rows drawn in a
// frame the renderer gives up too (see `window-top`).
export component ModLoaderChoose inherits ZoomTransition {
    /// The dialog's inner area minus its title: what this screen has to fill.
    in property <length> screen-height: 0px;

    height: root.screen-height;
    padding-left: 8px;
    padding-right: 8px;

    private property <string> loader-type: CreateInstanceState.mod-loader-type;
    private property <[string]> versions: root.loader-type == "Fabric"
        ? CreateInstanceState.fabric-versions
        : root.loader-type == "Quilt" ? CreateInstanceState.quilt-versions
        : root.loader-type == "Forge" ? CreateInstanceState.forge-versions
        : root.loader-type == "Neoforge" ? CreateInstanceState.neoforge-versions
        : [];

    pure function loader-icon(loader-type: string) -> image {
        if loader-type == "Fabric" {
            return @image-url("../../../assets/images/fabric.webp");
        }
        if loader-type == "Quilt" {
            return @image-url("../../../assets/images/quilt.svg");
        }
        if loader-type == "Forge" {
            return @image-url("../../../assets/images/forge.svg");
        }
        return @image-url("../../../assets/images/neoforge.png");
    }

    // A row is 54px tall (see `ListItem`), which is what lets the list's
    // height and the visible range be computed without measuring anything.
    private property <length> row-height: 54px;
    // The part of the list the scroll area can show, with two rows of slack on
    // each side so a scroll never reveals a slot before its row is built.
    private property <length> window-top: max(
        0px,
        -versions-scroll.content-y - 2 * root.row-height);
    private property <length> window-bottom: -versions-scroll.content-y + versions-scroll.height
        + 2 * root.row-height;

    // The gap the settings screen opens with, which is what this screen uses too.
    // The 4px replaces an empty `SettingGroup` hairline box plus the 16px bottom
    // margin of its item list, which read as a second border just above the
    // list's own.
    Rectangle {
        width: 100%;
        height: 4px;
        background: transparent;
    }

    list := Rectangle {
        width: 100%;
        vertical-stretch: 1;
        // CSS `border: 1px solid rgba(0, 0, 0, 0.16)`.
        border-width: 1px;
        border-color: #00000029;
        border-radius: 8px;
        clip: true;
        background: transparent;

        versions-scroll := ScrollView {
            // The rows live in a box of their own — a row's `visible` cannot be
            // used to drop it from the scroll content, or the list would
            // collapse. See `window-top`.
            list-content := Rectangle {
                width: 100%;
                height: root.row-height * root.versions.length;

                for version[index] in root.versions : ListItem {
                    visible: root.row-height * index < root.window-bottom
                        && root.row-height * (index + 1) > root.window-top;
                    y: root.row-height * index;
                    title: version;
                    icon: root.loader-icon(root.loader-type);
                    clickable: true;

                    clicked => {
                        CreateInstanceState.mod-loader-version = version;
                        CreateInstanceState.step = "settings";
                    }
                }
            }
        }
    }
}
