import { Theme } from "../theme.slint";
import { AppIcon } from "../components/display/app-icon.slint";
import { ScrollView } from "../components/containers/scroll-view.slint";
import { NotificationItem, NotificationState, NotificationTask, NotificationText } from "../globals/notifications.slint";

component NotificationRow inherits Rectangle {
    in property <NotificationItem> item;
    height: 54px;
    border-radius: 8px;
    background: Theme.surface-0.transparentize(0.18);

    AppIcon {
        name: root.item.icon;
        size: 18px;
        icon-color: Theme.mauve;
        x: 12px;
        y: 18px;
    }
    VerticalLayout {
        x: 42px;
        y: 8px;
        width: root.width - 54px;
        height: root.height - 16px;
        spacing: 3px;
        Text {
            text: NotificationText.notification-title(root.item);
            color: Theme.text;
            font-size: 13px;
            overflow: elide;
        }
        Text {
            text: NotificationText.notification-message(root.item);
            color: Theme.subtext-0;
            font-size: 11px;
            overflow: elide;
        }
    }
}

component NotificationTaskRow inherits Rectangle {
    in property <NotificationTask> task;
    height: 64px;
    border-radius: 8px;
    background: Theme.surface-0.transparentize(0.18);
    TouchArea {
        clicked => { NotificationState.open-task(); }
    }

    VerticalLayout {
        x: 12px;
        y: 8px;
        width: root.width - 24px;
        height: root.height - 16px;
        spacing: 4px;
        HorizontalLayout {
            height: 16px;
            Text {
                text: NotificationText.task-title(root.task);
                color: Theme.text;
                font-size: 13px;
                overflow: elide;
                horizontal-alignment: center;
            }
            Text {
                text: root.task.loading ? @tr("NotificationOverlay" => "In progress") : "";
                color: Theme.subtext-0;
                font-size: 11px;
                horizontal-alignment: right;
            }
        }
        Text {
            text: NotificationText.task-description(root.task);
            color: Theme.subtext-0;
            font-size: 11px;
            overflow: elide;
            horizontal-alignment: center;
        }
        Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.surface-2;
            clip: true;
            Rectangle {
                x: 0px;
                width: root.task.max > 0
                    ? max(0px, min(root.width, root.width * root.task.value / root.task.max))
                    : 0px;
                height: 100%;
                background: Theme.mauve;
            }
        }
    }
}

/// The notification centre uses the same full-height side-panel treatment as
/// the news surface, entering from the right and covering the window's right
/// side rather than floating above the page.
export component NotificationOverlay inherits Rectangle {
    width: 100%;
    height: 100%;
    visible: NotificationState.count > 0 && root.phase != "closed";
    background: #000000.with-alpha(0.35 * root.scrim-alpha);

    private property <string> phase: "closed";
    private property <bool> open: NotificationState.visible;
    private property <float> scrim-alpha: root.phase == "shown" ? 1.0 : 0.0;
    private property <length> panel-width: min(460px, root.width * 0.45);
    private property <length> panel-x: root.phase == "shown"
        ? root.width - root.panel-width
        : root.width;
    private property <bool> leaving: root.phase == "leaving";
    animate scrim-alpha { duration: 150ms; easing: ease-out-quad; }
    animate panel-x {
        duration: root.leaving ? 180ms : 220ms;
        easing: root.leaving ? cubic-bezier(0.47, 0, 1, 0.75) : cubic-bezier(0, 0.47, 0.25, 1);
    }

    changed open => {
        if root.open {
            root.phase = "starting";
            start-timer.restart();
        } else if root.phase != "closed" {
            root.phase = "leaving";
            leave-timer.restart();
            NotificationState.mark-read();
        }
    }
    init => {
        if NotificationState.visible { root.phase = "shown"; }
    }
    start-timer := Timer {
        interval: 16ms;
        running: root.phase == "starting";
        triggered => { root.phase = "shown"; }
    }
    leave-timer := Timer {
        interval: 180ms;
        running: root.phase == "leaving";
        triggered => { root.phase = "closed"; }
    }

    TouchArea {
        clicked => { NotificationState.close(); }
        scroll-event(event) => { accept }
    }

    Rectangle {
        x: root.panel-x;
        y: 0px;
        width: root.panel-width;
        height: root.height;
        background: Theme.base;
        border-width: 1px;
        border-color: Theme.overlay-0.transparentize(0.35);

        TouchArea { }
        VerticalLayout {
            padding: 16px;
            height: root.height - 48px;
            spacing: 10px;
            HorizontalLayout {
                height: 24px;
                Text {
                    text: @tr("NotificationOverlay" => "Notifications");
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: Theme.font-weight-bold;
                }
                Text {
                    text: "" + NotificationState.count;
                    color: Theme.subtext-0;
                    font-size: 13px;
                    horizontal-alignment: right;
                }
            }
            ScrollView {
                vertical-stretch: 1;
                scrollbar-top: 0px;
                scrollbar-bottom: 0px;
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        height: 24px;
                        Text {
                            text: @tr("NotificationOverlay" => "Notifications");
                            color: Theme.mauve;
                            font-size: 13px;
                            font-weight: Theme.font-weight-bold;
                        }
                        Text {
                            text: "" + NotificationState.notification-count;
                            color: Theme.subtext-0;
                            font-size: 13px;
                            font-weight: Theme.font-weight-bold;
                            horizontal-alignment: right;
                        }
                    }
                    HorizontalLayout {
                        height: 24px;
                        Text {
                            text: @tr("NotificationOverlay" => "Active tasks");
                            color: Theme.mauve;
                            font-size: 13px;
                            font-weight: Theme.font-weight-bold;
                        }
                        Text {
                            text: "" + NotificationState.task-count;
                            color: Theme.subtext-0;
                            font-size: 13px;
                            font-weight: Theme.font-weight-bold;
                            horizontal-alignment: right;
                        }
                    }
                    for task in NotificationState.tasks: NotificationTaskRow {
                        task: task;
                    }
                    for item in NotificationState.notifications: NotificationRow {
                        item: item;
                    }
                }
            }
        }
    }
}
