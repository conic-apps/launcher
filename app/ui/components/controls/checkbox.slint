import { Theme } from "../../theme.slint";

// Tick box: an 18x18 box, 4px radius, translucent hairline, filled with the
// pinned latte lavender when checked, with a white tick inside.
//
// The box is drawn directly and `toggled` reports the click. Its one caller —
// the Yggdrasil profile list in the add-account dialog — disables the box and
// drives the selection from the whole row, so the box itself is drawn with only
// its `checked` state fed.
export component Checkbox inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> checkbox-enabled: true;
    callback toggled;

    width: 18px;
    height: 18px;

    box := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 4px;
        border-width: 1.5px;
        border-color: root.checked ? Theme.latte-lavender
            : hover.has-hover ? Theme.subtext-0
            : Theme.overlay-0;
        background: root.checked ? Theme.latte-lavender : transparent;
        opacity: root.checkbox-enabled ? 1.0 : 0.5;
        animate background, border-color { duration: 150ms; easing: ease; }

        if root.checked : glyph := Rectangle {
            width: 5px;
            height: 9px;
            y: (parent.height - self.height) / 2 - 1px;
            background: transparent;
            transform-rotation: 45deg;

            Rectangle {
                x: parent.width - 2px;
                width: 2px;
                height: parent.height;
                background: #fff;
            }

            Rectangle {
                y: parent.height - 2px;
                width: parent.width;
                height: 2px;
                background: #fff;
            }
        }
    }

    hover := TouchArea {
        enabled: root.checkbox-enabled;
        clicked => { root.toggled(); }
    }
}
