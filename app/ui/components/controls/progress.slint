import { Theme } from "../../theme.slint";

// Linear progress bar: a 1px track with a 3px bar over it, clipped to the 2px
// box.
//
//   * `loading` shows the indeterminate bar sweeping left↔right;
//   * otherwise the bar's width is `value / max` and eases over 300ms.
//
// The sweep is a sawtooth: a 1.25s phase per sweep with an instant reset,
// computed from `animation-tick()` because Slint has no keyframe timelines, and
// eased with a smoothstep standing in for a cubic-bezier (a 3px bar, so the
// difference is not visible).
//
// The travel accounts for the bar's own centring: the 50%-wide bar is centred
// first, and its offset is measured from there, so the bar moves over
// `0.25W + [-0.85W, +0.85W]` = `[-0.6W, +1.1W]`. That clears the track at both
// ends; `[-0.85W, +0.85W]` would leave a 15% tail visible on the right when the
// animation restarts.
export component Progress inherits Rectangle {
    in property <bool> loading: false;
    in property <float> value: 0;
    in property <float> max: 0;

    height: 2px;
    background: transparent;
    clip: true;

    private property <float> phase: mod(animation-tick(), 1.25s) / 1.25s;
    private property <float> sweep: self.phase * self.phase * (3.0 - 2.0 * self.phase);
    // `root`, not `parent`: the two bars below sit inside `if` blocks, so
    // `parent` would be the implicit conditional item rather than this component.
    private property <length> sweep-x: root.width * (-0.60 + self.sweep * 1.70);

    Rectangle {
        width: 100%;
        height: 1px;
        background: Theme.surface-2;
    }

    if root.loading: Rectangle {
        width: root.width * 0.5;
        height: 3px;
        x: root.sweep-x;
        background: #f0f0f0;
    }

    if !root.loading: Rectangle {
        width: root.max > 0.0 ? min(root.value / root.max, 1.0) * root.width : 0px;
        height: 3px;
        x: 0px;
        background: #f0f0f0;
        animate width {
            duration: 300ms;
            easing: ease;
        }
    }
}
