import { Theme } from "../../theme.slint";
import { Icons } from "../../icons.slint";

// Centered search / command palette opener. The icon is the Font Awesome Pro v7
// 640-viewbox `search` glyph, read out of the generated `Icons` table like every
// other icon. The hotkey chip lives in the title bar container, not here.
export component SearchBar inherits Rectangle {
    in property <string> placeholder;
    callback activated;

    height: 26px;
    border-radius: Theme.controllers-border-radius;
    border-width: 1px;
    border-color: Theme.controllers-border;
    // Not the controller background: the title bar overrides it with the
    // flavor's surface-0 on every dark flavor, and leaves it as the controller
    // background on Latte. See `Theme.titlebar-search-background`.
    background: Theme.titlebar-search-background;
    clip: true;

    accessible-role: button;
    accessible-label: root.placeholder;
    accessible-action-default => { root.activated(); }

    Path {
        commands: Icons.fill-commands("search");
        viewbox-width: Icons.viewbox("search");
        viewbox-height: Icons.viewbox("search");
        width: 20px;
        height: 20px;
        x: 10px;
        fill: Theme.default-text-color.transparentize(0.1);
    }

    Text {
        text: root.placeholder;
        font-size: 13px;
        color: Theme.default-text-color.transparentize(0.2);
        x: 36px;
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}