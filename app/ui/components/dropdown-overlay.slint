import { Theme } from "../theme.slint";
import { AccountAvatar } from "account-avatar.slint";
import { AppIcon } from "app-icon.slint";
import { Dropdown } from "../globals/dropdown.slint";

export component DropdownOverlay inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    private property <int> option-count: Dropdown.account-mode
        ? Dropdown.accounts.length
        : Dropdown.options.length;
    private property <length> natural-height: 18px + root.option-count * 26px
        + max(0, root.option-count - 1) * 4px;
    private property <length> panel-height: Dropdown.open ? root.natural-height : 0px;
    private property <float> panel-opacity: Dropdown.open ? 1.0 : 0.0;

    animate panel-height { duration: 200ms; easing: ease; }
    animate panel-opacity { duration: 200ms; easing: ease; }

    outside := TouchArea {
        enabled: Dropdown.open || root.panel-height > 0.5px;
        scroll-event(event) => {
            if (Dropdown.open || root.panel-height > 0.5px) {
                return accept;
            }
            return reject;
        }
        clicked => { Dropdown.open = false; }
    }

    panel := Rectangle {
        x: Dropdown.anchor-x;
        y: Dropdown.expand-upwards
            ? Dropdown.anchor-y + root.natural-height - root.panel-height
            : Dropdown.anchor-y;
        width: Dropdown.anchor-width;
        height: root.panel-height;
        opacity: root.panel-opacity;
        clip: true;
        // The dialog radius: 10px on every palette, but the token is the token.
        border-radius: Theme.dialog-border-radius;
        border-width: 1px;
        border-color: Theme.controllers-border;
        background: Theme.base;
        drop-shadow-color: #4500611d;
        drop-shadow-blur: 10px;

        panel-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            scroll-event(event) => {
                if (Dropdown.open || root.panel-height > 0.5px) {
                    return accept;
                }
                return reject;
            }
        }

        if Dropdown.account-mode : VerticalLayout {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: root.natural-height - 2px;
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 4px;

            for player in Dropdown.accounts : Rectangle {
                height: 26px;
                // The controller radius: 4px in Latte rather than the 6px the
                // dark flavors use.
                border-radius: Theme.controllers-border-radius;
                background: Dropdown.current == player.key ? #ffffff17
                    : player-touch.has-hover ? #ffffff1f
                    : transparent;
                animate background { duration: 30ms; }

                AccountAvatar {
                    size: 18px;
                    skin: player.avatar;
                    x: 8px;
                }

                Text {
                    text: player.name;
                    font-size: 12px;
                    font-weight: Theme.font-weight-normal;
                    color: Theme.default-text-color.transparentize(0.1);
                    x: 34px;
                    width: parent.width - 42px;
                    overflow: elide;
                    wrap: no-wrap;
                }

                player-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => {
                        Dropdown.chosen = player.key;
                        Dropdown.choose-owner = Dropdown.owner;
                        Dropdown.choose-serial = Dropdown.choose-serial + 1;
                        Dropdown.open = false;
                    }
                }
            }
        }

        if !Dropdown.account-mode : VerticalLayout {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: root.natural-height - 2px;
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 4px;

            for option in Dropdown.options : Rectangle {
                height: 26px;
                // The controller radius: 4px in Latte rather than the 6px the
                // dark flavors use.
                border-radius: Theme.controllers-border-radius;
                background: Dropdown.current == option.key ? #ffffff17
                    : option-touch.has-hover ? #ffffff1f
                    : transparent;
                animate background { duration: 30ms; }

                if option.icon != "" : AppIcon {
                    name: option.icon;
                    size: 14px;
                    x: 8px;
                }

                Text {
                    text: option.label;
                    font-size: 12px;
                    font-weight: Theme.font-weight-normal;
                    color: Theme.default-text-color.transparentize(0.1);
                    x: option.icon != "" ? 30px : 8px;
                    width: parent.width - (option.icon != "" ? 38px : 16px);
                    overflow: elide;
                    wrap: no-wrap;
                }

                option-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => {
                        Dropdown.chosen = option.key;
                        Dropdown.choose-owner = Dropdown.owner;
                        Dropdown.choose-serial = Dropdown.choose-serial + 1;
                        Dropdown.open = false;
                    }
                }
            }
        }
    }
}
