import { Theme } from "../theme.slint";
import { SettingItem } from "setting-item.slint";
import { AppIcon } from "app-icon.slint";

// Collapsible settings group (src/components/SettingCollapse.vue).
//
// The Vue component animates height/opacity over 200ms with
// `cubic-bezier(0.215, 0.61, 0.355, 1)` and flips the chevron over 200ms
// `ease-in-out`. Slint's `animate` is interruptible, so re-toggling mid-flight
// behaves like the original Web Animations API implementation.
//
// `border-radius` corners are applied per side: when closed the header is fully
// rounded; when open only its top corners are, and the content keeps the
// bottom corners (matching the Vue class toggling).
//
// As in `SettingGroup`, the corners are the rows' and nothing is clipped to a
// radius — the Vue puts `overflow: hidden` on these two but gives the content's
// last child its bottom radii as well, and a rounded `clip` is what Slint's
// software renderer drops (see `README.md`). So the header is the first row, and
// the last one while it is closed, and the content's last row says so itself.
export component SettingCollapse inherits VerticalLayout {
    in property <string> title;
    in property <string> description: "";
    in property <bool> resetable: false;
    /// `.setting-collapse-disabled { opacity: 0.6 }` with `* { pointer-events:
    /// none }`, and a `toggle()` that returns early — the instance settings
    /// overlay's advanced options, which are inert until the instance overrides
    /// the launcher's own launch settings.
    in property <bool> collapse-disabled: false;
    callback reset;

    private property <bool> opened: false;

    width: 100%;
    spacing: 0px;
    opacity: root.collapse-disabled ? 0.6 : 1.0;

    head := Rectangle {
        width: 100%;
        height: head-item.preferred-height;
        background: transparent;

        head-item := SettingItem {
            width: parent.width;
            group-first: true;
            group-last: !root.opened;
            // `pointer-events: none` also takes the header's hover with it: CSS
            // `:hover` needs the element to be the pointer's target, so a
            // disabled header never changes background. `clickable` is what
            // gates both the hover fill and the click, so one property stands in
            // for all of it.
            clickable: !root.collapse-disabled;
            // The Vue's `border-radius: 8px` -> `8px 8px 0 0` on `.opened`, over
            // 200ms; a row's bottom corners are where that is carried here.
            animate border-bottom-left-radius, border-bottom-right-radius {
                duration: 200ms;
                easing: ease;
            }
            title: root.title;
            description: root.description;
            resetable: root.resetable;
            reset => { if !root.collapse-disabled { root.reset(); } }
            clicked => { root.opened = !root.opened; }

            AppIcon {
                name: "chevron-down";
                size: 17px;
                icon-color: Theme.default-text-color.transparentize(0.1);
                transform-rotation: root.opened ? 180deg : 0deg;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                animate transform-rotation { duration: 200ms; easing: ease-in-out; }
            }
        }
    }

    // `@children` cannot live in a conditional, so the content is always
    // instantiated. A clipped wrapper collapses to zero height when closed;
    // its height reads the natural height of a separate inner element so the
    // binding does not reference itself (which Slint rejects as a loop). It
    // stays visible while the height animates back to zero so the collapse is
    // animated instead of snapping shut.
    //
    // The clip is that animation's, and is a plain rectangle: the bottom corners
    // are the last row's (`group-last`), which a caller whose content is a
    // dynamic `@children` slot has to pass on — see `settings-jvm.slint`.
    content-wrapper := Rectangle {
        width: 100%;
        height: root.opened ? content.preferred-height : 0px;
        visible: root.opened || self.height > 0.5px;
        opacity: root.opened ? 1.0 : 0.0;
        clip: true;
        background: transparent;

        animate height { duration: 200ms; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }
        animate opacity { duration: 200ms; easing: cubic-bezier(0.215, 0.61, 0.355, 1); }

        content := Rectangle {
            width: 100%;
            background: transparent;

            VerticalLayout {
                spacing: 1px;
                @children
            }

            // The `* { pointer-events: none }` half of
            // `.setting-collapse-disabled`, covering the rows the slot placed
            // here. Declared after them so it is on top; a bare `TouchArea`
            // because that is the only thing that intercepts, and it rejects the
            // wheel so the scroller above still takes it.
            if root.collapse-disabled : TouchArea {
                width: 100%;
                height: 100%;
            }
        }
    }
}
