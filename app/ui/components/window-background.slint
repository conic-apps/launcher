import { Background } from "../globals/background.slint";

// The window's background, with Rust rendering the sky and world images.
//
//   window colour → hyperbola sky (30%) → 3D world (30%) → custom background
//   → dim overlay
//
// Over the world come the user's custom backgrounds, up to two of them: a new
// one fades in *over* the one on screen, which stays opaque underneath until
// the incoming one has arrived and is then dropped. Fading both at once would
// let the window colour show through the middle of the transition — which is
// the flash this arrangement exists to avoid.
//
// The whole stack sits in a wrapper scaled by 1.08 that follows the pointer. The
// images are rendered 1.08x the window to match, so the scale lands them on
// device pixels rather than stretching them.
export component WindowBackground inherits Rectangle {
    // The alphas are the component's own, bound to the global's targets: a
    // global cannot animate, and a component property with an `animate` is what
    // turns "the target is 1 now" into a fade. Writing the target again does
    // nothing (the binding's value has not changed), so a fade in flight is
    // never restarted by an unrelated refresh.
    private property <float> custom-a-alpha: Background.custom-a-alpha;
    private property <float> custom-b-alpha: Background.custom-b-alpha;
    private property <length> parallax-x: Background.parallax-x;
    private property <length> parallax-y: Background.parallax-y;

    // The frame pump: while the camera advances, something in the window has to
    // depend on `animation-tick()`, which Slint re-evaluates on every frame —
    // and a window with an animation in flight is one Slint keeps painting.
    // Without it the world only advanced when something else in the UI happened
    // to animate (`Window::request_redraw` alone was not enough: it left the
    // world frozen on a machine whose compositor only repaints for animations,
    // and the camera then jumped when the user finally scrolled the list).
    // The item is zero-sized, so nothing on screen depends on the value.
    Rectangle {
        x: Background.camera-moving ? (animation-tick() / 1s) * 1px : 0px;
        width: 0;
        height: 0;
    }

    parallax := Rectangle {
        // Centred, so the 1.08 scaling spills 4% past each edge.
        x: root.width * -0.04 + root.parallax-x;
        y: root.height * -0.04 + root.parallax-y;
        width: root.width * 1.08;
        height: root.height * 1.08;

        // `visible` rather than an opacity: with the world covered there is
        // nothing to draw, and Slint skips uploading an image that is not
        // visible — which is what keeps a custom background cheap.
        // The sky stays up when the world is off screen, and is the whole
        // background when there is no GPU to draw the world with.
        Image {
            source: Background.sky-image;
            width: 100%;
            height: 100%;
            image-fit: fill;
            visible: Background.world-shown || Background.software-only;
        }
        Image {
            source: Background.world-image;
            width: 100%;
            height: 100%;
            image-fit: fill;
            visible: Background.world-shown;
        }

        // Cover-fit.
        Image {
            source: Background.custom-a;
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: root.custom-a-alpha;
        }
        Image {
            source: Background.custom-b;
            width: 100%;
            height: 100%;
            image-fit: cover;
            opacity: root.custom-b-alpha;
        }

        Rectangle {
            background: black;
            opacity: Background.dim-alpha;
        }
    }
}
