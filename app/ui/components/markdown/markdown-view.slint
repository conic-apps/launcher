// The view half of the renderer: a document's display list, drawn.
//
// Everything here is a loop over the engine's items. The geometry, the type
// sizes, the line breaks and the decorations all come from Rust, so this file
// has no measurements of its own to disagree with — which is the whole point of
// splitting the work this way. Slint's `Text` reports the box it needs and
// nothing about where a line breaks; the engine needs the second and Slint
// cannot give it, so Rust does the breaking and Slint does the drawing.

import { MarkdownPalette, MdIconPath } from "markdown-types.slint";

/// One item of the engine's display list, in paint order.
///
/// Mirrors the Rust `MdItem`'s text and rectangle fields; the caller copies one
/// into the other. A bitmap is a `MarkdownImage` rather than an `MdItem`, and
/// `visible` is set on the wrapper a view draws each item in, not carried here:
/// it is how a view skips the parts of a long document that are scrolled out of
/// sight, which a README of any length needs because a renderer struggles well
/// before a thousand elements.
export struct MdItem {
    /// "text" | "rect". A bitmap is a `MarkdownImage`, not one of these.
    kind: string,
    x: length,
    y: length,
    width: length,
    height: length,
    /// The glyphs of a `text` item, and empty for a `rect`. An image is a
    /// `MarkdownImage` with its own `alt` field rather than one of these.
    text: string,
    font-size: length,
    font-weight: int,
    font-italic: bool,
    /// Set with the code font rather than the text font.
    mono: bool,
    /// The name of the palette slot this item takes its colour from, resolved by
    /// `MarkdownColors.resolve`.
    color: string,
    radius: length,
    /// Whether a `rect` item is filled at all. A table cell that has no
    /// background of its own is an outline and nothing else.
    filled: bool,
    /// A `rect` item's outline width, drawn inside the box.
    border-width: length,
    /// The name of the palette slot the outline takes its colour from.
    border-color: string,
    /// On a `rect` that acts as a link: the transparent box that takes the press.
    /// A link is one item per line, not two, and the item carries where its rule
    /// belongs rather than being matched up with a rule item afterwards.
    link-url: string,
    /// Groups every piece of one link, so that a view can resolve "is the pointer
    /// inside this link" from one string and draw the rule under all of its lines
    /// at once. Empty for an item that is not a link.
    link-id: string,
    /// Where the rule for a hovered link sits, measured down from the top of this
    /// box. Zero for an item that is not a link.
    rule-offset: length,
    /// Whether this link reveals a rule at all. False for a link whose content is
    /// an image: `text-decoration` does not reach a replaced element, so a browser
    /// underlines nothing under a linked picture, and a line across the bottom of
    /// every badge in a README is worse than no line.
    rule: bool,
}

/// One bitmap of the document.
///
/// Images are a model of their own rather than a field on [`MdItem`], and that is
/// not tidiness: a Slint struct literal has to name every field, and there is no
/// way to write the empty `image` that every other item would need. So the
/// engine's `MdItem` carries the bitmap, and the bridge moves the image items
/// into this model and leaves the rest where they are.
export struct MarkdownImage {
    x: length,
    y: length,
    width: length,
    height: length,
    /// The corner radius. `.markdown-body img { border-radius: 8px }`.
    radius: length,
    /// The alternative text, for a label or a tooltip.
    alt: string,
    /// The bitmap. An empty one draws nothing, which is what an image the caller
    /// has not fetched yet looks like.
    bitmap: image,
    /// Set when the image is itself a link (`[![alt](img)](url)`), in which case
    /// it takes a press like any other link.
    link-url: string,
    /// That link's id, so that a hovered rule can cover the image too.
    link-id: string,
}

/// One run of the document: the unit a view stacks vertically.
///
/// Mirrors the Rust `MdChunk` with its `MdSection`'s geometry flattened in; the
/// caller copies one into the other. A run is what moves as one thing, which is
/// why a collapsible section is one: closing it shortens its run, and a column of
/// runs puts everything below it back where it belongs. Covering the content
/// instead would hide it and reclaim nothing.
export struct MdChunk {
    /// The id of the section this run is (the engine's `MdSection.id`), or -1 for
    /// a run of ordinary blocks.
    section-index: int,
    /// Where the run starts in the engine's *open* layout, which is the origin
    /// its items' own `y` are measured from.
    top: length,
    /// How tall the run is with its section open.
    height: length,
    /// How much of that the section hides while it is closed — its content and
    /// the margin under it, not the summary row. Zero for a run that is not a
    /// section.
    hidden: length,
    /// The summary row's box. All zero for a run that is not a section.
    head-x: length,
    head-y: length,
    head-width: length,
    head-height: length,
    head-radius: length,
    /// The disclosure chevron, which a view rotates a quarter turn when the
    /// section opens.
    marker-x: length,
    marker-y: length,
    marker-size: length,
    /// The run's items, in paint order.
    items: [MdItem],
    /// Its bitmaps, in the same coordinate space as the items.
    images: [MarkdownImage],
}

// Resolves a colour name against the palette.
//
// The names are the engine's `ColorRole::name`, and the two have to be kept in
// step by hand. A name that resolves to nothing falls back to the text colour,
// which is the one colour every item can live without — so a palette that is
// missing a slot shows the wrong tint for one kind of thing rather than an
// invisible document.
export global MarkdownColors {
    public pure function resolve(palette: MarkdownPalette, name: string) -> color {
        if name == "heading" { return palette.heading; }
        if name == "link" { return palette.link; }
        if name == "code-text" { return palette.code-text; }
        if name == "code-background" { return palette.code-background; }
        if name == "code-block-text" { return palette.code-block-text; }
        if name == "code-block-background" { return palette.code-block-background; }
        if name == "quote-text" { return palette.quote-text; }
        if name == "quote-bar" { return palette.quote-bar; }
        if name == "table-border" { return palette.table-border; }
        if name == "table-head-text" { return palette.table-head-text; }
        if name == "table-head-background" { return palette.table-head-background; }
        if name == "rule" { return palette.rule; }
        if name == "strike" { return palette.strike; }
        if name == "marker" { return palette.marker; }
        if name == "placeholder" { return palette.placeholder; }
        if name == "details-head" { return palette.details-head; }
        if name == "details-head-hover" { return palette.details-head-hover; }
        if name == "details-head-active" { return palette.details-head-active; }
        if name == "details-marker" { return palette.details-marker; }
        return palette.text;
    }
}

// A run of glyphs in one style.
//
// `height` is the run's own ascent and descent rather than the line's box, which
// is what makes two runs of different sizes on one line share a baseline: the
// engine put them at the offsets where their baselines meet, and Slint centres
// the glyphs in the box it is given. `wrap` is off because the engine has
// already broken the line — a run that wrapped again would be two runs' worth of
// text in one line, and the box is the width the engine measured.
component MdText inherits Text {
    in property <MdItem> item;
    in property <color> text-color: black;
    in property <string> family: "";
    in property <string> mono-family: "monospace";

    x: item.x;
    y: item.y;
    width: item.width;
    height: item.height;
    text: item.text;
    font-size: item.font-size;
    font-weight: item.font-weight;
    font-italic: item.font-italic;
    font-family: item.mono ? mono-family : family;
    color: text-color;
    vertical-alignment: center;
    horizontal-alignment: left;
    wrap: no-wrap;
    // A run is its own box, so it never has to elide; the engine sized it.
    overflow: clip;
}

// A rounded box, filled or outlined.
component MdRect inherits Rectangle {
    in property <MdItem> item;
    in property <color> fill: transparent;
    in property <color> outline: transparent;

    x: item.x;
    y: item.y;
    width: item.width;
    height: item.height;
    background: item.filled ? fill : transparent;
    border-width: item.border-width;
    border-color: outline;
    border-radius: item.radius;
    clip: true;
}

// A bitmap, clipped to its radius. `image-fit: contain`, so a bitmap arrives
// undistorted even where the view was given a box of a different shape.
component MdImage inherits Rectangle {
    in property <MarkdownImage> picture;
    in property <string> hovered-id: "";
    callback link-clicked(string);

    x: picture.x;
    y: picture.y;
    width: picture.width;
    height: picture.height;
    border-radius: picture.radius;
    clip: true;

    Image {
        width: parent.width;
        height: parent.height;
        source: picture.bitmap;
        image-fit: contain;
    }

    // `![alt](img)` inside a link is a link: GitHub's `.markdown-body` styles
    // every `a` under the body, image or not, and a click on any anchor opens
    // it. `text-decoration` does not reach a replaced element, so there is no
    // rule to draw over the picture — but the press is the same press, and the
    // hand says so.
    if root.picture.link-url != "" : TouchArea {
        mouse-cursor: pointer;
        clicked => { root.link-clicked(root.picture.link-url); }
    }
}

// The transparent box that takes a link's press, and the rule it reveals.
//
// The engine emits one of these per line a link appears on, all sharing a
// `link-id`. The hover is a property of the *view* rather than of the item: with
// a link on three lines, three boxes each revealing only its own rule would draw
// its underline one line at a time. So the hovered id is the view's, and every
// piece of that link — on any line — follows it.
component MdLink inherits Rectangle {
    in property <MdItem> box-item;
    in property <color> link-color: black;
    in property <string> hovered-id: "";
    /// The pointer entered or left a link. The id is empty on the way out, so a
    /// view does not have to remember which link it was.
    callback hover-changed(string, bool);
    callback link-clicked(string);

    x: box-item.x;
    y: box-item.y;
    width: box-item.width;
    height: box-item.height;
    background: transparent;

    // The rule, at the position the font asked for. The engine carries it on the
    // box rather than emitting a second item, so there is nothing here to match
    // up and nothing to be a pixel out.
    Rectangle {
        visible: box-item.rule && root.hovered-id != "" && root.hovered-id == box-item.link-id;
        x: 0;
        y: box-item.rule-offset;
        width: parent.width;
        height: 1px;
        background: root.link-color;
    }

    touch := TouchArea {
        // The hand a browser shows over a hyperlink. Everywhere else in the
        // launcher a control's own shape says it is pressable and the arrow is
        // left alone; a link has no shape of its own — it is a run of text that
        // happens to be blue — so the cursor is the only thing that says it goes
        // somewhere.
        mouse-cursor: pointer;
        // A `changed` handler rather than a `has-hover` callback: `has-hover` is
        // a property, and a `changed` handler is the only way to be told it
        // moved.
        changed has-hover => { root.hover-changed(box-item.link-id, touch.has-hover); }
        clicked => { root.link-clicked(box-item.link-url); }
    }
}

// A `<details>` summary row: the row's background, its chevron, and the press
// that opens the section.
//
// It is drawn before the run's items rather than after them, and that is the
// whole reason it is a component of its own: a row has a fill, and a fill drawn
// over the title would hide it. A `MdLink` gets away with one element because
// its box is transparent.
component MdSectionRow inherits Rectangle {
    in property <MdChunk> chunk;
    in property <MarkdownPalette> palette;
    in property <bool> open: false;
    /// The chevron to draw, when the caller has an icon set of its own.
    in property <MdIconPath> icon: { commands: "", viewbox: 0, stroke-width: 0 };
    /// The row is pressed. The view decides what that means, and says which run
    /// it was.
    callback toggled(int);

    x: chunk.head-x;
    y: chunk.head-y - chunk.top;
    width: chunk.head-width;
    height: chunk.head-height;
    border-top-left-radius: chunk.head-radius;
    border-top-right-radius: chunk.head-radius;
    border-bottom-left-radius: chunk.head-radius;
    border-bottom-right-radius: chunk.head-radius;
    background: touch.pressed ? palette.details-head-active
        : touch.has-hover ? palette.details-head-hover
        : palette.details-head;
    animate background { duration: 50ms; }

    // The chevron, drawn the way `AppIcon` draws one — path data at its own view
    // box, stroked, round caps and joins — so the caller's icon and the built-in
    // fallback are the same picture. A path rather than a glyph either way: the
    // engine has no icon font, and `Comfortaa` has none of the triangles a
    // disclosure wants, where a missing glyph is a box.
    if root.icon.viewbox > 0 : Path {
        x: chunk.marker-x - root.x;
        y: chunk.marker-y - chunk.top - root.y;
        width: chunk.marker-size;
        height: chunk.marker-size;
        commands: root.icon.commands;
        viewbox-width: root.icon.viewbox;
        viewbox-height: root.icon.viewbox;
        fill: transparent;
        stroke: palette.details-marker;
        stroke-width: chunk.marker-size * root.icon.stroke-width / root.icon.viewbox;
        stroke-line-cap: LineCap.round;
        stroke-line-join: LineJoin.round;
        // A quarter turn, from the *right* a closed disclosure shows to the *down*
        // an open one does. Half a turn from a down-chevron would end up pointing
        // up, which reads as "collapse this" while the section is open. A quarter
        // turn is only honest because the icon set's `chevron-forward` and
        // `chevron-down` are the same glyph: the caller's own icon has to be one
        // of them, or the two states are two different pictures and the turn lies.
        transform-rotation: root.open ? 90deg : 0deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        animate transform-rotation { duration: 200ms; easing: ease-in-out; }
    }

    if root.icon.viewbox <= 0 : Path {
        x: chunk.marker-x - root.x;
        y: chunk.marker-y - chunk.top - root.y;
        width: chunk.marker-size;
        height: chunk.marker-size;
        fill: palette.details-marker;
        transform-rotation: root.open ? 90deg : 0deg;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        animate transform-rotation { duration: 200ms; easing: ease-in-out; }
        commands: "M " + (self.width / 1px * 0.36) + " " + (self.height / 1px * 0.22)
            + " L " + (self.width / 1px * 0.66) + " " + (self.height / 1px * 0.5)
            + " L " + (self.width / 1px * 0.36) + " " + (self.height / 1px * 0.78)
            + " L " + (self.width / 1px * 0.26) + " " + (self.height / 1px * 0.68)
            + " L " + (self.width / 1px * 0.46) + " " + (self.height / 1px * 0.5)
            + " L " + (self.width / 1px * 0.26) + " " + (self.height / 1px * 0.32) + " Z";
    }

    // No `mouse-cursor: pointer` here, and that is the house rule rather than an
    // oversight: this is a desktop app, a control's own shape is what says it is
    // one, and an arrow over every pressable thing tells the reader nothing they
    // did not already get from the row lighting up under the pointer. A link is
    // the exception and it says why in `MdLink`.
    touch := TouchArea {
        clicked => { root.toggled(root.chunk.section-index); }
    }
}

/// Draws a document.
///
/// The caller owns the state: it runs the Rust `Renderer`, copies the resulting
/// runs into [`MdChunk`]s, and pushes them in as `chunks` with `content-height`
/// beside them. The component's job is to draw them, to answer a click on a link,
/// and to leave everything it is given a way to override.
///
/// # Culling
///
/// Nothing here walks the visible part of the list: a README of any length is
/// thousands of items and a renderer struggles well before that. A caller that
/// has a scroll offset sets `viewport-y` and `viewport-height` and the `visible`
/// binding below skips the rest — which is why the view asks for the offset
/// rather than working it out. The margin is generous on purpose: an item that
/// appears a little outside the window costs nothing, and one that appears
/// *inside* it late is what a user notices.
export component MarkdownView inherits Rectangle {
    /// The document, in runs, in document order. Never empty in practice: a
    /// document with no `<details>` in it is one run of everything.
    in property <[MdChunk]> chunks: [];
    /// How tall the list is *with every section open*, which is what the engine
    /// laid out for. Not what a scroll container should offer — `shown-height` is
    /// that, and the two differ by whatever the closed sections are hiding.
    in property <length> content-height: 0px;
    /// The colours `color` resolves against. See `MarkdownPalette`.
    // Every slot is named. A struct's unset fields take their *type* default,
    // which for a color is opaque black, and `MarkdownColors.resolve` only falls
    // back to `text` for a name it does not know — not for one that was left out.
    // Twelve of the twenty roles are set to something other than black here, and
    // would come out black without this literal.
    in property <MarkdownPalette> palette: {
        text: #000000,
        heading: #000000,
        link: #0000ee,
        code-text: #000000,
        code-background: #cccccc,
        code-block-text: #000000,
        code-block-background: #eeeeee,
        quote-text: #555555,
        quote-bar: #888888,
        table-border: #aaaaaa,
        table-head-text: #000000,
        table-head-background: #dddddd,
        rule: #888888,
        strike: #000000,
        // GitHub's `.markdown-body` has no `::marker` and no broken-image rule,
        // so a browser draws both in the text's own colour.
        marker: #000000,
        placeholder: #000000,
        details-head: #ffffff,
        details-head-hover: #f0f0f0,
        details-head-active: #e0e0e0,
        details-marker: #444444,
    };
    /// The family body text is set in. A run with `mono` is set in `mono-family`
    /// instead, and an empty one falls back to the window's default.
    in property <string> family: "";
    /// The family code spans and code blocks are set in. Slint's `font-family`
    /// does not resolve a generic name like `monospace` the way CSS does, so name
    /// the same real family the engine measures with.
    in property <string> mono-family: "monospace";
    /// The chevron a `<details>` row draws, when the caller has an icon set. An
    /// empty one — a `viewbox` of zero — draws the built-in path instead.
    in property <MdIconPath> marker-icon: { commands: "", viewbox: 0, stroke-width: 0 };
    /// The scroll offset of whatever contains this view: 0 at the top, negative
    /// scrolled down. Only read when culling is on.
    in property <length> viewport-y: 0px;
    /// The height of the window onto the document, for the same reason.
    in property <length> viewport-height: 0px;
    /// Skip the items outside the viewport. Off by default, because a view that
    /// has no scroll offset to report should not silently lose them.
    in property <bool> cull: false;
    /// The id of the link the pointer is inside, which is what the rules follow.
    ///
    /// `in-out`, because the view sets it and a caller may set it too: a caller
    /// with its own idea of where the pointer is — a keyboard focus, a test, a
    /// touch device — drives the same underline without going through a
    /// `TouchArea`. An empty value means no rule is drawn, which is the right
    /// default: an underline that never appears is better than one that appears
    /// and never goes away.
    in-out property <string> hovered-link: "";
    /// A link was clicked. The parameter is its URL.
    callback link-clicked(string);

    /// Which runs are open, index-aligned with `chunks`. A run that is not a
    /// section has nothing to open, and the value it holds is never read.
    ///
    /// The caller owns this rather than the view, for the same reason it owns the
    /// chunks: a re-layout — which a width change causes — rebuilds the model, and
    /// state the view kept in a property would be gone the first time the window
    /// moved a pixel. Index-aligned rather than keyed by an id because the runs
    /// are the document's own structure and do not change when it is re-wrapped,
    /// and because the caller has to rewrite the model on every layout either way:
    /// this way it reads each section's own `open` as the answer for a run it has
    /// no state for.
    in-out property <[bool]> section-open: [];
    /// A summary row was clicked. The parameter is the section's id (the run's
    /// `section-index`, not its position in `chunks`).
    callback section-toggled(int);
    /// The document's height with every run at the height it is at right now.
    ///
    /// A binding rather than a callback: the runs are laid out by a
    /// `VerticalLayout`, so the column's own height *is* this, and reading it is
    /// exact on every frame of a collapse instead of a frame behind. A caller has
    /// to size its scroll container from here rather than from `content-height`:
    /// the engine's height is the open one, and a container that used it would
    /// keep a scroll range for content that is on its way out, and the document
    /// would end in a band of empty space as tall as everything closed.
    ///
    /// `content-height` is the one exception, and it is a degenerate one: with
    /// nothing in `chunks` the column measures nothing at all, and a caller that
    /// has laid a document out but not yet pushed it still has the engine's
    /// number. That is the only case where it beats the column.
    out property <length> shown-height:
        root.chunks.length == 0 ? root.content-height : column.preferred-height;

    /// The view's width, in logical pixels.
    ///
    /// This is the *only* thing a caller has to hear about before the document
    /// has to be laid out again, which is why the view reports its size rather
    /// than waiting to be asked: a document is a function of its width and its
    /// style, and a width nobody is told about is a document that never re-wraps.
    ///
    /// It is reported **twice over**, and both halves are needed. A `changed`
    /// handler does not fire for a bound property's *first* value — only for
    /// changes after it — so a view that reported its width from `changed` alone
    /// would tell the caller about every resize except the one that decides where
    /// every line breaks. `init` covers the first value, `changed` covers the rest.
    callback resized(length);

    init => { root.resized(self.width); }
    changed width => { root.resized(self.width); }

    background: transparent;
    clip: true;

    // The runs, stacked.
    //
    // A `VerticalLayout` because it is the only thing in Slint that adds up a list
    // of heights and puts each child under the one before it, and that is the
    // entire mechanism: a closed section's run is as short as its summary row, and
    // everything below it moves up on its own. Drawing a cover over the content
    // and shrinking a number instead would reclaim no space at all — the gap would
    // still be there and the tail of the document would be out of reach.
    //
    // The width is the view's, and the runs stretch across it, so the column
    // measures the document rather than the items inside it: a run's height is a
    // number the engine gave, and a run whose items are all absolutely positioned
    // would otherwise measure zero.
    column := VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;

        for chunk[index] in root.chunks: chunk-box := Rectangle {
            in property <bool> is-section: chunk.section-index >= 0;
            // 1 open, 0 closed. The animation is on this and not on the height, so
            // that the height and the clip below follow one number.
            private property <float> progress: root.section-open[index] ? 1 : 0;
            animate progress {
                duration: 200ms;
                easing: cubic-bezier(0.215, 0.61, 0.355, 1);
            }

            /// Whether something at `y` inside this run is near enough to the
            /// window onto the document to be worth drawing.
            ///
            /// The margin is generous on purpose: something that appears a little
            /// outside it costs nothing, and one that appears *inside* it late is
            /// what a reader notices. The item is placed against the run and the run
            /// is placed by the layout, so the two together are where it is on
            /// screen — a closed section has moved every run below it, which is why
            /// the engine's own number would be the wrong one to compare against.
            function in-window(y: length) -> bool {
                return y + chunk-box.y + root.viewport-y > -root.viewport-height
                    && y + chunk-box.y + root.viewport-y < 2 * root.viewport-height;
            }

            width: 100%;
            height: chunk.height - (self.is-section ? chunk.hidden * (1 - self.progress) : 0px);
            background: transparent;
            // Only a section clips: a shrinking run has to crop its own content
            // against what it is showing, and nothing else here can overflow.
            clip: true;

            if self.is-section : MdSectionRow {
                chunk: chunk;
                palette: root.palette;
                icon: root.marker-icon;
                open: root.section-open[index];
                toggled(at) => { root.section-toggled(at); }
            }

            // A run's items carry `y` relative to the *run* rather than to the
            // document: that is what the caller copies across, and it is what lets
            // these components be handed the item and nothing else. The document's
            // coordinates are the engine's, and stay absolute there.
            //
            // Drawn straight onto the run rather than through a wrapper that would
            // carry one shared `visible`: a box of no size between the run and its
            // text is harmless until something clips, and then it takes the text
            // with it.
            //
            // One loop and a conditional per kind, because the run's *paint order*
            // is the engine's: a chip's background is emitted before the run of text
            // it sits behind, and drawing every rectangle after every piece of text
            // would put the capsule over its own code.
            for item in chunk.items : Rectangle {
                visible: !root.cull || in-window(item.y);
                // No box of its own, so it neither draws nor clips: the items place
                // themselves, and the culling is the one thing they share.
                x: 0;
                y: 0;
                width: 0;
                height: 0;
                background: transparent;

                if item.kind == "text" : MdText {
                    item: item;
                    text-color: MarkdownColors.resolve(root.palette, item.color);
                    family: root.family;
                    mono-family: root.mono-family;
                }

                if item.kind == "rect" : MdRect {
                    item: item;
                    fill: MarkdownColors.resolve(root.palette, item.color);
                    outline: MarkdownColors.resolve(root.palette, item.border-color);
                }
            }

            for picture in chunk.images : MdImage {
                visible: !root.cull || in-window(picture.y);
                picture: picture;
                hovered-id: root.hovered-link;
                link-clicked(url) => { root.link-clicked(url); }
            }

            // The links are last within their run so their boxes are over the text:
            // a press on a link has to reach the link, not the glyphs it is drawn
            // in. An item with a URL is a link — there is no other kind of item
            // that carries one. A run's links are under the *next* run's items, and
            // the runs do not overlap, so a link is never under its own text.
            for item in chunk.items : MdLink {
                // Culled like the other two loops. Every table cell and chip in
                // the document is a `rect`, so without this an off-screen one is
                // still painted and still hit-testable, and an off-screen link
                // can set `hovered-link`. A hidden element takes no pointer
                // events, so that half of it is fixed. The element itself is
                // still created — Slint has no `for … : if`, so a link box is
                // allocated per cell — but it is neither drawn nor hit-tested.
                visible: (item.kind == "rect" && item.link-url != "")
                    && (!root.cull || in-window(item.y));
                box-item: item;
                link-color: root.palette.link;
                hovered-id: root.hovered-link;
                hover-changed(id, on) => { root.hovered-link = on ? id : ""; }
                link-clicked(url) => { root.link-clicked(url); }
            }
        }
    }
}
