import { Theme } from "../theme.slint";
import { AppConfig } from "../globals/settings.slint";

// A palette preview tile: 90x60, rounded, label at `width - 20`.
//
// Neither the 4px blue outline nor the label is inside the tile: the outline is
// drawn 4px outside the 90x60 box, and the label sits 70px down a 60px box. Both
// show because the tile has no `clip`. This one cannot carry one either —
// Slint's `clip` cuts the children to the element's box, which would take the
// outline and the label with it. The radius is therefore on the image box, the
// one element that has to be rounded and cropped.
component PaletteSwatch inherits Rectangle {
    in property <image> preview;
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> swatch-disabled: false;
    callback chosen;

    width: 90px;
    height: 60px;

    // Disabled swatches dim every *descendant*, and that is written per element
    // rather than on the component root on purpose. An element carrying
    // `opacity` below 1 is composited through a layer bounded by its own box, so
    // an opacity on this root clipped the label off altogether: the label sits
    // ten pixels *below* this 60px box, and with follow-system on — the only
    // state in which anything here is disabled — the palette showed four
    // unlabelled tiles. Nothing that dims has a child escaping its box: the
    // outline draws nothing, the image fills the box it dims, and the label
    // draws inside its own.
    private property <float> dim: root.swatch-disabled ? 0.6 : 1.0;

    if root.selected : Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: 10px;
        background: Theme.blue;
        opacity: root.dim;
    }

    image-box := Rectangle {
        width: 90px;
        height: 60px;
        border-radius: 6px;
        clip: true;
        opacity: root.dim;

        Image {
            width: 100%;
            height: 100%;
            source: root.preview;
            image-fit: contain;
        }
    }

    Text {
        text: root.label;
        font-size: 12.3px;
        font-weight: Theme.font-weight-normal;
        color: Theme.default-text-color.transparentize(0.1);
        opacity: root.dim;
        y: parent.width - 20px;
        width: 100%;
        horizontal-alignment: center;
    }

    TouchArea {
        enabled: !root.swatch-disabled;
        clicked => { root.chosen(); }
    }
}

// The four palette tiles. The appearance settings and the setup wizard draw the
// same block, so it is one component. It sits in a `SettingGroup` as the last
// child, which is what rounds the two bottom corners (`group-last`).
export component PaletteRow inherits Rectangle {
    /// The palette a tile is outlined for. With "follow system" on it is Mocha
    /// or Latte whichever the system is, and otherwise the configured one.
    in property <string> selected: "";
    in property <bool> swatches-disabled: false;
    /// Rounds the two bottom corners when this is the last row of its group.
    in property <bool> group-last: true;

    width: 100%;
    height: 120px;
    background: Theme.setting-item-background;
    border-bottom-left-radius: root.group-last ? 8px : 0px;
    border-bottom-right-radius: root.group-last ? 8px : 0px;

    // The tiles are centred with a 24px gap and an 18px top inset. Spacing and
    // padding say so directly rather than through hand-computed offsets, so a
    // fifth tile, or a wider one, needs nothing changed here.
    HorizontalLayout {
        alignment: center;
        cross-axis-alignment: start;
        padding-top: 18px;
        spacing: 24px;

        PaletteSwatch {
            preview: @image-url("../assets/images/palette-latte.png");
            label: "Latte";
            selected: root.selected == "Latte";
            swatch-disabled: root.swatches-disabled;
            chosen => {
                Theme.transitions-enabled = true;
                AppConfig.palette = "Latte";
                AppConfig.changed();
            }
        }
        PaletteSwatch {
            preview: @image-url("../assets/images/palette-frappe.png");
            label: "Frappé";
            selected: root.selected == "Frappe";
            swatch-disabled: root.swatches-disabled;
            chosen => {
                Theme.transitions-enabled = true;
                AppConfig.palette = "Frappe";
                AppConfig.changed();
            }
        }
        PaletteSwatch {
            preview: @image-url("../assets/images/palette-macchiato.png");
            label: "Macchiato";
            selected: root.selected == "Macchiato";
            swatch-disabled: root.swatches-disabled;
            chosen => {
                Theme.transitions-enabled = true;
                AppConfig.palette = "Macchiato";
                AppConfig.changed();
            }
        }
        PaletteSwatch {
            preview: @image-url("../assets/images/palette-mocha.png");
            label: "Mocha";
            selected: root.selected == "Mocha";
            swatch-disabled: root.swatches-disabled;
            chosen => {
                Theme.transitions-enabled = true;
                AppConfig.palette = "Mocha";
                AppConfig.changed();
            }
        }
    }
}
