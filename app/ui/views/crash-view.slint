import { Theme } from "../theme.slint";
import { CrashState } from "../globals/crash.slint";
import { Button } from "../components/controls/button.slint";
import { ScrollView } from "../components/containers/scroll-view.slint";

// The crash report page.
//
// A placeholder shape rather than a finished design: it shows whatever the
// launch crate's `CrashReport` carried, with no processing — the instance, the
// summary line, the exit code, a scrollable dump of the raw crash text and the
// report path. The design is expected to change; the wiring (Rust sets the
// `CrashState` fields and navigates to the `"crash"` page) is what this
// settles.
//
// It is a page rather than a dialog so a game that crashes after the launcher
// has been left on some other screen takes the whole window, the way the
// launch and game screens do.
export component CrashView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    content := VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 32px;
        spacing: 12px;

        Text {
            height: 30px;
            text: @tr("CrashView" => "Game crashed");
            font-size: 24px;
            color: Theme.red;
            vertical-alignment: center;
        }

        Text {
            height: 20px;
            text: CrashState.instance-name;
            font-size: 16px;
            color: Theme.default-text-color;
            vertical-alignment: center;
        }

        Text {
            // Auto height: the summary wraps to as many lines as it needs.
            text: CrashState.summary;
            font-size: 14px;
            wrap: word-wrap;
            color: Theme.default-text-color.transparentize(0.1);
        }

        if CrashState.exit-code != "": Text {
            height: 16px;
            text: CrashState.exit-code;
            font-size: 12px;
            color: Theme.default-text-color.transparentize(0.4);
            vertical-alignment: center;
        }

        if CrashState.reasons != "": Text {
            text: CrashState.reasons;
            font-size: 12px;
            wrap: word-wrap;
            color: Theme.peach;
        }

        if CrashState.keywords != "": Text {
            text: @tr("CrashView" => "Possible mods:") + " " + CrashState.keywords;
            font-size: 12px;
            wrap: word-wrap;
            color: Theme.peach;
        }

        ScrollView {
            vertical-stretch: 1;
            background: Theme.crust.with-alpha(0.6);

            Text {
                width: 100%;
                text: CrashState.details;
                font-size: 12px;
                wrap: word-wrap;
                color: Theme.default-text-color.transparentize(0.1);
            }
        }

        if CrashState.report-path != "": Text {
            // Auto height: a long path may wrap, but usually does not.
            text: CrashState.report-path;
            font-size: 11px;
            wrap: word-wrap;
            color: Theme.default-text-color.transparentize(0.4);
        }

        Button {
            width: 100%;
            text: @tr("CrashView" => "Close");
            clicked => { CrashState.close(); }
        }
    }
}
