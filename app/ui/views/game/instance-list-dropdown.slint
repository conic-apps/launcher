import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { Dropdown, DropdownOption } from "../../globals/dropdown.slint";
import { FocusManager } from "../../globals/focus.slint";

export component InstanceListDropdown inherits Rectangle {
    in property <string> label: "";
    in property <string> selected: "";
    in property <[DropdownOption]> options: [];
    in property <string> selected-key: "";
    in property <string> dropdown-id: "instance-list";
    callback select(string);

    out property <bool> opened: root.is-open;

    // No `width` here on purpose. A `Rectangle` fills its parent anyway, so the
    // row below does not need to be told the component's width — but a *layout*
    // child must not bind one, and `width: 100%` on the root was quietly taking
    // the width back from the layout that was supposed to be dividing it. With
    // the two instances in `instances-list-tool-bar.slint` both at
    // `horizontal-stretch: 1` the row stopped splitting in half.
    height: 25px;
    // The root carries the head's fill.
    background: Theme.surface-0;
    border-radius: 4px;

    private property <bool> is-open: Dropdown.open && Dropdown.owner == root.dropdown-id;
    private property <float> chevron-flip: root.is-open ? 1.0 : 0.0;
    animate chevron-flip { duration: 200ms; easing: ease-in-out; }

    private property <int> serial: Dropdown.choose-serial;
    changed serial => {
        if Dropdown.choose-owner == root.dropdown-id {
            root.select(Dropdown.chosen);
        }
    }

    // The label is its own text and the selection takes the rest, with the
    // chevron 12px from the end.
    //
    // Spelled out rather than left to the default: the geometry default is
    // specified per element type, and this is the box the only `TouchArea` in
    // the component lives in — a layout whose children are all `Rectangle`s has
    // a preferred size of 0, so if the default is ever the preferred size
    // rather than the parent's, the dropdown stops being clickable rather than
    // merely looking wrong.
    head := HorizontalLayout {
        width: root.width;
        height: root.height;
        cross-axis-alignment: center;

        // Both halves are layouts rather than `Rectangle`s wrapping a layout.
        // A nested `HorizontalLayout` does not fill a `Rectangle` parent the way
        // the `Rectangle` itself does — it shrink-wraps — and `width: 100%` on
        // it did not rescue that here: the row stayed a few pixels wide, the
        // selection elided to a bare "…", and the chevron, 12px from the end of
        // a tiny box, sat in the middle of the dropdown instead of at its edge.
        // Made a layout, it is placed by `head` like anything else, so it is
        // given the room it is entitled to and its own padding applies.
        //
        // `horizontal-stretch: 0` keeps the label at its own width. Stretch
        // factors default to 1, so without it the label would claim half the row
        // away from the selection.
        label-box := Rectangle {
            horizontal-stretch: 0;
            vertical-stretch: 0;
            background: Theme.surface-1;
            border-radius: 4px;

            HorizontalLayout {
                padding-top: 6px;
            padding-bottom: 6px;
            padding-left: 12px;
            padding-right: 12px;
            cross-axis-alignment: center;

            label-text := Text {
                text: root.label;
                font-size: 13px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
            }
            }
        }

        // The chevron's `horizontal-stretch: 0` gives it its own 14px and the
        // selection the rest, so the arrow is 12px from the end whatever the text
        // is doing. Stretch factors default to 1, and a stretching chevron claims
        // half the free space with the text and drags the arrow inward.
        selected-box := Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            HorizontalLayout {
            width: 100%;
            height: 100%;
            padding-left: 12px;
            padding-right: 12px;
            cross-axis-alignment: center;

            Text {
                text: root.selected;
                font-size: 13px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
                horizontal-stretch: 1;
                overflow: elide;
                wrap: no-wrap;
            }

            AppIcon {
                name: "chevron-down";
                horizontal-stretch: 0;
                size: 14px;
                icon-color: Theme.default-text-color.transparentize(0.1);
                transform-scale-y: (1.0 - 2.0 * root.chevron-flip) * 100%;
                opacity: 1.0 - 0.3 * (1.0 - abs(1.0 - 2.0 * root.chevron-flip));
                }
            }
        }
    }

    // The whole component is the click target, so this hangs off the *root*
    // and not off `head`. Inside the layout it was a column like any other:
    // stretch factors default to 1, so it took a share of the free space away
    // from the selection, and `width: 100%` handed it the whole row as its
    // preferred size besides — the selection elided to a bare "…" and the
    // chevron stopped being 12px from the end. Out here it is in no layout at
    // all, so the `TouchArea` rule applies in full: 100% of its parent, which is
    // the whole dropdown, and it costs the row nothing.
    head-touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            FocusManager.clear();
            if (root.is-open) {
                Dropdown.open = false;
                } else {
                Dropdown.options = root.options;
                Dropdown.accounts = [];
                Dropdown.account-mode = false;
                Dropdown.current = root.selected-key;
                Dropdown.owner = root.dropdown-id;
                Dropdown.anchor-x = root.absolute-position.x;
                Dropdown.anchor-y = root.absolute-position.y + root.height + 4px;
                Dropdown.anchor-width = root.width;
                Dropdown.expand-upwards = false;
                Dropdown.open = true;
            }
        }
    }
}
