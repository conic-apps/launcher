import { Theme } from "../../theme.slint";
import { MusicState } from "../../globals/music.slint";

// Audio visualizer.
//
// A row of bars across the container: the live spectrum while a track is
// playing, and a 2px baseline when it is not. The bars are elements in logical
// pixels; see `app/src/ui/overlays/music_player/` for why the spectrum-to-bars maths is on the Rust
// side rather than in a binding.
//
// A gradient is relative to the element it fills, so a bar draws the range *it*
// covers: from `lavender` at its own foot to wherever the full-height gradient
// is at the bar's head — the same colour everywhere, which is what `level` (a
// fraction of the container height) is for.
export component BeatMap inherits Rectangle {
    /// Take the whole container and drop the block's own border radius (and,
    /// with `transparent`, its opaque background). The size itself is the
    /// caller's.
    in property <bool> fill: false;
    /// Skip the opaque background so the parent shows through.
    in property <bool> transparent: false;
    /// Live spectrum (`MusicState.live`) or the idle baseline.
    in property <bool> live: MusicState.live;
    /// One bar height per bar, 0..1 of `height`.
    in property <[float]> levels: MusicState.levels;
    /// Minimum bar width in logical pixels: the bar count is the container's
    /// width divided by this. A plain number because Slint cannot divide one
    /// length by another.
    in property <float> min-bar-width: 10;
    /// Reports a resize; the bar count — and through it the analyser's
    /// resolution — follow.
    callback resized(int);

    width: 100%;
    height: 100%;
    // The fixed block's own 48px height is a state rather than a ternary,
    // because Slint will not unify the `100%` of a filled box with a `48px`
    // length in one expression. The radius *is* a plain ternary, so it is one —
    // the state block is for the height alone, and the radius is a second thing
    // it would otherwise have carried.
    states [
        block when !root.fill : {
            height: 48px;
        }
    ]
    border-radius: root.fill ? 0 : 8px;
    background: (root.fill || root.transparent) ? Colors.transparent : Theme.mantle;

    // ----- geometry -----
    private property <int> bar-count: clamp(
        floor(root.width / 1px / root.min-bar-width),
        32,
        256,
    );
    private property <length> bar-width: root.width / root.bar-count;
    // A quarter of a bar's width, floored, at least 1px.
    private property <length> bar-gap: max(1px, floor(root.bar-width * 0.25 / 1px) * 1px);
    /// The floor that keeps a silent bar visible.
    private property <length> min-bar-height: 1px;
    /// The idle branch's 2px baseline.
    private property <length> idle-height: 2px;

    // `init` covers the first layout: the width is not known yet, so the count
    // is the floor, and a window that really is that narrow leaves it there —
    // which is the right answer either way.
    init => {
        root.resized(root.bar-count);
    }

    changed bar-count => {
        root.resized(root.bar-count);
    }


    // The frame pump: the spectrum is a *pull* from Rust, so something has to ask
    // for it once per frame, and a window with an animation in flight is one
    // Slint keeps painting. The item is zero-sized, so nothing on screen depends
    // on the value (the same trick as `window-background.slint`'s).
    if root.visible && root.live : Rectangle {
        x: (animation-tick() / 1s) * 1px;
        width: 0;
        height: 0;
    }

    // The live branch: one bar per level. `levels` is empty whenever `live` is
    // false, so the guard is belt and braces — but the idle branch below is
    // gated on `!live`, and the two should agree about which one owns the bars.
    if root.live : live-bars := Rectangle {
        for level[index] in root.levels : Rectangle {
            x: floor(index * root.bar-width / 1px) * 1px;
            y: root.height - self.height;
            width: root.bar-width - root.bar-gap;
            // The live branch's bar height, floored so a silent bar stays
            // visible.
            height: max(root.min-bar-height, level * root.height);
            // The full-height gradient, drawn for the part of it this bar
            // covers: from `lavender` at the bar's own foot to wherever the
            // gradient is at the bar's head, which is what `level` — a fraction
            // of the container height — is for.
            background: @linear-gradient(
                0deg,
                Theme.lavender 0%,
                Theme.lavender.mix(Theme.blue, level) 100%,
            );
        }
    }

    // The idle branch: the same number of bars, two pixels of `surface-2` at the
    // bottom. It is its own loop because a gradient cannot share a `background`
    // ternary with a plain colour — the two do not unify into a brush, and the
    // bars come out invisible.
    if !root.live : idle := Rectangle {
        // An integer model repeats once per bar.
        for index in root.bar-count : Rectangle {
            x: floor(index * root.bar-width / 1px) * 1px;
            y: root.height - root.idle-height;
            width: root.bar-width - root.bar-gap;
            height: root.idle-height;
            background: Theme.surface-2;
        }
    }
}
