import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/display/app-icon.slint";
import { AccountAvatar } from "../../components/display/account-avatar.slint";
import { BeatMap } from "beat-map.slint";
import { MusicState } from "../../globals/music.slint";
import { AppConfig } from "../../globals/settings.slint";
import { GameState, GameIntro } from "../../globals/game.slint";
import { AccountListDropdown } from "account-list-dropdown.slint";

// A pill-shaped footer action (account switcher / connect / new instance /
// install pack). The label is hidden for the icon-only buttons.
component FooterButton inherits Rectangle {
    in property <string> icon;
    in property <bool> show-label: false;
    in property <string> label-text: "";
    callback clicked;

    // 12px of padding around a 22px icon on each side; the labelled "New
    // instance" adds an 8px gap and the label.
    width: root.show-label ? 54px + label.preferred-width : 46px;
    private property <length> label-width: root.show-label ? label.preferred-width : 0px;
    height: 36px;
    border-radius: 8px;
    background: button-touch.pressed ? Theme.surface-1
        : button-touch.has-hover ? Theme.surface-1.transparentize(0.2)
        : Theme.surface-0;
    drop-shadow-color: #00000033;
    drop-shadow-blur: 10px;

    HorizontalLayout {
        alignment: center;
        // The label is hidden on the icon-only buttons but its cell stays in the
        // layout — and Slint gives even an *empty* `Text` a few pixels of
        // preferred width — so both its width and its gap have to be zeroed or
        // the icon is pushed left of centre and the button reads as
        // right-padded only. The width is a property of its own because the
        // button's own width needs the label's, which `visible` cannot give.
        spacing: root.show-label ? 8px : 0px;
        cross-axis-alignment: center;

        AppIcon {
            name: root.icon;
            size: 22px;
            icon-color: Theme.default-text-color.transparentize(0.1);
        }

        label := Text {
            width: root.label-width;
            text: root.label-text;
            font-size: 14px;
            font-weight: Theme.font-weight-normal;
            color: Theme.default-text-color.transparentize(0.1);
            visible: root.show-label;
        }
    }

    button-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Bottom bar: account avatar + switcher, connect / new instance / install pack,
// over the background music visualizer.
export component GameFooterBar inherits Rectangle {
    width: 100%;
    height: 56px;
    background: transparent;

    // The bar slides up from 56px below the window over 0.6s, then its contents
    // fade in from +10px, staggered — the avatar at 0.1s, the account name at
    // 0.15s, connect at 0.2s. The right-hand actions run alongside the first
    // group, so they take the same 0.1s / 0.15s beats.
    private property <duration> item-duration: 200ms;
    private property <length> intro-dy: GameIntro.played ? 0px : 56px;
    animate intro-dy { duration: 600ms; easing: ease-out-quart; }

    // The bar is drawn on top of the instance list, but a bare `Rectangle` does
    // not take pointer events: Slint dispatches to the topmost item first and
    // falls through to the items below whenever one ignores the event, so a
    // press on the bar's empty area would reach the card underneath and select
    // it. The shield swallows it; it is declared first so the controls in `body`
    // below still get their own events.
    shield := TouchArea {
        width: root.width;
        height: root.height;
        // A bare `TouchArea`'s `scroll-event` defaults to `reject`, which would
        // let the wheel through to the list, so accept it to keep the list from
        // scrolling under the bar.
        scroll-event(event) => { accept }
    }

    body := Rectangle {
        x: 0;
        y: root.intro-dy;
        width: root.width;
        height: root.height;
        background: Theme.surface-0.transparentize(0.4);

        // Declared first: it is the layer under every sibling.
        //
        // Its opacity is 0.3, not 0.5.
        //
        // It takes no pointer events.
        if AppConfig.show-visualizer : BeatMap {
            fill: true;
            transparent: true;
            opacity: 0.3;
            // The visualizer fills the footer, so its box is the footer's. It is
            // given here, at the one place that knows that box, because a
            // percentage on a component's own root does *not* resolve against
            // the element the instance was written in: it is evaluated before
            // the wrapper an `if` puts around a conditional child has a size,
            // and stays at the 100px it could not resolve.
            width: parent.width;
            height: parent.height;
            resized(bar-count) => { MusicState.resized(bar-count); }
        }

        if GameState.has-account : account-layer := Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            pill := AccountListDropdown {
                // 28 + 56 − 16: the avatar's right edge, less the 16px the pill
                // tucks under the circle.
                x: 68px;
                y: -6px + self.intro-dy;
                name: GameState.current-account-name;
                kind: GameState.current-account-kind;
                players: GameState.accounts;
                current-key: GameState.current-account-key;
                include-add-account: true;
                opacity: self.intro-alpha;
                select(key) => { GameState.select-account(key); }
                add-account => { GameState.open-add-account(); }

                private property <length> intro-dy: GameIntro.played ? 0px : 10px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dy { duration: root.item-duration; delay: 150ms; easing: ease-out-quart; }
                animate intro-alpha { duration: root.item-duration; delay: 150ms; easing: ease-out-quart; }
            }

            connect-button := FooterButton {
                x: pill.x + pill.width + 8px;
                y: -6px + self.intro-dy;
                icon: "globe";
                opacity: self.intro-alpha;
                clicked => { GameState.open-connect(); }

                private property <length> intro-dy: GameIntro.played ? 0px : 10px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dy { duration: root.item-duration; delay: 200ms; easing: ease-out-quart; }
                animate intro-alpha { duration: root.item-duration; delay: 200ms; easing: ease-out-quart; }
            }
        }

        if !GameState.has-account : unlogged-layer := Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            unlogged-pill := Rectangle {
                // 28 + 56 − 16, as the logged-in pill above: the avatar's right
                // edge less the 16px the pill tucks under the circle.
                x: 68px;
                y: -6px + self.intro-dy;
                width: 32px + unlogged-text.preferred-width + 16px;
                height: 36px;
                border-radius: 8px;
                background: Theme.surface-0;
                drop-shadow-color: #00000033;
                drop-shadow-blur: 10px;
                opacity: self.intro-alpha;

                private property <length> intro-dy: GameIntro.played ? 0px : 10px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dy { duration: root.item-duration; delay: 150ms; easing: ease-out-quart; }
                animate intro-alpha { duration: root.item-duration; delay: 150ms; easing: ease-out-quart; }

                unlogged-text := Text {
                    text: @tr("Not logged in");
                    font-size: 14px;
                    font-weight: Theme.font-weight-normal;
                    color: Theme.default-text-color.transparentize(0.1);
                    x: 32px;
                }

                unlogged-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => { GameState.open-add-account(); }
                }
            }

            connect-button-unlogged := FooterButton {
                x: unlogged-pill.x + unlogged-pill.width + 8px;
                y: -6px + self.intro-dy;
                icon: "globe";
                opacity: self.intro-alpha;
                clicked => { GameState.open-connect(); }

                private property <length> intro-dy: GameIntro.played ? 0px : 10px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dy { duration: root.item-duration; delay: 200ms; easing: ease-out-quart; }
                animate intro-alpha { duration: root.item-duration; delay: 200ms; easing: ease-out-quart; }
            }
        }

        // Declared after the account layers so the avatar's circle — inset 28px
        // from the left, overhanging the bar — is painted *over* the left 16px of
        // the name pill it overlaps. Slint paints siblings in declaration order
        // unless `z` is set, and the compiler ignores `z` on a component
        // instance's root, so here the order is the z-order.
        //
        // The box is 56px. `AccountAvatar` insets its own 4px for the avatar's
        // padding and border, so both sit inside those 56px and need no extra
        // room here.
        avatar-wrap := Rectangle {
            x: 28px;
            y: -18px + self.intro-dy;
            width: 56px;
            height: 56px;
            background: transparent;
            opacity: self.intro-alpha;

            private property <length> intro-dy: GameIntro.played ? 0px : 10px;
            private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
            animate intro-dy { duration: root.item-duration; delay: 100ms; easing: ease-out-quart; }
            animate intro-alpha { duration: root.item-duration; delay: 100ms; easing: ease-out-quart; }

            AccountAvatar {
                width: 100%;
                height: 100%;
                skin: GameState.current-account-avatar;
                kind: GameState.current-account-kind;
                unlogged: !GameState.has-account;
            }

            avatar-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    if GameState.has-account {
                        GameState.open-accounts();
                    } else {
                        GameState.open-add-account();
                    }
                }
            }
        }

        install-pack-button := FooterButton {
            x: parent.width - 52px - self.width;
            y: -6px + self.intro-dy;
            icon: "package";
            opacity: self.intro-alpha;
            clicked => { GameState.open-packs(); }

            private property <length> intro-dy: GameIntro.played ? 0px : 10px;
            private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
            animate intro-dy { duration: root.item-duration; delay: 100ms; easing: ease-out-quart; }
            animate intro-alpha { duration: root.item-duration; delay: 100ms; easing: ease-out-quart; }
        }

        new-instance-button := FooterButton {
            x: install-pack-button.x - 8px - self.width;
            y: -6px + self.intro-dy;
            icon: "add";
            show-label: true;
            label-text: @tr("New instance");
            opacity: self.intro-alpha;
            clicked => { GameState.new-instance(); }

            private property <length> intro-dy: GameIntro.played ? 0px : 10px;
            private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
            animate intro-dy { duration: root.item-duration; delay: 150ms; easing: ease-out-quart; }
            animate intro-alpha { duration: root.item-duration; delay: 150ms; easing: ease-out-quart; }
        }
    }
}
