import { Theme } from "../theme.slint";
import { AppIcon } from "../components/display/app-icon.slint";
import { ScrollView } from "../components/containers/scroll-view.slint";
import { SlideTransition } from "../components/containers/slide-transition.slint";
import { FocusManager } from "../globals/focus.slint";
import { Navigation } from "../globals/navigation.slint";
import { PageMotion } from "../globals/page-motion.slint";
import { AccountAddState } from "../globals/dialogs.slint";
import { SetupWizardState } from "../globals/setup.slint";
import { SetupLanguage } from "setup/setup-language.slint";
import { SetupStorage } from "setup/setup-storage.slint";
import { SetupPalette } from "setup/setup-palette.slint";
import { SetupAddAccount } from "setup/setup-add-account.slint";
import { SetupJavaSettings } from "setup/setup-java-settings.slint";
import { SetupLaunchOptions } from "setup/setup-launch-options.slint";
import { SetupImportInstances } from "setup/setup-import-instances.slint";

// A button of the wizard's bottom bar: 40px tall, 8px rounded, with the white
// hover and press wash. "Back" is 200px with a chevron in front of its label;
// "Next" takes the rest of the row.
component FooterButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> show-icon: false;
    in property <color> fill: Theme.blue;
    /// A disabled button dims and stops taking clicks; "Back" carries this on
    /// the first step.
    in property <bool> disabled: false;
    callback clicked;

    horizontal-stretch: 1;
    height: 40px;
    border-radius: 8px;
    background: root.fill;
    opacity: root.disabled ? 0.7 : 1.0;

    // The white hover and press washes sit over the fill rather than mixed
    // into it, the same arrangement as the import buttons.
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: touch.pressed ? #ffffff6f : touch.has-hover ? #ffffff2f : #ffffff00;
        animate background { duration: 100ms; easing: ease; }
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        cross-axis-alignment: center;
        spacing: 4px;

        if root.show-icon : AppIcon {
            name: "chevron-back";
            size: 20px;
            // The icon is a stroked path, so the label colour is the stroke
            // colour.
            icon-color: Theme.text-inverse;
        }

        Text {
            text: root.text;
            font-size: 13px;
            font-weight: Theme.font-weight-normal;
            color: Theme.text-inverse;
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => {
            FocusManager.clear();
            root.clicked();
        }
    }
}

// The first-run wizard.
//
// A column of three bands: the mauve header, the translucent card that holds
// the step, and the translucent button bar pinned to the bottom of the window.
// The header and the bar slide in from above and below, and the card fades up.
// The page swap drives both directions: the entrance plays on "enter", and the
// exit — defined on its own, not the entrance run backwards — on "leave".
//
// The step swap plays the outgoing screen out and then the incoming one in, the
// same state machine the add-account dialog runs (see `AccountAdd`).
export component SetupView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // The wizard's entrance and exit, driven by the app-wide page swap. The
    // header, card and bar read it; "shown" is at rest.
    private property <string> motion: PageMotion.phase("setup");

    // The header band is 100px narrower than the window and the card 186px,
    // both centred.
    private property <length> header-inset: 100px;
    private property <length> body-inset: 186px;
    // The card's height is the window's less 176px: the header band and its
    // 16px gap take 100px above it, and the bottom 76px hold the 48px button
    // bar plus 28px of space above it.
    private property <length> body-height: root.height - 176px;

    // The wrapper carries 8px of plain `base` below the mauve header.
    header-wrapper := Rectangle {
        x: (root.width - self.width) / 2;
        y: root.motion == "shown" ? 0px : -118px;
        width: root.width - root.header-inset;
        height: header.height + 8px;
        background: Theme.base;
        border-bottom-left-radius: 12px;
        border-bottom-right-radius: 12px;
        // Entrance: down over 0.33s, the first thing on the timeline, no delay.
        // Exit: back up over 0.15s, last of the three, mirroring the entrance's
        // order. The exit is defined on its own (not the entrance reversed) so it
        // can be tuned by itself.
        animate y {
            duration: root.motion == "leave" ? 150ms : 330ms;
            delay: root.motion == "leave" ? 90ms : 0ms;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }

        header := Rectangle {
            width: 100%;
            height: 76px;
            background: Theme.mauve.with-alpha(0.2);
            border-width: 1px;
            border-color: Theme.mauve.with-alpha(0.2);
            border-bottom-left-radius: 12px;
            border-bottom-right-radius: 12px;

            // The two paragraphs sit at 16px and 12px with a 4px gap; the close
            // button is pinned over the right-hand end.
            Text {
                x: 32px;
                y: 16px;
                text: @tr("SetupView" => "First-run setup");
                font-size: 16px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
            }

            Text {
                x: 32px;
                y: 36px;
                text: @tr("SetupView" => "Customize Conic Launcher to suit your preferences");
                font-size: 12px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
            }

            // A 20x20 box around the 16px glyph.
            close := Rectangle {
                x: parent.width - self.width - 32px;
                y: 16px;
                width: 20px;
                height: 20px;
                border-radius: 100px;
                background: close-touch.pressed ? Theme.mauve.with-alpha(0.5)
                    : close-touch.has-hover ? Theme.mauve.with-alpha(0.4)
                    : #ffffff00;
                animate background { duration: 100ms; easing: ease; }

                AppIcon {
                    x: 2px;
                    y: 2px;
                    name: "xmark";
                    size: 16px;
                    icon-color: Theme.default-text-color.transparentize(0.1);
                }

                close-touch := TouchArea {
                    clicked => {
                        FocusManager.clear();
                        root.close-add-account-host();
                        // Closing the wizard means skipping it: Rust keeps the
                        // default storage and marks the wizard done.
                        SetupWizardState.skip();
                        Navigation.navigate("game");
                    }
                }
            }
        }
    }

    // The padding is the `ScrollView`'s own content padding rather than the
    // card's, which is what puts the scrollbar 8px from the card's own edge,
    // inside the 36px of padding, rather than 36px further in: a Slint
    // `ScrollView` pins its scrollbar to its own right edge.
    body := Rectangle {
        x: (root.width - self.width) / 2;
        y: header-wrapper.height + 16px;
        width: root.width - root.body-inset;
        height: root.body-height;
        background: Theme.base.with-alpha(0.9);
        border-radius: 12px;
        clip: true;
        // Entrance: fades and scales up 0.06s after the header, over 0.33s.
        // Exit: back down over 0.15s, 0.03s in — the middle of the reverse order.
        opacity: root.motion == "shown" ? 1.0 : 0.0;
        transform-scale: root.motion == "shown" ? 100% : 90%;
        animate opacity, transform-scale {
            duration: root.motion == "leave" ? 150ms : 330ms;
            delay: root.motion == "leave" ? 30ms : 60ms;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }

        ScrollView {
            content-column := VerticalLayout {
                padding-top: 24px;
                padding-bottom: 24px;
                padding-left: 36px;
                padding-right: 36px;
                alignment: start;

                if root.shown == "language" : SlideTransition {
                    phase: root.leaving ? "leave" : root.arrive-phase;
                    direction: root.direction;
                    SetupLanguage { }
                }

                if root.shown == "storage" : SlideTransition {
                    phase: root.leaving ? "leave" : root.arrive-phase;
                    direction: root.direction;
                    SetupStorage { }
                }

                if root.shown == "palette" : SlideTransition {
                    phase: root.leaving ? "leave" : root.arrive-phase;
                    direction: root.direction;
                    SetupPalette { }
                }

                if root.shown == "add-account" : SlideTransition {
                    phase: root.leaving ? "leave" : root.arrive-phase;
                    direction: root.direction;
                    SetupAddAccount { }
                }

                if root.shown == "java-settings" : SlideTransition {
                    phase: root.leaving ? "leave" : root.arrive-phase;
                    direction: root.direction;
                    SetupJavaSettings { }
                }

                if root.shown == "launch-options" : SlideTransition {
                    phase: root.leaving ? "leave" : root.arrive-phase;
                    direction: root.direction;
                    SetupLaunchOptions { }
                }

                if root.shown == "import-instances" : SlideTransition {
                    phase: root.leaving ? "leave" : root.arrive-phase;
                    direction: root.direction;
                    SetupImportInstances { }
                }
            }
        }
    }

    // The wizard's phases, in order. The storage step is dropped once storage has
    // been answered, so a wizard reopened from Settings does not ask again.
    private property <[string]> phases:
        SetupWizardState.storage-configured
        ? [
            "language",
            "palette",
            "add-account",
            "java-settings",
            "launch-options",
            "import-instances",
        ]
        : [
            "language",
            "storage",
            "palette",
            "add-account",
            "java-settings",
            "launch-options",
            "import-instances",
        ];

    /// The step the user asked for, written by `goto-step` and read by the
    /// swap and by the button labels.
    private property <int> wanted: 0;
    /// The step actually mounted — one 80ms beat behind `wanted`.
    private property <string> shown: "";
    private property <string> direction: "left";
    private property <bool> leaving: false;
    private property <bool> leave-armed: false;
    private property <bool> enter-armed: false;
    private property <string> arrive-phase: "shown";

    /// The "Next" button's label, which moves with the request and not with the
    /// 80ms beat.
    // Keyed on the *next* phase's name rather than its index, because the
    // storage step's presence shifts every index after it.
    out property <string> next-label:
        root.wanted == 0 ? @tr("SetupView" => "Let's get started!")
        : root.wanted >= root.phases.length - 1 ? @tr("SetupView" => "Finish")
        : root.phases[root.wanted + 1] == "palette" ? @tr("SetupView" => "Next (Color scheme)")
        : root.phases[root.wanted + 1] == "add-account" ? @tr("SetupView" => "Next (Add account)")
        : root.phases[root.wanted + 1] == "java-settings" ? @tr("SetupView" => "Next (Java settings)")
        : root.phases[root.wanted + 1] == "launch-options" ? @tr("SetupView" => "Next (Launch options)")
        : root.phases[root.wanted + 1] == "import-instances" ? @tr("SetupView" => "Next (Import instances)")
        : @tr("SetupView" => "Next");

    // The page stack rebuilds this view on every navigation to it, so the first
    // step is simply mounted.
    init => {
        root.shown = root.phases[0];
    }

    // The out-in beat: the mounted step plays its 80ms leave, and the one the
    // user asked for is mounted when that is over — at its enter rest, moving
    // to "shown" a frame later, since an element created and finished in the
    // same frame has nothing to animate from.
    leave-timer := Timer {
        interval: 80ms;
        running: root.leave-armed;
        triggered => {
            root.leave-armed = false;
            root.leaving = false;
            if root.phases[root.wanted] != root.shown {
                root.shown = root.phases[root.wanted];
                root.arrive-phase = "enter";
                root.enter-armed = true;
            }
        }
    }

    enter-timer := Timer {
        interval: 16ms;
        running: root.enter-armed;
        triggered => {
            root.enter-armed = false;
            root.arrive-phase = "shown";
        }
    }

    /// Tears down what the add-account step embeds, if it is the one on show.
    ///
    /// The step mounts the add-account dialog body, and that body is torn down
    /// by unmounting it — Slint has no unmount hook. In the dialog the body's
    /// "Cancel" button does this teardown, but the wizard hides that button,
    /// so leaving the step (or closing the wizard from it) is the only moment
    /// left. Without it the browser flow's loopback listener would outlive the
    /// screen for its ten-minute timeout, and a later visit to the step would
    /// find `prepare-auth-code-flow` a no-op over the stale listener and the
    /// login link empty again. `close` is the dialog's own teardown — cancel
    /// the login, free the listener — and its `account-add-visible` write is a
    /// no-op here. See `AccountAddState.close`.
    function close-add-account-host() {
        if root.shown == "add-account" {
            AccountAddState.close();
        }
    }

    function goto-step(index: int, towards-left: bool) {
        if index < 0 || index >= root.phases.length || index == root.wanted {
            return;
        }
        root.close-add-account-host();
        // The direction follows the way the index moves.
        root.direction = towards-left ? "left" : "right";
        root.wanted = index;
        if root.shown == "" {
            root.shown = root.phases[index];
            return;
        }
        root.leaving = true;
        root.leave-armed = true;
        leave-timer.restart();
    }

    // The bar has no backdrop blur, so the content scrolling under it shows
    // through unblurred (Slint 1.18 has no backdrop blur, like the game view's
    // toolbar and footer). It is pinned to the bottom of the *window*; the
    // wizard fills everything below the title bar, so that is the same place.
    footer := Rectangle {
        x: 0px;
        y: root.motion == "shown" ? root.height - self.height : root.height - self.height + 100px;
        width: 100%;
        height: 48px;
        background: Theme.surface-0.with-alpha(0.6);
        // Entrance: up 0.09s in, after the header and card. Exit: back down
        // first of the three, over 0.15s — the reverse order.
        animate y {
            duration: root.motion == "leave" ? 150ms : 330ms;
            delay: root.motion == "leave" ? 0ms : 90ms;
            easing: cubic-bezier(0.215, 0.61, 0.355, 1);
        }

        // The buttons are 40px tall in a 16px-tall content box, pulled up 24px,
        // so they sit 8px above the bar and stop 16px short of its bottom edge.
        // The bar is a plain `Rectangle` rather than a layout, so that is said
        // with the numbers rather than with a padding.
        row := HorizontalLayout {
            x: 16px;
            y: 16px - 24px;
            width: parent.width - 32px;
            height: 40px;
            spacing: 32px;

            FooterButton {
                horizontal-stretch: 0;
                width: 200px;
                text: @tr("SetupView" => "Back");
                show-icon: true;
                disabled: root.wanted == 0;
                clicked => { root.goto-step(root.wanted - 1, false); }
            }

            FooterButton {
                fill: Theme.mauve;
                text: root.next-label;
                clicked => {
                    if root.wanted < root.phases.length - 1 {
                        root.goto-step(root.wanted + 1, true);
                    } else {
                        // The last step: commit the storage choice and the
                        // "setup done" flag, then leave for the game view.
                        SetupWizardState.finish();
                        Navigation.navigate("game");
                    }
                }
            }
        }
    }
}
