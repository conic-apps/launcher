import { Theme } from "../theme.slint";
import { AppIcon } from "../components/display/app-icon.slint";
import { ScrollView } from "../components/containers/scroll-view.slint";
import { FocusManager } from "../globals/focus.slint";
import { PageMotion } from "../globals/page-motion.slint";
import { SettingsGeneral } from "settings/settings-general.slint";
import { SettingsGame } from "settings/settings-game.slint";
import { SettingsJvm } from "settings/settings-jvm.slint";
import { SettingsAppearance } from "settings/settings-appearance.slint";
import { SettingsAudio } from "settings/settings-audio.slint";
import { SettingsDownload } from "settings/settings-download.slint";
import { SettingsAccessibility } from "settings/settings-accessibility.slint";
import { SettingsAbout } from "settings/settings-about.slint";

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active: false;
    callback selected;

    width: 100%;
    height: 30px;
    border-radius: 8px;
    background: touch.pressed ? Theme.surface-1.transparentize(0.2)
        : root.active ? Theme.surface-1.transparentize(0.2)
        : touch.has-hover ? Theme.surface-0.transparentize(0.2)
        : transparent;

    Rectangle {
        x: -6px;
        width: 3px;
        height: root.active ? 22px : 0px;
        border-radius: 9999px;
        background: Theme.mauve;
        opacity: root.active ? 1.0 : 0.0;
        animate height, opacity { duration: 100ms; easing: ease; }
    }

    HorizontalLayout {
        padding-left: 10px;
        spacing: 8px;
        cross-axis-alignment: center;

        AppIcon {
            name: root.icon;
            size: 16px;
            icon-color: Theme.default-text-color.transparentize(0.1);
        }

        Text {
            text: root.label;
            font-size: 13px;
            font-weight: Theme.font-weight-normal;
            color: Theme.default-text-color.transparentize(0.1);
        }
    }

    touch := TouchArea {
        clicked => {
            FocusManager.clear();
            root.selected();
        }
    }
}

component SettingsSection inherits VerticalLayout {
    in property <string> title;

    width: 100%;
    spacing: 18px;
    alignment: start;

    Rectangle {
        height: 18px;
        background: transparent;

        Text {
            text: root.title;
            x: 8px;
            font-size: 18px;
            font-weight: Theme.font-weight-normal;
            // Full opacity, unlike the dimmed body text.
            color: Theme.text;
        }
    }

    @children
}

export component SettingsView inherits Rectangle {
    width: 100%;
    height: 100%;

    private property <string> motion: PageMotion.phase("settings");

    // The tint fades on the content's own beat, so the whole page — backdrop
    // included — comes and goes as one rather than the content sliding over an
    // already-present tint. `transparentize(1.0)` is the fully transparent end,
    // the same colour at alpha 0.
    background: Theme.base.transparentize(root.motion == "shown" ? 0.4 : 1.0);
    animate background { duration: 250ms; easing: cubic-bezier(0, 0.65, 0.26, 1); }

    private property <length> intro-offset: 40px;

    // Background click layer: clicking empty space (page padding, section
    // titles, gaps between rows) blurs the focused text field. Controls and rows
    // declare their own touch areas on top and handle the click themselves.
    TouchArea {
        clicked => { FocusManager.clear(); }
    }

    // The page's content: it slides up from `intro-offset` below and fades in,
    // and fades out in place, on the tint's beat above.
    HorizontalLayout {
        y: root.motion == "enter" ? root.intro-offset : 0px;
        opacity: root.motion == "shown" ? 1.0 : 0.0;
        animate opacity, y { duration: 250ms; easing: cubic-bezier(0, 0.65, 0.26, 1); }

        Rectangle {
            width: 224px;
            height: 100%;
            background: transparent;

            VerticalLayout {
                padding-top: 28px;
                padding-left: 32px;
                padding-bottom: 16px;
                spacing: 4px;
                alignment: start;

                NavItem { icon: "house"; label: @tr("General"); active: root.active-index == 0; selected => { root.scroll-to(0); } }
                NavItem { icon: "gamepad"; label: @tr("Launch"); active: root.active-index == 1; selected => { root.scroll-to(1); } }
                NavItem { icon: "java"; label: @tr("Java"); active: root.active-index == 2; selected => { root.scroll-to(2); } }
                NavItem { icon: "palette"; label: @tr("Appearance"); active: root.active-index == 3; selected => { root.scroll-to(3); } }
                NavItem { icon: "musical-notes"; label: @tr("Audio"); active: root.active-index == 4; selected => { root.scroll-to(4); } }
                NavItem { icon: "globe"; label: @tr("Download"); active: root.active-index == 5; selected => { root.scroll-to(5); } }
                NavItem { icon: "accessibility"; label: @tr("Accessibility"); active: root.active-index == 6; selected => { root.scroll-to(6); } }
                NavItem { icon: "about"; label: @tr("About"); active: root.active-index == 7; selected => { root.scroll-to(7); } }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 100%;
            background: transparent;

            scroll := ScrollView {
                // Named to stay clear of `ScrollView`'s own layout, which these
                // children are inlined into (`content-column` here, `content-layout`
                // there).
                content-column := VerticalLayout {
                    padding-top: 24px;
                    padding-right: 24px;
                    padding-bottom: 24px;
                    padding-left: 16px;
                    spacing: 24px;
                    alignment: start;

                    s0 := SettingsSection { title: @tr("General"); SettingsGeneral { } }
                    s1 := SettingsSection { title: @tr("Launch"); SettingsGame { } }
                    s2 := SettingsSection { title: @tr("Java"); SettingsJvm { } }
                    s3 := SettingsSection { title: @tr("Appearance"); SettingsAppearance { } }
                    s4 := SettingsSection { title: @tr("Audio"); SettingsAudio { } }
                    s5 := SettingsSection { title: @tr("Download"); SettingsDownload { } }
                    s6 := SettingsSection { title: @tr("Accessibility"); SettingsAccessibility { } }
                    s7 := SettingsSection { title: @tr("About"); SettingsAbout { } }
                }
            }
        }
    }

    // Scroll-spy: the last section whose top has crossed 100px below the
    // viewport top is active; at the very bottom the last section wins.
    private property <length> vp: scroll.content-y;
    private property <length> max-scroll: max(0px, scroll.content-height - scroll.height);
    private property <bool> at-bottom: root.max-scroll > 0px && -root.vp >= root.max-scroll - 1px;
    private property <int> active-index:
        root.at-bottom ? 7
        : s7.y + root.vp <= 100px ? 7
        : s6.y + root.vp <= 100px ? 6
        : s5.y + root.vp <= 100px ? 5
        : s4.y + root.vp <= 100px ? 4
        : s3.y + root.vp <= 100px ? 3
        : s2.y + root.vp <= 100px ? 2
        : s1.y + root.vp <= 100px ? 1
        : 0;

    // The `true` asks for a smooth scroll, which the `ScrollView` glides
    // through its lerp.
    public function scroll-to(index: int) {
        if index == 0 { scroll.scroll-to(16px - s0.y, true); }
        if index == 1 { scroll.scroll-to(16px - s1.y, true); }
        if index == 2 { scroll.scroll-to(16px - s2.y, true); }
        if index == 3 { scroll.scroll-to(16px - s3.y, true); }
        if index == 4 { scroll.scroll-to(16px - s4.y, true); }
        if index == 5 { scroll.scroll-to(16px - s5.y, true); }
        if index == 6 { scroll.scroll-to(16px - s6.y, true); }
        if index == 7 { scroll.scroll-to(16px - s7.y, true); }
    }
}
