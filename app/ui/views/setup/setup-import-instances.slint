import { Theme } from "../../theme.slint";
import { SetupWizardState } from "../../globals/setup.slint";
import { WizardTitle, WizardMessage } from "wizard-text.slint";

// One of the three `.import-instances button`s: 240x36, `--ctp-lavender`, a
// `--ctp-text-inverse` label, and a white wash on top of the fill for the hover
// and the press (`linear-gradient(#ffffff2f, #ffffff2f)` and `#ffffff6f`).
//
// The wash is drawn rather than mixed into the fill so the `error` variant can
// still repaint the button underneath it — the Vue's `background` and
// `background-image` are two properties, and one inline rule over the other.
component ImportButton inherits Rectangle {
    in property <string> text;
    /// `&.error { background: var(--ctp-red) }`, over the lavender.
    in property <bool> error: false;
    /// `&.creating, &.error { opacity: 0.7; pointer-events: none }`.
    in property <bool> inactive: false;
    callback clicked;

    width: 240px;
    height: 36px;
    border-radius: 8px;
    background: root.error ? Theme.red : Theme.lavender;
    opacity: root.inactive ? 0.7 : 1.0;

    // The hover and press washes, which the Vue draws as a `background-image`
    // layer *over* the `background` colour: `#ffffff2f` is white at 18% and
    // `#ffffff6f` at 43%. A separate element rather than a mixed colour, since
    // the error variant still repaints the button underneath it.
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: touch.pressed ? #ffffff6f : touch.has-hover ? #ffffff2f : #ffffff00;
        animate background { duration: 100ms; easing: ease; }
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.text;
        vertical-alignment: center;
        horizontal-alignment: center;
        font-size: 12px;
        font-weight: Theme.font-weight-normal;
        color: Theme.text-inverse;
    }

    touch := TouchArea {
        enabled: !root.inactive;
        clicked => { root.clicked(); }
    }
}

// src/views/setup/SetupWizardImportInstances.vue
//
// Two of the three buttons do nothing in the Vue: `.import-from-other-launcher`
// has no `@click` at all, so importing from another launcher is a button the
// original never wired up. It is ported as the dead button it is rather than
// left out, so the screen still looks the way it does.
export component SetupImportInstances inherits VerticalLayout {
    width: 100%;
    spacing: 0px;
    alignment: start;

    WizardTitle { title: @tr("SetupImportInstances" => "Import instances"); }

    WizardMessage { message: @tr("SetupImportInstances" => "Import previously played instances from other launchers to get started quickly"); }

    // `<div style="width: 100%; display: flex; justify-content: center; margin:
    // 12px 0">` — the margins are split into the two spacers around the row,
    // since a layout has none.
    Rectangle {
        width: 100%;
        height: 12px;
        background: transparent;
    }

    HorizontalLayout {
        width: 100%;
        alignment: center;

        ImportButton {
            text: @tr("SetupImportInstances" => "Import instances");
        }
    }

    Rectangle {
        width: 100%;
        height: 12px;
        background: transparent;
    }

    WizardMessage { message: @tr("SetupImportInstances" => "If you're new to Minecraft, you can also create a blank instance with the latest version right away"); }

    Rectangle {
        width: 100%;
        height: 12px;
        background: transparent;
    }

    // `<div style="width: 100%; display: flex; justify-content: center; gap:
    // 16px; margin: 12px 0">`.
    HorizontalLayout {
        width: 100%;
        alignment: center;
        spacing: 16px;

        ImportButton {
            text: SetupWizardState.release-error
                ? @tr("SetupImportInstances" => "An error occurred")
                : SetupWizardState.creating-release
                ? @tr("SetupImportInstances" => "Creating...")
                : SetupWizardState.created-release != ""
                ? SetupWizardState.created-release
                : @tr("SetupImportInstances" => "Create instance with latest release");
            error: SetupWizardState.release-error;
            inactive: SetupWizardState.creating-release || SetupWizardState.release-error;
            clicked => { SetupWizardState.create-latest-release(); }
        }

        ImportButton {
            text: SetupWizardState.snapshot-error
                ? @tr("SetupImportInstances" => "An error occurred")
                : SetupWizardState.creating-snapshot
                ? @tr("SetupImportInstances" => "Creating...")
                : SetupWizardState.created-snapshot != ""
                ? SetupWizardState.created-snapshot
                : @tr("SetupImportInstances" => "Create instance with latest snapshot");
            error: SetupWizardState.snapshot-error;
            inactive: SetupWizardState.creating-snapshot || SetupWizardState.snapshot-error;
            clicked => { SetupWizardState.create-latest-snapshot(); }
        }
    }

    Rectangle {
        width: 100%;
        height: 12px;
        background: transparent;
    }
}
