import { Theme } from "../../theme.slint";
import { SettingGroup } from "../../components/setting-group.slint";
import { SettingItem } from "../../components/setting-item.slint";
import { BaseSwitch } from "../../components/base-switch.slint";
import { PaletteRow } from "../../components/palette-row.slint";
import { AppConfig } from "../../globals/settings.slint";
import { WizardTitle, WizardMessage } from "wizard-text.slint";

// The same group the appearance settings open with — one `SettingItem` with a
// switch, then the four palette tiles — without the group's title, and at full
// width.
//
// The palette change itself needs nothing here: `Theme.active-palette` already
// resolves "follow system" to Mocha or Latte, and the tiles arm the 300ms
// palette transition themselves (see `PaletteRow`).
export component SetupPalette inherits VerticalLayout {
    width: 100%;
    spacing: 0px;
    alignment: start;

    WizardTitle { title: @tr("SetupPalette" => "Choose a color scheme"); }
    WizardMessage { message: @tr("SetupPalette" => "Conic Launcher supports multiple color schemes. Pick one that suits your style."); }

    // A 16px top margin before the group.
    VerticalLayout {
        width: 100%;
        padding-top: 16px;
        spacing: 0px;
        alignment: start;

        SettingGroup {
            // Full width: the wizard's column is already inset by the body's own
            // 36px.
            width: 100%;

            SettingItem {
                group-first: true;
                title: @tr("SetupPalette" => "Follow system dark mode");
                description: @tr("SetupPalette" => "Uses Latte when the system is set to light mode, otherwise uses Mocha");
                icon: "moon";
            icon-outline: true;

                BaseSwitch {
                    checked <=> AppConfig.palette-follow-system;
                    // Arms the palette transition, which is what makes a change
                    // a *user* change (see `Theme.transitions-enabled`).
                    toggled => {
                        Theme.transitions-enabled = true;
                        AppConfig.changed();
                    }
                }
            }

            PaletteRow {
                selected: Theme.active-palette;
                swatches-disabled: AppConfig.palette-follow-system;
            }
        }
    }
}
