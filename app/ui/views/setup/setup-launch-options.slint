import { SettingsGame } from "../settings/settings-game.slint";
import { WizardTitle, WizardMessage } from "wizard-text.slint";

// The settings page's launch section with the wizard's two overrides on top: the
// groups run the body's full width rather than the settings page's, and the
// section carries a 16px top margin.
export component SetupLaunchOptions inherits VerticalLayout {
    width: 100%;
    spacing: 0px;
    alignment: start;

    WizardTitle { title: @tr("SetupLaunchOptions" => "Game launch options"); }

    WizardMessage {
        message: @tr("SetupLaunchOptions" => "Here are some basic launch options. You can change more options later in Settings and instance-specific settings.");
    }

    Rectangle {
        width: 100%;
        height: 16px;
        background: transparent;
    }

    SettingsGame {
        // The wizard drops the settings page's inset.
        group-inset: 0px;
    }
}
