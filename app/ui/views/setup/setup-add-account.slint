import { Theme } from "../../theme.slint";
import { AccountAvatar } from "../../components/display/account-avatar.slint";
import { AccountAdd } from "../../overlays/dialogs/account-add/account-add.slint";
import { GameState } from "../../globals/game.slint";
import { WizardTitle, WizardMessage } from "wizard-text.slint";

// The screen is one of two: no account yet, so the add-account body fills it; an
// account, so the profile card the wizard promises to have made the default.
//
// `GameState` holds the account the game view already has: Rust owns it, and a
// finished add-account writes the config and then asks that view to reload, so
// the card appears on its own once the sign-in is through.
export component SetupAddAccount inherits VerticalLayout {
    width: 100%;
    spacing: 0px;
    alignment: start;
    // Both paragraphs below are full width, so the centring is only visible on
    // the card.
    cross-axis-alignment: center;

    if !GameState.has-account : AccountAdd {
        content-width: root.width;
        // The wizard's own padding is the dialog's 8px, and the wizard's
        // close/next buttons replace the hidden "Cancel" ones — see
        // `AccountAdd`.
        wizard-host: true;
    }

    if GameState.has-account : WizardTitle {
        title: @tr("SetupAddAccount" => "Account added!");
    }

    if GameState.has-account : WizardMessage {
        width: 100%;
        message: @tr("SetupAddAccount" => "The following profile has been set as default. The launcher will use this profile to log in to the game when no profile is assigned to an instance");
    }

    // The card uses the raw surface0, not the setting-item background, which
    // Latte remaps onto its mantle.
    if GameState.has-account : Rectangle {
        width: 320px;
        height: card-rows.preferred-height + 48px;
        background: Theme.surface-0;
        border-radius: 12px;

        card-rows := VerticalLayout {
            x: 24px;
            y: 24px;
            width: parent.width - 48px;
            alignment: start;
            spacing: 0px;

            // The 56px head, centred by the card.
            //
            // A drop shadow is **not** drawn: Slint's `drop-shadow-*` follows the
            // element's *box*, so on a round avatar it puts a square 56x56 shadow
            // behind a circle — worse than no shadow at all. There is no way to
            // soften a shape Slint has no mask for, so the shadow is dropped.
            Rectangle {
                width: 100%;
                height: 56px;
                background: transparent;

                AccountAvatar {
                    x: (parent.width - self.width) / 2;
                    y: 0px;
                    size: 56px;
                    kind: GameState.current-account-kind;
                    skin: GameState.current-account-avatar;
                }
            }

            // The name's 16px top margin as a spacer, which a layout has none
            // of.
            Rectangle {
                width: 100%;
                height: 16px;
                background: transparent;
            }

            Text {
                width: 100%;
                text: GameState.current-account-name;
                font-size: 16px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
                horizontal-alignment: center;
            }

            // The profile type's 8px top margin as a spacer.
            Rectangle {
                width: 100%;
                height: 8px;
                background: transparent;
            }

            Text {
                width: 100%;
                text: GameState.current-account-kind == "Microsoft"
                    ? @tr("SetupAddAccount" => "Microsoft (Official account)")
                    : GameState.current-account-kind == "Yggdrasil"
                    ? @tr("SetupAddAccount" => "Yggdrasil (External login)")
                    : @tr("SetupAddAccount" => "No auth service (Offline account)");
                font-size: 13px;
                font-weight: Theme.font-weight-normal;
                // `&.microsoft { color: green } &.yggdrasil { color: yellow }
                // &.offline { color: red }` — the same three colours
                // `AccountAvatar` rings a head with.
                color: GameState.current-account-kind == "Microsoft" ? Theme.green
                    : GameState.current-account-kind == "Yggdrasil" ? Theme.yellow
                    : Theme.red;
                horizontal-alignment: center;
            }
        }
    }

    // A 24px spacer after the card, which a layout has no margin for. It is a
    // sibling `Rectangle` rather than part of the card.
    if GameState.has-account : Rectangle {
        width: 0px;
        height: 24px;
        background: transparent;
    }
}
