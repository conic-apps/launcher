import { GameIntro } from "../globals/game.slint";
import { InstanceSummary } from "game/instance-summary.slint";
import { InstancesList } from "game/instances-list.slint";
import { GameFooterBar } from "game/footer.slint";
import { InstanceSettingsRoot } from "../overlays/instance-settings.slint";
import { ContentRoot } from "../overlays/content/content-root.slint";

// The game screen: current-instance summary on the left, the grouped instance
// list on the right and the footer bar beneath. The click-to-open content
// overlays live in ContentRoot.
export component GameView inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    // The screen is recreated on every navigation to it (the page stack uses a
    // conditional), so the intro replays on every visit.
    init => {
        GameIntro.played = false;
    }

    // The intro is a single beat: once the first frame has been rendered, centre
    // the current instance without animating (so the list opens on the selected
    // instance rather than gliding to it) and then play every intro at once by
    // flipping the shared flag — each element's `animate` carries its own delay,
    // which is how the timeline positions are reproduced.
    intro-timer := Timer {
        interval: 50ms;
        running: true;
        triggered => {
            instance-list.scroll-to-current(false);
            // The entrance is ordered against the window the list settled on, so
            // the list has to be told where that is *after* the centring and
            // before the flag flips — otherwise the cards stagger from the top of
            // the whole list and a list opened on its last instance has every
            // visible card waiting the same step.
            instance-list.begin-intro();
            GameIntro.played = true;
            intro-timer.running = false;
        }
    }

    instance-summary := InstanceSummary {
        x: 48px;
        y: parent.height * 45 / 100 - self.height / 2;
    }

    instance-list := InstancesList {
        y: 0;
        x: parent.width - self.width + 320px;
    }

    GameFooterBar {
        y: parent.height - self.height;
    }

    // The instance settings overlay. Declared before `ContentRoot` because it
    // paints first, and their order is what decides which of the two is on top
    // when both are open.
    InstanceSettingsRoot { }

    // The content overlays. Mounted here rather than at the app root so the
    // panels sit below the title bar and only exist on the game screen.
    ContentRoot { }
}
