import { SettingGroup } from "../../components/settings/setting-group.slint";
import { SettingItem } from "../../components/settings/setting-item.slint";
import { Switch } from "../../components/controls/switch.slint";
import { AppConfig } from "../../globals/settings.slint";
import { Theme } from "../../theme.slint";

export component SettingsAccessibility inherits VerticalLayout {
    width: 100%;
    padding-left: 8px;
    padding-right: 8px;
    spacing: 16px;
    alignment: start;

    SettingGroup {
        title: @tr("Accessibility");

        SettingItem {
            group-first: true;
            title: @tr("Release update reminder");
            description: @tr("Show a reminder dialog when a Minecraft release is published");

            Switch {
                checked <=> AppConfig.release-reminder;
                toggled => { AppConfig.changed(); }
            }
        }

        SettingItem {
            title: @tr("Snapshot update reminder");
            description: @tr("Show a reminder dialog when a Minecraft snapshot is published");

            Switch {
                checked <=> AppConfig.snapshot-reminder;
                toggled => { AppConfig.changed(); }
            }
        }

        SettingItem {
            group-last: true;
            title: @tr("Auto-change game language");
            description: @tr("Set the game language to your launcher language on first launch");

            Switch {
                checked <=> AppConfig.auto-game-lang;
                toggled => { AppConfig.changed(); }
            }
        }
    }

    SettingGroup {
        title: "无障碍";

        SettingItem {
            group-first: true;
            group-last: true;
            title: @tr("High contrast mode");
            description: @tr("Enable high contrast mode for the current theme (if available)");
            icon: "contrast";

            Switch {
                checked <=> AppConfig.high-contrast;
                // Swaps the semantic tokens like a palette change does, so it
                // animates the same way (see `Theme.transitions-enabled`).
                //
                // As in the palette row, `Switch` writes `checked` through
                // the two-way binding first; the tokens are only evaluated from
                // the event loop's change handlers, so arming here in `toggled`
                // is early enough.
                toggled => {
                    Theme.transitions-enabled = true;
                    AppConfig.changed();
                }
            }
        }
    }
}
