import { Theme } from "../../theme.slint";

// A rounded info card. Currently unused.
export component InfoBox inherits Rectangle {
    in property <bool> click-able: false;

    width: 100%;
    background: Theme.card-background;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        padding: 20px;
        alignment: start;
        @children
    }
}
