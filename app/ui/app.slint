import { Theme, ThemeProvider } from "theme.slint";
import { TitleBar, WindowControl } from "components/title-bar.slint";
import { AppConfig } from "globals/settings.slint";
import { CommandPaletteState } from "globals/command-palette.slint";
import { Navigation } from "globals/navigation.slint";
import { Dialogs } from "globals/dialogs.slint";
import { DropdownOverlay } from "overlays/dropdown-overlay.slint";
import { DescriptionTooltipOverlay } from "overlays/description-tooltip.slint";
import { DialogRoot } from "overlays/dialog-root.slint";
import { CommandPaletteOverlay } from "overlays/command-palette.slint";
import { MusicPlayerOverlay } from "overlays/music-player.slint";
import { WindowDrag } from "globals/window-drag.slint";
import { WindowBackground } from "components/display/window-background.slint";
import { SettingsView } from "views/settings-view.slint";
import { GameView } from "views/game-view.slint";
import { LaunchView } from "views/launch-view.slint";
import { SetupView } from "views/setup-view.slint";
import { TodoPlaceholder } from "views/todo-placeholder.slint";

// Re-export so the Rust side can access the globals and build the Java runtime
// model (`slint_backend::AppConfig` / `slint_backend::JavaRuntime` /
// `slint_backend::GameState`).
export { AppConfig, JavaRuntime } from "globals/settings.slint";
export { Navigation } from "globals/navigation.slint";
export { GameState, GameRow, AccountItem } from "globals/game.slint";
export { LaunchState } from "globals/launch.slint";
export { ScrollInput, ScrollSource } from "globals/scroll.slint";
export { AvatarMask } from "globals/avatar.slint";
export { Dialogs, CreateInstanceState, MinecraftVersionItem, AccountAddState, YggdrasilProfileItem, DeleteInstanceState, DeleteSaveState, DeleteAccountState } from "globals/dialogs.slint";
export { WindowDrag } from "globals/window-drag.slint";
export { MultiplayerState, MultiplayerPlayer, MultiplayerPeer } from "globals/multiplayer.slint";
export { WindowControl } from "components/title-bar.slint";
export { Background } from "globals/background.slint";
export { ContentState, ContentSearch, ContentCard, CardTag, FilterChip, FilterRow, PageButton } from "globals/content.slint";
export { MusicState, MusicTrack } from "globals/music.slint";
export { CommandPaletteState, PaletteItem } from "globals/command-palette.slint";
export { InstanceSettingsState } from "globals/instance-settings.slint";
export { AccountViewState, AccountDay, AccountMonthLabel, AccountActivity } from "globals/account-view.slint";
export { SetupWizardState } from "globals/setup.slint";
export { WorldMapState, WorldSource, WorldTile } from "globals/worldmap.slint";

// Application root window. macOS keeps the native traffic lights, Linux draws
// the window controls itself, and Windows draws the platform's own over the
// title bar (`app/src/support/native/windows/caption.rs`) — neither of the last two leaves a
// system title bar behind.
export component App inherits Window {
    title: @tr("Conic Launcher");
    // Window/taskbar icon for Windows and Linux WMs (see the shared asset). macOS
    // is handled separately (`native/macos/dock_icon.rs`): winit's window icon
    // path is a no-op there.
    icon: @image-url("assets/images/app-icon.png");
    // Base typography, whose tokens live in `theme.slint`.
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size-base;
    default-font-weight: Theme.font-weight-normal;
    // macOS blends its native title bar into the client area; Linux leaves the
    // corners transparent for the rounded, frameless window. Windows stays
    // opaque: its frame is DWM's, which rounds the window itself.
    background: self.macos || self.linux ? transparent : Theme.crust;
    // 840x532 is the floor, not a fixed size: fixed `width`/`height` on the
    // root Window pin min == max (making the window non-resizable), so the
    // intended size is expressed as the minimum + preferred size.
    min-width: 840px;
    min-height: 532px;
    preferred-width: 840px;
    preferred-height: 532px;
    // Linux has no window controls of its own, and Windows drops the caption so
    // that the platform's have the app's title bar to sit on (see
    // `app/src/support/native/windows/caption.rs`), so both draw over the whole window.
    no-frame: self.linux || self.windows;
    resize-border-width: (self.linux || self.windows) ? 6px : 0px;
    // The initial focus element, and the only thing that keeps the `Ctrl`/`⌘` + `/`
    // shortcut alive: a window with nothing focused discards its key events, so
    // the shortcut would work until the first click and never again. The scope
    // wraps the whole window so a key event from any focused field inside it —
    // a settings text input, the palette's own search box — reaches its binding
    // on the way up.
    forward-focus: app-scope;

    in-out property <bool> macos: false;
    in-out property <bool> linux: false;
    in-out property <bool> windows: false;
    /// The custom title bar's height. Declared here rather than in
    /// `title-bar.slint` because the platform sizes the window controls to it and
    /// hit tests them against it (see `app/src/support/native/windows/caption.rs`), so the two sides
    /// have to read the same number.
    in property <length> title-bar-height: 44px;
    /// How much of the title bar's right-hand end the platform's own window
    /// controls take, in logical units. Zero everywhere but Windows, where the
    /// platform measures it and pushes it in.
    in-out property <length> window-controls-inset: 0px;
    /// The platform's window controls, as the platform draws them. Empty until
    /// the window exists, which is also when the platform can be asked.
    in-out property <[WindowControl]> window-controls: [];
    /// Which control the pointer is on, and which is pressed, in the platform's
    /// own numbering (`WindowControl.index`). -1 is neither: the controls are
    /// non-client area, so the pointer is only ever reported through the system's
    /// own messages.
    in-out property <int> window-control-hovered: -1;
    in-out property <int> window-control-pressed: -1;
    /// Whether the window is in native fullscreen — a *state* pushed from the
    /// platform (`native/macos/traffic_lights.rs`), not a request: to change it, use the
    /// `WindowService`. macOS hides the traffic lights in fullscreen, and the
    /// title bar stops leaving room for them there. False elsewhere.
    in-out property <bool> window-fullscreen: false;
    in-out property <string> search-placeholder: @tr("Search or type a command…");
    in-out property <string> search-hotkey: "";

    // Closing while a task is running asks first
    // (`Dialogs.confirm-quit-app-visible`); the confirm then plays a 250ms
    // `scale(0.93)` plus fade and closes the window 500ms later. Both halves live
    // here: the scale and the fade are the container's own `transform-scale` and
    // `opacity` about its centre, and the wait is the timer.
    //
    // A close on any other page never gets here — the title bar's close button
    // closes the window outright.
    private property <bool> quitting: false;
    private property <float> quit-alpha: root.quitting ? 0.0 : 1.0;
    private property <float> quit-scale: root.quitting ? 93% : 100%;
    animate quit-alpha, quit-scale {
        duration: 250ms;
        easing: cubic-bezier(0, 0.74, 0.65, 1);
    }

    quit-timer := Timer {
        // Waits out the transition, then as much again before closing.
        interval: 500ms;
        running: root.quitting;
        triggered => { root.close(); }
    }

    function quit() {
        root.quitting = true;
    }

    // The page-swap lifecycle. `navigate`/`back` set `transition-stage` to
    // "starting" on the same beat as `current-page`; these two timers advance
    // it. One 16ms beat holds a view at its start values so the renderer has
    // seen them before its animation retargets them — Slint has no timeline, and
    // a property only moves while something reads it.
    page-settle-timer := Timer {
        interval: 16ms;
        running: Navigation.transition-stage == "starting";
        triggered => { Navigation.transition-stage = "running"; }
    }

    // The swap is at most the 250ms any view's exit is allowed. When it is over
    // `leaving-page` clears, so a kept-mounted view (the wizard) unmounts.
    page-run-timer := Timer {
        interval: 250ms;
        running: Navigation.transition-stage == "running";
        triggered => {
            Navigation.transition-stage = "idle";
            Navigation.leaving-page = "";
        }
    }

    // The first page's view can animate in too: the wizard reads "starting" as
    // its entrance. `init` runs before the event loop, so the stage outlives
    // Rust's `set_current_page("setup")` and the settle timer starts on the
    // first frame.
    init => {
        if Navigation.transition-stage == "idle" {
            Navigation.transition-stage = "starting";
        }
    }

    callback toggle-music();
    callback maximize-or-fullscreen();
    callback minimize-window();
    callback close-window();
    /// Settings → Data storage asked for a restart after a location changed.
    callback restart-app();
    /// Tells the platform which theme the app resolved to, so the window controls
    /// it draws take their ink from this title bar. Answered on Windows
    /// (`app/src/support/native/windows/caption.rs`) and ignored everywhere else.
    callback set-caption-dark(dark: bool);

    // Drives the palette selection and animates the Theme tokens (see
    // theme.slint). Must exist exactly once.
    ThemeProvider {
        caption-dark-changed(dark) => { root.set-caption-dark(dark); }
    }

    // The window's key handler. Neither focus-on-click nor tab traversal is on:
    // a `FocusScope` covering the window would take every click in the app away
    // from the control under it, and it is only ever focused explicitly.
    app-scope := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        focus-on-tab-navigation: false;

        // Slint's `Control` is the command key on macOS and the control key
        // everywhere else, so one binding covers both platforms. (`Meta` is the
        // *other* one — the physical control key on macOS — which is the opposite
        // of what the name suggests.)
        //
        // The binding lives on the app scope rather than on the palette, which is
        // hidden most of the time and whose subtree a click outside never focuses.
        KeyBinding {
            keys: @keys(Control + "/");
            activated => { CommandPaletteState.toggle(); }
        }

        // The focus goes to the palette's search field while it is open and comes
        // back here when it closes, so the bindings above keep working: a window
        // with nothing focused discards its key events entirely.
        private property <bool> palette-open: CommandPaletteState.visible;
        changed palette-open => {
            if !palette-open {
                app-scope.focus();
            }
        }

        // The content layer stays full-size; the title bar owns the top row and
        // the platform owns the remaining window edge.
        container := Rectangle {
            width: root.width;
            height: root.height;
            // The quit animation: `scale(0.93)` and `opacity: 0`, over the
            // transition the confirm dialog starts. Both are on this one box
            // because it holds everything; the easing lives on the two root
            // properties they read, so it is written once.
            opacity: root.quit-alpha;
            transform-scale: root.quit-scale;
            // The window background: the palette's flat `crust`. The hyperbola sky
            // over it is only 30% opaque, so the base shows through and is part of
            // the picture.
            background: Theme.crust;
            border-radius: 16px;
            // A 1px hairline at 16% white. A Slint border is drawn inside the box
            // and does not inset its children, so only the hairline is reproduced,
            // not the 1px inset.
            border-width: 1px;
            border-color: #ffffff.with-alpha(0.16);
            clip: true;

            // Behind every page and every overlay.
            WindowBackground { }

            VerticalLayout {
                width: root.width;
                height: root.height;

                TitleBar {
                    macos: root.macos;
                    linux: root.linux;
                    windows: root.windows;
                    fullscreen: root.window-fullscreen;
                    height: root.title-bar-height;
                    window-controls-inset: root.window-controls-inset;
                    window-controls: root.window-controls;
                    window-control-hovered: root.window-control-hovered;
                    window-control-pressed: root.window-control-pressed;
                    search-placeholder: root.search-placeholder;
                    search-hotkey: root.search-hotkey;
                    current-page: Navigation.current-page;
                    music-enabled: AppConfig.music-enabled;

                    // Navigation is global: the title bar drives it directly.
                    open-home => { Navigation.navigate("game"); }
                    open-settings => { Navigation.navigate("settings"); }
                    open-search => { CommandPaletteState.open(); }
                    toggle-music => { root.toggle-music(); }
                    maximize-or-fullscreen => { root.maximize-or-fullscreen(); }
                    minimize-window => { root.minimize-window(); }
                    // The launch page is the one where closing abandons a running
                    // task, so it asks first.
                    close-window => {
                        if Navigation.current-page == "launch" {
                            Dialogs.confirm-quit-app-visible = true;
                        } else {
                            root.close();
                        }
                    }
                }

                // Page stack. The account view is an overlay on the game screen
                // now, so `"accounts"` no longer names a page; the fallback
                // catches any page value with no screen of its own.
                //
                // Animated at the view, not here: a page that plays its own exit
                // keeps being mounted while `leaving-page` is set, so its elements
                // can run their `leave` phase. Pages without an exit swap on
                // `current-page` alone, instantly.
                page-stack := Rectangle {
                    width: 100%;
                    vertical-stretch: 1;
                    clip: true;

                    if Navigation.current-page == "settings" || Navigation.leaving-page == "settings" : SettingsView { }
                    if Navigation.current-page == "game" || Navigation.leaving-page == "game" : GameView { }
                    if Navigation.current-page == "launch" : LaunchView { }
                    if Navigation.current-page == "setup" || Navigation.leaving-page == "setup" : SetupView { }
                    if Navigation.current-page != "settings" && Navigation.current-page != "game" && Navigation.current-page != "launch" && Navigation.current-page != "setup" : TodoPlaceholder { }
                }
            }

            // Floating dropdown list + outside-click layer, mounted above the page
            // stack (see `DropdownOverlay`).
            //
            // The `z` is load-bearing. Mounting after `page-stack` only orders it
            // above the elements that carry no `z` of their own; the instance
            // list's toolbar (`z: 114`) and both scrollbars (`z: 500`) do, and
            // those are exactly what a toolbar dropdown opens over — at the
            // default 0 the panel is painted underneath the list it belongs to.
            DropdownOverlay {
                z: 1000;
            }

            // The description tooltip, on the same footing: it is taller than the row
            // it belongs to and both the settings collapse and the settings scroll
            // area clip, so it is drawn here and anchored to the description line
            // (see `overlays/description-tooltip.slint`).
            DescriptionTooltipOverlay { }

            // The background-music panel, mounted on the same layer and covering
            // everything below the title bar. It comes after the dropdowns and the
            // tooltip but before the dialogs. Its `top: 44px` is applied here,
            // where the title bar's height is known.
            MusicPlayerOverlay {
                y: root.title-bar-height;
                height: root.height - root.title-bar-height;
            }

            // The command palette, mounted between the music player and the dialog
            // layer.
            CommandPaletteOverlay { }

            // The dialog layer, mounted last so a dialog covers both the page and
            // the floating dropdown. It has to stay above the command palette and
            // the music player, so it carries an explicit `z` rather than relying
            // on declaration order.
            DialogRoot {
                z: 2000;
                confirm-quit => { root.quit(); }
                restart-app => { root.restart-app(); }
            }
        }
    }
}
