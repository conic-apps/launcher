{
    "productName": "conic-launcher",
    "version": "0.1.0-alpha.1",
    "identifier": "app.conicmc.launcher",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "macOSPrivateApi": true,
        "windows": [
            {
                "label": "main",
                "title": "Conic Launcher",
                "minWidth": 840,
                "minHeight": 532,
                "width": 840,
                "height": 532,
                "focus": true,
                "center": true,
                "transparent": true,
                "decorations": false,
                "fullscreen": false,
                "resizable": true,
                "shadow": false
            }
        ],
        "security": {
            "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https://cdn.modrinth.com https://media.forgecdn.net http://textures.minecraft.net https://textures.minecraft.net https://mod.mcimirror.top; style-src 'self' 'unsafe-inline'; navigate-to 'self';",
            "assetProtocol": {
                "enable": true,
                "scope": {
                    "allow": [
                        "**/*"
                    ]
                }
            }
        },
        "withGlobalTauri": true
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "createUpdaterArtifacts": true,
        "windows": {
            "wix": {
                "version": "0.1.0.1"
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3OENDNkQwMkM3RjUyREYKUldUZlVuOHMwTWFNcDBDU3pCaFFnRlEyL3ZWSHR2bm1wQzVYZTR4a1YzVUF4OTJmRFE3bWJqaXUK",
            "endpoints": [
                "https://brkdr.dpdns.org/v1/stable/{{target}}/{{arch}}/{{current_version}}"
            ]
        },
        "deep-link": {
            "desktop": {
                "schemes": [
                    "conic-launcher"
                ]
            }
        }
    }
}
