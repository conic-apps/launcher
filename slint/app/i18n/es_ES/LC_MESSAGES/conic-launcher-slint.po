msgstr " para iniciar sesión con tu navegador en su lugar."

#: ui
msgctxt "AccountAddMicrosoft"
msgid "Copied!"
msgstr "¡Copiado!"

#: ui
msgctxt "AccountAddMicrosoft"
msgid "Login link:"
msgstr "Enlace de inicio de sesión:"

#: ui
msgctxt "AccountAddMicrosoft"
msgid "Clicking \"Log in\" opens your browser to sign in. You can also "
msgstr "Al hacer clic en «Iniciar sesión» se abrirá tu navegador. También puedes "

#: ui
msgctxt "AccountAddMicrosoft"
msgid "copy the link"
msgstr "copiar el enlace"

#: ui
msgctxt "AccountAddMicrosoft"
msgid " and paste it into the browser. To finish signing in on another device, "
msgstr " y pegarlo en el navegador. Para terminar de iniciar sesión en otro dispositivo, "

#: ui
msgctxt "AccountAddMicrosoft"
msgid "use a device code"
msgstr "usar un código de dispositivo"

#: ui
msgctxt "AccountAddMicrosoft"
msgid " instead."
msgstr " en su lugar."

#: ui
msgctxt "AccountAddMicrosoft"
msgid "Log in"
msgstr "Iniciar sesión"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Sign in to a Minecraft account through a third-party Yggdrasil auth server — for skin sites, self-hosted auth servers and other unofficial account systems."
msgstr "Inicia sesión en una cuenta de Minecraft mediante un servidor de autenticación Yggdrasil de terceros: para sitios de skins, servidores propios y otros sistemas de cuentas no oficiales."

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Auth server address (API root)"
msgstr "Dirección del servidor de autenticación (API root)"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Auth service: {}"
msgstr "Servicio de autenticación: {}"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Password"
msgstr "Contraseña"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Verify and add profile"
msgstr "Verificar y añadir perfil"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Please wait"
msgstr "Espera un momento"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Back"
msgstr "Atrás"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "This account has more than one profile — choose the ones to add"
msgstr "Esta cuenta tiene varios perfiles: elige los que quieras añadir"

#: ui
msgctxt "AccountAddYggdrasil"
msgid " (added)"
msgstr " (añadido)"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Add profiles"
msgstr "Añadir perfiles"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "This account has no game profile"
msgstr "Esta cuenta no tiene ningún perfil de juego"

#: ui
msgctxt "AccountAddMicrosoft"
msgid "Cancel"
msgstr "Cancelar"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Cancel"
msgstr "Cancelar"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Username"
msgstr "Nombre de usuario"
