msgstr "Hintergrundbild"

#: ui
msgctxt "SettingsAppearance"
msgid "Custom background image"
msgstr "Eigenes Hintergrundbild"

#: ui
msgctxt "SettingsAppearance"
msgid "Select an image as the launcher background. Instance backgrounds take priority"
msgstr "Wähle ein Bild als Launcher-Hintergrund. Instanzhintergründe haben Vorrang"

