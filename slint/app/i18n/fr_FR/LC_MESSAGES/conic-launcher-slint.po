msgstr "Séparés par des points-virgules sous Windows, des deux-points sur les autres systèmes"

#: ui
msgctxt "SettingsGame"
msgid "Execute before launch"
msgstr "Exécuter avant le lancement"

#: ui
msgctxt "SettingsGame"
msgid "Added before the launch command"
msgstr "Ajouté avant la commande de lancement"

#: ui
msgctxt "SettingsGame"
msgid "Wrap command"
msgstr "Commande d'encapsulation"

