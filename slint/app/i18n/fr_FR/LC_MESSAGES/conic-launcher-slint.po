msgid "Accessibility"
msgstr "Accessibilité"

#: ui
msgctxt "SettingsAccessibility"
msgid "Release update reminder"
msgstr "Rappel des versions stables"

#: ui
msgctxt "SettingsAccessibility"
msgid "Show a reminder dialog when a Minecraft release is published"
msgstr "Affiche une boîte de dialogue de rappel lorsqu'une version stable de Minecraft est publiée"

#: ui
msgctxt "SettingsAccessibility"
msgid "Snapshot update reminder"
msgstr "Rappel des snapshots"

#: ui
msgctxt "SettingsAccessibility"
msgid "Show a reminder dialog when a Minecraft snapshot is published"
msgstr "Affiche une boîte de dialogue de rappel lorsqu'un snapshot de Minecraft est publié"

#: ui
msgctxt "SettingsAccessibility"
msgid "Auto-change game language"
msgstr "Langue du jeu automatique"

#: ui
msgctxt "SettingsAccessibility"
msgid "Set the game language to your launcher language on first launch"
msgstr "Définit la langue du jeu sur celle du lanceur au premier lancement"

#: ui
msgctxt "SettingsAccessibility"
msgid "High contrast mode"
msgstr "Mode contraste élevé"

#: ui
msgctxt "SettingsAccessibility"
msgid "Enable high contrast mode for the current theme (if available)"
msgstr "Active le mode contraste élevé pour le thème actuel (si disponible)"

#: ui
msgctxt "SettingsAppearance"
msgid "Palette"
msgstr "Palette"

#: ui
msgctxt "SettingsAppearance"
msgid "Follow system dark mode"
msgstr "Suivre le mode sombre du système"

#: ui
msgctxt "SettingsAppearance"
msgid "Uses Latte when the system is set to light mode, otherwise uses Mocha"
msgstr "Utilise Latte lorsque le système est en mode clair, sinon Mocha"

#: ui
msgctxt "SettingsAppearance"
msgid "Background image"
msgstr "Image de fond"

#: ui
msgctxt "SettingsAppearance"
msgid "Custom background image"
msgstr "Image de fond personnalisée"

#: ui
msgctxt "SettingsAppearance"
msgid "Select an image as the launcher background. Instance backgrounds take priority"
msgstr "Sélectionnez une image comme fond du lanceur. Les fonds définis par instance ont la priorité"

#: ui
msgctxt "SettingsAppearance"
msgid "Remove image"
msgstr "Supprimer l'image"

#: ui
msgctxt "SettingsAppearance"
msgid "Background image darkness"
msgstr "Assombrissement de l'image de fond"

#: ui
msgctxt "SettingsAppearance"
msgid "3D background camera movement"
msgstr "Mouvement 3D de la caméra du fond"

#: ui
msgctxt "SettingsAppearance"
msgid "When disabled, the camera stops moving forward and the background stops updating after rendering, completely eliminating background overhead"
msgstr "Lorsqu'il est désactivé, la caméra cesse d'avancer et le fond cesse d'être mis à jour après le rendu, éliminant totalement la charge liée au fond"

#: ui
msgctxt "SettingsAppearance"
msgid "Background parallax"
msgstr "Parallaxe du fond"

#: ui
msgctxt "SettingsAppearance"
msgid "When disabled, the background no longer moves with the mouse"
msgstr "Lorsqu'elle est désactivée, le fond ne bouge plus avec la souris"

#: ui
msgctxt "SettingsAudio"
msgid "Background music"
msgstr "Musique de fond"

#: ui
msgctxt "SettingsAudio"
msgid "Enable background music"
msgstr "Activer la musique de fond"

#: ui
msgctxt "SettingsAudio"
msgid "Play background music in the launcher."
msgstr "Joue de la musique de fond dans le lanceur."

#: ui
msgctxt "SettingsAudio"
msgid "Resume on start"
msgstr "Reprendre au démarrage"

#: ui
msgctxt "SettingsAudio"
msgid "Resume the last track and its progress when the application starts."
msgstr "Reprend la dernière piste et sa progression au démarrage de l'application."

#: ui
msgctxt "SettingsAudio"
msgid "Audio visualizer"
msgstr "Visualiseur audio"

#: ui
msgctxt "SettingsAudio"
msgid "Show audio visualization at the bottom of the game page."
msgstr "Affiche une visualisation audio en bas de la page de jeu."

#: ui
msgctxt "SettingsAudio"
msgid "Pause on game launch"
msgstr "Pause au lancement du jeu"

#: ui
msgctxt "SettingsAudio"
msgid "Automatically pause background music when the game finishes launching."
msgstr "Met automatiquement en pause la musique de fond lorsque le lancement du jeu est terminé."

#: ui
msgctxt "SettingsAudio"
msgid "Open music folder"
msgstr "Ouvrir le dossier de musique"

#: ui
msgctxt "SettingsAudio"
msgid "Place the music you want to play in this folder."
msgstr "Placez la musique que vous souhaitez écouter dans ce dossier."

#: ui
msgctxt "SettingsAudio"
msgid "Volume"
msgstr "Volume"

#: ui
msgctxt "SettingsAudio"
msgid "Master volume"
msgstr "Volume général"

#: ui
msgctxt "SettingsAudio"
msgid "Master volume (when window is in background)"
msgstr "Volume général (fenêtre en arrière-plan)"

#: ui
msgctxt "SettingsDownload"
msgid "Download options"
msgstr "Options de téléchargement"

#: ui
msgctxt "SettingsDownload"
msgid "Max connections"
msgstr "Connexions simultanées maximales"

#: ui
msgctxt "SettingsDownload"
msgid "Limit the number of simultaneous connections to servers. Only applies to downloads during installation. Setting too high may reduce speed!"
msgstr "Limite le nombre de connexions simultanées aux serveurs. Ne s'applique qu'aux téléchargements effectués lors de l'installation. Une valeur trop élevée peut réduire la vitesse !"

#: ui
msgctxt "SettingsDownload"
msgid "Max download speed (B/s)"
msgstr "Vitesse de téléchargement maximale (o/s)"

#: ui
msgctxt "SettingsDownload"
msgid "Limit download speed. Only applies to downloads during installation. Must be greater than 1024 to take effect. Set to 0 to disable"
msgstr "Limite la vitesse de téléchargement. Ne s'applique qu'aux téléchargements effectués lors de l'installation. Doit être supérieure à 1024 pour prendre effet. Mettre 0 pour désactiver"

#: ui
msgctxt "SettingsDownload"
msgid "Mirror servers"
msgstr "Serveurs miroirs"

#: ui
msgctxt "SettingsDownload"
msgid "Download game files from alternative sources"
msgstr "Télécharge les fichiers du jeu depuis des sources alternatives"

#: ui
msgctxt "SettingsDownload"
msgid "Proxy"
msgstr "Proxy"

#: ui
msgctxt "SettingsDownload"
msgid "Use system proxy (requires app restart)"
msgstr "Utilise le proxy système (redémarrage de l'application requis)"

#: ui
msgctxt "SettingsDownload"
msgid "Currently only proxy via environment variables is supported"
msgstr "Seul le proxy via variables d'environnement est actuellement pris en charge"

