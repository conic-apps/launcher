msgstr "Exécuter après le lancement"

#: ui
msgctxt "SettingsGame"
msgid "Added at the end of the launch script"
msgstr "Ajoutée à la fin du script de lancement"

#: ui
msgctxt "SettingsGame"
msgid "Ignore invalid Minecraft certificates"
msgstr "Ignorer les certificats Minecraft invalides"

#: ui
msgctxt "SettingsGame"
msgid "Adds -Dfml.ignoreInvalidMinecraftCertificates=true to JVM arguments"
msgstr "Ajoute -Dfml.ignoreInvalidMinecraftCertificates=true aux arguments JVM"

#: ui
msgctxt "SettingsGame"
msgid "Ignore patch discrepancies"
msgstr "Ignorer les divergences de patchs"

#: ui
msgctxt "SettingsGame"
msgid "Adds -Dfml.ignorePatchDiscrepancies=true to JVM arguments"
msgstr "Ajoute -Dfml.ignorePatchDiscrepancies=true aux arguments JVM"

#: ui
msgctxt "SettingsGame"
msgid "Skip game file check"
msgstr "Ignorer la vérification des fichiers du jeu"

#: ui
msgctxt "SettingsGame"
msgid "The launcher will not attempt to verify or repair game files before launching"
msgstr "Le lanceur ne cherchera pas à vérifier ni à réparer les fichiers du jeu avant le lancement"

