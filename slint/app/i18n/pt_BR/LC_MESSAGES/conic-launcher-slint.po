msgid "Accessibility"
msgstr "Acessibilidade"

#: ui
msgctxt "SettingsAccessibility"
msgid "Release update reminder"
msgstr "Aviso de novas releases"

#: ui
msgctxt "SettingsAccessibility"
msgid "Show a reminder dialog when a Minecraft release is published"
msgstr "Mostra um diálogo de aviso quando uma release do Minecraft é publicada"

#: ui
msgctxt "SettingsAccessibility"
msgid "Snapshot update reminder"
msgstr "Aviso de novos snapshots"

#: ui
msgctxt "SettingsAccessibility"
msgid "Show a reminder dialog when a Minecraft snapshot is published"
msgstr "Mostra um diálogo de aviso quando um snapshot do Minecraft é publicado"

#: ui
msgctxt "SettingsAccessibility"
msgid "Auto-change game language"
msgstr "Alterar idioma do jogo automaticamente"

#: ui
msgctxt "SettingsAccessibility"
msgid "Set the game language to your launcher language on first launch"
msgstr "Define o idioma do jogo conforme o idioma do launcher na primeira inicialização"

#: ui
msgctxt "SettingsAccessibility"
msgid "High contrast mode"
msgstr "Modo de alto contraste"

#: ui
msgctxt "SettingsAccessibility"
msgid "Enable high contrast mode for the current theme (if available)"
msgstr "Ativa o modo de alto contraste para o tema atual (se disponível)"

#: ui
msgctxt "SettingsAppearance"
msgid "Palette"
msgstr "Paleta de cores"

#: ui
msgctxt "SettingsAppearance"
msgid "Follow system dark mode"
msgstr "Seguir modo escuro do sistema"

#: ui
msgctxt "SettingsAppearance"
msgid "Uses Latte when the system is set to light mode, otherwise uses Mocha"
msgstr "Usa Latte quando o sistema estiver em modo claro; caso contrário, usa Mocha"

#: ui
msgctxt "SettingsAppearance"
msgid "Background image"
msgstr "Imagem de fundo"

#: ui
msgctxt "SettingsAppearance"
msgid "Custom background image"
msgstr "Imagem de fundo personalizada"

#: ui
msgctxt "SettingsAppearance"
msgid "Select an image as the launcher background. Instance backgrounds take priority"
msgstr "Selecione uma imagem como fundo do launcher. Os fundos das instâncias têm prioridade"

#: ui
msgctxt "SettingsAppearance"
msgid "Remove image"
msgstr "Remover imagem"

#: ui
msgctxt "SettingsAppearance"
msgid "Background image darkness"
msgstr "Escurecer imagem de fundo"

#: ui
msgctxt "SettingsAppearance"
msgid "3D background camera movement"
msgstr "Movimentação de câmera do fundo em 3D"

#: ui
msgctxt "SettingsAppearance"
msgid "When disabled, the camera stops moving forward and the background stops updating after rendering, completely eliminating background overhead"
msgstr "Quando desativado, a câmera para de avançar e o fundo para de ser atualizado após a renderização, eliminando completamente o custo do fundo"

#: ui
msgctxt "SettingsAppearance"
msgid "Background parallax"
msgstr "Paralaxe do fundo"

#: ui
msgctxt "SettingsAppearance"
msgid "When disabled, the background no longer moves with the mouse"
msgstr "Quando desativado, o fundo não se move mais junto com o mouse"

#: ui
msgctxt "SettingsAudio"
msgid "Background music"
msgstr "Música de fundo"

#: ui
msgctxt "SettingsAudio"
msgid "Enable background music"
msgstr "Ativar música de fundo"

#: ui
msgctxt "SettingsAudio"
msgid "Play background music in the launcher."
msgstr "Reproduz música de fundo no launcher."

#: ui
msgctxt "SettingsAudio"
msgid "Resume on start"
msgstr "Retomar ao iniciar"

#: ui
msgctxt "SettingsAudio"
msgid "Resume the last track and its progress when the application starts."
msgstr "Retoma a última faixa e seu progresso quando o aplicativo é iniciado."

#: ui
msgctxt "SettingsAudio"
msgid "Audio visualizer"
msgstr "Visualizador de áudio"

#: ui
msgctxt "SettingsAudio"
msgid "Show audio visualization at the bottom of the game page."
msgstr "Exibe a visualização de áudio na parte inferior da página do jogo."

#: ui
msgctxt "SettingsAudio"
msgid "Pause on game launch"
msgstr "Pausar ao iniciar o jogo"

#: ui
msgctxt "SettingsAudio"
msgid "Automatically pause background music when the game finishes launching."
msgstr "Pausa automaticamente a música de fundo quando o jogo termina de iniciar."

#: ui
msgctxt "SettingsAudio"
msgid "Open music folder"
msgstr "Abrir pasta de músicas"

#: ui
msgctxt "SettingsAudio"
msgid "Place the music you want to play in this folder."
msgstr "Coloque as músicas que deseja ouvir nesta pasta."

#: ui
msgctxt "SettingsAudio"
msgid "Volume"
msgstr "Volume"

#: ui
msgctxt "SettingsAudio"
msgid "Master volume"
msgstr "Volume principal"

#: ui
msgctxt "SettingsAudio"
msgid "Master volume (when window is in background)"
msgstr "Volume principal (quando a janela está em segundo plano)"

#: ui
msgctxt "SettingsDownload"
msgid "Download options"
msgstr "Opções de download"

#: ui
msgctxt "SettingsDownload"
msgid "Max connections"
msgstr "Conexões máximas"

#: ui
msgctxt "SettingsDownload"
msgid "Limit the number of simultaneous connections to servers. Only applies to downloads during installation. Setting too high may reduce speed!"
msgstr "Limita o número de conexões simultâneas aos servidores. Aplica-se apenas aos downloads durante a instalação. Um valor muito alto pode reduzir a velocidade!"

#: ui
msgctxt "SettingsDownload"
msgid "Max download speed (B/s)"
msgstr "Velocidade máxima de download (B/s)"

#: ui
msgctxt "SettingsDownload"
msgid "Limit download speed. Only applies to downloads during installation. Must be greater than 1024 to take effect. Set to 0 to disable"
msgstr "Limita a velocidade de download. Aplica-se apenas aos downloads durante a instalação. Deve ser maior que 1024 para ter efeito. Defina 0 para desativar"

#: ui
msgctxt "SettingsDownload"
msgid "Mirror servers"
msgstr "Servidores espelho"

#: ui
msgctxt "SettingsDownload"
msgid "Download game files from alternative sources"
msgstr "Baixa arquivos do jogo de fontes alternativas"

#: ui
msgctxt "SettingsDownload"
msgid "Proxy"
msgstr "Proxy"

#: ui
msgctxt "SettingsDownload"
msgid "Use system proxy (requires app restart)"
msgstr "Usar proxy do sistema (requer reiniciar o aplicativo)"

#: ui
msgctxt "SettingsDownload"
msgid "Currently only proxy via environment variables is supported"
msgstr "Atualmente, há suporte apenas para proxy via variáveis de ambiente"

