msgid "Clicking \"Log in\" opens your browser to sign in. You can also "
msgstr "Clicar em “Entrar” abre o seu navegador. Você também pode "

#: ui
msgctxt "AccountAddMicrosoft"
msgid "copy the link"
msgstr "copiar o link"

#: ui
msgctxt "AccountAddMicrosoft"
msgid " and paste it into the browser. To finish signing in on another device, "
msgstr " e colá-lo no navegador. Para concluir o login em outro dispositivo, "

#: ui
msgctxt "AccountAddMicrosoft"
msgid "use a device code"
msgstr "usar um código de dispositivo"

#: ui
msgctxt "AccountAddMicrosoft"
msgid " instead."
msgstr "."

#: ui
msgctxt "AccountAddMicrosoft"
msgid "Log in"
msgstr "Entrar"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Sign in to a Minecraft account through a third-party Yggdrasil auth server — for skin sites, self-hosted auth servers and other unofficial account systems."
msgstr "Entre em uma conta do Minecraft por um servidor de autenticação Yggdrasil de terceiros — para sites de skins, servidores próprios e outros sistemas de contas não oficiais."

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Auth server address (API root)"
msgstr "Endereço do servidor de autenticação (API root)"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Auth service: {}"
msgstr "Serviço de autenticação: {}"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Password"
msgstr "Senha"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Verify and add profile"
msgstr "Verificar e adicionar perfil"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Please wait"
msgstr "Aguarde"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Back"
msgstr "Voltar"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "This account has more than one profile — choose the ones to add"
msgstr "Esta conta tem mais de um perfil — escolha quais adicionar"

#: ui
msgctxt "AccountAddYggdrasil"
msgid " (added)"
msgstr " (adicionado)"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Add profiles"
msgstr "Adicionar perfis"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "This account has no game profile"
msgstr "Esta conta não tem nenhum perfil de jogo"

#: ui
msgctxt "AccountAddMicrosoft"
msgid "Cancel"
msgstr "Cancelar"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Cancel"
msgstr "Cancelar"

#: ui
msgctxt "AccountAddYggdrasil"
msgid "Username"
msgstr "Nome de usuário"
