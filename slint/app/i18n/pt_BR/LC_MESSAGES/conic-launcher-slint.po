msgctxt "SettingsGame"
msgid "Extra class paths"
msgstr "Caminhos de classe extras"

#: ui
msgctxt "SettingsGame"
msgid "Separated by semicolons on Windows, colons on other systems"
msgstr "Separados por ponto e vírgula no Windows e por dois-pontos nos demais sistemas"

#: ui
msgctxt "SettingsGame"
msgid "Execute before launch"
msgstr "Executar antes da inicialização"

#: ui
msgctxt "SettingsGame"
msgid "Added before the launch command"
msgstr "Adicionado antes do comando de inicialização"

#: ui
msgctxt "SettingsGame"
msgid "Wrap command"
msgstr "Comando wrapper"

#: ui
msgctxt "SettingsGame"
msgid "Added at the beginning of the launch command"
msgstr "Adicionado ao início do comando de inicialização"

#: ui
msgctxt "SettingsGame"
msgid "Execute after launch"
msgstr "Executar após a inicialização"

#: ui
msgctxt "SettingsGame"
msgid "Added at the end of the launch script"
msgstr "Adicionado ao final do script de inicialização"

#: ui
msgctxt "SettingsGame"
msgid "Ignore invalid Minecraft certificates"
msgstr "Ignorar certificados inválidos do Minecraft"

#: ui
msgctxt "SettingsGame"
msgid "Adds -Dfml.ignoreInvalidMinecraftCertificates=true to JVM arguments"
msgstr "Adiciona -Dfml.ignoreInvalidMinecraftCertificates=true aos argumentos da JVM"

#: ui
msgctxt "SettingsGame"
msgid "Ignore patch discrepancies"
msgstr "Ignorar divergências de patches"

#: ui
msgctxt "SettingsGame"
msgid "Adds -Dfml.ignorePatchDiscrepancies=true to JVM arguments"
msgstr "Adiciona -Dfml.ignorePatchDiscrepancies=true aos argumentos da JVM"

#: ui
msgctxt "SettingsGame"
msgid "Skip game file check"
msgstr "Ignorar verificação dos arquivos do jogo"

#: ui
msgctxt "SettingsGame"
msgid "The launcher will not attempt to verify or repair game files before launching"
msgstr "O launcher não tentará verificar nem reparar os arquivos do jogo antes da inicialização"

