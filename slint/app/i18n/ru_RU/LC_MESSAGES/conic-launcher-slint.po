msgctxt "SettingsGeneral"
msgid "Follow system"
msgstr "Как в системе"

#: ui
msgctxt "SettingsGeneral"
msgid "Auto update"
msgstr "Автообновление"

#: ui
msgctxt "SettingsGeneral"
msgid "Automatically download and install updates when available"
msgstr "Автоматически загружать и устанавливать обновления, когда они доступны"

#: ui
msgctxt "SettingsGeneral"
msgid "Update channel"
msgstr "Канал обновлений"

#: ui
msgctxt "SettingsGeneral"
msgid "Controls how frequently the launcher receives updates"
msgstr "Определяет частоту получения обновлений лаунчером"

#: ui
msgctxt "SettingsGeneral"
msgid "Stable"
msgstr "Стабильный"

#: ui
msgctxt "SettingsGeneral"
msgid "Beta"
msgstr "Бета"

