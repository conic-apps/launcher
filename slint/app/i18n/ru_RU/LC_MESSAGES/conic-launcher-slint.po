msgctxt "SettingsGame"
msgid "Extra class paths"
msgstr "Дополнительные пути классов"

#: ui
msgctxt "SettingsGame"
msgid "Separated by semicolons on Windows, colons on other systems"
msgstr "Разделяются точкой с запятой в Windows и двоеточием в других системах"

#: ui
msgctxt "SettingsGame"
msgid "Execute before launch"
msgstr "Выполнять перед запуском"

#: ui
msgctxt "SettingsGame"
msgid "Added before the launch command"
msgstr "Добавляется перед командой запуска"

#: ui
msgctxt "SettingsGame"
msgid "Wrap command"
msgstr "Команда-обертка"

#: ui
msgctxt "SettingsGame"
msgid "Added at the beginning of the launch command"
msgstr "Добавляется в начало команды запуска"

#: ui
msgctxt "SettingsGame"
msgid "Execute after launch"
msgstr "Выполнять после запуска"

#: ui
msgctxt "SettingsGame"
msgid "Added at the end of the launch script"
msgstr "Добавляется в конец сценария запуска"

#: ui
msgctxt "SettingsGame"
msgid "Ignore invalid Minecraft certificates"
msgstr "Игнорировать недействительные сертификаты Minecraft"

#: ui
msgctxt "SettingsGame"
msgid "Adds -Dfml.ignoreInvalidMinecraftCertificates=true to JVM arguments"
msgstr "Добавляет -Dfml.ignoreInvalidMinecraftCertificates=true в аргументы JVM"

#: ui
msgctxt "SettingsGame"
msgid "Ignore patch discrepancies"
msgstr "Игнорировать расхождения патчей"

#: ui
msgctxt "SettingsGame"
msgid "Adds -Dfml.ignorePatchDiscrepancies=true to JVM arguments"
msgstr "Добавляет -Dfml.ignorePatchDiscrepancies=true в аргументы JVM"

#: ui
msgctxt "SettingsGame"
msgid "Skip game file check"
msgstr "Пропускать проверку файлов игры"

#: ui
msgctxt "SettingsGame"
msgid "The launcher will not attempt to verify or repair game files before launching"
msgstr "Лаунчер не будет проверять и восстанавливать файлы игры перед запуском"

