// Icon geometry for `AppIcon`.
//
// The Vue frontend renders Font Awesome Pro / Ionicons SVGs from
// `src/assets/icons/*.svg`. Font Awesome Pro cannot be shipped, so the paths
// used by the migrated screens are embedded here as plain SVG path data,
// preserving each icon's original view box and stroke width.
//
// An icon is described by up to four lookups:
//   * `stroke-commands` — outline sub-paths (drawn with `stroke`);
//   * `fill-commands`   — solid sub-paths (drawn with `fill`);
//   * `viewbox`         — square view box edge (512, 640 or 24);
//   * `stroke-width`    — stroke width in view box units (32, 36, 48 or 2).
//
// Mixed icons (e.g. `gamepad`, `palette`, `about`, `contrast`, `speedometer`)
// have both stroke and fill commands; `AppIcon` layers them.
export global Icons {
    public pure function viewbox(name: string) -> int {
        if name == "bell" { return 24; }
        if name == "server" { return 24; }
        if name == "package" { return 24; }
        if name == "java" { return 640; }
        if name == "flag" { return 640; }
        if name == "github" { return 640; }
        if name == "search" { return 640; }
        return 512;
    }

    public pure function stroke-width(name: string) -> int {
        if name == "bell" { return 2; }
        if name == "server" { return 2; }
        if name == "package" { return 2; }
        if name == "link" { return 36; }
        if name == "chevron-forward" { return 48; }
        if name == "chevron-down" { return 48; }
        if name == "chevron-up" { return 48; }
        return 32;
    }

