import { AccountAddDialog } from "dialogs/account-add.slint";
import { CreateInstance } from "dialogs/create-instance.slint";
import { LaunchErrorDialogs } from "dialogs/launch-errors.slint";
import { MultiplayerExtension } from "dialogs/multiplayer-extension.slint";
import { ConfirmDeleteInstance } from "dialogs/confirm-delete-instance.slint";

// The overlay layer (src/overlays/DialogRoot.vue): one instance per dialog,
// mounted once above the whole app. Each dialog stays hidden until its flag in
// `Dialogs` is set, and draws its own scrim, so a dialog that is closed lets
// everything through.
//
// The Vue's DialogRoot lists every dialog in the app; they are added here as
// they are migrated.
export component DialogRoot inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    CreateInstance { }
    // The instance settings overlay's "Delete instance" row. `DialogRoot.vue`
    // lists `ConfirmDeleteInstance` right after `CreateInstance` and ahead of the
    // four launch errors, so a create-instance dialog that is still open covers
    // it and a launch error covers it in turn — the same order.
    ConfirmDeleteInstance { }
    // Slint draws and hit-tests in declaration order, where the Vue's z-index
    // decides. `DialogRoot.vue` puts the four launch-error dialogs ahead of
    // `MultiplayerExtension` and `AccountAdd`, so a launch error raised while
    // one of those is open is drawn *over* it there — which is the case that
    // matters, since a launch is what raises one. Listed here in the same
    // order for the same reason: the last instance is the top one.
    LaunchErrorDialogs { }
    MultiplayerExtension { }
    AccountAddDialog { }
}
