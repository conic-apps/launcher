import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/app-icon.slint";
import { BaseLoading } from "../../components/base-loading.slint";

// The "nothing here" placeholder (`ContentNotFound.vue`), drawn over an empty
// grid, and the spinner block the list views show instead of their grid while
// the first response is on its way (`.search-status`).
//
// The Vue wraps the placeholder in a `<Transition>`: 350ms in on
// `cubic-bezier(.34, 1.56, .64, 1)` — a slight overshoot — and 250ms out on
// `cubic-bezier(.215, .61, .355, 1)`, both scaling from 0.9, so it springs open
// rather than appearing. A newly created element never plays an `animate`
// (its first evaluation takes the not-animating branch), which is why this
// shows itself for one frame at the rest values first, exactly like
// `BaseDialog` and `DescriptionTooltip` do.
export component ContentNotFound inherits Rectangle {
    /// The Vue's `show` prop.
    in property <bool> show: false;
    /// The second line, which the Vue only draws when it is given one.
    in property <string> description: "";
    /// The block it occupies, and the box the body is centred in. A definite
    /// height rather than `100%` or a measured one: it is a child of a column,
    /// and a component whose height is measured collapses to nothing there (see
    /// the note in `panels.slint`). What the block *is* differs per call site —
    /// see `panels.slint`, which is the only place that decides.
    in property <length> block-height: 150px;
    /// How tall the placeholder's own content is, for the call sites whose block
    /// is that content plus a padding (`.search-status { padding: 40px 0 }`).
    out property <length> content-height: body.preferred-height;

    width: 100%;
    height: block-height;
    background: transparent;

    // "closed" | "starting" | "shown" | "leaving"
    private property <string> phase: "closed";
    visible: root.phase != "closed";
    // The Vue's overlay is `pointer-events: none` — it sits over the grid
    // without swallowing its clicks.
    private property <float> reveal: root.phase == "shown" ? 1.0 : 0.0;
    private property <float> spring: root.phase == "shown" ? 1.0 : 0.9;

    changed show => {
        if root.show {
            if root.phase == "closed" {
                root.phase = "starting";
                start-timer.restart();
            } else {
                root.phase = "shown";
            }
        } else if root.phase != "closed" && root.phase != "leaving" {
            root.phase = "leaving";
        }
    }

    start-timer := Timer {
        interval: 16ms;
        running: root.phase == "starting";
        triggered => { root.phase = "shown"; }
    }

    // The longer of the leave's two tracks.
    leave-timer := Timer {
        interval: 260ms;
        running: root.phase == "leaving";
        triggered => { root.phase = "closed"; }
    }

    init => {
        if root.show {
            root.phase = "shown";
        }
    }

    animate reveal {
        duration: root.phase == "shown" ? 350ms : 250ms;
        easing: root.phase == "shown"
            ? cubic-bezier(0.34, 1.56, 0.64, 1)
            : cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    animate spring {
        duration: root.phase == "shown" ? 350ms : 250ms;
        easing: root.phase == "shown"
            ? cubic-bezier(0.34, 1.56, 0.64, 1)
            : cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    body := Rectangle {
        // `.content-placeholder { right: 320px; width: 380px; height:
        // fit-content; display: flex; align-items: center; flex-direction:
        // column }`. Its `right` is on a *static* element — the Vue never gives
        // it `position: absolute` — so it has no effect; the wrapper the panel
        // puts it in is the `display: flex; align-items: center; justify-content:
        // center` one, and that is what centres this 380px box.
        width: 380px;
        height: self.preferred-height;
        background: transparent;
        opacity: root.reveal;
        transform-scale: root.spring;

        VerticalLayout {
            // `.message { margin-top: 12px }` and `.desc { margin-top: 12px }`
            // — the two lines sit 12px below the icon and each other.
            spacing: 12px;

            // A wrapper rather than an alignment on the icon: cell alignment
            // is a property of native elements, not of a component.
            Rectangle {
                height: 64px;
                background: transparent;

                AppIcon {
                    y: 0;
                    name: "about";
                    size: 64px;
                }
            }

            Text {
                // `.message { font-size: 16px; margin-top: 12px }`
                text: @tr("No results match the current filter");
                font-size: 16px;
                color: Theme.default-text-color.transparentize(0.1);
                horizontal-alignment: center;
                height: 16px;
            }

            if root.description != "" : Text {
                // `.desc { font-size: 12px; margin-top: 12px }`, wrapped at the
                // block's 380px like any paragraph — no height of its own.
                text: root.description;
                font-size: 12px;
                color: Theme.default-text-color.transparentize(0.1);
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}

// The spinner block the list views draw while the first response is in flight
// (`.search-status` + `.loading`): a 32px spinner in a padded mantle box.
export component ContentLoading inherits Rectangle {
    /// `.search-status { padding: 40px 0 }` around the 64px spinner box.
    width: 100%;
    height: 144px;
    background: transparent;

    VerticalLayout {
        width: 100%;
        padding-top: 40px;
        padding-bottom: 40px;
        // `.search-status { justify-content: center }` is the *main* axis of a
        // flex row — the horizontal one here — so the mark is centred across the
        // panel. `alignment` would centre it down the column instead and leave
        // it against the left edge, which is where it was drawn.
        cross-axis-alignment: center;

        Rectangle {
            width: 64px;
            height: 64px;
            background: Theme.mantle;
            border-radius: 8px;

            BaseLoading {
                size: 32px;
                stroke-width: 4;
                // The seven `.loading` blocks this component replaces all pass
                // the same three: `:size="32" :gap="8" :strokeWidth="4"`.
                gap: 8;
            }
        }
    }
}
