import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/app-icon.slint";

// The panels' header row (`styles/title-bar.less` `.title`): a 52px mantle bar
// with the panel's icon, its title, and — on the panels that can show content
// from more than one place — the source switcher pushed to the right.
//
// The switcher is the Vue's `.select-source`: 40x32 buttons in a 4px-gapped row,
// each tinted by the source it selects (blue for local, Modrinth's green,
// CurseForge's peach) and backed by `surface2` while active.
// One `.select-source button`. The local button draws a stroked glyph, the two
// platform marks are filled, which is `AppIcon`'s stroke/fill split.
component SourceButton inherits Rectangle {
    in property <string> source: "";
    in property <bool> active: false;
    callback clicked;

    width: 40px;
    height: 32px;
    border-radius: 4px;
    background: touch.pressed ? Theme.surface-1
        : touch.has-hover ? Theme.surface-0
        : (root.active ? Theme.surface-2 : transparent);

    // `button.local.active { stroke: var(--ctp-blue) }`,
    // `button.active.modrinth { fill: var(--ctp-green) }`,
    // `button.active.curseforge { fill: var(--ctp-peach) }`, and otherwise the
    // body text at 70%.
    private property <color> tint:
        !root.active ? Theme.default-text-color.transparentize(0.3)
        : root.source == "local" ? Theme.blue
        : root.source == "modrinth" ? Theme.green
        : Theme.peach;

    AppIcon {
        name: root.source == "local" ? "file-tray-full-outline"
            : root.source == "modrinth" ? "modrinth"
            : "curseforge";
        // The Modrinth mark is a 593-unit view box and reads a size larger than
        // the 512-unit ionicons at the same number, so it is drawn 3px smaller —
        // the Vue's inline `padding: 3px` on that one button's svg.
        size: root.source == "modrinth" ? 18px : 24px;
        icon-color: root.tint;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
export component ContentTitleBar inherits Rectangle {
    in property <string> icon: "";
    in property <length> icon-size: 20px;
    in property <string> title: "";
    /// Gap below the bar. The Vue only sets one on the saves panel
    /// (`ContentSaves.vue`'s `margin-bottom: 16px`); the others leave it at 0.
    in property <length> title-gap: 0px;
    /// "" when the panel has a single source. Otherwise the switcher is drawn
    /// with `sources` — "local", "modrinth", "curseforge".
    in property <[string]> sources: [];
    in property <string> active-source: "";

    callback source-selected(string);

    width: 100%;
    height: 52px + title-gap;
    background: transparent;

    bar := Rectangle {
        width: parent.width;
        height: 52px;
        background: Theme.mantle;
        clip: true;

        // `.title { display: flex; align-items: center; padding: 0 32px; gap: 8px }`
        // with `.select-source { margin-left: auto; gap: 4px }` — so the title
        // takes what the buttons leave and the row is pushed against the right
        // padding edge. The spacer is `margin-left: auto`.
        HorizontalLayout {
            padding-left: 32px;
            padding-right: 32px;
            spacing: 8px;
            cross-axis-alignment: center;

            AppIcon {
                name: root.icon;
                size: root.icon-size;
            }

            Text {
                text: root.title;
                font-size: 16px;
                color: Theme.default-text-color.transparentize(0.1);
            }

            Rectangle { horizontal-stretch: 1; }

            switcher := HorizontalLayout {
                // The buttons' own 32px, and their width is what they measure —
                // a layout with no `width` of its own takes its parent's, which
                // would run them back over the title.
                height: 32px;
                vertical-stretch: 0;
                spacing: 4px;

                for source in root.sources : SourceButton {
                    source: source;
                    active: source == root.active-source;
                    clicked => { root.source-selected(source); }
                }
            }
        }
    }
}
