import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/app-icon.slint";
import { CardTag, ContentCard as CardData, ContentText } from "../../globals/content.slint";
import { GameTime } from "../../globals/game.slint";

// One card of a content grid (`styles/content-card.less` `.content`), shared by
// all nine grids — the five local lists, the six remote ones and the saves.
//
// The Vue builds the card out of three overlapping boxes and lets the hover
// state reach into them with descendant selectors:
//
//     .content        translateX(4px)          rgba(surface0, .4), radius 8
//     .content img    72px wide, 2px surface0 border, radius 8 0 0 8
//     .content-info   starts where the image ends and its own `transform` pulls
//                     it 8px back over it, width calc(100% - 72px) → -88px on
//                     hover, surface0 → surface1
//     .actions        right: 4px, z-index -1, buttons at opacity 0 / scale .5
//
// Three things carry over differently:
//
//   * The 4px right shift is folded into the card's `x`, which Rust computes —
//     there is one place that knows the grid geometry.
//   * `.actions` is *behind* the image and the info block in the Vue, which it
//     gets from `z-index: -1` inside the card's stacking context. Slint has no
//     negative z, so the column is declared **before** them: siblings paint in
//     declaration order and hit-test in reverse, which is the same result.
//   * The image's rounded left corners need a `clip`, and a rounded `clip` is a
//     no-op on the software renderer (see the README's Windows note) — the one
//     place a card can come out square, like `AccountAvatar`.
// One tag of the info block — the Vue's `span.loader-type` / `span.version` /
// `span.game-mode` / `span.command-enabled` family, whose class picks the fill.
// One `button` of the card's action column: invisible until the card is
// hovered, then `.8` opacity and full scale, over 200ms.
//
// It draws only — the card owns the pointer (see `ContentCard`'s `hover-area`)
// and hands the button its own hover and press state, because a `TouchArea` here
// would take the card's hover away the moment the pointer reached it.
component ActionButton inherits Rectangle {
    in property <string> kind: "heart";
    in property <bool> favorited: false;
    /// `.content:hover .actions button` — the whole card is hovered.
    in property <bool> shown: false;
    /// `.actions button:hover` and `:active`, which the card works out from the
    /// pointer's position.
    in property <bool> pointed: false;
    in property <bool> pressed: false;

    // 14px, the size of the `AppIcon` the Vue puts in: `.actions` is absolutely
    // positioned with only `right` set, so it shrinks to its content and the
    // button is exactly as big as its glyph. A 20px box left the glyph against
    // the info block instead of centred in the 24px the hover opens up.
    width: 14px;
    height: 14px;
    background: transparent;
    opacity: root.shown ? (root.pressed ? 0.9 : (root.pointed ? 1.0 : 0.8)) : 0.0;
    transform-scale: root.shown ? 1.0 : 0.5;

    animate opacity, transform-scale {
        duration: 200ms;
        easing: ease-out-quad;
    }

    // `:name="isFavorited ? 'heart' : 'heart-outline'"` — the heart is outlined
    // until it is favourited, when it also turns red
    // (`.heart-favorited { color: var(--ctp-red) !important }`).
    AppIcon {
        name: root.kind == "heart" && !root.favorited ? "heart-outline" : root.kind;
        size: 14px;
        icon-color: root.favorited && root.kind == "heart"
            ? Theme.red
            : Theme.default-text-color.transparentize(0.1);
    }
}
component TagChip inherits Rectangle {
    in property <CardTag> tag;

    // The Vue's tag family, transcribed from `styles/content-card.less` and
    // `ContentSaves.vue`'s own block, class by class:
    //
    //   span.loader-type, span.version { font-size: 9px; padding: 2px 6px;
    //                                    margin-right: 4px;
    //                                    border-radius: 100px;
    //                                    font-weight: 500;
    //                                    color: var(--ctp-text-inverse) }
    //   span.loader-type.fabric { background: yellow } (forge blue, neoforge
    //                            peach, quilt mauve, liteloader yellow)
    //   span.version { border: 1px solid var(--ctp-sky); color: var(--ctp-text) }
    //   span.game-mode, span.command-enabled { font-size: 9px; padding: 2px 6px;
    //                                    border-radius: 100px; font-weight: 500;
    //                                    color: var(--ctp-text-inverse) }
    //   span.game-mode.survival { background: green } (creative mauve, adventure
    //                            peach, spectator blue)
    //   span.command-enabled { background: yellow; margin-left: 4px }
    //   span.last-played { font-size: 10px; margin-left: 4px }
    //
    // The margins are *outside* the pill, which is why the background lives on
    // an inner box: a tag's own box is `margin + padding + label`.
    private property <bool> pill: tag.kind != "last-played" && tag.kind != "plain";
    private property <length> margin-before:
        tag.kind == "command-enabled" || tag.kind == "last-played" ? 4px : 0px;
    private property <length> margin-after:
        tag.kind == "version"
            || tag.kind == "loader-fabric"
            || tag.kind == "loader-forge"
            || tag.kind == "loader-neoforge"
            || tag.kind == "loader-quilt"
            || tag.kind == "loader-liteloader" ? 4px
        : 0px;

    // One line box for the run — the info block's 16px strut — with a 13px
    // pill centred in it (9px of text plus its 4px of padding).
    height: 16px;
    width: root.margin-before + pill-box.width + root.margin-after;
    background: transparent;

    // A last-played tag's halves are both translated, so neither can be
    // composed in Rust; the relative time comes from the same `GameTime` helper
    // the instance cards use.
    private property <string> resolved: root.tag.kind == "last-played"
        ? ContentText.last-played-label()
            + GameTime.last-played(
                root.tag.time-kind,
                root.tag.time-hours,
                root.tag.time-month,
                root.tag.time-day,
                root.tag.time-year,
            )
        : root.tag.label + root.tag.text;

    pill-box := Rectangle {
        x: root.margin-before;
        y: root.pill ? 1.5px : 0px;
        height: root.pill ? 13px : 16px;
        border-radius: 100px;
        background: tag.kind == "loader-fabric" || tag.kind == "loader-liteloader"
                || tag.kind == "command-enabled" ? Theme.yellow
            : tag.kind == "loader-forge" ? Theme.blue
            : tag.kind == "loader-neoforge" ? Theme.peach
            : tag.kind == "loader-quilt" ? Theme.mauve
            : tag.kind == "game-mode-survival" ? Theme.green
            : tag.kind == "game-mode-creative" ? Theme.mauve
            : tag.kind == "game-mode-adventure" ? Theme.peach
            : tag.kind == "game-mode-spectator" ? Theme.blue
            : transparent;
        // `span.version { border: 1px solid var(--ctp-sky) }` — the only
        // outlined tag.
        border-width: tag.kind == "version" ? 1px : 0px;
        border-color: Theme.sky;

        label := Text {
            text: root.resolved;
            // `span.version { color: var(--ctp-text) }` — a version reads as
            // body text, not as the inverse of its own fill, because it has no
            // fill. The Vue draws a last-played tag's label at 80% and its
            // value at full strength; Slint has no per-span styling, so the
            // whole tag takes the label's dimmer colour.
            color: !root.pill || tag.kind == "version"
                ? Theme.default-text-color.transparentize(root.pill ? 0.1 : 0.3)
                : Theme.text-inverse;
            font-size: root.pill ? 9px : 10px;
            // `font-weight: 500` is on the four pill classes; `span.last-played`
            // has none, so its text keeps the body weight.
            font-weight: root.pill ? 500 : Theme.font-weight-normal;
            x: root.pill ? 6px : 0px;
            vertical-alignment: center;
        }

        width: label.width + (root.pill ? 12px : 0px);
    }
}
export component ContentCard inherits Rectangle {
    in property <CardData> card;
    /// 72px for the content lists, 64px for the saves (the Vue's two `img`s).
    in property <length> icon-size: 72px;
    /// Whether the card reacts to the pointer. The empty-state placeholder that
    /// covers an empty grid turns it off, as the Vue's `pointer-events: none`
    /// does.
    in property <bool> interactive: true;
    /// Which line style the second row takes. The Vue has two: `p.authors`
    /// (11px, 2px margins) for the content lists and `p.folder-name` (10px, 4px
    /// margins) for the saves' folder. "" | "authors" | "folder".
    in property <string> subtitle-style: "authors";

    callback select();
    callback open-path();
    callback delete();
    callback toggle-favorite();
    callback open-link();
    callback play();

    // The card's place in the grid, from Rust (`layout` in `app/src/content.rs`).
    // A grid has no layout of its own here — the cards are positioned by hand —
    // so without these every card is drawn at the grid's origin and they pile up
    // on one another.
    x: card.x;
    y: card.y;
    width: card.width;
    height: card.height;
    visible: card.in_view;
    // `rgba(var(--ctp-surface0-rgb), 0.4)`
    background: Theme.surface-0.transparentize(0.6);
    border-radius: 8px;
    // `.content.content-disabled { opacity: .7 }`
    opacity: card.mod-disabled ? 0.7 : 1.0;
    // `.content.selected { z-index: 10 }` — a repeated child's root `z` is the
    // one the compiler honours, so an expanded save rises over its neighbours.
    z: card.selected ? 10 : 0;

    // The card holds **one** `TouchArea`, and every hover-revealed control is a
    // plain drawing that it routes clicks to by position.
    //
    // The Vue has a `TouchArea` per control, and that does not carry over:
    // `has-hover` is only ever true for the *topmost* area under the pointer, so
    // the moment the pointer reached an action button the card stopped being
    // hovered — the column faded out from under the pointer, the pointer was
    // over the card again, and the two chased each other every time the mouse
    // moved. CSS has no such rule (`:hover` on a parent stays true while a
    // descendant is hovered), which is why the original is stable.
    //
    // The geometry below is the Vue's: `.actions { right: 4px; padding: 12px 0 }`
    // — an absolutely positioned flex column that shrinks to its content, so it
    // is exactly as wide as a button's 14px glyph — and `.download-button
    // { left: 20px }` with an 18px button vertically centred.
    hover-area := TouchArea {
        enabled: root.interactive;
        clicked => {
            if root.over-play {
                root.play();
            } else if root.over-first {
                if root.card.action-kind == "favorite" {
                    root.toggle-favorite();
                } else {
                    root.open-path();
                }
            } else if root.over-second {
                if root.card.action-kind == "favorite" {
                    root.open-link();
                } else {
                    root.delete();
                }
            } else if hover-area.mouse-x <= root.inner-right {
                root.select();
            }
        }
    }

    private property <bool> hovered: hover-area.has-hover || expansion.pointed;
    /// `.content-info:hover { width: calc(100% - 88px) }` — the 16px the inner
    /// card gives up while the pointer is on the card.
    private property <length> info-inset: root.hovered ? 16px : 0px;
    /// Where the inner card ends. `.content` is the flex row the image and
    /// `.content-info` fill, so those two are what the card *is*; the strip of
    /// the grid cell past them is its transparent overhang, and a click there
    /// opens nothing.
    private property <length> inner-right:
        root.icon-size - 8px + max(0px, root.width - root.icon-size - root.info-inset);

    /// `.actions { right: 4px }` around the 14px column.
    private property <length> actions-left: root.width - 18px;
    private property <bool> column-shown: root.card.action-kind != "";
    private property <length> play-top: (root.height - 18px) / 2;

    /// Whether the pointer is over the column's top button — the favourites'
    /// heart, or a local card's folder.
    private property <bool> over-first:
        root.hovered && root.column-shown
            && hover-area.mouse-x >= root.actions-left
            && hover-area.mouse-y >= 12px && hover-area.mouse-y <= 26px;
    private property <bool> over-second:
        root.hovered && root.column-shown
            && hover-area.mouse-x >= root.actions-left
            && hover-area.mouse-y >= root.height - 26px && hover-area.mouse-y <= root.height - 12px;
    private property <bool> over-play:
        root.hovered && root.card.shows-play
            && hover-area.mouse-x >= 20px && hover-area.mouse-x <= 38px
            && hover-area.mouse-y >= root.play-top && hover-area.mouse-y <= root.play-top + 18px;

    // ----- the hover-revealed action column (`.actions`, z-index -1) -----
    // `position: absolute; right: 4px; top: 0; height: 100%; padding: 12px 0`,
    // a column of two buttons pushed to its ends. Neither takes clicks — the
    // card's own area routes them here by position.
    if root.column-shown : Rectangle {
        x: root.actions-left;
        y: 0;
        width: 14px;
        height: root.height;
        background: transparent;

        actions := VerticalLayout {
            // `.actions { padding: 12px 0; justify-content: space-between }` —
            // the padding and the `space-between` are both the layout's, so the
            // spacer element that stood in for the latter is gone.
            padding-top: 12px;
            padding-bottom: 12px;
            alignment: space-between;

            ActionButton {
                kind: root.card.action-kind == "favorite" ? "heart" : "folder";
                favorited: root.card.favorited;
                shown: root.hovered;
                pointed: root.over-first;
                pressed: root.over-first && hover-area.pressed;
            }

            ActionButton {
                kind: root.card.action-kind == "favorite" ? "link" : "trash";
                shown: root.hovered;
                pointed: root.over-second;
                pressed: root.over-second && hover-area.pressed;
            }
        }
    }

    // ----- the icon -----
    icon-box := Rectangle {
        x: 0;
        y: 0;
        width: root.icon-size;
        height: root.height;
        border-width: 2px;
        border-color: Theme.surface-0;
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
        clip: true;

        Image {
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            source: root.card.icon;
            image-fit: ImageFit.fill;
            // `.content:hover img { opacity: 0.4 }` — the *saves* cards dim
            // their world icon while the info block opens up; the mods cards'
            // `.content:hover` has no such rule. The saves are the only cards
            // whose second line is a folder name (and the only ones with a play
            // button), which is what this keys off.
            opacity: root.hovered && root.subtitle-style == "folder" ? 0.4 : 1.0;
            animate opacity {
                duration: 200ms;
                easing: ease-out;
            }
        }
    }

    // ----- the info block -----
    info := Rectangle {
        // The flex row puts it after the image; its `translateX(-8px)` then
        // pulls it back over the image's right edge.
        // `.content:hover .content-info { width: calc(100% - 88px) }` — the same
        // block, 16px narrower. Only the *inset* is animated: `width` also
        // follows the card's own width, so animating it left the block a frame
        // behind the card around it while the window was being resized.
        // The animation has to be on a property this element owns: an `animate`
        // cannot reach into another element's property.
        private property <length> inset: root.info-inset;

        x: root.icon-size - 8px;
        y: 0;
        height: root.height;
        width: max(0px, root.width - root.icon-size - self.inset);
        background: root.hovered ? Theme.surface-1 : Theme.surface-0;
        border-radius: 8px;

        animate inset, background {
            duration: 200ms;
            easing: ease-out-quad;
        }

        // `.content-info { padding: 8px 12px }`, which is a padding.
        info-layout := VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 0px;

            // `p.name { font-size: 14px; font-weight: 700 }`, nowrap + ellipsis.
            // Its line box is its *own* font size: `line-height: 1` on
            // everything (src/assets/styles/main.css) and a block's strut comes
            // from its own font, not the parent's.
            // The line box is its own 14px row: the strikethrough below is
            // drawn over it, and a layout child may not set its own `y`, so the
            // two live inside this wrapper.
            Rectangle {
                height: 14px;
                background: transparent;

                name := Text {
                    width: parent.width;
                    height: parent.height;
                    text: (root.card.mod-disabled ? ContentText.disabled-prefix : "")
                        + root.card.title;
                    font-size: 14px;
                    font-weight: 700;
                    color: Theme.default-text-color.transparentize(0.1);
                    overflow: elide;
                    vertical-alignment: center;
                }

                // `.content-disabled .name { text-decoration: line-through }`.
                // The `p.name` carries the prefix's span too, so the rule crosses
                // both. Slint's `Text` has no decoration property, hence the rule
                // drawn by hand: a hairline through the middle of the line box,
                // as wide as the text it drew — `preferred-width` while that
                // fits, the elided block when it does not — in the text's ink.
                if root.card.mod-disabled : Rectangle {
                    x: 0;
                    width: min(name.preferred-width, name.width);
                    height: 1px;
                    background: name.color;
                }
            }

            // `p.authors { font-size: 11px; opacity: .9; margin: 2px 0 }`, or
            // `p.folder-name { font-size: 10px; opacity: .6; margin: 4px 0 }`.
            if root.card.has-subtitle : Text {
                text: root.card.subtitle;
                font-size: root.subtitle-style == "folder" ? 10px : 11px;
                // `opacity: .9` on the authors line, and the body ink is already
                // at 90%: the two multiply.
                color: Theme.default-text-color.transparentize(
                    root.subtitle-style == "folder" ? 0.4 : 0.1,
                );
                overflow: elide;
                vertical-alignment: center;
                // `margin: 2px 0` on the authors line, `margin: 4px 0` on the
                // folder one, either side of the line box itself.
                height: root.subtitle-style == "folder" ? 18px : 15px;
            }

            // `p.mod-description { font-size: 10px; opacity: .6; margin: 2px 0 }`.
            // A card with no description — a save — draws no line at all, which
            // is what the Vue's `v-if` does.
            if root.card.description != "" : Text {
                text: root.card.description;
                font-size: 10px;
                // `opacity: .6`.
                color: Theme.default-text-color.transparentize(0.4);
                overflow: elide;
                vertical-alignment: center;
                // `margin: 2px 0` around the 10px line box.
                height: 14px;
            }

            // The tags share one line box in the Vue (`span`s in a row). The
            // Vue's spacing is 4px for a pill's right margin and 4px for the
            // last-played tag's left margin; one 4px step is used for all of
            // them, so a run of pills reads 4px tighter than the original's 8.
            tags := HorizontalLayout {
                height: 16px;
                // The tags carry their own margins (see `TagChip`).
                spacing: 0px;
                // The Vue's `span`s sit in a plain line box: no `justify-content`,
                // so the run starts at the block's left edge.
                cross-axis-alignment: center;

                for tag in root.card.tags : TagChip {
                    tag: tag;
                }
            }
        }
    }

    // ----- the saves' play button (`.play-button`) -----
    // `left: 20px; top: 50%; translateY(-50%)`, revealed with the hover.
    if root.card.shows-play : Rectangle {
        x: 20px;
        width: 18px;
        height: 18px;
        background: transparent;
        opacity: root.hovered ? 1.0 : 0.0;
        transform-scale: root.hovered ? 1.0 : 0.5;

        animate opacity, transform-scale {
            duration: 200ms;
            easing: ease-out-quad;
        }

        AppIcon {
            name: "play";
            size: 18px;
            // The ionicon play glyph is a fill, and `fill` defaults to the
            // body ink.
            icon-color: Theme.default-text-color.transparentize(0.1);
        }
    }

    // ----- the expansion (the saves' `.extra`) -----
    // The Vue's `.content.selected .extra` grows to `height + 160px` (or hangs
    // upwards when the card sits near the bottom of the window), takes an
    // outline and rises above the neighbouring cards. It is declared last so it
    // paints over the info block. Its content is the world map, which is not
    // migrated yet, so only the panel and its outline are drawn.
    // `.content .extra { height: 100%; opacity: 0; transition: all 200ms ease }`
    // → `.content.selected .extra { height: calc(100% + 160px); opacity: 1 }`:
    // the box *grows* by 160px over 200ms rather than appearing. Expanding
    // upwards (`.expand-up`) pins it to the card's bottom edge, so the growth
    // is what moves its top edge up.
    //
    // `visible` rather than `if`, so the card's hover can take the expanded
    // area into account: `.extra` is a child of `.content` in the Vue, and
    // `:hover` on a parent stays true while a descendant is hovered.
    expansion := Rectangle {
        private property <float> expanded: root.card.selected ? 1.0 : 0.0;

        visible: self.expanded > 0.0;
        x: 0;
        y: root.card.expand-up ? -160px * self.expanded : 0px;
        width: root.width;
        height: root.height + 160px * self.expanded;
        opacity: self.expanded;
        animate height, opacity, y {
            duration: 200ms;
            easing: ease;
        }
        background: Theme.surface-0;
        border-radius: 8px;
        // `outline: 2px solid var(--ctp-blue)` — an outline is drawn outside
        // the box, a border inside it; the difference is 2px per edge.
        border-width: 2px;
        border-color: Theme.blue;

        // `.extra` carries `@click.stop`: a click on the expanded area opens
        // nothing, it only keeps the card hovered.
        expansion-touch := TouchArea { }

        // `.map-previewer-container { position: absolute; inset: 0; padding:
        // 8px }` around the world map. The map itself is not migrated
        // (`WorldMap.vue` over the `conic-worldmap` crate — see the README), so
        // this is the box it would draw into: the map's own `.world-map {
        // border-radius: 8px; background: var(--ctp-base) }`.
        Rectangle {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            border-radius: 8px;
            background: Theme.base;
        }

        // Declared after the area it reads — an id is only in scope from its
        // own declaration onwards.
        out property <bool> pointed: expansion-touch.has-hover;
    }
}
