// Background-music state (mirrors src/store/music.ts).
//
// The store was one Pinia store with a module-level audio graph beside it. Here
// the graph lives in `slint-music` (the mirror of `crates/music`) and this
// global carries what the UI reads: the playlist, the transport flags, the two
// clocks and the bar levels the footer visualizer draws. `panel-open` and
// `playlist-open` are the one piece of state that stays here rather than in Rust
// — the store kept `panelOpen` in itself only so the title bar could reach it,
// and `showPlaylist` was a `ref` inside `MusicPlayer.vue` all along.

/// One entry of the playlist, as `list_music_files` returns it.
export struct MusicTrack {
    /// The file name, which is also what the playlist and the track title show.
    name: string,
    /// Absolute path, the key the saved position is restored by.
    path: string,
}

export global MusicState {
    // ----- playlist -----
    in-out property <[MusicTrack]> tracks: [];
    /// Which track is selected, or -1 for none (`currentIndex`).
    in-out property <int> current-index: -1;
    /// The selected track's name, empty when nothing is selected. Resolved here
    /// rather than pushed from Rust so the two cannot disagree.
    out property <string> current-name: MusicState.current-index >= 0
        && MusicState.current-index < MusicState.tracks.length
            ? MusicState.tracks[MusicState.current-index].name
            : "";

    // ----- transport -----
    in-out property <bool> is-playing: false;
    in-out property <bool> shuffle: false;
    in-out property <bool> repeat: false;
    /// Whether the transport is waiting on audio: a selection being opened, or
    /// the player running out of buffered samples. The store had no equivalent —
    /// an `<audio>` element could not be seen to be behind — so this is the one
    /// piece of state the panel has that the Vue did not.
    in-out property <bool> buffering: false;
    /// `currentTime` and `duration`, in seconds.
    in-out property <float> current-time: 0;
    in-out property <float> duration: 0;
    /// The panel's two clocks, the `formatTime` of `MusicPlayer.vue` (`mm:ss`,
    /// zero-padded, `00:00` for anything that is not a time). Composed in Rust
    /// because Slint has no number-to-string conversion.
    in-out property <string> current-time-text: "00:00";
    in-out property <string> duration-text: "00:00";
    /// The `progress` getter: 0 while the duration is unknown, so the bar is
    /// empty rather than a division by zero.
    in-out property <float> progress: 0;

    // ----- footer visualizer (BeatMap.vue) -----
    /// One bar height per bar, 0..1 of the visualizer's height, already mapped
    /// and normalised by `src/music.rs`. The component only draws them.
    in-out property <[float]> levels: [];
    /// Whether the bars show a live spectrum or the idle baseline: the Vue's
    /// `analyser && hasTrack && isPlaying`.
    in-out property <bool> live: false;

    // ----- panel -----
    in-out property <bool> panel-open: false;
    in-out property <bool> playlist-open: false;

    // ----- transport actions (the store's actions) -----
    callback toggle-play();
    callback play-index(int);
    callback previous();
    callback next();
    callback seek-ratio(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback open-music-folder();

    // ----- panel actions -----
    callback close-panel();
    callback toggle-playlist();

    // ----- visualizer -----
    /// The visualizer reports its bar count, which is what decides the analyser's
    /// resolution (`BeatMap.vue`'s `ResizeObserver` → `setAnalyserFftSize`).
    callback resized(int);
}
