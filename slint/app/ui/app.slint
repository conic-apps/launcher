import { Theme } from "theme.slint";
import { TitleBar } from "components/title-bar.slint";
import { Navigation } from "globals/navigation.slint";
import { DropdownOverlay } from "components/dropdown-overlay.slint";
import { SettingsView } from "views/settings-view.slint";
import { GameViewPlaceholder } from "views/game-placeholder.slint";

// Re-export so the Rust side can access the settings global and build the Java
// runtime model (`slint_backend::AppConfig` / `slint_backend::JavaRuntime`).
export { AppConfig, JavaRuntime } from "globals/settings.slint";

// Application root window (App.vue). Native window chrome on every platform:
// macOS gets the Chrome-style treatment (transparent hidden titlebar +
// full-size content view via a winit window-attributes hook in main.rs) so the
// custom title bar draws under the native traffic lights; Windows/Linux use
// their native caption bar.
export component App inherits Window {
    title: @tr("Conic Launcher");
    // Base typography from the original stylesheet (see theme.slint).
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-size-base;
    default-font-weight: Theme.font-weight-normal;
    // macOS keeps a transparent window so the custom title bar blends into the
    // native (transparent) title bar; other platforms need an opaque client
    // area beneath their native caption bar.
    background: self.macos ? transparent : Theme.crust;
    width: 840px;
    height: 532px;

    in-out property <bool> macos: false;
    in-out property <string> search-placeholder: @tr("Search or type a command…");
    in-out property <string> search-hotkey: "";

    callback open-search();
    callback toggle-music();
    callback maximize-or-fullscreen();

    // Corners, edge and borders are owned by the window system (the native
    // title bar / window frame), so the content layer is a plain full-size
    // gradient with no custom framing.
    container := Rectangle {
        width: root.width;
        height: root.height;
        background: @linear-gradient(180deg, Theme.mantle 0%, Theme.crust 100%);
        clip: true;

        VerticalLayout {
            width: root.width;
            height: root.height;

            TitleBar {
                macos: root.macos;
                search-placeholder: root.search-placeholder;
                search-hotkey: root.search-hotkey;
                current-page: Navigation.current-page;

                // Navigation is global now: the title bar drives it directly.
                open-home => { Navigation.navigate("game"); }
                open-settings => { Navigation.navigate("settings"); }
                open-search => { root.open-search(); }
                toggle-music => { root.toggle-music(); }
                maximize-or-fullscreen => { root.maximize-or-fullscreen(); }
            }

            // Page stack (App.vue `<component :is="pages[...]">`). Only the
            // settings page is migrated for real; the rest keeps the
            // placeholder until later phases.
            page-stack := Rectangle {
                width: 100%;
                vertical-stretch: 1;
                clip: true;

                if Navigation.current-page == "settings" : SettingsView { }
                if Navigation.current-page != "settings" : GameViewPlaceholder { }
            }
        }

        // Floating dropdown list + outside-click layer, mounted above the page
        // stack (see `DropdownOverlay`).
        DropdownOverlay { }
    }
}
