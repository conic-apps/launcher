import { Theme } from "../theme.slint";
import { NavigationButton } from "title-bar/navigation-button.slint";
import { TitleBarActionButton } from "title-bar/title-bar-action-button.slint";
import { SearchBar } from "search-bar.slint";

component LinuxWindowControlButton inherits Rectangle {
    in property <string> icon-commands;
    callback clicked;

    width: 18px;
    height: 18px;
    border-radius: 9px;
    background: touch.pressed ? Theme.overlay-0
        : touch.has-hover ? Theme.surface-2
        : Theme.surface-1;

    accessible-role: button;
    accessible-action-default => { root.clicked(); }

    Path {
        commands: root.icon-commands;
        viewbox-width: 512;
        viewbox-height: 512;
        width: 14px;
        height: 14px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        fill: transparent;
        stroke: Theme.default-text-color;
        stroke-width: 1px;
        stroke-line-cap: LineCap.round;
        stroke-line-join: LineJoin.round;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// One of the platform's own window controls, as the platform draws it.
//
// The artwork is the platform's own: the glyph comes from the font Windows draws
// its caption buttons with, and the fills are DWM's, both rendered by
// `src/windows_caption.rs`. The state is the platform's too — the controls are
// non-client area, so the system hit tests and clicks them, and reports the
// pointer through `window-control-hovered` / `-pressed`.
//
// The fill is published as *colours* rather than baked into the bitmap, because
// the fill is the only thing that changes for two of the three controls, and
// being able to interpolate it is what gives hovering and pressing a transition.
export struct WindowControl {
    /// Which control this is: 0 minimize, 1 maximize (or restore), 2 close.
    index: int,
    /// The glyph in the caption's own ink: what the control shows at rest.
    glyph: image,
    /// The same glyph in the ink that reads on `plate` — white, for the close
    /// button, and the same image as `glyph` for the other two, which never get
    /// a plate.
    plate-glyph: image,
    /// Whether this control's fill is an opaque plate rather than a translucent
    /// wash, which is the only reason a glyph would change ink. Close is; the
    /// other two are not.
    plate: bool,
    /// The fill behind the glyph on hover.
    hover-fill: color,
    /// What the press *adds* on top of `hover-fill`, not the fill on its own: the
    /// two are stacked, so this is an increment. Compositing two washes of `a` and
    /// `b` lands on `a + b - a·b`, so the increment that reaches the pressed
    /// strength is `(pressed - hover) / (1 - hover)` — worked out in
    /// `src/windows_caption.rs`, where the numbers live.
    press-fill: color,
}

// Draws one of the platform's window controls. There is deliberately no TouchArea
// and no callback: the platform owns these, presses and all, so a handler here
// would never fire. The platform places them with the same inset this component
// is given, which is what keeps the two in step (see `src/windows_caption.rs`).
component SystemWindowControl inherits Rectangle {
    in property <WindowControl> control;
    in property <int> hovered: -1;
    in property <int> pressed: -1;

    width: 46px;
    height: 100%;

    // How far into the control the pointer is: 0 at rest, 1 hovered, 2 pressed.
    // Two numbers rather than one, so the press can be quicker than the hover the
    // way the platform's own buttons are: the press rides *on top of* the hover
    // instead of replacing it, so letting go drops straight back to a hover and
    // only leaving takes the full hover duration.
    private property <float> hover-level: root.hovered == root.control.index ? 1 : 0;
    private property <float> press-level: root.pressed == root.control.index ? 1 : 0;
    animate hover-level { duration: 120ms; easing: ease-out; }
    animate press-level { duration: 60ms; easing: ease-out; }
    private property <float> level: root.hover-level + root.press-level;

    // The fill is two layers whose opacities carry the whole ramp, saturated
    // because `level` runs 0, 1, 2 rather than a fraction. Interpolating the
    // colours instead would mean `mix`, whose factor weights the *receiver* and
    // which is alpha-aware besides — the wrong tool for a flat wash.
    background: Colors.transparent;
    Rectangle {
        background: root.control.hover-fill;
        opacity: clamp(root.level, 0, 1);
    }
    Rectangle {
        background: root.control.press-fill;
        opacity: clamp(root.level - 1, 0, 1);
    }

    // The glyph, in whichever ink the current fill needs. Only close's fill is
    // opaque, so only its glyph changes ink; minimize and maximize keep one image
    // at full opacity and let the wash behind them do all the moving — which is
    // the platform's own model, and why the two are gated on `plate` rather than
    // cross-faded unconditionally: cross-fading an image with itself composites
    // it twice, which lands short of opaque mid-transition and makes the glyph
    // thin out as it moves.
    Image {
        source: root.control.glyph;
        width: 100%;
        height: 100%;
        opacity: root.control.plate ? 1 - clamp(root.level, 0, 1) : 1;
        // The artwork is rendered at the device size of this rectangle, so
        // filling it is exact rather than a rescale.
        image-fit: fill;
    }
    Image {
        source: root.control.plate-glyph;
        width: 100%;
        height: 100%;
        opacity: root.control.plate ? clamp(root.level, 0, 1) : 0;
        image-fit: fill;
    }
}

// Title bar (App.vue). macOS uses native traffic lights, Linux the custom window
// controls below, and Windows the platform's own controls over the right-hand end
// of the bar (`SystemWindowControl`).
export component TitleBar inherits Rectangle {
    in property <bool> macos: false;
    in property <bool> linux: false;
    in property <bool> windows: false;
    /// Whether the window is in native fullscreen, where macOS hides the
    /// traffic lights (see the leading controls below).
    in property <bool> fullscreen: false;
    /// How much of the bar's right-hand end the platform's own window controls
    /// take, and the controls themselves with their state. All pushed in from
    /// `src/windows_caption.rs`, which is also where they are placed.
    in property <length> window-controls-inset: 0px;
    in property <[WindowControl]> window-controls: [];
    in property <int> window-control-hovered: -1;
    in property <int> window-control-pressed: -1;
    in property <string> search-placeholder;
    in property <string> search-hotkey;
    in property <string> current-page: "game";

    callback open-home();
    callback open-settings();
    callback open-search();
    callback toggle-music();
    callback maximize-or-fullscreen();
    callback minimize-window();
    callback close-window();

    // What the right-hand actions have to stay clear of: the custom Linux
    // controls (78px of buttons plus the gap that follows them, 86px in all) or
    // the platform's own controls plus the same gap. macOS has nothing on the
    // right, which is why it keeps the 10px edge padding the Vue gives every
    // platform.
    private property <length> controls-inset:
        root.linux ? 86px : root.window-controls-inset + 10px;

    // Ionicons (stroked, 512 viewbox) icon paths, stroke-width 32.
    // 18px glyph on a 512 view box scales the stroke to 32 * 18 / 512 = 1.125px.
    private property <length> stroked-icon-width: 1.125px;
    private property <string> house-icon: "M80 212v236a16 16 0 0016 16h96V328a24 24 0 0124-24h80a24 24 0 0124 24v136h96a16 16 0 0016-16V212 M480 256L266.89 52c-5-5.28-16.69-5.34-21.78 0L32 256M400 179V64h-48v69";
    private property <string> gear-icon: "M262.29 192.31a64 64 0 1057.4 57.4 64.13 64.13 0 00-57.4-57.4zM416.39 256a154.34 154.34 0 01-1.53 20.79l45.21 35.46a10.81 10.81 0 012.45 13.75l-42.77 74a10.81 10.81 0 01-13.14 4.59l-44.9-18.08a16.11 16.11 0 00-15.17 1.75A164.48 164.48 0 01325 400.8a15.94 15.94 0 00-8.82 12.14l-6.73 47.89a11.08 11.08 0 01-10.68 9.17h-85.54a11.11 11.11 0 01-10.69-8.87l-6.72-47.82a16.07 16.07 0 00-9-12.22 155.3 155.3 0 01-21.46-12.57 16 16 0 00-15.11-1.71l-44.89 18.07a10.81 10.81 0 01-13.14-4.58l-42.77-74a10.8 10.8 0 012.45-13.75l38.21-30a16.05 16.05 0 006-14.08c-.36-4.17-.58-8.33-.58-12.5s.21-8.27.58-12.35a16 16 0 00-6.07-13.94l-38.19-30A10.81 10.81 0 0149.48 186l42.77-74a10.81 10.81 0 0113.14-4.59l44.9 18.08a16.11 16.11 0 0015.17-1.75A164.48 164.48 0 01187 111.2a15.94 15.94 0 008.82-12.14l6.73-47.89A11.08 11.08 0 01213.23 42h85.54a11.11 11.11 0 0110.69 8.87l6.72 47.82a16.07 16.07 0 009 12.22 155.3 155.3 0 0121.46 12.57 16 16 0 0015.11 1.71l44.89-18.07a10.81 10.81 0 0113.14 4.58l42.77 74a10.8 10.8 0 01-2.45 13.75l-38.21 30a16.05 16.05 0 00-6.05 14.08c.33 4.14.55 8.3.55 12.47z";
    private property <string> music-icon: "M192 218v-6c0-14.84 10-27 24.24-30.59l174.59-46.68A20 20 0 0 1 416 154v22 M416 295.94v80c0 13.91-8.93 25.59-22 30l-22 8c-25.9 8.72-52-10.42-52-38h0a33.37 33.37 0 0 1 23-32l51-18.15c13.07-4.4 22-15.94 22-29.85V58a10 10 0 0 0-12.6-9.61L204 102a16.48 16.48 0 0 0-12 16v226c0 13.91-8.93 25.6-22 30l-52 18c-13.88 4.68-22 17.22-22 32h0c0 27.58 26.52 46.55 52 38l22-8c13.07-4.4 22-16.08 22-30v-80";
    private property <string> minimize-icon: "M128 256H384";
    private property <string> maximize-icon: "M144 144H368V368H144Z";
    private property <string> close-icon: "M160 160L352 352M352 160L160 352";

    height: 44px;
    background: Theme.titlebar-background.transparentize(0.2);

    // The platform's own window controls (Windows), flush with the window's
    // right edge and as tall as the bar. Outside `WindowMoveArea`: they are
    // non-client area, so the system hit tests and clicks them, and the bar's own
    // drag area must not sit on top of them.
    if root.windows : Rectangle {
        width: root.window-controls-inset;
        height: 100%;
        x: root.width - self.width;
        y: 0px;

        for control in root.window-controls : SystemWindowControl {
            x: root.window-controls-inset / 3 * control.index;
            y: 0px;
            control: control;
            hovered: root.window-control-hovered;
            pressed: root.window-control-pressed;
        }
    }

    WindowMoveArea {
        width: root.width;
        height: root.height;

        TouchArea {
            width: root.width;
            height: root.height;
            double-clicked => { root.maximize-or-fullscreen(); }
        }

        // Left navigation actions (settings, home). .title-bar-actions-left is
        // at left:16, or left:90 on macOS to clear the native traffic lights —
        // except in fullscreen, where AppKit hides them: the controls take the
        // corner they leave behind instead of lining up behind nothing. (The
        // Vue keeps the 90px gap there.)
        Rectangle {
            x: root.macos && !root.fullscreen ? 90px : 16px;
            y: (root.height - self.height) / 2;
            width: 60px;
            height: 28px;

            HorizontalLayout {
                spacing: 4px;

                NavigationButton {
                    icon-commands: root.gear-icon;
                    icon-stroke-width: root.stroked-icon-width;
                    selected: root.current-page == "settings";
                    accessible-label: @tr("Settings");
                    clicked => { root.open-settings(); }
                }
                NavigationButton {
                    icon-commands: root.house-icon;
                    icon-stroke-width: root.stroked-icon-width;
                    selected: root.current-page == "game";
                    accessible-label: @tr("Home");
                    clicked => { root.open-home(); }
                }
            }
        }

        if root.linux : Rectangle {
            width: 78px;
            height: 28px;
            x: root.width - self.width;
            y: (root.height - self.height) / 2;

            HorizontalLayout {
                x: 0px;
                y: 5px;
                width: 66px;
                height: 18px;
                spacing: 6px;
                alignment: start;
                cross-axis-alignment: center;

                LinuxWindowControlButton {
                    icon-commands: root.minimize-icon;
                    clicked => { root.minimize-window(); }
                }
                LinuxWindowControlButton {
                    icon-commands: root.maximize-icon;
                    clicked => { root.maximize-or-fullscreen(); }
                }
                LinuxWindowControlButton {
                    icon-commands: root.close-icon;
                    clicked => { root.close-window(); }
                }
            }
        }

        // Centered search bar. Mirrors App.vue: .title-bar-container is
        // calc(100vw - 500px) centered; the search bar is given width:100%
        // via inline style and fills the container; .search-hotkey floats
        // right:10 of the container (i.e. 10px inside the bar's right edge).
        search-container := Rectangle {
            width: max(0px, root.width - 500px);
            height: root.height;
            x: (root.width - self.width) / 2;
            y: 0px;

            SearchBar {
                width: 100%;
                height: 26px;
                x: 0px;
                y: (root.height - self.height) / 2;
                placeholder: root.search-placeholder;
                activated => { root.open-search(); }
            }

            if root.search-hotkey != "" : hotkey-chip := Rectangle {
                width: hotkey-text.width + 12px;
                height: 17px;
                border-radius: 4px;
                background: Theme.surface-2.transparentize(0.3);
                x: search-container.width - self.width - 10px;
                y: (root.height - self.height) / 2;

                hotkey-text := Text {
                    text: root.search-hotkey;
                    font-size: 11px;
                    color: Theme.default-text-color.transparentize(0.4);
                    x: (hotkey-chip.width - self.width) / 2;
                    y: (hotkey-chip.height - self.height) / 2;
                }
            }
        }

        // Right-side actions (music). The window controls take the far right on
        // the platforms that have them there; macOS traffic lights remain on the
        // left.
        Rectangle {
            width: 28px;
            height: 28px;
            x: root.width - self.width - root.controls-inset;
            y: (root.height - self.height) / 2;

            TitleBarActionButton {
                icon-commands: root.music-icon;
                icon-stroke-width: root.stroked-icon-width;
                accessible-label: @tr("Music");
                clicked => { root.toggle-music(); }
            }
        }
    }
}
