import { Theme } from "../theme.slint";
import { AppIcon } from "app-icon.slint";
import { BaseLoading } from "base-loading.slint";
import { FocusManager } from "../globals/focus.slint";

// A single settings row (src/components/SettingItem.vue).
//
// Layout mirrors the CSS: 10/16/10/14 padding, a 40px icon column with an 8px
// right margin, a text column (13px title, 12px 60%-opacity description) and a
// right-aligned control area. Navigable rows show a chevron and get the hover /
// active background; rows with a control use the caller's children.
export component SettingItem inherits Rectangle {
    in property <string> title: "";
    // Optional blue tag chips appended to the title (Java runtime versions).
    in property <[string]> tags: [];
    in property <string> description: "";
    in property <string> icon: "";
    in property <image> custom-icon;
    in property <bool> custom-icon-rounded: false;
    in property <bool> navigable: false;
    // Clickable but without the trailing chevron (collapse headers).
    in property <bool> clickable: false;
    in property <bool> resetable: false;
    /// Shows a small spinner after the title while the row's value is loading.
    in property <bool> loading: false;
    // Hover/pressed state driven by the parent for rows that are not navigable
    // but still clickable (the collapse header).
    in property <bool> hovered: false;
    in property <bool> pressed: false;
    in property <bool> item-disabled: false;
    // Whether this row sits on the top / bottom edge of the group it belongs to.
    //
    // The Vue rounds the group's first and last child and nothing else
    // (`.setting-items > div:first-child` / `:last-child`) — there is no
    // `overflow` on `.setting-items`, so the corners are the rows' own. Slint
    // has no `:first-child` selector and cannot reach into a `@children` slot,
    // so the row that ends the group says so itself.
    //
    // This cannot be a clip instead, and not only because of what it costs the
    // Vue: a `clip: true` + `border-radius` box is clipped *rectangularly* by
    // Slint's software renderer (`i-slint-renderer-software`'s `combine_clip`
    // ignores the radius), and the winit backend silently falls back to that
    // renderer when femtovg's OpenGL context cannot be created — a VM, an RDP
    // session, a disabled or outdated GPU driver — with no log. A rounded fill
    // is what every renderer draws.
    in property <bool> group-first: false;
    in property <bool> group-last: false;

    callback clicked;
    callback reset;

    // The 8px of `SettingGroup.vue`.
    private property <length> group-radius: 8px;

    width: 100%;
    background: root.pressed || ((root.navigable || root.clickable) && touch.pressed) ? Theme.setting-item-background-active
        : root.hovered || ((root.navigable || root.clickable) && touch.has-hover) ? Theme.setting-item-background-hover
        : Theme.setting-item-background;
    border-top-left-radius: root.group-first ? root.group-radius : 0px;
    border-top-right-radius: root.group-first ? root.group-radius : 0px;
    border-bottom-left-radius: root.group-last ? root.group-radius : 0px;
    border-bottom-right-radius: root.group-last ? root.group-radius : 0px;
    animate background { duration: 50ms; }
    opacity: root.item-disabled ? 0.6 : 1.0;

    // Declared before the content so controls (selects, switches, reset
    // buttons) stay on top and keep receiving pointer events; empty areas fall
    // through to this touch area. It is always enabled (even for plain rows) so
    // that clicking a row blurs any focused text field.
    touch := TouchArea {
        width: root.width;
        height: root.height;
        clicked => {
            FocusManager.clear();
            if (root.navigable || root.clickable) {
                root.clicked();
            }
        }
    }

    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 14px;
        padding-right: 16px;
        spacing: 0px;
        cross-axis-alignment: center;

        // ----- left: icon + text -----
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            cross-axis-alignment: center;

            if root.icon != "" || root.custom-icon.width > 0 : icon-box := Rectangle {
                width: 40px;
                height: 28px;
                horizontal-stretch: 0;

                if root.custom-icon.width > 0 : Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: root.custom-icon-rounded ? 10000px : 0px;
                    clip: true;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;

                    Image {
                        width: 100%;
                        height: 100%;
                        source: root.custom-icon;
                    }
                }
                if root.custom-icon.width <= 0 : AppIcon {
                    name: root.icon;
                    size: 26px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            text-column := VerticalLayout {
                spacing: 2px;
                alignment: center;
                cross-axis-alignment: start;

                if root.title != "" : HorizontalLayout {
                    spacing: 4px;
                    cross-axis-alignment: center;
                    alignment: start;

                    Text {
                        text: root.title;
                        font-size: 13px;
                        font-weight: Theme.font-weight-normal;
                        color: Theme.default-text-color.transparentize(0.1);
                    }

                    for tag[index] in root.tags : Rectangle {
                        height: 17px;
                        width: tag-label.preferred-width + 14px;
                        border-radius: 100px;
                        border-width: 1px;
                        border-color: Theme.blue;
                        background: transparent;

                        tag-label := Text {
                            text: tag;
                            font-size: 11px;
                            font-weight: Theme.font-weight-normal;
                            color: Theme.default-text-color.transparentize(0.1);
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    if root.resetable : reset-button := Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 3px;
                        background: reset-touch.has-hover ? #ffffff1c : transparent;
                        opacity: reset-touch.pressed ? 0.8 : 1.0;

                        AppIcon {
                            name: "refresh";
                            size: 16px;
                            icon-color: Theme.default-text-color.transparentize(0.1);
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        reset-touch := TouchArea {
                            clicked => { root.reset(); }
                        }
                    }

                    // The Vue wraps the spinner in `<Transition name="fade">`
                    // (100ms opacity). Keeping the box in the tree and animating
                    // its opacity is what gives the fade: a freshly created
                    // element would simply appear.
                    loading-box := Rectangle {
                        width: 15px;
                        height: 15px;
                        background: transparent;
                        opacity: root.loading ? 1.0 : 0.0;
                        visible: root.loading || self.opacity > 0.001;
                        // The Vue's `<span style="transform: scale(0.8)">`.
                        transform-scale: 80%;
                        animate opacity { duration: 100ms; easing: ease; }

                        BaseLoading {
                            size: 15px;
                            stroke-width: 8;
                            icon-color: Theme.default-text-color.transparentize(0.1);
                        }
                    }
                }

                if root.description != "" : Text {
                    text: root.description;
                    font-size: 12px;
                    font-weight: Theme.font-weight-normal;
                    // CSS: rgba(default-text, 0.849) at 60% element opacity.
                    color: Theme.default-text-color.with-alpha(0.509);
                    wrap: word-wrap;
                    line-height-factor: 1.1;
                }
            }
        }

        // ----- right: control / chevron -----
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 0px;
            cross-axis-alignment: center;

            if root.navigable : AppIcon {
                name: "chevron-forward";
                size: 17px;
                icon-color: Theme.default-text-color.transparentize(0.1);
            }

            // `.setting-item .icon` chevron has `margin-right: 4px`.
            if root.navigable : Rectangle {
                width: 4px;
                background: transparent;
            }

            @children
        }
    }

    // Disabled rows swallow pointer events (CSS `pointer-events: none`).
    if root.item-disabled : TouchArea {
        width: root.width;
        height: root.height;
    }
}
