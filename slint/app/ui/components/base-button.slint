import { Theme } from "../theme.slint";
import { FocusManager } from "../globals/focus.slint";

// Small button (src/components/BaseButton.vue). Used for "Remove image", the
// dialog buttons, …
//
// The Vue component is `width: 100%`: it fills whatever row it is placed in,
// which in an auto-sized flex row means shrinking to its content. Slint has no
// such two-way sizing, so the width is the label plus the 16px horizontal
// padding by default and callers that put the button in a sized row (the
// create-instance dialog's button pair) pass `button-width` explicitly.
export component BaseButton inherits Rectangle {
    in property <string> text: "";
    in property <color> text-color: Theme.default-text-color.transparentize(0.1);
    in property <bool> button-enabled: true;
    /// 0 keeps the content width.
    in property <length> button-width: 0px;
    /// Fills the button instead of the default surface. The Vue's callers set
    /// an inline `background`, which beats the class and so covers the hover and
    /// pressed states too — the accented buttons of the add-account dialog are
    /// exactly that. `transparent` (the default) keeps the default look.
    in property <color> button-background: transparent;
    callback clicked;

    width: root.button-width > 0px ? root.button-width : button-label.preferred-width + 32px;
    height: 30px;
    border-radius: Theme.controllers-border-radius;
    border-width: 1px;
    border-color: Theme.controllers-border;
    // Vue BaseButton: normal `--controllers-background`, hover `surface2` at
    // 85%, active raw `surface2`.
    background: root.button-background != transparent ? root.button-background
        : button-touch.pressed ? Theme.surface-2
        : button-touch.has-hover ? Theme.surface-2.transparentize(0.15)
        : Theme.controllers-background;
    // `&:hover { transform: scale(1.02) }` and `&:active { transform: scale(0.97) }`.
    // A `button-background` pins the fill above and so leaves the press with no
    // feedback of its own — this is what the accented buttons have left, and
    // what the Vue has them do (an inline `background` beats the class, a
    // transform is not part of it).
    transform-scale: button-touch.pressed ? 97% : button-touch.has-hover ? 102% : 100%;
    opacity: root.button-enabled ? 1.0 : 0.5;
    // `transition: all 150ms ease` covers both tracks.
    animate background, transform-scale { duration: 150ms; easing: ease; }

    button-label := Text {
        text: root.text;
        font-size: 11px;
        font-weight: Theme.font-weight-normal;
        color: root.text-color;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    button-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.button-enabled;
        clicked => {
            FocusManager.clear();
            root.clicked();
        }
    }
}
