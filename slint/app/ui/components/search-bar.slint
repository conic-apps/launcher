import { Theme } from "../theme.slint";

// Centered search / command palette opener (BaseSearchBar.vue). The icon is
// the FontAwesome Pro v7 640-viewbox search glyph at the AppIcon default size.
// The hotkey chip lives in the title bar container, not here (App.vue).
export component SearchBar inherits Rectangle {
    in property <string> placeholder;
    callback activated;

    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.controllers-border.transparentize(0.82);
    background: Theme.controllers-background;
    clip: true;

    accessible-role: button;
    accessible-label: root.placeholder;
    accessible-action-default => { root.activated(); }

    Path {
        commands: "M480 272C480 317.9 465.1 360.3 440 394.7L566.6 521.4C579.1 533.9 579.1 554.2 566.6 566.7C554.1 579.2 533.8 579.2 521.3 566.7L394.7 440C360.3 465.1 317.9 480 272 480C157.1 480 64 386.9 64 272C64 157.1 157.1 64 272 64C386.9 64 480 157.1 480 272zM272 416C351.5 416 416 351.5 416 272C416 192.5 351.5 128 272 128C192.5 128 128 192.5 128 272C128 351.5 192.5 416 272 416z";
        viewbox-width: 640;
        viewbox-height: 640;
        width: 20px;
        height: 20px;
        x: 10px;
        y: (root.height - self.height) / 2;
        fill: Theme.text.transparentize(0.1);
    }

    Text {
        text: root.placeholder;
        font-size: 13px;
        color: Theme.text.transparentize(0.2);
        x: 36px;
        y: (root.height - self.height) / 2;
    }

    touch := TouchArea {
        clicked => { root.activated(); }
    }
}