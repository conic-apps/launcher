import { Theme } from "../theme.slint";
import { AppIcon } from "app-icon.slint";
import { FocusManager } from "../globals/focus.slint";

// The instance card: `InstanceSetting.vue`'s `.instance` block, which
// `ConfirmDeleteInstance.vue` repeats almost line for line — so it is one
// component here rather than two near-copies.
//
// Geometry, from `box-sizing: border-box` on `*`:
//
//   the content box starts at  x = 16 (the `border-left`) + 16 (`padding-left`)
//                        and   y =  1 (the 1px hairline)   +  8 (`padding-top`),
//   so the title row sits at (32, 9) and the details 6px under it.
//
// The absolutely positioned `img.background` is placed against the *padding* box,
// which is the border box less the borders: `right: 0` therefore lands its right
// edge 1px inside the card, and `width: calc(100% - 100px)` is 100px off a
// padding box that starts at x = 16 — hence x = 116, not 100.
//
// `transition: border-left 200ms ease, margin 200ms ease` animates nothing: no
// rule anywhere changes either property.
export component InstanceCard inherits Rectangle {
    /// The instance's name; two-way, because the card is where it is edited.
    in-out property <string> name: "";
    /// Whether this card's title row can be edited at all. The settings overlay
    /// can; the delete dialog's copy of the card has no editor.
    in property <bool> name-editable: false;
    /// The Vue's `editingInstanceName`: the title row is swapped for a field.
    in-out property <bool> name-editing: false;
    /// The mod loader's display name, empty for a vanilla instance
    /// (`ModLoaderType::to_string`). The class is `tag <lowercased>`, and
    /// `.tag.vanilla` is what the empty name gets.
    in property <string> loader: "";
    in property <string> minecraft-version: "";
    in property <bool> has-background: false;
    /// The instance's background picture, loaded by Rust. An image that could
    /// not be decoded reports a zero width, which is the same test as the Vue's
    /// `imgLoaded` — the `<img>` is drawn only once it has loaded.
    in property <image> card-background;
    /// The delete dialog's third detail line (its play time). Empty draws
    /// nothing, which is the settings overlay's case: `InstanceSetting.vue` has
    /// no such row.
    in property <string> playtime: "";
    in property <string> playtime-label: "";
    /// The Minecraft version row is drawn even with no version. The delete
    /// dialog's copy of the card has no `v-if` on it; the settings overlay's
    /// has, and passes this at its default.
    in property <bool> version-always: false;
    /// The colour behind the card, which the background image's fade has to be
    /// mixed with: the overlay's panel is `Theme.base`, the create-instance
    /// dialog's `Theme.dialog-background`.
    in property <color> backdrop: Theme.base;

    /// The title row was clicked while it was not being edited — the Vue's
    /// `@click="editInstanceName"`.
    callback name-clicked();
    /// The name was typed. The Vue writes through `v-model` into
    /// `currentInstance.config.name`, which its `watchEffect` then saves.
    callback name-edited();

    /// The fill of `.tag.<loader>`; `.tag.vanilla` is the fallback, since the
    /// Vue applies it to the `v-else` branch.
    pure function tag-color(key: string) -> color {
        if key == "quilt" { return Theme.mauve; }
        if key == "fabric" { return Theme.yellow; }
        if key == "forge" { return Theme.blue; }
        if key == "neoforge" { return Theme.peach; }
        return Theme.green;
    }

    width: 100%;
    height: 60px;
    border-radius: 8px;
    clip: true;
    background: Theme.surface-0.with-alpha(0.4);

    /// `border: 1px solid rgba(var(--ctp-surface1-rgb), 0.8)`.
    Rectangle {
        border-width: 1px;
        border-color: Theme.surface-1.with-alpha(0.8);
        background: transparent;
    }

    /// `border-left: 16px solid rgba(var(--ctp-lavender-rgb), 0.8)`, drawn over
    /// the hairline: Slint has one `border-width` for the whole box.
    Rectangle {
        x: 0;
        y: 0;
        width: 16px;
        height: parent.height;
        background: Theme.lavender.with-alpha(0.8);
    }

    // `img.background`: `object-fit: cover`, pinned to the card's top right and
    // faded out towards the left.
    if root.has-background && root.card-background.width > 0 : Rectangle {
        x: 116px;
        y: 1px;
        width: parent.width - 116px - 1px;
        height: parent.height - 2px;
        background: transparent;

        Image {
            width: 100%;
            height: 100%;
            source: root.card-background;
            image-fit: cover;
        }

        // `mask-image: linear-gradient(to left, black 0%, transparent 100%)`.
        // Slint has no masks, so the card's own fill is laid over the image and
        // faded out to the right instead: at the image's left edge it is exactly
        // what the mask leaves behind there, which is `rgba(surface0, 0.4)` over
        // the backdrop — an opaque 40/60 mix of the two, and `mix` weights its
        // *receiver*, so the backdrop is the one named first.
        Rectangle {
            background: @linear-gradient(
                90deg,
                root.backdrop.mix(Theme.surface-0, 0.6) 0%,
                transparent 100%);
        }
    }

    // ----- `p.instance-name` -----
    if !root.name-editing : name-row := Rectangle {
        x: 32px;
        y: 9px;
        width: parent.width - 49px;
        height: 16px;
        background: transparent;

        name-text := Text {
            x: 0px;
            // `span { max-width: calc(100% - 30px) }` with the ellipsis the row's
            // own `overflow: hidden; white-space: nowrap; text-overflow` put
            // there: the name takes its own width and is cut once it would
            // reach the edit icon 30px away. A bare `Text` outside a layout is
            // centred on its own width, so the alignment is explicit.
            width: min(self.preferred-width, parent.width - 30px);
            height: 16px;
            text: root.name;
            font-size: 16px;
            font-weight: Theme.font-weight-normal;
            color: Theme.default-text-color.transparentize(0.1);
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.name-editable : edit-icon := AppIcon {
            name: "create-outline";
            size: 16px;
            x: name-text.width + 4px;
            icon-color: Theme.default-text-color.transparentize(0.1);
            // `svg:hover { transform: scale(1.02) }` /
            // `svg:active { transform: scale(0.97) }`.
            transform-scale: edit-touch.pressed ? 97% : edit-touch.has-hover ? 102% : 100%;
            animate transform-scale { duration: 100ms; }
        }

        edit-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                FocusManager.clear();
                root.name-clicked();
            }
        }
    }

    // The Vue swaps the `<p>` for a bare `<input>` (`appearance: none; border:
    // none; background: none; height: 100%; width: 100%`), focused as soon as it
    // appears (`nextTick` + `focus()`) and left on `@blur`.
    if root.name-editable && root.name-editing : name-input := TextInput {
        x: 32px;
        y: 9px;
        width: parent.width - 49px;
        height: 16px;
        text <=> root.name;
        font-size: 16px;
        font-weight: Theme.font-weight-normal;
        color: Theme.default-text-color.transparentize(0.1);
        // The macOS backend paints the caret with the selection colour, so a
        // translucent tint yields a text-coloured caret.
        selection-background-color: Theme.default-text-color.with-alpha(0.3);
        selection-foreground-color: Theme.default-text-color;
        single-line: true;
        vertical-alignment: center;
        init => { self.focus(); }
        changed has-focus => {
            if !self.has-focus && root.name-editing {
                root.name-editing = false;
            }
        }
        edited => { root.name-edited(); }
        // Clicking any control elsewhere in the overlay drops the focus (see
        // `FocusManager`), which ends the edit as well.
        private property <int> clear-sequence: FocusManager.clear-sequence;
        changed clear-sequence => { self.clear-focus(); }
    }

    // ----- `.details` -----
    details := HorizontalLayout {
        x: 32px;
        // `margin-top: 6px`, under the 16px title row.
        y: 9px + 16px + 6px;
        width: parent.width - 49px;
        height: 13px;
        // `.tag` carries no margin of its own and every following span an 8px
        // `margin-left`, and the tag is always first.
        spacing: 8px;
        alignment: start;
        cross-axis-alignment: center;

        tag := Rectangle {
            width: tag-text.preferred-width + 12px;
            height: 13px;
            border-radius: 100px;
            background: root.tag-color(root.loader.to-lowercase());

            tag-text := Text {
                text: root.loader == "" ? "Vanilla" : root.loader;
                font-size: 11px;
                // The Vue's `font-weight: 500`.
                font-weight: 500;
                color: Theme.text-inverse;
            }
        }

        // `<span class="minecraft-version">`, which the settings overlay hides
        // when the runtime names no version and the delete dialog always shows.
        if root.version-always || root.minecraft-version != "" : HorizontalLayout {
            spacing: 0px;
            alignment: start;
            cross-axis-alignment: center;

            Text {
                text: "Minecraft: ";
                font-size: 11px;
                // `.label { opacity: 0.8; font-weight: 300 }`.
                font-weight: 300;
                color: Theme.default-text-color.transparentize(0.1).with-alpha(0.72);
            }

            Text {
                text: root.minecraft-version;
                font-size: 11px;
                font-weight: 500;
                color: Theme.default-text-color.transparentize(0.1);
            }
        }

        // `<span class="playtime">` — the delete dialog's third row.
        if root.playtime != "" : HorizontalLayout {
            spacing: 0px;
            alignment: start;
            cross-axis-alignment: center;

            Text {
                text: root.playtime-label;
                font-size: 11px;
                font-weight: 300;
                color: Theme.default-text-color.transparentize(0.1).with-alpha(0.72);
            }

            Text {
                text: root.playtime;
                font-size: 11px;
                font-weight: 500;
                color: Theme.default-text-color.transparentize(0.1);
            }
        }
    }
}
