import { Theme } from "../theme.slint";
import { AppIcon } from "app-icon.slint";
import { FocusManager } from "../globals/focus.slint";

// A titled group of settings (src/components/SettingGroup.vue).
//
// `width: calc(100% - 16px); margin: 0 auto` becomes a full-width layout whose
// items are inset by the settings page (`padding: 0 8px`). The Vue rounds the
// first and last child to 8px and leaves the wrapper's own corners to the
// border; here every row is rounded instead — a row does not know whether it is
// the first or the last — and this wrapper paints the card behind them, in the
// colour a row paints, so the notches their corners leave at the two ends of
// the card and at the 1px seams between rows are filled in.
//
// Clipping the wrapper to its own radius rounds the rows just as well, and is
// what this did before, but it also cuts off the value tooltip a control in the
// first row draws above itself: `.setting-items` has no `overflow` and lets
// that tooltip through.
export component SettingGroup inherits VerticalLayout {
    in property <string> title: "";
    in property <bool> resetable: false;
    in property <bool> danger: false;
    callback reset;

    width: 100%;
    spacing: 10px;

    if root.title != "" : Rectangle {
        height: 16px;
        background: transparent;

        HorizontalLayout {
            padding-left: 8px;
            spacing: 4px;
            cross-axis-alignment: center;
            alignment: start;

            Text {
                text: root.title;
                font-size: 13.5px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
            }

            if root.resetable : Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 3px;
                background: group-reset-touch.has-hover ? #ffffff1c : transparent;
                opacity: group-reset-touch.pressed ? 0.8 : 1.0;

                AppIcon {
                    name: "refresh";
                    size: 16px;
                    icon-color: Theme.default-text-color.transparentize(0.1);
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                group-reset-touch := TouchArea {
                    clicked => {
                        FocusManager.clear();
                        root.reset();
                    }
                }
            }
        }
    }

    items := Rectangle {
        width: 100%;
        border-radius: 8px;
        background: Theme.setting-item-background;

        VerticalLayout {
            spacing: 1px;
            @children
        }

        // `--setting-group-border` (Latte, and every high-contrast scheme).
        // Drawn as an overlay after the rows so the 1px hairline sits on top;
        // it is transparent (no-op) on the dark flavors without high contrast.
        group-border := Rectangle {
            width: 100%;
            height: 100%;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.danger
                ? Theme.setting-group-danger-border
                : Theme.setting-group-border;
            background: transparent;
        }
    }
}
