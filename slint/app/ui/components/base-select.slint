import { Theme } from "../theme.slint";
import { FocusManager } from "../globals/focus.slint";

// Segmented select (src/components/BaseSelect.vue).
//
// A row of options with 1px separators, the active option filled with the
// lavender accent. The Vue component has no explicit width: it shrinks to its
// content and grows to fit it, which Slint handles by deriving the component's
// preferred size from the inner layout.
export component BaseSelect inherits Rectangle {
    in property <[string]> options;
    in property <[string]> display-name;
    /// Which options can be picked, parallel to `options`; shorter than
    /// `options` means "the remaining ones are enabled".
    ///
    /// The Vue takes the *names* that cannot be picked (`disabled: string[]`).
    /// Slint arrays have no `contains` (only the experimental `index-of`), so
    /// the caller derives a flag per option instead.
    in property <[bool]> option-enabled: [];
    in-out property <string> value;
    callback selected(string);

    // CSS: option height 22px + 1px border on each side of the (auto-height)
    // wrapper => 24px total (box-sizing: border-box).
    //
    // The width is the options' own width plus those borders: without it the
    // select has no preferred size, and a layout would stretch it (and its last
    // option with it) to whatever space is left.
    width: options-row.preferred-width + 2px;
    height: 24px;
    background: Theme.controllers-background;
    border-width: 1px;
    border-color: Theme.controllers-border;
    border-radius: 4px;
    clip: true;

    options-row := HorizontalLayout {
        for option[index] in root.options : Rectangle {
            width: option-label.preferred-width + 16px;
            height: 22px;
            background: root.value == option ? Theme.lavender : transparent;
            // CSS `.disabled { opacity: 0.4; }`
            opacity: index < root.option-enabled.length && !root.option-enabled[index] ? 0.4 : 1.0;

            option-label := Text {
                text: root.display-name[index];
                font-size: 12px;
                font-weight: Theme.font-weight-normal;
                color: root.value == option ? Theme.text-inverse : Theme.default-text-color.transparentize(0.1);
                x: 8px;
                y: (parent.height - self.height) / 2;
            }

            // separator (all but the last option)
            if index < root.options.length - 1 : Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: Theme.controllers-border;
            }

            TouchArea {
                width: parent.width;
                height: parent.height;
                // CSS `pointer-events: none` on a disabled option.
                enabled: index >= root.option-enabled.length || root.option-enabled[index];
                clicked => {
                    FocusManager.clear();
                    root.value = option;
                    root.selected(option);
                }
            }
        }
    }
}
