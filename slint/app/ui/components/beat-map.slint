import { Theme } from "../theme.slint";
import { MusicState } from "../globals/music.slint";

// Audio visualizer (src/components/BeatMap.vue).
//
// A row of bars across the container: the live spectrum while a track is playing,
// and a 2px baseline in `surface2` when it is not. The Vue drew it into a
// `<canvas>` sized to the container times the device pixel ratio; this draws the
// same bars as elements, in logical pixels, which is the one difference — see
// `src/music.rs` for why the spectrum-to-bars maths is on the Rust side rather
// than in a binding.
//
// The colours come from a gradient the Vue built once for the whole canvas, from
// `lavender` at the bottom to `blue` at the top. A gradient here is relative to
// the element it fills, so a bar draws the range *it* covers: from `lavender` at
// its own foot to wherever the canvas gradient is at the bar's head. That is the
// same colour everywhere, which is what `level` (a fraction of the canvas height)
// is for.
export component BeatMap inherits Rectangle {
    /// The Vue's `.fill`: take the whole container and drop the block's own
    /// `border-radius` (and, with `transparent`, its opaque background). The
    /// size itself is the caller's, for the reason above.
    in property <bool> fill: false;
    /// Skip the opaque background so the parent shows through.
    in property <bool> transparent: false;
    /// Live spectrum (`MusicState.live`, the Vue's `analyser && hasTrack &&
    /// isPlaying`) or the idle baseline.
    in property <bool> live: MusicState.live;
    /// One bar height per bar, 0..1 of `height`.
    in property <[float]> levels: MusicState.levels;
    /// `minBarWidth`, in logical pixels: the bar count is the container's width
    /// divided by this, which is what the Vue's `resizeCanvas` did on every
    /// resize. A plain number because Slint cannot divide one length by another.
    in property <float> min-bar-width: 10;
    /// The Vue's `ResizeObserver` reported a resize; the bar count — and through
    /// it the analyser's resolution — follow.
    callback resized(int);

    width: 100%;
    height: 100%;
    // `border-radius: 8px`, dropped by `.fill`. The fixed block's own 48px
    // height is a state rather than a ternary, because Slint will not unify the
    // `100%` of a filled box with a `48px` length in one expression.
    states [
        block when !root.fill : {
            height: 48px;
        }
    ]
    background: (root.fill || root.transparent) ? Colors.transparent : Theme.mantle;

    // ----- geometry (BeatMap.vue's module constants) -----
    private property <int> bar-count: clamp(
        floor(root.width / 1px / root.min-bar-width),
        32,
        256,
    );
    private property <length> bar-width: root.width / root.bar-count;
    // `Math.max(1, Math.floor(barWidth * 0.25))`.
    private property <length> bar-gap: max(1px, floor(root.bar-width * 0.25 / 1px) * 1px);
    /// `Math.max(barHeight, 1)`, the floor that keeps a silent bar visible.
    private property <length> min-bar-height: 1px;
    /// The idle branch's 2px baseline, `height - 2`.
    private property <length> idle-height: 2px;

    // The Vue's `ResizeObserver` fired on the container's box changing, which for
    // this app is the window being resized. `init` is what covers the first
    // layout: the width is not known yet, so the count is the `MIN_BARS` floor,
    // and a window that really is that narrow leaves it there — which is the right
    // answer either way.
    init => {
        root.resized(root.bar-count);
    }

    changed bar-count => {
        root.resized(root.bar-count);
    }


    // The frame pump: the spectrum is a *pull* from Rust, so something has to ask
    // for it once per frame, and a window with an animation in flight is one
    // Slint keeps painting. The item is zero-sized, so nothing on screen depends
    // on the value (the same trick as `window-background.slint`'s).
    if root.visible && root.live : Rectangle {
        x: (animation-tick() / 1s) * 1px;
        width: 0;
        height: 0;
    }

    // The live branch: one bar per level. `levels` is empty whenever `live` is
    // false, so the guard is belt and braces — but the idle branch below is
    // gated on `!live`, and the two should agree about which one owns the bars.
    if root.live : live-bars := Rectangle {
        for level[index] in root.levels : Rectangle {
            x: floor(index * root.bar-width / 1px) * 1px;
            y: root.height - self.height;
            width: root.bar-width - root.bar-gap;
            // The live branch's `barHeight`, with the `Math.max(…, 1)` that keeps a
            // silent bar visible.
            height: max(root.min-bar-height, level * root.height);
            // The Vue's canvas gradient, drawn for the part of it this bar
            // covers: from `lavender` at the bar's own foot to wherever the canvas
            // gradient is at the bar's head, which is what `level` — a fraction of
            // the canvas height — is for.
            background: @linear-gradient(
                0deg,
                Theme.lavender 0%,
                Theme.lavender.mix(Theme.blue, level) 100%,
            );
        }
    }

    // The idle branch: the same number of bars, two pixels of `surface2` at the
    // bottom, which is what the Vue drew when there was no spectrum to read. It
    // is its own loop because a gradient cannot share a `background` ternary
    // with a plain colour — the two do not unify into a brush, and the bars come
    // out invisible.
    if !root.live : idle := Rectangle {
        // One bar per `barCount`, which is what an integer as a model repeats
        // over.
        for index in root.bar-count : Rectangle {
            x: floor(index * root.bar-width / 1px) * 1px;
            y: root.height - root.idle-height;
            width: root.bar-width - root.bar-gap;
            height: root.idle-height;
            background: Theme.surface-2;
        }
    }
}
