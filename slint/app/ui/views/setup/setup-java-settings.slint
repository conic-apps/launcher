import { Theme } from "../../theme.slint";
import { AppConfig } from "../../globals/settings.slint";
import { SetupWizardState } from "../../globals/setup.slint";
import { SettingsJvm } from "../settings/settings-jvm.slint";
import { WizardTitle, WizardMessage, WizardWarning } from "wizard-text.slint";

// src/views/setup/SetupWizardJavaSettings.vue
//
// The screen is the settings page's Java section with the wizard's two
// overrides on top: the groups run the body's full width rather than the
// settings page's `width: calc(100% - 16px)`, and the section carries the
// inline `margin-top: 16px`.
//
// The Vue wraps the section in a second `ScrollView`. It is not reproduced, and
// nothing scrolls differently without it: `.wrapper { height: 100% }` resolves
// against an auto-height block parent, so that inner scroll area grows with its
// content and never scrolls — the body's own `ScrollView` is what moves, in the
// Vue as here.
export component SetupJavaSettings inherits VerticalLayout {
    width: 100%;
    spacing: 0px;
    alignment: start;

    // The Vue's `onMounted`: a platform that cannot fetch a Java runtime gets
    // the auto-install switch turned off, since it would never resolve. The
    // screen is created when the step is entered and destroyed when it is
    // left, so this runs once per visit, exactly as `onMounted` does.
    init => {
        if !SetupWizardState.jvm-auto-install-supported && AppConfig.prefer-mojang-java {
            AppConfig.prefer-mojang-java = false;
            AppConfig.changed();
        }
    }

    WizardTitle { title: @tr("SetupJavaSettings" => "Java settings"); }

    if SetupWizardState.jvm-auto-install-supported : WizardMessage {
        message: @tr("SetupJavaSettings" => "Conic Launcher can greatly simplify Java environment configuration. Enable \"Auto-install Java runtime\" to avoid manual installation!");
    }

    if !SetupWizardState.jvm-auto-install-supported : WizardWarning {
        message: @tr("SetupJavaSettings" => "Note: Auto-installation of Java may not be available on the current platform. It is recommended to install Java manually and disable \"Auto-install Java runtime\"");
    }

    // `style="margin-top: 16px"` on the `<SettingsJVM>` element.
    Rectangle {
        width: 100%;
        height: 16px;
        background: transparent;
    }

    SettingsJvm {
        // `:deep(.setting-group), :deep(.setting-collapse) { width: 100% }`.
        group-inset: 0px;
    }
}
