import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/app-icon.slint";
import { GameState, GameIntro } from "../../globals/game.slint";
import { DropdownOption } from "../../globals/dropdown.slint";
import { InstanceListDropdown } from "instance-list-dropdown.slint";

// Search + sort/group toolbar above the instance list
// (src/views/game/InstancesListToolBar.vue). Anchored to the top-right.
export component InstancesListToolBar inherits Rectangle {
    width: 400px;
    height: 112px;
    // The root is only the 400×112 box `InstancesList` positions against; the
    // panel the Vue `.tool-bar` element corresponds to — background included —
    // is `body` below, because the intro animates that whole element.
    background: transparent;
    // NOTE: the `z-index: 114` of the Vue original is *not* set here. A component
    // root's `z` only reaches the parent's stacking order when the parent places
    // it from a `for` loop — for a plain instance the compiler's z-order pass
    // reads the instance's own binding and drops the rest. `InstancesList` sets it
    // where the toolbar has to sit above the scrolling rows.

    private property <[DropdownOption]> sort-options: [
    { key: "name", label: @tr("Name"), icon: "" },
    { key: "version", label: @tr("Version"), icon: "" },
    { key: "playtime", label: @tr("Play time"), icon: "" },
    { key: "lastplay", label: @tr("Last played"), icon: "" },
    ];
    private property <[DropdownOption]> group-options: [
    { key: "none", label: @tr("Ungrouped"), icon: "" },
    { key: "loader", label: @tr("Mod loader"), icon: "" },
    ];

    private property <string> sort-label:
    GameState.sort-mode == "name" ? @tr("Name")
    : GameState.sort-mode == "version" ? @tr("Version")
    : GameState.sort-mode == "lastplay" ? @tr("Last played")
    : @tr("Play time");
    private property <string> group-label:
    GameState.group-mode == "loader" ? @tr("Mod loader") : @tr("Ungrouped");

    // Intro: the toolbar slides in from 100px to the right over 0.5s
    // `power3.out` (`power3` is GSAP's quart, Slint's `ease-out-quart`). It is the
    // first beat of the list's intro, which the game view starts 0.05s after the
    // footer and the summary, so the shared delay is 50ms.
    private property <length> intro-dx: GameIntro.played ? 0px : 100px;
    private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;

    animate intro-dx { duration: 500ms; delay: 50ms; easing: ease-out-quart; }
    animate intro-alpha { duration: 500ms; delay: 50ms; easing: ease-out-quart; }

    // The whole panel is one element in the Vue original: the intro animates
    // `.tool-bar` itself (`gsap.fromTo(toolbar, { opacity: 0, x: 100 }, ...)`),
    // so the translucent background slides in together with the controls rather
    // than staying put under them.
    body := Rectangle {
        x: root.intro-dx;
        y: 0;
        width: root.width;
        height: root.height;
        background: Theme.surface-0.transparentize(0.6);
        border-top-left-radius: 16px;
        border-bottom-left-radius: 16px;
        opacity: root.intro-alpha;
        visible: root.intro-alpha > 0.01;

        // The panel is drawn on top of the scrolling rows, but a bare
        // `Rectangle` does not take pointer events: Slint dispatches to the
        // topmost item first and falls through to the items below whenever one
        // ignores the event, so a press on the panel's empty area would reach the
        // card underneath and select it (Vue: the toolbar's `z-index: 114` puts
        // it above the rows, so it covers the press). The shield swallows it; it
        // is declared first so the controls below still get their own events.
        shield := TouchArea {
            width: parent.width;
            height: parent.height;
            // A bare `TouchArea`'s `scroll-event` defaults to `reject`, which
            // would let the wheel through to the list. Vue's Lenis listens on the
            // scroll container, which the panel covers, so accept it to match.
            scroll-event(event) => { accept }
        }

        // `.search { margin-top: 16px; margin-left: 16px }` and `.other {
        // margin-left: 16px; margin-top: 12px }` are a padding and a `gap`. The
        // 68px the second row sat at was `16 + 40 + 12` written out, the 332px
        // was the row less a 40px button, and the two 182px dropdowns were half
        // of what was left.
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;

            // ----- search -----
            // `.search { display: flex }` of a `width: 100%` field and a
            // `flex-shrink: 0` 40px button.
            search-row := HorizontalLayout {
                height: 40px;

                input-box := Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.surface-0;
                    border-top-left-radius: 8px;
                    border-bottom-left-radius: 8px;

                    // `input { padding-left: 16px; height: 100% }`.
                    HorizontalLayout {
                        padding-left: 16px;
                        cross-axis-alignment: center;

                        Text {
                            text: @tr("Search...");
                            font-size: 14px;
                            color: Theme.default-text-color.transparentize(0.4);
                            visible: GameState.search-query == "";
                        }

                        TextInput {
                            horizontal-stretch: 1;
                            text: GameState.search-query;
                            font-size: 14px;
                            single-line: true;
                            vertical-alignment: center;
                            edited => { GameState.search-changed(self.text); }
                        }
                    }
                }

                search-button := Rectangle {
                    width: 40px;
                    background: search-touch.pressed ? Theme.surface-2
                    : search-touch.has-hover ? Theme.surface-2.transparentize(0.2)
                    : Theme.surface-1;
                    border-top-right-radius: 8px;
                    border-bottom-right-radius: 8px;

                    // `.search-button { display: flex; align-items: center;
                    // justify-content: center }`.
                    HorizontalLayout {
                        alignment: center;
                        cross-axis-alignment: center;

                        AppIcon {
                            name: "search";
                            size: 20px;
                        }
                    }

                    search-touch := TouchArea { }
                }
            }

            // ----- sort / group -----
            // `.other { display: flex; gap: 8px }` with `> div { flex: 1 }` on
            // both, so each takes half of what is left. `flex: 1` is a zero
            // basis and a grow of 1, which is an *exact* half of the row;
            // `horizontal-stretch: 1` on its own is not, because it only hands
            // out the space left over after each child's preferred size, and
            // these two prefer different widths ("Sort" against "Group",
            // "Play time" against "Ungrouped"). So the half is stated, and the
            // stretch kept only so the row still divides rather than packing.
            other-row := HorizontalLayout {
                height: 25px;
                spacing: 8px;

                InstanceListDropdown {
                    preferred-width: (other-row.width - other-row.spacing) / 2;
                    horizontal-stretch: 1;
                    label: @tr("Sort");
                    selected: root.sort-label;
                    options: root.sort-options;
                    selected-key: GameState.sort-mode;
                    dropdown-id: "instance-sort";
                    select(key) => { GameState.set-sort(key); }
                }

                InstanceListDropdown {
                    preferred-width: (other-row.width - other-row.spacing) / 2;
                    horizontal-stretch: 1;
                    label: @tr("Group");
                    selected: root.group-label;
                    options: root.group-options;
                    selected-key: GameState.group-mode;
                    dropdown-id: "instance-group";
                    select(key) => { GameState.set-group-mode(key); }
                }
            }
        }
    }
}
