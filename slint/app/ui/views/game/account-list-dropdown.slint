import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/app-icon.slint";
import { AccountItem } from "../../globals/game.slint";
import { Dropdown } from "../../globals/dropdown.slint";
import { FocusManager } from "../../globals/focus.slint";

export component AccountListDropdown inherits Rectangle {
    in property <string> name: "";
    in property <string> kind: "";
    in property <[AccountItem]> players: [];
    in property <string> current-key: "";
    in property <string> dropdown-id: "account-switcher";
    callback select(string);

    out property <bool> opened: root.is-open;

    height: 36px;
    width: 32px + name-text.preferred-width + 36px;
    background: Theme.surface-0;
    border-radius: 8px;
    drop-shadow-color: #00000033;
    drop-shadow-blur: 10px;

    private property <bool> is-open: Dropdown.open && Dropdown.owner == root.dropdown-id;
    private property <float> chevron-flip: root.is-open ? 1.0 : 0.0;
    animate chevron-flip { duration: 200ms; easing: ease-in-out; }

    private property <length> panel-height: root.players.length * 26px
        + max(0, root.players.length - 1) * 4px + 18px;
    private property <int> serial: Dropdown.choose-serial;
    changed serial => {
        if Dropdown.choose-owner == root.dropdown-id {
            root.select(Dropdown.chosen);
        }
    }

    name-text := Text {
        text: root.name;
        font-size: 14px;
        font-weight: Theme.font-weight-normal;
        color: Theme.default-text-color.transparentize(0.1);
        x: 32px;
        y: (parent.height - self.height) / 2;
    }

    switch-btn := Rectangle {
        x: parent.width - 36px;
        y: 0;
        width: 36px;
        height: parent.height;
        background: switch-touch.pressed ? Theme.overlay-0
            : switch-touch.has-hover ? Theme.surface-2
            : Theme.surface-1;
        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;

        AppIcon {
            name: "chevron-up";
            size: 16px;
            icon-color: Theme.default-text-color.transparentize(0.1);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            transform-scale-y: (1.0 - 2.0 * root.chevron-flip) * 100%;
            opacity: 1.0 - 0.3 * (1.0 - abs(1.0 - 2.0 * root.chevron-flip));
        }

        switch-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                FocusManager.clear();
                if (root.is-open) {
                    Dropdown.open = false;
                } else {
                    Dropdown.options = [];
                    Dropdown.accounts = root.players;
                    Dropdown.account-mode = true;
                    Dropdown.current = root.current-key;
                    Dropdown.owner = root.dropdown-id;
                    Dropdown.anchor-x = root.absolute-position.x;
                    Dropdown.anchor-y = root.absolute-position.y - root.panel-height - 4px;
                    Dropdown.anchor-width = root.width;
                    Dropdown.expand-upwards = true;
                    Dropdown.open = true;
                }
            }
        }
    }
}
