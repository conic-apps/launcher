import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/app-icon.slint";
import { AccountAvatar } from "../../components/account-avatar.slint";
import { AccountItem } from "../../globals/game.slint";

// Profile name + account switcher pill (src/views/game/AccountListDropdown.vue).
// The list opens upward and is right-aligned to the trigger.
export component AccountListDropdown inherits Rectangle {
    in property <string> name: "";
    in property <string> kind: "";
    in property <[AccountItem]> players: [];
    in property <string> current-key: "";
    in-out property <bool> opened: false;
    callback select(string);

    height: 36px;
    width: 32px + name-text.preferred-width + 36px;
    background: Theme.surface-0;
    border-radius: 8px;
    drop-shadow-color: #00000033;
    drop-shadow-blur: 10px;

    private property <length> panel-height:
        root.players.length * 26px + max(0, root.players.length - 1) * 8px + 16px;

    name-text := Text {
        text: root.name;
        font-size: 14px;
        font-weight: Theme.font-weight-normal;
        color: Theme.default-text-color.transparentize(0.1);
        x: 32px;
        y: (parent.height - self.height) / 2;
    }

    switch-btn := Rectangle {
        x: parent.width - 36px;
        y: 0;
        width: 36px;
        height: parent.height;
        background: switch-touch.pressed ? Theme.overlay-0
            : switch-touch.has-hover ? Theme.surface-2
            : Theme.surface-1;
        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;

        AppIcon {
            name: "chevron-up";
            size: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        switch-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.opened = !root.opened; }
        }
    }

    if root.opened : Rectangle {
        x: parent.width - self.width;
        y: -(root.panel-height + 4px);
        width: root.width;
        height: root.panel-height;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.controllers-border;
        background: Theme.base;
        drop-shadow-color: #4500611d;
        drop-shadow-blur: 10px;
        z: 100000;

        VerticalLayout {
            x: 10px;
            y: 8px;
            width: parent.width - 20px;
            height: parent.height - 16px;
            spacing: 8px;

            for player in root.players : Rectangle {
                height: 26px;
                border-radius: 6px;
                background: player.key == root.current-key ? #ffffff17
                    : player-touch.has-hover ? #ffffff1f
                    : transparent;
                animate background { duration: 30ms; }

                AccountAvatar {
                    size: 18px;
                    kind: player.kind;
                    x: 8px;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: player.name;
                    font-size: 12px;
                    font-weight: Theme.font-weight-normal;
                    color: Theme.default-text-color.transparentize(0.1);
                    x: 34px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 42px;
                    overflow: elide;
                    wrap: no-wrap;
                }

                player-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    clicked => {
                        root.opened = false;
                        root.select(player.key);
                    }
                }
            }
        }
    }
}
