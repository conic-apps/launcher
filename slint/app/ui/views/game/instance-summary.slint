import { Theme } from "../../theme.slint";
import { AppIcon } from "../../components/app-icon.slint";
import { BaseLoading } from "../../components/base-loading.slint";
import { Dropdown, DropdownOption } from "../../globals/dropdown.slint";
import { FocusManager } from "../../globals/focus.slint";
import { GameState, GameIntro, GameTime } from "../../globals/game.slint";

// A labelless metadata column (label on top, value below) used by the detail
// row of the current-instance summary.
component MetaColumn inherits Rectangle {
    in property <string> label;
    in property <string> value;

    width: layout.preferred-width;
    height: layout.preferred-height;
    background: transparent;

    layout := VerticalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        padding-left: 4px;
        padding-right: 4px;
        spacing: 2px;
        alignment: start;

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: Theme.font-weight-normal;
            color: Theme.default-text-color.with-alpha(0.8);
        }
        Text {
            text: root.value;
            font-size: 15px;
            font-weight: Theme.font-weight-normal;
            color: Theme.default-text-color.transparentize(0.1);
        }
    }
}

// The 1px divider between metadata columns (`margin: 0 8px`).
component MetaSeparator inherits Rectangle {
    width: 17px;
    height: 26px;
    background: transparent;

    Rectangle {
        x: 8px;
        width: 1px;
        height: 26px;
        background: Theme.surface-2;
    }
}

// One preview row of the current-instance contents list.
component ContentRow inherits Rectangle {
    in property <string> icon;
    in property <string> type-label;
    in property <int> count: 0;
    /// The row's preview icons, at most five.
    in property <[image]> icons: [];
    in property <bool> loading: false;
    in property <bool> disabled: false;
    in property <string> unit: "";
    callback clicked;

    width: 400px;
    height: 36px;
    border-radius: 8px;
    background: row-touch.pressed ? Theme.surface-1
    : row-touch.has-hover ? Theme.surface-0
    : Theme.surface-0.with-alpha(0.7);
    opacity: root.disabled ? 0.6 : 1.0;
    animate background { duration: 100ms; }

    // `.current-instance-contents > div { padding: 8px 16px }` — a padding, not
    // three hand-kept numbers. The layout fills the row by default.
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 0px;
        cross-axis-alignment: center;

        // left: icon + type
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            cross-axis-alignment: center;
            alignment: start;

            AppIcon {
                name: root.icon;
                size: 20px;
            }
            Text {
                text: root.type-label;
                font-size: 14px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
            }
        }

        // right: preview dots + count / spinner
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 8px;
            cross-axis-alignment: center;

            // `InstanceSummary.vue`'s `.content-img`: the first five items of
            // the row, each a 20px circle with a 1px lavender outline, 1px
            // apart. The icons are decoded by `content.rs`.
            HorizontalLayout {
                spacing: 1px;
                cross-axis-alignment: center;
                for icon in root.icons : Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10000px;
                    border-width: 1px;
                    border-color: Theme.lavender.with-alpha(0.8);
                    background: Theme.surface-1;
                    clip: true;

                    Image {
                        x: 1px;
                        y: 1px;
                        width: 18px;
                        height: 18px;
                        source: icon;
                        image-fit: cover;
                    }
                }
            }

            if root.loading : BaseLoading {
                size: 16px;
                stroke-width: 6;
            }
            if !root.loading : Text {
                text: "\{root.count} \{root.unit}";
                font-size: 14px;
                font-weight: Theme.font-weight-normal;
                color: Theme.default-text-color.transparentize(0.1);
            }
        }
    }

    row-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }
}

// The current-instance panel: title, metadata row, launch/actions row and the
// local-content previews (src/views/game/InstanceSummary.vue).
//
// The four blocks are stacked by a `VerticalLayout` with a 16px `spacing` — the
// Vue's `margin-top: 16px` on three of them — so the panel's height is the
// layout's own rather than a running sum down to the last block.
//
// The intro slides each block in horizontally, and Slint *refuses* an `x` on a
// layout child rather than merely overriding it, so a block cannot carry its own
// slide where it sits in the stack. Each block is therefore wrapped twice: a
// plain `Rectangle` cell that the layout positions, and inside it a second
// `Rectangle` that carries the `x`, one level down where `x` is its own again.
export component InstanceSummary inherits Rectangle {
    // The panel is as wide as its widest block, which the layout reports.
    width: stack.preferred-width;
    height: stack.preferred-height;
    background: transparent;

    // Vue `playIntro`: the three detail rows slide in from -50px over 0.33s
    // `power3.out` (GSAP's `power3` is quart, Slint's `ease-out-quart`), staggered
    // by 0.03s; the four content previews repeat the same steps starting 0.03s
    // after the first batch started.
    private property <duration> intro-stagger: 30ms;
    private property <[DropdownOption]> launch-options: [
    { key: "repair", label: @tr("Repair game and launch"), icon: "build" },
    ];
    private property <bool> launch-menu-is-open: Dropdown.open && Dropdown.owner == "launch-menu";
    private property <float> launch-chevron-flip: root.launch-menu-is-open ? 1.0 : 0.0;
    animate launch-chevron-flip { duration: 200ms; easing: ease-in-out; }
    out property <bool> launch-menu-opened: root.launch-menu-is-open;
    private property <int> dropdown-serial: Dropdown.choose-serial;
    changed dropdown-serial => {
        if Dropdown.choose-owner == "launch-menu" {
            Dropdown.open = false;
            GameState.repair-and-launch();
        }
    }

    stack := VerticalLayout {
        spacing: 16px;
        cross-axis-alignment: start;

        // ----- row-1: instance name -----
        row1-cell := Rectangle {
            background: transparent;

            // The slide, one level down: Slint *refuses* an `x` on a layout
            // child, so the cell cannot carry it and its own child does.
            row1-slide := Rectangle {
                background: transparent;
                x: self.intro-dx;
                opacity: self.intro-alpha;

                private property <length> intro-dx: GameIntro.played ? 0px : -50px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                // First beat: no delay.
                animate intro-dx { duration: 330ms; easing: ease-out-quart; }
                animate intro-alpha { duration: 330ms; easing: ease-out-quart; }

                title1 := Text {
                    text: GameState.has-current ? GameState.current-name : @tr("no instance selected!");
                    font-size: 38px;
                    font-weight: Theme.font-weight-normal;
                    color: Theme.default-text-color.transparentize(0.1);
                }
            }
        }

        // ----- row-2: metadata -----
        row2-cell := Rectangle {
            background: transparent;

            row2-slide := Rectangle {
                background: transparent;
                x: self.intro-dx;
                opacity: self.intro-alpha;

                private property <length> intro-dx: GameIntro.played ? 0px : -50px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dx { duration: 330ms; delay: 1 * root.intro-stagger; easing: ease-out-quart; }
                animate intro-alpha { duration: 330ms; delay: 1 * root.intro-stagger; easing: ease-out-quart; }

                // `vertical-stretch: 0` because the panel's height comes from
                // this layout: a child that fills would ask the parent for its
                // height, which asks it again.
                row2 := HorizontalLayout {
                    spacing: 0px;
                    cross-axis-alignment: center;
                    vertical-stretch: 0;
                    horizontal-stretch: 0;

                    MetaColumn {
                        label: @tr("Minecraft version");
                        value: GameState.has-current ? GameState.current-minecraft : "--";
                    }

                    if GameState.current-has-loader : MetaSeparator { }
                    if GameState.current-has-loader : MetaColumn {
                        label: "\{GameState.current-loader} \{@tr("version")}";
                        value: GameState.current-loader-version;
                    }

                    MetaSeparator { }
                    MetaColumn {
                        label: @tr("Last played date");
                        value: GameState.has-current
                        ? GameTime.last-played(
                        GameState.current-last-played-kind,
                        GameState.current-last-played-hours,
                        GameState.current-last-played-month,
                        GameState.current-last-played-day,
                        GameState.current-last-played-year,
                        )
                        : "--";
                    }

                    if GameState.current-has-playtime : MetaSeparator { }
                    // `<AppIcon name="time" :size="22" style="margin-right: 2px">`, and the
                    // `MetaColumn` beside it carries the `p { padding: 2px 4px }` the Vue
                    // puts every metadata cell in — so the gap is 2 + 4 = 6px, and the row's
                    // `spacing: 0px` supplied none of it.
                    if GameState.current-has-playtime : time-icon := HorizontalLayout {
                        spacing: 0px;
                        cross-axis-alignment: center;
                        padding-right: 2px;

                        AppIcon {
                            name: "time";
                            size: 22px;
                        }
                    }
                    if GameState.current-has-playtime : MetaColumn {
                        label: @tr("Play time");
                        value: GameTime.play-time(GameState.current-playtime-kind, GameState.current-playtime-value);
                    }
                }
            }
        }

        // ----- row-3: launch + actions -----
        row3-cell := Rectangle {
            background: transparent;

            row3-slide := Rectangle {
                background: transparent;
                x: self.intro-dx;
                opacity: self.intro-alpha;

                private property <length> intro-dx: GameIntro.played ? 0px : -50px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dx { duration: 330ms; delay: 2 * root.intro-stagger; easing: ease-out-quart; }
                animate intro-alpha { duration: 330ms; delay: 2 * root.intro-stagger; easing: ease-out-quart; }

                // `.row-3 { display: flex; align-items: center }` with the actions 16px
                // after the launch buttons (`div.actions { margin-left: 16px }`), which
                // is what puts the 32px pills 5px below the top of the 42px launch
                // button — as `align-items: center` does and pinning them to the top did
                // not.
                row3 := HorizontalLayout {
                    spacing: 16px;
                    cross-axis-alignment: center;
                    vertical-stretch: 0;
                    horizontal-stretch: 0;

                    // `.launch-sub-button { margin-left: 2px }` beside a 128px
                    // button, so `spacing: 2px` and the 130px falls out.
                    launch-buttons := HorizontalLayout {
                        vertical-stretch: 0;
                        width: 154px;
                        height: 42px;
                        cross-axis-alignment: stretch;
                        spacing: 2px;

                        launch-button := Rectangle {
                            width: 128px;
                            height: parent.height;
                            background: #7287fd;
                            border-top-left-radius: 8px;
                            border-bottom-left-radius: 8px;
                            opacity: launch-touch.pressed ? 0.9 : root-launch-disabled ? 0.6 : 1.0;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                cross-axis-alignment: center;

                                AppIcon { name: "play"; size: 20px; icon-color: #ffffff; }
                                Text {
                                    text: @tr("Launch");
                                    font-size: 15px;
                                    font-weight: Theme.font-weight-normal;
                                    color: #ffffff;
                                }
                            }

                            launch-touch := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                enabled: GameState.has-current;
                                clicked => { GameState.launch(); }
                            }
                        }

                        launch-sub-button := Rectangle {
                            vertical-stretch: 1;
                            width: 24px;
                            background: #7287fd;
                            border-top-right-radius: 8px;
                            border-bottom-right-radius: 8px;
                            opacity: sub-touch.pressed ? 0.9 : root-launch-disabled ? 0.6 : 1.0;

                            AppIcon {
                                name: "chevron-down";
                                size: 16px;
                                icon-color: #ffffff;
                                transform-scale-y: (1.0 - 2.0 * root.launch-chevron-flip) * 100%;
                                opacity: 1.0 - 0.3 * (1.0 - abs(1.0 - 2.0 * root.launch-chevron-flip));
                            }

                            sub-touch := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                enabled: GameState.has-current;
                                clicked => {
                                    FocusManager.clear();
                                    if (root.launch-menu-is-open) {
                                        Dropdown.open = false;
                                        } else {
                                        Dropdown.options = root.launch-options;
                                        Dropdown.accounts = [];
                                        Dropdown.account-mode = false;
                                        Dropdown.current = "";
                                        Dropdown.owner = "launch-menu";
                                        Dropdown.anchor-x = launch-buttons.absolute-position.x;
                                        Dropdown.anchor-y = launch-buttons.absolute-position.y
                                        + launch-buttons.height + 4px;
                                        Dropdown.anchor-width = launch-buttons.width;
                                        Dropdown.expand-upwards = false;
                                        Dropdown.open = true;
                                    }
                                }
                            }
                        }
                    }

                    actions := Rectangle {
                        vertical-stretch: 0;
                        width: 112px;
                        height: 32px;
                        background: transparent;
                        opacity: GameState.has-current ? 1.0 : 0.6;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 100px;
                                background: folder-touch.pressed ? Theme.surface-0
                                : folder-touch.has-hover ? Theme.surface-1
                                : transparent;

                                AppIcon {
                                    name: "folder";
                                    size: 20px;
                                }

                                folder-touch := TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    enabled: GameState.has-current;
                                    clicked => { GameState.open-instance-folder(); }
                                }
                            }

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 100px;
                                background: star-touch.pressed ? Theme.surface-0
                                : star-touch.has-hover ? Theme.surface-1
                                : transparent;

                                AppIcon {
                                    name: GameState.current-starred ? "star" : "star-outline";
                                    size: 20px;
                                }

                                star-touch := TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    enabled: GameState.has-current;
                                    clicked => { GameState.toggle-starred(); }
                                }
                            }

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 100px;
                                background: settings-touch.pressed ? Theme.surface-0
                                : settings-touch.has-hover ? Theme.surface-1
                                : transparent;

                                AppIcon {
                                    name: "settings";
                                    size: 20px;
                                }

                                settings-touch := TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    enabled: GameState.has-current;
                                    clicked => { GameState.open-instance-settings(); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ----- current instance contents -----
        // The four previews carry the second batch of the intro: the same slide,
        // starting 0.03s after the detail rows did — and the dimming for having
        // no instance is on the whole block, where each of the four rows used to
        // carry its own share of it.
        contents-cell := Rectangle {
            border-radius: 12px;
            background: transparent;

            contents-slide := Rectangle {
                background: transparent;
                x: self.intro-dx;
                opacity: (GameState.has-current ? 1.0 : 0.6) * self.intro-alpha;

                private property <length> intro-dx: GameIntro.played ? 0px : -50px;
                private property <float> intro-alpha: GameIntro.played ? 1.0 : 0.0;
                animate intro-dx { duration: 330ms; delay: 1 * root.intro-stagger; easing: ease-out-quart; }
                animate intro-alpha { duration: 330ms; delay: 1 * root.intro-stagger; easing: ease-out-quart; }

                // `.current-instance-contents { padding: 4px 4px; gap: 4px }` around
                // four 400px rows. The slide is on the box above, so each row here is
                // just a row.
                contents := VerticalLayout {
                    padding: 4px;
                    spacing: 4px;
                    vertical-stretch: 0;
                    horizontal-stretch: 0;

                    saves-row := ContentRow {
                        height: 36px;
                        icon: "save";
                        type-label: @tr("Saves");
                        count: GameState.content-saves;
                        icons: GameState.preview-saves;
                        loading: GameState.content-loading;
                        disabled: !GameState.has-current;
                        unit: GameState.count-unit;
                        clicked => { GameState.open-content("saves"); }

                    }

                    mods-row := ContentRow {
                        height: 36px;
                        icon: "extension-puzzle";
                        type-label: @tr("Mods");
                        count: GameState.content-mods;
                        icons: GameState.preview-mods;
                        loading: GameState.content-loading;
                        disabled: !GameState.has-current || !GameState.current-has-loader;
                        unit: GameState.count-unit;
                        clicked => { GameState.open-content("mods"); }

                    }

                    resourcepacks-row := ContentRow {
                        height: 36px;
                        icon: "folder";
                        type-label: @tr("Resource packs");
                        count: GameState.content-resourcepacks;
                        icons: GameState.preview-resourcepacks;
                        loading: GameState.content-loading;
                        disabled: !GameState.has-current;
                        unit: GameState.count-unit;
                        clicked => { GameState.open-content("resourcepacks"); }

                    }

                    screenshots-row := ContentRow {
                        height: 36px;
                        icon: "images-outline";
                        type-label: @tr("Screenshots");
                        count: GameState.content-screenshots;
                        icons: GameState.preview-screenshots;
                        loading: GameState.content-loading;
                        disabled: !GameState.has-current || GameState.content-screenshots == 0;
                        unit: GameState.count-unit;
                        clicked => { GameState.open-content("screenshots"); }

                    }
                }
            }
        }
    }

    private property <bool> root-launch-disabled: !GameState.has-current;
}
