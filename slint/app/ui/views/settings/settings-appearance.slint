import { Theme } from "../../theme.slint";
import { SettingGroup } from "../../components/setting-group.slint";
import { SettingItem } from "../../components/setting-item.slint";
import { BaseSwitch } from "../../components/base-switch.slint";
import { BaseButton } from "../../components/base-button.slint";
import { BaseSliderBar } from "../../components/base-slider-bar.slint";
import { AppConfig } from "../../globals/settings.slint";
import { Background } from "../../globals/background.slint";

// A palette preview tile (.color-style > div, 90x60, rounded, label at
// `width - 20`).
//
// Neither the 4px blue outline nor the label is inside the tile: the outline is
// the Vue's `outline: 4px solid var(--ctp-blue)`, drawn 4px outside the 90x60
// box, and the label is its `p { margin-top: calc(100% - 20px) }`, 70px down a
// 60px box. The Vue's tile has no `overflow: hidden`, so both show. This one
// cannot carry a `clip` for the same reason — Slint's `clip` cuts the children
// to the element's box, which would take the outline and the label with it. The
// radius is therefore on the image box, which is the one element that has to be
// rounded and cropped.
component PaletteSwatch inherits Rectangle {
    in property <image> preview;
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> swatch-disabled: false;
    callback chosen;

    width: 90px;
    height: 60px;

    // `.color-style-disabled * { opacity: 0.6 }` dims every *descendant*, and
    // that is written here rather than on the component root on purpose. An
    // element carrying `opacity` below 1 is composited through a layer bounded
    // by its own box, so an opacity on this root clipped the label off
    // altogether: the label is the Vue's `margin-top: calc(100% - 20px)`, ten
    // pixels *below* this 60px box, and with follow-system on — which is the
    // only state in which anything here is disabled — the palette showed four
    // unlabelled tiles. Per-element opacity is also what the Vue says, and
    // nothing that dims has a child escaping its box: the outline draws nothing,
    // the image fills the box it dims, and the label draws inside its own.
    private property <float> dim: root.swatch-disabled ? 0.6 : 1.0;

    if root.selected : Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: 10px;
        background: Theme.blue;
        opacity: root.dim;
    }

    image-box := Rectangle {
        width: 90px;
        height: 60px;
        border-radius: 6px;
        clip: true;
        opacity: root.dim;

        Image {
            width: 100%;
            height: 100%;
            source: root.preview;
            image-fit: contain;
        }
    }

    Text {
        text: root.label;
        font-size: 12.3px;
        font-weight: Theme.font-weight-normal;
        color: Theme.default-text-color.transparentize(0.1);
        opacity: root.dim;
        y: parent.width - 20px;
        width: 100%;
        horizontal-alignment: center;
    }

    TouchArea {
        enabled: !root.swatch-disabled;
        clicked => { root.chosen(); }
    }
}

// src/views/settings/SettingsAppearance.vue
export component SettingsAppearance inherits VerticalLayout {
    width: 100%;
    padding-left: 8px;
    padding-right: 8px;
    spacing: 16px;
    alignment: start;

    SettingGroup {
        title: @tr("Palette");

        SettingItem {
            group-first: true;
            title: @tr("Follow system dark mode");
            description: @tr("Uses Latte when the system is set to light mode, otherwise uses Mocha");
            icon: "moon";

            BaseSwitch {
                checked <=> AppConfig.palette-follow-system;
                // Arms the palette transition, which is what makes a change a
                // *user* change (see `Theme.transitions-enabled`); without it
                // the app would snap, which is right at startup and wrong here.
                //
                // `BaseSwitch` writes `checked` through the two-way binding
                // before it calls `toggled`, so this is not the first mutation
                // of the change — and does not need to be. Slint evaluates the
                // tokens lazily, from the change handlers, which run on the
                // event loop and never in the middle of a click handler: by the
                // time anything reads `transitions-enabled`, it is set.
                toggled => {
                    Theme.transitions-enabled = true;
                    AppConfig.changed();
                }
            }
        }

        // The palette row is a plain `Rectangle` rather than a `SettingItem`, so
        // it does not pick up the `group-last` rounding the Vue gives
        // `:last-child`; it is the last child here, so it rounds its own.
        color-style := Rectangle {
            width: 100%;
            height: 120px;
            background: Theme.setting-item-background;
            border-bottom-left-radius: 8px;
            border-bottom-right-radius: 8px;

            // `.color-style { display: flex; align-items: center;
            // justify-content: center }` with the tiles' `margin: -24px 12px 0`
            // — a 24px side that is really a gap, and a -24px top that is what
            // `align-items: center` then measures against. Spacing and padding
            // say so directly, so the 456px of hand-computed offsets (4 × 90 +
            // 8 × 12) and the 114px pitch are gone: a fifth tile, or a wider one,
            // needs nothing changed here.
            HorizontalLayout {
                alignment: center;
                cross-axis-alignment: start;
                padding-top: 18px;
                spacing: 24px;

                PaletteSwatch {
                    preview: @image-url("../../assets/palette-latte.png");
                    label: "Latte";
                    selected: Theme.active-palette == "Latte";
                    swatch-disabled: AppConfig.palette-follow-system;
                    chosen => {
                        Theme.transitions-enabled = true;
                        AppConfig.palette = "Latte";
                        AppConfig.changed();
                    }
                }
                PaletteSwatch {
                    preview: @image-url("../../assets/palette-frappe.png");
                    label: "Frappé";
                    selected: Theme.active-palette == "Frappe";
                    swatch-disabled: AppConfig.palette-follow-system;
                    chosen => {
                        Theme.transitions-enabled = true;
                        AppConfig.palette = "Frappe";
                        AppConfig.changed();
                    }
                }
                PaletteSwatch {
                    preview: @image-url("../../assets/palette-macchiato.png");
                    label: "Macchiato";
                    selected: Theme.active-palette == "Macchiato";
                    swatch-disabled: AppConfig.palette-follow-system;
                    chosen => {
                        Theme.transitions-enabled = true;
                        AppConfig.palette = "Macchiato";
                        AppConfig.changed();
                    }
                }
                PaletteSwatch {
                    preview: @image-url("../../assets/palette-mocha.png");
                    label: "Mocha";
                    selected: Theme.active-palette == "Mocha";
                    swatch-disabled: AppConfig.palette-follow-system;
                    chosen => {
                        Theme.transitions-enabled = true;
                        AppConfig.palette = "Mocha";
                        AppConfig.changed();
                    }
                }
            }
        }
    }

    SettingGroup {
        title: @tr("Background image");

        SettingItem {
            group-first: true;
            title: @tr("Custom background image");
            description: @tr("Select an image as the launcher background. Instance backgrounds take priority");
            icon: "image";
            navigable: AppConfig.background-image == "";
            clicked => { AppConfig.pick-background-image(); }

            if AppConfig.background-image != "" : BaseButton {
                text: @tr("Remove image");
                text-color: Theme.red;
                clicked => { AppConfig.remove-background-image(); }
            }
        }

        SettingItem {
            title: @tr("Background image darkness");
            description: AppConfig.background-darkness + "%";
            item-disabled: AppConfig.background-image == "";

            BaseSliderBar {
                max: 100;
                min: 0;
                step: 5;
                slider-enabled: AppConfig.background-image != "";
                value <=> AppConfig.background-darkness;
                edited => { AppConfig.changed(); }
            }
        }

        SettingItem {
            title: @tr("3D background camera movement");
            description: @tr("When disabled, the camera stops moving forward and the background stops updating after rendering, completely eliminating background overhead");
            // Nothing moves a world that is not being drawn: this machine has no
            // OpenGL, so the background is the hyperbola sky alone.
            item-disabled: Background.software-only;

            BaseSwitch {
                checked <=> AppConfig.background-camera-move;
                toggled => { AppConfig.changed(); }
            }
        }

        SettingItem {
            group-last: true;
            title: @tr("Background parallax");
            description: @tr("When disabled, the background no longer moves with the mouse");

            BaseSwitch {
                checked <=> AppConfig.background-parallax;
                toggled => { AppConfig.changed(); }
            }
        }
    }
}
