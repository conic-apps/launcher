import { Theme } from "../../theme.slint";
import { SettingGroup } from "../../components/setting-group.slint";
import { SettingItem } from "../../components/setting-item.slint";
import { BaseSwitch } from "../../components/base-switch.slint";
import { BaseButton } from "../../components/base-button.slint";
import { BaseSliderBar } from "../../components/base-slider-bar.slint";
import { AppConfig } from "../../globals/settings.slint";

// A palette preview tile (.color-style > div, 90x60, rounded, label at
// `width - 20`). The 4px blue outline is drawn outside the box by a larger
// rectangle behind the tile.
component PaletteSwatch inherits Rectangle {
    in property <image> preview;
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> swatch-disabled: false;
    callback chosen;

    width: 90px;
    height: 60px;
    border-radius: 6px;
    clip: true;
    opacity: root.swatch-disabled ? 0.6 : 1.0;

    if root.selected : Rectangle {
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: 10px;
        background: Theme.blue;
    }

    Image {
        width: 100%;
        height: 100%;
        source: root.preview;
        image-fit: contain;
    }

    Text {
        text: root.label;
        font-size: 12.3px;
        font-weight: Theme.font-weight-normal;
        color: Theme.default-text-color.transparentize(0.1);
        y: parent.width - 20px;
        width: 100%;
        horizontal-alignment: center;
    }

    TouchArea {
        enabled: !root.swatch-disabled;
        clicked => { root.chosen(); }
    }
}

// src/views/settings/SettingsAppearance.vue
export component SettingsAppearance inherits VerticalLayout {
    width: 100%;
    padding-left: 8px;
    padding-right: 8px;
    spacing: 16px;
    alignment: start;

    SettingGroup {
        title: @tr("Palette");

        SettingItem {
            title: @tr("Follow system dark mode");
            description: @tr("Uses Latte when the system is set to light mode, otherwise uses Mocha");
            icon: "moon";

            BaseSwitch {
                checked <=> AppConfig.palette-follow-system;
                toggled => { AppConfig.changed(); }
            }
        }

        // The palette row is a plain `Rectangle` rather than a `SettingItem`, so
        // it does not pick up the rounding the rows get; without it the square
        // corners here cover the rounded ones of the card painted behind them.
        color-style := Rectangle {
            width: 100%;
            height: 120px;
            background: Theme.setting-item-background;
            border-radius: 8px;

            PaletteSwatch {
                x: (color-style.width - 456px) / 2 + 12px;
                y: 18px;
                preview: @image-url("../../assets/palette-latte.png");
                label: "Latte";
                selected: Theme.active-palette == "Latte";
                swatch-disabled: AppConfig.palette-follow-system;
                chosen => { AppConfig.palette = "Latte"; AppConfig.changed(); }
            }
            PaletteSwatch {
                x: (color-style.width - 456px) / 2 + 126px;
                y: 18px;
                preview: @image-url("../../assets/palette-frappe.png");
                label: "Frappé";
                selected: Theme.active-palette == "Frappe";
                swatch-disabled: AppConfig.palette-follow-system;
                chosen => { AppConfig.palette = "Frappe"; AppConfig.changed(); }
            }
            PaletteSwatch {
                x: (color-style.width - 456px) / 2 + 240px;
                y: 18px;
                preview: @image-url("../../assets/palette-macchiato.png");
                label: "Macchiato";
                selected: Theme.active-palette == "Macchiato";
                swatch-disabled: AppConfig.palette-follow-system;
                chosen => { AppConfig.palette = "Macchiato"; AppConfig.changed(); }
            }
            PaletteSwatch {
                x: (color-style.width - 456px) / 2 + 354px;
                y: 18px;
                preview: @image-url("../../assets/palette-mocha.png");
                label: "Mocha";
                selected: Theme.active-palette == "Mocha";
                swatch-disabled: AppConfig.palette-follow-system;
                chosen => { AppConfig.palette = "Mocha"; AppConfig.changed(); }
            }
        }
    }

    SettingGroup {
        title: @tr("Background image");

        SettingItem {
            title: @tr("Custom background image");
            description: @tr("Select an image as the launcher background. Instance backgrounds take priority");
            icon: "image";
            navigable: AppConfig.background-image == "";
            clicked => { AppConfig.pick-background-image(); }

            if AppConfig.background-image != "" : BaseButton {
                text: @tr("Remove image");
                text-color: Theme.red;
                clicked => { AppConfig.remove-background-image(); }
            }
        }

        SettingItem {
            title: @tr("Background image darkness");
            description: AppConfig.background-darkness + "%";
            item-disabled: AppConfig.background-image == "";

            BaseSliderBar {
                max: 100;
                min: 0;
                step: 5;
                slider-enabled: AppConfig.background-image != "";
                value <=> AppConfig.background-darkness;
                edited => { AppConfig.changed(); }
            }
        }

        SettingItem {
            title: @tr("3D background camera movement");
            description: @tr("When disabled, the camera stops moving forward and the background stops updating after rendering, completely eliminating background overhead");

            BaseSwitch {
                checked <=> AppConfig.background-camera-move;
                toggled => { AppConfig.changed(); }
            }
        }

        SettingItem {
            title: @tr("Background parallax");
            description: @tr("When disabled, the background no longer moves with the mouse");

            BaseSwitch {
                checked <=> AppConfig.background-parallax;
                toggled => { AppConfig.changed(); }
            }
        }
    }
}
