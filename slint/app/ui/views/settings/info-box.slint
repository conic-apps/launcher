import { Theme } from "../../theme.slint";

// Rounded info card (src/views/settings/InfoBox.vue). Currently unused (the
// sponsorship box is commented out in the Vue About page) but kept so the
// settings tree mirrors the original.
export component InfoBox inherits Rectangle {
    in property <bool> click-able: false;

    width: 100%;
    background: Theme.card-background;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;

    VerticalLayout {
        padding: 20px;
        spacing: 0px;
        alignment: start;
        @children
    }
}
